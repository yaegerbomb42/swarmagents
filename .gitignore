# Local secret material — never commit.
api_keys.md
.swarm-board-cookies

# Dependencies
/node_modules
/.pnpm-store

# Production Builds
/build
/dist
/.next
/out

# Environment & Local Secrets
.env
.env.local
.env.*.local
*.pem

# Logs & Caches
*.log
*.err
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.turbo

# IDE & Tooling Caches
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
.aider*

# Tracked env files that should NOT be committed
*.env.secret
*.env.production
*.env.local
# Real env files carry live keys. Track *.example templates instead.
**/.env.clean
**/.env.clean.*
!**/.env.clean.example
**/*.local-backup

# python env noise
.venv/
venv/
**/venv/
__pycache__/
*.py[cod]

.npm-cache*/
**/.npm-cache*/

# Local databases / runtime state (Prisma, SQLite). Never source.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Editor local history (VS Code timeline / Eclipse local history)
.history/
**/.history/

# Hand-made build snapshots kept next to build output
_dist_old_bak/

# large binaries & generated data — too big for git (GitHub 100MB limit); keep on disk only
*.gguf
*.pack
models/

# Build output / deps / runtime junk (anywhere)
node_modules/
.next/
dist/
build/
.last_build_hash
.last_npm_hash
.last_npm_install
.build_counts
*.tsbuildinfo
__pycache__/
.lease_secret
*.zip
.DS_Store

# nested node_modules
**/node_modules/
**/node_modules
# Dead build leftovers kept only for reference on disk
**/_app.old/
*.old.bak

# Model weights and heavy artifacts (never commit)
*.safetensors
*.gguf
*.pt
*.pth
*.ckpt
*.onnx
*.bin
models/
**/hf_cache/
**/.cache/huggingface/

# Build caches and deps
**/node_modules/
**/.next/
**/.turbo/
.repowise/
*.pkl

# Playtest session cookie header (apps/swarmagents/scripts/playtest.mjs)
.swarm-playtest-cookies
