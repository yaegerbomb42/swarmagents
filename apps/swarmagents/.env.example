# SwarmAgents — example environment for `docker compose`.
#
# Copy to `.env` (same directory as docker-compose.yml) and fill in real
# values. Docker Compose reads `.env` automatically. NEVER commit a filled-in
# `.env`, and never put real secrets in this file.
#
# The three server-mode variables are required for any deployment: without
# them the app either refuses to boot (missing SWARM_SESSION_SECRET) or
# serves unauthenticated. See DEPLOY.md "Server-mode authentication".

# 1 = server mode: sign-in required for every route (except login / signup /
# health). The Compose files set this by default; this line documents it.
SWARM_SERVER_MODE=1

# HMAC key for session cookies. 32+ random bytes, e.g. `openssl rand -hex 32`.
# Losing it signs everyone out (sessions stop verifying); rotating it also
# re-keys the SWARM_KEYS_SECRET fallback for sealed provider keys.
SWARM_SESSION_SECRET=replace-me-with-32-plus-random-bytes-from-openssl-rand-hex-32

# Public hostname(s) for the middleware host allowlist, comma-separated.
# Example: swarmagents.example.com. Required in server mode: an unset list
# denies every Host by default (it used to mean allow-all). A front proxy
# that restricts the Host header does not substitute for setting this.
SWARM_ALLOWED_HOSTS=

# Bearer token for server-to-server callers (external MCP clients, harness).
# Read from env only, never logged. Required for /api/mcp/swarm-board writes
# from outside a browser session.
SWARM_HARNESS_TOKEN=replace-me-with-a-long-random-bearer-token

# Host port for the app (container always listens on 3777).
APP_PORT=3777
