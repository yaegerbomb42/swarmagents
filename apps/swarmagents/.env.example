# SwarmAgents — example environment for `docker compose`.
#
# Copy to `.env` (same directory as docker-compose.yml) and fill in real
# values. Docker Compose reads `.env` automatically. NEVER commit a filled-in
# `.env`, and never put real secrets in this file.
#
# The three server-mode variables are required for any deployment: without
# them the app either refuses to boot (missing SWARM_SESSION_SECRET) or
# serves unauthenticated. See DEPLOY.md "Server-mode authentication".

# 1 = server mode: sign-in required for every route (except login / signup /
# health). The Compose files set this by default; this line documents it.
SWARM_SERVER_MODE=1

# HMAC key for session cookies. 32+ random bytes, e.g. `openssl rand -hex 32`.
# Losing it signs everyone out (sessions stop verifying); rotating it also
# re-keys the SWARM_KEYS_SECRET fallback for sealed provider keys.
SWARM_SESSION_SECRET=replace-me-with-32-plus-random-bytes-from-openssl-rand-hex-32

# Public hostname(s) for the middleware host allowlist, comma-separated.
# Example: swarmagents.example.com. Required in server mode: an unset list
# denies every Host by default (it used to mean allow-all), and the app now
# refuses to boot when the list is empty. Entries may carry a port
# (swarmagents.example.com:443) — ports are stripped before matching. A
# front proxy that restricts the Host header does not substitute for
# setting this.
SWARM_ALLOWED_HOSTS=

# Session cookies are Secure by default: browsers only send them over HTTPS.
# Leave this unset (Secure) when a TLS-terminating proxy fronts the app. Set
# to 0 ONLY for a deployment reached over plain HTTP — otherwise the browser
# silently drops the cookie and login loops forever with no error shown.
# See DEPLOY.md "Server-mode authentication".
# SWARM_COOKIE_SECURE=1

# Self-signup switch. In server mode (and production) sign-up is CLOSED
# unless this is set: /api/signup answers 403 and the login page does not
# offer "Create account". Set to 1 (or true) to open self-signup — this is
# also how the first/operator account is created on a fresh deployment:
# set it, create the account(s), then unset it to close sign-up again.
# Local mode ignores this (sign-up is always open on loopback).
# See DEPLOY.md "Sign-up posture".
# SWARM_ALLOW_SIGNUP=1
#
# Invite-only sign-up (middle posture): set SWARM_SIGNUP_MODE=invite and
# sign-up requires a valid single-use code from SWARM_INVITE_CODES
# (comma-separated; codes are case-sensitive). The login page renders an
# invite-code field and /api/signup rejects missing/unknown/spent codes
# with one generic 400. Invite mode takes precedence over
# SWARM_ALLOW_SIGNUP. Use long random codes (e.g. `openssl rand -hex 16`
# each) — anyone holding a code can create one account. With invite mode
# on but no codes configured, sign-up fails closed. Redeemed codes are
# recorded only as keyed hashes on the created account; removing a code
# from this list does not un-redeem it. See DEPLOY.md "Sign-up posture".
# SWARM_SIGNUP_MODE=invite
# SWARM_INVITE_CODES=

# Signup abuse controls (FIX-44). New accounts start UNVERIFIED: a
# verification link is emailed (needs the SMTP settings below) and, in
# server mode, the account cannot start runs until the link is clicked —
# accounts consume VM compute, so open sign-ups must prove they own the
# email first. Accounts created before this shipped are grandfathered
# (treated as verified). Local mode is never gated.
# SWARM_EMAIL_VERIFY_TTL_HOURS=24
#
# Bot check: Cloudflare Turnstile on the sign-up form. Set BOTH keys to
# enable it; with the secret unset the check is skipped (fine for local
# mode and closed sign-ups — set them before opening sign-ups).
# SWARM_TURNSTILE_SITE_KEY=
# SWARM_TURNSTILE_SECRET=

# Bearer token for server-to-server callers (external MCP clients, harness).
# Read from env only, never logged. Required for /api/mcp/swarm-board writes
# from outside a browser session.
SWARM_HARNESS_TOKEN=replace-me-with-a-long-random-bearer-token

# Public origin of this deployment (e.g. https://swarmagents.example.com).
# Required in server mode for real (Docker) runs: per-user VMs reach the
# app's LLM proxy and approval endpoint through it. Without it (and without
# the SWARM_VM_* overrides below) Docker runs are refused at start, and
# non-Anthropic providers cannot run at all — the VM's Claude CLI speaks
# only the Anthropic Messages API, so OpenAI-style providers must go through
# the server-side LLM proxy, which also keeps raw provider keys out of the
# VM. The run-start error response names whichever variables are missing.
SWARM_PUBLIC_ORIGIN=

# Optional overrides for the origins VMs use to reach this app. Normally
# SWARM_PUBLIC_ORIGIN covers both; set these only when VMs must reach the
# app at a different address than the public site (e.g. the Docker bridge
# gateway IP, or host.docker.internal under Docker Desktop — never the VM's
# own 127.0.0.1/localhost).
# SWARM_VM_LLM_BASE_URL=http://172.17.0.1:3777
# SWARM_VM_APPROVAL_BASE_URL=http://172.17.0.1:3777

# Host port for the app (container always listens on 3777). 3400 is the
# canonical production host port: deploy/deploy.sh's HEALTH_URL polls it
# and deploy/nginx.conf proxies `/` to it. Change it only together with
# both (see "Canonical deploy shape" in DEPLOY.md).
APP_PORT=3400

# Desktop mode: 1 = every per-user VM is created from the desktop image
# (swarm-vm:desktop) and the live VM screen is served through the desktop
# proxy. The PRODUCTION default is ON — docker-compose.server.yml.example
# sets SWARM_VM_DESKTOP: "1" explicitly, and `deploy` builds the desktop
# image when it is missing. Unset/0 (the local default) keeps headless VMs
# and the terminal screen. To opt out in production, set this to 0 in the
# server compose environment (or run `./deploy.sh desktop-off` on the VPS).
# /api/health always reports the state (`desktop`), and /api/health?ready=1
# fails with DESKTOP_IMAGE_MISSING when desktop is on but the image is gone.
#SWARM_VM_DESKTOP=1
# Desktop image tag (default swarm-vm:desktop; build with
# `npm run vm-image-desktop:build`, see vm-image-desktop/).
#SWARM_VM_DESKTOP_IMAGE=swarm-vm:desktop
# Per-VM memory ceiling (docker --memory). Desktop VMs should get 4g; the
# driver default 2g is the floor. The server template sets 4g.
#SWARM_VM_MEMORY=4g

# Frame tap: 1 = the desktop proxy composites each session's RFB stream
# into a framebuffer shadow and stores JPEG keyframes on significant
# screen damage, readable at GET /desktop/keyframes (session-gated).
# This also enables retained keyframes after a session closes, the frame
# reference in takeover handback summaries, and desktop.damage run
# telemetry. Off by default (unset/0 = zero overhead, no frames held in
# memory). Only the exact value 1 enables it. Memory cost while on: up to
# ~2x framebuffer plus a 32 MiB keyframe store per tapped session.
# See DEPLOY.md "Desktop stream proxy".
# SWARM_DESKTOP_FRAME_TAP=1
# Stored keyframes are downscaled to this largest dimension in px
# (default 1280, 0 = full resolution). Only matters with the frame tap
# on; unset/invalid values fall back to 1280.
# SWARM_DESKTOP_KEYFRAME_MAX_DIM=1280

# Outbound mail for password-reset email (FIX-39). Without these, a
# server-mode deployment cannot deliver reset links (the request endpoint
# still answers 200, so set them before opening sign-ups). Any SMTP
# provider works (Gmail app password, Fastmail, SES/Mailgun SMTP, ...).
# SWARM_SMTP_HOST=smtp.example.com
# SWARM_SMTP_PORT=587
# SWARM_SMTP_SECURE=0
# SWARM_SMTP_USER=
# SWARM_SMTP_PASS=
# SWARM_MAIL_FROM=SwarmAgents <no-reply@example.com>
# Per-operation SMTP socket timeout in milliseconds (default 10000;
# invalid values fall back to the default).
# SWARM_SMTP_TIMEOUT_MS=10000
# EHLO name the client presents (default: the container hostname).
# SWARM_SMTP_HELO=mail.example.com
# Reset-link lifetime in minutes (default 30).
# SWARM_PASSWORD_RESET_TTL_MIN=30

# Global cap on simultaneously live user VMs. Runs beyond the cap queue
# with a capacity status instead of starting a VM. Default 4 (sized for a
# small VPS at the 4GiB desktop-VM ceiling); 0 disables the cap.
# Idle-but-alive VMs count until the idle sweeper hibernates them
# (SWARM_VM_IDLE_MIN). See DEPLOY.md "Global concurrent-VM cap".
# SWARM_MAX_CONCURRENT_VMS=4
