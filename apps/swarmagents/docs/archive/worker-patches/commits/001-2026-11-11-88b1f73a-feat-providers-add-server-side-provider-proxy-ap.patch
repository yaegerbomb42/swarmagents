+import { NextResponse, type NextRequest } from "next/server";
+import { defaultProviderConfigs, modelForTier, type ProviderConfig } from "@/lib/providers";
+import type { ModelTier } from "@/lib/providers/types";
+import { USER_HEADER } from "@/lib/auth";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+const TIERS: ModelTier[] = ["fast", "balanced", "deep"];
+
+function dedupe(keys: string[]): string[] {
+  return Array.from(new Set(keys.map((k) => k.trim()).filter(Boolean)));
+}
+
+function envKeysName(config: { id: string }): string {
+  const suffix = config.id.toUpperCase().replace(/[^A-Z0-9]+/g, "_");
+  return `SWARM_KEYS_${suffix}`;
+}
+
+function caller(req: NextRequest): string | null {
+  const user = req.headers.get(USER_HEADER);
+  return user && user.length > 0 && user.length <= 128 ? user : null;
+}
+
+function unauthorized() {
+  return NextResponse.json({ error: "Sign in required." }, { status: 401 });
+}
+
+function providerSummary(config: ProviderConfig, env: Record<string, string | undefined>) {
+  const raw = env[envKeysName(config)] ?? "";
+  return {
+    id: config.id,
+    kind: config.kind,
+    rank: config.rank ?? 0,
+    enabled: config.enabled !== false,
+    configured: dedupe(raw.split(",")).length > 0,
+    models: Object.fromEntries(TIERS.map((t) => [t, modelForTier(config, t)])),
+  };
+}
+
+/**
+ * GET /api/providers
+ *
+ * Lists the server-known providers and whether each is configured with server
+ * held keys. No keys or secrets are ever returned. The UI uses this to decide
+ * whether to route completions through /api/providers/complete (server-held
+ * keys) or fall back to BYO-key (user-entered keys in the browser).
+ */
+export async function GET(req: NextRequest) {
+  const user = caller(req);
+  if (!user) return unauthorized();
+  const providers = defaultProviderConfigs().map((config) =>
+    providerSummary(config, process.env),
+  );
+  return NextResponse.json(
+    { providers },
+    { headers: { "cache-control": "no-store" } },
+  );
+}
