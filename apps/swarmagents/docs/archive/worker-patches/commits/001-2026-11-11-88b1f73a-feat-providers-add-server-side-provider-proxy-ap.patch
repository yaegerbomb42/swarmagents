+import test from "node:test";
+import assert from "node:assert/strict";
+import { NextRequest } from "next/server";
+import { GET } from "./route";
+
+process.env.SWARM_KEYS_ANTHROPIC = "sk-test-list-ant";
+process.env.SWARM_KEYS_OPENAI = "sk-test-list-oai";
+
+test("GET /api/providers lists configured providers without keys", async () => {
+  const res = await GET(
+    new NextRequest("http://localhost/api/providers", {
+      headers: { "x-swarm-user": "local" },
+    }),
+  );
+  assert.equal(res.status, 200);
+  const json = await res.json();
+  assert.ok(Array.isArray(json.providers));
+  const ids = json.providers.map((p: { id: string }) => p.id);
+  assert.ok(ids.includes("anthropic"));
+  assert.ok(ids.includes("openai"));
+  assert.ok(ids.includes("gemini"));
+
+  // no key material anywhere in the response
+  const serialized = JSON.stringify(json);
+  assert.equal(serialized.includes("sk-test-list-ant"), false);
+  assert.equal(serialized.includes("sk-test-list-oai"), false);
+
+  const anthropic = json.providers.find((p: { id: string }) => p.id === "anthropic");
+  assert.equal(anthropic.configured, true);
+  assert.equal(anthropic.kind, "anthropic");
+  assert.equal(anthropic.enabled, true);
+  assert.ok(anthropic.models.balanced);
+
+  const gemini = json.providers.find((p: { id: string }) => p.id === "gemini");
+  assert.equal(gemini.configured, false); // no SWARM_KEYS_GEMINI set
+});
+
+test("GET /api/providers requires a signed-in caller", async () => {
+  const res = await GET(new NextRequest("http://localhost/api/providers"));
+  assert.equal(res.status, 401);
+});
