+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import {
+  DEFAULT_SHUTDOWN_TIMEOUT_MS,
+  handleShutdown,
+  registerShutdownHandler,
+  type ShutdownDeps,
+} from "./shutdown";
+import { RuntimeManager } from "./manager";
+import { VmManager } from "../vm/manager";
+import { FakeVmDriver } from "../vm/fake-driver";
+import type { ExecOptions, ExecResult, VmHandle } from "../vm/types";
+import { TelemetryBus, type SequencedEvent, type TelemetryEvent } from "../telemetry/bus";
+import { readRunEvents } from "../telemetry/run-log";
+
+const sleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));
+
+function tmpDir(): string {
+  return fs.mkdtempSync(path.join(os.tmpdir(), "swarm-shutdown-"));
+}
+
+test("registers the signal handlers exactly once", () => {
+  assert.equal(registerShutdownHandler(), true);
+  assert.equal(registerShutdownHandler(), false);
+});
+
+test("handleShutdown cancels runs with reason 'shutdown', flushes, then exits 0", async () => {
+  const calls: string[] = [];
+  let exitCode: number | undefined;
+  const deps: ShutdownDeps = {
+    cancelActiveRuns: (reason) => {
+      assert.equal(reason, "shutdown");
+      calls.push("cancel");
+      return ["run_1"];
+    },
+    flush: () => {
+      calls.push("flush");
+    },
+    exit: (code) => {
+      exitCode = code;
+      calls.push(`exit:${code}`);
+    },
+    timeoutMs: 1000,
+  };
+
+  await handleShutdown("SIGTERM", deps);
+
+  assert.deepEqual(calls, ["cancel", "flush", "exit:0"]);
+  assert.equal(exitCode, 0);
+});
+
+test("handleShutdown force-exits within the timeout when flushing hangs", async () => {
+  let exitCode: number | undefined;
+  const deps: ShutdownDeps = {
+    cancelActiveRuns: () => [],
+    // A writer that never resolves: the shutdown must not wait on it.
+    flush: () => new Promise<void>(() => {}),
+    exit: (code) => {
+      exitCode = code;
+    },
+    timeoutMs: 25,
+  };
+
+  const startedAt = Date.now();
+  await handleShutdown("SIGINT", deps);
+  const elapsedMs = Date.now() - startedAt;
+
+  assert.equal(exitCode, 0);
+  assert.ok(elapsedMs < 1000, `expected force-exit near the 25ms timeout, took ${elapsedMs}ms`);
+});
+
+test("handleShutdown still exits 0 when cancelling or flushing throws", async () => {
+  const exits: number[] = [];
+  const deps: ShutdownDeps = {
+    cancelActiveRuns: () => {
+      throw new Error("cancel boom");
+    },
+    flush: () => {
+      throw new Error("flush boom");
+    },
+    exit: (code) => {
+      exits.push(code);
+    },
+    timeoutMs: 1000,
+  };
+
+  await handleShutdown("SIGTERM", deps);
+
+  assert.deepEqual(exits, [0]);
+});
+
+test("default shutdown timeout is 10s", () => {
+  assert.equal(DEFAULT_SHUTDOWN_TIMEOUT_MS, 10_000);
+});
+
+/** A VM driver whose ensure stays pending so runs are still active at cancel time. */
+class SlowEnsureDriver extends FakeVmDriver {
+  override async ensure(userId: string): Promise<VmHandle> {
+    await sleep(200);
+    return super.ensure(userId);
+  }
+
+  override async exec(handle: VmHandle, cmd: string[], opts?: ExecOptions): Promise<ExecResult> {
+    return super.exec(handle, cmd, opts);
+  }
+}
+
+test("RuntimeManager.cancelAll cancels every active run with reason 'shutdown'", () => {
+  const bus = new TelemetryBus();
+  const manager = new RuntimeManager({ vm: new VmManager({ customDriver: new SlowEnsureDriver() }), bus });
+  const alice = manager.start("alice", { prompt: "a" });
+  const bob = manager.start("bob", { prompt: "b" });
+
+  const events: SequencedEvent[] = [];
+  bus.subscribe(alice.runId, 0, (event) => events.push(event));
+  bus.subscribe(bob.runId, 0, (event) => events.push(event));
+
+  const cancelled = manager.cancelAll("shutdown");
+
+  assert.deepEqual([...cancelled].sort(), [alice.runId, bob.runId].sort());
+  for (const userId of ["alice", "bob"]) {
+    const summary = manager.list(userId)[0];
+    assert.equal(summary.status, "cancelled");
+    assert.equal(summary.cancelledReason, "shutdown");
+  }
+  const cancelEvents = events.filter((event) => event.type === "run.cancelled");
+  assert.equal(cancelEvents.length, 2);
+  for (const event of cancelEvents) {
+    assert.equal((event as { reason?: unknown }).reason, "shutdown");
+  }
+  // Nothing left to cancel.
+  assert.deepEqual(manager.cancelAll("shutdown"), []);
+});
+
+test("TelemetryBus.flush leaves persisted run logs intact", () => {
+  const dir = tmpDir();
+  try {
+    const bus = new TelemetryBus({ persist: true, runsDir: () => dir });
+    bus.publish("run_flush", { type: "run.created", data: { prompt: "flush me", userId: "alice" } });
+    bus.publish("run_flush", { type: "run.finished", exitCode: 0 } as TelemetryEvent);
+
+    assert.doesNotThrow(() => bus.flush());
+
+    const replayed = readRunEvents("run_flush", dir);
+    assert.deepEqual(
+      replayed.map((event) => event.type),
+      ["run.created", "run.finished"],
+    );
+    assert.ok(fs.existsSync(path.join(dir, "run_flush.jsonl")));
+  } finally {
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+});
diff --git a/apps/swarmagents/lib/runtime/shutdown.ts b/apps/swarmagents/lib/runtime/shutdown.ts
new file mode 100644
index 000000000..fc5945cfc
--- /dev/null
+++ b/apps/swarmagents/lib/runtime/shutdown.ts
@@ -0,0 +1,95 @@
+/**
+ * Graceful shutdown: on SIGTERM/SIGINT (e.g. a deploy), cancel in-flight
+ * runs with reason "shutdown", flush run-log writers, then exit within a
+ * configurable timeout. A hung flush cannot stall the exit — a force-exit
+ * timer fires at the deadline — and a second signal kills the process
+ * immediately (the listeners are registered with `process.once`, so the
+ * second signal falls through to the default disposition).
+ *
+ * Registration is guarded by a globalThis flag so Next.js module reloads
+ * (several bundles loading this file) register the handlers exactly once.
+ * `handleShutdown` is exported so unit tests can call it directly with
+ * fakes instead of sending real signals.
+ */
+
+import { getRuntimeManager } from "./manager";
+import { telemetryBus } from "../telemetry/index";
+
+export type ShutdownSignal = "SIGTERM" | "SIGINT";
+
+/** Default budget for cancelling runs and flushing logs before exiting. */
+export const DEFAULT_SHUTDOWN_TIMEOUT_MS = 10_000;
+
+export interface ShutdownDeps {
+  /** Cancel every active run; defaults to the process-wide RuntimeManager. */
+  cancelActiveRuns?: (reason: "shutdown") => string[];
+  /** Flush run-log writers; defaults to the process-wide TelemetryBus. */
+  flush?: () => Promise<void> | void;
+  /** Exit the process; defaults to `process.exit`. */
+  exit?: (code: number) => void;
+  /** Force-exit if cancelling/flushing takes longer than this. */
+  timeoutMs?: number;
+}
+
+/**
+ * Run one graceful shutdown: cancel active runs, flush run logs, exit 0.
+ * Always exits (code 0) within `timeoutMs`, even if cancelling or flushing
+ * throws or hangs. Safe to call directly in tests with fakes.
+ */
+export async function handleShutdown(
+  signal: ShutdownSignal,
+  deps: ShutdownDeps = {},
+): Promise<void> {
+  const timeoutMs = Math.max(0, deps.timeoutMs ?? DEFAULT_SHUTDOWN_TIMEOUT_MS);
+  const exit = deps.exit ?? ((code: number) => process.exit(code));
+  let exited = false;
+  const doExit = (code: number): void => {
+    if (!exited) {
+      exited = true;
+      exit(code);
+    }
+  };
+
+  // Force-exit timer: deliberately kept referenced so it still fires if
+  // flushing hangs. Cleared once the graceful path finishes.
+  let timer: NodeJS.Timeout | undefined;
+  const timedOut = new Promise<void>((resolve) => {
+    timer = setTimeout(() => {
+      doExit(0);
+      resolve();
+    }, timeoutMs);
+  });
+
+  try {
+    const cancel = deps.cancelActiveRuns ?? (() => getRuntimeManager().cancelAll("shutdown"));
+    try {
+      cancel("shutdown");
+    } catch (err) {
+      console.error(`[shutdown] failed to cancel runs on ${signal}:`, err);
+    }
+    const flush = deps.flush ?? (() => telemetryBus.flush());
+    await Promise.race([Promise.resolve().then(() => flush()), timedOut]);
+  } catch (err) {
+    console.error(`[shutdown] failed to flush run logs on ${signal}:`, err);
+  } finally {
+    if (timer !== undefined) clearTimeout(timer);
+  }
+  doExit(0);
+}
+
+const g = globalThis as typeof globalThis & { __swarmShutdownRegistered?: boolean };
+
+/**
+ * Listen for SIGTERM and SIGINT exactly once per process. Returns true on
+ * the first call, false when the handlers are already registered.
+ */
+export function registerShutdownHandler(deps: ShutdownDeps = {}): boolean {
+  if (g.__swarmShutdownRegistered) return false;
+  g.__swarmShutdownRegistered = true;
+  const onSignal = (signal: ShutdownSignal): void => {
+    void handleShutdown(signal, deps);
+  };
+  process.once("SIGTERM", () => onSignal("SIGTERM"));
+  process.once("SIGINT", () => onSignal("SIGINT"));
+  return true;
+}
