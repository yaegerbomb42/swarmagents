diff --git a/apps/swarmagents/lib/client/files.test.ts b/apps/swarmagents/lib/client/files.test.ts
new file mode 100644
index 000000000..022ff43b8
--- /dev/null
+++ b/apps/swarmagents/lib/client/files.test.ts
@@ -0,0 +1,191 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import {
+  FileBrowserError,
+  WORKSPACE_ROOT,
+  describeFilesError,
+  fetchWorkspaceFile,
+  fetchWorkspaceListing,
+  formatBytes,
+  joinWorkspacePath,
+  normalizeWorkspacePath,
+  parentWorkspacePath,
+  type FetchLike,
+} from "./files";
+
+function fakeFetch(body: unknown, init?: ResponseInit & { raw?: string }): FetchLike {
+  return async () =>
+    new Response(init?.raw ?? JSON.stringify(body), {
+      status: init?.status ?? 200,
+      headers: { "content-type": "application/json" },
+    });
+}
+
+test("joins a directory and an entry into an absolute workspace path", () => {
+  assert.equal(joinWorkspacePath("/workspace", "src"), "/workspace/src");
+  assert.equal(joinWorkspacePath("/workspace/src", "app.ts"), "/workspace/src/app.ts");
+  assert.equal(joinWorkspacePath("/workspace/", "notes.md"), "/workspace/notes.md");
+  assert.equal(joinWorkspacePath("", "notes.md"), "/workspace/notes.md");
+});
+
+test("normalizes relative, duplicate-slash, and dot paths", () => {
+  assert.equal(normalizeWorkspacePath("notes.md"), "/workspace/notes.md");
+  assert.equal(normalizeWorkspacePath("/workspace//src/./app.ts"), "/workspace/src/app.ts");
+  assert.equal(normalizeWorkspacePath(""), WORKSPACE_ROOT);
+  assert.equal(normalizeWorkspacePath(null), WORKSPACE_ROOT);
+});
+
+test("path joining rejects traversal instead of clamping it", () => {
+  for (const name of ["..", "../etc", "a/../../b"]) {
+    assert.throws(
+      () => joinWorkspacePath("/workspace/src", name),
+      (err: unknown) => err instanceof FileBrowserError && err.kind === "forbidden",
+      `expected ${name} to be rejected`,
+    );
+  }
+});
+
+test("paths outside the workspace and invalid names are refused", () => {
+  assert.throws(
+    () => normalizeWorkspacePath("/etc/passwd"),
+    (err: unknown) => err instanceof FileBrowserError && err.kind === "forbidden",
+  );
+  assert.throws(
+    () => normalizeWorkspacePath("/workspace/a\u0000b"),
+    (err: unknown) => err instanceof FileBrowserError && err.kind === "invalid_path",
+  );
+  assert.throws(
+    () => normalizeWorkspacePath("/workspace\\a"),
+    (err: unknown) => err instanceof FileBrowserError && err.kind === "invalid_path",
+  );
+  assert.throws(
+    () => joinWorkspacePath("/workspace", "  "),
+    (err: unknown) => err instanceof FileBrowserError && err.kind === "invalid_path",
+  );
+});
+
+test("parentWorkspacePath walks up and stops at the root", () => {
+  assert.equal(parentWorkspacePath("/workspace/src/app.ts"), "/workspace/src");
+  assert.equal(parentWorkspacePath("/workspace/src"), "/workspace");
+  assert.equal(parentWorkspacePath("/workspace"), null);
+});
+
+test("fetchWorkspaceListing parses entries and builds the request URL", async () => {
+  let seen = "";
+  const fetchImpl: FetchLike = async (input) => {
+    seen = String(input);
+    return new Response(
+      JSON.stringify({
+        path: "/workspace",
+        kind: "directory",
+        root: "/workspace",
+        parent: null,
+        entries: [{ name: "src", path: "/workspace/src", type: "directory", size: 0 }],
+      }),
+      { status: 200 },
+    );
+  };
+
+  const listing = await fetchWorkspaceListing("/workspace", { fetchImpl });
+  assert.equal(listing.path, "/workspace");
+  assert.equal(listing.parent, null);
+  assert.equal(listing.entries[0].name, "src");
+  assert.equal(listing.entries[0].type, "directory");
+  assert.match(seen, /^\/api\/runtime\/vm\/files\?path=%2Fworkspace$/);
+});
+
+test("fetchWorkspaceFile requests read=1 and keeps the binary/truncated flags", async () => {
+  let seen = "";
+  const fetchImpl: FetchLike = async (input) => {
+    seen = String(input);
+    return new Response(
+      JSON.stringify({
+        path: "/workspace/big.txt",
+        kind: "file",
+        size: 2_000_000,
+        truncated: true,
+        binary: false,
+        limit: 1_048_576,
+        content: "x",
+      }),
+      { status: 200 },
+    );
+  };
+
+  const file = await fetchWorkspaceFile("/workspace/big.txt", { fetchImpl });
+  assert.match(seen, /read=1/);
+  assert.equal(file.truncated, true);
+  assert.equal(file.limit, 1_048_576);
+  assert.equal(file.content, "x");
+});
+
+test("maps API error codes to typed error states", async () => {
+  const cases: Array<{ status: number; code: string; kind: FileBrowserError["kind"] }> = [
+    { status: 401, code: "unauthorized", kind: "unauthorized" },
+    { status: 403, code: "outside_workspace", kind: "forbidden" },
+    { status: 404, code: "not_found", kind: "not_found" },
+    { status: 400, code: "is_a_directory", kind: "bad_request" },
+    { status: 501, code: "unsupported", kind: "unsupported" },
+    { status: 500, code: "vm_error", kind: "server" },
+  ];
+
+  for (const c of cases) {
+    await assert.rejects(
+      fetchWorkspaceListing("/workspace", {
+        fetchImpl: fakeFetch({ error: "nope", code: c.code }, { status: c.status }),
+      }),
+      (err: unknown) => {
+        assert.ok(err instanceof FileBrowserError);
+        assert.equal(err.kind, c.kind);
+        assert.equal(err.status, c.status);
+        assert.equal(err.code, c.code);
+        assert.equal(err.message, "nope");
+        return true;
+      },
+      `expected ${c.status}/${c.code}`,
+    );
+  }
+});
+
+test("a network failure becomes a network error", async () => {
+  const fetchImpl: FetchLike = async () => {
+    throw new TypeError("fetch failed");
+  };
+  await assert.rejects(
+    fetchWorkspaceListing("/workspace", { fetchImpl }),
+    (err: unknown) => err instanceof FileBrowserError && err.kind === "network",
+  );
+});
+
+test("a success response with the wrong shape is a malformed error", async () => {
+  await assert.rejects(
+    fetchWorkspaceListing("/workspace", { fetchImpl: fakeFetch({ nope: true }) }),
+    (err: unknown) => err instanceof FileBrowserError && err.kind === "malformed",
+  );
+  await assert.rejects(
+    fetchWorkspaceListing("/workspace", { fetchImpl: fakeFetch(null, { raw: "not json" }) }),
+    (err: unknown) => err instanceof FileBrowserError && err.kind === "malformed",
+  );
+});
+
+test("abort errors are rethrown untouched so effects can ignore them", async () => {
+  const fetchImpl: FetchLike = async () => {
+    const err = new Error("aborted");
+    err.name = "AbortError";
+    throw err;
+  };
+  await assert.rejects(
+    fetchWorkspaceListing("/workspace", { fetchImpl }),
+    (err: unknown) => err instanceof Error && err.name === "AbortError",
+  );
+});
+
+test("formatBytes and describeFilesError produce friendly text", () => {
+  assert.equal(formatBytes(0), "0 B");
+  assert.equal(formatBytes(512), "512 B");
+  assert.equal(formatBytes(1536), "1.5 KB");
+  assert.equal(formatBytes(1024 * 1024), "1.0 MB");
+  assert.equal(describeFilesError(new FileBrowserError("not_found", "Missing.")), "Missing.");
+  assert.equal(describeFilesError(new Error("boom")), "boom");
+  assert.equal(describeFilesError("weird"), "Could not load the VM filesystem.");
+});
diff --git a/apps/swarmagents/lib/client/files.ts b/apps/swarmagents/lib/client/files.ts
new file mode 100644
index 000000000..7825b6efe
--- /dev/null
+++ b/apps/swarmagents/lib/client/files.ts
@@ -0,0 +1,296 @@
+/**
+ * Client helpers for the workspace file browser.
+ *
+ * The UI never talks to the VM directly; it goes through
+ * GET /api/runtime/vm/files. These helpers build the request URLs, keep paths
+ * scoped to /workspace, and turn the API's error payloads into a typed
+ * FileBrowserError the views can render.
+ */
+
+/** Root of the per-user persistent volume, mirrored from lib/vm/files. */
+export const WORKSPACE_ROOT = "/workspace";
+
+export type WorkspaceEntryType = "file" | "directory" | "other";
+
+export interface WorkspaceEntry {
+  name: string;
+  path: string;
+  type: WorkspaceEntryType;
+  size: number;
+  modifiedAt?: number;
+}
+
+export interface WorkspaceListing {
+  path: string;
+  kind: "directory";
+  root: string;
+  parent: string | null;
+  entries: WorkspaceEntry[];
+}
+
+export interface WorkspaceFile {
+  path: string;
+  kind: "file";
+  size: number;
+  truncated: boolean;
+  binary: boolean;
+  /** Byte cap the API enforced for this read (1 MB). */
+  limit: number;
+  /** Present only for non-binary files. */
+  content?: string;
+}
+
+/** Categories the UI can render for a failed file request. */
+export type FileBrowserErrorKind =
+  | "invalid_path"
+  | "forbidden"
+  | "unauthorized"
+  | "not_found"
+  | "bad_request"
+  | "unsupported"
+  | "network"
+  | "server"
+  | "malformed";
+
+export class FileBrowserError extends Error {
+  readonly kind: FileBrowserErrorKind;
+  readonly status?: number;
+  readonly code?: string;
+
+  constructor(
+    kind: FileBrowserErrorKind,
+    message: string,
+    extra?: { status?: number; code?: string },
+  ) {
+    super(message);
+    this.name = "FileBrowserError";
+    this.kind = kind;
+    this.status = extra?.status;
+    this.code = extra?.code;
+  }
+}
+
+const CONTROL_CHARS = /[\u0000-\u001f\u007f]/;
+
+function pathError(kind: FileBrowserErrorKind, message: string): FileBrowserError {
+  return new FileBrowserError(kind, message);
+}
+
+/**
+ * Normalize a path to an absolute path inside /workspace.
+ *
+ * Relative paths are taken relative to /workspace, "." segments are dropped,
+ * and ".." (or anything that escapes the workspace) is refused rather than
+ * silently clamped.
+ */
+export function normalizeWorkspacePath(raw: string | null | undefined): string {
+  const input = (raw ?? "").trim();
+  if (!input) return WORKSPACE_ROOT;
+  if (CONTROL_CHARS.test(input)) {
+    throw pathError("invalid_path", "Path contains control characters.");
+  }
+  if (input.includes("\\")) {
+    throw pathError("invalid_path", "Path contains a backslash.");
+  }
+
+  const absolute = input.startsWith("/") ? input : `${WORKSPACE_ROOT}/${input}`;
+  const segments: string[] = [];
+  for (const segment of absolute.split("/")) {
+    if (!segment || segment === ".") continue;
+    if (segment === "..") {
+      throw pathError("forbidden", "Path traversal is not allowed.");
+    }
+    segments.push(segment);
+  }
+
+  const resolved = `/${segments.join("/")}`;
+  if (resolved !== WORKSPACE_ROOT && !resolved.startsWith(`${WORKSPACE_ROOT}/`)) {
+    throw pathError("forbidden", `Path must stay inside ${WORKSPACE_ROOT}.`);
+  }
+  return resolved;
+}
+
+/** Join a directory path and a child name into a normalized workspace path. */
+export function joinWorkspacePath(dir: string, name: string): string {
+  const base = normalizeWorkspacePath(dir);
+  const child = (name ?? "").trim();
+  if (!child) {
+    throw pathError("invalid_path", "Entry name is empty.");
+  }
+  if (child.startsWith("/")) {
+    return normalizeWorkspacePath(child);
+  }
+  return normalizeWorkspacePath(`${base}/${child}`);
+}
+
+/** Parent of a workspace path, or null when already at the workspace root. */
+export function parentWorkspacePath(path: string): string | null {
+  const normalized = normalizeWorkspacePath(path);
+  if (normalized === WORKSPACE_ROOT) return null;
+  const idx = normalized.lastIndexOf("/");
+  if (idx <= 0) return null;
+  return normalized.slice(0, idx);
+}
+
+export type FetchLike = typeof fetch;
+
+export interface FilesRequestOptions {
+  signal?: AbortSignal;
+  /** Injectable fetch for tests and SSR-safe callers. */
+  fetchImpl?: FetchLike;
+}
+
+function isAbortError(err: unknown): boolean {
+  return err instanceof Error && err.name === "AbortError";
+}
+
+function requestUrl(path: string, read: boolean): string {
+  const params = new URLSearchParams({ path });
+  if (read) params.set("read", "1");
+  return `/api/runtime/vm/files?${params.toString()}`;
+}
+
+const STATUS_ERROR_KIND: Record<number, FileBrowserErrorKind> = {
+  400: "bad_request",
+  401: "unauthorized",
+  403: "forbidden",
+  404: "not_found",
+  501: "unsupported",
+};
+
+function asObject(value: unknown): Record<string, unknown> | null {
+  return value && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : null;
+}
+
+function asString(value: unknown): string | undefined {
+  return typeof value === "string" ? value : undefined;
+}
+
+function asNumber(value: unknown): number | undefined {
+  return typeof value === "number" && Number.isFinite(value) ? value : undefined;
+}
+
+function parseListing(body: unknown): WorkspaceListing {
+  const obj = asObject(body);
+  if (!obj || obj.kind !== "directory" || !Array.isArray(obj.entries)) {
+    throw new FileBrowserError("malformed", "The VM file API returned an unexpected directory listing.");
+  }
+  const entries: WorkspaceEntry[] = [];
+  for (const raw of obj.entries) {
+    const entry = asObject(raw);
+    const name = asString(entry?.name);
+    const path = asString(entry?.path);
+    const type = asString(entry?.type);
+    if (!entry || !name || !path || !type) {
+      throw new FileBrowserError("malformed", "The VM file API returned an invalid entry.");
+    }
+    const size = asNumber(entry.size) ?? 0;
+    const modifiedAt = asNumber(entry.modifiedAt);
+    entries.push({
+      name,
+      path,
+      type: type === "directory" ? "directory" : type === "file" ? "file" : "other",
+      size,
+      ...(modifiedAt !== undefined ? { modifiedAt } : {}),
+    });
+  }
+  return {
+    path: asString(obj.path) ?? WORKSPACE_ROOT,
+    kind: "directory",
+    root: asString(obj.root) ?? WORKSPACE_ROOT,
+    parent: obj.parent === null ? null : (asString(obj.parent) ?? null),
+    entries,
+  };
+}
+
+function parseFile(body: unknown): WorkspaceFile {
+  const obj = asObject(body);
+  if (!obj || obj.kind !== "file" || typeof obj.binary !== "boolean") {
+    throw new FileBrowserError("malformed", "The VM file API returned an unexpected file payload.");
+  }
+  return {
+    path: asString(obj.path) ?? "",
+    kind: "file",
+    size: asNumber(obj.size) ?? 0,
+    truncated: obj.truncated === true,
+    binary: obj.binary,
+    limit: asNumber(obj.limit) ?? 0,
+    ...(typeof obj.content === "string" ? { content: obj.content } : {}),
+  };
+}
+
+async function requestJson(
+  path: string,
+  read: boolean,
+  parse: (body: unknown) => WorkspaceListing | WorkspaceFile,
+  options: FilesRequestOptions,
+): Promise<WorkspaceListing | WorkspaceFile> {
+  const fetchImpl = options.fetchImpl ?? fetch;
+
+  let res: Response;
+  try {
+    res = await fetchImpl(requestUrl(path, read), { signal: options.signal });
+  } catch (err) {
+    if (isAbortError(err)) throw err;
+    throw new FileBrowserError("network", "Could not reach the VM file API.");
+  }
+
+  let body: unknown = null;
+  try {
+    body = await res.json();
+  } catch {
+    body = null;
+  }
+
+  if (!res.ok) {
+    const obj = asObject(body);
+    const code = asString(obj?.code);
+    const message =
+      asString(obj?.error) ?? `The VM file API returned ${res.status}.`;
+    const kind = STATUS_ERROR_KIND[res.status] ?? "server";
+    throw new FileBrowserError(kind, message, { status: res.status, code });
+  }
+
+  return parse(body);
+}
+
+/** Fetch a directory listing from the VM file API. */
+export async function fetchWorkspaceListing(
+  path: string,
+  options: FilesRequestOptions = {},
+): Promise<WorkspaceListing> {
+  return (await requestJson(path, false, parseListing, options)) as WorkspaceListing;
+}
+
+/** Fetch a capped text preview from the VM file API. */
+export async function fetchWorkspaceFile(
+  path: string,
+  options: FilesRequestOptions = {},
+): Promise<WorkspaceFile> {
+  return (await requestJson(path, true, parseFile, options)) as WorkspaceFile;
+}
+
+/** Human-readable byte size (e.g. "1.5 MB"). */
+export function formatBytes(bytes: number): string {
+  if (!Number.isFinite(bytes) || bytes <= 0) return "0 B";
+  const units = ["B", "KB", "MB", "GB", "TB"];
+  let value = bytes;
+  let unit = 0;
+  while (value >= 1024 && unit < units.length - 1) {
+    value /= 1024;
+    unit += 1;
+  }
+  const rounded = unit === 0 ? String(Math.round(value)) : value.toFixed(value >= 10 ? 0 : 1);
+  return `${rounded} ${units[unit]}`;
+}
+
+/** Message suitable for an inline error state; unknown errors fall back safely. */
+export function describeFilesError(err: unknown): string {
+  if (err instanceof FileBrowserError) return err.message;
+  if (err instanceof Error && err.message) return err.message;
+  return "Could not load the VM filesystem.";
+}
+
+export { isAbortError };
