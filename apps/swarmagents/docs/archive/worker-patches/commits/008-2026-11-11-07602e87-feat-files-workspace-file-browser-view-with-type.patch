diff --git a/apps/swarmagents/minimalist-ui/src/components/FilesView.tsx b/apps/swarmagents/minimalist-ui/src/components/FilesView.tsx
new file mode 100644
index 000000000..a5022201b
--- /dev/null
+++ b/apps/swarmagents/minimalist-ui/src/components/FilesView.tsx
@@ -0,0 +1,268 @@
+"use client";
+
+import React, { useCallback, useEffect, useState } from "react";
+import {
+  AlertTriangle,
+  ChevronLeft,
+  File as FileIcon,
+  FileText,
+  Folder,
+  Loader2,
+  RefreshCw,
+  X,
+} from "lucide-react";
+import {
+  WORKSPACE_ROOT,
+  describeFilesError,
+  fetchWorkspaceFile,
+  fetchWorkspaceListing,
+  formatBytes,
+  joinWorkspacePath,
+  parentWorkspacePath,
+  type WorkspaceEntry,
+  type WorkspaceFile,
+  type WorkspaceListing,
+} from "../../../lib/client/files";
+
+interface FilesViewProps {
+  /**
+   * Monotonic token that changes when the current run emits run.finished, so
+   * the listing and open preview re-read the workspace after the agent writes.
+   */
+  refreshToken?: number;
+}
+
+function isAbort(err: unknown): boolean {
+  return err instanceof Error && err.name === "AbortError";
+}
+
+function entryIcon(entry: WorkspaceEntry) {
+  if (entry.type === "directory") return <Folder className="h-3.5 w-3.5 text-cyan-400/80" />;
+  if (entry.type === "file") return <FileText className="h-3.5 w-3.5 text-white/50" />;
+  return <FileIcon className="h-3.5 w-3.5 text-white/30" />;
+}
+
+export function FilesView({ refreshToken = 0 }: FilesViewProps) {
+  const [path, setPath] = useState(WORKSPACE_ROOT);
+  const [listing, setListing] = useState<WorkspaceListing>();
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState<string>();
+  const [reload, setReload] = useState(0);
+
+  const [selected, setSelected] = useState<string>();
+  const [file, setFile] = useState<WorkspaceFile>();
+  const [fileLoading, setFileLoading] = useState(false);
+  const [fileError, setFileError] = useState<string>();
+
+  // Directory listing (also reloads when a run finishes or the user refreshes).
+  useEffect(() => {
+    const ctrl = new AbortController();
+    setLoading(true);
+    setError(undefined);
+    fetchWorkspaceListing(path, { signal: ctrl.signal })
+      .then((data) => {
+        if (ctrl.signal.aborted) return;
+        setListing(data);
+      })
+      .catch((err) => {
+        if (isAbort(err) || ctrl.signal.aborted) return;
+        setError(describeFilesError(err));
+      })
+      .finally(() => {
+        if (!ctrl.signal.aborted) setLoading(false);
+      });
+    return () => ctrl.abort();
+  }, [path, refreshToken, reload]);
+
+  // Open file preview (re-read on refresh so the agent's latest writes show).
+  useEffect(() => {
+    if (!selected) {
+      setFile(undefined);
+      setFileError(undefined);
+      setFileLoading(false);
+      return;
+    }
+    const ctrl = new AbortController();
+    setFileLoading(true);
+    setFileError(undefined);
+    fetchWorkspaceFile(selected, { signal: ctrl.signal })
+      .then((data) => {
+        if (ctrl.signal.aborted) return;
+        setFile(data);
+      })
+      .catch((err) => {
+        if (isAbort(err) || ctrl.signal.aborted) return;
+        setFile(undefined);
+        setFileError(describeFilesError(err));
+      })
+      .finally(() => {
+        if (!ctrl.signal.aborted) setFileLoading(false);
+      });
+    return () => ctrl.abort();
+  }, [selected, refreshToken, reload]);
+
+  const navigate = useCallback((next: string) => {
+    setPath(next);
+    setSelected(undefined);
+    setFile(undefined);
+    setFileError(undefined);
+  }, []);
+
+  const openEntry = useCallback(
+    (entry: WorkspaceEntry) => {
+      if (entry.type === "directory") {
+        navigate(joinWorkspacePath(path, entry.name));
+        return;
+      }
+      setSelected(entry.path);
+    },
+    [navigate, path],
+  );
+
+  const parent = parentWorkspacePath(path);
+  const selectedName = selected ? selected.slice(selected.lastIndexOf("/") + 1) : undefined;
+
+  return (
+    <div className="flex flex-1 min-h-0 flex-col">
+      {/* Toolbar: path + refresh */}
+      <div className="flex items-center gap-2 border-b border-white/10 bg-[#0f0f15] px-3 py-2">
+        <button
+          onClick={() => parent && navigate(parent)}
+          disabled={!parent}
+          title="Up one folder"
+          className="grid h-6 w-6 place-items-center rounded-lg text-white/50 transition hover:bg-white/10 hover:text-white disabled:cursor-not-allowed disabled:opacity-25"
+        >
+          <ChevronLeft className="h-3.5 w-3.5" />
+        </button>
+        <div className="min-w-0 flex-1 truncate font-mono text-[11px] text-white/60">
+          {path}
+        </div>
+        {refreshToken > 0 && (
+          <span className="rounded-full border border-emerald-400/20 bg-emerald-400/10 px-2 py-0.5 text-[10px] font-mono text-emerald-300/80">
+            synced
+          </span>
+        )}
+        <button
+          onClick={() => setReload((n) => n + 1)}
+          title="Refresh"
+          className="flex items-center gap-1.5 rounded-lg px-2 py-1 text-[11px] font-mono text-white/50 transition hover:bg-white/10 hover:text-white"
+        >
+          <RefreshCw className={`h-3 w-3 ${loading ? "animate-spin" : ""}`} />
+          <span>Refresh</span>
+        </button>
+      </div>
+
+      <div className="flex min-h-0 flex-1">
+        {/* Directory listing */}
+        <div className="flex min-w-0 flex-1 flex-col overflow-y-auto border-r border-white/10 scrollbar-thin">
+          {error ? (
+            <div className="flex flex-1 flex-col items-center justify-center gap-2 p-6 text-center">
+              <AlertTriangle className="h-5 w-5 text-rose-400/70" />
+              <div className="text-xs text-rose-300/90">{error}</div>
+              <button
+                onClick={() => setReload((n) => n + 1)}
+                className="rounded-lg border border-white/10 px-2.5 py-1 text-[11px] text-white/60 hover:bg-white/10 hover:text-white"
+              >
+                Try again
+              </button>
+            </div>
+          ) : loading && !listing ? (
+            <div className="flex flex-1 items-center justify-center gap-2 p-6 text-xs text-white/40">
+              <Loader2 className="h-4 w-4 animate-spin" /> Loading workspace…
+            </div>
+          ) : listing && listing.entries.length === 0 ? (
+            <div className="flex flex-1 flex-col items-center justify-center gap-1 p-6 text-center">
+              <Folder className="h-5 w-5 text-white/25" />
+              <div className="text-xs text-white/40">This folder is empty.</div>
+            </div>
+          ) : (
+            <div className="p-1.5">
+              {listing?.entries.map((entry) => {
+                const active = selected === entry.path;
+                return (
+                  <button
+                    key={entry.path}
+                    onClick={() => openEntry(entry)}
+                    className={`flex w-full items-center gap-2 rounded-lg px-2 py-1.5 text-left font-mono text-[11px] transition-colors ${
+                      active ? "bg-white/15 text-white" : "text-white/70 hover:bg-white/[0.07]"
+                    }`}
+                  >
+                    {entryIcon(entry)}
+                    <span className="min-w-0 flex-1 truncate">{entry.name}</span>
+                    {entry.type === "file" && (
+                      <span className="shrink-0 text-[10px] text-white/30">{formatBytes(entry.size)}</span>
+                    )}
+                  </button>
+                );
+              })}
+            </div>
+          )}
+        </div>
+
+        {/* Preview pane */}
+        <div className="flex min-w-0 flex-1 flex-col">
+          {!selected ? (
+            <div className="flex flex-1 flex-col items-center justify-center gap-1 p-6 text-center">
+              <FileText className="h-5 w-5 text-white/20" />
+              <div className="text-xs text-white/40">Select a file to preview it.</div>
+              <div className="max-w-[220px] text-[10px] leading-relaxed text-white/25">
+                Text previews are capped by the API; binary files show a notice instead of content.
+              </div>
+            </div>
+          ) : (
+            <>
+              <div className="flex items-center gap-2 border-b border-white/10 bg-[#0f0f15] px-3 py-1.5">
+                <FileText className="h-3.5 w-3.5 shrink-0 text-white/40" />
+                <span className="min-w-0 flex-1 truncate font-mono text-[11px] text-white/70">
+                  {selectedName}
+                </span>
+                {file && <span className="shrink-0 text-[10px] text-white/30">{formatBytes(file.size)}</span>}
+                <button
+                  onClick={() => setSelected(undefined)}
+                  title="Close preview"
+                  className="grid h-5 w-5 place-items-center rounded text-white/40 hover:bg-white/10 hover:text-white"
+                >
+                  <X className="h-3 w-3" />
+                </button>
+              </div>
+
+              {fileLoading ? (
+                <div className="flex flex-1 items-center justify-center gap-2 p-6 text-xs text-white/40">
+                  <Loader2 className="h-4 w-4 animate-spin" /> Reading file…
+                </div>
+              ) : fileError ? (
+                <div className="flex flex-1 flex-col items-center justify-center gap-2 p-6 text-center">
+                  <AlertTriangle className="h-5 w-5 text-rose-400/70" />
+                  <div className="text-xs text-rose-300/90">{fileError}</div>
+                </div>
+              ) : file?.binary ? (
+                <div className="flex flex-1 flex-col items-center justify-center gap-2 p-6 text-center">
+                  <AlertTriangle className="h-5 w-5 text-amber-400/70" />
+                  <div className="text-xs text-white/60">Binary file — preview unavailable.</div>
+                  <div className="text-[10px] text-white/30">
+                    {formatBytes(file.size)} · detected as binary by the file API.
+                  </div>
+                </div>
+              ) : (
+                <div className="flex min-h-0 flex-1 flex-col">
+                  <pre className="min-h-0 flex-1 overflow-auto whitespace-pre-wrap break-words p-3 font-mono text-[11px] leading-relaxed text-white/75 scrollbar-thin">
+                    {file?.content ?? ""}
+                  </pre>
+                  {file?.truncated && (
+                    <div className="flex items-center gap-1.5 border-t border-amber-400/20 bg-amber-400/10 px-3 py-1.5 text-[10px] text-amber-200/80">
+                      <AlertTriangle className="h-3 w-3 shrink-0" />
+                      <span>
+                        Preview truncated at the {formatBytes(file.limit)} limit — showing the first{" "}
+                        {formatBytes(file.limit)} of {formatBytes(file.size)}.
+                      </span>
+                    </div>
+                  )}
+                </div>
+              )}
+            </>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+}
