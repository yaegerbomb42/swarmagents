diff --git a/apps/swarmagents/lib/client/useRunStream.test.ts b/apps/swarmagents/lib/client/useRunStream.test.ts
new file mode 100644
index 000000000..13bb2cdee
--- /dev/null
+++ b/apps/swarmagents/lib/client/useRunStream.test.ts
@@ -0,0 +1,50 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { getRunStreamBadge, type RunStreamItem } from "./useRunStream.js";
+
+function item(kind: string): RunStreamItem {
+  return { seq: 1, kind, data: {}, parsed: { data: "{}" }, ts: Date.now() };
+}
+
+test("maps connecting state", () => {
+  assert.deepEqual(
+    getRunStreamBadge({ status: "connecting", items: [], reconnectAttempt: 0 }),
+    { label: "connecting", tone: "connecting" },
+  );
+});
+
+test("maps connected state to live", () => {
+  assert.deepEqual(
+    getRunStreamBadge({ status: "connected", items: [item("assistant.text")], reconnectAttempt: 0 }),
+    { label: "live", tone: "live" },
+  );
+});
+
+test("maps reconnecting state with attempt number", () => {
+  assert.deepEqual(
+    getRunStreamBadge({ status: "reconnecting", items: [], reconnectAttempt: 3 }),
+    { label: "reconnecting (attempt 3)", tone: "reconnecting" },
+  );
+  assert.deepEqual(
+    getRunStreamBadge({ status: "reconnecting", items: [], reconnectAttempt: 0 }),
+    { label: "reconnecting (attempt 1)", tone: "reconnecting" },
+  );
+});
+
+test("maps terminal run events to ended", () => {
+  assert.deepEqual(
+    getRunStreamBadge({ status: "connected", items: [item("run.finished")], reconnectAttempt: 0 }),
+    { label: "ended", tone: "ended" },
+  );
+  assert.deepEqual(
+    getRunStreamBadge({ status: "reconnecting", items: [item("run.cancelled")], reconnectAttempt: 2 }),
+    { label: "ended", tone: "ended" },
+  );
+});
+
+test("maps run.error to error", () => {
+  assert.deepEqual(
+    getRunStreamBadge({ status: "connected", items: [item("run.error")], reconnectAttempt: 0, error: "boom" }),
+    { label: "error", tone: "error" },
+  );
+});
diff --git a/apps/swarmagents/lib/client/useRunStream.ts b/apps/swarmagents/lib/client/useRunStream.ts
index 8f69c6ab4..e77093f7a 100644
--- a/apps/swarmagents/lib/client/useRunStream.ts
+++ b/apps/swarmagents/lib/client/useRunStream.ts
@@ -40,6 +40,41 @@ export interface RunStreamState {
   status: RunStreamStatus;
   items: RunStreamItem[];
   error?: string;
+  /** 1-based reconnect attempt while status is reconnecting; 0 otherwise. */
+  reconnectAttempt: number;
+}
+
+export type RunStreamBadgeTone = "connecting" | "live" | "reconnecting" | "ended" | "error";
+
+export interface RunStreamBadge {
+  label: string;
+  tone: RunStreamBadgeTone;
+}
+
+function isTerminalEnd(item: RunStreamItem | undefined): boolean {
+  if (!item) return false;
+  return item.kind === "run.finished" || item.kind === "run.cancelled";
+}
+
+export function getRunStreamBadge(state: Pick<RunStreamState, "status" | "items" | "error" | "reconnectAttempt">): RunStreamBadge {
+  const last = state.items[state.items.length - 1];
+  if (last?.kind === "run.error") return { label: "error", tone: "error" };
+  if (isTerminalEnd(last)) return { label: "ended", tone: "ended" };
+
+  switch (state.status) {
+    case "idle":
+      return { label: "idle", tone: "ended" };
+    case "connecting":
+      return { label: "connecting", tone: "connecting" };
+    case "connected":
+      return { label: "live", tone: "live" };
+    case "reconnecting": {
+      const n = Math.max(1, state.reconnectAttempt || 1);
+      return { label: `reconnecting (attempt ${n})`, tone: "reconnecting" };
+    }
+    default:
+      return state.error ? { label: "error", tone: "error" } : { label: "connecting", tone: "connecting" };
+  }
 }
 
 const MAX_LINES = 2000;
