       if (!alive) return;
       const headers: Record<string, string> = {};
       if (lastIdRef.current) headers["Last-Event-ID"] = lastIdRef.current;
-      setStatus(attempt === 0 ? "connecting" : "reconnecting");
+      const reconnecting = attempt > 0;
+      setStatus(reconnecting ? "reconnecting" : "connecting");
+      setReconnectAttempt(reconnecting ? attempt : 0);
       try {
         const res = await fetch(`/api/runtime/stream/${encodeURIComponent(runId)}`, {
           headers,
@@ -102,6 +141,7 @@ export function useRunStream(runId?: string | null): RunStreamState {
         if (!res.ok || !res.body) throw new Error(`stream responded ${res.status}`);
         setStatus("connected");
         setError(undefined);
+        setReconnectAttempt(0);
         const reader = res.body.getReader();
         const decoder = new TextDecoder();
         for (;;) {
@@ -130,6 +170,7 @@ export function useRunStream(runId?: string | null): RunStreamState {
         setError(message);
         const delayMs = backoffDelayMs(attempt);
         attempt += 1;
+        setReconnectAttempt(attempt);
         timer = setTimeout(() => void connect(), delayMs);
       }
     };
@@ -141,8 +182,9 @@ export function useRunStream(runId?: string | null): RunStreamState {
       outer.abort();
       if (timer) clearTimeout(timer);
       setStatus("idle");
+      setReconnectAttempt(0);
     };
   }, [runId]);
 
-  return { status, items, error };
+  return { status, items, error, reconnectAttempt };
 }
