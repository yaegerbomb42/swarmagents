diff --git a/apps/swarmagents/minimalist-ui/src/components/ApprovalGate.tsx b/apps/swarmagents/minimalist-ui/src/components/ApprovalGate.tsx
new file mode 100644
index 000000000..ccc23ce28
--- /dev/null
+++ b/apps/swarmagents/minimalist-ui/src/components/ApprovalGate.tsx
@@ -0,0 +1,100 @@
+"use client";
+
+// ApprovalGate — renders the run's pending approval requests and lets the user
+// Allow or Deny them.
+//
+// The harness emits approval.required (with the tool, the flagged action —
+// already secret-scrubbed by the harness redactor before it ever reaches the
+// client — and the classifier's reason + risk level) and pauses the run until
+// a decision arrives at POST /api/runtime/approvals/{id}. A decision POSTed
+// here resolves that gate; the run stream's approval.resolved event then
+// removes the card (the reducer marks it resolved and only pending approvals
+// render). A decision is hidden optimistically on click and restored if the
+// API rejects it, so the button never appears to do nothing.
+
+import { useState } from "react";
+import { ShieldAlert } from "lucide-react";
+import { postApprovalDecision, type ApprovalDecision } from "../../../lib/client/approvals";
+import type { ApprovalEntry } from "../../../lib/client/runTimeline";
+
+export function ApprovalGate({ approvals }: { approvals: ApprovalEntry[] }) {
+  const [busyId, setBusyId] = useState<string | null>(null);
+  const [dismissed, setDismissed] = useState<Record<string, true>>({});
+  const [error, setError] = useState<string | null>(null);
+
+  const visible = approvals.filter((a) => a.status === "pending" && !dismissed[a.id]);
+  if (visible.length === 0) return null;
+
+  const decide = async (approval: ApprovalEntry, decision: ApprovalDecision) => {
+    if (busyId) return;
+    setBusyId(approval.id);
+    setError(null);
+    setDismissed((prev) => ({ ...prev, [approval.id]: true }));
+    const result = await postApprovalDecision(approval.id, decision);
+    if (!result.ok) {
+      // Restore the card so the user can retry.
+      setDismissed((prev) => {
+        const next = { ...prev };
+        delete next[approval.id];
+        return next;
+      });
+      setError(result.error ?? "decision failed");
+    }
+    setBusyId(null);
+  };
+
+  return (
+    <div className="mb-3 space-y-2">
+      {visible.map((a) => (
+        <div
+          key={a.id}
+          data-approval-id={a.id}
+          className="rounded-2xl border border-amber-400/30 bg-amber-400/[0.06] p-4"
+        >
+          <div className="flex flex-wrap items-center gap-2.5">
+            <ShieldAlert className="h-4 w-4 shrink-0 text-amber-300/90" />
+            <span className="text-sm text-white/90">Approval required</span>
+            <span
+              className={`rounded-full px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider ${
+                a.riskLevel === "deny"
+                  ? "bg-rose-400/10 text-rose-300/90"
+                  : "bg-amber-400/10 text-amber-300/90"
+              }`}
+            >
+              {a.riskLevel}
+            </span>
+            <span className="font-mono text-[10px] text-white/40">{a.tool}</span>
+          </div>
+          {a.action !== "" && (
+            <pre className="mt-2 max-h-40 overflow-y-auto whitespace-pre-wrap break-words rounded-xl bg-black/40 px-3 py-2 font-mono text-[11px] leading-relaxed text-amber-200/90">
+              {a.action}
+            </pre>
+          )}
+          {a.reason !== "" && <div className="mt-2 text-xs text-white/55">{a.reason}</div>}
+          <div className="mt-3 flex items-center gap-2">
+            <button
+              type="button"
+              disabled={busyId != null}
+              onClick={() => decide(a, "approve")}
+              className="rounded-xl bg-emerald-500/20 px-4 py-1.5 text-xs font-medium text-emerald-200 transition hover:bg-emerald-500/30 disabled:cursor-not-allowed disabled:opacity-50"
+            >
+              Allow
+            </button>
+            <button
+              type="button"
+              disabled={busyId != null}
+              onClick={() => decide(a, "deny")}
+              className="rounded-xl bg-rose-500/20 px-4 py-1.5 text-xs font-medium text-rose-200 transition hover:bg-rose-500/30 disabled:cursor-not-allowed disabled:opacity-50"
+            >
+              Deny
+            </button>
+            {busyId === a.id && <span className="font-mono text-[10px] text-white/40">sending…</span>}
+          </div>
+          {error && <div className="mt-2 font-mono text-[10px] text-rose-300/90">{error}</div>}
+        </div>
+      ))}
+    </div>
+  );
+}
+
+export default ApprovalGate;
