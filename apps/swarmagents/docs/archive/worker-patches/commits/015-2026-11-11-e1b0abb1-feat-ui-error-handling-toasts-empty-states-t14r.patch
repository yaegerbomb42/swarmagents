@@ -0,0 +1,83 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { describeFailure, toastReducer } from "./toasts.js";
+
+const t = (id: string, over: Partial<Parameters<typeof toastReducer>[0][number]> = {}) => ({
+  id,
+  tone: "error" as const,
+  message: "provider failed",
+  ...over,
+});
+
+test("add appends to an empty list", () => {
+  const next = toastReducer([], { type: "add", toast: t("1") });
+  assert.equal(next.length, 1);
+  assert.equal(next[0].id, "1");
+});
+
+test("add is immutable: returns a new array and leaves the old untouched", () => {
+  const before = [t("1")];
+  const next = toastReducer(before, { type: "add", toast: t("2") });
+  assert.notEqual(next, before);
+  assert.equal(before.length, 1);
+  assert.equal(next.length, 2);
+});
+
+test("dismiss removes the matching toast", () => {
+  const before = [t("1"), t("2"), t("3")];
+  const next = toastReducer(before, { type: "dismiss", id: "2" });
+  assert.deepEqual(
+    next.map((x) => x.id),
+    ["1", "3"]
+  );
+});
+
+test("dismiss with an unknown id leaves the list unchanged", () => {
+  const before = [t("1")];
+  const next = toastReducer(before, { type: "dismiss", id: "nope" });
+  assert.equal(next.length, 1);
+  assert.equal(next[0].id, "1");
+});
+
+test("dismiss is immutable: does not mutate the original list", () => {
+  const before = [t("1"), t("2")];
+  toastReducer(before, { type: "dismiss", id: "1" });
+  assert.equal(before.length, 2);
+});
+
+test("add then dismiss round-trips to empty", () => {
+  let state = toastReducer([], { type: "add", toast: t("a") });
+  state = toastReducer(state, { type: "add", toast: t("b") });
+  state = toastReducer(state, { type: "dismiss", id: "a" });
+  state = toastReducer(state, { type: "dismiss", id: "b" });
+  assert.equal(state.length, 0);
+});
+
+test("dismiss removes every toast with the matching id", () => {
+  const before = [t("x"), t("x")];
+  const next = toastReducer(before, { type: "dismiss", id: "x" });
+  assert.equal(next.length, 0);
+});
+
+test("describeFailure maps a fetch network error to a friendly label", () => {
+  const f = describeFailure(new Error("Failed to fetch"));
+  assert.equal(f.message, "Network error");
+  assert.equal(f.detail, "Could not reach the provider. Check your connection or API key.");
+});
+
+test("describeFailure maps a provider error to its message", () => {
+  const f = describeFailure(new Error("401 Unauthorized"));
+  assert.equal(f.message, "Provider error");
+  assert.equal(f.detail, "401 Unauthorized");
+});
+
+test("describeFailure maps an abort to 'Run stopped'", () => {
+  const f = describeFailure(new DOMException("aborted", "AbortError"));
+  assert.equal(f.message, "Run stopped");
+});
+
+test("describeFailure falls back for unknown thrown values", () => {
+  const f = describeFailure(undefined);
+  assert.equal(f.message, "Provider error");
+  assert.equal(f.detail, "unknown error");
+});
diff --git a/apps/swarmagents/lib/ui/toasts.ts b/apps/swarmagents/lib/ui/toasts.ts
new file mode 100644
index 000000000..1a65128ab
--- /dev/null
+++ b/apps/swarmagents/lib/ui/toasts.ts
@@ -0,0 +1,43 @@
+// t14r — toast model + reducer.
+//
+// Pure, dependency-free state logic for the dismissible toast UI. Kept outside the
+// React components so it is unit-testable under lib/**/*.test.ts and importable by
+// both the minimalist-ui app and any future surface.
+
+export type ToastTone = "info" | "error" | "success";
+
+export interface Toast {
+  id: string;
+  tone: ToastTone;
+  message: string;
+  /** Optional second line (e.g. provider name, detail). */
+  detail?: string;
+  /** TTL in ms; omit for a persistent toast (only manual dismiss). */
+  ttlMs?: number;
+}
+
+export type ToastAction =
+  | { type: "add"; toast: Toast }
+  | { type: "dismiss"; id: string };
+
+/** Immutable reducer over the visible toast list. */
+export function toastReducer(state: readonly Toast[], action: ToastAction): Toast[] {
+  switch (action.type) {
+    case "add":
+      return [...state, action.toast];
+    case "dismiss":
+      return state.filter((toast) => toast.id !== action.id);
+  }
+}
+
+/** Friendly label for a provider/network failure before it hits the toast. */
+export function describeFailure(err: unknown): { message: string; detail?: string } {
+  if (err instanceof Error && err.name === "AbortError") {
+    return { message: "Run stopped", detail: "The request was cancelled." };
+  }
+  const msg = err instanceof Error ? err.message : String(err ?? "unknown error");
+  if (!msg || msg === "Failed to fetch") {
+    return { message: "Network error", detail: "Could not reach the provider. Check your connection or API key." };
+  }
+  return { message: "Provider error", detail: msg };
+}
