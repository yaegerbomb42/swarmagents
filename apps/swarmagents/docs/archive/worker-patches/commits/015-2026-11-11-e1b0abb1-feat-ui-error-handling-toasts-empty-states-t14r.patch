diff --git a/apps/swarmagents/minimalist-ui/src/components/Toasts.tsx b/apps/swarmagents/minimalist-ui/src/components/Toasts.tsx
new file mode 100644
index 000000000..3fbe7da6e
--- /dev/null
+++ b/apps/swarmagents/minimalist-ui/src/components/Toasts.tsx
@@ -0,0 +1,103 @@
+import {
+  createContext,
+  useCallback,
+  useContext,
+  useReducer,
+  type ReactNode,
+} from "react";
+import { AlertTriangle, CheckCircle2, Info, X } from "lucide-react";
+import { toastReducer, type Toast, type ToastTone } from "../../../lib/ui/toasts";
+import { uid } from "../data";
+
+interface PushInput {
+  tone?: ToastTone;
+  message: string;
+  detail?: string;
+  ttlMs?: number;
+}
+
+interface ToastsValue {
+  toasts: Toast[];
+  push: (input: PushInput) => void;
+  dismiss: (id: string) => void;
+}
+
+const ToastsContext = createContext<ToastsValue | null>(null);
+
+const TONE_STYLE: Record<ToastTone, { icon: typeof Info; chip: string; label: string }> = {
+  error: { icon: AlertTriangle, chip: "text-red-400 bg-red-500/12 ring-red-500/25", label: "Error" },
+  success: { icon: CheckCircle2, chip: "text-emerald-400 bg-emerald-500/12 ring-emerald-500/25", label: "Success" },
+  info: { icon: Info, chip: "text-cyan-400 bg-cyan-500/12 ring-cyan-500/25", label: "Info" },
+};
+
+const DEFAULT_TTL = 8000;
+
+/**
+ * t14r — dismissible toast system for provider/network failures (and info/success).
+ * State lives in the pure lib/ui/toasts reducer; this component only wires it to React.
+ */
+export function ToastsProvider({ children }: { children: ReactNode }) {
+  const [toasts, dispatch] = useReducer(toastReducer, []);
+
+  const dismiss = useCallback((id: string) => dispatch({ type: "dismiss", id }), []);
+
+  const push = useCallback((input: PushInput) => {
+    const id = uid();
+    dispatch({ type: "add", toast: {
+      id,
+      tone: input.tone ?? "info",
+      message: input.message,
+      detail: input.detail,
+    } });
+    // Auto-dismiss unless the caller opted out with ttlMs: 0.
+    const ttl = input.ttlMs ?? DEFAULT_TTL;
+    if (ttl > 0) setTimeout(() => dispatch({ type: "dismiss", id }), ttl);
+  }, []);
+
+  return (
+    <ToastsContext.Provider value={{ toasts, push, dismiss }}>
+      {children}
+      {toasts.length > 0 && (
+        <div className="fixed right-4 top-4 z-[60] flex w-[min(92vw,22rem)] flex-col gap-2">
+          {toasts.map((toast) => {
+            const tone = TONE_STYLE[toast.tone];
+            const Icon = tone.icon;
+            return (
+              <div
+                key={toast.id}
+                role="alert"
+                className="glass-soft flex items-start gap-3 rounded-2xl px-4 py-3 shadow-[0_12px_40px_rgba(0,0,0,0.5)]"
+              >
+                <span className={`mt-0.5 grid h-7 w-7 shrink-0 place-items-center rounded-lg ring-1 ${tone.chip}`}>
+                  <Icon className="h-4 w-4" />
+                </span>
+                <div className="min-w-0 flex-1">
+                  <div className="text-xs font-medium text-white/90">
+                    <span className="mr-1.5 uppercase tracking-widest text-white/35">{tone.label}</span>
+                    {toast.message}
+                  </div>
+                  {toast.detail && (
+                    <div className="mt-0.5 break-words text-[11px] leading-relaxed text-white/50">{toast.detail}</div>
+                  )}
+                </div>
+                <button
+                  onClick={() => dismiss(toast.id)}
+                  aria-label="Dismiss notification"
+                  className="grid h-6 w-6 shrink-0 place-items-center rounded-full text-white/40 transition hover:bg-white/10 hover:text-white"
+                >
+                  <X className="h-3.5 w-3.5" />
+                </button>
+              </div>
+            );
+          })}
+        </div>
+      )}
+    </ToastsContext.Provider>
+  );
+}
+
+export function useToasts(): ToastsValue {
+  const ctx = useContext(ToastsContext);
+  if (!ctx) throw new Error("useToasts must be used within a ToastsProvider");
+  return ctx;
