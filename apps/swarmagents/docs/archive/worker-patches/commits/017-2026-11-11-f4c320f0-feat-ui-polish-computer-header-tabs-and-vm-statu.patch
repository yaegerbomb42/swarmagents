+  // Derive the VM status from the run stream's lifecycle events (plus any
+  // in-flight reset) so the header pill reflects the sandbox without new props.
+  let vmStatus: keyof typeof VM_STATUS_STYLES = "ready";
+  for (const item of stream.items) {
+    if (item.kind === "vm.starting") vmStatus = "booting";
+    else if (item.kind === "vm.ready") vmStatus = "ready";
+    else if (item.kind === "vm.error") vmStatus = "error";
+  }
+  if (vmResetting) vmStatus = "booting";
+  const vmStatusStyle = VM_STATUS_STYLES[vmStatus];
+
+  const tabRefs = useRef<Array<HTMLButtonElement | null>>([]);
+  const onTabKeyDown = (e: React.KeyboardEvent<HTMLDivElement>) => {
+    const current = VIEW_TABS.findIndex((tab) => tab.view === activeView);
+    let next: number;
+    switch (e.key) {
+      case "ArrowRight":
+        next = (current + 1) % VIEW_TABS.length;
+        break;
+      case "ArrowLeft":
+        next = (current - 1 + VIEW_TABS.length) % VIEW_TABS.length;
+        break;
+      case "Home":
+        next = 0;
+        break;
+      case "End":
+        next = VIEW_TABS.length - 1;
+        break;
+      default:
+        return;
+    }
+    e.preventDefault();
+    onToggleView(VIEW_TABS[next].view);
+    tabRefs.current[next]?.focus();
+  };
+
