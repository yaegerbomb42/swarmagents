+import { useEffect, useState } from 'react';
+import { ExternalLink, GitBranch } from 'lucide-react';
+
+interface HealthInfo {
+  version?: string;
+  commit?: string;
+}
+
+const GITHUB_URL = 'https://github.com/yaegerbomb42/monolith';
+
+export function SiteFooter() {
+  const [health, setHealth] = useState<HealthInfo>({});
+
+  useEffect(() => {
+    let cancelled = false;
+    fetch('/api/health', { cache: 'no-store' })
+      .then((res) => (res.ok ? res.json() : null))
+      .then((body) => {
+        if (!cancelled && body && typeof body === 'object') {
+          setHealth({
+            version: typeof body.version === 'string' ? body.version : undefined,
+            commit: typeof body.commit === 'string' ? body.commit : undefined,
+          });
+        }
+      })
+      .catch(() => null);
+    return () => {
+      cancelled = true;
+    };
+  }, []);
+
+  const version = health.version?.trim();
+  const commit = health.commit?.trim();
+  const shortCommit = commit && commit !== 'unknown' ? commit.slice(0, 7) : undefined;
+  const buildLabel = [version ? `v${version}` : undefined, shortCommit].filter(Boolean).join(' · ');
+
+  return (
+    <footer className="mt-2 w-full border-t border-white/10">
+      <div className="mx-auto flex w-full max-w-5xl flex-col items-center justify-between gap-2 px-1 py-3 font-mono text-[11px] text-white/40 sm:flex-row">
+        <span className="whitespace-nowrap">© SwarmAgents</span>
+        <div className="flex flex-wrap items-center justify-center gap-x-4 gap-y-1">
+          <a
+            href="/providers"
+            className="rounded transition-colors hover:text-cyan-300 active:text-cyan-200"
+          >
+            Providers
+          </a>
+          <a
+            href={GITHUB_URL}
+            target="_blank"
+            rel="noreferrer noopener"
+            className="inline-flex items-center gap-1 rounded transition-colors hover:text-cyan-300 active:text-cyan-200"
+          >
+            <GitBranch className="h-3 w-3" />
+            GitHub
+            <ExternalLink className="h-2.5 w-2.5 opacity-60" />
+          </a>
+          {buildLabel && (
+            <span className="whitespace-nowrap text-white/30" title={commit}>
+              {buildLabel}
+            </span>
+          )}
+        </div>
+      </div>
+    </footer>
+  );
+}
