new file mode 100644
index 000000000..92e1a54b9
--- /dev/null
+++ b/apps/swarmagents/lib/telemetry/usage.ts
@@ -0,0 +1,136 @@
+// t24 — usage & cost meter.
+//
+// Reads the durable runtime store (tasks + their run ledgers) and rolls usage into
+// all-time totals, per-run rows, per-day buckets and per-provider buckets. The data
+// comes from lib/runtime (the ledger is the source of truth for cost/tokens), so this
+// module is a thin, pure projection over what the runtime already persists.
+
+import { loadLedger, loadTasks } from "../runtime/store";
+import type { RunRecord, RunUsage } from "../runtime/types";
+
+export interface UsageTotals {
+  inputTokens: number;
+  outputTokens: number;
+  cachedTokens: number;
+  costUsd: number;
+  turns: number;
+  toolCalls: number;
+  wallMs: number;
+}
+
+export const EMPTY_TOTALS: UsageTotals = {
+  inputTokens: 0,
+  outputTokens: 0,
+  cachedTokens: 0,
+  costUsd: 0,
+  turns: 0,
+  toolCalls: 0,
+  wallMs: 0,
+};
+
+/** Fold a run's usage into an immutable totals accumulator. */
+function addTotals(a: UsageTotals, b: Partial<RunUsage>): UsageTotals {
+  return {
+    inputTokens: a.inputTokens + (b.inputTokens ?? 0),
+    outputTokens: a.outputTokens + (b.outputTokens ?? 0),
+    cachedTokens: a.cachedTokens + (b.cachedTokens ?? 0),
+    costUsd: a.costUsd + (b.costUsd ?? 0),
+    turns: a.turns + (b.turns ?? 0),
+    toolCalls: a.toolCalls + (b.toolCalls ?? 0),
+    wallMs: a.wallMs + (b.wallMs ?? 0),
+  };
+}
+
+/** Local calendar day for a timestamp, as YYYY-MM-DD. */
+export function dayKey(ts: number): string {
+  const d = new Date(ts);
+  const mm = String(d.getMonth() + 1).padStart(2, "0");
+  const dd = String(d.getDate()).padStart(2, "0");
+  return `${d.getFullYear()}-${mm}-${dd}`;
+}
+
+/** One run expanded with its usage totals (what the UI lists as "per run"). */
+export interface RunUsageRow extends UsageTotals {
+  runId: string;
+  taskId: string;
+  provider?: string;
+  model?: string;
+  status: RunRecord["status"];
+  startedAt: number;
+  endedAt?: number;
+}
+
+export interface DayUsage {
+  day: string;
+  runs: number;
+  totals: UsageTotals;
+}
+
+export interface ProviderUsage {
+  provider: string;
+  runs: number;
+  totals: UsageTotals;
+}
+
+export interface UsageSnapshot {
+  /** All-time totals across every run of every task. */
+  totals: UsageTotals;
+  /** Most recent runs first. */
+  perRun: RunUsageRow[];
+  /** Newest day first. */
+  perDay: DayUsage[];
+  /** Most spend first (then alphabetical). */
+  perProvider: ProviderUsage[];
+}
+
+/** Aggregate all recorded usage from the runtime store. */
+export function aggregateUsage(): UsageSnapshot {
+  const tasks = loadTasks();
+
+  let totals: UsageTotals = { ...EMPTY_TOTALS };
+  const perRun: RunUsageRow[] = [];
+  const dayMap = new Map<string, { runs: number; totals: UsageTotals }>();
+  const providerMap = new Map<string, { runs: number; totals: UsageTotals }>();
+
+  for (const task of tasks) {
+    const ledger = loadLedger(task.id);
+    for (const run of ledger.runs) {
+      perRun.push({
+        ...run.usage,
+        runId: run.id,
+        taskId: run.taskId,
+        provider: run.provider,
+        model: run.model,
+        status: run.status,
+        startedAt: run.startedAt,
+        endedAt: run.endedAt,
+      });
+
+      totals = addTotals(totals, run.usage);
+
+      const day = dayKey(run.startedAt);
+      const db = dayMap.get(day) ?? { runs: 0, totals: { ...EMPTY_TOTALS } };
+      db.runs += 1;
+      db.totals = addTotals(db.totals, run.usage);
+      dayMap.set(day, db);
+
+      const provider = run.provider ?? "unknown";
+      const pb = providerMap.get(provider) ?? { runs: 0, totals: { ...EMPTY_TOTALS } };
+      pb.runs += 1;
+      pb.totals = addTotals(pb.totals, run.usage);
+      providerMap.set(provider, pb);
+    }
+  }
+
+  perRun.sort((a, b) => b.startedAt - a.startedAt);
+
+  const perDay = [...dayMap.entries()]
+    .map(([day, v]) => ({ day, runs: v.runs, totals: v.totals }))
+    .sort((a, b) => b.day.localeCompare(a.day));
+
+  const perProvider = [...providerMap.entries()]
+    .map(([provider, v]) => ({ provider, runs: v.runs, totals: v.totals }))
+    .sort((a, b) => b.totals.costUsd - a.totals.costUsd || a.provider.localeCompare(b.provider));
+
+  return { totals, perRun, perDay, perProvider };
+}
