diff --git a/apps/swarmagents/app/api/runtime/vm/exec/route.test.ts b/apps/swarmagents/app/api/runtime/vm/exec/route.test.ts
new file mode 100644
index 000000000..3eeec3c6c
--- /dev/null
+++ b/apps/swarmagents/app/api/runtime/vm/exec/route.test.ts
@@ -0,0 +1,187 @@
+/**
+ * Tests for POST /api/runtime/vm/exec using the fake VM driver.
+ *
+ * The route runs the command through the RuntimeManager's VmManager (argv
+ * form), streams output to the telemetry bus under a "shell" run, and gates
+ * dangerous commands with the risk classifier. Auth is the middleware-set
+ * x-swarm-user header.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import { NextRequest } from "next/server";
+import { POST } from "./route";
+import { RuntimeManager, getRuntimeManager, setRuntimeManagerForTesting } from "../../../../../lib/runtime/manager";
+import { VmManager } from "../../../../../lib/vm/manager";
+import { FakeVmDriver } from "../../../../../lib/vm/fake-driver";
+import { telemetryBus } from "../../../../../lib/telemetry/index";
+import type { ExecOptions, ExecResult, VmHandle, VmDriver } from "../../../../../lib/vm/types";
+
+const sleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));
+
+/** A fake driver that records every exec call (argv form) for assertions. */
+class RecordingFakeVm extends FakeVmDriver {
+  calls: Array<{ cmd: string[]; opts: ExecOptions }> = [];
+  override async exec(h: VmHandle, cmd: string[], opts?: ExecOptions): Promise<ExecResult> {
+    this.calls.push({ cmd, opts: opts ?? {} });
+    if (opts?.signal?.aborted) return { exitCode: 130 };
+    return super.exec(h, cmd, opts);
+  }
+}
+
+function request(path: string, init: RequestInit = {}, user: string | null = "alice"): NextRequest {
+  const headers = new Headers(init.headers);
+  if (user !== null) headers.set("x-swarm-user", user);
+  return new NextRequest(`http://localhost${path}`, { ...init, headers, signal: init.signal ?? undefined });
+}
+
+function postExec(body: unknown, user: string | null = "alice"): Promise<Response> {
+  return POST(request("/api/runtime/vm/exec", { method: "POST", body: JSON.stringify(body) }, user));
+}
+
+async function json(res: Response): Promise<any> {
+  return res.json();
+}
+
+function install(driver: VmDriver): RuntimeManager {
+  const manager = new RuntimeManager({ vm: new VmManager({ customDriver: driver }) });
+  setRuntimeManagerForTesting(manager);
+  return manager;
+}
+
+async function waitForEvent(runId: string, type: string, timeoutMs = 2000): Promise<any> {
+  const events: any[] = [];
+  const start = Date.now();
+  const unsubscribe = telemetryBus.subscribe(runId, 0, (e) => events.push(e));
+  try {
+    while (!events.some((e) => e.type === type)) {
+      if (Date.now() - start > timeoutMs) throw new Error(`timed out waiting for ${type}`);
+      await sleep(5);
+    }
+    return events.find((e) => e.type === type)!;
+  } finally {
+    unsubscribe();
+  }
+}
+
+test.afterEach(() => {
+  setRuntimeManagerForTesting(null);
+});
+
+test("exec: auth guard returns 401", async () => {
+  install(new RecordingFakeVm());
+  const res = await postExec({ cmd: "ls" }, null);
+  assert.equal(res.status, 401);
+});
+
+test("exec: validation rejects bad bodies", async () => {
+  install(new RecordingFakeVm());
+  assert.equal((await postExec("not json")).status, 400);
+  assert.equal((await postExec([])).status, 400);
+  assert.equal((await postExec({})).status, 400);
+  assert.equal((await postExec({ cmd: "" })).status, 400);
+  assert.equal((await postExec({ cmd: "   " })).status, 400);
+  assert.equal((await postExec({ cmd: 42 })).status, 400);
+  assert.equal((await postExec({ cmd: [""] })).status, 400);
+  assert.equal((await postExec({ cmd: [42] })).status, 400);
+  assert.equal((await postExec({ cmd: "echo 'unterminated" })).status, 400);
+  assert.equal((await postExec({ cmd: "echo \0" })).status, 400);
+  assert.equal((await postExec({ cmd: ["a".repeat(3000)] })).status, 400);
+  assert.equal((await postExec({ cmd: Array.from({ length: 101 }, () => "x") })).status, 400);
+  assert.equal((await postExec({ cmd: "x".repeat(9000) })).status, 400);
+  assert.equal((await postExec({ cmd: "ls", extra: "y" })).status, 201);
+
+  const big = { cmd: "x".repeat(80 * 1024) };
+  assert.equal((await postExec(big)).status, 413);
+});
+
+test("exec: risk classifier refuses deny and ask commands without executing", async () => {
+  const driver = new RecordingFakeVm();
+  install(driver);
+
+  // deny: system credential files are off-limits.
+  const deny = await postExec({ cmd: "cat /etc/passwd" });
+  assert.equal(deny.status, 403);
+  assert.equal((await json(deny)).level, "deny");
+  assert.equal(driver.calls.length, 0);
+
+  // ask: destructive root deletion requires approval — refused from the
+  // terminal (take it to the agent prompt instead).
+  const ask = await postExec({ cmd: "rm -rf /" });
+  assert.equal(ask.status, 403);
+  assert.equal((await json(ask)).level, "ask");
+  assert.equal(driver.calls.length, 0);
+});
+
+test("exec: runs argv form via VmManager and streams to a shell run", async () => {
+  const driver = new RecordingFakeVm();
+  install(driver);
+
+  const res = await postExec({ cmd: 'echo "hello world" -n' });
+  assert.equal(res.status, 201);
+  const { runId } = await json(res);
+  assert.match(runId, /^run_[A-Za-z0-9_-]{1,64}$/);
+
+  // The driver got the tokenized argv (quotes stripped, args separate).
+  assert.equal(driver.calls.length, 1);
+  assert.deepEqual(driver.calls[0].cmd, ["echo", "hello world", "-n"]);
+
+  const started = await waitForEvent(runId, "shell.cmd");
+  assert.equal(started.data.command, 'echo "hello world" -n');
+  assert.deepEqual(started.data.argv, ["echo", "hello world", "-n"]);
+
+  const output = await waitForEvent(runId, "shell.output");
+  assert.equal(output.data.stream, "stdout");
+  assert.equal(output.data.text, "hello world -n\n");
+
+  const finished = await waitForEvent(runId, "run.finished");
+  assert.equal(finished.exitCode, 0);
+
+  // The run is owned by the user and listed with kind shell.
+  const manager = getRuntimeManager();
+  assert.ok(manager.ownsRun("alice", runId));
+  const runs = manager.list("alice");
+  const shell = runs.find((r) => r.runId === runId);
+  assert.equal(shell?.kind, "shell");
+  assert.equal(shell?.status, "finished");
+  assert.equal(shell?.exitCode, 0);
+  assert.equal(shell?.prompt, 'echo "hello world" -n');
+});
+
+test("exec: array cmd runs as-is", async () => {
+  const driver = new RecordingFakeVm();
+  install(driver);
+
+  const res = await postExec({ cmd: ["echo", "hi"] });
+  assert.equal(res.status, 201);
+  const { runId } = await json(res);
+  assert.deepEqual(driver.calls[0].cmd, ["echo", "hi"]);
+  await waitForEvent(runId, "run.finished");
+});
+
+test("exec: exec failure streams run.error on the shell run", async () => {
+  class FailingFakeVm extends FakeVmDriver {
+    override async exec(h: VmHandle, cmd: string[], opts?: ExecOptions): Promise<ExecResult> {
+      void h;
+      void cmd;
+      void opts;
+      throw new Error("boom");
+    }
+  }
+  install(new FailingFakeVm());
+
+  // The POST starts the run immediately (the exec runs in the background, like
+  // agent runs), so the failure surfaces as a run.error event on the bus.
+  const res = await postExec({ cmd: "ls" });
+  assert.equal(res.status, 201);
+  const { runId } = await json(res);
+  const error = await waitForEvent(runId, "run.error");
+  assert.match(error.message, /boom/);
+
+  const manager = getRuntimeManager();
+  const runs = manager.list("alice");
+  const shell = runs.find((r) => r.runId === runId);
+  assert.equal(shell?.kind, "shell");
+  assert.equal(shell?.status, "error");
+});
+
diff --git a/apps/swarmagents/app/api/runtime/vm/exec/route.ts b/apps/swarmagents/app/api/runtime/vm/exec/route.ts
new file mode 100644
index 000000000..3875dba8e
--- /dev/null
+++ b/apps/swarmagents/app/api/runtime/vm/exec/route.ts
@@ -0,0 +1,133 @@
+/**
+ * Terminal exec: run a single user-typed command in their VM.
+ *
+ * POST /api/runtime/vm/exec {cmd: string | string[]} -> {runId}
+ *
+ * - `cmd` may be a shell line ("ls -la") or an argv array (["ls", "-la"]).
+ *   Strings are split with a POSIX-like tokenizer (quotes/escapes honored).
+ * - Commands run through VmManager via argv — exactly like the harness's exec.
+ * - The risk classifier (lib/harness/risk) is applied first: deny-classified
+ *   commands never run; ask-classified ones (privileged, network-mutating,
+ *   destructive) are refused with a reason — take those to the agent prompt.
+ * - Output streams onto the telemetry bus under a dedicated "shell" run,
+ *   consumed by the client at /api/runtime/stream/[runId].
+ */
+
+import { NextResponse, type NextRequest } from "next/server";
+import { USER_HEADER } from "../../../../../lib/auth";
+import { getRuntimeManager } from "../../../../../lib/runtime/manager";
+import { classifyCommand } from "../../../../../lib/harness/risk";
+import {
+  tokenizeShellCommand,
+  shellCommandText,
+  SHELL_MAX_ARGS,
+  SHELL_MAX_ARG_LEN,
+  SHELL_MAX_CMD_LEN,
+} from "../../../../../lib/vm/argv";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+const MAX_BODY_SIZE = 64 * 1024;
+
+function caller(req: NextRequest): string | null {
+  const user = req.headers.get(USER_HEADER);
+  return user && user.length > 0 && user.length <= 128 ? user : null;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function unauthorized() {
+  return NextResponse.json({ error: "Sign in required." }, { status: 401 });
+}
+
+/** Normalize the body's cmd field into an argv array; returns a 400 message on failure. */
+function normalizeCmd(raw: unknown): { argv: string[]; source: string } | { error: string } {
+  if (typeof raw === "string") {
+    const trimmed = raw.trim();
+    if (!trimmed) return { error: "cmd is required." };
+    const argv = tokenizeShellCommand(trimmed);
+    if (!argv) return { error: "cmd has an unterminated quote." };
+    return { argv, source: trimmed };
+  }
+  if (Array.isArray(raw)) {
+    if (raw.length === 0) return { error: "cmd is required." };
+    const argv: string[] = [];
+    for (const item of raw) {
+      if (typeof item !== "string") return { error: "cmd array entries must be strings." };
+      if (item.length === 0) return { error: "cmd array entries must be non-empty." };
+      argv.push(item);
+    }
+    return { argv, source: shellCommandText(argv) };
+  }
+  return { error: "cmd must be a string or an array of strings." };
+}
+
+export async function POST(req: NextRequest) {
+  const user = caller(req);
+  if (!user) return unauthorized();
+
+  let text: string;
+  try {
+    text = await req.text();
+  } catch {
+    return NextResponse.json({ error: "Could not read request body." }, { status: 400 });
+  }
+  if (text.length > MAX_BODY_SIZE) {
+    return NextResponse.json({ error: "Request body too large." }, { status: 413 });
+  }
+
+  let body: unknown;
+  try {
+    body = JSON.parse(text);
+  } catch {
+    return NextResponse.json({ error: "Invalid JSON body." }, { status: 400 });
+  }
+  if (!isRecord(body)) {
+    return NextResponse.json({ error: "Body must be a JSON object." }, { status: 400 });
+  }
+
+  const normalized = normalizeCmd(body.cmd);
+  if ("error" in normalized) {
+    return NextResponse.json({ error: normalized.error }, { status: 400 });
+  }
+  const { argv, source } = normalized;
+
+  // Limits: no NUL bytes, sane arg count / lengths, and a total cap.
+  if (source.includes("\0")) {
+    return NextResponse.json({ error: "cmd contains NUL bytes." }, { status: 400 });
+  }
+  if (argv.length > SHELL_MAX_ARGS) {
+    return NextResponse.json({ error: `cmd has too many arguments (max ${SHELL_MAX_ARGS}).` }, { status: 400 });
+  }
+  for (const arg of argv) {
+    if (Buffer.byteLength(arg, "utf8") > SHELL_MAX_ARG_LEN) {
+      return NextResponse.json({ error: `an argument is too long (max ${SHELL_MAX_ARG_LEN} bytes).` }, { status: 400 });
+    }
+  }
+  if (source.length > SHELL_MAX_CMD_LEN) {
+    return NextResponse.json({ error: "cmd is too long." }, { status: 400 });
+  }
+
+  // Risk gate: deny never runs; ask (privileged/destructive/network) is
+  // refused with a reason — the terminal is for the user's own exploration,
+  // and anything a human needs approved belongs in the agent prompt.
+  const risk = classifyCommand(source);
+  if (risk.level === "deny" || risk.level === "ask") {
+    return NextResponse.json(
+      {
+        error:
+          risk.level === "deny"
+            ? risk.reason
+            : `${risk.reason} — refused from the terminal; run it through the agent prompt instead.`,
+        level: risk.level,
+      },
+      { status: 403 },
+    );
+  }
+
+  const { runId } = getRuntimeManager().execShell(user, argv, source);
+  return NextResponse.json({ runId }, { status: 201 });
+}
