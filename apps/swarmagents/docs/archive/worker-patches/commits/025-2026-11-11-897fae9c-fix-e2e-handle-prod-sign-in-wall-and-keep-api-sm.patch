diff --git a/apps/swarmagents/e2e/dispatch.spec.ts b/apps/swarmagents/e2e/dispatch.spec.ts
index 2fb33e8c1..1b68adab6 100644
--- a/apps/swarmagents/e2e/dispatch.spec.ts
+++ b/apps/swarmagents/e2e/dispatch.spec.ts
@@ -10,10 +10,10 @@ const readOnly = mode() === "prod";
 test(
   "dispatch: prompt streams log lines into the UI",
   { skip: readOnly ? "prod mode is read-only" : false },
-  async () => {
+  async (t) => {
     const testName = "dispatch: prompt streams log lines into the UI";
-    await runPageTest(testName, async ({ page }) => {
-      await openWorkspace(page);
+    const result = await runPageTest(testName, async ({ page, context }) => {
+      await openWorkspace(page, context);
 
       await page.getByRole("button", { name: /^Terminal$/ }).first().click();
       await page.getByText(/Isolated User Sandbox/).first().waitFor({ state: "visible", timeout: 15_000 });
@@ -26,5 +26,6 @@ test(
       await page.getByText(/first token/).first().waitFor({ state: "visible", timeout: 30_000 });
       await page.getByText(/done · \d+ tok/).first().waitFor({ state: "visible", timeout: 45_000 });
     });
+    if (result.skipped) t.skip(result.skipped);
   },
 );
diff --git a/apps/swarmagents/e2e/lib.ts b/apps/swarmagents/e2e/lib.ts
index 8da5fd00f..cf82a52f6 100644
--- a/apps/swarmagents/e2e/lib.ts
+++ b/apps/swarmagents/e2e/lib.ts
@@ -6,7 +6,7 @@ export type E2EMode = "local" | "prod";
 
 export interface SummaryEntry {
   test: string;
-  status: "passed" | "failed";
+  status: "passed" | "failed" | "skipped";
   error?: string;
   screenshot?: string;
 }
@@ -21,6 +21,13 @@ const DEFAULT_BASE_URL = "http://127.0.0.1:3777";
 const DEFAULT_SCREENSHOT_ROOT = "/workspace/monolith-playtest";
 const RUN_MARKER_TTL_MS = 60_000;
 
+export class UISkipError extends Error {
+  constructor(reason: string) {
+    super(reason);
+    this.name = "UISkipError";
+  }
+}
+
 export function mode(): E2EMode {
   return process.env.SWARM_E2E_MODE === "prod" ? "prod" : "local";
 }
@@ -142,7 +149,7 @@ export async function closeBrowser(): Promise<void> {
 export async function runPageTest(
   testName: string,
   fn: (ctx: PageTestContext) => Promise<void>,
-): Promise<void> {
+): Promise<{ skipped?: string }> {
   const browser = await getBrowser();
   const token = process.env.SWARM_HARNESS_TOKEN;
   const headers: Record<string, string> = token ? { authorization: `Bearer ${token}` } : {};
@@ -177,11 +184,15 @@ export async function runPageTest(
 
   const screenshot = path.join(screenshotDir(), `${slug(testName)}.png`);
   let failure: unknown;
+  let skipped: string | undefined;
   try {
     await fn({ page, context, consoleErrors });
   } catch (err) {
-    failure = err;
-    throw err;
+    if (err instanceof UISkipError) skipped = err.message;
+    else {
+      failure = err;
+      throw err;
+    }
   } finally {
     let captured: string | undefined;
     if (!page.isClosed()) {
@@ -193,21 +204,56 @@ export async function runPageTest(
     try {
       record({
         test: testName,
-        status: failure ? "failed" : "passed",
-        error: failure ? errorText(failure) : undefined,
+        status: failure ? "failed" : skipped ? "skipped" : "passed",
+        error: failure ? errorText(failure) : skipped,
         screenshot: captured,
       });
     } finally {
       await context.close().catch(() => undefined);
     }
   }
+
+  return skipped ? { skipped } : {};
+}
+
+export async function isLoginWall(page: Page): Promise<boolean> {
+  try {
+    const url = new URL(page.url());
+    if (url.pathname === "/login" || url.pathname.startsWith("/login/")) return true;
+  } catch {}
+  const loginForm = page.locator("form.login-form, .login-page, input[type='password']").first();
+  return loginForm.isVisible().catch(() => false);
+}
+
+async function tryAuthenticateReadOnly(context: BrowserContext): Promise<boolean> {
+  // Prod mode blocks non-GET page navigations; token-to-session exchange would
+  // require a supported API flow (e.g. POST) which is not available here.
+  void context;
+  return false;
+}
+
+export async function assertUIAccessible(page: Page, context: BrowserContext): Promise<void> {
+  if (mode() !== "prod") return;
+  if (!(await isLoginWall(page))) return;
+
+  const authed = await tryAuthenticateReadOnly(context);
+  if (authed) {
+    await page.goto("/", { waitUntil: "domcontentloaded" });
+    if (!(await isLoginWall(page))) return;
+  }
+
+  throw new UISkipError(
+    "UI skipped: prod sign-in wall detected at /login and no supported read-only token-to-session mechanism is available (bearer SWARM_HARNESS_TOKEN does not authenticate page navigations).",
+  );
 }
 
-export async function openWorkspace(page: Page): Promise<void> {
+export async function openWorkspace(page: Page, context?: BrowserContext): Promise<void> {
   const response = await page.goto("/", { waitUntil: "domcontentloaded" });
   if (!response) throw new Error("Home page returned no response");
   if (response.status() >= 400) throw new Error(`Home page returned HTTP ${response.status()}`);
 
+  if (context) await assertUIAccessible(page, context);
+
   await page.locator("textarea").first().waitFor({ state: "visible", timeout: 15_000 });
 
   const launch = page.getByRole("button", { name: "Launch Agent Workspace" });
