   assert.equal(describeFilesError(new Error("boom")), "boom");
   assert.equal(describeFilesError("weird"), "Could not load the VM filesystem.");
 });
+
+// --- Live file activity (l8) ---
+
+function streamItem(kind: string, data: unknown, ts: number): LiveStreamItemLike {
+  return { kind, data, ts };
+}
+
+function toolCall(id: string | undefined, name: string, input: unknown, ts: number): LiveStreamItemLike {
+  return streamItem("tool.call", { type: "tool.call", id, name, input }, ts);
+}
+
+function toolResult(id: string | undefined, ok: boolean, ts: number): LiveStreamItemLike {
+  return streamItem("tool.result", { type: "tool.result", id, ok, truncated: false, output: "" }, ts);
+}
+
+test("toolCallFilePath reads file_path, path, and notebook_path, and stays in the workspace", () => {
+  assert.equal(toolCallFilePath({ file_path: "/workspace/src/app.ts" }), "/workspace/src/app.ts");
+  assert.equal(toolCallFilePath({ file_path: "src/notes.md" }), "/workspace/src/notes.md");
+  assert.equal(toolCallFilePath({ path: "/workspace/a/b.txt" }), "/workspace/a/b.txt");
+  assert.equal(toolCallFilePath({ notebook_path: "/workspace/analysis.ipynb" }), "/workspace/analysis.ipynb");
+  assert.equal(toolCallFilePath({ command: "ls" }), undefined);
+  assert.equal(toolCallFilePath({}), undefined);
+  assert.equal(toolCallFilePath(null), undefined);
+  // Outside the workspace (or traversal) is not a FilesView path.
+  assert.equal(toolCallFilePath({ file_path: "/etc/passwd" }), undefined);
+  assert.equal(toolCallFilePath({ file_path: "../escape.txt" }), undefined);
+});
+
+test("extractLiveFileActivity pairs tool results with their calls by id", () => {
+  const activity = extractLiveFileActivity([
+    toolCall("c1", "Write", { file_path: "/workspace/a.txt", content: "hi" }, 1000),
+    toolCall("c2", "Edit", { file_path: "/workspace/b.ts", old_string: "a", new_string: "b" }, 1100),
+    toolResult("c1", true, 2000),
+    toolResult("c2", true, 2100),
+  ]);
+  assert.equal(activity.changes.length, 2);
+  assert.equal(activity.changes[0].path, "/workspace/a.txt");
+  assert.equal(activity.changes[0].tool, "Write");
+  assert.equal(activity.changes[0].editedAt, 2000);
+  assert.deepEqual(activity.changes[0].newTexts, []);
+  assert.equal(activity.changes[1].path, "/workspace/b.ts");
+  assert.deepEqual(activity.changes[1].newTexts, ["b"]);
+  assert.deepEqual(activity.changes[1].oldTexts, ["a"]);
+  assert.equal(activity.lastBashAt, undefined);
+});
+
+test("extractLiveFileActivity keeps MultiEdit edits in order and the latest edit per file", () => {
+  const activity = extractLiveFileActivity([
+    toolCall("c1", "MultiEdit", {
+      file_path: "/workspace/m.ts",
+      edits: [
+        { old_string: "one", new_string: "uno" },
+        { old_string: "two", new_string: "dos" },
+      ],
+    }, 1000),
+    toolResult("c1", true, 2000),
+    toolCall("c2", "Edit", { file_path: "/workspace/m.ts", old_string: "uno", new_string: "uno!" }, 3000),
+    toolResult("c2", true, 4000),
+  ]);
+  assert.equal(activity.changes.length, 1);
+  assert.deepEqual(activity.changes[0].newTexts, ["uno!"]);
+  assert.equal(activity.changes[0].editedAt, 4000);
+});
+
+test("extractLiveFileActivity ignores failed results, reads, and unmatched results", () => {
+  const activity = extractLiveFileActivity([
+    toolCall("c1", "Write", { file_path: "/workspace/fail.txt" }, 1000),
+    toolResult("c1", false, 2000),
+    toolCall("c2", "Read", { file_path: "/workspace/read.txt" }, 1100),
+    toolResult("c2", true, 2100),
+    toolResult("no-such-call", true, 2200),
+  ]);
+  assert.deepEqual(activity.changes, []);
+  assert.equal(activity.lastBashAt, undefined);
+});
+
+test("extractLiveFileActivity falls back to the most recent running write call without an id", () => {
+  const activity = extractLiveFileActivity([
+    toolCall(undefined, "Write", { file_path: "/workspace/noid.txt" }, 1000),
+    toolResult(undefined, true, 2000),
+  ]);
+  assert.equal(activity.changes.length, 1);
+  assert.equal(activity.changes[0].path, "/workspace/noid.txt");
+});
+
+test("extractLiveFileActivity records Bash results and NotebookEdit paths", () => {
+  const activity = extractLiveFileActivity([
+    toolCall("c1", "Bash", { command: "npm test" }, 1000),
+    toolResult("c1", true, 2000),
+    toolCall("c2", "NotebookEdit", { notebook_path: "/workspace/nb.ipynb" }, 1100),
+    toolResult("c2", true, 2100),
+  ]);
+  assert.equal(activity.lastBashAt, 2000);
+  assert.equal(activity.changes.length, 1);
+  assert.equal(activity.changes[0].path, "/workspace/nb.ipynb");
+  assert.equal(activity.changes[0].tool, "NotebookEdit");
+});
+
+test("findChangedLineRanges locates single and multi-line edits, skipping stale text", () => {
+  const content = "line one\nline two\nline three\nline four\n";
+  assert.deepEqual(findChangedLineRanges(content, ["line two"]), [{ startLine: 2, endLine: 2 }]);
+  assert.deepEqual(findChangedLineRanges(content, ["line two\nline three"]), [
+    { startLine: 2, endLine: 3 },
+  ]);
+  assert.deepEqual(findChangedLineRanges(content, ["line two", "line four"]), [
+    { startLine: 2, endLine: 2 },
+    { startLine: 4, endLine: 4 },
+  ]);
+  assert.deepEqual(findChangedLineRanges(content, ["gone"]), []);
+  assert.deepEqual(findChangedLineRanges(content, [""]), []);
+});
+
+test("formatEditedAgo counts seconds then minutes", () => {
+  assert.equal(formatEditedAgo(1000, 1000), "edited just now");
+  assert.equal(formatEditedAgo(1000, 4000), "edited just now");
+  assert.equal(formatEditedAgo(1000, 6000), "edited 5s ago");
+  assert.equal(formatEditedAgo(1000, 45000), "edited 44s ago");
+  assert.equal(formatEditedAgo(1000, 121000), "edited 2m ago");
+});
+
+test("live refresh debounce constants are the specified 500ms / 2s / 60s", () => {
+  assert.equal(LIVE_FILE_REFRESH_DEBOUNCE_MS, 500);
+  assert.equal(LIVE_BASH_REFRESH_DEBOUNCE_MS, 2000);
+  assert.equal(LIVE_EDIT_DOT_TTL_MS, 60_000);
+});
+
+test("debounce collapses rapid calls into one, and flush runs it early", (t) => {
+  t.mock.timers.enable({ apis: ["setTimeout"] });
+  try {
+    let calls = 0;
+    const debounced = debounce(() => {
+      calls += 1;
+    }, 500);
+    debounced();
+    debounced();
+    debounced();
+    t.mock.timers.tick(499);
+    assert.equal(calls, 0);
+    t.mock.timers.tick(1);
+    assert.equal(calls, 1);
+
+    // A fresh burst collapses again.
+    debounced();
+    t.mock.timers.tick(200);
+    debounced();
+    t.mock.timers.tick(499);
+    assert.equal(calls, 1);
+    t.mock.timers.tick(1);
+    assert.equal(calls, 2);
+
+    // flush runs the pending call immediately; cancel drops it.
+    debounced();
+    debounced.flush();
+    assert.equal(calls, 3);
+    debounced();
+    debounced.cancel();
+    t.mock.timers.tick(1000);
+    assert.equal(calls, 3);
+  } finally {
+    t.mock.timers.reset();
+  }
+});
