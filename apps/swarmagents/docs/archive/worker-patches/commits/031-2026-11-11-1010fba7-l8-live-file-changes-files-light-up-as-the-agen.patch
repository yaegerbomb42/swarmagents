+// ---------------------------------------------------------------------------
+// Live file activity
+//
+// While a run is live, the run stream reports tool.call / tool.result pairs.
+// These pure helpers turn that stream into the file activity FilesView
+// renders: which files the agent just wrote, where the edits landed, and
+// whether a shell command ran (which may have touched anything).
+// ---------------------------------------------------------------------------
+
+/** Tool names that write a file (path taken from the matching tool.call input). */
+export const LIVE_FILE_WRITE_TOOLS: ReadonlySet<string> = new Set([
+  "Write",
+  "Edit",
+  "MultiEdit",
+  "NotebookEdit",
+]);
+
+/** Tool names that run a shell command (may touch any file). */
+export const LIVE_BASH_TOOLS: ReadonlySet<string> = new Set(["Bash", "Terminal", "Shell", "cmd"]);
+
+/** Debounce before re-reading a directory after a write-tool result. */
+export const LIVE_FILE_REFRESH_DEBOUNCE_MS = 500;
+/** Debounce before a full refresh after a Bash tool result. */
+export const LIVE_BASH_REFRESH_DEBOUNCE_MS = 2000;
+/** How long a file keeps its "edited Ns ago" dot after the edit. */
+export const LIVE_EDIT_DOT_TTL_MS = 60_000;
+
+/** A 1-based inclusive line range inside a file preview. */
+export interface ChangedLineRange {
+  startLine: number;
+  endLine: number;
+}
+
+/** One file the agent touched during the current run. */
+export interface LiveFileChange {
+  /** Normalized workspace path. */
+  path: string;
+  /** Tool that wrote it (Write / Edit / MultiEdit / NotebookEdit). */
+  tool: string;
+  /** Wall-clock ms of the tool.result that confirmed the write. */
+  editedAt: number;
+  /** new_string values, in edit order (Edit: one; MultiEdit: one per edit). */
+  newTexts: string[];
+  /** old_string values, parallel to newTexts when present. */
+  oldTexts: string[];
+}
+
+/** Everything FilesView needs to render live activity for the current run. */
+export interface LiveFileActivity {
+  /** One entry per touched file, latest edit wins, in first-touch order. */
+  changes: LiveFileChange[];
+  /** Wall-clock ms of the latest successful Bash tool.result, if any. */
+  lastBashAt?: number;
+}
+
+/** Minimal shape of a run-stream item this module reads (see useRunStream). */
+export interface LiveStreamItemLike {
+  kind: string;
+  data: unknown;
+  ts: number;
+}
+
+function liveAsString(value: unknown): string | undefined {
+  return typeof value === "string" ? value : undefined;
+}
+
+/**
+ * The workspace path a tool call targets, or undefined when the input carries
+ * no usable path (or one outside /workspace). Mirrors the field order the
+ * harness risk classifier uses: file_path, then path, then notebook_path.
+ */
+export function toolCallFilePath(input: unknown): string | undefined {
+  const obj = asObject(input);
+  if (!obj) return undefined;
+  const raw =
+    liveAsString(obj.file_path) ?? liveAsString(obj.path) ?? liveAsString(obj.notebook_path);
+  if (!raw) return undefined;
+  try {
+    return normalizeWorkspacePath(raw);
+  } catch {
+    return undefined;
+  }
+}
+
+function editTextsOf(name: string, input: unknown): { newTexts: string[]; oldTexts: string[] } {
+  const obj = asObject(input);
+  if (!obj) return { newTexts: [], oldTexts: [] };
+  if (name === "Edit") {
+    const next = liveAsString(obj.new_string);
+    const prev = liveAsString(obj.old_string);
+    return {
+      newTexts: next !== undefined ? [next] : [],
+      oldTexts: prev !== undefined ? [prev] : [],
+    };
+  }
+  if (name === "MultiEdit") {
+    const newTexts: string[] = [];
+    const oldTexts: string[] = [];
+    const edits = Array.isArray(obj.edits) ? obj.edits : [];
+    for (const edit of edits) {
+      const entry = asObject(edit);
+      if (!entry) continue;
+      const next = liveAsString(entry.new_string);
+      const prev = liveAsString(entry.old_string);
+      if (next !== undefined) newTexts.push(next);
+      if (prev !== undefined) oldTexts.push(prev);
+    }
+    return { newTexts, oldTexts };
+  }
+  return { newTexts: [], oldTexts: [] };
+}
+
+/**
+ * Reduce run-stream items to live file activity. Each tool.result is paired
+ * with its tool.call (by id, else the most recent still-unmatched write/Bash
+ * call — the same pairing runTimeline uses for results that lost their id).
+ * Failed results (ok === false) wrote nothing and are ignored.
+ */
+export function extractLiveFileActivity(
+  items: readonly LiveStreamItemLike[],
+): LiveFileActivity {
+  const byId = new Map<string, { name: string; input: unknown }>();
+  const unmatched: Array<{ id: string; name: string; input: unknown }> = [];
+  const byPath = new Map<string, LiveFileChange>();
+  let lastBashAt: number | undefined;
+
+  for (const item of items) {
+    const data = asObject(item.data) ?? {};
+    if (item.kind === "tool.call") {
+      const name = liveAsString(data.name) ?? "tool";
+      const id = liveAsString(data.id);
+      // One object shared by both indexes so matching a result by id also
+      // removes it from the unmatched pool.
+      const call = { id: id ?? "", name, input: data.input };
+      if (id) byId.set(id, call);
+      unmatched.push(call);
+      continue;
+    }
+    if (item.kind !== "tool.result") continue;
+
+    const id = liveAsString(data.id);
+    let call = id ? byId.get(id) : undefined;
+    if (!call) {
+      // No id match: close the most recent still-unmatched write/Bash call.
+      for (let i = unmatched.length - 1; i >= 0; i -= 1) {
+        const candidate = unmatched[i];
+        if (LIVE_FILE_WRITE_TOOLS.has(candidate.name) || LIVE_BASH_TOOLS.has(candidate.name)) {
+          call = candidate;
+          break;
+        }
+      }
+    }
+    if (!call) continue;
+    // The call is now matched; drop it from the unmatched pool even when the
+    // result failed, so a later id-less result cannot claim it.
+    const dropIdx = unmatched.findIndex((c) => c === call);
+    if (dropIdx >= 0) unmatched.splice(dropIdx, 1);
+    // A failed result wrote nothing.
+    if (data.ok === false) continue;
+
+    if (LIVE_BASH_TOOLS.has(call.name)) {
+      lastBashAt = item.ts;
+      continue;
+    }
+    if (!LIVE_FILE_WRITE_TOOLS.has(call.name)) continue;
+    const path = toolCallFilePath(call.input);
+    if (!path) continue;
+    const { newTexts, oldTexts } = editTextsOf(call.name, call.input);
+    // Map.set on an existing key keeps its first-touch position; the value
+    // (latest edit) is what changes.
+    byPath.set(path, {
+      path,
+      tool: call.name,
+      editedAt: item.ts,
+      newTexts,
+      oldTexts,
+    });
+  }
+
+  return {
+    changes: [...byPath.values()],
+    ...(lastBashAt !== undefined ? { lastBashAt } : {}),
+  };
+}
+
+/**
+ * Locate each new_text inside the freshly read file content and return the
+ * 1-based line ranges it covers, so the preview can highlight what changed.
+ * Texts that no longer match the content (e.g. overwritten since) are skipped.
+ */
+export function findChangedLineRanges(content: string, newTexts: string[]): ChangedLineRange[] {
+  const ranges: ChangedLineRange[] = [];
+  let searchFrom = 0;
+  for (const text of newTexts) {
+    if (!text) continue;
+    const idx = content.indexOf(text, searchFrom);
+    if (idx < 0) continue;
+    const startLine = content.slice(0, idx).split("\n").length;
+    const endLine = startLine + text.split("\n").length - 1;
+    ranges.push({ startLine, endLine });
+    searchFrom = idx + text.length;
+  }
+  return ranges;
+}
+
+/** "edited just now" / "edited 5s ago" / "edited 2m ago" for the live dot. */
+export function formatEditedAgo(editedAt: number, now: number): string {
+  const seconds = Math.max(0, Math.floor((now - editedAt) / 1000));
+  if (seconds < 5) return "edited just now";
+  if (seconds < 60) return `edited ${seconds}s ago`;
+  return `edited ${Math.floor(seconds / 60)}m ago`;
+}
+
+/** A debounced callback: repeated calls within delayMs collapse into one. */
+export interface DebouncedFunction {
+  (): void;
+  cancel(): void;
+  /** Run the pending call now, if one is scheduled. */
+  flush(): void;
+}
+
+export function debounce(fn: () => void, delayMs: number): DebouncedFunction {
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  let pending = false;
+  const debounced = (() => {
+    pending = true;
+    if (timer !== undefined) clearTimeout(timer);
+    timer = setTimeout(() => {
+      timer = undefined;
+      pending = false;
+      fn();
+    }, delayMs);
+  }) as DebouncedFunction;
+  debounced.cancel = () => {
+    if (timer !== undefined) {
+      clearTimeout(timer);
+      timer = undefined;
+    }
+    pending = false;
+  };
+  debounced.flush = () => {
+    if (!pending) return;
+    debounced.cancel();
+    fn();
+  };
+  return debounced;
+}
+
