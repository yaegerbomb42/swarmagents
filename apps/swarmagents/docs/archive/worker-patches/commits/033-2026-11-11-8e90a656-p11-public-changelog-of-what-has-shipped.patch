--- /dev/null
+++ b/apps/swarmagents/app/changelog/page.tsx
@@ -0,0 +1,61 @@
+import type { Metadata } from "next";
+import { CHANGELOG } from "../../content/changelog";
+
+export const metadata: Metadata = {
+  title: "Changelog — SwarmAgents",
+  description: "What has shipped in SwarmAgents, newest first.",
+};
+
+// Rendered per request like the other public pages: the CSP nonce is minted
+// per request in middleware, so a statically prerendered copy could serve a
+// stale nonce.
+export const dynamic = "force-dynamic";
+
+/** Format an ISO date (YYYY-MM-DD) as e.g. "November 11, 2026". */
+function formatDate(iso: string): string {
+  const [year, month, day] = iso.split("-").map(Number);
+  return new Date(Date.UTC(year, month - 1, day)).toLocaleDateString("en-US", {
+    month: "long",
+    day: "numeric",
+    year: "numeric",
+    timeZone: "UTC",
+  });
+}
+
+/**
+ * Public changelog: what has shipped, grouped by ship date, newest first.
+ * Signed-out readable — /changelog is in the middleware PUBLIC set.
+ */
+export default function ChangelogPage() {
+  return (
+    <main className="min-h-dvh bg-black text-white">
+      <div className="mx-auto w-full max-w-2xl px-4 py-12 sm:px-6">
+        <a
+          href="/"
+          className="font-mono text-xs text-white/40 transition-colors hover:text-cyan-300"
+        >
+          ← SwarmAgents
+        </a>
+        <h1 className="mt-6 text-3xl font-semibold tracking-tight">Changelog</h1>
+        <p className="mt-2 text-sm leading-relaxed text-white/60">
+          What has shipped in SwarmAgents, newest first.
+        </p>
+        {CHANGELOG.map((release) => (
+          <section key={release.date} className="mt-10">
+            <h2 className="border-b border-white/10 pb-2 font-mono text-xs uppercase tracking-wider text-white/40">
+              <time dateTime={release.date}>{formatDate(release.date)}</time>
+            </h2>
+            <ul className="mt-4 space-y-6">
+              {release.entries.map((entry) => (
+                <li key={entry.title}>
+                  <h3 className="text-base font-medium">{entry.title}</h3>
+                  <p className="mt-1 text-sm leading-relaxed text-white/60">{entry.summary}</p>
+                </li>
+              ))}
+            </ul>
+          </section>
+        ))}
+      </div>
+    </main>
+  );
+}
diff --git a/apps/swarmagents/content/changelog.ts b/apps/swarmagents/content/changelog.ts
