@@ -0,0 +1,74 @@
+/**
+ * Public changelog content: user-visible work that has shipped, grouped by
+ * ship date, newest first. New releases go at the front of the list.
+ *
+ * Dates are the day the work landed on main. Where an exact day cannot be
+ * determined, entries are grouped under the week they shipped rather than
+ * given an invented precise date.
+ */
+
+export interface ChangelogEntry {
+  /** Short user-facing title, e.g. "Usage meter". */
+  title: string;
+  /** One or two sentences on what changed for the user. No internal task ids. */
+  summary: string;
+}
+
+export interface ChangelogRelease {
+  /** ISO date (YYYY-MM-DD) the group shipped. */
+  date: string;
+  entries: ChangelogEntry[];
+}
+
+export const CHANGELOG: ChangelogRelease[] = [
+  {
+    date: "2026-11-11",
+    entries: [
+      {
+        title: "Signed-in sessions",
+        summary:
+          "Sign in once and stay signed in with an expiring session. Sessions end automatically after a period of inactivity, and signing out clears them immediately.",
+      },
+      {
+        title: "Provider catalog and test-connection",
+        summary:
+          "Browse the available providers and their models from the Providers page, and test a connection before sending work to it so a bad key or unreachable endpoint shows up early.",
+      },
+      {
+        title: "Approvals",
+        summary:
+          "Sensitive actions now ask for your approval before they run, so nothing consequential happens without you saying yes first.",
+      },
+      {
+        title: "File browser",
+        summary:
+          "Browse and inspect the files in your workspace from the Files view, including what the agent has changed.",
+      },
+      {
+        title: "Usage meter",
+        summary:
+          "See how much you have used, live in the composer, so there are no surprises about where a run stands.",
+      },
+      {
+        title: "Snapshots",
+        summary:
+          "Save a snapshot of your workspace and restore it later from the Snapshots panel.",
+      },
+      {
+        title: "Live runs resume after a dropped connection",
+        summary:
+          "If the live stream drops, the run reconnects and resumes where it left off instead of starting over.",
+      },
+      {
+        title: "VM status indicator",
+        summary:
+          "The status bar now shows whether your workspace VM is starting, ready, or hibernated.",
+      },
+      {
+        title: "Security hardening",
+        summary:
+          "Hardened security headers, cross-site request protection, and rate limits on API calls are now in place behind the scenes.",
+      },
+    ],
+  },
+];
