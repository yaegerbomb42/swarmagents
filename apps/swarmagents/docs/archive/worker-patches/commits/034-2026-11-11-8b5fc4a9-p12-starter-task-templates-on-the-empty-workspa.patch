+/**
+ * Starter task templates (p12).
+ *
+ * Shown as tappable chips on the empty workspace so a brand-new signed-in
+ * user sees concrete things to try. Tapping a chip only FILLS the input —
+ * nothing here auto-submits.
+ */
+
+export interface StarterTemplate {
+  /** Stable id, used as the React key. */
+  id: string;
+  /** Short label shown on the chip. */
+  label: string;
+  /** Full prompt filled into the input when the chip is tapped. */
+  prompt: string;
+}
