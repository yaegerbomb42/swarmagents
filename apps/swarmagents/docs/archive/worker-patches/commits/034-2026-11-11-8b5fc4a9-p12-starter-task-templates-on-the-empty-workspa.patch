diff --git a/apps/swarmagents/minimalist-ui/src/components/StarterPrompts.tsx b/apps/swarmagents/minimalist-ui/src/components/StarterPrompts.tsx
new file mode 100644
index 000000000..2200aec35
--- /dev/null
+++ b/apps/swarmagents/minimalist-ui/src/components/StarterPrompts.tsx
@@ -0,0 +1,54 @@
+import { STARTER_TEMPLATES, type StarterTemplate } from '../templates';
+
+/**
+ * Window event fired when a starter chip is tapped somewhere that cannot
+ * call back into the input directly (e.g. the ComputerScreen terminal empty
+ * state). InputBar listens for it and fills the textarea.
+ */
+export const STARTER_PROMPT_EVENT = 'swarmagents:starter-prompt';
+
+export function dispatchStarterPrompt(prompt: string) {
+  if (typeof window === 'undefined') return;
+  window.dispatchEvent(
+    new CustomEvent<string>(STARTER_PROMPT_EVENT, { detail: prompt }),
+  );
+}
+
+/**
+ * Tappable starter-task chips for the empty workspace (p12). Clicking a chip
+ * calls `onSelect` with the template's full prompt — the caller fills the
+ * input so the user can edit it and press Send. Nothing auto-submits.
+ * Native buttons, so the chips are keyboard accessible (Tab + Enter/Space).
+ */
+export function StarterPrompts({
+  templates = STARTER_TEMPLATES,
+  onSelect,
+  className = '',
+}: {
+  templates?: StarterTemplate[];
+  /** Called with the template's full prompt. The caller fills the input; nothing auto-submits. */
+  onSelect: (prompt: string) => void;
+  className?: string;
+}) {
+  if (templates.length === 0) return null;
+  return (
+    <div className={className} role="group" aria-label="Starter tasks">
+      <div className="mb-2 text-[11px] font-medium tracking-wide text-white/40">
+        Try one of these to get started
+      </div>
+      <div className="flex flex-wrap gap-1.5">
+        {templates.map((t) => (
+          <button
+            key={t.id}
+            type="button"
+            onClick={() => onSelect(t.prompt)}
+            title={t.prompt}
+            className="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs text-white/70 transition hover:border-cyan-400/40 hover:bg-cyan-400/10 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400/70"
+          >
+            {t.label}
+          </button>
+        ))}
+      </div>
+    </div>
+  );
+}
