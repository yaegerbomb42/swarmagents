 apps/swarmagents/app/robots.ts              |  9 +++++++
 apps/swarmagents/app/sitemap.ts             | 18 +++++++++++++
 apps/swarmagents/lib/middleware.test.ts     |  8 ++++++
 apps/swarmagents/middleware.ts              |  4 +--
 5 files changed, 65 insertions(+), 2 deletions(-)
