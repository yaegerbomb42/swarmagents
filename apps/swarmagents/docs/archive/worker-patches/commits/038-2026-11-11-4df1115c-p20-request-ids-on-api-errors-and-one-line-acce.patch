+
+/** Mint a fresh request id. */
+export function newRequestId(): string {
+  return crypto.randomUUID();
+}
+
+/** Honor an inbound request id when it is a safe token; otherwise mint one. */
+export function resolveRequestId(inbound: string | null | undefined): string {
+  return isSafeRequestId(inbound) ? inbound : newRequestId();
