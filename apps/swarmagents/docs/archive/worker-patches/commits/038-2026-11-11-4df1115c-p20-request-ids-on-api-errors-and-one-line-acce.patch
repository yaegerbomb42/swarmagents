+
+/** The request id for a handler: the middleware-forwarded header, or a minted one when called directly. */
+export function requestIdFromHeaders(headers: Headers): string {
+  return resolveRequestId(headers.get(REQUEST_ID_HEADER));
+}
+
+/** One-way hash of a user id for the access log (never log the raw id). */
+export function hashUserId(userId: string | null | undefined): string {
+  if (!userId) return "anonymous";
+  return crypto.createHash("sha256").update(userId).digest("hex").slice(0, 12);
+}
+
+/** JSON error body carrying the request id, so a client can quote it to support. */
+export function errorBody(requestId: string, error: string): { error: string; requestId: string } {
+  return { error, requestId };
