diff --git a/apps/swarmagents/lib/request-id.test.ts b/apps/swarmagents/lib/request-id.test.ts
new file mode 100644
index 000000000..6f21a89cd
--- /dev/null
+++ b/apps/swarmagents/lib/request-id.test.ts
@@ -0,0 +1,97 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  REQUEST_ID_HEADER,
+  errorBody,
+  errorResponse,
+  formatAccessLog,
+  hashUserId,
+  isSafeRequestId,
+  newRequestId,
+  requestIdFromHeaders,
+  resolveRequestId,
+} from "./request-id";
+
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;
+
+test("isSafeRequestId accepts plain tokens and rejects anything injectable", () => {
+  assert.equal(isSafeRequestId("abc-123_XYZ"), true);
+  assert.equal(isSafeRequestId("a"), true);
+  assert.equal(isSafeRequestId("x".repeat(128)), true);
+  assert.equal(isSafeRequestId(""), false);
+  assert.equal(isSafeRequestId("has space"), false);
+  assert.equal(isSafeRequestId("bad\nid"), false);
+  assert.equal(isSafeRequestId("bad\rid"), false);
+  assert.equal(isSafeRequestId("bad:id"), false);
+  assert.equal(isSafeRequestId("x".repeat(129)), false);
+  assert.equal(isSafeRequestId(null), false);
+  assert.equal(isSafeRequestId(undefined), false);
+});
+
+test("resolveRequestId reuses a provided safe token and mints a UUID otherwise", () => {
+  assert.equal(resolveRequestId("req_test_123"), "req_test_123");
+  const minted = resolveRequestId("has space");
+  assert.match(minted, UUID);
+  assert.match(resolveRequestId(null), UUID);
+  assert.match(resolveRequestId(undefined), UUID);
+  // Two minted ids differ.
+  assert.notEqual(newRequestId(), newRequestId());
+});
+
+test("requestIdFromHeaders reads the forwarded header and mints one when absent", () => {
+  const withHeader = new Headers({ [REQUEST_ID_HEADER]: "req_from_middleware" });
+  assert.equal(requestIdFromHeaders(withHeader), "req_from_middleware");
+  assert.match(requestIdFromHeaders(new Headers()), UUID);
+  // An unsafe forwarded value is replaced, never echoed. (CR/LF values
+  // cannot even reach this code: the Headers implementation rejects them.)
+  const unsafe = new Headers({ [REQUEST_ID_HEADER]: "bad id" });
+  const replaced = requestIdFromHeaders(unsafe);
+  assert.match(replaced, UUID);
+  assert.ok(!replaced.includes(" "));
+});
+
+test("errorResponse carries the request id and echoes a provided safe token", async () => {
+  const withId = new Request("http://localhost/api/x", { headers: { [REQUEST_ID_HEADER]: "req_echo_me" } });
+  const res = errorResponse(withId, "prompt is required.", 400);
+  assert.equal(res.status, 400);
+  assert.deepEqual(await res.json(), { error: "prompt is required.", requestId: "req_echo_me" });
+
+  const withoutId = new Request("http://localhost/api/x");
+  const minted = errorResponse(withoutId, "boom", 500);
+  assert.equal(minted.status, 500);
+  const body = (await minted.json()) as { error: string; requestId: string };
+  assert.equal(body.error, "boom");
+  assert.match(body.requestId, UUID);
+});
+
+test("errorBody shapes the JSON error payload", () => {
+  assert.deepEqual(errorBody("req_1", "nope"), { error: "nope", requestId: "req_1" });
+});
+
+test("hashUserId is a stable short hash and never returns the raw id", () => {
+  assert.equal(hashUserId(null), "anonymous");
+  assert.equal(hashUserId(undefined), "anonymous");
+  assert.equal(hashUserId(""), "anonymous");
+  const a = hashUserId("alice");
+  const b = hashUserId("alice");
+  assert.equal(a, b);
+  assert.match(a, /^[0-9a-f]{12}$/);
+  assert.ok(!a.includes("alice"));
+  assert.notEqual(hashUserId("alice"), hashUserId("bob"));
+});
+
+test("formatAccessLog is one line with method, path, status, duration, requestId and user hash", () => {
+  const line = formatAccessLog({
+    method: "POST",
+    path: "/api/runtime/tasks",
+    status: 400,
+    durationMs: 12,
+    requestId: "req_abc",
+    userHash: "deadbeefcafe",
+  });
+  assert.ok(!line.includes("\n"), "access log must stay on one line");
+  assert.equal(
+    line,
+    "[access] method=POST path=/api/runtime/tasks status=400 durationMs=12 requestId=req_abc userHash=deadbeefcafe",
+  );
+});
diff --git a/apps/swarmagents/lib/request-id.ts b/apps/swarmagents/lib/request-id.ts
new file mode 100644
index 000000000..416ef9b34
--- /dev/null
+++ b/apps/swarmagents/lib/request-id.ts
@@ -0,0 +1,81 @@
+/**
+ * Request ids: correlate API errors with the access log.
+ *
+ * The middleware honors an inbound `x-request-id` when it is a safe token
+ * (bounded, no whitespace or control characters — it is echoed back in a
+ * response header and into JSON error bodies, so it must not carry CR/LF or
+ * other header-injection characters) and mints a UUID otherwise. Route
+ * handlers read the id the middleware forwarded and include it in JSON
+ * error bodies; the access log records the same id, so support can trace a
+ * failure from the JSON a user pastes to the server log line.
+ *
+ * Never log tokens or bodies here: the access log carries only method,
+ * path, status, duration, the request id, and a hash of the user id.
+ */
+
+import crypto from "node:crypto";
+import { NextResponse } from "next/server";
+
+/** The request-id header, read inbound and set on every response. */
+export const REQUEST_ID_HEADER = "x-request-id";
+
+/** Safe request-id tokens: 1-128 chars of [A-Za-z0-9_-]. Anything else is replaced with a minted id. */
+const SAFE_TOKEN = /^[A-Za-z0-9_-]{1,128}$/;
+
+/** True when the value may be echoed back as a request id. */
+export function isSafeRequestId(value: string | null | undefined): value is string {
+  return typeof value === "string" && SAFE_TOKEN.test(value);
