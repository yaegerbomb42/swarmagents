+
+/** JSON error response carrying the request id (tiny helper for route handlers). */
+export function errorResponse(request: Request, message: string, status: number): NextResponse {
+  return NextResponse.json(errorBody(requestIdFromHeaders(request.headers), message), { status });
+}
+
+export interface AccessLogEntry {
+  method: string;
+  path: string;
+  status: number;
+  durationMs: number;
+  requestId: string;
+  userHash: string;
+}
+
+/** One single-line access-log entry. Key=value, no tokens, no bodies, no query strings. */
+export function formatAccessLog(entry: AccessLogEntry): string {
+  return [
+    "[access]",
+    `method=${entry.method}`,
+    `path=${entry.path}`,
+    `status=${entry.status}`,
+    `durationMs=${entry.durationMs}`,
+    `requestId=${entry.requestId}`,
+    `userHash=${entry.userHash}`,
+  ].join(" ");
+}
