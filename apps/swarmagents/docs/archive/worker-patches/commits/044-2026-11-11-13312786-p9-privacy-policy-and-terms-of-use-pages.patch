+import type { Metadata } from "next";
+import type { CSSProperties } from "react";
+
+export const metadata: Metadata = {
+  title: "Privacy Policy — SwarmAgents",
+  description:
+    "How SwarmAgents collects, stores, and protects your account, prompts, run logs, and workspace data.",
+};
+
+/**
+ * Privacy Policy. Plain, dated copy — no lorem ipsum. SwarmAgents runs a
+ * user-owned VM and stores prompts, run logs, and an account email, so this
+ * page says exactly what is kept, where it lives, and how to get it deleted.
+ * Public: middleware lists /privacy as a PUBLIC route so signed-out visitors
+ * can read it.
+ */
+
+const mainStyle: CSSProperties = {
+  minHeight: "100vh",
+  background: "var(--color-bg)",
+  color: "var(--color-text)",
+  fontFamily: "var(--font-sans)",
+  padding: "var(--space-8) var(--space-4) var(--space-16)",
+  boxSizing: "border-box",
+};
+
+const articleStyle: CSSProperties = {
+  maxWidth: 680,
+  margin: "0 auto",
+  lineHeight: "var(--line-height-normal)",
+};
+
+const h1Style: CSSProperties = {
+  fontSize: "var(--type-size-4)",
+  lineHeight: "var(--line-height-tight)",
+  margin: "0 0 var(--space-2)",
+  fontWeight: "var(--type-weight-semibold)",
+};
+
+const metaStyle: CSSProperties = {
+  color: "var(--color-text-muted)",
+  fontSize: "var(--type-size-0)",
+  margin: "0 0 var(--space-8)",
+};
+
+const h2Style: CSSProperties = {
+  fontSize: "var(--type-size-2)",
+  margin: "var(--space-8) 0 var(--space-3)",
+  fontWeight: "var(--type-weight-semibold)",
+};
+
+const pStyle: CSSProperties = {
+  margin: "0 0 var(--space-4)",
+  fontSize: "var(--type-size-1)",
+  color: "var(--color-text)",
+};
+
+const listStyle: CSSProperties = {
+  margin: "0 0 var(--space-4)",
+  paddingLeft: "var(--space-5)",
+  fontSize: "var(--type-size-1)",
+};
+
+const linkStyle: CSSProperties = {
+  color: "var(--color-focus)",
+  textDecoration: "underline",
+  textUnderlineOffset: 3,
+};
+
+const navStyle: CSSProperties = {
+  display: "flex",
+  flexWrap: "wrap",
+  gap: "var(--space-4)",
+  marginTop: "var(--space-12)",
+  paddingTop: "var(--space-6)",
+  borderTop: "1px solid var(--color-line)",
+  fontSize: "var(--type-size-0)",
+  color: "var(--color-text-muted)",
+};
+
+export default function PrivacyPage() {
+  return (
+    <main style={mainStyle}>
+      <article style={articleStyle}>
+        <h1 style={h1Style}>Privacy Policy</h1>
+        <p style={metaStyle}>
+          Last updated: November 2026 · SwarmAgents is operated from Illinois,
+          United States.
+        </p>
+
+        <p style={pStyle}>
+          SwarmAgents is a preview product. It gives you a personal agent that
+          runs on a virtual machine you own, with access to your files, tools,
+          and the providers you connect. This policy explains what we store,
+          why we store it, and how to get it deleted. If anything here changes,
+          the date above changes with it.
+        </p>
+
+        <h2 style={h2Style}>What we store</h2>
+        <ul style={listStyle}>
+          <li>
+            <strong>Account email.</strong> The email address you sign up with,
+            used to identify your account and keep your sessions separate from
+            other users.
+          </li>
+          <li>
+            <strong>Prompts.</strong> The messages you send to the agent, kept
+            so your conversation history and runs can be shown back to you.
+          </li>
+          <li>
+            <strong>Run logs.</strong> Records of what the agent did — tool
+            calls, file changes, and run status — kept so you can review, resume,
+            and audit past runs.
+          </li>
+          <li>
+            <strong>Workspace volumes.</strong> The files in your agent&apos;s
+            workspace, including anything the agent creates or edits on your
+            behalf. This is your data, stored on the VM that runs your agent.
+          </li>
+          <li>
+            <strong>Session cookies.</strong> A signed session cookie in your
+            browser keeps you signed in. It identifies your session only; it
+            carries no tracking identifiers and is not shared with advertisers.
+          </li>
+        </ul>
+
+        <h2 style={h2Style}>Provider keys</h2>
+        <p style={pStyle}>
+          API keys for model and tool providers (for example, your provider
+          keys) are stored on the server and used only to call those providers
+          on your behalf. They are never sent to your browser, never shown in
+          the interface, and never shared with any other party.
+        </p>
+
+        <h2 style={h2Style}>What we do not do</h2>
+        <p style={pStyle}>
+          We do not sell your data. We do not share your prompts, run logs,
+          workspace files, or account email with advertisers or data brokers.
+          Your data is sent to the model and tool providers you have connected
+          only as needed to carry out your requests, and to no one else.
+        </p>
+
+        <h2 style={h2Style}>How long we keep it</h2>
+        <p style={pStyle}>
+          Your account data, prompts, run logs, and workspace volumes are kept
+          while your account is active, so your history and work remain
+          available to you. Session cookies expire as described in the sign-in
+          flow; signing out ends the session.
+        </p>
+
+        <h2 style={h2Style}>Deletion</h2>
+        <p style={pStyle}>
+          You can request deletion of your account and all data associated
+          with it at any time, from the account settings in the app or by
+          contacting the operator directly. Deleting your account removes your
+          prompts, run logs, workspace volumes, and account email from our
+          servers. Backups, if any, are purged on their normal rotation cycle.
+        </p>
+
+        <h2 style={h2Style}>Preview status</h2>
+        <p style={pStyle}>
+          SwarmAgents is in preview. Features, storage, and this policy may
+          change as the product develops. We will update the date at the top of
+          this page when they do, and we will not quietly expand what we
+          collect.
+        </p>
+
+        <h2 style={h2Style}>Contact</h2>
+        <p style={pStyle}>
+          SwarmAgents is operated from Illinois, United States. Questions about
+          this policy can be sent to the operator through the support channel
+          listed in the app.
+        </p>
+
+        <nav style={navStyle} aria-label="Legal">
+          <a href="/terms" style={linkStyle}>
+            Terms of Use
+          </a>
+          <a href="/login" style={linkStyle}>
+            Sign in
+          </a>
+          <a href="/" style={linkStyle}>
+            Home
+          </a>
+        </nav>
+      </article>
+    </main>
+  );
+}
