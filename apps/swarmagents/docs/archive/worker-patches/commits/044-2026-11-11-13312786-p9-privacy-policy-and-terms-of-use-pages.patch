+import type { Metadata } from "next";
+import type { CSSProperties } from "react";
+
+export const metadata: Metadata = {
+  title: "Terms of Use — SwarmAgents",
+  description:
+    "The terms for using SwarmAgents: what the service is, what you are responsible for, and the limits of a preview product.",
+};
+
+/**
+ * Terms of Use. Plain, dated copy — no lorem ipsum. Covers the preview nature
+ * of the product, the user-owned VM, acceptable use, and the limits of
+ * liability for an agent that can run code and change files on your behalf.
+ * Public: middleware lists /terms as a PUBLIC route so signed-out visitors
+ * can read it.
+ */
+
+const mainStyle: CSSProperties = {
+  minHeight: "100vh",
+  background: "var(--color-bg)",
+  color: "var(--color-text)",
+  fontFamily: "var(--font-sans)",
+  padding: "var(--space-8) var(--space-4) var(--space-16)",
+  boxSizing: "border-box",
+};
+
+const articleStyle: CSSProperties = {
+  maxWidth: 680,
+  margin: "0 auto",
+  lineHeight: "var(--line-height-normal)",
+};
+
+const h1Style: CSSProperties = {
+  fontSize: "var(--type-size-4)",
+  lineHeight: "var(--line-height-tight)",
+  margin: "0 0 var(--space-2)",
+  fontWeight: "var(--type-weight-semibold)",
+};
+
+const metaStyle: CSSProperties = {
+  color: "var(--color-text-muted)",
+  fontSize: "var(--type-size-0)",
+  margin: "0 0 var(--space-8)",
+};
+
+const h2Style: CSSProperties = {
+  fontSize: "var(--type-size-2)",
+  margin: "var(--space-8) 0 var(--space-3)",
+  fontWeight: "var(--type-weight-semibold)",
+};
+
+const pStyle: CSSProperties = {
+  margin: "0 0 var(--space-4)",
+  fontSize: "var(--type-size-1)",
+  color: "var(--color-text)",
+};
+
+const listStyle: CSSProperties = {
+  margin: "0 0 var(--space-4)",
+  paddingLeft: "var(--space-5)",
+  fontSize: "var(--type-size-1)",
+};
+
+const linkStyle: CSSProperties = {
+  color: "var(--color-focus)",
+  textDecoration: "underline",
+  textUnderlineOffset: 3,
+};
+
+const navStyle: CSSProperties = {
+  display: "flex",
+  flexWrap: "wrap",
+  gap: "var(--space-4)",
+  marginTop: "var(--space-12)",
+  paddingTop: "var(--space-6)",
+  borderTop: "1px solid var(--color-line)",
+  fontSize: "var(--type-size-0)",
+  color: "var(--color-text-muted)",
+};
+
+export default function TermsPage() {
+  return (
+    <main style={mainStyle}>
+      <article style={articleStyle}>
+        <h1 style={h1Style}>Terms of Use</h1>
+        <p style={metaStyle}>
+          Last updated: November 2026 · SwarmAgents is operated from Illinois,
+          United States.
+        </p>
+
+        <p style={pStyle}>
+          These terms govern your use of SwarmAgents. By creating an account or
+          using the service, you agree to them. If you do not agree, do not use
+          the service.
+        </p>
+
+        <h2 style={h2Style}>What SwarmAgents is</h2>
+        <p style={pStyle}>
+          SwarmAgents gives you a personal coding agent that runs on a virtual
+          machine you own. The agent can read and write files in your
+          workspace, run commands, call the model and tool providers you
+          connect, and browse the web on your behalf. You stay in control:
+          you choose what the agent can access, and you can review its runs and
+          stop it at any time.
+        </p>
+
+        <h2 style={h2Style}>Preview status</h2>
+        <p style={pStyle}>
+          SwarmAgents is in preview. The service may change, break, or become
+          temporarily unavailable without notice, and features may be added,
+          changed, or removed. Do not rely on it as your only copy of anything
+          important — keep your own backups of work that matters.
+        </p>
+
+        <h2 style={h2Style}>Your account</h2>
+        <p style={pStyle}>
+          You are responsible for keeping your account credentials safe and for
+          everything done under your account. Your provider API keys stay on
+          the server and are used only to call those providers on your behalf;
+          you are responsible for the usage and charges those keys incur with
+          the providers themselves. Tell the operator promptly if you believe
+          your account has been compromised.
+        </p>
+
+        <h2 style={h2Style}>Your responsibilities</h2>
+        <ul style={listStyle}>
+          <li>
+            Use the service only for lawful purposes, and only in ways that
+            respect the rights of others.
+          </li>
+          <li>
+            Do not use the agent to harm, harass, or deceive anyone; to break
+            into systems you do not own; or to produce or distribute illegal
+            content.
+          </li>
+          <li>
+            Do not try to circumvent the service&apos;s security, rate limits,
+            or access controls, and do not resell or share your access in a way
+            that lets others use the service through your account.
+          </li>
+          <li>
+            Review what the agent does. The agent acts on your instructions,
+            and you are responsible for the changes it makes to your workspace
+            and the requests it sends to your connected providers.
+          </li>
+        </ul>
+
+        <h2 style={h2Style}>Your content</h2>
+        <p style={pStyle}>
+          You own your prompts, your workspace files, and everything the agent
+          creates for you. We store that content only to operate the service
+          for you, as described in the{" "}
+          <a href="/privacy" style={linkStyle}>
+            Privacy Policy
+          </a>
+          . We do not claim ownership of it, and we do not sell it.
+        </p>
+
+        <h2 style={h2Style}>What the agent may do — and what it may get wrong</h2>
+        <p style={pStyle}>
+          An agent that can run code and edit files can make mistakes: it can
+          delete or overwrite files, run commands with unintended effects, or
+          produce incorrect output. That is the nature of the tool. You accept
+          that risk when you give the agent access to a workspace or provider,
+          and you should keep backups and review run logs before relying on
+          its output.
+        </p>
+
+        <h2 style={h2Style}>Availability and liability</h2>
+        <p style={pStyle}>
+          The service is provided &ldquo;as is&rdquo;, without warranties of any
+          kind, express or implied, including merchantability, fitness for a
+          particular purpose, and non-infringement. To the fullest extent
+          permitted by law, the operator is not liable for any indirect,
+          incidental, or consequential damages, or for loss of data, arising
+          from your use of the service.
+        </p>
+
+        <h2 style={h2Style}>Ending your use</h2>
+        <p style={pStyle}>
+          You may stop using the service and request deletion of your account
+          at any time, as described in the Privacy Policy. The operator may
+          suspend or terminate accounts that violate these terms, abuse the
+          service, or create a security risk, with or without notice.
+        </p>
+
+        <h2 style={h2Style}>Changes to these terms</h2>
+        <p style={pStyle}>
+          These terms may change as the product develops. The date at the top
+          of this page will change when they do, and continued use of the
+          service after a change means you accept the updated terms.
+        </p>
+
+        <h2 style={h2Style}>Governing law</h2>
+        <p style={pStyle}>
+          These terms are governed by the laws of the State of Illinois, United
+          States, without regard to conflict-of-law rules.
+        </p>
+
+        <nav style={navStyle} aria-label="Legal">
+          <a href="/privacy" style={linkStyle}>
+            Privacy Policy
+          </a>
+          <a href="/login" style={linkStyle}>
+            Sign in
+          </a>
+          <a href="/" style={linkStyle}>
+            Home
+          </a>
+        </nav>
+      </article>
+    </main>
+  );
+}
