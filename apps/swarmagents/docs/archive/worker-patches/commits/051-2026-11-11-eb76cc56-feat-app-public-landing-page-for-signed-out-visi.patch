@@ -227,6 +227,10 @@ export async function isLoginWall(page: Page): Promise<boolean> {
     const url = new URL(page.url());
     if (url.pathname === "/login" || url.pathname.startsWith("/login/")) return true;
   } catch {}
+  // Signed out, "/" serves the public landing page: still no workspace, so it
+  // counts as a wall for the prod-mode UI specs.
+  const landing = page.locator("[data-testid='public-landing']").first();
+  if (await landing.isVisible().catch(() => false)) return true;
   const loginForm = page.locator("form.login-form, .login-page, input[type='password']").first();
   return loginForm.isVisible().catch(() => false);
 }
