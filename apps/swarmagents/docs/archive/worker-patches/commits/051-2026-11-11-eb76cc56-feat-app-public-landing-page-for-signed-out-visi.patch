   assert.equal(new URL(loc).searchParams.get("next"), "/runs?tab=log");
 });
 
+test("serves the landing page to unauthenticated visitors (GET / is public)", () => {
+  const res = middleware(req("http://swarm.example.com/", { host: "swarm.example.com" }));
+  assert.equal(res.status, 200, "the landing page must not redirect to /login");
+  assert.equal(res.headers.get("location"), null, "the landing page must not redirect");
+});
+
+test("the public landing keeps the query string and answers HEAD", () => {
+  const res = middleware(req("http://swarm.example.com/?utm=launch", { host: "swarm.example.com" }));
+  assert.equal(res.status, 200);
+  const head = middleware(req("http://swarm.example.com/", { host: "swarm.example.com" }, "HEAD"));
+  assert.equal(head.status, 200, "HEAD / must stay public");
+});
+
+test("the public landing is read-only: other methods still need a session", () => {
+  for (const method of STATE_CHANGING) {
+    const res = middleware(req("http://swarm.example.com/", { host: "swarm.example.com" }, method));
+    assert.equal(res.status, 303, `${method} / must still be gated`);
+    const loc = res.headers.get("location") ?? "";
+    assert.ok(loc.startsWith("http://swarm.example.com/login?next="), `unexpected location: ${loc}`);
+  }
+});
+
+test("the public landing does not open any other path (/providers stays gated)", () => {
+  for (const path of ["/providers", "/runs", "/settings", "/api/providers/health"]) {
+    const res = middleware(req(`http://swarm.example.com${path}`, { host: "swarm.example.com" }));
+    if (path.startsWith("/api/")) {
+      assert.equal(res.status, 401, `${path} must require a session`);
+    } else {
+      assert.equal(res.status, 303, `${path} must redirect to the sign-in page`);
+      const loc = res.headers.get("location") ?? "";
+      assert.ok(loc.startsWith("http://swarm.example.com/login?next="), `unexpected location: ${loc}`);
+      assert.equal(new URL(loc).searchParams.get("next"), path);
+    }
+  }
+});
+
+test("signed-in visitors still get the workspace at / without a redirect", () => {
+  const res = middleware(req("http://swarm.example.com/", { host: "swarm.example.com", cookie: cookie() }));
+  assert.equal(res.status, 200);
+  assert.equal(res.headers.get("location"), null, "authenticated requests must not redirect");
+});
+
 test("returns 401 JSON for unauthenticated API calls instead of redirecting", async () => {
   const res = middleware(req("http://swarm.example.com/api/providers/health", { host: "swarm.example.com" }));
   assert.equal(res.status, 401);
diff --git a/apps/swarmagents/middleware.ts b/apps/swarmagents/middleware.ts
index b5268f03e..b45ac1d36 100644
--- a/apps/swarmagents/middleware.ts
+++ b/apps/swarmagents/middleware.ts
@@ -31,6 +31,20 @@ export { isAllowed as isLocal } from "./lib/auth";
 /** Reachable signed out: the sign-in page and the endpoints it uses. */
 const PUBLIC = new Set(["/login", "/api/login", "/api/signup", "/api/me", "/api/mcp/swarm-board", "/api/health"]);
 
+/** Read-only methods a signed-out visitor may use on the public landing page. */
+const READ_ONLY = new Set(["GET", "HEAD"]);
+
+/**
+ * The public landing page: "/" is reachable without a session so a first-time
+ * visitor sees what the product is instead of a locked sign-in form. Only the
+ * exact path and only read-only methods qualify — every other route (including
+ * /providers and all of /api/*) stays behind the auth gate. The page itself
+ * renders the workspace for a visitor who does hold a session.
+ */
+function isPublicLanding(pathname: string, method: string): boolean {
+  return pathname === "/" && READ_ONLY.has(method.toUpperCase());
+}
+
 /** The public board MCP endpoint is exempt from the cross-site gate (external MCP clients call it). */
 const BOARD_PATH = "/api/mcp/swarm-board";
 
@@ -136,6 +150,8 @@ export function middleware(req: NextRequest) {
   }
 
   if (PUBLIC.has(pathname)) return withSecurityHeaders(NextResponse.next({ request: { headers } }), nonce, { dev }, rate);
+  // The landing page at / is public for read-only navigations (see isPublicLanding).
+  if (isPublicLanding(pathname, req.method)) return withSecurityHeaders(NextResponse.next({ request: { headers } }), nonce, { dev }, rate);
   if (!user) {
     if (!serverMode()) return withSecurityHeaders(new NextResponse("forbidden", { status: 403 }), nonce, { dev }, rate);
