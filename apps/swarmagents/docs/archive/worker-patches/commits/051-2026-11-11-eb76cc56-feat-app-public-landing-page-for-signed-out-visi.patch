+import { cookies, headers } from "next/headers";
+import { requestUser } from "../lib/auth";
 import HomeClient from "./home-client";
+import PublicLanding from "./public-landing";
 
-export default function Home() {
+export default async function Home() {
+  // The middleware lets an unauthenticated GET / through so a first-time
+  // visitor sees the public landing page. A visitor who holds a session still
+  // lands straight in the workspace, exactly as before.
+  const [hdrs, cs] = await Promise.all([headers(), cookies()]);
+  const user = requestUser({ headers: hdrs, cookies: { get: (name) => cs.get(name) } });
+  if (!user) return <PublicLanding />;
   return <HomeClient />;
 }
 
 // Serve the shell per-request instead of from the static prerender cache:
 // the CSP nonce is minted per request in middleware, so Next can only stamp it
 // onto its inline bootstrap scripts when the page is rendered dynamically.
-export const dynamic = "force-dynamic";
\ No newline at end of file
+export const dynamic = "force-dynamic";
