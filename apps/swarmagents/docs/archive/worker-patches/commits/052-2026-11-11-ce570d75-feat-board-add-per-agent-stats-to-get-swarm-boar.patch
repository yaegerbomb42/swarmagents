+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { NextRequest } from "next/server";
+import { GET } from "./route";
+import { configureStorePaths, saveStoreAtomic } from "@/lib/board/store";
+import type { BoardStore } from "@/lib/board/types";
+
+test("GET includes per-agent stats (claimed/inReview/completed/rejected)", async () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "swarm-board-route-"));
+  const dataFile = path.join(dir, "swarm_board.json");
+  configureStorePaths(dir, dataFile);
+  try {
+    const store: BoardStore = {
+      tasks: [
+        { id: "t1", title: "T", description: "D", difficulty: "easy", minElo: 1200, constraints: [], status: "claimed", claimedBy: "A", createdAt: 0, updatedAt: 0 },
+        { id: "t2", title: "T", description: "D", difficulty: "easy", minElo: 1200, constraints: [], status: "in_review", claimedBy: "A", createdAt: 0, updatedAt: 0 },
+        { id: "t3", title: "T", description: "D", difficulty: "easy", minElo: 1200, constraints: [], status: "completed", claimedBy: "B", createdAt: 0, updatedAt: 0 },
+        { id: "t4", title: "T", description: "D", difficulty: "easy", minElo: 1200, constraints: [], status: "open", claimedBy: "C", rejectedBy: ["C", "C"], createdAt: 0, updatedAt: 0 },
+      ],
+      proposals: [],
+      messages: [],
+    };
+    await saveStoreAtomic(store);
+
+    const res = await GET(new NextRequest("http://localhost/api/mcp/swarm-board"));
+    assert.equal(res.status, 200);
+    const body = (await res.json()) as { agents: Record<string, { claimed: number; inReview: number; completed: number; rejected: number }> };
+    assert.deepEqual(body.agents["A"], { claimed: 1, inReview: 1, completed: 0, rejected: 0 });
+    assert.deepEqual(body.agents["B"], { claimed: 0, inReview: 0, completed: 1, rejected: 0 });
+    assert.deepEqual(body.agents["C"], { claimed: 0, inReview: 0, completed: 0, rejected: 2 });
+  } finally {
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+});
