+import test from "node:test";
+import assert from "node:assert/strict";
+import { computeAgentStats } from "./agent-stats";
+import type { SwarmTask } from "@/lib/mcp-types";
+
+function task(over: Partial<SwarmTask>): SwarmTask {
+  return {
+    id: "t",
+    title: "T",
+    description: "D",
+    difficulty: "easy",
+    minElo: 1200,
+    constraints: [],
+    status: "open",
+    createdAt: 0,
+    updatedAt: 0,
+    ...over,
+  };
+}
+
+test("computeAgentStats buckets claimed/in-review/completed by claimedBy", () => {
+  const stats = computeAgentStats([
+    task({ status: "claimed", claimedBy: "A" }),
+    task({ status: "in_review", claimedBy: "A" }),
+    task({ status: "completed", claimedBy: "B" }),
+    task({ status: "completed", claimedBy: "B" }),
+  ]);
+  assert.deepEqual(stats["A"], { claimed: 1, inReview: 1, completed: 0, rejected: 0 });
+  assert.deepEqual(stats["B"], { claimed: 0, inReview: 0, completed: 2, rejected: 0 });
+});
+
+test("computeAgentStats counts tracked rejections per agent and ignores open/untracked tasks", () => {
+  const stats = computeAgentStats([
+    task({ status: "open", claimedBy: "A", rejectedBy: ["A"] }),
+    task({ status: "open", claimedBy: "A", rejectedBy: ["A", "C"] }),
+    task({ status: "open" }), // never claimed
+  ]);
+  assert.equal(stats["A"].rejected, 2);
+  assert.equal(stats["C"].rejected, 1);
+  assert.equal(Object.keys(stats).length, 2);
+});
+
+test("computeAgentStats returns an empty map for an empty/blank backlog", () => {
+  assert.deepEqual(computeAgentStats([]), {});
+  assert.deepEqual(computeAgentStats([task({ status: "open" })]), {});
+});
