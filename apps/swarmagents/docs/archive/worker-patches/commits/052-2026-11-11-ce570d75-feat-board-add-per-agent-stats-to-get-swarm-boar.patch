@@ -130,6 +130,67 @@ test("handleReviewAndMergeTask rejects missing feedback", async () => {
   assert.match(result.error.message, /feedback/);
 });
 
+test("handleReviewAndMergeTask records a rejection when approved=false", async () => {
+  const store = emptyStore();
+  store.tasks.push({
+    id: "t1",
+    title: "T",
+    description: "D",
+    difficulty: "easy",
+    minElo: 1200,
+    constraints: [],
+    status: "in_review",
+    claimedBy: "A",
+    createdAt: 0,
+    updatedAt: 0,
+  });
+  const result = await handleReviewAndMergeTask(store, { taskId: "t1", approved: false, feedback: "needs work" });
+  assert.ok("result" in result);
+  const parsed = JSON.parse(result.result.content[0].text);
+  assert.equal(parsed.task.status, "open");
+  assert.deepEqual(parsed.task.rejectedBy, ["A"]);
+});
+
+test("handleReviewAndMergeTask appends multiple rejections on repeated rejection", async () => {
+  const store = emptyStore();
+  store.tasks.push({
+    id: "t1",
+    title: "T",
+    description: "D",
+    difficulty: "easy",
+    minElo: 1200,
+    constraints: [],
+    status: "in_review",
+    claimedBy: "A",
+    rejectedBy: ["A"],
+    createdAt: 0,
+    updatedAt: 0,
+  });
+  await handleReviewAndMergeTask(store, { taskId: "t1", approved: false, feedback: "again" });
+  assert.deepEqual(store.tasks[0].rejectedBy, ["A", "A"]);
+});
+
+test("handleReviewAndMergeTask approves without recording a rejection", async () => {
+  const store = emptyStore();
+  store.tasks.push({
+    id: "t1",
+    title: "T",
+    description: "D",
+    difficulty: "easy",
+    minElo: 1200,
+    constraints: [],
+    status: "in_review",
+    claimedBy: "A",
+    createdAt: 0,
+    updatedAt: 0,
+  });
+  const result = await handleReviewAndMergeTask(store, { taskId: "t1", approved: true, feedback: "ok" });
+  assert.ok("result" in result);
+  const parsed = JSON.parse(result.result.content[0].text);
+  assert.equal(parsed.task.status, "completed");
+  assert.equal(parsed.task.rejectedBy, undefined);
+});
+
