+++ b/apps/swarmagents/lib/board/agent-stats.ts
@@ -0,0 +1,48 @@
+import type { SwarmTask } from "@/lib/mcp-types";
+
+/** Per-agent quality signals, aggregated from the task board. */
+export interface AgentStats {
+  claimed: number;
+  inReview: number;
+  completed: number;
+  rejected: number;
+}
+
+function emptyStats(): AgentStats {
+  return { claimed: 0, inReview: 0, completed: 0, rejected: 0 };
+}
+
+/**
+ * Aggregate per-agent signals across every task.
+ *
+ * - claimed / inReview / completed come from the task's current status and its
+ *   claimedBy owner.
+ * - rejected counts every entry in a task's rejectedBy list (recorded when
+ *   review_and_merge_task completes with approved=false), so a rejection keeps
+ *   counting even after the task is re-claimed by another agent.
+ *
+ * Only agents that own at least one task or rejection appear in the result.
+ */
+export function computeAgentStats(tasks: readonly SwarmTask[]): Record<string, AgentStats> {
+  const stats: Record<string, AgentStats> = {};
+  const bump = (agent: string, key: keyof AgentStats): void => {
+    let s = stats[agent];
+    if (!s) {
+      s = emptyStats();
+      stats[agent] = s;
+    }
+    s[key] += 1;
+  };
+
+  for (const task of tasks) {
+    if (task.claimedBy) {
+      if (task.status === "claimed") bump(task.claimedBy, "claimed");
+      else if (task.status === "in_review") bump(task.claimedBy, "inReview");
+      else if (task.status === "completed") bump(task.claimedBy, "completed");
+    }
+    if (task.rejectedBy) {
+      for (const agent of task.rejectedBy) bump(agent, "rejected");
+    }
+  }
+  return stats;
+}
