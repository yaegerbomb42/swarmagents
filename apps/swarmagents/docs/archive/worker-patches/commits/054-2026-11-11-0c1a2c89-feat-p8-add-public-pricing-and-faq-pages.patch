diff --git a/apps/swarmagents/lib/middleware.test.ts b/apps/swarmagents/lib/middleware.test.ts
index c971b9f25..c54914d0e 100644
--- a/apps/swarmagents/lib/middleware.test.ts
+++ b/apps/swarmagents/lib/middleware.test.ts
@@ -187,3 +187,21 @@ test("429 responses carry Retry-After and rate-limit headers (login bucket)", ()
   assert.equal(res.headers.get("X-RateLimit-Remaining"), "0");
   assert.ok(Number(res.headers.get("X-RateLimit-Reset")) >= 0);
 });
+
+test("/pricing is publicly accessible without authentication", () => {
+  const res = middleware(req("http://swarm.example.com/pricing", { host: "swarm.example.com" }));
+  assert.equal(res.status, 200);
+});
+
+test("/faq is publicly accessible without authentication", () => {
+  const res = middleware(req("http://swarm.example.com/faq", { host: "swarm.example.com" }));
+  assert.equal(res.status, 200);
+});
+
+test("/pricing and /faq do not redirect unauthenticated users to /login", () => {
+  for (const path of ["/pricing", "/faq"]) {
+    const res = middleware(req(`http://swarm.example.com${path}`, { host: "swarm.example.com" }));
+    assert.equal(res.status, 200, `${path} must not redirect`);
+    assert.equal(res.headers.get("location"), null, `${path} must not set a Location header`);
+  }
+});
