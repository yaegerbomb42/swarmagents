@@ -0,0 +1,138 @@
+export const metadata = {
+  title: "FAQ — SwarmAgents",
+  description: "Frequently asked questions about SwarmAgents: what a run is, approvals, hibernate, reset, what is stored, providers, signup, and more.",
+};
+
+export const dynamic = "force-dynamic";
+
+const FAQS: { q: string; a: string }[] = [
+  {
+    q: "What is a run?",
+    a: "A run is one execution of your agent inside your persistent VM. You start a run with a prompt, and your agent works inside the VM using the tools you&rsquo;ve given it — shell, file edits, browser, and more — while you watch live.",
+  },
+  {
+    q: "What is the persistent VM?",
+    a: "Each account gets one persistent Linux VM. Your agent&rsquo;s workspace, installed tools, and state live there between runs. It hibernates when idle and wakes when you start a new run.",
+  },
+  {
+    q: "What are approvals?",
+    a: "Some actions (like destructive commands or external network calls) require your explicit approval before the agent can proceed. You review and approve or reject each one in the UI.",
+  },
+  {
+    q: "What does hibernate do?",
+    a: "Hibernate suspends your VM when it&rsquo;s been idle, freeing resources while keeping your workspace intact. Your agent resumes exactly where it left off on the next run.",
+  },
+  {
+    q: "What does reset do?",
+    a: "Reset wipes the VM workspace back to a clean state, as if it were freshly provisioned. Use this if something goes wrong or you want to start over.",
+  },
+  {
+    q: "What is stored?",
+    a: "Prompts, run logs, workspace files, VM snapshots, and your account email are stored. Provider keys you add stay on the server and are never sent to agent-controlled code.",
+  },
+  {
+    q: "Which providers are supported?",
+    a: "You can bring your own provider keys (Anthropic Claude, OpenAI, etc.) or use the platform pool if available. Provider health is checked automatically so failed keys are rotated out.",
+  },
+  {
+    q: "Is self-signup open?",
+    a: "No — self-signup is closed in production unless SWARM_ALLOW_SIGNUP=1 is set. To request an account, contact the operator (mailto link on the pricing page).",
+  },
+  {
+    q: "Can I take over my agent?",
+    a: "Yes — you can watch your agent&rsquo;s screen, terminal, and browser live, and you can take control at any time.",
+  },
+  {
+    q: "How long do runs keep history?",
+    a: "Run history is kept per-user up to a configurable limit. Older runs are pruned to keep the history manageable.",
+  },
+  {
+    q: "Is this a paid product?",
+    a: "SwarmAgents is in preview. There is no published price and no charges during the preview period. Contact the operator for access and pricing details when they&rsquo;re available.",
+  },
+];
+
+export default function FAQPage() {
+  return (
+    <main
+      style={{
+        minHeight: "100vh",
+        background: "#000",
+        color: "#fff",
+        fontFamily: '"Geist", "SF Pro Text", -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif',
+        padding: "40px 20px 80px",
+      }}
+    >
+      <div style={{ maxWidth: 720, margin: "0 auto" }}>
+        <h1
+          style={{
+            fontSize: "clamp(1.75rem, 1.64rem + 0.55vw, 2rem)",
+            fontWeight: 600,
+            letterSpacing: "-0.02em",
+            marginBottom: 8,
+            color: "#fff",
+          }}
+        >
+          FAQ
+        </h1>
+        <p
+          style={{
+            fontSize: "clamp(1rem, 0.96rem + 0.2vw, 1.0625rem)",
+            color: "#888",
+            marginBottom: 40,
+            lineHeight: 1.6,
+          }}
+        >
+          Honest answers about SwarmAgents. Still have questions? Contact the
+          operator.
+        </p>
+
+        <div style={{ display: "flex", flexDirection: "column", gap: 16 }}>
+          {FAQS.map((faq, i) => (
+            <details
+              key={i}
+              style={{
+                background: "#0a0a0a",
+                border: "1px solid #1a1a1a",
+                borderRadius: 8,
+                overflow: "hidden",
+              }}
+            >
+              <summary
+                style={{
+                  padding: "12px 16px",
+                  fontWeight: 600,
+                  color: "#fff",
+                  cursor: "pointer",
+                  listStyle: "none",
+                }}
+              >
+                {faq.q}
+              </summary>
+              <p style={{ padding: "0 16px 16px", color: "#ccc", lineHeight: 1.7 }}>
+                {faq.a}
+              </p>
+            </details>
+          ))}
+        </div>
+
+        <p style={{ color: "#555", fontSize: "clamp(0.875rem, 0.84rem + 0.18vw, 0.9375rem)", marginTop: 40 }}>
+          {"Want pricing? "}
+          <a
+            href="/pricing"
+            style={{ color: "#22d3ee", textDecoration: "none", borderBottom: "1px solid #22d3ee" }}
+          >
+            See pricing
+          </a>
+          {" • "}
+          <a
+            href="/login"
+            style={{ color: "#22d3ee", textDecoration: "none", borderBottom: "1px solid #22d3ee" }}
+          >
+            Sign in
+          </a>
+        </p>
+      </div>
+    </main>
+  );
+}
\ No newline at end of file
