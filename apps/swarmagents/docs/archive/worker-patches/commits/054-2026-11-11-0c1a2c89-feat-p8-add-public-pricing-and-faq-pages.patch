+import Link from "next/link";
+
+export const metadata = {
+  title: "Pricing — SwarmAgents",
+  description: "One persistent VM per account. Bring your own provider keys, or use the platform pool. Preview access — contact the operator to get started.",
+};
+
+export const dynamic = "force-dynamic";
+
+export default function PricingPage() {
+  return (
+    <main
+      style={{
+        minHeight: "100vh",
+        background: "#000",
+        color: "#fff",
+        fontFamily: '"Geist", "SF Pro Text", -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif',
+        padding: "40px 20px 80px",
+      }}
+    >
+      <div style={{ maxWidth: 720, margin: "0 auto" }}>
+        <h1
+          style={{
+            fontSize: "clamp(1.75rem, 1.64rem + 0.55vw, 2rem)",
+            fontWeight: 600,
+            letterSpacing: "-0.02em",
+            marginBottom: 8,
+            color: "#fff",
+          }}
+        >
+          Pricing
+        </h1>
+        <p
+          style={{
+            fontSize: "clamp(1rem, 0.96rem + 0.2vw, 1.0625rem)",
+            color: "#888",
+            marginBottom: 40,
+            lineHeight: 1.6,
+          }}
+        >
+          SwarmAgents is in preview. One persistent Linux VM per account — your
+          agent lives there, you can watch it work live, and you keep full
+          control.
+        </p>
+
+        <section style={{ marginBottom: 40 }}>
+          <h2
+            style={{
+              fontSize: "clamp(1.375rem, 1.3rem + 0.38vw, 1.5625rem)",
+              fontWeight: 600,
+              marginBottom: 20,
+              color: "#fff",
+            }}
+          >
+            What&rsquo;s included
+          </h2>
+          <ul style={{ color: "#fff", lineHeight: 1.8, paddingLeft: 20 }}>
+            <li>One persistent VM per account — your agent runs there 24/7</li>
+            <li>Live screen, terminal, and browser view of your agent at work</li>
+            <li>Bring your own provider keys (Anthropic, OpenAI, etc.)</li>
+            <li>Optional platform provider pool if you don&rsquo;t have keys</li>
+            <li>Full command history and run logs</li>
+            <li>File snapshots, VM suspend/resume, and idle cleanup</li>
+          </ul>
+        </section>
+
+        <section style={{ marginBottom: 40 }}>
+          <h2
+            style={{
+              fontSize: "clamp(1.375rem, 1.3rem + 0.38vw, 1.5625rem)",
+              fontWeight: 600,
+              marginBottom: 20,
+              color: "#fff",
+            }}
+          >
+            Cost
+          </h2>
+          <p style={{ color: "#fff", marginBottom: 16 }}>
+            SwarmAgents is in preview — there is no published price yet. We do
+            not invent prices or charge during the preview period. To request
+            access, email us at the operator address listed below.
+          </p>
+        </section>
+
+        <section style={{ marginBottom: 40, padding: 24, background: "#0a0a0a", border: "1px solid #1a1a1a", borderRadius: 12 }}>
+          <h2
+            style={{
+              fontSize: "clamp(1.125rem, 1.07rem + 0.28vw, 1.25rem)",
+              fontWeight: 600,
+              marginBottom: 12,
+              color: "#fff",
+            }}
+          >
+            How to get access
+          </h2>
+          <p style={{ color: "#888", lineHeight: 1.6, marginBottom: 12 }}>
+            Self-signup is closed in production. To request an account, contact
+            the operator:
+          </p>
+          <a
+            href="mailto:operator@swarmagents.local"
+            style={{
+              color: "#22d3ee",
+              textDecoration: "none",
+              borderBottom: "1px solid #22d3ee",
+            }}
+          >
+            mailto:operator@swarmagents.local
+          </a>
+        </section>
+
+        <p style={{ color: "#555", fontSize: "clamp(0.875rem, 0.84rem + 0.18vw, 0.9375rem)", marginTop: 40 }}>
+          {"Already have an account? "}
+          <Link
+            href="/login"
+            style={{ color: "#22d3ee", textDecoration: "none", borderBottom: "1px solid #22d3ee" }}
+          >
+            Sign in
+          </Link>
+        </p>
+      </div>
+    </main>
+  );
+}
