diff --git a/apps/swarmagents/instrumentation.ts b/apps/swarmagents/instrumentation.ts
index 2dba404df..d8d0eec35 100644
--- a/apps/swarmagents/instrumentation.ts
+++ b/apps/swarmagents/instrumentation.ts
@@ -2,11 +2,23 @@
  * Server startup hook (Next.js instrumentation). Registers the graceful
  * shutdown handler once per process so a SIGTERM/SIGINT during a deploy
  * cancels in-flight runs with reason "shutdown" and flushes run logs
- * before the process exits.
+ * before the process exits. Then reconciles runs left queued/running by the
+ * previous process so history never shows them spinning forever.
  */
 export async function register(): Promise<void> {
   if (process.env.NEXT_RUNTIME === "nodejs") {
     const { registerShutdownHandler } = await import("./lib/runtime/shutdown");
     registerShutdownHandler();
+
+    // Recovery must never break startup: a bad log file is logged and skipped.
+    try {
+      const { reconcileInterruptedRuns } = await import("./lib/runtime/recovery");
+      const report = reconcileInterruptedRuns();
+      if (report.count > 0) {
+        console.info(`[recovery] marked ${report.count} interrupted run(s) after restart`);
+      }
+    } catch (error) {
+      console.error("[recovery] startup reconciliation failed:", error);
+    }
   }
 }
