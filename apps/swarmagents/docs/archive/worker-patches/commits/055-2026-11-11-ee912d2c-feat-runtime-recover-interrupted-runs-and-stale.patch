@@ -199,33 +203,82 @@ export function listRuns(options: ListRunsOptions = {}): StoredRunSummary[] {
   return summaries.slice(0, limit);
 }
 
-/** Reason recorded on runs orphaned by a server restart. */
+/**
+ * Every persisted run with one of the given statuses, newest first. Unlike
+ * listRuns this has no pagination limit: startup recovery must see every
+ * orphaned run, however many accumulated.
+ */
+export function listByStatus(
+  status: StoredRunStatus | readonly StoredRunStatus[],
+  options: { runsDir?: string | null; userId?: string } = {},
+): StoredRunSummary[] {
+  const runsDir = options.runsDir === undefined ? getRunsDir() : options.runsDir;
+  if (!runsDir) return [];
+  const wanted = new Set<StoredRunStatus>(
+    typeof status === "string" ? [status] : [...status],
+  );
+
+  const summaries: StoredRunSummary[] = [];
+  for (const info of listRunLogs(runsDir)) {
+    const run = getRun(info.runId, runsDir);
+    if (!run || !wanted.has(run.summary.status)) continue;
+    if (options.userId && run.summary.userId !== options.userId) continue;
+    summaries.push(run.summary);
+  }
+  summaries.sort(
+    (a, b) => b.createdAt - a.createdAt || (a.runId < b.runId ? 1 : a.runId > b.runId ? -1 : 0),
+  );
+  return summaries;
+}
+
+/** Reason recorded on runs interrupted by a server restart. */
+export const INTERRUPTED_RUN_REASON = "interrupted by server restart";
+
+/** Reason recorded on runs orphaned by a server restart (legacy spelling). */
 export const ORPHANED_RUN_REASON = "server restarted";
 
 /**
- * Finalize every persisted run still marked running. The server restarted
- * mid-run, so no live process will ever finish it; leaving it "running"
- * would strand it forever. Appends a run.error event (seq = last persisted
- * seq + 1, so the log stays gapless and ordered) to each orphaned run's log,
- * which flips its durable summary to "error" with the restart reason.
- * Finished, errored and cancelled runs are left untouched. Returns the
- * recovered runIds. Idempotent: a second call finds nothing still running.
+ * Finalize one persisted run that was still queued or running when the
+ * process died. Appends a run.error event (seq = last persisted seq + 1, so
+ * the log stays gapless and ordered) with `reason`, which flips its durable
+ * summary to "error". Writes straight to the run log rather than the bus:
+ * there are no subscribers after a restart, and the bus's per-process seq
+ * would start at 1 and corrupt the persisted ordering. Returns true when the
+ * run was marked; finished/errored/cancelled/unknown runs are left untouched,
+ * so it is idempotent.
+ */
+export function markInterrupted(
+  runId: string,
+  runsDir: string | null = getRunsDir(),
+  reason: string = INTERRUPTED_RUN_REASON,
+): boolean {
+  if (!runsDir) return false;
+  const run = getRun(runId, runsDir);
+  if (!run) return false;
+  if (run.summary.status !== "queued" && run.summary.status !== "running") return false;
+
+  const errorEvent: SequencedEvent & { message: string } = {
+    type: "run.error",
+    message: reason,
+    seq: run.summary.lastSeq + 1,
+    runId: run.runId,
+    ts: Date.now(),
+  };
+  appendRunEvent(errorEvent, runsDir);
+  return true;
+}
+
+/**
+ * Finalize every persisted run still marked running or queued. The server
+ * restarted mid-run, so no live process will ever finish it; leaving it
+ * "running" would strand it forever. Returns the recovered runIds.
+ * Idempotent: a second call finds nothing still in flight.
  */
 export function recoverOrphanedRuns(runsDir: string | null = getRunsDir()): string[] {
   if (!runsDir) return [];
   const recovered: string[] = [];
-  for (const info of listRunLogs(runsDir)) {
-    const run = getRun(info.runId, runsDir);
-    if (!run || run.summary.status !== "running") continue;
-    const errorEvent: SequencedEvent & { message: string } = {
-      type: "run.error",
-      message: ORPHANED_RUN_REASON,
-      seq: run.summary.lastSeq + 1,
-      runId: run.runId,
-      ts: Date.now(),
-    };
-    appendRunEvent(errorEvent, runsDir);
-    recovered.push(run.runId);
+  for (const run of listByStatus(["queued", "running"], { runsDir })) {
+    if (markInterrupted(run.runId, runsDir, ORPHANED_RUN_REASON)) recovered.push(run.runId);
   }
   return recovered;
 }
-- 
