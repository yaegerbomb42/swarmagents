diff --git a/apps/swarmagents/lib/runtime/manager.steer.test.ts b/apps/swarmagents/lib/runtime/manager.steer.test.ts
new file mode 100644
index 000000000..4f7409359
--- /dev/null
+++ b/apps/swarmagents/lib/runtime/manager.steer.test.ts
@@ -0,0 +1,232 @@
+/**
+ * Steer: interrupting the active run mid-flight with "no, do X instead".
+ * steer() must cancel the active run as "superseded", start a new run that
+ * resumes the same Claude session (--resume), keep queued items queued, and
+ * publish a run.steered event linking the two runIds. Route-level coverage
+ * for POST {action:"steer"} is included at the bottom.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import { RuntimeManager } from "./manager";
+import { VmManager } from "../vm/manager";
+import { FakeVmDriver } from "../vm/fake-driver";
+import { telemetryBus } from "../telemetry/bus";
+import type { ExecOptions, ExecResult, VmHandle } from "../vm/types";
+import type { RunSummary } from "./manager";
+import { NextRequest } from "next/server";
+import { DELETE, GET, POST } from "../../app/api/runtime/tasks/route";
+import { setRuntimeManagerForTesting } from "./manager";
+
+const sleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));
+
+/** Stream-json transcript for a single claude invocation with a fixed session id. */
+function fixtureLines(sessionId: string): string[] {
+  return [
+    JSON.stringify({ type: "system", subtype: "init", session_id: sessionId, model: "claude-test" }),
+    JSON.stringify({ type: "result", subtype: "success", session_id: sessionId, cost_usd: 0, duration_ms: 1, num_turns: 1 }),
+  ];
+}
+
+class SteerFakeVm extends FakeVmDriver {
+  calls: string[][] = [];
+
+  constructor(
+    private readonly sessionId = "sess_steer_a",
+    private readonly delays: number[] = [],
+  ) {
+    super();
+  }
+
+  override async exec(handle: VmHandle, cmd: string[], opts?: ExecOptions): Promise<ExecResult> {
+    if (cmd[0] !== "claude") return super.exec(handle, cmd, opts);
+    const index = this.calls.length;
+    this.calls.push(cmd);
+    const delay = this.delays[index] ?? 0;
+    if (delay > 0) await sleep(delay);
+    if (opts?.signal?.aborted) return { exitCode: 130 };
+    for (const line of fixtureLines(this.sessionId)) opts?.onStdout?.(`${line}\n`);
+    return { exitCode: 0 };
+  }
+}
+
+function managerWith(driver: SteerFakeVm): RuntimeManager {
+  return new RuntimeManager({
+    vm: new VmManager({ customDriver: driver }),
+    router: null,
+  });
+}
+
+async function waitFor(
+  manager: RuntimeManager,
+  userId: string,
+  pred: (runs: RunSummary[]) => boolean,
+  steps = 400,
+): Promise<RunSummary[]> {
+  for (let i = 0; i < steps; i++) {
+    const runs = manager.list(userId);
+    if (pred(runs)) return runs;
+    await sleep(10);
+  }
+  throw new Error("timed out waiting for run state");
+}
+
+async function waitForCalls(driver: SteerFakeVm, count: number, steps = 100): Promise<void> {
+  for (let i = 0; i < steps; i++) {
+    if (driver.calls.length >= count) return;
+    await sleep(10);
+  }
+  throw new Error(`timed out waiting for ${count} claude calls`);
+}
+
+test("steer cancels the active run as superseded and resumes the same session", async () => {
+  const driver = new SteerFakeVm("sess_steer_a", [5000, 0]);
+  const manager = managerWith(driver);
+
+  const first = manager.start("alice", { prompt: "first task", sessionId: "sess_steer_a" });
+  assert.equal(first.accepted, true);
+  await waitForCalls(driver, 1);
+
+  const t0 = Date.now();
+  const result = manager.steer("alice", "stop, use python instead");
+  assert.equal(result.ok, true);
+  assert.equal(result.steeredFrom, first.runId);
+  assert.notEqual(result.runId, first.runId);
+
+  // The old run is terminal (cancelled, superseded) promptly.
+  const runs = await waitFor(manager, "alice", (all) => {
+    const old = all.find((r) => r.runId === first.runId);
+    const next = all.find((r) => r.runId === result.runId);
+    return old?.status !== "running" && next?.status === "running";
+  });
+  const oldSummary = runs.find((r) => r.runId === first.runId);
+  assert.equal(oldSummary?.status, "cancelled");
+  assert.equal(oldSummary?.cancelledReason, "superseded");
+  assert.ok(Date.now() - t0 < 2000, "steer should supersede the old run within 2s");
+
+  // The steered run carries the same Claude session and the prefixed prompt.
+  await waitForCalls(driver, 2);
+  const cmd = driver.calls[1];
+  const resumeIdx = cmd.indexOf("--resume");
+  assert.ok(resumeIdx !== -1, "steered run should include --resume");
+  assert.equal(cmd[resumeIdx + 1], "sess_steer_a");
+  assert.equal(cmd.at(-1), "User interrupted: stop, use python instead");
+
+  // run.steered on the new run links back to the cancelled runId.
+  const events: Array<{ type: string; data?: Record<string, unknown> }> = [];
+  telemetryBus.subscribe(result.runId, 0, (event) => events.push(event as never));
+  const steered = events.find((event) => event.type === "run.steered");
+  assert.ok(steered, "run.steered should be published on the new run");
+  assert.equal(steered.data?.steeredFrom, first.runId);
+
+  await waitFor(manager, "alice", (all) => all.every((run) => run.status !== "running" && run.status !== "queued"));
+});
+
+test("steer keeps queued items queued; they run after the steered run", async () => {
+  const driver = new SteerFakeVm("sess_q", [5000, 0, 0, 0]);
+  const manager = managerWith(driver);
+
+  const active = manager.start("alice", { prompt: "active" });
+  const q1 = manager.start("alice", { prompt: "queued-1" });
+  const q2 = manager.start("alice", { prompt: "queued-2" });
+  assert.equal(q1.queued, true);
+  assert.equal(q2.queued, true);
+  await waitForCalls(driver, 1);
+
+  const result = manager.steer("alice", "do it differently");
+  assert.equal(result.ok, true);
+
+  const during = manager.list("alice");
+  assert.equal(during.find((r) => r.runId === active.runId)?.status, "cancelled");
+  assert.equal(during.find((r) => r.runId === active.runId)?.cancelledReason, "superseded");
+  assert.equal(during.find((r) => r.runId === result.runId)?.status, "running");
+  assert.equal(during.find((r) => r.runId === q1.runId)?.status, "queued");
+  assert.equal(during.find((r) => r.runId === q1.runId)?.position, 1);
+  assert.equal(during.find((r) => r.runId === q2.runId)?.status, "queued");
+  assert.equal(during.find((r) => r.runId === q2.runId)?.position, 2);
+
+  // Queued prompts execute after the steered run, in their original order.
+  const runs = await waitFor(
+    manager,
+    "alice",
+    (all) => all.length >= 4 && all.every((run) => run.status !== "running" && run.status !== "queued"),
+  );
+  assert.equal(driver.calls.length, 4);
+  assert.equal(driver.calls[0].at(-1), "active");
+  assert.equal(driver.calls[1].at(-1), "User interrupted: do it differently");
+  assert.equal(driver.calls[2].at(-1), "queued-1");
+  assert.equal(driver.calls[3].at(-1), "queued-2");
+  assert.equal(runs.find((r) => r.runId === q1.runId)?.status, "finished");
+  assert.equal(runs.find((r) => r.runId === q2.runId)?.status, "finished");
+});
+
+test("steer without an active run is a no-op (ok:false)", async () => {
+  const driver = new SteerFakeVm();
+  const manager = managerWith(driver);
+  const result = manager.steer("alice", "hello");
+  assert.equal(result.ok, false);
+  assert.equal(driver.calls.length, 0);
+});
+
+// --- Route: POST {action:"steer", prompt} ---
+
+function request(path: string, init: RequestInit = {}, user: string | null = "alice"): NextRequest {
+  const headers = new Headers(init.headers);
+  if (user !== null) headers.set("x-swarm-user", user);
+  return new NextRequest(`http://localhost${path}`, { ...init, headers, signal: init.signal ?? undefined });
+}
+
+async function postTask(body: unknown, user: string | null = "alice"): Promise<Response> {
+  return POST(request("/api/runtime/tasks", { method: "POST", body: JSON.stringify(body) }, user));
+}
+
+test.afterEach(() => {
+  setRuntimeManagerForTesting(null);
+});
+
+test("route: POST {action:'steer'} supersedes the active run and returns the new runId", async () => {
+  const driver = new SteerFakeVm("sess_route", [5000, 0]);
+  const manager = managerWith(driver);
+  setRuntimeManagerForTesting(manager);
+
+  const first = await postTask({ prompt: "long task", sessionId: "sess_route" });
+  assert.equal(first.status, 201);
+  const { runId } = (await first.json()) as { runId: string };
+
+  const steerRes = await postTask({ action: "steer", prompt: "use python instead" });
+  assert.equal(steerRes.status, 201);
+  const steerBody = (await steerRes.json()) as { runId: string; steeredFrom: string };
+  assert.equal(steerBody.steeredFrom, runId);
+  assert.notEqual(steerBody.runId, runId);
+
+  // Both runs end up in the list: old cancelled/superseded, new finished.
+  for (let i = 0; i < 400; i++) {
+    const runs = ((await (await GET(request("/api/runtime/tasks"))).json()) as { runs: RunSummary[] }).runs;
+    const old = runs.find((r) => r.runId === runId);
+    const next = runs.find((r) => r.runId === steerBody.runId);
+    if (old?.status === "cancelled" && next?.status !== "running" && next?.status !== "queued") {
+      assert.equal(old.cancelledReason, "superseded");
+      assert.ok(next, "steered run should be listed");
+      assert.equal(next.status, "finished");
+      assert.equal(driver.calls.length, 2);
+      const resumeIdx = driver.calls[1].indexOf("--resume");
+      assert.equal(driver.calls[1][resumeIdx + 1], "sess_route");
+      assert.equal(driver.calls[1].at(-1), "User interrupted: use python instead");
+      return;
+    }
+    await sleep(10);
+  }
+  throw new Error("timed out waiting for steered runs to settle");
+});
+
+test("route: POST steer rejects a missing prompt and 409s with no active run", async () => {
+  const driver = new SteerFakeVm();
+  setRuntimeManagerForTesting(managerWith(driver));
+
+  assert.equal((await postTask({ action: "steer", prompt: "" })).status, 400);
+  assert.equal((await postTask({ action: "steer", prompt: "   " })).status, 400);
+  const res = await postTask({ action: "steer", prompt: "nothing running" });
+  assert.equal(res.status, 409);
+  assert.equal(((await res.json()) as { error: string }).error, "No active run to steer.");
+  assert.equal(driver.calls.length, 0);
+});
diff --git a/apps/swarmagents/lib/runtime/manager.ts b/apps/swarmagents/lib/runtime/manager.ts
index 251c09e74..828bbdcd7 100644
--- a/apps/swarmagents/lib/runtime/manager.ts
+++ b/apps/swarmagents/lib/runtime/manager.ts
@@ -321,6 +321,47 @@ export class RuntimeManager {
     return { accepted: true, runId, queued: false };
   }
 
+  /**
+   * Steer the active run: cancel it with reason "superseded" and immediately
+   * start a new run that resumes the same Claude session, with the user's
+   * text prefixed "User interrupted: ". The context of the interrupted run
+   * is preserved because the new run passes --resume <sessionId>.
+   *
+   * Unlike cancel(), queued prompts stay queued: the steered run claims the
+   * active slot ahead of them. A run.steered event is published on the new
+   * run linking back to the cancelled runId so the timeline can show both.
+   */
+  steer(userId: string, text: string): StartResult & { ok: boolean; steeredFrom?: string } {
+    const st = this.state(userId);
+    const old = st.active;
+    if (!old) return { ok: false, accepted: false, runId: "", queued: false };
+
+    // Park the queue so finalize()'s startNext() cannot pull a queued prompt
+    // into the slot the steered run is about to claim.
+    const parked = st.queue.splice(0, st.queue.length);
+
+    // The runner emits run.started with the live session id (stored on the
+    // active run); fall back to the persisted session for a run that has not
+    // emitted its init yet.
+    const sessionId = old.sessionId ?? getLastSession(userId);
+
+    this.finalize(old.runId, { status: "cancelled", cancelledReason: "superseded" });
+    old.controller.abort();
+
+    st.queue.push(...parked);
+
+    const prompt = `User interrupted: ${text}`;
+    const result = this.start(userId, { prompt, sessionId });
+    if (result.accepted) {
+      const steeredEvent: { type: "run.steered"; data: Record<string, string> } = {
+        type: "run.steered",
+        data: { steeredFrom: old.runId, reason: "steered", message: `steered from ${old.runId}` },
+      };
+      this.bus.publish(result.runId, steeredEvent);
+    }
+    return { ...result, ok: true, steeredFrom: old.runId };
+  }
+
   /** Move the next queued prompt into the active slot and execute it. */
   private startNext(userId: string): void {
     const st = this.users.get(userId);
@@ -900,6 +941,11 @@ export class RuntimeManager {
       if (st?.active?.runId === runId && st.active.startedAt === undefined) {
         st.active.startedAt = Date.now();
       }
+      // Track the live session id so a steer() issued mid-run can resume the
+      // exact Claude session (the id only exists once the init line arrives).
+      if (event.sessionId && st?.active?.runId === runId) {
+        st.active.sessionId = event.sessionId;
+      }
     }
     this.bus.publish(runId, event);
   }
