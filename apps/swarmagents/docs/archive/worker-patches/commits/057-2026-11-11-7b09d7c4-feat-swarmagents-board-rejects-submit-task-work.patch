diff --git a/apps/swarmagents/lib/board/branch-check.test.ts b/apps/swarmagents/lib/board/branch-check.test.ts
new file mode 100644
index 000000000..3f08d30fa
--- /dev/null
+++ b/apps/swarmagents/lib/board/branch-check.test.ts
@@ -0,0 +1,43 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { verifyBranchPushed, type GitRunner } from "./branch-check";
+
+const foundRunner: GitRunner = async (args) => {
+  const branch = args[args.length - 1];
+  return { stdout: `abc123\trefs/heads/${branch}\n` };
+};
+
+const missingRunner: GitRunner = async () => ({ stdout: "" });
+
+test("verifyBranchPushed: passes when check is disabled", async () => {
+  const prev = process.env.SWARM_GIT_REMOTE_CHECK;
+  process.env.SWARM_GIT_REMOTE_CHECK = "0";
+  try {
+    const res = await verifyBranchPushed("feat/x", { runGit: missingRunner });
+    assert.deepEqual(res, { ok: true });
+  } finally {
+    if (prev === undefined) delete process.env.SWARM_GIT_REMOTE_CHECK;
+    else process.env.SWARM_GIT_REMOTE_CHECK = prev;
+  }
+});
+
+test("verifyBranchPushed: accepts a branch found on the remote", async () => {
+  const res = await verifyBranchPushed("feat/x", { runGit: foundRunner, enforce: true });
+  assert.equal(res.ok, true);
+});
+
+test("verifyBranchPushed: rejects a branch missing on the remote", async () => {
+  const res = await verifyBranchPushed("feat/x", { runGit: missingRunner, enforce: true });
+  assert.equal(res.ok, false);
+  assert.match(res.error ?? "", /not found on remote/);
+  assert.match(res.error ?? "", /git push/);
+});
+
+test("verifyBranchPushed: surfaces git command failures", async () => {
+  const failingRunner: GitRunner = async () => {
+    throw new Error("git: not a git repository");
+  };
+  const res = await verifyBranchPushed("feat/x", { runGit: failingRunner, enforce: true });
+  assert.equal(res.ok, false);
+  assert.match(res.error ?? "", /Failed to verify/);
+});
diff --git a/apps/swarmagents/lib/board/branch-check.ts b/apps/swarmagents/lib/board/branch-check.ts
new file mode 100644
index 000000000..8a14e3512
--- /dev/null
+++ b/apps/swarmagents/lib/board/branch-check.ts
@@ -0,0 +1,57 @@
+/**
+ * Optional verification that a git branch exists on the origin remote before
+ * the board accepts a `submit_task_work` submission. The check is on by
+ * default and can be disabled with `SWARM_GIT_REMOTE_CHECK=0` (e.g. in unit
+ * tests, or when the host has no git access to the repository).
+ */
+
+import { execFile } from "node:child_process";
+import { promisify } from "node:util";
+
+const execFileAsync = promisify(execFile);
+
+export type GitRunner = (args: string[]) => Promise<{ stdout: string }>;
+
+const defaultGitRunner: GitRunner = (args) => execFileAsync("git", args, { encoding: "utf8" });
+
+export interface BranchCheckOptions {
+  remote?: string;
+  timeoutMs?: number;
+  enforce?: boolean;
+  runGit?: GitRunner;
+}
+
+export interface BranchCheckResult {
+  ok: boolean;
+  error?: string;
+}
+
+/**
+ * Return whether `branch` exists on the configured remote. When the check is
+ * disabled (or no runner is provided), it always passes.
+ */
+export async function verifyBranchPushed(
+  branch: string,
+  opts: BranchCheckOptions = {}
+): Promise<BranchCheckResult> {
+  const enforce = opts.enforce ?? process.env.SWARM_GIT_REMOTE_CHECK !== "0";
+  if (!enforce) return { ok: true };
+
+  const remote = opts.remote ?? "origin";
+  const runGit = opts.runGit ?? defaultGitRunner;
+
+  try {
+    const { stdout } = await runGit(["ls-remote", "--heads", remote, branch]);
+    const found = stdout.split("\n").some((line) => line.includes(`refs/heads/${branch}`));
+    if (found) return { ok: true };
+    return {
+      ok: false,
+      error: `Branch "${branch}" was not found on remote "${remote}". Push it first with: git push -u origin ${branch}`,
+    };
+  } catch (err) {
+    return {
+      ok: false,
+      error: `Failed to verify branch "${branch}" on remote "${remote}": ${err instanceof Error ? err.message : String(err)}`,
+    };
+  }
+}
