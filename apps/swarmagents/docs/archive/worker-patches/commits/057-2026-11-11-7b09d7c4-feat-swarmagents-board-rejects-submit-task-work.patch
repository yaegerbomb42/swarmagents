+  // The worker must have pushed the branch to origin before submitting (the
+  // submission only records a branch name). Verify the ref exists remotely
+  // unless the check is disabled via SWARM_GIT_REMOTE_CHECK=0.
+  const branchCheck = await verifyBranchPushed(args.gitBranch as string);
+  if (!branchCheck.ok) {
+    return { error: invalidParams(branchCheck.error ?? "gitBranch could not be verified on origin") };
+  }
+
