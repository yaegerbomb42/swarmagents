   if (!task) return { error: notFound("Task not found") };
   task.status = "in_review";
diff --git a/apps/swarmagents/lib/board/validation.ts b/apps/swarmagents/lib/board/validation.ts
index 601fd07db..0fcde2e1c 100644
--- a/apps/swarmagents/lib/board/validation.ts
+++ b/apps/swarmagents/lib/board/validation.ts
@@ -124,11 +124,35 @@ export function validateClaimTask(args: Record<string, unknown>): ValidationErro
   return errs;
 }
 
+/** Prefixes a worker branch must carry. */
+const ALLOWED_BRANCH_PREFIXES = ["feat/", "fix/", "docs/"] as const;
+
+/**
+ * Validate a gitBranch value for a submission. It must be a non-empty string,
+ * must not be a trunk branch (main/master), and must carry an allowed prefix
+ * (feat/, fix/, docs/). Returns a validation error or null.
+ */
+export function validateGitBranch(branch: unknown): ValidationError | null {
+  const e = requiredString(branch, "gitBranch", 200);
+  if (e) return e;
+  const value = (branch as string).trim();
+  if (value === "main" || value === "master") {
+    return { field: "gitBranch", message: "gitBranch must not be the main or master branch" };
+  }
+  if (!ALLOWED_BRANCH_PREFIXES.some((prefix) => value.startsWith(prefix))) {
+    return {
+      field: "gitBranch",
+      message: `gitBranch must start with one of: ${ALLOWED_BRANCH_PREFIXES.join(", ")}`,
+    };
+  }
+  return null;
+}
+
 export function validateSubmitTaskWork(args: Record<string, unknown>): ValidationError[] {
   const errs: ValidationError[] = [];
   const e1 = requiredString(args.taskId, "taskId");
   if (e1) errs.push(e1);
-  const e2 = requiredString(args.gitBranch, "gitBranch", 200);
+  const e2 = validateGitBranch(args.gitBranch);
   if (e2) errs.push(e2);
   const e3 = requiredString(args.summary, "summary", 8000);
   if (e3) errs.push(e3);
