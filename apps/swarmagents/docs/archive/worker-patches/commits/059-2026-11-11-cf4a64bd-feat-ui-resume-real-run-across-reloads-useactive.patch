@@ -0,0 +1,115 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import {
+  LAST_RUN_ID_KEY,
+  RESUME_RECENT_WINDOW_MS,
+  readLastRunIdHint,
+  selectRunToResume,
+  writeLastRunIdHint,
+  type RunResumeSelection,
+} from "./useActiveRun";
+
+const NOW = 1_700_000_000_000;
+
+function run(overrides: Partial<{ runId: string; status: string; prompt: string; createdAt: number }> = {}) {
+  return {
+    runId: "run_test",
+    status: "finished",
+    prompt: "hello",
+    createdAt: NOW - 1000,
+    ...overrides,
+  };
+}
+
+function idOf(selection: RunResumeSelection): string | null {
+  return selection.kind === "run" ? selection.run.runId : null;
+}
+
+test("selects the running run when present", () => {
+  const runs = [
+    run({ runId: "run_finished", status: "finished", createdAt: NOW - 60_000 }),
+    run({ runId: "run_running", status: "running", createdAt: NOW - 5000 }),
+  ];
+  assert.equal(idOf(selectRunToResume(runs, null, NOW)), "run_running");
+});
+
+test("prefers the hinted run when it is still running", () => {
+  const runs = [
+    run({ runId: "run_older", status: "running", createdAt: NOW - 60_000 }),
+    run({ runId: "run_newer", status: "running", createdAt: NOW - 5000 }),
+  ];
+  assert.equal(idOf(selectRunToResume(runs, "run_older", NOW)), "run_older");
+});
+
+test("picks the earliest-created running run when no hint", () => {
+  // Dur master summaries fold queued runs to "running"; the active run is the
+  // one created first (queued runs were created after it).
+  const runs = [
+    run({ runId: "run_second", status: "running", createdAt: NOW - 2000 }),
+    run({ runId: "run_first", status: "running", createdAt: NOW - 10_000 }),
+    run({ runId: "run_third", status: "running", createdAt: NOW - 1000 }),
+  ];
+  assert.equal(idOf(selectRunToResume(runs, null, NOW)), "run_first");
+});
+
+test("falls back to the most recent finished run within the window", () => {
+  const runs = [
+    run({ runId: "run_old_finished", status: "finished", createdAt: NOW - RESUME_RECENT_WINDOW_MS - 1000 }),
+    run({ runId: "run_recent_finished", status: "finished", createdAt: NOW - 10_000 }),
+    run({ runId: "run_newer_finished", status: "finished", createdAt: NOW - 2000 }),
+  ];
+  assert.equal(idOf(selectRunToResume(runs, null, NOW)), "run_newer_finished");
+});
+
+test("prefers the hinted finished run when several finished recently", () => {
+  const runs = [
+    run({ runId: "run_b", status: "finished", createdAt: NOW - 2000 }),
+    run({ runId: "run_a", status: "finished", createdAt: NOW - 10_000 }),
+  ];
+  assert.equal(idOf(selectRunToResume(runs, "run_a", NOW)), "run_a");
+});
+
+test("ignores finished runs outside the recent window", () => {
+  const runs = [
+    run({ runId: "run_stale", status: "finished", createdAt: NOW - RESUME_RECENT_WINDOW_MS - 1 }),
+    run({ runId: "run_cancelled", status: "cancelled", createdAt: NOW - 5000 }),
+    run({ runId: "run_error", status: "error", createdAt: NOW - 5000 }),
+  ];
+  assert.equal(selectRunToResume(runs, null, NOW).kind, "none");
+});
+
+test("returns none when no runs qualify", () => {
+  assert.equal(selectRunToResume([], null, NOW).kind, "none");
+  assert.equal(selectRunToResume([run({ status: "cancelled" })], null, NOW).kind, "none");
+});
+
+test("ignores malformed entries", () => {
+  const runs = [null, 42, { status: "running" }, { runId: "" }];
+  assert.equal(selectRunToResume(runs, null, NOW).kind, "none");
+});
+
+test("sessionStorage hint round-trips through read/write", () => {
+  const store = new Map<string, string>();
+  const fakeStorage = {
+    getItem: (key: string) => store.get(key) ?? null,
+    setItem: (key: string, value: string) => void store.set(key, value),
+    removeItem: (key: string) => void store.delete(key),
+  };
+
+  assert.equal(readLastRunIdHint(fakeStorage), null);
+  writeLastRunIdHint("run_abc", fakeStorage);
+  assert.equal(readLastRunIdHint(fakeStorage), "run_abc");
+  assert.equal(store.get(LAST_RUN_ID_KEY), "run_abc");
+
+  writeLastRunIdHint(null, fakeStorage);
+  assert.equal(readLastRunIdHint(fakeStorage), null);
+});
+
+test("hint helpers survive missing storage", () => {
+  assert.equal(readLastRunIdHint(null), null);
+  assert.doesNotThrow(() => writeLastRunIdHint("run_abc", null));
+});
+
+test("resume window is 10 minutes", () => {
+  assert.equal(RESUME_RECENT_WINDOW_MS, 10 * 60 * 1000);
+});
diff --git a/apps/swarmagents/lib/client/useActiveRun.ts b/apps/swarmagents/lib/client/useActiveRun.ts
new file mode 100644
index 000000000..198decb8e
--- /dev/null
+++ b/apps/swarmagents/lib/client/useActiveRun.ts
@@ -0,0 +1,251 @@
+"use client";
+
+/**
+ * useActiveRun() — restore the user's live run across reloads.
+ *
+ * runId previously lived only in React state (App.tsx), so a reload lost the
+ * live view while the run kept going server-side. On mount this hook asks
+ * GET /api/runtime/runs for the caller's durable runs and picks the one
+ * worth resuming:
+ *
+ *   - a running run first. The durable summary folds a queued run to "running"
+ *     too, so the earliest-created running run is the active one (queued runs
+ *     are created after it);
+ *   - otherwise the most recent finished run within RESUME_RECENT_WINDOW_MS.
+ *
+ * A sessionStorage hint (LAST_RUN_ID_KEY) is written whenever a run starts or
+ * is restored and biases the choice when several runs qualify, so a reload
+ * lands back on the run the user was watching.
+ *
+ * The caller passes the resolved runId + prompt to the existing useRunStream
+ * machinery (ComputerScreen): the SSE endpoint replays the run's events from
+ * seq 0, falling back to the run's durable log when the in-memory ring buffer
+ * has evicted early events, so the terminal/timeline repopulate and keep
+ * streaming.
+ */
+
+import { useCallback, useEffect, useState } from "react";
+
+export const LAST_RUN_ID_KEY = "ac.lastRunId";
+
+/** Only finished runs this recent are worth resurrecting on reload. */
+export const RESUME_RECENT_WINDOW_MS = 10 * 60 * 1000;
+
+/** Loose client-side view of a StoredRunSummary (GET /api/runtime/runs). */
+export interface StoredRunLite {
+  runId: string;
+  status?: string;
+  prompt?: string;
+  createdAt?: number;
+}
+
+export type RunResumeSelection =
+  | { kind: "run"; run: StoredRunLite }
+  | { kind: "none" };
+
+function isUsableRun(value: unknown): value is StoredRunLite {
+  return (
+    typeof value === "object" &&
+    value !== null &&
+    typeof (value as StoredRunLite).runId === "string" &&
+    (value as StoredRunLite).runId.length > 0
+  );
+}
+
+/**
+ * Pick the run to resume after a reload. Order of preference:
+ *
+ *  1. the hinted run when it is still running — it is what the user was
+ *     watching when they reloaded;
+ *  2. otherwise the running run with the oldest createdAt: the durable summary
+ *     folds queued runs to "running", so this is the active one, since queued
+ *     runs were created after it;
+ *  3. the hinted run when it finished within the recent window;
+ *  4. the most recent finished run within the recent window.
+ *
+ * Cancelled/errored runs are never resumed.
+ */
+export function selectRunToResume(
+  runs: readonly unknown[],
+  hint: string | null,
+  now: number = Date.now(),
+): RunResumeSelection {
+  const valid = runs.filter(isUsableRun);
+
+  const running = valid.filter((run) => run.status === "running");
+  if (running.length > 0) {
+    if (hint) {
+      const hinted = running.find((run) => run.runId === hint);
+      if (hinted) return { kind: "run", run: hinted };
+    }
+    const active = running.reduce((a, b) =>
+      (b.createdAt ?? Number.POSITIVE_INFINITY) <
+      (a.createdAt ?? Number.POSITIVE_INFINITY)
+        ? b
+        : a,
+    );
+    return { kind: "run", run: active };
+  }
+
+  const recentlyFinished = valid.filter(
+    (run) =>
+      run.status === "finished" &&
+      typeof run.createdAt === "number" &&
+      now - run.createdAt <= RESUME_RECENT_WINDOW_MS,
+  );
+  if (recentlyFinished.length > 0) {
+    if (hint) {
+      const hinted = recentlyFinished.find((run) => run.runId === hint);
+      if (hinted) return { kind: "run", run: hinted };
+    }
+    const latest = recentlyFinished.reduce((a, b) =>
+      (b.createdAt ?? 0) > (a.createdAt ?? 0) ? b : a,
+    );
+    return { kind: "run", run: latest };
+  }
+
+  return { kind: "none" };
+}
+
+type StorageLike = Pick<Storage, "getItem" | "setItem" | "removeItem">;
+
+/** sessionStorage, or null when unavailable (SSR, private mode). */
+function safeSessionStorage(): StorageLike | null {
+  try {
+    return typeof window === "undefined" ? null : window.sessionStorage;
+  } catch {
+    return null;
+  }
+}
+
+export function readLastRunIdHint(
+  storage: StorageLike | null = safeSessionStorage(),
+): string | null {
+  if (!storage) return null;
+  try {
+    const raw = storage.getItem(LAST_RUN_ID_KEY);
+    return raw && raw.length > 0 ? raw.slice(0, 64) : null;
+  } catch {
+    return null;
+  }
+}
+
+export function writeLastRunIdHint(
+  runId: string | null | undefined,
+  storage: StorageLike | null = safeSessionStorage(),
+): void {
+  if (!storage) return;
+  try {
+    if (runId) storage.setItem(LAST_RUN_ID_KEY, runId.slice(0, 64));
+    else storage.removeItem(LAST_RUN_ID_KEY);
+  } catch {
+    // Storage can be unavailable (private mode); the hint is best-effort.
+  }
+}
+
+export type ActiveRunOutcome =
+  | "idle"
+  | "loading"
+  | "restored"
+  | "none"
+  | "unauthorized"
+  | "error";
+
+export interface ActiveRunState {
+  outcome: ActiveRunOutcome;
+  /** True while the initial runs fetch is in flight. */
+  restoring: boolean;
+  /** Resumed run id, when outcome === "restored". */
+  runId?: string;
+  /** The resumed run's prompt (for the telemetry / thread panel). */
+  prompt?: string;
+  /** True when the resumed run is still live (status "running"). */
+  live?: boolean;
+  error?: { status?: number; message: string };
+}
+
+export function useActiveRun(): ActiveRunState & { retry: () => void } {
+  const [state, setState] = useState<ActiveRunState>({
+    outcome: "idle",
+    restoring: false,
+  });
+  const [attempt, setAttempt] = useState(0);
+
+  useEffect(() => {
+    let cancelled = false;
+    setState((prev) => ({
+      ...prev,
+      outcome: "loading",
+      restoring: true,
+      error: undefined,
+    }));
+
+    (async () => {
+      let res: Response;
+      try {
+        res = await fetch("/api/runtime/runs?limit=20", {
+          headers: { Accept: "application/json" },
+          cache: "no-store",
+        });
+      } catch {
+        if (!cancelled) {
+          setState({
+            outcome: "error",
+            restoring: false,
+            error: { message: "Could not reach the runtime." },
+          });
+        }
+        return;
+      }
+      if (cancelled) return;
+
+      if (res.status === 401) {
+        setState({ outcome: "unauthorized", restoring: false });
+        return;
+      }
+      if (!res.ok) {
+        const body: unknown = await res.json().catch(() => null);
+        const message =
+          body &&
+          typeof body === "object" &&
+          typeof (body as { error?: unknown }).error === "string"
+            ? (body as { error: string }).error
+            : `Server responded ${res.status}.`;
+        setState({
+          outcome: "error",
+          restoring: false,
+          error: { status: res.status, message },
+        });
+        return;
+      }
+
+      const body: unknown = await res.json().catch(() => null);
+      const runs =
+        body && typeof body === "object" && Array.isArray((body as { runs?: unknown }).runs)
+          ? (body as { runs: unknown[] }).runs
+          : [];
+      const selection = selectRunToResume(runs, readLastRunIdHint());
+      if (selection.kind === "run") {
+        writeLastRunIdHint(selection.run.runId);
+        setState({
+          outcome: "restored",
+          restoring: false,
+          runId: selection.run.runId,
+          prompt:
+            typeof selection.run.prompt === "string" ? selection.run.prompt : undefined,
+          live: selection.run.status === "running",
+        });
+      } else {
+        setState({ outcome: "none", restoring: false });
+      }
+    })();
+
+    return () => {
+      cancelled = true;
+    };
+  }, [attempt]);
+
+  const retry = useCallback(() => setAttempt((n) => n + 1), []);
+
+  return { ...state, retry };
+}
