+test("a fresh connection replays the durable log when the bus holds nothing", async () => {
+  const { dir, cleanup } = tempDir();
+  try {
+    // A run that finished long ago: the bus no longer holds it (idle eviction
+    // or a restart), so a reload connects from seq 0 and must get the whole
+    // run from the durable log.
+    const oldProcess = new TelemetryBus({ persist: true, runsDir: () => dir });
+    oldProcess.publish("run_fresh_log", { type: "one" });
+    oldProcess.publish("run_fresh_log", { type: "two" });
+    oldProcess.publish("run_fresh_log", { type: "three" });
+
+    const fresh = new TelemetryBus();
+    assert.equal(fresh.latestSeq("run_fresh_log"), 0);
+
+    const ac = new AbortController();
+    const stream = sseResponse("run_fresh_log", 0, ac.signal, { bus: fresh, keepAliveMs: 60_000, runsDir: dir });
+    const types = await readUntil(stream, "three", ac);
+    assert.deepEqual(types, ["one", "two", "three"]);
+  } finally {
+    cleanup();
+  }
+});
+
+test("a fresh connection replays evicted early events from the durable log", async () => {
+  const { dir, cleanup } = tempDir();
+  try {
+    // The bus ring buffer evicted the run's early events (capacity 2), so a
+    // fresh connection must fall back to the durable log for the full run —
+    // without duplicating the events the buffer still holds.
+    const bus = new TelemetryBus({ persist: true, runsDir: () => dir, capacity: 2 });
+    bus.publish("run_fresh_evicted", { type: "one" });
+    bus.publish("run_fresh_evicted", { type: "two" });
+    bus.publish("run_fresh_evicted", { type: "three" });
+    bus.publish("run_fresh_evicted", { type: "four" });
+
+    const ac = new AbortController();
+    const stream = sseResponse("run_fresh_evicted", 0, ac.signal, { bus, keepAliveMs: 60_000, runsDir: dir });
+    const types = await readUntil(stream, "four", ac);
+    assert.deepEqual(types, ["one", "two", "three", "four"]);
+  } finally {
+    cleanup();
+  }
+});
+
+test("a fresh connection with a live bus replays the buffer once, no duplicates", async () => {
+  const { dir, cleanup } = tempDir();
+  try {
+    const bus = new TelemetryBus({ persist: true, runsDir: () => dir });
+    bus.publish("run_fresh_live", { type: "one" });
+    bus.publish("run_fresh_live", { type: "two" });
+    bus.publish("run_fresh_live", { type: "three" });
+
+    const ac = new AbortController();
+    const stream = sseResponse("run_fresh_live", 0, ac.signal, { bus, keepAliveMs: 60_000, runsDir: dir });
+    const types = await readUntil(stream, "three", ac);
+    assert.deepEqual(types, ["one", "two", "three"]);
+  } finally {
+    cleanup();
+  }
+});
+
