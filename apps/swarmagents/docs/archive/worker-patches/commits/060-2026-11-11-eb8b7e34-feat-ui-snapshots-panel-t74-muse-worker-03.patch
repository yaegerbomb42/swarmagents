@@ -0,0 +1,38 @@
+/**
+ * Snapshot label validation, shared by the server and the browser UI.
+ *
+ * This module has no imports — not even node builtins — so the minimalist UI
+ * can import it directly. Snapshot labels become a docker image tag, so they
+ * keep the conservative tag charset: 1-64 chars, lowercase alphanumerics plus
+ * `.`, `_` and `-`, starting with an alphanumeric, and no `..` (which docker
+ * rejects). The regex and the rule live here exactly once; docker-driver.ts
+ * re-exports them, and the Snapshots panel validates with the same code the
+ * API route uses.
+ */
+
+/** The server-side label charset, shared with the client. */
+export const SNAPSHOT_LABEL_RE = /^[a-z0-9][a-z0-9._-]{0,63}$/;
+
+/** Human-readable form of the label rule, for inline form errors. */
+export const SNAPSHOT_LABEL_RULE =
+  "1–64 characters: lowercase letters, digits, . _ -, starting with a letter or digit, no “..”";
+
+/** Validate a user-supplied snapshot label (throws on anything unsafe). */
+export function validateSnapshotLabel(label: string): void {
+  if (!SNAPSHOT_LABEL_RE.test(label) || label.includes("..")) {
+    throw new Error(`Invalid snapshot label: ${JSON.stringify(label)}`);
+  }
+}
+
+/**
+ * Friendly validation message for a label, or null when the label is valid.
+ * The client form uses this so the inline error matches the server rejection.
+ */
+export function snapshotLabelError(label: string): string | null {
+  if (!label) return "Label is required.";
+  if (label.length > 64) return "Label must be at most 64 characters.";
+  if (!SNAPSHOT_LABEL_RE.test(label) || label.includes("..")) {
+    return `Invalid label — ${SNAPSHOT_LABEL_RULE}.`;
+  }
+  return null;
+}
