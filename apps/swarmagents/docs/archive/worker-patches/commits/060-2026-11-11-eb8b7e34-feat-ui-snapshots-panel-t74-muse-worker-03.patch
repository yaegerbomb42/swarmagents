+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  SnapshotsError,
+  createSnapshot,
+  describeSnapshotsError,
+  fetchSnapshots,
+  restoreSnapshot,
+  type FetchLike,
+} from "./snapshots";
+
+function fakeFetch(body: unknown, init?: ResponseInit & { raw?: string }): FetchLike {
+  return async () =>
+    new Response(init?.raw ?? JSON.stringify(body), {
+      status: init?.status ?? 200,
+      headers: { "content-type": "application/json" },
+    });
+}
+
+test("fetchSnapshots parses the caller's snapshots newest first", async () => {
+  const fetchImpl = fakeFetch({
+    snapshots: [
+      { label: "second", createdAt: 2000 },
+      { label: "first", createdAt: 1000 },
+    ],
+  });
+  const list = await fetchSnapshots({ fetchImpl });
+  assert.deepEqual(
+    list.map((s) => s.label),
+    ["second", "first"],
+  );
+  assert.equal(list[0]?.createdAt, 2000);
+});
+
+test("fetchSnapshots rejects a malformed list payload", async () => {
+  await assert.rejects(
+    () => fetchSnapshots({ fetchImpl: fakeFetch({ snapshots: "nope" }) }),
+    (err: unknown) => err instanceof SnapshotsError && err.kind === "malformed",
+  );
+  await assert.rejects(
+    () => fetchSnapshots({ fetchImpl: fakeFetch({ snapshots: [{ label: "ok" }] }) }),
+    (err: unknown) => err instanceof SnapshotsError && err.kind === "malformed",
+  );
+});
+
+test("createSnapshot posts create + label and returns the created snapshot", async () => {
+  let seenUrl = "";
+  let seenInit: RequestInit | undefined;
+  const fetchImpl: FetchLike = async (url, init) => {
+    seenUrl = String(url);
+    seenInit = init;
+    return new Response(
+      JSON.stringify({ ok: true, snapshot: { label: "before-edit", createdAt: 3000 } }),
+      { status: 201, headers: { "content-type": "application/json" } },
+    );
+  };
+  const created = await createSnapshot("before-edit", { fetchImpl });
+  assert.equal(seenUrl, "/api/runtime/vm/snapshots");
+  assert.equal(seenInit?.method, "POST");
+  assert.deepEqual(JSON.parse(String(seenInit?.body)), { action: "create", label: "before-edit" });
+  assert.equal(created.label, "before-edit");
+  assert.equal(created.createdAt, 3000);
+});
+
+test("createSnapshot surfaces a 400 label rejection as invalid_label", async () => {
+  await assert.rejects(
+    () =>
+      createSnapshot("BAD", {
+        fetchImpl: fakeFetch({ error: "Invalid snapshot label: \"BAD\"" }, { status: 400 }),
+      }),
+    (err: unknown) =>
+      err instanceof SnapshotsError &&
+      err.kind === "invalid_label" &&
+      /Invalid snapshot label/.test(err.message),
+  );
+});
+
+test("restoreSnapshot posts restore + label and accepts the ok payload", async () => {
+  let seenInit: RequestInit | undefined;
+  const fetchImpl: FetchLike = async (_url, init) => {
+    seenInit = init;
+    return new Response(JSON.stringify({ ok: true, label: "before-edit" }), {
+      status: 200,
+      headers: { "content-type": "application/json" },
+    });
+  };
+  await restoreSnapshot("before-edit", { fetchImpl });
+  assert.equal(seenInit?.method, "POST");
+  assert.deepEqual(JSON.parse(String(seenInit?.body)), { action: "restore", label: "before-edit" });
+});
+
+test("restoreSnapshot maps a 404 to not_found with the server message", async () => {
+  await assert.rejects(
+    () =>
+      restoreSnapshot("ghost", {
+        fetchImpl: fakeFetch({ error: "Snapshot not found: \"ghost\"" }, { status: 404 }),
+      }),
+    (err: unknown) =>
+      err instanceof SnapshotsError &&
+      err.kind === "not_found" &&
+      err.status === 404 &&
+      /not found/i.test(err.message),
+  );
+});
+
+test("a failed fetch becomes a network error, and describeSnapshotsError passes messages through", async () => {
+  const failing: FetchLike = async () => {
+    throw new Error("boom");
+  };
+  await assert.rejects(
+    () => fetchSnapshots({ fetchImpl: failing }),
+    (err: unknown) => err instanceof SnapshotsError && err.kind === "network",
+  );
+  assert.equal(describeSnapshotsError(new SnapshotsError("server", "Server broke.")), "Server broke.");
+  assert.equal(describeSnapshotsError(new Error("plain")), "plain");
+  assert.equal(describeSnapshotsError(undefined), "Could not reach the snapshot API.");
+});
diff --git a/apps/swarmagents/lib/client/snapshots.ts b/apps/swarmagents/lib/client/snapshots.ts
new file mode 100644
index 000000000..c60822505
--- /dev/null
+++ b/apps/swarmagents/lib/client/snapshots.ts
@@ -0,0 +1,181 @@
+/**
+ * Client helpers for VM snapshots.
+ *
+ * The UI never talks to the VM directly; it goes through
+ * GET/POST /api/runtime/vm/snapshots. These helpers turn the API's error
+ * payloads into a typed SnapshotsError the panel can surface via toasts.
+ * Label validation itself lives in lib/vm/snapshot-label, shared with the
+ * server — this module only moves snapshots over the wire.
+ */
+
+import type { VmSnapshot } from "../vm/types";
+
+export type { VmSnapshot };
+
+export type SnapshotsErrorKind =
+  | "invalid_label"
+  | "unauthorized"
+  | "not_found"
+  | "bad_request"
+  | "network"
+  | "server"
+  | "malformed";
+
+export class SnapshotsError extends Error {
+  readonly kind: SnapshotsErrorKind;
+  readonly status?: number;
+
+  constructor(kind: SnapshotsErrorKind, message: string, extra?: { status?: number }) {
+    super(message);
+    this.name = "SnapshotsError";
+    this.kind = kind;
+    this.status = extra?.status;
+  }
+}
+
+export type FetchLike = typeof fetch;
+
+export interface SnapshotsRequestOptions {
+  signal?: AbortSignal;
+  /** Injectable fetch for tests and SSR-safe callers. */
+  fetchImpl?: FetchLike;
+}
+
+const SNAPSHOTS_URL = "/api/runtime/vm/snapshots";
+
+const STATUS_ERROR_KIND: Record<number, SnapshotsErrorKind> = {
+  400: "bad_request",
+  401: "unauthorized",
+  404: "not_found",
+};
+
+function isAbortError(err: unknown): boolean {
+  return err instanceof Error && err.name === "AbortError";
+}
+
+function asObject(value: unknown): Record<string, unknown> | null {
+  return value && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : null;
+}
+
+function asString(value: unknown): string | undefined {
+  return typeof value === "string" ? value : undefined;
+}
+
+function asNumber(value: unknown): number | undefined {
+  return typeof value === "number" && Number.isFinite(value) ? value : undefined;
+}
+
+function parseSnapshot(raw: unknown): VmSnapshot {
+  const entry = asObject(raw);
+  const label = asString(entry?.label);
+  const createdAt = asNumber(entry?.createdAt);
+  if (!entry || !label || createdAt === undefined) {
+    throw new SnapshotsError("malformed", "The snapshot API returned an invalid snapshot.");
+  }
+  return {
+    label,
+    createdAt,
+    ...(typeof entry.image === "string" ? { image: entry.image } : {}),
+  };
+}
+
+function parseList(body: unknown): VmSnapshot[] {
+  const obj = asObject(body);
+  if (!obj || !Array.isArray(obj.snapshots)) {
+    throw new SnapshotsError("malformed", "The snapshot API returned an unexpected list payload.");
+  }
+  return obj.snapshots.map(parseSnapshot);
+}
+
+function parseCreated(body: unknown): VmSnapshot {
+  const obj = asObject(body);
+  if (!obj || obj.ok !== true) {
+    throw new SnapshotsError("malformed", "The snapshot API returned an unexpected create payload.");
+  }
+  return parseSnapshot(obj.snapshot);
+}
+
+async function requestJson(
+  init: RequestInit,
+  parse: (body: unknown) => VmSnapshot[] | VmSnapshot,
+  options: SnapshotsRequestOptions,
+): Promise<VmSnapshot[] | VmSnapshot> {
+  const fetchImpl = options.fetchImpl ?? fetch;
+
+  let res: Response;
+  try {
+    res = await fetchImpl(SNAPSHOTS_URL, { ...init, signal: options.signal });
+  } catch (err) {
+    if (isAbortError(err)) throw err;
+    throw new SnapshotsError("network", "Could not reach the snapshot API.");
+  }
+
+  let body: unknown = null;
+  try {
+    body = await res.json();
+  } catch {
+    body = null;
+  }
+
+  if (!res.ok) {
+    const obj = asObject(body);
+    const message = asString(obj?.error) ?? `The snapshot API returned ${res.status}.`;
+    const kind =
+      res.status === 400 && /label/i.test(message)
+        ? "invalid_label"
+        : (STATUS_ERROR_KIND[res.status] ?? "server");
+    throw new SnapshotsError(kind, message, { status: res.status });
+  }
+
+  return parse(body);
+}
+
+/** List the caller's snapshots, newest first (as the API returns them). */
+export async function fetchSnapshots(
+  options: SnapshotsRequestOptions = {},
+): Promise<VmSnapshot[]> {
+  return (await requestJson({ method: "GET" }, parseList, options)) as VmSnapshot[];
+}
+
+/** Create a snapshot with the given label. */
+export async function createSnapshot(
+  label: string,
+  options: SnapshotsRequestOptions = {},
+): Promise<VmSnapshot> {
+  return (await requestJson(
+    {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ action: "create", label }),
+    },
+    parseCreated,
+    options,
+  )) as VmSnapshot;
+}
+
+/** Restore the snapshot with the given label. */
+export async function restoreSnapshot(
+  label: string,
+  options: SnapshotsRequestOptions = {},
+): Promise<void> {
+  await requestJson(
+    {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ action: "restore", label }),
+    },
+    () => [],
+    options,
+  );
+}
+
+/** Message suitable for a toast; unknown errors fall back safely. */
+export function describeSnapshotsError(err: unknown): string {
+  if (err instanceof SnapshotsError) return err.message;
+  if (err instanceof Error && err.message) return err.message;
+  return "Could not reach the snapshot API.";
+}
+
+export { isAbortError };
