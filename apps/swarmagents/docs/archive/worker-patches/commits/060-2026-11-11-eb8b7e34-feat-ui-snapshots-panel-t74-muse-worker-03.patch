+"use client";
+
+import React, { useCallback, useEffect, useState } from "react";
+import {
+  AlertTriangle,
+  Camera,
+  History,
+  Loader2,
+  RefreshCw,
+  RotateCcw,
+  X,
+} from "lucide-react";
+import { useToasts } from "./Toasts";
+import {
+  createSnapshot,
+  describeSnapshotsError,
+  fetchSnapshots,
+  restoreSnapshot,
+  type VmSnapshot,
+} from "../../../lib/client/snapshots";
+import {
+  SNAPSHOT_LABEL_RULE,
+  snapshotLabelError,
+} from "../../../lib/vm/snapshot-label";
+
+function isAbort(err: unknown): boolean {
+  return err instanceof Error && err.name === "AbortError";
+}
+
+function pad2(value: number): string {
+  return String(value).padStart(2, "0");
+}
+
+function formatCreated(createdAt: number): string {
+  if (!createdAt || !Number.isFinite(createdAt)) return "—";
+  const date = new Date(createdAt);
+  if (Number.isNaN(date.getTime())) return "—";
+  return `${date.getUTCFullYear()}-${pad2(date.getUTCMonth() + 1)}-${pad2(date.getUTCDate())} ${pad2(
+    date.getUTCHours(),
+  )}:${pad2(date.getUTCMinutes())}`;
+}
+
+/**
+ * Snapshots panel (t74): lists the caller's VM checkpoints, creates one with
+ * a label validated by the same rule the server enforces
+ * (lib/vm/snapshot-label, shared — never a divergent client copy), and
+ * restores one behind a confirm dialog. API failures surface via the toast
+ * layer; the list itself keeps an inline retry state.
+ */
+export function SnapshotsPanel() {
+  const { push: pushToast } = useToasts();
+  const [snapshots, setSnapshots] = useState<VmSnapshot[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState<string>();
+  const [reload, setReload] = useState(0);
+
+  const [label, setLabel] = useState("");
+  const [labelError, setLabelError] = useState<string>();
+  const [creating, setCreating] = useState(false);
+
+  /** Label awaiting a restore confirmation, or null when no dialog is open. */
+  const [confirmRestore, setConfirmRestore] = useState<string | null>(null);
+  const [restoring, setRestoring] = useState(false);
+
+  const load = useCallback(async (signal: AbortSignal) => {
+    setLoading(true);
+    setError(undefined);
+    try {
+      const data = await fetchSnapshots({ signal });
+      if (signal.aborted) return;
+      setSnapshots(data);
+    } catch (err) {
+      if (isAbort(err) || signal.aborted) return;
+      setError(describeSnapshotsError(err));
+    } finally {
+      if (!signal.aborted) setLoading(false);
+    }
+  }, []);
+
+  useEffect(() => {
+    const ctrl = new AbortController();
+    load(ctrl.signal);
+    return () => ctrl.abort();
+  }, [load, reload]);
+
+  const refresh = useCallback(() => setReload((n) => n + 1), []);
+
+  const onLabelChange = useCallback((value: string) => {
+    setLabel(value);
+    // Live validation with the shared server rule, so an invalid label is
+    // caught here with a clear inline error instead of a round trip.
+    setLabelError(snapshotLabelError(value.trim()) ?? undefined);
+  }, []);
+
+  const handleCreate = useCallback(
+    async (e: React.FormEvent) => {
+      e.preventDefault();
+      const trimmed = label.trim();
+      const validation = snapshotLabelError(trimmed);
+      if (validation) {
+        setLabelError(validation);
+        return;
+      }
+      setCreating(true);
+      try {
+        const created = await createSnapshot(trimmed);
+        setSnapshots((prev) => [created, ...prev.filter((s) => s.label !== created.label)]);
+        setLabel("");
+        setLabelError(undefined);
+        pushToast({ tone: "success", message: `Snapshot “${created.label}” created.` });
+      } catch (err) {
+        if (!isAbort(err)) {
+          pushToast({
+            tone: "error",
+            message: "Could not create snapshot.",
+            detail: describeSnapshotsError(err),
+          });
+        }
+      } finally {
+        setCreating(false);
+      }
+    },
+    [label, pushToast],
+  );
+
+  const handleRestore = useCallback(async () => {
+    if (!confirmRestore) return;
+    const target = confirmRestore;
+    setRestoring(true);
+    try {
+      await restoreSnapshot(target);
+      setConfirmRestore(null);
+      pushToast({ tone: "success", message: `Restored snapshot “${target}”.` });
+      refresh();
+    } catch (err) {
+      if (!isAbort(err)) {
+        pushToast({
+          tone: "error",
+          message: `Could not restore snapshot “${target}”.`,
+          detail: describeSnapshotsError(err),
+        });
+      }
+    } finally {
+      setRestoring(false);
+    }
+  }, [confirmRestore, pushToast, refresh]);
+
+  return (
+    <div className="flex flex-1 min-h-0 flex-col">
+      {/* Toolbar: title + refresh */}
+      <div className="flex items-center gap-2 border-b border-white/10 bg-[#0f0f15] px-3 py-2">
+        <Camera className="h-3.5 w-3.5 shrink-0 text-cyan-400/80" />
+        <span className="min-w-0 flex-1 truncate text-[11px] font-mono text-white/70">
+          Snapshots — checkpoints of your VM, restored on demand
+        </span>
+        <button
+          onClick={refresh}
+          title="Refresh"
+          className="flex shrink-0 items-center gap-1.5 rounded-lg px-2 py-1 text-[11px] font-mono text-white/50 transition hover:bg-white/10 hover:text-white"
+        >
+          <RefreshCw className={`h-3 w-3 ${loading ? "animate-spin" : ""}`} />
+          <span>Refresh</span>
+        </button>
+      </div>
+
+      {/* Create form */}
+      <form
+        onSubmit={handleCreate}
+        className="flex flex-col gap-1.5 border-b border-white/10 px-3 py-3"
+        noValidate
+      >
+        <div className="flex items-center gap-2">
+          <label htmlFor="snapshot-label" className="shrink-0 text-[11px] font-mono text-white/50">
+            New snapshot
+          </label>
+          <input
+            id="snapshot-label"
+            value={label}
+            onChange={(e) => onLabelChange(e.target.value)}
+            placeholder="e.g. before-edit"
+            autoComplete="off"
+            spellCheck={false}
+            aria-invalid={labelError ? true : undefined}
+            aria-describedby={labelError ? "snapshot-label-error" : "snapshot-label-hint"}
+            className={`min-w-0 flex-1 rounded-lg border bg-black/40 px-2.5 py-1.5 font-mono text-[11px] text-white placeholder:text-white/25 focus:outline-none focus:ring-2 ${
+              labelError
+                ? "border-rose-400/40 focus:ring-rose-400/40"
+                : "border-white/10 focus:border-cyan-400/40 focus:ring-cyan-400/30"
+            }`}
+          />
+          <button
+            type="submit"
+            disabled={creating || !label.trim() || Boolean(labelError)}
+            className="flex shrink-0 items-center gap-1.5 rounded-lg border border-cyan-400/30 bg-cyan-400/10 px-2.5 py-1.5 text-[11px] font-mono text-cyan-200 transition hover:bg-cyan-400/20 disabled:cursor-not-allowed disabled:opacity-40"
+          >
+            {creating ? <Loader2 className="h-3 w-3 animate-spin" /> : <Camera className="h-3 w-3" />}
+            <span>{creating ? "Creating…" : "Create"}</span>
+          </button>
+        </div>
+        {labelError ? (
+          <p id="snapshot-label-error" role="alert" className="text-[11px] text-rose-300/90">
+            {labelError}
+          </p>
+        ) : (
+          <p id="snapshot-label-hint" className="text-[10px] text-white/30">
+            Label rule: {SNAPSHOT_LABEL_RULE}.
+          </p>
+        )}
+      </form>
+
+      {/* Snapshot list */}
+      <div className="flex min-w-0 flex-1 flex-col overflow-y-auto scrollbar-thin">
+        {error ? (
+          <div className="flex flex-1 flex-col items-center justify-center gap-2 p-6 text-center">
+            <AlertTriangle className="h-5 w-5 text-rose-400/70" />
+            <div className="text-xs text-rose-300/90">{error}</div>
+            <button
+              onClick={refresh}
+              className="rounded-lg border border-white/10 px-2.5 py-1 text-[11px] text-white/60 hover:bg-white/10 hover:text-white"
+            >
+              Try again
+            </button>
+          </div>
+        ) : loading && snapshots.length === 0 ? (
+          <div className="flex flex-1 items-center justify-center gap-2 p-6 text-xs text-white/40">
+            <Loader2 className="h-4 w-4 animate-spin" /> Loading snapshots…
+          </div>
+        ) : snapshots.length === 0 ? (
+          <div className="flex flex-1 flex-col items-center justify-center gap-1.5 p-6 text-center">
+            <History className="h-6 w-6 text-white/20" />
+            <div className="text-xs text-white/50">No snapshots yet</div>
+            <div className="max-w-[240px] text-[10px] leading-relaxed text-white/25">
+              Create one above to checkpoint your VM — restore it later to roll back to exactly
+              this state.
+            </div>
+          </div>
+        ) : (
+          <>
+            <div className="sticky top-0 z-10 grid grid-cols-[minmax(0,1fr)_112px_96px] items-center gap-2 border-b border-white/5 bg-[#0b0b10]/95 px-3 py-1.5 font-mono text-[10px] uppercase tracking-wider text-white/30 backdrop-blur">
+              <span>Label</span>
+              <span className="text-right">Created</span>
+              <span className="text-right">Restore</span>
+            </div>
+            <div className="p-1.5">
+              {snapshots.map((snap) => (
+                <div
+                  key={snap.label}
+                  className="grid grid-cols-[minmax(0,1fr)_112px_96px] items-center gap-2 rounded-lg px-2 py-1.5 font-mono text-[11px] text-white/70 hover:bg-white/[0.07]"
+                >
+                  <span className="flex min-w-0 items-center gap-2">
+                    <Camera className="h-3.5 w-3.5 shrink-0 text-cyan-400/80" />
+                    <span className="min-w-0 truncate" title={snap.label}>
+                      {snap.label}
+                    </span>
+                  </span>
+                  <span className="text-right text-[10px] text-white/30">
+                    {formatCreated(snap.createdAt)}
+                  </span>
+                  <span className="flex justify-end">
+                    <button
+                      onClick={() => setConfirmRestore(snap.label)}
+                      disabled={restoring}
+                      title={`Restore snapshot “${snap.label}”`}
+                      className="flex items-center gap-1 rounded-lg border border-white/10 px-2 py-1 text-[10px] text-white/60 transition hover:border-emerald-400/40 hover:bg-emerald-400/10 hover:text-emerald-200 disabled:cursor-not-allowed disabled:opacity-40"
+                    >
+                      <RotateCcw className="h-3 w-3" />
+                      <span>Restore</span>
+                    </button>
+                  </span>
+                </div>
+              ))}
+            </div>
+          </>
+        )}
+      </div>
+
+      {/* Restore confirm dialog */}
+      {confirmRestore && (
+        <div className="fixed inset-0 z-50 flex items-center justify-center p-4">
+          <div
+            className="absolute inset-0 bg-black/60"
+            onClick={() => !restoring && setConfirmRestore(null)}
+          />
+          <div
+            role="alertdialog"
+            aria-modal="true"
+            aria-label="Confirm snapshot restore"
+            className="relative w-full max-w-sm rounded-2xl border border-white/10 bg-[#0d0d12] p-6 shadow-2xl"
+          >
+            <div className="mb-2 flex items-center justify-between">
+              <h2 className="text-base font-semibold text-white">Restore snapshot?</h2>
+              <button
+                type="button"
+                onClick={() => setConfirmRestore(null)}
+                disabled={restoring}
+                className="rounded-full p-1 text-white/50 transition hover:bg-white/10 hover:text-white disabled:opacity-40"
+                aria-label="Close restore confirmation"
+              >
+                <X className="h-4 w-4" />
+              </button>
+            </div>
+            <p className="text-sm leading-relaxed text-white/60">
+              This rolls your VM back to snapshot{" "}
+              <span className="font-mono text-[13px] text-cyan-200">“{confirmRestore}”</span>. Any
+              changes made since it was created will be lost.
+            </p>
+            <div className="mt-5 flex justify-end gap-2">
+              <button
+                type="button"
+                onClick={() => setConfirmRestore(null)}
+                disabled={restoring}
+                className="rounded-lg border border-white/10 px-3 py-1.5 text-xs text-white/70 transition hover:bg-white/10 hover:text-white disabled:opacity-40"
+              >
+                Cancel
+              </button>
+              <button
+                type="button"
+                onClick={handleRestore}
+                disabled={restoring}
+                className="flex items-center gap-1.5 rounded-lg border border-emerald-400/40 bg-emerald-400/15 px-3 py-1.5 text-xs font-medium text-emerald-200 transition hover:bg-emerald-400/25 disabled:cursor-not-allowed disabled:opacity-50"
+              >
+                {restoring && <Loader2 className="h-3 w-3 animate-spin" />}
+                {restoring ? "Restoring…" : "Restore snapshot"}
+              </button>
+            </div>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
