+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  SNAPSHOT_LABEL_RE,
+  snapshotLabelError,
+  validateSnapshotLabel,
+} from "./snapshot-label.js";
+
+/**
+ * These are the same cases the server enforces in lib/vm/docker-driver.ts
+ * (which re-exports this module) and in app/api/runtime/vm/snapshots/route.ts.
+ * The client panel imports this module directly, so a label the panel accepts
+ * is a label the API accepts — there is no second, divergent client copy.
+ */
+
+test("validateSnapshotLabel accepts safe docker tag labels", () => {
+  for (const label of ["base", "before-edit", "v1.2", "a_b", "checkpoint-2026"]) {
+    assert.doesNotThrow(() => validateSnapshotLabel(label));
+  }
+});
+
+test("validateSnapshotLabel rejects unsafe labels", () => {
+  for (const label of [
+    "",
+    "Snap",
+    "snap!",
+    "snap:tag",
+    "/abs",
+    "a..b",
+    "-lead",
+    ".lead",
+    "_lead",
+    "has space",
+    "a/b",
+    "x".repeat(65),
+  ]) {
+    assert.throws(() => validateSnapshotLabel(label), /Invalid snapshot label/);
+  }
+});
+
+test("SNAPSHOT_LABEL_RE is the single shared regex", () => {
+  assert.equal(SNAPSHOT_LABEL_RE.source, "^[a-z0-9][a-z0-9._-]{0,63}$");
+  assert.equal(validateSnapshotLabel.length, 1);
+});
+
+test("snapshotLabelError returns null for valid labels and a message otherwise", () => {
+  assert.equal(snapshotLabelError("before-edit"), null);
+  assert.equal(snapshotLabelError("v1.2"), null);
+  assert.equal(snapshotLabelError(""), "Label is required.");
+  assert.match(snapshotLabelError("UPPER") ?? "", /Invalid label/);
+  assert.match(snapshotLabelError("a..b") ?? "", /Invalid label/);
+  assert.match(snapshotLabelError("x".repeat(65)) ?? "", /at most 64/);
+});
