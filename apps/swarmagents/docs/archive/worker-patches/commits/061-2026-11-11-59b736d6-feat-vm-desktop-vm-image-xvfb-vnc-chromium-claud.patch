+#!/usr/bin/env bash
+#
+# build-vm-image.sh — build the swarmagents VM desktop image.
+#
+#   scripts/build-vm-image.sh [--smoke-test]
+#
+# Builds the image from vm-image/ (Dockerfile + entrypoint.sh) and tags it
+# swarmagents-vm-desktop:latest. With --smoke-test, also boots a throwaway
+# container and verifies the acceptance checks: noVNC page served, `claude
+# --version` works, X display is up, Chromium remote debugging is listening.
+set -euo pipefail
+
+cd "$(dirname "$0")/.."
+
+IMAGE="swarmagents-vm-desktop:latest"
+SMOKE=0
+for arg in "$@"; do
+  case "$arg" in
+    --smoke-test) SMOKE=1 ;;
+    *) echo "usage: $0 [--smoke-test]" >&2; exit 2 ;;
+  esac
+done
+
+echo "═══ Building ${IMAGE} ═══"
+docker build --tag "$IMAGE" --file vm-image/Dockerfile vm-image
+
+echo
+echo "═══ Image summary ═══"
+SIZE_BYTES="$(docker image inspect "$IMAGE" --format '{{.Size}}')"
+docker image inspect "$IMAGE" --format \
+  "image: {{.RepoDigests}}
+created: {{.Created}}
+size: ${SIZE_BYTES} bytes ($((SIZE_BYTES / 1048576)) MiB)"
+
+if [ "$SMOKE" -ne 1 ]; then
+  echo
+  echo "Image built. Run it with:"
+  echo "  docker run -d -p 6080:6080 ${IMAGE}"
+  echo "Then open http://localhost:6080/vnc.html"
+  exit 0
+fi
+
+echo
+echo "═══ Smoke test (throwaway container) ═══"
+CNAME="vm-desktop-smoke-$$"
+cleanup() {
+  docker rm -f "$CNAME" >/dev/null 2>&1 || true
+}
+trap cleanup EXIT
+
+# Publish on the host port given in SMOKE_HOST_PORT, or an ephemeral free
+# port if unset (the host may already have something on 6080).
+if [ -n "${SMOKE_HOST_PORT:-}" ]; then
+  HOST_PORT="$SMOKE_HOST_PORT"
+else
+  HOST_PORT="$(python3 - <<'PY'
+import socket
+s = socket.socket()
+s.bind(("127.0.0.1", 0))
+print(s.getsockname()[1])
+s.close()
+PY
+)"
+fi
+echo "Publishing ${HOST_PORT}:6080 (container 6080)"
+docker run -d --name "$CNAME" -p "${HOST_PORT}:6080" "$IMAGE" >/dev/null
+
+pass() { echo "  ✓ $1"; }
+fail() { echo "  ✗ $1"; exit 1; }
+
+# Wait for the noVNC web page (websockify is up and serving /usr/share/novnc).
+ready=false
+for _ in $(seq 1 60); do
+  if docker exec "$CNAME" sh -c '
+      curl -fsS http://127.0.0.1:6080/vnc.html >/dev/null 2>&1'; then
+    ready=true
+    break
+  fi
+  sleep 1
+done
+[ "$ready" = true ] || fail "noVNC page not reachable on :6080"
+pass "noVNC served at http://localhost:6080/vnc.html"
+
+docker exec "$CNAME" claude --version >/dev/null 2>&1 \
+  && pass "docker exec <c> claude --version works" \
+  || fail "claude --version failed inside the container"
+
+docker exec "$CNAME" xdpyinfo -display :1 >/dev/null 2>&1 \
+  && pass "xdpyinfo -display :1 succeeds" \
+  || fail "Xvfb on :1 not running"
+
+docker exec "$CNAME" sh -c '
+  curl -fsS http://127.0.0.1:9222/json/version >/dev/null 2>&1' \
+  && pass "Chromium remote debugging listening on 127.0.0.1:9222" \
+  || fail "Chromium remote debugging not reachable"
+
+echo
+echo "═══ Smoke test passed ═══"
+echo "Container ${CNAME} removed."
diff --git a/apps/swarmagents/vm-image/Dockerfile b/apps/swarmagents/vm-image/Dockerfile
new file mode 100644
index 000000000..cc68d20b1
--- /dev/null
+++ b/apps/swarmagents/vm-image/Dockerfile
@@ -0,0 +1,66 @@
+# syntax=docker/dockerfile:1
+#
+# swarmagents-vm-desktop — Debian bookworm (node 22) VM image with a
+# headless X desktop, VNC access via noVNC, a persistent Chromium with a
+# remote-debugging endpoint, and the Claude Code CLI.
+#
+# Services started by the entrypoint (see entrypoint.sh):
+#   Xvfb :1 (1280x800x24) → openbox + tint2 + wallpaper → x11vnc on
+#   127.0.0.1:5900 → websockify/noVNC on 0.0.0.0:6080 → Chromium with
+#   remote debugging on 127.0.0.1:9222.
+
+FROM node:22-bookworm-slim
+
+ENV DEBIAN_FRONTEND=noninteractive \
+    DISPLAY=:1 \
+    HOME=/home/agent \
+    LANG=C.UTF-8
+
+# Desktop + X + VNC stack, browser and tooling. novnc/websockify from the
+# Debian archive keeps the image free of third-party git hosts.
+RUN apt-get update && apt-get install -y --no-install-recommends \
+    xvfb \
+    x11-utils \
+    xauth \
+    openbox \
+    tint2 \
+    feh \
+    imagemagick \
+    x11vnc \
+    novnc \
+    websockify \
+    chromium \
+    git \
+    curl \
+    python3 \
+    build-essential \
+    tmux \
+    ca-certificates \
+    && rm -rf /var/lib/apt/lists/*
+
+# Non-root user for the desktop session (uid 1000, matches the host volume
+# owner) and the workspace mount point. The base image's `node` user also
+# has uid 1000, so drop it first to keep the uid unique.
+RUN userdel -r node \
+    && useradd --create-home --uid 1000 --shell /bin/bash agent \
+    && mkdir -p /workspace /home/agent/.chromium \
+    && chown -R agent:agent /home/agent /workspace
+
+# Simple gradient wallpaper for the desktop.
+RUN convert -size 1280x800 gradient:"#34346a-#14142a" /home/agent/wallpaper.png \
+    && chown agent:agent /home/agent/wallpaper.png
+
+# Claude Code CLI (global install → /usr/local/bin/claude).
+RUN npm install --global @anthropic-ai/claude-code
+
+COPY entrypoint.sh /usr/local/bin/entrypoint.sh
+RUN chmod +x /usr/local/bin/entrypoint.sh
+
+USER agent
+WORKDIR /workspace
+
+# 6080 = noVNC (web + websockify proxy); 9222 = Chromium remote debugging
+# (loopback); 5900 = x11vnc (loopback, proxied via websockify).
+EXPOSE 6080 5900 9222
+
+ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
