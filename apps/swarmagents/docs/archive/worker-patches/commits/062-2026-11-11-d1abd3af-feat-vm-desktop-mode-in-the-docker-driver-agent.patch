--- a/apps/swarmagents/README.md
+++ b/apps/swarmagents/README.md
@@ -212,6 +212,28 @@ user keeps their files. The policy lives in `lib/vm/idle.ts`
 (`resolveIdlePolicy`) and the timer in `lib/vm/idle-sweeper.ts` (wired by the
 VM manager).
 
+### Desktop VMs (agent user + reachable display)
+
+The docker driver can run a *desktop* image (`vm-desktop`) instead of the
+headless stub container:
+
+- The container keeps the image's own entrypoint (no `tail -f /dev/null`
+  stub), runs as the non-root `agent` user (`--user 1000:1000`), gets
+  `DISPLAY=:1` and a bigger `/dev/shm` (`--shm-size 512m`) so Chromium can
+  run.
+- Instead of publishing host ports, the VM is attached to a user-defined
+  bridge network (`SWARM_VM_NETWORK`, default `swarm-vms`, created on demand),
+  so the app reaches it by container IP. `driver.display(userId)` returns
+  `{host, port}` — the container IP on that network plus the in-VM display
+  port (6080) — or `null` when there is no display (e.g. the fake driver).
+- Execs run as the same user with `HOME=/home/agent`.
+- Desktop mode is on when `SWARM_VM_DESKTOP=1`, off when `SWARM_VM_DESKTOP=0`,
+  and otherwise inferred from the image name (an image containing
+  `vm-desktop` is treated as a desktop image).
+- Containers created before desktop mode existed are detected (they lack the
+  `swarm.vm.desktop=1` label) and recreated on the next `ensure()` — the
+  `/workspace` volume is kept, so the user's files survive the upgrade.
+
 ### Provider catalog and key storage
 
 `lib/providers/catalog.ts` holds `PROVIDER_CATALOG`: one typed entry per
@@ -307,6 +329,8 @@ Never commit real keys. All provider keys live in env only.
 | `SWARM_VM_IDLE_MIN` | `30` | Minutes of inactivity before a persistent VM is stopped (0 = never stop). |
 | `SWARM_VM_SWEEP_INTERVAL_SEC` | `60` | How often the idle sweeper checks for idle VMs. |
 | `SWARM_VM_ENV_ALLOW` | unset | Comma-separated extra env var names forwarded into VMs. |
+| `SWARM_VM_DESKTOP` | inferred from the image name | `1` forces desktop mode (agent user + display endpoint), `0` disables it; unset infers it from an image containing `vm-desktop`. |
+| `SWARM_VM_NETWORK` | `swarm-vms` | User-defined bridge network desktop VMs attach to (created on demand); the VM is reached by container IP, not published host ports. |
 | `CLAUDE_BIN` | `claude` | Path to the Claude Code CLI binary inside the VM. |
 | `SWARM_APPROVAL_TIMEOUT_SEC` | `300` | Seconds before an unanswered ask-level approval auto-denies and halts the run. |
 | `ANTHROPIC_API_KEY` | unset | Provider key forwarded to the VM for Claude Code. |
diff --git a/apps/swarmagents/lib/vm/docker-driver.test.ts b/apps/swarmagents/lib/vm/docker-driver.test.ts
new file mode 100644
index 000000000..7331fc0d6
--- /dev/null
+++ b/apps/swarmagents/lib/vm/docker-driver.test.ts
@@ -0,0 +1,440 @@
+/**
+ * Docker driver tests — desktop mode (l2).
+ *
+ * Desktop mode runs the `vm-desktop` image as the non-root `agent` user with
+ * a reachable display endpoint: no `tail -f /dev/null` stub, DISPLAY=:1,
+ * a bigger /dev/shm for Chromium, the shared bridge network instead of
+ * published host ports, and a label so legacy containers can be detected and
+ * recreated (without touching the /workspace volume).
+ */
+import test from "node:test";
+import assert from "node:assert/strict";
+import { EventEmitter } from "node:events";
+import type { ChildProcess, SpawnOptions } from "node:child_process";
+import {
+  DockerVmDriver,
+  buildExecArgs,
+  buildRunArgs,
+  resolveDesktopMode,
+  resolveVmNetwork,
+  DEFAULT_VM_NETWORK,
+  VM_DESKTOP_LABEL,
+  VM_DESKTOP_USER,
+  VM_DISPLAY_PORT,
+} from "./docker-driver.js";
+import { FakeVmDriver } from "./fake-driver.js";
+import type { VmHandle } from "./types.js";
+
+// ---------------------------------------------------------------------------
+// Fake spawn — captures argv/env and drives child-process events.
+// ---------------------------------------------------------------------------
+
+interface FakeSpawnCall {
+  cmd: string;
+  args: readonly string[];
+  opts: SpawnOptions;
+  cp: {
+    emitClose: (code: number | null) => void;
+    emitError: (err: Error) => void;
+    kill: (sig?: string) => boolean;
+    killed: boolean;
+    stdout: EventEmitter;
+    stderr: EventEmitter;
+  };
+}
+
+function makeFakeSpawn() {
+  const calls: FakeSpawnCall[] = [];
+  const spawnFn = (cmd: string, args: readonly string[], opts?: SpawnOptions): ChildProcess => {
+    const stdout = new EventEmitter();
+    const stderr = new EventEmitter();
+    const emitter = new EventEmitter();
+    const call: FakeSpawnCall = {
+      cmd,
+      args,
+      opts: opts ?? {},
+      cp: {
+        emitClose: (code) => emitter.emit("close", code),
+        emitError: (err) => emitter.emit("error", err),
+        kill: (sig) => {
+          call.cp.killed = true;
+          emitter.emit("close", 143);
+          return true;
+        },
+        killed: false,
+        stdout,
+        stderr,
+      },
+    };
+    calls.push(call);
+    const cp: Record<string, unknown> = {
+      stdout,
+      stderr,
+      on: (ev: string, fn: (...a: unknown[]) => void) => {
+        emitter.on(ev, fn);
+        return cp;
+      },
+      kill: call.cp.kill,
+    };
+    return cp as unknown as ChildProcess;
+  };
+  return { spawnFn, calls };
+}
+
+const flush = () => new Promise((r) => setImmediate(r));
+
+const handle = (userId = "alice"): VmHandle => ({
+  userId,
+  containerName: `swarm-vm-${userId}`,
+  createdAt: Date.now(),
+});
+
+const LEGACY_BASE = {
+  containerName: "swarm-vm-a",
+  volume: "swarm-vm-a-workspace",
+  image: "node:22-bookworm-slim",
+  memory: "2g",
+  cpus: "2",
+  pidsLimit: "512",
+};
+
+// ---------------------------------------------------------------------------
+// Mode / network resolution
+// ---------------------------------------------------------------------------
+
+test("resolveDesktopMode: the explicit override wins over env and image", () => {
+  assert.equal(resolveDesktopMode({ SWARM_VM_DESKTOP: "1" }, "node:22-bookworm-slim", false), false);
+  assert.equal(resolveDesktopMode({ SWARM_VM_DESKTOP: "0" }, "swarm-vm-desktop:latest", true), true);
+  assert.equal(resolveDesktopMode({}, "node:22-bookworm-slim", true), true);
+});
+
+test("resolveDesktopMode: SWARM_VM_DESKTOP forces desktop mode on and off", () => {
+  assert.equal(resolveDesktopMode({ SWARM_VM_DESKTOP: "1" }, "node:22-bookworm-slim"), true);
+  assert.equal(resolveDesktopMode({ SWARM_VM_DESKTOP: "true" }, "node:22-bookworm-slim"), true);
+  assert.equal(resolveDesktopMode({ SWARM_VM_DESKTOP: "yes" }, "node:22-bookworm-slim"), true);
+  assert.equal(resolveDesktopMode({ SWARM_VM_DESKTOP: "0" }, "swarm-vm-desktop:latest"), false);
+  assert.equal(resolveDesktopMode({ SWARM_VM_DESKTOP: "false" }, "swarm-vm-desktop:latest"), false);
+});
+
+test("resolveDesktopMode: unset falls back to the image name", () => {
+  assert.equal(resolveDesktopMode({}, "swarmagents-vm-desktop:latest"), true);
+  assert.equal(resolveDesktopMode({}, "node:22-bookworm-slim"), false);
+  // A blank value is "unset", so the image name still decides.
+  assert.equal(resolveDesktopMode({ SWARM_VM_DESKTOP: "   " }, "swarmagents-vm-desktop:latest"), true);
+});
+
+test("resolveVmNetwork: default, env and explicit override", () => {
+  assert.equal(resolveVmNetwork({}), DEFAULT_VM_NETWORK);
+  assert.equal(resolveVmNetwork({}), "swarm-vms");
+  assert.equal(resolveVmNetwork({ SWARM_VM_NETWORK: "vms" }), "vms");
+  assert.equal(resolveVmNetwork({ SWARM_VM_NETWORK: "  " }), DEFAULT_VM_NETWORK);
+  assert.equal(resolveVmNetwork({ SWARM_VM_NETWORK: "vms" }, "other"), "other");
+});
+
+// ---------------------------------------------------------------------------
+// argv
+// ---------------------------------------------------------------------------
+
+test("buildRunArgs keeps the legacy stub and adds no display args in legacy mode", () => {
+  const argv = buildRunArgs({ ...LEGACY_BASE });
+
+  assert.deepEqual(argv.slice(-4), ["node:22-bookworm-slim", "tail", "-f", "/dev/null"]);
+  assert.equal(argv.includes("--user"), false);
+  assert.equal(argv.includes("--shm-size"), false);
+  assert.equal(argv.includes("--network"), false);
+  assert.equal(argv.some((a) => a.startsWith("DISPLAY=")), false);
+  assert.equal(argv.some((a) => a.startsWith(`${VM_DESKTOP_LABEL}=`)), false);
+  // The hardened profile is unchanged.
+  assert.ok(argv.includes("--security-opt"));
+  assert.ok(argv.includes("--cap-drop"));
+  assert.ok(argv.includes("--init"));
+});
+
+test("buildRunArgs in desktop mode runs as agent with a display and the shared network", () => {
+  const argv = buildRunArgs({ ...LEGACY_BASE, image: "swarmagents-vm-desktop:latest", desktop: true });
+
+  assert.equal(argv[argv.indexOf("--user") + 1], VM_DESKTOP_USER);
+  assert.equal(argv[argv.indexOf("--user") + 1], "1000:1000");
+  assert.equal(argv[argv.indexOf("--shm-size") + 1], "512m");
+  assert.equal(argv[argv.indexOf("-e") + 1], "DISPLAY=:1");
+  assert.equal(argv[argv.indexOf("--network") + 1], "swarm-vms");
+  assert.equal(argv[argv.indexOf("--label") + 1], `${VM_DESKTOP_LABEL}=1`);
+
+  // The image's own CMD runs: no `tail -f /dev/null` stub, image is last.
+  assert.equal(argv.includes("tail"), false);
+  assert.equal(argv.includes("/dev/null"), false);
+  assert.equal(argv[argv.length - 1], "swarmagents-vm-desktop:latest");
+
+  // No host ports are published: the VM is reached over the bridge network.
+  assert.equal(argv.some((a) => a.startsWith("-p") || a.startsWith("--publish")), false);
+
+  // The hardened profile and the workspace volume are untouched.
+  assert.ok(argv.includes("--security-opt"));
+  assert.ok(argv.includes("--cap-drop"));
+  assert.equal(argv[argv.indexOf("--memory") + 1], "2g");
+  assert.equal(argv[argv.indexOf("--cpus") + 1], "2");
+  assert.equal(argv[argv.indexOf("--pids-limit") + 1], "512");
+  assert.equal(argv[argv.indexOf("-v") + 1], "swarm-vm-a-workspace:/workspace");
+});
+
+test("buildRunArgs in desktop mode uses the configured network and keeps the limits", () => {
+  const argv = buildRunArgs({
+    ...LEGACY_BASE,
+    desktop: true,
+    network: "other-vms",
+    memory: "4g",
+    pidsLimit: "1024",
+  });
+  assert.equal(argv[argv.indexOf("--network") + 1], "other-vms");
+  assert.equal(argv[argv.indexOf("--memory") + 1], "4g");
+  assert.equal(argv[argv.indexOf("--pids-limit") + 1], "1024");
+});
+
+test("buildExecArgs only passes --user when one is requested", () => {
+  assert.deepEqual(buildExecArgs("c", ["ls"], {}), ["exec", "--", "c", "ls"]);
+  assert.deepEqual(
+    buildExecArgs("c", ["ls"], { user: VM_DESKTOP_USER }),
+    ["exec", "--user", "1000:1000", "--", "c", "ls"],
+  );
+  assert.deepEqual(
+    buildExecArgs("c", ["ls"], { env: { HOME: "/home/agent" }, user: VM_DESKTOP_USER }),
+    ["exec", "--user", "1000:1000", "-e", "HOME", "--", "c", "ls"],
+  );
+});
+
+// ---------------------------------------------------------------------------
+// ensure() — desktop containers
+// ---------------------------------------------------------------------------
+
+test("DockerVmDriver.ensure in desktop mode creates the network and runs the desktop container", async () => {
+  const { spawnFn, calls } = makeFakeSpawn();
+  const driver = new DockerVmDriver({ spawnFn, image: "swarmagents-vm-desktop:latest", desktop: true });
+
+  const p = driver.ensure("alice");
+  calls[0].cp.emitClose(0); // volume ls -> missing
+  await flush();
+  calls[1].cp.emitClose(0); // volume create
+  await flush();
+  calls[2].cp.emitClose(1); // network inspect -> missing
+  await flush();
+  calls[3].cp.emitClose(0); // network create
+  await flush();
+  calls[4].cp.emitClose(1); // container inspect -> missing
+  await flush();
+  calls[5].cp.emitClose(0); // image inspect -> found
+  await flush();
+
+  const netCreate = calls.find((c) => c.args[0] === "network" && c.args[1] === "create");
+  assert.ok(netCreate, "expected the shared network to be created");
+  assert.deepEqual(netCreate!.args, ["network", "create", "swarm-vms"]);
+
+  const runCall = calls.find((c) => c.args[0] === "run");
+  assert.ok(runCall, "expected a docker run call");
+  const argv = runCall!.args;
+  assert.equal(argv[argv.indexOf("--user") + 1], "1000:1000");
+  assert.equal(argv[argv.indexOf("-e") + 1], "DISPLAY=:1");
+  assert.equal(argv[argv.indexOf("--network") + 1], "swarm-vms");
+  assert.equal(argv.includes("tail"), false);
+
+  runCall!.cp.emitClose(0);
+  const h = await p;
+  assert.equal(h.containerName, "swarm-vm-alice");
+});
+
+test("DockerVmDriver.ensure recreates a legacy container for desktop mode without deleting the workspace volume", async () => {
+  const { spawnFn, calls } = makeFakeSpawn();
+  const driver = new DockerVmDriver({ spawnFn, image: "swarmagents-vm-desktop:latest", desktop: true });
+
+  const p = driver.ensure("alice");
+  calls[0].cp.stdout.emit("data", Buffer.from("swarm-vm-alice-workspace\n"));
+  calls[0].cp.emitClose(0); // volume ls -> volume exists
+  await flush();
+  calls[1].cp.emitClose(0); // network inspect -> exists
+  await flush();
+  calls[2].cp.stdout.emit("data", Buffer.from("running\n"));
+  calls[2].cp.emitClose(0); // container inspect -> exists
+  await flush();
+  calls[3].cp.stdout.emit("data", Buffer.from("{}\n"));
+  calls[3].cp.emitClose(0); // labels -> no desktop label
+  await flush();
+
+  const rm = calls.find((c) => c.args[0] === "rm");
+  assert.ok(rm, "expected the legacy container to be removed");
+  assert.deepEqual(rm!.args, ["rm", "-f", "swarm-vm-alice"]);
+  rm!.cp.emitClose(0);
+  await flush();
+
+  // The workspace volume must survive the recreation.
+  assert.ok(
+    !calls.some((c) => c.args[0] === "volume" && c.args[1] === "rm"),
+    "the /workspace volume must not be deleted",
+  );
+
+  calls[5].cp.emitClose(0); // image inspect -> found
+  await flush();
+  const runCall = calls.find((c) => c.args[0] === "run");
+  assert.ok(runCall, "expected a fresh desktop container");
+  assert.equal(runCall!.args[runCall!.args.indexOf("--label") + 1], `${VM_DESKTOP_LABEL}=1`);
+  runCall!.cp.emitClose(0);
+
+  const h = await p;
+  assert.equal(h.containerName, "swarm-vm-alice");
+});
+
+test("DockerVmDriver.ensure keeps a desktop container that already carries the label", async () => {
+  const { spawnFn, calls } = makeFakeSpawn();
+  const driver = new DockerVmDriver({ spawnFn, image: "swarmagents-vm-desktop:latest", desktop: true });
+
+  const p = driver.ensure("alice");
+  calls[0].cp.stdout.emit("data", Buffer.from("swarm-vm-alice-workspace\n"));
+  calls[0].cp.emitClose(0); // volume ls -> volume exists
+  await flush();
+  calls[1].cp.emitClose(0); // network inspect -> exists
+  await flush();
+  calls[2].cp.stdout.emit("data", Buffer.from("running\n"));
+  calls[2].cp.emitClose(0); // container inspect -> running
+  await flush();
+  calls[3].cp.stdout.emit("data", Buffer.from(JSON.stringify({ [VM_DESKTOP_LABEL]: "1" })));
+  calls[3].cp.emitClose(0); // labels -> desktop container
+  await flush();
+
+  const update = calls.find((c) => c.args[0] === "update");
+  assert.ok(update, "expected the limits to be re-applied");
+  update!.cp.emitClose(0);
+
+  assert.ok(!calls.some((c) => c.args[0] === "rm"), "must not recreate a desktop container");
+  assert.ok(!calls.some((c) => c.args[0] === "run"), "must not recreate a desktop container");
+
+  const h = await p;
+  assert.equal(h.containerName, "swarm-vm-alice");
+});
+
+// ---------------------------------------------------------------------------
+// display()
+// ---------------------------------------------------------------------------
+
+const NETWORK_JSON = JSON.stringify({
+  "swarm-vms": {
+    IPAddress: "172.18.0.5",
+    Gateway: "172.18.0.1",
+  },
+  bridge: { IPAddress: "172.17.0.2" },
+});
+
+test("DockerVmDriver.display parses the container IP on the shared network", async () => {
+  const { spawnFn, calls } = makeFakeSpawn();
+  const driver = new DockerVmDriver({ spawnFn, image: "swarmagents-vm-desktop:latest", desktop: true });
+
+  const p = driver.display("alice");
+  assert.deepEqual(calls[0].args, [
+    "container", "inspect", "-f", "{{json .NetworkSettings.Networks}}", "swarm-vm-alice",
+  ]);
+  calls[0].cp.stdout.emit("data", Buffer.from(NETWORK_JSON));
+  calls[0].cp.emitClose(0);
+
+  const endpoint = await p;
+  assert.deepEqual(endpoint, { host: "172.18.0.5", port: VM_DISPLAY_PORT });
+  assert.equal(endpoint!.port, 6080);
+});
+
+test("DockerVmDriver.display accepts a handle as well as a user id", async () => {
+  const { spawnFn, calls } = makeFakeSpawn();
+  const driver = new DockerVmDriver({ spawnFn, image: "swarmagents-vm-desktop:latest", desktop: true });
+
+  const p = driver.display(handle("alice"));
+  calls[0].cp.stdout.emit("data", Buffer.from(NETWORK_JSON));
+  calls[0].cp.emitClose(0);
+  assert.deepEqual(await p, { host: "172.18.0.5", port: VM_DISPLAY_PORT });
+});
+
+test("DockerVmDriver.display returns null without a desktop, an IP or a usable inspect", async () => {
+  // Legacy driver: no display at all, and no docker call is made.
+  const legacy = makeFakeSpawn();
+  const legacyDriver = new DockerVmDriver({
+    spawnFn: legacy.spawnFn,
+    image: "node:22-bookworm-slim",
+    desktop: false,
+  });
+  assert.equal(await legacyDriver.display("alice"), null);
+  assert.equal(legacy.calls.length, 0);
+
+  const { spawnFn, calls } = makeFakeSpawn();
+  const driver = new DockerVmDriver({ spawnFn, image: "swarmagents-vm-desktop:latest", desktop: true });
+
+  // No IP on the shared network yet.
+  const noIp = driver.display("alice");
+  calls[0].cp.stdout.emit("data", Buffer.from(JSON.stringify({ "swarm-vms": { IPAddress: "" } })));
+  calls[0].cp.emitClose(0);
+  assert.equal(await noIp, null);
+
+  // The VM is attached to a different network.
+  const otherNet = driver.display("alice");
+  calls[1].cp.stdout.emit("data", Buffer.from(JSON.stringify({ bridge: { IPAddress: "172.17.0.2" } })));
+  calls[1].cp.emitClose(0);
+  assert.equal(await otherNet, null);
+
+  // inspect failed.
+  const failed = driver.display("alice");
+  calls[2].cp.emitClose(1);
+  assert.equal(await failed, null);
+
+  // Unparseable output.
+  const garbage = driver.display("alice");
+  calls[3].cp.stdout.emit("data", Buffer.from("not json"));
+  calls[3].cp.emitClose(0);
+  assert.equal(await garbage, null);
+});
+
+test("DockerVmDriver.display honours the configured network and port", async () => {
+  const { spawnFn, calls } = makeFakeSpawn();
+  const driver = new DockerVmDriver({
+    spawnFn,
+    image: "swarmagents-vm-desktop:latest",
+    desktop: true,
+    network: "other-vms",
+    displayPort: 6081,
+  });
+
+  const p = driver.display("alice");
+  calls[0].cp.stdout.emit(
+    "data",
+    Buffer.from(JSON.stringify({ "other-vms": { IPAddress: "10.0.0.7" }, "swarm-vms": { IPAddress: "172.18.0.5" } })),
+  );
+  calls[0].cp.emitClose(0);
+
+  assert.deepEqual(await p, { host: "10.0.0.7", port: 6081 });
+});
+
+// ---------------------------------------------------------------------------
+// exec() — desktop user + HOME
+// ---------------------------------------------------------------------------
+
+test("DockerVmDriver.exec in desktop mode runs as agent with HOME=/home/agent", async () => {
+  const { spawnFn, calls } = makeFakeSpawn();
+  const driver = new DockerVmDriver({ spawnFn, image: "swarmagents-vm-desktop:latest", desktop: true });
+
+  const p = driver.exec(handle(), ["ls", "-la"]);
+  const call = calls[0];
+  assert.equal(call.args[0], "exec");
+  assert.equal(call.args[call.args.indexOf("--user") + 1], "1000:1000");
+  assert.equal(call.args[call.args.indexOf("-e") + 1], "HOME");
+  assert.equal(call.opts.env!.HOME, "/home/agent");
+  call.cp.emitClose(0);
+  assert.equal((await p).exitCode, 0);
+});
+
+test("DockerVmDriver.exec in legacy mode keeps the container user and argv", async () => {
+  const { spawnFn, calls } = makeFakeSpawn();
+  const driver = new DockerVmDriver({ spawnFn, image: "node:22-bookworm-slim", desktop: false });
+
+  const p = driver.exec(handle(), ["ls"]);
+  assert.deepEqual(calls[0].args, ["exec", "--", "swarm-vm-alice", "ls"]);
+  calls[0].cp.emitClose(0);
+  assert.equal((await p).exitCode, 0);
+});
+
+test("FakeVmDriver.display returns null (no display outside the docker driver)", async () => {
+  const driver = new FakeVmDriver();
+  const h = await driver.ensure("alice");
+  assert.equal(await driver.display(h), null);
+});
diff --git a/apps/swarmagents/lib/vm/docker-driver.ts b/apps/swarmagents/lib/vm/docker-driver.ts
index 6eb6f379f..767fd8a9d 100644
--- a/apps/swarmagents/lib/vm/docker-driver.ts
+++ b/apps/swarmagents/lib/vm/docker-driver.ts
@@ -13,6 +13,7 @@ import type {
   VmFileBytes,
   VmFileStat,
   VmSnapshot,
+  VmDisplayEndpoint,
 } from "./types";
 import { VmFileError } from "./files";
 import {
@@ -119,6 +120,72 @@ export const VM_CAPABILITIES = [
 /** Pull timeout for SWARM_VM_PULL=1, ms. Default 2 min. */
 export const SWARM_VM_PULL_TIMEOUT_MS = Number(process.env.SWARM_VM_PULL_TIMEOUT_MS ?? "120000");
 
+// ---------------------------------------------------------------------------
