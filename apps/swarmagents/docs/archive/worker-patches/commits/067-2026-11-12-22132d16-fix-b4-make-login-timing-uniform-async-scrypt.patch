+
+test("verifyLocalUser timing is uniform between unknown email and wrong password", async () => {
+  await signupLocalUser("alice@example.com", "correct horse battery");
+  const wrongPassword = "definitely-wrong-password";
+
+  const knownWrong = () => verifyLocalUser("alice@example.com", wrongPassword);
+  const unknown = () => verifyLocalUser("nobody@example.com", wrongPassword);
+
+  // Warm up the scrypt pool / caches so the first call does not skew ratios.
+  for (let i = 0; i < 3; i++) {
+    await knownWrong();
+    await unknown();
+  }
+
+  const N = 10;
+  let knownTotal = 0;
+  let unknownTotal = 0;
+  for (let i = 0; i < N; i++) {
+    const t0 = performance.now();
+    await knownWrong();
+    knownTotal += performance.now() - t0;
+
+    const t1 = performance.now();
+    await unknown();
+    unknownTotal += performance.now() - t1;
+  }
+  const knownAvg = knownTotal / N;
+  const unknownAvg = unknownTotal / N;
+  assert.ok(unknownAvg > 0, `unknown-email verification should cost something, got ${unknownAvg}ms`);
+  // An unknown email must not be meaningfully faster than a known wrong
+  // password, otherwise accounts could be enumerated by response timing.
+  // Allow generous slack for scheduling noise (DoD: ratio < 3x).
+  assert.ok(knownAvg < unknownAvg * 3, `known=${knownAvg.toFixed(2)}ms unknown=${unknownAvg.toFixed(2)}ms`);
+});
+
+test("password verification yields to the event loop (async, non-blocking)", async () => {
+  await signupLocalUser("alice@example.com", "correct horse battery");
+
+  const order: string[] = [];
+  const timerPromise = new Promise<void>((resolve) => {
+    // Fire ~5ms after the timer is set. scrypt takes ~25ms, so if
+    // verification is async the timer wins; if it blocked synchronously the
+    // verification would resolve first.
+    setTimeout(() => {
+      order.push("timer");
+      resolve();
+    }, 5);
+  });
+
+  const verifyPromise = verifyLocalUser("alice@example.com", "wrong-password").then(() => {
+    order.push("verify");
+  });
+  await Promise.all([timerPromise, verifyPromise]);
+
+  assert.deepEqual(order, ["timer", "verify"], "a short timer must fire while verification is still pending");
+});
diff --git a/apps/swarmagents/lib/users.ts b/apps/swarmagents/lib/users.ts
index d89052484..60fd3653b 100644
--- a/apps/swarmagents/lib/users.ts
+++ b/apps/swarmagents/lib/users.ts
@@ -9,12 +9,30 @@
 
 import fs from "node:fs";
 import path from "node:path";
-import { randomBytes, scryptSync } from "node:crypto";
+import { randomBytes, scrypt } from "node:crypto";
+import { promisify } from "node:util";
 import { resolveStorageDir, isDirWritable } from "./board/store";
 
 const SCHEME = "scrypt";
 const KEY_LEN = 32;
 const SALT_BYTES = 16;
+
+/** Async scrypt (promisified); never blocks the event loop while hashing. */
+const scryptAsync = promisify(scrypt) as (
+  password: string | Buffer,
+  salt: Buffer | string,
+  keylen: number,
+) => Promise<Buffer>;
+
+/**
+ * A fixed scrypt hash used to equalize the cost of a login attempt for an
+ * unknown email. The stored value is never used for authentication — only its
+ * parameters (identical to real hashes) matter, so known and unknown accounts
+ * burn the same CPU before responding and account existence cannot be probed
+ * by response timing.
+ */
+const DUMMY_SCRYPT_HASH =
+  "scrypt$33247306aac749054795c00127be0ecf$945ffa6bb3d59a4b3d46e77f8a6f5c1cb0bc5d549c017b4b5d9e90dd74a00ba9";
 const MAX_EMAIL_LEN = 254;
 const MIN_PASSWORD_LEN = 8;
 const MAX_PASSWORD_LEN = 1024;
@@ -36,18 +54,19 @@ interface UserFile {
   users: StoredUser[];
 }
 
-/** Password hashing: scrypt with a random salt (node:crypto, no deps). */
-function hashPassword(password: string): string {
+/** Password hashing: scrypt with a random salt, async (node:crypto, no deps). */
+async function hashPassword(password: string): Promise<string> {
   const salt = randomBytes(SALT_BYTES);
-  const hash = scryptSync(password, salt, KEY_LEN);
+  const hash = await scryptAsync(password, salt, KEY_LEN);
   return `${SCHEME}$${salt.toString("hex")}$${hash.toString("hex")}`;
 }
 
-function verifyPassword(password: string, stored: string): boolean {
+/** Verify a password against a stored scrypt hash; async and constant-time. */
+async function verifyPassword(password: string, stored: string): Promise<boolean> {
   const parts = stored.split("$");
   if (parts.length !== 3 || parts[0] !== SCHEME) return false;
   const expected = Buffer.from(parts[2], "hex");
-  const actual = scryptSync(password, Buffer.from(parts[1], "hex"), expected.length);
+  const actual = await scryptAsync(password, Buffer.from(parts[1], "hex"), expected.length);
   return actual.length === expected.length && timingSafeEqualBuf(actual, expected);
 }
 
