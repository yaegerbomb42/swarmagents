+test("PATCH rejects bodies over the 16kb cap with 413", async () => {
+  saveProvider(OWNER, { id: "openai", apiKey: KEY_ONE });
+
+  const res = await PATCH(
+    new Request("http://localhost/api/providers/openai", {
+      method: "PATCH",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({ action: "add-key", apiKey: "x".repeat(17 * 1024) }),
+    }),
+    ctx("openai")
+  );
+  assert.equal(res.status, 413);
+  const body = (await res.json()) as { error?: string };
+  assert.match(body.error ?? "", /too large/i);
+
+  // The oversized mutation never landed.
+  assert.deepEqual(onDisk().providers[0].keys, [KEY_ONE]);
+});
+
+test("PATCH accepts a valid add-key just under the 16kb cap", async () => {
+  saveProvider(OWNER, { id: "openai", apiKey: KEY_ONE });
+
+  const res = await patch("openai", {
+    action: "add-key",
+    apiKey: KEY_TWO,
+    note: "x".repeat(16_000),
+  });
+  assert.equal(res.status, 200);
+  assert.deepEqual(onDisk().providers[0].keys, [KEY_ONE, KEY_TWO]);
+});
