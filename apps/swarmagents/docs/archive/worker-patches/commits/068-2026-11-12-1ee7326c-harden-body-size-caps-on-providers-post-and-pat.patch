diff --git a/apps/swarmagents/app/api/providers/[id]/route.ts b/apps/swarmagents/app/api/providers/[id]/route.ts
index 2f76219c1..ec2b4548c 100644
--- a/apps/swarmagents/app/api/providers/[id]/route.ts
+++ b/apps/swarmagents/app/api/providers/[id]/route.ts
@@ -23,10 +23,36 @@ interface RouteContext {
 
 const NO_STORE = { "cache-control": "no-store" } as const;
 
+/** Bodies over this size are rejected with 413 (same cap as /api/login). */
+const MAX_BODY_SIZE = 16 * 1024;
+
 function unauthorized() {
   return NextResponse.json({ error: "Sign in required." }, { status: 401, headers: NO_STORE });
 }
 
+/**
+ * Read a JSON body, rejecting anything over MAX_BODY_SIZE with 413 before
+ * parsing so a huge body cannot stall the process.
+ */
+async function readJsonBody(
+  request: Request
+): Promise<{ body: unknown } | { response: Response }> {
+  let text: string;
+  try {
+    text = await request.text();
+  } catch {
+    return { response: NextResponse.json({ error: "Could not read request body." }, { status: 400 }) };
+  }
+  if (text.length > MAX_BODY_SIZE) {
+    return { response: NextResponse.json({ error: "Request body too large." }, { status: 413 }) };
+  }
+  try {
+    return { body: JSON.parse(text) as unknown };
+  } catch {
+    return { response: NextResponse.json({ error: "Invalid JSON body." }, { status: 400 }) };
+  }
+}
+
 async function routeId(ctx: RouteContext): Promise<string> {
   const params = await Promise.resolve(ctx.params);
   return typeof params?.id === "string" ? params.id : "";
@@ -55,12 +81,9 @@ export async function PATCH(request: Request, ctx: RouteContext) {
   const owner = providerOwner(request);
   if (!owner) return unauthorized();
   const id = await routeId(ctx);
-  let body: unknown;
-  try {
-    body = await request.json();
-  } catch {
-    return NextResponse.json({ error: "Invalid JSON body." }, { status: 400 });
-  }
+  const parsed = await readJsonBody(request);
+  if ("response" in parsed) return parsed.response;
+  const body = parsed.body;
   const { status, body: payload } = runKeyMutation(owner, id, body);
   return NextResponse.json(payload, { status, headers: NO_STORE });
 }
