--- a/apps/swarmagents/app/api/providers/[id]/route.test.ts
+++ b/apps/swarmagents/app/api/providers/[id]/route.test.ts
@@ -179,6 +179,37 @@ test("PATCH rejects unknown providers, bad indexes and bad payloads", async () =
   assert.deepEqual(onDisk().providers[0].keys, [KEY_ONE]);
