+test("POST rejects bodies over the 16kb cap with 413", async () => {
+  const res = await POST(
+    new Request("http://localhost/api/providers", {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({ id: "openai", apiKey: "x".repeat(17 * 1024) }),
+    })
+  );
+  assert.equal(res.status, 413);
+  const body = (await res.json()) as { error?: string };
+  assert.match(body.error ?? "", /too large/i);
+  // The oversized save never landed.
+  assert.deepEqual(onDisk().providers, []);
+});
+
+test("PATCH rejects bodies over the 16kb cap with 413", async () => {
+  await post({ id: "openai", apiKey: "sk-secret-cap-test" });
+  const res = await PATCH(
+    new Request("http://localhost/api/providers", {
+      method: "PATCH",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({ id: "openai", action: "add-key", apiKey: "x".repeat(17 * 1024) }),
+    })
+  );
+  assert.equal(res.status, 413);
+  const body = (await res.json()) as { error?: string };
+  assert.match(body.error ?? "", /too large/i);
+  // The oversized mutation never landed.
+  assert.deepEqual(onDisk().providers[0].keys, ["sk-secret-cap-test"]);
+});
+
+test("PATCH accepts a valid add-key just under the 16kb cap", async () => {
+  await post({ id: "openai", apiKey: "sk-secret-cap-test" });
+  const res = await patch({
+    id: "openai",
+    action: "add-key",
+    apiKey: "sk-secret-near-cap",
+    note: "x".repeat(16_000),
+  });
+  assert.equal(res.status, 200);
+  const body = (await res.json()) as { keyCount?: number };
+  assert.equal(body.keyCount, 2);
+  assert.deepEqual(onDisk().providers[0].keys, ["sk-secret-cap-test", "sk-secret-near-cap"]);
+});
+
