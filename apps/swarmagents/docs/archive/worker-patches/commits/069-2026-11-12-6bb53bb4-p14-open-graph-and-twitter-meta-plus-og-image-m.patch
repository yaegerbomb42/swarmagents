--- /dev/null
+++ b/apps/swarmagents/app/og-image.tsx
@@ -0,0 +1,70 @@
+import React from "react";
+import { ImageResponse } from "next/og";
+
+// Shared 1200x630 brand image for the Open Graph and Twitter file-convention
+// routes (app/opengraph-image.tsx and app/twitter-image.tsx). Both routes
+// re-export size/contentType and render this same image, so the two URLs stay
+// identical by construction. Brand: black canvas, white wordmark, cyan
+// (#22d3ee, the --color-focus accent) rule and site URL.
+
+export const size = { width: 1200, height: 630 };
+export const contentType = "image/png";
+
+export function renderOgImage(): ImageResponse {
+  return new ImageResponse(
+    (
+      <div
+        style={{
+          width: "100%",
+          height: "100%",
+          display: "flex",
+          flexDirection: "column",
+          justifyContent: "center",
+          padding: "72px 88px",
+          backgroundColor: "#000000",
+        }}
+      >
+        <div
+          style={{
+            width: 96,
+            height: 10,
+            backgroundColor: "#22d3ee",
+            marginBottom: 40,
+          }}
+        />
+        <div
+          style={{
+            fontSize: 116,
+            fontWeight: 800,
+            lineHeight: 1,
+            letterSpacing: -4,
+            color: "#ffffff",
+          }}
+        >
+          SwarmAgents
+        </div>
+        <div
+          style={{
+            marginTop: 28,
+            fontSize: 42,
+            lineHeight: 1.25,
+            color: "#888888",
+          }}
+        >
+          One chat bar. One agent. Every tool.
+        </div>
+        <div
+          style={{
+            marginTop: 56,
+            fontSize: 30,
+            letterSpacing: 2,
+            color: "#22d3ee",
+          }}
+        >
+          swarmagents.codes
+        </div>
+      </div>
+    ),
+    { ...size },
+  );
+}
diff --git a/apps/swarmagents/app/opengraph-image.test.ts b/apps/swarmagents/app/opengraph-image.test.ts
new file mode 100644
index 000000000..5af234604
--- /dev/null
+++ b/apps/swarmagents/app/opengraph-image.test.ts
@@ -0,0 +1,32 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import OgImage, { contentType as ogContentType, size as ogSize } from "./opengraph-image";
+import TwitterImage, { contentType as twContentType, size as twSize } from "./twitter-image";
+
+/** PNG signature, then the IHDR width/height at bytes 16-23. */
+function pngDimensions(buf: Buffer): { width: number; height: number } {
+  assert.deepEqual(
+    [...buf.subarray(0, 8)],
+    [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a],
+    "not a PNG",
+  );
+  return { width: buf.readUInt32BE(16), height: buf.readUInt32BE(20) };
+}
+
+for (const [name, render, size, contentType] of [
+  ["opengraph-image", OgImage, ogSize, ogContentType],
+  ["twitter-image", TwitterImage, twSize, twContentType],
+] as const) {
+  test(`${name} renders a 1200x630 PNG`, async () => {
+    assert.deepEqual(size, { width: 1200, height: 630 });
+    assert.equal(contentType, "image/png");
+    const res = await render();
+    assert.equal(res.status, 200);
+    assert.match(res.headers.get("content-type") ?? "", /image\/png/);
+    const buf = Buffer.from(await res.arrayBuffer());
+    assert.deepEqual(pngDimensions(buf), { width: 1200, height: 630 });
+    // The render must actually draw something: a blank black canvas would
+    // compress to a few hundred bytes.
+    assert.ok(buf.length > 5000, `image suspiciously small (${buf.length} bytes)`);
+  });
+}
