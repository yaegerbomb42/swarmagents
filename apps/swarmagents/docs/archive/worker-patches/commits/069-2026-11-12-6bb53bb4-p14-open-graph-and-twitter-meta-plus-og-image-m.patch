+// Canonical public origin for absolute Open Graph / Twitter URLs. Overridable
+// with NEXT_PUBLIC_SITE_URL; the live site is swarmagents.codes.
+function siteUrl(): URL {
+  try {
+    return new URL(process.env.NEXT_PUBLIC_SITE_URL ?? "https://swarmagents.codes");
+  } catch {
+    return new URL("https://swarmagents.codes");
+  }
+}
+
+const DESCRIPTION = "One chat bar. One agent. Every tool. Nothing hidden.";
+
 export const metadata: Metadata = {
+  metadataBase: siteUrl(),
   title: "SwarmAgents",
-  description: "One chat bar. One agent. Every tool. Nothing hidden.",
+  description: DESCRIPTION,
+  openGraph: {
+    title: "SwarmAgents",
+    description: DESCRIPTION,
+    type: "website",
+    siteName: "SwarmAgents",
+    // og:image / twitter:image come from the file convention:
+    // app/opengraph-image.tsx and app/twitter-image.tsx.
+  },
+  twitter: {
+    card: "summary_large_image",
+    title: "SwarmAgents",
+    description: DESCRIPTION,
+    // twitter:image comes from app/twitter-image.tsx (file convention).
+  },
 };
 
