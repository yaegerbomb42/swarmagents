diff --git a/apps/swarmagents/lib/middleware.test.ts b/apps/swarmagents/lib/middleware.test.ts
index c971b9f25..667f0bf7a 100644
--- a/apps/swarmagents/lib/middleware.test.ts
+++ b/apps/swarmagents/lib/middleware.test.ts
@@ -1,7 +1,7 @@
 import test from "node:test";
 import assert from "node:assert/strict";
 import { NextRequest } from "next/server";
-import { middleware } from "../middleware";
+import { config, middleware } from "../middleware";
 import { SESSION_COOKIE, signSession } from "./auth";
 import { resetBuckets } from "./rate-limit";
 
@@ -187,3 +187,14 @@ test("429 responses carry Retry-After and rate-limit headers (login bucket)", ()
   assert.equal(res.headers.get("X-RateLimit-Remaining"), "0");
   assert.ok(Number(res.headers.get("X-RateLimit-Reset")) >= 0);
 });
+
+test("matcher excludes the public OG/Twitter image routes (like icon.png)", () => {
+  // Next anchors matcher patterns to the full pathname; mirror that here.
+  const pattern = new RegExp(`^(?:${config.matcher[0]})$`);
+  assert.equal(pattern.test("/opengraph-image"), false, "unfurlers must reach /opengraph-image signed out");
+  assert.equal(pattern.test("/twitter-image"), false, "unfurlers must reach /twitter-image signed out");
+  assert.equal(pattern.test("/icon.png"), false, "icon.png stays excluded");
+  assert.equal(pattern.test("/login"), true, "login still runs through middleware");
+  assert.equal(pattern.test("/"), true, "home still runs through middleware");
+  assert.equal(pattern.test("/_next/static/chunk.js"), false, "static assets stay excluded");
+});
