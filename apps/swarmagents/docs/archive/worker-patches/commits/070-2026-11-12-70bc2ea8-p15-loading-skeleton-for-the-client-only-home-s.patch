From: yaegerbomb42 <yaeger.james42@gmail.com>
Date: Thu, 12 Nov 2026 00:21:32 +0000
Subject: [PATCH] [p15] Loading skeleton for the client-only home shell

---
 apps/swarmagents/app/home-client.tsx          |  2 +
 apps/swarmagents/app/loading.tsx              | 11 +++
 .../src/components/HomeSkeleton.tsx           | 96 +++++++++++++++++++
 3 files changed, 109 insertions(+)
 create mode 100644 apps/swarmagents/app/loading.tsx
 create mode 100644 apps/swarmagents/minimalist-ui/src/components/HomeSkeleton.tsx

diff --git a/apps/swarmagents/app/home-client.tsx b/apps/swarmagents/app/home-client.tsx
index 0c4ab2294..7606a1379 100644
--- a/apps/swarmagents/app/home-client.tsx
+++ b/apps/swarmagents/app/home-client.tsx
@@ -2,10 +2,12 @@
 
 import nextDynamic from "next/dynamic";
 import { ErrorBoundary } from "../minimalist-ui/src/components/ErrorBoundary";
+import { HomeSkeleton } from "../minimalist-ui/src/components/HomeSkeleton";
 import { ToastsProvider } from "../minimalist-ui/src/components/Toasts";
 
 const MinimalistApp = nextDynamic(() => import("../minimalist-ui/src/App"), {
   ssr: false,
+  loading: () => <HomeSkeleton />,
 });
 
 export default function HomeClient() {
diff --git a/apps/swarmagents/app/loading.tsx b/apps/swarmagents/app/loading.tsx
new file mode 100644
index 000000000..451a1035e
--- /dev/null
+++ b/apps/swarmagents/app/loading.tsx
@@ -0,0 +1,11 @@
+import { HomeSkeleton } from "../minimalist-ui/src/components/HomeSkeleton";
+
+/**
+ * Route-level loading UI for `/`: shows the workspace skeleton while the
+ * home segment renders. The same skeleton is also the `loading` fallback
+ * of the client-only dynamic import in `home-client.tsx`, which covers
+ * the (longer) wait for the workspace JS chunk to load.
+ */
+export default function Loading() {
+  return <HomeSkeleton />;
+}
diff --git a/apps/swarmagents/minimalist-ui/src/components/HomeSkeleton.tsx b/apps/swarmagents/minimalist-ui/src/components/HomeSkeleton.tsx
new file mode 100644
index 000000000..b0157c3fc
--- /dev/null
+++ b/apps/swarmagents/minimalist-ui/src/components/HomeSkeleton.tsx
@@ -0,0 +1,96 @@
+/**
+ * HomeSkeleton — loading placeholder for the client-only home shell.
+ *
+ * Mirrors the workspace chrome (header bar, computer-screen rectangle,
+ * bottom input bar) so a signed-in user sees a professional skeleton
+ * instead of a blank page while the workspace JS chunk loads. It is
+ * rendered in two places:
+ * - as the `loading` fallback of the `next/dynamic` import in
+ *   `app/home-client.tsx` (covers the client-only chunk load), and
+ * - as `app/loading.tsx` (covers the route segment's server render).
+ * Next swaps it out automatically once the real app mounts.
+ *
+ * The pulse uses `motion-safe:animate-pulse` so users who prefer
+ * reduced motion see a static skeleton; the global reduced-motion rule
+ * in `app/globals.css` neutralizes animations as a second layer.
+ */
+export function HomeSkeleton() {
+  return (
+    <div
+      role="status"
+      aria-label="Loading workspace"
+      className="relative min-h-dvh overflow-hidden bg-[#07070a] text-white antialiased"
+    >
+      <span className="sr-only">Loading workspace…</span>
+
+      {/* Header bar */}
+      <div
+        aria-hidden="true"
+        className="fixed inset-x-0 top-0 z-30 mx-auto flex w-full max-w-6xl items-center justify-between px-4 py-4 sm:px-6"
+      >
+        <div className="flex items-center gap-3">
+          <div className="h-5 w-36 rounded bg-white/10 motion-safe:animate-pulse" />
+          <div className="hidden h-5 w-16 rounded-full bg-white/10 motion-safe:animate-pulse sm:block" />
+        </div>
+        <div className="hidden items-center gap-2 sm:flex">
+          <div className="h-8 w-24 rounded-full bg-white/10 motion-safe:animate-pulse" />
+          <div className="h-8 w-24 rounded-full bg-white/10 motion-safe:animate-pulse" />
+          <div className="h-9 w-9 rounded-full bg-white/10 motion-safe:animate-pulse" />
+        </div>
+        <div className="h-9 w-9 rounded-full bg-white/10 motion-safe:animate-pulse sm:hidden" />
+      </div>
+
+      {/* Main body: role bar + computer screen */}
+      <div
+        aria-hidden="true"
+        className="relative z-10 flex min-h-dvh flex-col items-center px-4 pb-48 pt-20 sm:justify-center sm:px-8 sm:pb-32"
+      >
+        <div className="flex w-full flex-col items-center">
+          {/* Role & VM bar placeholder */}
+          <div className="mb-4 flex w-full max-w-5xl items-center justify-between gap-3">
+            <div className="h-9 w-40 rounded-full bg-white/10 motion-safe:animate-pulse" />
+            <div className="flex items-center gap-2">
+              <div className="h-9 w-20 rounded-full bg-white/10 motion-safe:animate-pulse" />
+              <div className="h-9 w-20 rounded-full bg-white/10 motion-safe:animate-pulse" />
+            </div>
+          </div>
+
+          {/* Computer-screen rectangle */}
+          <div className="mb-6 flex w-full max-w-5xl flex-col overflow-hidden rounded-3xl border border-white/15 bg-[#0d0d12] shadow-[0_25px_70px_rgba(0,0,0,0.8)] backdrop-blur-2xl">
+            <div className="flex items-center justify-between gap-3 border-b border-white/10 bg-[#14141c] px-4 py-2.5">
+              <div className="flex items-center gap-2">
+                <span className="h-3 w-3 rounded-full bg-white/15" />
+                <span className="h-3 w-3 rounded-full bg-white/15" />
+                <span className="h-3 w-3 rounded-full bg-white/15" />
+              </div>
+              <div className="h-4 w-48 max-w-[40%] rounded bg-white/10 motion-safe:animate-pulse" />
+              <div className="h-6 w-16 rounded-full bg-white/10 motion-safe:animate-pulse" />
+            </div>
+            <div className="flex min-h-[320px] flex-col gap-3 p-5 sm:min-h-[380px]">
+              <div className="h-4 w-3/4 rounded bg-white/10 motion-safe:animate-pulse" />
+              <div className="h-4 w-1/2 rounded bg-white/10 motion-safe:animate-pulse" />
+              <div className="h-4 w-2/3 rounded bg-white/10 motion-safe:animate-pulse" />
+              <div className="mt-2 h-24 rounded-xl bg-white/5 motion-safe:animate-pulse" />
+              <div className="h-4 w-1/3 rounded bg-white/10 motion-safe:animate-pulse" />
+            </div>
+          </div>
+        </div>
+      </div>
+
+      {/* Bottom input-bar placeholder */}
+      <div
+        aria-hidden="true"
+        className="fixed inset-x-0 bottom-16 z-20 px-4 pb-[calc(env(safe-area-inset-bottom)+1.25rem)] pt-10 sm:bottom-0 sm:pb-5"
+      >
+        <div className="mx-auto w-full max-w-2xl">
+          <div className="rounded-[28px] border border-white/10 bg-white/5 p-2 backdrop-blur-2xl">
+            <div className="flex items-center gap-2 px-2 py-1.5">
+              <div className="h-5 flex-1 rounded bg-white/10 motion-safe:animate-pulse" />
+              <div className="h-11 w-11 shrink-0 rounded-full bg-white/10 motion-safe:animate-pulse" />
+            </div>
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+}
-- 
