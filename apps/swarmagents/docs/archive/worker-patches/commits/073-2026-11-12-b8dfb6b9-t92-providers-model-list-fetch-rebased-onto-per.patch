@@ -0,0 +1,292 @@
+/**
+ * Live model lists, fetched from the provider itself.
+ *
+ * The catalog's model ids go stale, so the Add/Edit provider form offers the
+ * ids the provider reports right now: this module calls the provider's
+ * OpenAI-compatible GET /models endpoint (or the catalog-specific equivalent
+ * for Anthropic and Gemini) server-side with the stored key, caches the
+ * result for 10 minutes, and returns ids only.
+ *
+ * Key material never leaves this module: responses carry ids only, upstream
+ * error bodies are redacted with the key before they reach an error message,
+ * and a caller-supplied key (typed into the Add form before the provider is
+ * saved) is used for one fetch only — it is never stored, cached, logged, or
+ * echoed back.
+ *
+ * Per-user isolation: the caller passes the owner, the stored key comes from
+ * that owner's own providers (via routerProviders(owner)), the cache is
+ * keyed by owner + provider id, and host env keys (SWARM_KEYS_*) are only
+ * consulted in local mode — server mode never shares host keys across
+ * accounts.
+ */
+
+import { catalogEntry } from "./catalog";
+import { errorMessage, redact } from "./errors";
+import { serverMode } from "../auth";
+import type { FetchLike, ProviderConfig, ProviderKind } from "./types";
+
+/** How long a fetched model list stays fresh. */
+export const MODEL_LIST_TTL_MS = 10 * 60 * 1000;
+
+/** Per-request timeout for the upstream /models call. */
+export const MODEL_LIST_TIMEOUT_MS = 10_000;
+
+/** A rejected model-list fetch (no key, no endpoint, upstream failure). */
+export class ModelListError extends Error {
+  /** HTTP status the API should answer with. */
+  readonly status: number;
+
+  constructor(message: string, status = 502) {
+    super(message);
+    this.name = "ModelListError";
+    this.status = status;
+  }
+}
+
+export interface ProviderModelList {
+  id: string;
+  models: string[];
+  /** True when this came from the 10-minute cache instead of the provider. */
+  cached: boolean;
+  fetchedAt: number;
+}
+
+export interface FetchProviderModelsOptions {
+  fetch?: FetchLike;
+  /** Environment source for SWARM_KEYS_<PROVIDER>. Defaults to process.env. */
+  env?: Record<string, string | undefined>;
+  /** Injectable clock, primarily for deterministic tests. */
+  now?: () => number;
+  /**
+   * The owner whose stored key (and cache entry) this fetch belongs to.
+   * Required: the model-list cache is keyed by owner, so one user's fetched
+   * list is never served to another user.
+   */
+  owner: string;
+  /**
+   * Let a keyless provider read host env keys (SWARM_KEYS_*). Defaults to
+   * true only in local (single-user) mode; server mode never shares host
+   * keys across accounts (mirrors routerProviders' hostEnvKeys).
+   */
+  hostEnvKeys?: boolean;
+  /**
+   * A key supplied by the caller (e.g. typed into the Add form before the
+   * provider is saved). Takes precedence over the stored key, bypasses the
+   * cache, and is never stored or returned.
+   */
+  apiKey?: string;
+  /** Timeout for the upstream call in ms. Default MODEL_LIST_TIMEOUT_MS. */
+  timeoutMs?: number;
+}
+
+interface CacheEntry {
+  models: string[];
+  fetchedAt: number;
+}
+
+/** In-memory cache, keyed by owner + provider id. Stored-key fetches only. */
+const modelListCache = new Map<string, CacheEntry>();
+
+/** Clear the model-list cache (primarily for tests). */
+export function clearModelListCache(): void {
+  modelListCache.clear();
+}
+
+function dedupe(keys: string[]): string[] {
+  return Array.from(new Set(keys.map((k) => k.trim()).filter(Boolean)));
+}
+
+function envKeysName(config: ProviderConfig): string {
+  if (config.envKeys) return config.envKeys;
+  const suffix = config.id.toUpperCase().replace(/[^A-Z0-9]+/g, "_");
+  return `SWARM_KEYS_${suffix}`;
+}
+
+/**
+ * Keys for a provider: explicit config keys first, then the environment
+ * (mirrors the health checker's resolution). The environment fallback only
+ * applies when `hostEnvKeys` is true — in server mode host keys are never
+ * shared across accounts, so a keyless config resolves to no keys at all.
+ */
+export function loadProviderKeys(
+  config: ProviderConfig,
+  env: Record<string, string | undefined>,
+  hostEnvKeys = !serverMode()
+): string[] {
+  if (config.keys) return dedupe(config.keys);
+  if (!hostEnvKeys) return [];
+  let raw = env[envKeysName(config)];
+  if (raw === undefined && config.id !== config.kind) {
+    raw = env[`SWARM_KEYS_${config.kind.toUpperCase()}`];
+  }
+  return dedupe((raw ?? "").split(","));
+}
+
+function asRecord(value: unknown): Record<string, unknown> | undefined {
+  return typeof value === "object" && value !== null
+    ? (value as Record<string, unknown>)
+    : undefined;
+}
+
+function asString(value: unknown): string | undefined {
+  return typeof value === "string" ? value : undefined;
+}
+
+/**
+ * The provider's model-list URL for its kind.
+ *
+ * OpenAI-compatible and Anthropic providers expose GET /v1/models; Gemini
+ * exposes GET /v1beta/models. A baseUrl that already ends in the version
+ * segment takes just `/models`, otherwise the version segment is appended —
+ * the same join the request adapters use for chat endpoints.
+ */
+export function modelsListUrl(baseUrl: string, kind: ProviderKind): string {
+  const base = baseUrl.replace(/\/+$/, "");
+  if (kind === "gemini") {
+    return base.endsWith("/v1beta") ? `${base}/models` : `${base}/v1beta/models`;
+  }
+  return base.endsWith("/v1") ? `${base}/models` : `${base}/v1/models`;
+}
+
+/** Auth headers for a model-list call, mirroring the request adapters. */
+function headersFor(
+  config: ProviderConfig,
+  apiKey: string | undefined
+): Record<string, string> {
+  const headers: Record<string, string> = { ...config.headers };
+  if (!apiKey) return headers;
+  if (config.kind === "anthropic") {
+    headers["x-api-key"] = apiKey;
+    headers["anthropic-version"] = "2023-06-01";
+  } else if (config.kind === "openai") {
+    headers.authorization = `Bearer ${apiKey}`;
+  } else {
+    headers["x-goog-api-key"] = apiKey;
+  }
+  return headers;
+}
+
+/**
+ * Pull model ids out of a provider's list response.
+ *
+ * OpenAI-compatible and Anthropic answer `{ data: [{ id }] }`; Gemini
+ * answers `{ models: [{ name: "models/<id>", supportedGenerationMethods }] }`
+ * — the `models/` prefix is stripped, and entries that cannot generate
+ * content (embeddings, ...) are dropped when the capability list is present.
+ */
+export function parseModelIds(body: unknown, kind: ProviderKind): string[] {
+  const root = asRecord(body);
+  if (!root) return [];
+  const list = Array.isArray(root.data)
+    ? root.data
+    : Array.isArray(root.models)
+      ? root.models
+      : [];
+  const ids: string[] = [];
+  for (const item of list) {
+    const entry = asRecord(item);
+    if (!entry) continue;
+    if (kind === "gemini") {
+      const methods = entry.supportedGenerationMethods;
+      if (
+        Array.isArray(methods) &&
+        !methods.some((m) => m === "generateContent")
+      ) {
+        continue;
+      }
+    }
+    const raw = asString(entry.id) ?? asString(entry.name);
+    if (!raw) continue;
+    ids.push(raw.startsWith("models/") ? raw.slice("models/".length) : raw);
+  }
+  return [...new Set(ids)].sort();
+}
+
+/**
+ * Fetch a provider's current model ids from the provider itself.
+ *
+ * Uses the owner's stored key (config keys, then the environment in local
+ * mode only); a caller-supplied `apiKey` takes precedence and bypasses the
+ * cache. Stored-key results are cached for MODEL_LIST_TTL_MS under the
+ * owner's cache key. The returned list is ids only — never key material —
+ * and upstream error bodies are redacted before surfacing.
+ */
+export async function fetchProviderModels(
+  config: ProviderConfig,
+  options: FetchProviderModelsOptions
+): Promise<ProviderModelList> {
+  const fetchImpl =
+    options.fetch ?? (globalThis.fetch as FetchLike | undefined);
+  if (!fetchImpl) {
+    throw new ModelListError("No fetch implementation is available.", 502);
+  }
+  const env = options.env ?? process.env;
+  const now = options.now ?? Date.now;
+  const timeoutMs = options.timeoutMs ?? MODEL_LIST_TIMEOUT_MS;
+  const hostEnvKeys = options.hostEnvKeys ?? !serverMode();
+  const fetchedAt = now();
+  // The cache is keyed by owner + provider id: one user's fetched list is
+  // never served to another user.
+  const cacheKey = `${options.owner}:${config.id}`;
+
+  const suppliedKey = options.apiKey?.trim() || undefined;
+  const usingStoredKey = suppliedKey === undefined;
+  if (usingStoredKey) {
+    const cached = modelListCache.get(cacheKey);
+    if (cached && fetchedAt - cached.fetchedAt < MODEL_LIST_TTL_MS) {
+      return { id: config.id, models: cached.models, cached: true, fetchedAt: cached.fetchedAt };
+    }
+  }
+
+  const key = suppliedKey ?? loadProviderKeys(config, env, hostEnvKeys)[0];
+  const isLocal = catalogEntry(config.id)?.isLocal === true;
+  if (!key && !isLocal) {
+    throw new ModelListError("No API key stored for this provider.", 400);
+  }
+
+  // No kind-level default: a provider whose endpoint depends on the account
+  // or resource (Azure, Bedrock, a bare custom id) must have a baseUrl in
+  // its config or catalog entry, otherwise the list call would hit the wrong
+  // host with the user's key.
+  const baseUrl = config.baseUrl ?? catalogEntry(config.id)?.baseUrl;
+  if (!baseUrl) {
+    throw new ModelListError("This provider has no model list endpoint configured.", 400);
+  }
+  const url = modelsListUrl(baseUrl, config.kind);
+
+  const controller = new AbortController();
+  const timeoutId = setTimeout(() => controller.abort(), timeoutMs);
+  let response: Awaited<ReturnType<FetchLike>>;
+  try {
+    response = await fetchImpl(url, {
+      method: "GET",
+      headers: headersFor(config, key),
+      signal: controller.signal,
+    });
+  } catch (err) {
+    clearTimeout(timeoutId);
+    throw new ModelListError(`Could not reach ${config.id}: ${errorMessage(err)}`, 502);
+  }
+  clearTimeout(timeoutId);
+
+  if (!response.ok) {
+    const body = await response.text().catch(() => "");
+    const detail = body
+      ? `: ${redact(body.slice(0, 200), key ? [key] : [])}`
+      : "";
+    throw new ModelListError(`Provider returned HTTP ${response.status}${detail}`, 502);
+  }
+
+  const text = await response.text();
+  let json: unknown;
+  try {
+    json = JSON.parse(text);
+  } catch {
+    throw new ModelListError("Provider returned a non-JSON model list.", 502);
+  }
+  const models = parseModelIds(json, config.kind);
+  if (usingStoredKey) {
+    modelListCache.set(cacheKey, { models, fetchedAt });
+  }
+  return { id: config.id, models, cached: false, fetchedAt };
+}
