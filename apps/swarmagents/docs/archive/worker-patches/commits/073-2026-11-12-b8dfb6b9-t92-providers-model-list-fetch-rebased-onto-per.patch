@@ -0,0 +1,232 @@
+/**
+ * Tests for the live provider model-list fetch (lib/providers/models).
+ *
+ * Covers response parsing per provider kind, the 10-minute cache, and key
+ * resolution. All upstream calls are stubbed — no live provider is ever
+ * contacted.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  fetchProviderModels,
+  parseModelIds,
+  modelsListUrl,
+  clearModelListCache,
+  ModelListError,
+  MODEL_LIST_TTL_MS,
+} from "./models";
+import type { FetchLike, ProviderConfig } from "./types";
+
+const KEY = "sk-secret-test-cccc";
+
+test.beforeEach(() => {
+  clearModelListCache();
+});
+
+function config(overrides: Partial<ProviderConfig> = {}): ProviderConfig {
+  return { id: "openai", kind: "openai", baseUrl: "https://api.openai.com/v1", ...overrides };
+}
+
+function stubFetch(
+  makeResponse: () => Response,
+  calls: { url: string; init: Record<string, unknown> }[]
+): FetchLike {
+  return (async (url: string, init) => {
+    calls.push({ url, init: init as Record<string, unknown> });
+    return makeResponse();
+  }) as FetchLike;
+}
+
+function modelsResponse(ids: string[]): Response {
+  return new Response(JSON.stringify({ data: ids.map((id) => ({ id })) }), {
+    status: 200,
+    headers: { "content-type": "application/json" },
+  });
+}
+
+test("modelsListUrl appends /models to a versioned base and /v1/models otherwise", () => {
+  assert.equal(modelsListUrl("https://api.openai.com/v1", "openai"), "https://api.openai.com/v1/models");
+  assert.equal(modelsListUrl("https://api.perplexity.ai", "openai"), "https://api.perplexity.ai/v1/models");
+  assert.equal(modelsListUrl("https://api.perplexity.ai/", "openai"), "https://api.perplexity.ai/v1/models");
+  assert.equal(
+    modelsListUrl("https://generativelanguage.googleapis.com/v1beta", "gemini"),
+    "https://generativelanguage.googleapis.com/v1beta/models"
+  );
+  assert.equal(
+    modelsListUrl("https://generativelanguage.googleapis.com", "gemini"),
+    "https://generativelanguage.googleapis.com/v1beta/models"
+  );
+  assert.equal(modelsListUrl("https://api.anthropic.com", "anthropic"), "https://api.anthropic.com/v1/models");
+});
+
+test("parseModelIds dedupes and sorts OpenAI-style data entries", () => {
+  assert.deepEqual(
+    parseModelIds({ data: [{ id: "b" }, { id: "a" }, { id: "b" }, {}] }, "openai"),
+    ["a", "b"]
+  );
+  assert.deepEqual(parseModelIds({ data: "nope" }, "openai"), []);
+  assert.deepEqual(parseModelIds("nope", "openai"), []);
+});
+
+test("parseModelIds strips the models/ prefix and drops non-generative Gemini entries", () => {
+  assert.deepEqual(
+    parseModelIds(
+      {
+        models: [
+          { name: "models/gemini-2.5-pro", supportedGenerationMethods: ["generateContent"] },
+          { name: "models/text-embedding-004", supportedGenerationMethods: ["embedContent"] },
+          { name: "models/gemini-2.5-flash" },
+        ],
+      },
+      "gemini"
+    ),
+    ["gemini-2.5-flash", "gemini-2.5-pro"]
+  );
+});
+
+test("fetchProviderModels caches stored-key results and refetches after the TTL", async () => {
+  const calls: { url: string; init: Record<string, unknown> }[] = [];
+  let now = 1_000_000;
+  const options = {
+    fetch: stubFetch(() => modelsResponse(["gpt-4.1"]), calls),
+    env: {},
+    now: () => now,
+    owner: "test-user",
+  };
+
+  const first = await fetchProviderModels(config({ keys: [KEY] }), options);
+  assert.equal(first.cached, false);
+  assert.equal(calls.length, 1);
+
+  const second = await fetchProviderModels(config({ keys: [KEY] }), options);
+  assert.equal(second.cached, true);
+  assert.equal(calls.length, 1);
+
+  now += MODEL_LIST_TTL_MS;
+  const third = await fetchProviderModels(config({ keys: [KEY] }), options);
+  assert.equal(third.cached, false);
+  assert.equal(calls.length, 2, "expired cache entry was not refetched");
+});
+
+test("fetchProviderModels caches per owner and never serves one user's list to another", async () => {
+  const calls: { url: string; init: Record<string, unknown> }[] = [];
+  let now = 1_000_000;
+  const options = {
+    fetch: stubFetch(() => modelsResponse(["gpt-4.1"]), calls),
+    env: {},
+    now: () => now,
+  };
+
+  const aliceFirst = await fetchProviderModels(config({ keys: [KEY] }), { ...options, owner: "alice" });
+  assert.equal(aliceFirst.cached, false);
+  assert.equal(calls.length, 1);
+
+  const aliceSecond = await fetchProviderModels(config({ keys: [KEY] }), { ...options, owner: "alice" });
+  assert.equal(aliceSecond.cached, true);
+  assert.equal(calls.length, 1);
+
+  const bobFirst = await fetchProviderModels(config({ keys: [KEY] }), { ...options, owner: "bob" });
+  assert.equal(bobFirst.cached, false, "bob was served alice's cached list");
+  assert.equal(calls.length, 2);
+
+  const aliceThird = await fetchProviderModels(config({ keys: [KEY] }), { ...options, owner: "alice" });
+  assert.equal(aliceThird.cached, true);
+  assert.equal(calls.length, 2);
+});
+
+test("fetchProviderModels never caches a caller-supplied key fetch", async () => {
+  const calls: { url: string; init: Record<string, unknown> }[] = [];
+  const options = {
+    fetch: stubFetch(() => modelsResponse(["gpt-4.1"]), calls),
+    env: {},
+    owner: "test-user",
+  };
+
+  await fetchProviderModels(config(), { ...options, apiKey: "sk-typed-dddd" });
+  await fetchProviderModels(config(), { ...options, apiKey: "sk-typed-dddd" });
+  assert.equal(calls.length, 2, "caller-supplied key fetch was cached");
+});
+
+test("fetchProviderModels resolves keys from the environment when the config has none", async () => {
+  const calls: { url: string; init: Record<string, unknown> }[] = [];
+  const env = { SWARM_KEYS_OPENAI: ` ${KEY} ` };
+  await fetchProviderModels(config({ keys: undefined }), {
+    fetch: stubFetch(() => modelsResponse(["gpt-4.1"]), calls),
+    env,
+    owner: "test-user",
+  });
+  const headers = calls[0].init.headers as Record<string, string>;
+  assert.equal(headers.authorization, `Bearer ${KEY}`);
+});
+
+test("fetchProviderModels never reads host env keys when hostEnvKeys is false", async () => {
+  const calls: { url: string; init: Record<string, unknown> }[] = [];
+  const env = { SWARM_KEYS_OPENAI: ` ${KEY} ` };
+  await assert.rejects(
+    fetchProviderModels(config({ keys: undefined }), {
+      fetch: stubFetch(() => modelsResponse(["gpt-4.1"]), calls),
+      env,
+      owner: "test-user",
+      hostEnvKeys: false,
+    }),
+    (err: unknown) => {
+      assert.ok(err instanceof ModelListError);
+      assert.equal(err.status, 400);
+      return true;
+    }
+  );
+  assert.equal(calls.length, 0, "server mode must not consult host env keys");
+});
+
+test("fetchProviderModels throws 400 when no key is available", async () => {
+  const calls: { url: string; init: Record<string, unknown> }[] = [];
+  await assert.rejects(
+    fetchProviderModels(config({ keys: [] }), {
+      fetch: stubFetch(() => modelsResponse(["gpt-4.1"]), calls),
+      env: {},
+      owner: "test-user",
+    }),
+    (err: unknown) => {
+      assert.ok(err instanceof ModelListError);
+      assert.equal(err.status, 400);
+      return true;
+    }
+  );
+  assert.equal(calls.length, 0);
+});
+
+test("fetchProviderModels throws 400 when the provider has no model list endpoint", async () => {
+  const calls: { url: string; init: Record<string, unknown> }[] = [];
+  await assert.rejects(
+    fetchProviderModels(
+      { id: "azure-openai", kind: "openai", keys: [KEY] },
+      { fetch: stubFetch(() => modelsResponse(["gpt-4o"]), calls), env: {}, owner: "test-user" }
+    ),
+    (err: unknown) => {
+      assert.ok(err instanceof ModelListError);
+      assert.equal(err.status, 400);
+      return true;
+    }
+  );
+  assert.equal(calls.length, 0);
+});
+
+test("fetchProviderModels throws 502 and redacts the key from upstream errors", async () => {
+  const calls: { url: string; init: Record<string, unknown> }[] = [];
+  const upstream = new Response(`bad key ${KEY}`, { status: 403 });
+  await assert.rejects(
+    fetchProviderModels(config({ keys: [KEY] }), {
+      fetch: stubFetch(() => upstream, calls),
+      env: {},
+      owner: "test-user",
+    }),
+    (err: unknown) => {
+      assert.ok(err instanceof ModelListError);
+      assert.equal(err.status, 502);
+      assert.equal(err.message.includes(KEY), false, "error leaked the key");
+      assert.match(err.message, /403/);
+      return true;
+    }
+  );
+});
