@@ -0,0 +1,100 @@
+/**
+ * Live model list for a single provider: fetches the ids the provider
+ * reports right now from its own /models endpoint (OpenAI-compatible,
+ * Anthropic, or Gemini), caches them server-side for 10 minutes, and
+ * returns ids only.
+ *
+ * The response never carries key material. The fetch uses the provider's
+ * stored key; an optional `apiKey` in the POST body (typed into the Add
+ * form before the provider is saved) is used for that one fetch only — it
+ * is never stored, cached, logged, or echoed back.
+ *
+ * Auth comes from the middleware (every non-public /api/* route is gated),
+ * and the owner comes from the verified session header: the fetch uses the
+ * signed-in user's own stored key (decrypted server-side only), the cache
+ * is keyed by owner, and in server mode host keys are never consulted.
+ */
+
+import { NextResponse } from "next/server";
+import { catalogEntry, providerKindForCatalog } from "@/lib/providers/catalog";
+import { fetchProviderModels, ModelListError } from "@/lib/providers/models";
+import { providerOwner } from "@/lib/providers/owner";
+import { routerProviders } from "@/lib/providers/store";
+import type { ProviderConfig } from "@/lib/providers/types";
+
+export const dynamic = "force-dynamic";
+
+interface RouteContext {
+  params: Promise<{ id: string }>;
+}
+
+const NO_STORE = { "cache-control": "no-store" } as const;
+
+function asRecord(value: unknown): Record<string, unknown> | undefined {
+  return typeof value === "object" && value !== null
+    ? (value as Record<string, unknown>)
+    : undefined;
+}
+
+/**
+ * A provider config for a catalog entry that is not saved (and is not a
+ * built-in router default): the Add form fetches models for it before the
+ * provider exists, so the catalog's kind/baseUrl stand in for the config.
+ */
+function catalogConfig(id: string): ProviderConfig | undefined {
+  const entry = catalogEntry(id);
+  if (!entry) return undefined;
+  return {
+    id: entry.id,
+    kind: providerKindForCatalog(entry),
+    ...(entry.baseUrl ? { baseUrl: entry.baseUrl } : {}),
+  };
+}
+
+/**
+ * Fetch the provider's current model ids.
+ *
+ * Body (optional): { apiKey } — a key typed into the Add form for a provider
+ * that is not saved yet. When omitted, the stored key is used.
+ */
+export async function POST(request: Request, ctx: RouteContext) {
+  const owner = providerOwner(request);
+  if (!owner) {
+    return NextResponse.json({ error: "Sign in required." }, { status: 401, headers: NO_STORE });
+  }
+  const params = await Promise.resolve(ctx.params);
+  const id = typeof params?.id === "string" ? params.id : "";
+  const config =
+    routerProviders(owner).find((p) => p.id === id) ?? catalogConfig(id);
+  if (!config) {
+    return NextResponse.json({ error: "Provider not found." }, { status: 404 });
+  }
+
+  let body: unknown = null;
+  try {
+    body = await request.json();
+  } catch {
+    body = null;
+  }
+  const apiKey = asRecord(body)?.apiKey;
+  const suppliedKey = typeof apiKey === "string" ? apiKey : undefined;
+
+  try {
+    const list = await fetchProviderModels(config, {
+      owner,
+      ...(suppliedKey ? { apiKey: suppliedKey } : {}),
+    });
+    return NextResponse.json(
+      { models: list.models, cached: list.cached, fetchedAt: list.fetchedAt },
+      { headers: NO_STORE }
+    );
+  } catch (err) {
+    if (err instanceof ModelListError) {
+      return NextResponse.json({ error: err.message }, { status: err.status, headers: NO_STORE });
+    }
+    return NextResponse.json(
+      { error: "Could not fetch the model list." },
+      { status: 502, headers: NO_STORE }
+    );
+  }
+}
