@@ -0,0 +1,268 @@
+/**
+ * Tests for POST /api/providers/[id]/models.
+ *
+ * The endpoint fetches the provider's own /models list server-side with the
+ * signed-in user's stored key, caches it for 10 minutes under the owner's
+ * cache key, and returns ids only. No response may ever carry key material.
+ * All upstream calls are stubbed — no live provider is ever contacted.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { POST } from "./route";
+import { clearModelListCache } from "../../../../../lib/providers/models";
+import {
+  configureProviderStorePaths,
+  saveProvider,
+} from "../../../../../lib/providers/store";
+
+const KEY = "sk-secret-test-aaaa";
+
+let tempDir: string;
+let providersFile: string;
+
+/** Requests without the user header act as the local-mode owner. */
+const OWNER = "local";
+
+/** Calls the stubbed upstream fetch records, in order. */
+let calls: { url: string; init: Record<string, unknown> }[];
+
+test.beforeEach(() => {
+  tempDir = mkdtempSync(join(tmpdir(), "swarm-provider-models-route-"));
+  providersFile = join(tempDir, "providers.json");
+  configureProviderStorePaths(providersFile);
+  clearModelListCache();
+  calls = [];
+  delete process.env.SWARM_KEYS_OPENAI;
+  delete process.env.SWARM_KEYS_ANTHROPIC;
+  delete process.env.SWARM_KEYS_GEMINI;
+  delete process.env.SWARM_KEYS_OLLAMA;
+});
+
+test.afterEach(() => {
+  rmSync(tempDir, { recursive: true, force: true });
+});
+
+function ctx(id: string): { params: Promise<{ id: string }> } {
+  return { params: Promise.resolve({ id }) };
+}
+
+function post(id: string, body?: unknown): Promise<Response> {
+  const init: RequestInit =
+    body === undefined
+      ? { method: "POST" }
+      : {
+          method: "POST",
+          headers: { "content-type": "application/json" },
+          body: JSON.stringify(body),
+        };
+  return POST(new Request(`http://localhost/api/providers/${id}/models`, init), ctx(id));
+}
+
+function stubFetch(makeResponse: () => Response): typeof fetch {
+  return (async (url: string, init?: Record<string, unknown>) => {
+    calls.push({ url, init: init ?? {} });
+    return makeResponse();
+  }) as unknown as typeof fetch;
+}
+
+function withFetch<T>(makeResponse: () => Response, run: () => Promise<T>): Promise<T> {
+  const originalFetch = globalThis.fetch;
+  globalThis.fetch = stubFetch(makeResponse);
+  return run().finally(() => {
+    globalThis.fetch = originalFetch;
+  });
+}
+
+function modelsResponse(ids: string[]): Response {
+  return new Response(JSON.stringify({ data: ids.map((id) => ({ id })) }), {
+    status: 200,
+    headers: { "content-type": "application/json" },
+  });
+}
+
+test("POST returns the provider's model ids only, from its /models endpoint", async () => {
+  saveProvider(OWNER, { id: "openai", apiKey: KEY });
+
+  await withFetch(() => modelsResponse(["gpt-4.1", "gpt-4o-mini"]), async () => {
+    const res = await post("openai");
+    assert.equal(res.status, 200);
+    const text = await res.text();
+    assert.equal(text.includes(KEY), false, "response leaked the key");
+    const body = JSON.parse(text) as {
+      models: string[];
+      cached: boolean;
+      fetchedAt: number;
+    };
+    assert.deepEqual(body.models, ["gpt-4.1", "gpt-4o-mini"]);
+    assert.equal(body.cached, false);
+    assert.equal(typeof body.fetchedAt, "number");
+
+    assert.equal(calls.length, 1);
+    assert.equal(calls[0].url, "https://api.openai.com/v1/models");
+    const headers = calls[0].init.headers as Record<string, string>;
+    assert.equal(headers.authorization, `Bearer ${KEY}`);
+  });
+});
+
+test("POST serves the second call from the 10-minute cache without refetching", async () => {
+  saveProvider(OWNER, { id: "openai", apiKey: KEY });
+
+  await withFetch(() => modelsResponse(["gpt-4.1"]), async () => {
+    const first = await post("openai");
+    assert.equal(first.status, 200);
+    assert.equal(calls.length, 1);
+
+    const second = await post("openai");
+    assert.equal(second.status, 200);
+    assert.equal(calls.length, 1, "second call refetched instead of using the cache");
+    const body = JSON.parse(await second.text()) as { cached: boolean; models: string[] };
+    assert.equal(body.cached, true);
+    assert.deepEqual(body.models, ["gpt-4.1"]);
+  });
+});
+
+test("POST uses the Anthropic /v1/models endpoint with the x-api-key header", async () => {
+  saveProvider(OWNER, { id: "anthropic", apiKey: KEY });
+
+  await withFetch(() => modelsResponse(["claude-sonnet-4-5", "claude-haiku-4-5"]), async () => {
+    const res = await post("anthropic");
+    assert.equal(res.status, 200);
+    const body = JSON.parse(await res.text()) as { models: string[] };
+    assert.deepEqual(body.models, ["claude-haiku-4-5", "claude-sonnet-4-5"]);
+
+    assert.equal(calls.length, 1);
+    assert.equal(calls[0].url, "https://api.anthropic.com/v1/models");
+    const headers = calls[0].init.headers as Record<string, string>;
+    assert.equal(headers["x-api-key"], KEY);
+    assert.equal(headers["anthropic-version"], "2023-06-01");
+  });
+});
+
+test("POST parses Gemini's models list, strips the models/ prefix, and drops non-generative models", async () => {
+  saveProvider(OWNER, { id: "gemini", apiKey: KEY });
+
+  const makeResponse = () =>
+    new Response(
+      JSON.stringify({
+        models: [
+          { name: "models/gemini-2.5-pro", supportedGenerationMethods: ["generateContent"] },
+          { name: "models/gemini-embedding-001", supportedGenerationMethods: ["embedContent"] },
+          { name: "models/gemini-2.5-flash", supportedGenerationMethods: ["generateContent"] },
+        ],
+      }),
+      { status: 200, headers: { "content-type": "application/json" } }
+    );
+
+  await withFetch(makeResponse, async () => {
+    const res = await post("gemini");
+    assert.equal(res.status, 200);
+    const text = await res.text();
+    assert.equal(text.includes(KEY), false, "response leaked the key");
+    const body = JSON.parse(text) as { models: string[] };
+    assert.deepEqual(body.models, ["gemini-2.5-flash", "gemini-2.5-pro"]);
+
+    assert.equal(calls.length, 1);
+    assert.equal(calls[0].url, "https://generativelanguage.googleapis.com/v1beta/models");
+    const headers = calls[0].init.headers as Record<string, string>;
+    assert.equal(headers["x-goog-api-key"], KEY);
+  });
+});
+
+test("POST accepts a body-supplied key for a provider that is not saved yet", async () => {
+  const bodyKey = "sk-body-key-bbbb";
+  await withFetch(() => modelsResponse(["llama-3.3-70b-versatile"]), async () => {
+    // Groq is a catalog provider with no saved entry: the typed key is used
+    // for this one fetch and must never come back in the response.
+    const res = await post("groq", { apiKey: bodyKey });
+    assert.equal(res.status, 200);
+    const text = await res.text();
+    assert.equal(text.includes(bodyKey), false, "response leaked the body-supplied key");
+    const body = JSON.parse(text) as { models: string[] };
+    assert.deepEqual(body.models, ["llama-3.3-70b-versatile"]);
+
+    assert.equal(calls.length, 1);
+    assert.equal(calls[0].url, "https://api.groq.com/openai/v1/models");
+    const headers = calls[0].init.headers as Record<string, string>;
+    assert.equal(headers.authorization, `Bearer ${bodyKey}`);
+  });
+});
+
+test("POST fetches a local provider without a key", async () => {
+  await withFetch(() => modelsResponse(["llama3.3"]), async () => {
+    const res = await post("ollama");
+    assert.equal(res.status, 200);
+    const body = JSON.parse(await res.text()) as { models: string[] };
+    assert.deepEqual(body.models, ["llama3.3"]);
+
+    assert.equal(calls.length, 1);
+    assert.equal(calls[0].url, "http://localhost:11434/v1/models");
+    const headers = calls[0].init.headers as Record<string, string>;
+    assert.equal(headers.authorization, undefined);
+  });
+});
+
+test("POST returns 401 in server mode without a signed-in user", async () => {
+  const prev = process.env.SWARM_SERVER_MODE;
+  process.env.SWARM_SERVER_MODE = "1";
+  try {
+    await withFetch(() => modelsResponse(["gpt-4.1"]), async () => {
+      const res = await post("openai");
+      assert.equal(res.status, 401);
+      assert.equal(calls.length, 0, "unsigned server-mode request still called upstream");
+    });
+  } finally {
+    if (prev === undefined) delete process.env.SWARM_SERVER_MODE;
+    else process.env.SWARM_SERVER_MODE = prev;
+  }
+});
+
+test("POST returns 404 for an unknown provider", async () => {
+  await withFetch(() => modelsResponse(["gpt-4.1"]), async () => {
+    const res = await post("nope");
+    assert.equal(res.status, 404);
+    const body = JSON.parse(await res.text()) as { error?: string };
+    assert.equal(typeof body.error, "string");
+    assert.equal(calls.length, 0, "unknown provider still called upstream");
+  });
+});
+
+test("POST returns 400 when no key is stored for a non-local provider", async () => {
+  // OpenAI is a built-in router default with no saved entry and no env key.
+  await withFetch(() => modelsResponse(["gpt-4.1"]), async () => {
+    const res = await post("openai");
+    assert.equal(res.status, 400);
+    const body = JSON.parse(await res.text()) as { error?: string };
+    assert.match(body.error ?? "", /key/i);
+    assert.equal(calls.length, 0, "keyless provider still called upstream");
+  });
+});
+
+test("POST surfaces an upstream failure as 502 without key material", async () => {
+  saveProvider(OWNER, { id: "openai", apiKey: KEY });
+
+  // The upstream error body echoes the key — the response must not.
+  const upstream = () => new Response(`unauthorized for ${KEY}`, { status: 401 });
+  await withFetch(upstream, async () => {
+    const res = await post("openai");
+    assert.equal(res.status, 502);
+    const text = await res.text();
+    assert.equal(text.includes(KEY), false, "error response leaked the key");
+    const body = JSON.parse(text) as { error?: string };
+    assert.match(body.error ?? "", /401/);
+  });
+});
+
+test("POST surfaces a non-JSON upstream body as 502", async () => {
+  saveProvider(OWNER, { id: "openai", apiKey: KEY });
+
+  await withFetch(() => new Response("not json", { status: 200 }), async () => {
+    const res = await post("openai");
+    assert.equal(res.status, 502);
+    const body = JSON.parse(await res.text()) as { error?: string };
+    assert.equal(typeof body.error, "string");
+  });
+});
