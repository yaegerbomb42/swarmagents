--- a/apps/swarmagents/e2e/lenses.spec.ts
+++ b/apps/swarmagents/e2e/lenses.spec.ts
@@ -104,6 +104,18 @@ test("lenses: ELI5 answer and a rendered mermaid architecture diagram", { skip:
     await page.getByTestId("lens-result-toggle").click();
     await page.getByTestId("lens-result-body").waitFor({ state: "visible" });
 
+    // The same lens on the same message is cached: asking again must not
+    // reach the server a second time.
+    await lensButton.click();
+    await page.getByTestId("lens-option-eli5").click();
+    await page.getByTestId("lens-result").waitFor({ state: "visible" });
+    assert.equal(
+      requests.length,
+      1,
+      "the cached answer must not be asked for twice",
+    );
+    await page.getByText("The router tries the next key when a call fails.").waitFor();
+
     // Architecture: the mermaid block renders as a diagram, not as source.
     await lensButton.click();
     await page.getByTestId("lens-option-architecture").click();
@@ -114,6 +126,11 @@ test("lenses: ELI5 answer and a rendered mermaid architecture diagram", { skip:
     assert.equal(await diagram.locator("[data-testid='mermaid-node']").count(), 3);
     await diagram.getByText("Browser", { exact: true }).waitFor();
     assert.equal(await page.getByTestId("mermaid-source").count(), 0, "the raw source must not be shown");
+
+    // Two lenses, two calls: a different lens on the same message is a
+    // different answer and is not served from the cache.
+    assert.equal(requests.length, 2);
+    assert.equal(requests[1].lens, "architecture");
   });
   if (result.skipped) t.skip(result.skipped);
 });
