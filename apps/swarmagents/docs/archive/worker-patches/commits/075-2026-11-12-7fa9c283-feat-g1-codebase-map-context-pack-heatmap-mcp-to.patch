@@ -0,0 +1,37 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { extractTouchedPaths, normalizeTouchedPath } from "./touches";
+
+test("normalizeTouchedPath keeps workspace-relative paths", () => {
+  assert.equal(normalizeTouchedPath("/workspace/src/a.ts"), "src/a.ts");
+  assert.equal(normalizeTouchedPath("src/a.ts"), "src/a.ts");
+  assert.equal(normalizeTouchedPath("./src/a.ts"), "src/a.ts");
+  assert.equal(normalizeTouchedPath(""), null);
+  assert.equal(normalizeTouchedPath("/etc/passwd"), null);
+  assert.equal(normalizeTouchedPath("/workspace/../etc/passwd"), null);
+});
+
+test("extractTouchedPaths finds the files of a write tool call", () => {
+  const paths = extractTouchedPaths({ file_path: "/workspace/src/app.ts", content: "x" });
+  assert.deepEqual(paths, ["src/app.ts"]);
+});
+
+test("extractTouchedPaths finds the files a shell command mentions", () => {
+  const paths = extractTouchedPaths({ command: "cd /workspace && npx tsc lib/a.ts lib/b.ts" });
+  assert.ok(paths.includes("lib/a.ts"));
+  assert.ok(paths.includes("lib/b.ts"));
+});
+
+test("extractTouchedPaths walks nested tool arguments", () => {
+  const paths = extractTouchedPaths({
+    edits: [{ path: "/workspace/deep/nested/file.ts" }],
+    meta: { target: { targetPath: "/workspace/other.ts" } },
+  });
+  assert.ok(paths.includes("deep/nested/file.ts"));
+  assert.ok(paths.includes("other.ts"));
+});
+
+test("extractTouchedPaths ignores arguments that are not paths", () => {
+  const paths = extractTouchedPaths({ prompt: "fix the bug in src/app.ts please", timeout: 30 });
+  assert.deepEqual(paths, []);
+});
diff --git a/apps/swarmagents/lib/codebase/touches.ts b/apps/swarmagents/lib/codebase/touches.ts
new file mode 100644
index 000000000..9a15f75bf
--- /dev/null
+++ b/apps/swarmagents/lib/codebase/touches.ts
@@ -0,0 +1,75 @@
+/**
+ * Which files did the agent touch?
+ *
+ * The heatmap weighs the files this account's agent worked on before, so the
+ * harness has to know which paths a tool call referred to. The tool calls are
+ * Claude Code's (Write, Edit, Read, Bash, ...) and their argument shape
+ * differs per tool, so the paths are collected defensively: anything that
+ * looks like a workspace path is counted, and nothing else is.
+ */
+
+const PATH_KEYS = new Set([
+  "path",
+  "file",
+  "file_path",
+  "filepath",
+  "filePath",
+  "filename",
+  "fileName",
+  "target",
+  "target_path",
+  "targetPath",
+  "uri",
+  "notebook_path",
+  "notebookPath",
+]);
+
+/** Normalize a path the agent mentioned into a workspace-relative path. */
+export function normalizeTouchedPath(raw: string): string | null {
+  let value = String(raw ?? "").trim().replace(/\\/g, "/");
+  if (!value) return null;
+  value = value.replace(/^file:\/\//, "");
+  const marker = "/workspace/";
+  const index = value.indexOf(marker);
+  if (index >= 0) value = value.slice(index + marker.length);
+  else if (value.startsWith("/workspace")) value = value.slice("/workspace".length).replace(/^\/+/, "");
+  else if (value.startsWith("./")) value = value.slice(2);
+  if (!value || value.startsWith("/") || value.includes("..")) return null;
+  return value;
+}
+
+/** The file names a shell command mentions. */
+function pathsFromCommand(command: string): string[] {
+  const out: string[] = [];
+  const re = /(?:^|[\s"'`])((?:\/workspace\/)?[A-Za-z0-9_.@/-]+\.[A-Za-z0-9_-]{1,12})(?=[\s"'`:;,]|$)/g;
+  for (const match of command.matchAll(re)) out.push(match[1]);
+  return out;
+}
+
+/** Collect the workspace-relative paths a tool call refers to. */
+export function extractTouchedPaths(input: unknown): string[] {
+  const out = new Set<string>();
+  const push = (value: unknown) => {
+    if (typeof value !== "string") return;
+    const normalized = normalizeTouchedPath(value);
+    if (normalized) out.add(normalized);
+  };
+
+  const scan = (value: unknown, depth = 0): void => {
+    if (!value || depth > 5) return;
+    if (Array.isArray(value)) {
+      for (const item of value) scan(item, depth + 1);
+      return;
+    }
+    if (typeof value !== "object") return;
+    for (const [key, item] of Object.entries(value as Record<string, unknown>)) {
+      if (typeof item === "string" && PATH_KEYS.has(key)) push(item);
+      else if (key === "command" && typeof item === "string") {
+        for (const candidate of pathsFromCommand(item)) push(candidate);
+      } else scan(item, depth + 1);
+    }
+  };
+
+  scan(input);
+  return [...out];
+}
diff --git a/apps/swarmagents/lib/codebase/types.ts b/apps/swarmagents/lib/codebase/types.ts
