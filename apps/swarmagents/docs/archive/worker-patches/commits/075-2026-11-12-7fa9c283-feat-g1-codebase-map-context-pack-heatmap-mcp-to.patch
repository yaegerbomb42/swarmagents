+import { after, test } from "node:test";
+import { captureView, closeBrowser, openWorkspace, runPageTest } from "./lib";
+
+after(async () => {
+  await closeBrowser();
+});
+
+test("codebase: the right drawer has a Codebase tab with the heatmap", async (t) => {
+  const testName = "codebase: the right drawer has a Codebase tab with the heatmap";
+  const result = await runPageTest(testName, async ({ page, context }) => {
+    await openWorkspace(page, context);
+
+    // The right drawer docks the run thread and the codebase map.
+    const drawer = page.locator("[data-testid='right-drawer']").first();
+    await drawer.waitFor({ state: "visible", timeout: 15_000 });
+
+    const codebaseTab = page.locator("[data-testid='right-drawer-tab-codebase']").first();
+    await codebaseTab.waitFor({ state: "visible", timeout: 15_000 });
+    await codebaseTab.click();
+
+    // The Codebase tab shows the map: either the treemap of the hot files or
+    // the state that says there is no map for this repository yet.
+    const panel = page.locator("[data-testid='codebase-tab']").first();
+    await panel.waitFor({ state: "visible", timeout: 15_000 });
+
+    const treemap = page.locator("[data-testid='codebase-treemap']").first();
+    const empty = panel.getByText(/No codebase map yet|could not|Could not/).first();
+    const hasTreemap = await treemap.isVisible().catch(() => false);
+    if (!hasTreemap) {
+      await empty.waitFor({ state: "visible", timeout: 30_000 });
+    }
+
+    await captureView(page, testName, "codebase-tab");
+  });
+  if (result.skipped) t.skip(result.skipped);
+});
