+import test from "node:test";
+import assert from "node:assert/strict";
+import { resolveCodebaseInjection, wrapCodebasePack } from "./inject";
+import { writeUserSettings, readUserSettings } from "../providers/settings";
+import { forgetCodebaseMap } from "./store";
+import type { CodebaseMap, CodebaseRepoOption, CodebaseScan, CodebaseScanner } from "./types";
+
+const SCAN: CodebaseScan = {
+  repoRoot: "/workspace/demo",
+  repoName: "demo",
+  repoHash: "hash",
+  generatedAt: new Date(0).toISOString(),
+  gitHead: "head-1",
+  files: [
+    { path: "src/core.ts", bytes: 100, language: "TypeScript", exports: ["core"] },
+    { path: "src/app.ts", bytes: 50, language: "TypeScript", imports: ["./core"] },
+  ],
+  churn: { "src/core.ts": 10 },
+};
+
+function scanner(selected: string | null = SCAN.repoRoot): CodebaseScanner {
+  return {
+    async scan(): Promise<CodebaseScan | null> {
+      return SCAN;
+    },
+    async head(): Promise<string | undefined> {
+      return "head-1";
+    },
+    async publish(_userId: string, _repoRoot: string, _map: CodebaseMap): Promise<void> {},
+    async listRepos(): Promise<CodebaseRepoOption[]> {
+      return [];
+    },
+    async readMap(): Promise<CodebaseMap | null> {
+      return null;
+    },
+    async selectedRepo(): Promise<string | null> {
+      return selected;
+    },
+    async selectRepo(): Promise<void> {},
+  };
+}
+
+test("the pack is injected when the setting is on (the default)", async () => {
+  const userId = "inject-default";
+  const result = await resolveCodebaseInjection(userId, scanner(), SCAN.repoRoot);
+  assert.equal(result.enabled, true);
+  assert.equal(result.injected, true);
+  assert.ok(result.text?.includes("src/core.ts"));
+  assert.ok((result.tokenEstimate ?? 0) > 0);
+  forgetCodebaseMap(userId, SCAN.repoRoot);
+});
+
+test("the pack is not injected when the user turned it off", async () => {
+  const userId = "inject-off";
+  writeUserSettings(userId, { preferFreeProviders: true, injectCodebaseContext: false });
+  assert.equal(readUserSettings(userId).injectCodebaseContext, false);
+  const result = await resolveCodebaseInjection(userId, scanner(), SCAN.repoRoot);
+  assert.equal(result.enabled, false);
+  assert.equal(result.injected, false);
+  assert.equal(result.reason, "disabled");
+  forgetCodebaseMap(userId, SCAN.repoRoot);
+});
+
+test("the pack is not injected when the account never picked a repository", async () => {
+  const userId = "inject-no-repo";
+  const result = await resolveCodebaseInjection(userId, scanner(null), SCAN.repoRoot);
+  assert.equal(result.enabled, true);
+  assert.equal(result.injected, false);
+  assert.equal(result.reason, "no-repo-picked");
+  forgetCodebaseMap(userId, SCAN.repoRoot);
+});
+
+test("the pack is wrapped in markers that identify it in the prompt", () => {
+  const wrapped = wrapCodebasePack("# Codebase context: demo", { repoHash: "abc" });
+  assert.match(wrapped, /^<codebase_context repo_hash="abc">/);
+  assert.match(wrapped, /<\/codebase_context>$/);
+  assert.match(wrapped, /# Codebase context: demo/);
+});
diff --git a/apps/swarmagents/lib/codebase/inject.ts b/apps/swarmagents/lib/codebase/inject.ts
new file mode 100644
index 000000000..6652981da
--- /dev/null
+++ b/apps/swarmagents/lib/codebase/inject.ts
@@ -0,0 +1,99 @@
+/**
+ * Injecting the codebase context pack into a run.
+ *
+ * The pack is prepended to the run's system prompt so the agent starts with a
+ * map of the repository it is working in: languages, entry points, commands,
+ * the module layout and the files that everything else depends on.
+ *
+ * The user can turn the injection off (Settings -> Inject codebase context).
+ * When it is on, the pack is injected exactly once per run, and only when it
+ * fits inside the token budget.
+ */
+
+import { codebaseContextInjectionEnabled, readUserSettings } from "../providers/settings";
+import { CONTEXT_PACK_TOKEN_BUDGET } from "./rules";
+import {
+  ensureCodebaseMap,
+  maybeRefreshCodebaseMapOnGitChange,
+  selectedCodebaseRepo,
+} from "./store";
+import type { CodebaseScanner } from "./types";
+
+export interface CodebaseInjectionResult {
+  /** False when the account turned the injection off. */
+  enabled: boolean;
+  /** True when a pack was prepended to the run. */
+  injected: boolean;
+  repoRoot: string;
+  repoHash?: string;
+  tokenEstimate?: number;
+  text?: string;
+  /** Why nothing was injected (for the run log). */
+  reason?: string;
+}
+
+/**
+ * Resolve the pack for a run: honour the toggle, keep the map fresh and
+ * return the text to prepend. Never throws.
+ *
+ * The pack belongs to the repository the account picked (the Codebase tab):
+ * an account that never picked one gets no pack, and no map is built behind
+ * its back.
+ */
+export async function resolveCodebaseInjection(
+  userId: string,
+  scanner: CodebaseScanner,
+  fallbackRepoRoot: string,
+): Promise<CodebaseInjectionResult> {
+  try {
+    const settings = readUserSettings(userId);
+    if (!codebaseContextInjectionEnabled(settings)) {
+      return { enabled: false, injected: false, repoRoot: fallbackRepoRoot, reason: "disabled" };
+    }
+    const selected = await selectedCodebaseRepo(userId, scanner);
+    if (!selected) {
+      return { enabled: true, injected: false, repoRoot: fallbackRepoRoot, reason: "no-repo-picked" };
+    }
+    await maybeRefreshCodebaseMapOnGitChange(userId, scanner, selected).catch(() => undefined);
+    const map = await ensureCodebaseMap(userId, scanner, { repoRoot: selected });
+    if (!map?.contextPack?.text?.trim()) {
+      return { enabled: true, injected: false, repoRoot: selected, reason: "no-map" };
+    }
+    const pack = map.contextPack;
+    if (pack.tokenEstimate > CONTEXT_PACK_TOKEN_BUDGET) {
+      return {
+        enabled: true,
+        injected: false,
+        repoRoot: map.repoRoot,
+        repoHash: map.repoHash,
+        reason: "over-budget",
+      };
+    }
+    return {
+      enabled: true,
+      injected: true,
+      repoRoot: map.repoRoot,
+      repoHash: map.repoHash,
+      tokenEstimate: pack.tokenEstimate,
+      text: pack.text.trim(),
+    };
+  } catch {
+    return { enabled: true, injected: false, repoRoot: fallbackRepoRoot, reason: "error" };
+  }
+}
+
+/** Wrap the pack in the markers that make it recognisable in a prompt. */
+export function wrapCodebasePack(packText: string, meta: { repoHash?: string; repoName?: string } = {}): string {
+  const repoHash = meta.repoHash ? ` repo_hash="${meta.repoHash}"` : "";
+  const repoName = meta.repoName ? ` repo="${meta.repoName}"` : "";
+  return `<codebase_context${repoHash}${repoName}>\n${packText.trim()}\n</codebase_context>`;
+}
+
+/** Prepend the pack to an agent card (the system prompt of the run). */
+export function prefixAgentCardWithCodebasePack(
+  agentCard: string | undefined,
+  packText: string,
+): string {
+  const card = (agentCard ?? "").trim();
+  return card ? `${packText.trim()}\n\n${card}` : packText.trim();
+}
diff --git a/apps/swarmagents/lib/codebase/local-scanner.ts b/apps/swarmagents/lib/codebase/local-scanner.ts
new file mode 100644
index 000000000..b1eab730f
--- /dev/null
+++ b/apps/swarmagents/lib/codebase/local-scanner.ts
@@ -0,0 +1,117 @@
+/**
+ * A codebase scanner that runs on the app server's own filesystem.
+ *
+ * It runs the very same analyzer program the VM runs (so both sides agree on
+ * what a scan contains) and is used by the tests and by the tooling that
+ * builds a map for a checkout on the server itself.
+ */
+
+import { execFile } from "node:child_process";
+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { promisify } from "node:util";
+import { repoHashForRoot } from "./hash";
+import type {
+  CodebaseMap,
+  CodebaseRepoOption,
+  CodebaseScan,
+  CodebaseScanner,
+} from "./types";
+import { codebaseAnalyzerSource } from "./vm-analyzer-source";
+
+const execFileAsync = promisify(execFile);
+
+let analyzerPath: string | null = null;
+
+/** Write the analyzer to a temp file once and return its path. */
+async function analyzerFile(): Promise<string> {
+  if (analyzerPath) return analyzerPath;
+  const dir = await fs.mkdtemp(path.join(os.tmpdir(), "swarm-codebase-"));
+  const file = path.join(dir, "codebase-analyzer.mjs");
+  await fs.writeFile(file, codebaseAnalyzerSource(), "utf8");
+  analyzerPath = file;
+  return file;
+}
+
+/** Run the analyzer over a repository and return its scan. */
+export async function scanRepoLocal(
+  repoRoot: string,
+  options?: { sinceHead?: string },
+): Promise<CodebaseScan | null> {
+  const file = await analyzerFile();
+  try {
+    const { stdout } = await execFileAsync(
+      "node",
+      [file, path.resolve(repoRoot), options?.sinceHead ?? "-"],
+      { maxBuffer: 128 * 1024 * 1024 },
+    );
+    const parsed = JSON.parse(stdout) as { ok?: boolean; scanPath?: string };
+    if (!parsed.ok || !parsed.scanPath) return null;
+    const raw = await fs.readFile(parsed.scanPath, "utf8");
+    return JSON.parse(raw) as CodebaseScan;
+  } catch {
+    return null;
+  }
+}
+
+/** The HEAD of a local checkout. */
+export async function localRepoHead(repoRoot: string): Promise<string | undefined> {
+  try {
+    const { stdout } = await execFileAsync("git", ["-C", path.resolve(repoRoot), "rev-parse", "HEAD"], {
+      maxBuffer: 1024 * 1024,
+    });
+    const head = stdout.trim();
+    return head || undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+/** A scanner that reads and writes the server's own filesystem. */
+export function createLocalScanner(home: string = os.homedir()): CodebaseScanner {
+  return {
+    async scan(
+      _userId: string,
+      repoRoot: string,
+      options?: { sinceHead?: string },
+    ): Promise<CodebaseScan | null> {
+      return scanRepoLocal(repoRoot, options);
+    },
+    async head(_userId: string, repoRoot: string): Promise<string | undefined> {
+      return localRepoHead(repoRoot);
+    },
+    async publish(_userId: string, repoRoot: string, map: CodebaseMap): Promise<void> {
+      const dir = path.join(home, ".swarm", "codebase", map.repoHash || repoHashForRoot(repoRoot));
+      await fs.mkdir(dir, { recursive: true });
+      await fs.writeFile(path.join(dir, "map.json"), `${JSON.stringify(map, null, 2)}\n`, "utf8");
+      await fs.writeFile(path.join(dir, "context-pack.md"), map.contextPack.text, "utf8");
+    },
+    async listRepos(_userId: string): Promise<CodebaseRepoOption[]> {
+      return [];
+    },
+    async readMap(_userId: string, repoRoot: string): Promise<CodebaseMap | null> {
+      const hash = repoHashForRoot(repoRoot);
+      try {
+        const raw = await fs.readFile(path.join(home, ".swarm", "codebase", hash, "map.json"), "utf8");
+        return JSON.parse(raw) as CodebaseMap;
+      } catch {
+        return null;
+      }
+    },
+    async selectedRepo(_userId: string): Promise<string | null> {
+      try {
+        const raw = await fs.readFile(path.join(home, ".swarm", "codebase", "selection.json"), "utf8");
+        const parsed = JSON.parse(raw) as { repoRoot?: unknown };
+        return typeof parsed.repoRoot === "string" && parsed.repoRoot ? parsed.repoRoot : null;
+      } catch {
+        return null;
+      }
+    },
+    async selectRepo(_userId: string, repoRoot: string): Promise<void> {
+      const dir = path.join(home, ".swarm", "codebase");
+      await fs.mkdir(dir, { recursive: true });
+      await fs.writeFile(path.join(dir, "selection.json"), `${JSON.stringify({ repoRoot }, null, 2)}\n`, "utf8");
+    },
+  };
+}
diff --git a/apps/swarmagents/lib/codebase/parse.ts b/apps/swarmagents/lib/codebase/parse.ts
new file mode 100644
index 000000000..93a5ab2b2
--- /dev/null
+++ b/apps/swarmagents/lib/codebase/parse.ts
@@ -0,0 +1,92 @@
+/**
+ * Purpose heuristics: one short line per file and per top-level module.
+ *
+ * The pack is only useful if a line tells the agent *what a thing is*, so
+ * these heuristics look at where a file lives and what it is called before
+ * they fall back to the file's first meaningful line.
+ */
+
+const FILE_PURPOSE_RULES: ReadonlyArray<{ test: (p: string, base: string) => boolean; purpose: string }> = [
+  { test: (_p, base) => base.startsWith("readme"), purpose: "Project readme / overview" },
+  { test: (_p, base) => base === "package.json", purpose: "Package manifest and scripts" },
+  { test: (_p, base) => base.startsWith("tsconfig"), purpose: "TypeScript configuration" },
+  { test: (_p, base) => base.startsWith("next.config"), purpose: "Next.js configuration" },
+  { test: (_p, base) => base === "dockerfile" || base.startsWith("docker-compose"), purpose: "Container / build definition" },
+  { test: (_p, base) => base.startsWith("makefile"), purpose: "Makefile" },
+  { test: (p) => p.includes("/test/") || p.includes("/tests/") || p.includes("/spec/"), purpose: "Tests" },
+  { test: (p) => p.includes("__tests__"), purpose: "Tests" },
+  { test: (p) => /\.(test|spec)\.[a-z]+$/.test(p), purpose: "Tests" },
+  { test: (p) => p.includes("/components/"), purpose: "UI component" },
+  { test: (p) => p.includes("/app/api/") && p.endsWith("route.ts"), purpose: "API route handler" },
+  { test: (p) => p.includes("/app/") && p.endsWith("page.tsx"), purpose: "App page" },
+  { test: (p) => p.includes("/lib/runtime/"), purpose: "Runtime / execution logic" },
+  { test: (p) => p.includes("/lib/harness/"), purpose: "Agent harness" },
+  { test: (p) => p.includes("/lib/vm/"), purpose: "VM management" },
+  { test: (p) => p.includes("/lib/providers/"), purpose: "LLM / provider integration" },
+  { test: (p) => p.includes("/lib/client/"), purpose: "Client helpers" },
+  { test: (p) => p.includes("/e2e/"), purpose: "End-to-end tests" },
+  { test: (p) => p.includes("/lib/"), purpose: "Library module" },
+  { test: (p) => p.includes("/scripts/"), purpose: "Build / maintenance script" },
+  { test: (p) => p.includes("/docs/"), purpose: "Documentation" },
+];
+
+/** A one-line description of what a file is for. */
+export function inferPurpose(filePath: string, content?: string): string | undefined {
+  const base = filePath.split("/").pop()?.toLowerCase() ?? "";
+  const p = filePath.replace(/\\/g, "/").toLowerCase();
+  for (const rule of FILE_PURPOSE_RULES) {
+    if (rule.test(p, base)) return rule.purpose;
+  }
+  if (content) {
+    const first = content
+      .split(/\r?\n/)
+      .map((line) => line.trim())
+      .find(
+        (line) =>
+          line &&
+          !line.startsWith("//") &&
+          !line.startsWith("/*") &&
+          !line.startsWith("*") &&
+          !line.startsWith("#!") &&
+          !line.startsWith("import ") &&
+          !line.startsWith("export ") &&
+          !line.startsWith('"use'),
+      )
+      ?.replace(/^#+\s*/, "");
+    if (first && first.length >= 12 && first.length <= 120) return first;
+  }
+  return undefined;
+}
+
+const MODULE_PURPOSE_RULES: ReadonlyArray<{ test: (p: string, files: string[]) => boolean; purpose: string }> = [
+  { test: (p) => p === "app" || p.endsWith("/app"), purpose: "Next.js app routes and pages" },
+  { test: (p) => p === "apps" || p.endsWith("/apps"), purpose: "Application packages" },
+  { test: (p) => p === "packages" || p.endsWith("/packages"), purpose: "Shared packages" },
+  { test: (p) => p === "lib" || p.endsWith("/lib"), purpose: "Shared server/client libraries" },
+  { test: (p) => p === "components" || p.endsWith("/components"), purpose: "Shared UI components" },
+  { test: (p) => p.includes("runtime"), purpose: "Runtime control plane and run execution" },
+  { test: (p) => p.includes("harness"), purpose: "Agent harness and tool execution" },
+  { test: (p) => p.includes("vm"), purpose: "VM drivers, lifecycle and file access" },
+  { test: (p) => p.includes("provider"), purpose: "LLM provider config and routing" },
+  { test: (p) => p.includes("client"), purpose: "Browser/client utilities" },
+  { test: (p) => p.includes("telemetry"), purpose: "Run telemetry and reporting" },
+  { test: (p) => p.includes("e2e"), purpose: "End-to-end test specs" },
+  { test: (p) => p.split("/").includes("api"), purpose: "API routes" },
+  { test: (p) => p.includes("minimalist-ui"), purpose: "Minimalist UI workspace app" },
+  { test: (p) => p.includes("infra"), purpose: "Infrastructure and deployment" },
+  { test: (p) => p.includes("scripts"), purpose: "Build and maintenance scripts" },
+  { test: (p) => p.includes("docs"), purpose: "Documentation" },
+  { test: (p) => p.includes("test") || p.includes("spec"), purpose: "Tests" },
+];
+
+/** A one-line description of what a top-level module holds. */
+export function guessModulePurpose(modulePath: string, files: string[]): string {
+  const p = modulePath.toLowerCase();
+  for (const rule of MODULE_PURPOSE_RULES) {
+    if (rule.test(p, files)) return rule.purpose;
+  }
+  // A directory that is mostly tests is a test directory.
+  const testFiles = files.filter((file) => /\.(test|spec)\./.test(file)).length;
+  if (files.length > 0 && testFiles / files.length >= 0.6) return "Tests";
+  return "Module";
+}
diff --git a/apps/swarmagents/lib/codebase/ranking.test.ts b/apps/swarmagents/lib/codebase/ranking.test.ts
new file mode 100644
index 000000000..ad948e0a9
--- /dev/null
+++ b/apps/swarmagents/lib/codebase/ranking.test.ts
@@ -0,0 +1,102 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { rankHeatmap, rankKeyFilesByFanIn } from "./ranking";
+import { estimateTokens, truncateToTokenBudget } from "./tokens";
+import { CONTEXT_PACK_TOKEN_BUDGET } from "./rules";
+import { buildMapFromScan } from "./analyze";
+import type { CodebaseScan } from "./types";
+
+test("rankHeatmap orders by churn x size x fan-in x touches", () => {
+  const ranked = rankHeatmap([
+    { path: "a.ts", bytes: 100, fanIn: 1, churn90d: 10, agentTouches: 0 },
+    { path: "hot.ts", bytes: 500, fanIn: 20, churn90d: 200, agentTouches: 5 },
+    { path: "big.ts", bytes: 2000, fanIn: 0, churn90d: 0, agentTouches: 0 },
+  ]);
+  assert.equal(ranked[0].path, "hot.ts");
+  assert.ok(ranked[0].heat > ranked[1].heat);
+  assert.ok(ranked.every((r) => r.heat >= 0 && r.heat <= 1.000001));
+});
+
+test("rankHeatmap gives the touched file a higher heat", () => {
+  const withoutTouch = rankHeatmap([
+    { path: "a.ts", bytes: 1000, fanIn: 10, churn90d: 100, agentTouches: 0 },
+    { path: "b.ts", bytes: 1000, fanIn: 10, churn90d: 100, agentTouches: 0 },
+  ]);
+  const withTouch = rankHeatmap([
+    { path: "a.ts", bytes: 1000, fanIn: 10, churn90d: 100, agentTouches: 0 },
+    { path: "b.ts", bytes: 1000, fanIn: 10, churn90d: 100, agentTouches: 7 },
+  ]);
+  assert.equal(withoutTouch[0].heat, withoutTouch[1].heat);
+  assert.ok(withTouch[0].heat > withTouch[1].heat);
+  assert.equal(withTouch[0].path, "b.ts");
+});
+
+test("rankHeatmap is stable and honours the limit", () => {
+  const inputs = [
+    { path: "b.ts", bytes: 10, fanIn: 1, churn90d: 1, agentTouches: 0 },
+    { path: "a.ts", bytes: 10, fanIn: 1, churn90d: 1, agentTouches: 0 },
+    { path: "c.ts", bytes: 10, fanIn: 1, churn90d: 1, agentTouches: 0 },
+  ];
+  const first = rankHeatmap(inputs, 2);
+  const second = rankHeatmap(inputs, 2);
+  assert.deepEqual(first.map((r) => r.path), ["a.ts", "b.ts"]);
+  assert.deepEqual(first.map((r) => r.path), second.map((r) => r.path));
+});
+
+test("rankKeyFilesByFanIn prefers higher fan-in", () => {
+  const ranked = rankKeyFilesByFanIn([
+    { path: "b.ts", fanIn: 2 },
+    { path: "a.ts", fanIn: 10 },
+    { path: "c.ts", fanIn: 10 },
+  ], 2);
+  assert.deepEqual(ranked.map((r) => r.path), ["a.ts", "c.ts"]);
+});
+
+test("estimateTokens grows with the text and is zero for an empty string", () => {
+  assert.equal(estimateTokens(""), 0);
+  const small = estimateTokens("export function hello() { return 1; }");
+  const large = estimateTokens("export function hello() { return 1; }".repeat(50));
+  assert.ok(small > 0);
+  assert.ok(large > small * 10);
+});
+
+test("truncateToTokenBudget enforces the budget", () => {
+  const text = Array.from({ length: 5000 }, (_, i) => `line ${i} some codebase context`).join("\n");
+  const out = truncateToTokenBudget(text, 200);
+  assert.ok(out.truncated);
+  assert.ok(out.tokenEstimate <= 200, `estimate ${out.tokenEstimate} must fit the budget`);
+  assert.match(out.text, /truncated to fit budget/);
+});
+
+test("truncateToTokenBudget leaves a text that already fits alone", () => {
+  const text = "short pack";
+  const out = truncateToTokenBudget(text, 1000);
+  assert.equal(out.truncated, false);
+  assert.equal(out.text, text);
+});
+
+test("the context pack never exceeds the token budget", () => {
+  // A repository with far more files than the pack can describe.
+  const files = Array.from({ length: 4000 }, (_, i) => ({
+    path: `src/module-${i}/index.ts`,
+    bytes: 2048,
+    lines: 80,
+    language: "TypeScript",
+    exports: ["handler", "helper", "config"],
+    imports: [`../module-${(i + 1) % 4000}/index`],
+  }));
+  const scan: CodebaseScan = {
+    repoRoot: "/workspace/big",
+    repoName: "big",
+    repoHash: "hash",
+    generatedAt: new Date(0).toISOString(),
+    files,
+    churn: Object.fromEntries(files.map((file) => [file.path, 500])),
+  };
+  const map = buildMapFromScan(scan, { repoRoot: scan.repoRoot, tokenBudget: CONTEXT_PACK_TOKEN_BUDGET });
+  assert.ok(
+    map.contextPack.tokenEstimate <= CONTEXT_PACK_TOKEN_BUDGET,
+    `pack of ${map.contextPack.tokenEstimate} tokens must stay under ${CONTEXT_PACK_TOKEN_BUDGET}`,
+  );
+  assert.ok(map.contextPack.text.length > 0);
+});
diff --git a/apps/swarmagents/lib/codebase/ranking.ts b/apps/swarmagents/lib/codebase/ranking.ts
new file mode 100644
index 000000000..90051fb26
--- /dev/null
+++ b/apps/swarmagents/lib/codebase/ranking.ts
@@ -0,0 +1,69 @@
+/**
+ * Ranking rules for the codebase map.
+ *
+ * Two rankings come out of a scan:
+ *
+ *   - the heatmap: churn (90d) x size x fan-in x the files this account's
+ *     agent touched before. It answers "where is the risk?".
+ *   - the key files: pure import fan-in. It answers "what is load-bearing?".
+ */
+
+import { HEAT_WEIGHTS } from "./rules";
+import type { CodebaseHeatmapEntry } from "./types";
+
+export interface RankInput {
+  path: string;
+  bytes: number;
+  fanIn: number;
+  churn90d: number;
+  agentTouches: number;
+}
+
+/** Scale a list of raw values into 0..1 against the largest value. */
+function normalize(values: number[]): (value: number) => number {
+  let max = 0;
+  for (const value of values) if (value > max) max = value;
+  if (max <= 0) return () => 0;
+  return (value) => (value > 0 ? value / max : 0);
+}
+
+/**
+ * Rank files by heat. Ties break on fan-in, then churn, then path so the
+ * order is stable across rebuilds (a rebuilt map must not reshuffle the UI).
+ */
+export function rankHeatmap(inputs: RankInput[], limit = 200): CodebaseHeatmapEntry[] {
+  const churn = normalize(inputs.map((i) => i.churn90d));
+  const size = normalize(inputs.map((i) => i.bytes));
+  const fanIn = normalize(inputs.map((i) => i.fanIn));
+  const touches = normalize(inputs.map((i) => i.agentTouches));
+  return inputs
+    .map((input) => ({
+      ...input,
+      heat: Number(
+        (
+          churn(input.churn90d) * HEAT_WEIGHTS.churn +
+          size(input.bytes) * HEAT_WEIGHTS.size +
+          fanIn(input.fanIn) * HEAT_WEIGHTS.fanIn +
+          touches(input.agentTouches) * HEAT_WEIGHTS.touches
+        ).toFixed(6),
+      ),
+    }))
+    .sort(
+      (a, b) =>
+        b.heat - a.heat ||
+        b.fanIn - a.fanIn ||
+        b.churn90d - a.churn90d ||
+        a.path.localeCompare(b.path),
+    )
+    .slice(0, limit);
+}
+
+/** Rank files by import fan-in (how many other files import them). */
+export function rankKeyFilesByFanIn<T extends { fanIn: number; path: string }>(
+  files: T[],
+  limit = 40,
+): T[] {
+  return [...files]
+    .sort((a, b) => b.fanIn - a.fanIn || a.path.localeCompare(b.path))
+    .slice(0, limit);
+}
diff --git a/apps/swarmagents/lib/codebase/rules.ts b/apps/swarmagents/lib/codebase/rules.ts
new file mode 100644
index 000000000..855f05268
--- /dev/null
+++ b/apps/swarmagents/lib/codebase/rules.ts
@@ -0,0 +1,156 @@
+/**
+ * The rules that define "what this codebase looks like".
+ *
+ * They live here (instead of inside the analyzer program) for two reasons:
+ *
+ *   - the scanner that runs inside the user's VM is generated from these
+ *     values, so the VM and the server always agree on what counts as a
+ *     source file, how imports are spelled and which exports are public;
+ *   - they are plain data, so the unit tests can assert on them directly.
+ */
+
+import path from "node:path";
+
+/** Directories that never contain source worth mapping. */
+export const IGNORE_DIRS: readonly string[] = [
+  ".git",
+  ".hg",
+  ".svn",
+  "node_modules",
+  ".next",
+  ".turbo",
+  ".cache",
+  ".swarm",
+  "dist",
+  "build",
+  "out",
+  "coverage",
+  "vendor",
+  "__pycache__",
+  ".venv",
+  "venv",
+  ".idea",
+  ".vscode",
+  "target",
+];
+
+/** Lock files and generated bundles: big, noisy, never worth mapping. */
+export const IGNORE_FILES: readonly string[] = [
+  "package-lock.json",
+  "pnpm-lock.yaml",
+  "yarn.lock",
+  "bun.lockb",
+  "bun.lock",
+  "composer.lock",
+  "Cargo.lock",
+  "poetry.lock",
+  "go.sum",
+  ".DS_Store",
+];
+
+/** Extensions the scanner parses for imports/exports. */
+export const SOURCE_EXTS: readonly string[] = [
+  ".ts",
+  ".tsx",
+  ".js",
+  ".jsx",
+  ".mts",
+  ".cts",
+  ".mjs",
+  ".cjs",
+  ".py",
+  ".go",
+  ".rs",
+  ".java",
+  ".rb",
+  ".php",
+];
+
+/** Extension -> language label used in the pack's language histogram. */
+export const EXT_LANG: Readonly<Record<string, string>> = {
+  ts: "TypeScript",
+  tsx: "TypeScript",
+  mts: "TypeScript",
+  cts: "TypeScript",
+  js: "JavaScript",
+  jsx: "JavaScript",
+  mjs: "JavaScript",
+  cjs: "JavaScript",
+  py: "Python",
+  go: "Go",
+  rs: "Rust",
+  java: "Java",
+  rb: "Ruby",
+  php: "PHP",
+  css: "CSS",
+  scss: "CSS",
+  html: "HTML",
+  json: "JSON",
+  md: "Markdown",
+  yaml: "YAML",
+  yml: "YAML",
+  sh: "Shell",
+  sql: "SQL",
+};
+
+/** `import x from "y"` / `export * from "y"` — the static import forms. */
+export const STATIC_IMPORT_RE = /(?:import|export)\s+(?:[^"']*?\s+from\s+)?["']([^"']+)["']/g;
+/** `require("y")` — CommonJS. */
+export const REQUIRE_RE = /require\(\s*["']([^"']+)["']\s*\)/g;
+/** `import("y")` — dynamic import. */
+export const DYNAMIC_IMPORT_RE = /import\(\s*["']([^"']+)["']\s*\)/g;
+/** `from .x import y` / `import x` — Python. */
+export const PYTHON_IMPORT_RE = /^\s*(?:from\s+([.\w]+)\s+import|import\s+([.\w]+))/gm;
+
+/**
+ * The export forms the scanner understands, in the order they are reported.
+ * `kind: "list"` means the capture holds a comma separated export list
+ * (`export { a, b as c }`); `kind: "name"` means it holds a single name.
+ */
+export const EXPORT_PATTERNS: ReadonlyArray<{ re: RegExp; kind: "name" | "list" }> = [
+  { re: /export\s+(?:async\s+)?function\*?\s+([A-Za-z0-9_$]+)/g, kind: "name" },
+  { re: /export\s+class\s+([A-Za-z0-9_$]+)/g, kind: "name" },
+  { re: /export\s+(?:const|let|var|type|interface|enum)\s+([A-Za-z0-9_$]+)/g, kind: "name" },
+  { re: /export\s*\{\s*([^}]+)\s*\}/g, kind: "list" },
+  { re: /export\s+default\s+(?:function\*?\s+|class\s+)?([A-Za-z0-9_$]+)/g, kind: "name" },
+];
+
+/** Python: top-level defs/classes. */
+export const PYTHON_EXPORT_RE = /^(?:def|class)\s+([A-Za-z0-9_]+)/gm;
+/** Go: exported top-level identifiers. */
+export const GO_EXPORT_RE = /^(?:func|type|const|var)\s+([A-Z][A-Za-z0-9_]*)/gm;
+/** Rust: public items. */
+export const RUST_EXPORT_RE = /^\s*pub\s+(?:fn|struct|enum|trait|type|const)\s+([A-Za-z0-9_]+)/gm;
+
+/** Weights of the heat formula: churn x size x fan-in x agent touches. */
+export const HEAT_WEIGHTS = {
+  churn: 0.4,
+  size: 0.2,
+  fanIn: 0.25,
+  touches: 0.15,
+} as const;
+
+/** Hard ceiling for the injected context pack, in tokens. */
+export const CONTEXT_PACK_TOKEN_BUDGET = 8000;
+
+/** Files larger than this are measured but not parsed. */
+export const MAX_PARSED_FILE_BYTES = 120_000;
+
+/** Files smaller than this are parsed even when they are not source files. */
+export const MAX_SMALL_FILE_BYTES = 16_000;
+
+/** Cap on the number of files the scanner reports. */
+export const MAX_SCANNED_FILES = 20_000;
+
+/** Cap on the number of import specifiers kept per file. */
+export const MAX_IMPORTS_PER_FILE = 200;
+
+/** The language of a file, derived from its extension. */
+export function languageForPath(filePath: string): string | undefined {
+  const ext = path.extname(filePath).slice(1).toLowerCase();
+  if (EXT_LANG[ext]) return EXT_LANG[ext];
+  const base = path.basename(filePath).toLowerCase();
+  if (base === "dockerfile") return "Dockerfile";
+  if (base === "makefile") return "Makefile";
+  return undefined;
+}
diff --git a/apps/swarmagents/lib/codebase/scanner.test.ts b/apps/swarmagents/lib/codebase/scanner.test.ts
new file mode 100644
index 000000000..69d3392cf
--- /dev/null
+++ b/apps/swarmagents/lib/codebase/scanner.test.ts
@@ -0,0 +1,74 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { codebaseAnalyzerSource } from "./vm-analyzer-source";
+import { scanRepoLocal } from "./local-scanner";
+
+/** Write a small repository to a temp dir and return its path. */
+function fixtureRepo(): string {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "swarm-repo-"));
+  fs.mkdirSync(path.join(dir, "src", "lib"), { recursive: true });
+  fs.mkdirSync(path.join(dir, "node_modules", "junk"), { recursive: true });
+  fs.writeFileSync(
+    path.join(dir, "src", "core.ts"),
+    'export function core() { return 1; }\nexport const VERSION = "1";\n',
+  );
+  fs.writeFileSync(
+    path.join(dir, "src", "app.ts"),
+    'import { core } from "./lib/core";\nexport const app = () => core();\n',
+  );
+  fs.writeFileSync(path.join(dir, "src", "lib", "core.ts"), "export const core = () => 1;\n");
+  fs.writeFileSync(path.join(dir, "README.md"), "# Demo\n");
+  fs.writeFileSync(
+    path.join(dir, "package.json"),
+    JSON.stringify({ name: "demo", scripts: { build: "tsc", test: "node --test" } }, null, 2),
+  );
+  fs.writeFileSync(path.join(dir, "node_modules", "junk", "index.js"), "module.exports = 1;\n");
+  fs.writeFileSync(path.join(dir, "package-lock.json"), "{}\n");
+  return dir;
+}
+
+test("the analyzer program is valid JavaScript", () => {
+  const source = codebaseAnalyzerSource();
+  assert.match(source, /^#!\/usr\/bin\/env node/);
+  // `new Function` cannot parse ESM, so check it as a module body instead.
+  assert.doesNotThrow(() => {
+    // eslint-disable-next-line no-new-func
+    new Function(`return async () => { ${source.replace(/^#!.*\n/, "").replace(/^import .*$/gm, "")} }`);
+  });
+});
+
+test("the analyzer finds the source files, their imports and their exports", async () => {
+  const repo = fixtureRepo();
+  const scan = await scanRepoLocal(repo);
+  assert.ok(scan, "the analyzer must produce a scan");
+  const paths = scan.files.map((file) => file.path);
+  assert.ok(paths.includes("src/app.ts"));
+  assert.ok(paths.includes("src/lib/core.ts"));
+  assert.ok(paths.includes("README.md"));
+  // node_modules and the lock file are noise.
+  assert.ok(!paths.some((file) => file.includes("node_modules")));
+  assert.ok(!paths.includes("package-lock.json"));
+
+  const core = scan.files.find((file) => file.path === "src/core.ts");
+  assert.ok(core?.exports?.includes("core"));
+  assert.ok(core?.exports?.includes("VERSION"));
+
+  const app = scan.files.find((file) => file.path === "src/app.ts");
+  assert.ok(app?.imports?.includes("./lib/core"));
+
+  const pkg = scan.packageJson;
+  assert.equal(pkg?.scripts?.build, "tsc");
+  assert.ok(scan.lockFiles?.includes("package-lock.json"));
+  fs.rmSync(repo, { recursive: true, force: true });
+});
+
+test("the analyzer reports the repository root, its name and its hash", async () => {
+  const repo = fixtureRepo();
+  const scan = await scanRepoLocal(repo);
+  assert.equal(scan?.repoRoot, fs.realpathSync(repo));
+  assert.ok((scan?.repoHash ?? "").length === 16);
+  fs.rmSync(repo, { recursive: true, force: true });
+});
diff --git a/apps/swarmagents/lib/codebase/store.test.ts b/apps/swarmagents/lib/codebase/store.test.ts
new file mode 100644
index 000000000..3e6065b25
--- /dev/null
+++ b/apps/swarmagents/lib/codebase/store.test.ts
@@ -0,0 +1,126 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  ensureCodebaseMap,
+  forgetCodebaseMap,
+  getCodebaseContextPack,
+  getCodebaseHotspots,
+  maybeRefreshCodebaseMapOnGitChange,
+  normalizeRepoPath,
+  recordAgentTouches,
+} from "./store";
+import type { CodebaseMap, CodebaseRepoOption, CodebaseScan, CodebaseScanner } from "./types";
+
+/** A scanner that serves a fixed scan and counts how often it was asked. */
+function fakeScanner(scan: CodebaseScan, options: { head?: string } = {}): CodebaseScanner & {
+  scans: number;
+  published: CodebaseMap[];
+} {
+  const published: CodebaseMap[] = [];
+  const scanner = {
+    scans: 0,
+    published,
+    async scan(): Promise<CodebaseScan | null> {
+      scanner.scans += 1;
+      return scan;
+    },
+    async head(): Promise<string | undefined> {
+      return options.head;
+    },
+    async publish(_userId: string, _repoRoot: string, map: CodebaseMap): Promise<void> {
+      published.push(map);
+    },
+    async listRepos(): Promise<CodebaseRepoOption[]> {
+      return [];
+    },
+    async readMap(): Promise<CodebaseMap | null> {
+      return null;
+    },
+    async selectedRepo(): Promise<string | null> {
+      return null;
+    },
+    async selectRepo(): Promise<void> {},
+  };
+  return scanner;
+}
+
+const SAMPLE: CodebaseScan = {
+  repoRoot: "/workspace/demo",
+  repoName: "demo",
+  repoHash: "hash",
+  generatedAt: new Date(0).toISOString(),
+  gitHead: "head-1",
+  files: [
+    { path: "src/core.ts", bytes: 100, language: "TypeScript", exports: ["core"] },
+    { path: "src/a.ts", bytes: 50, language: "TypeScript", imports: ["./core"] },
+  ],
+  churn: { "src/core.ts": 10 },
+};
+
+test("ensureCodebaseMap builds the map once and reuses it", async () => {
+  const scanner = fakeScanner(SAMPLE, { head: "head-1" });
+  const first = await ensureCodebaseMap("alice", scanner, { repoRoot: SAMPLE.repoRoot });
+  const second = await ensureCodebaseMap("alice", scanner, { repoRoot: SAMPLE.repoRoot });
+  assert.ok(first);
+  assert.equal(scanner.scans, 1);
+  assert.equal(second, first);
+  assert.equal(scanner.published.length, 1);
+  forgetCodebaseMap("alice", SAMPLE.repoRoot);
+});
+
+test("ensureCodebaseMap rebuilds when the repository moved on", async () => {
+  const scanner = fakeScanner(SAMPLE, { head: "head-2" });
+  await ensureCodebaseMap("bob", scanner, { repoRoot: SAMPLE.repoRoot });
+  const rebuilt = await ensureCodebaseMap("bob", scanner, { repoRoot: SAMPLE.repoRoot });
+  assert.equal(scanner.scans, 2);
+  assert.ok(rebuilt);
+  forgetCodebaseMap("bob", SAMPLE.repoRoot);
+});
+
+test("ensureCodebaseMap keeps the agent touch counters across rebuilds", async () => {
+  const scanner = fakeScanner(SAMPLE, { head: "head-1" });
+  await ensureCodebaseMap("carol", scanner, { repoRoot: SAMPLE.repoRoot });
+  await recordAgentTouches("carol", scanner, SAMPLE.repoRoot, ["src/core.ts"]);
+  await ensureCodebaseMap("carol", scanner, { repoRoot: SAMPLE.repoRoot, force: true });
+  const map = await ensureCodebaseMap("carol", scanner, { repoRoot: SAMPLE.repoRoot });
+  assert.equal(map?.files.find((file) => file.path === "src/core.ts")?.agentTouches, 1);
+  forgetCodebaseMap("carol", SAMPLE.repoRoot);
+});
+
+test("recordAgentTouches raises the heat of the touched file", async () => {
+  const scanner = fakeScanner(SAMPLE, { head: "head-1" });
+  const map = await ensureCodebaseMap("dave", scanner, { repoRoot: SAMPLE.repoRoot });
+  const before = map?.heatmap.find((entry) => entry.path === "src/core.ts")?.heat ?? 0;
+  await recordAgentTouches("dave", scanner, SAMPLE.repoRoot, ["src/core.ts"]);
+  const after = map?.heatmap.find((entry) => entry.path === "src/core.ts")?.heat ?? 0;
+  assert.ok(after > before, `${after} should be hotter than ${before}`);
+  forgetCodebaseMap("dave", SAMPLE.repoRoot);
+});
+
+test("the context pack and the hotspots come from the same map", async () => {
+  const scanner = fakeScanner(SAMPLE, { head: "head-1" });
+  const pack = await getCodebaseContextPack("erin", scanner, SAMPLE.repoRoot);
+  const hotspots = await getCodebaseHotspots("erin", scanner, SAMPLE.repoRoot, 1);
+  assert.ok(pack?.text.includes("src/core.ts"));
+  assert.equal(hotspots.length, 1);
+  assert.equal(hotspots[0].path, "src/core.ts");
+  forgetCodebaseMap("erin", SAMPLE.repoRoot);
+});
+
+test("maybeRefreshCodebaseMapOnGitChange only rebuilds when the head moved", async () => {
+  const scanner = fakeScanner(SAMPLE, { head: "head-1" });
+  await ensureCodebaseMap("frank", scanner, { repoRoot: SAMPLE.repoRoot });
+  await maybeRefreshCodebaseMapOnGitChange("frank", scanner, SAMPLE.repoRoot);
+  assert.equal(scanner.scans, 1);
+  forgetCodebaseMap("frank", SAMPLE.repoRoot);
+});
+
+test("normalizeRepoPath turns workspace paths into repo-relative ones", () => {
+  assert.equal(normalizeRepoPath("/workspace/demo/src/a.ts", "/workspace/demo"), "src/a.ts");
+  assert.equal(normalizeRepoPath("/workspace/demo/src/a.ts"), "demo/src/a.ts");
+  assert.equal(normalizeRepoPath("src/a.ts"), "src/a.ts");
+  assert.equal(normalizeRepoPath("./src/a.ts"), "src/a.ts");
+  assert.equal(normalizeRepoPath("/etc/passwd"), null);
+  assert.equal(normalizeRepoPath("../outside.ts"), null);
+  assert.equal(normalizeRepoPath(""), null);
+});
diff --git a/apps/swarmagents/lib/codebase/store.ts b/apps/swarmagents/lib/codebase/store.ts
new file mode 100644
index 000000000..9039d3369
--- /dev/null
+++ b/apps/swarmagents/lib/codebase/store.ts
@@ -0,0 +1,217 @@
+/**
+ * The codebase map store.
+ *
+ * One map per (account, repository). The map itself lives in the user's VM
+ * (`~/.swarm/codebase/<repoHash>/map.json`), so the agent's MCP tools and the
+ * app read the very same document; the server keeps a small in-memory cache
+ * so a run does not rebuild the map on every turn.
+ *
+ * Freshness: a map is rebuilt when the repository's HEAD moves (someone
+ * committed) or when the user asks for it explicitly. The map is never
+ * rebuilt silently for a repository the account never picked.
+ */
+
+import { buildMapFromScan, selectHotspots } from "./analyze";
+import { repoHashForRoot } from "./hash";
+import { CONTEXT_PACK_TOKEN_BUDGET } from "./rules";
+import type { CodebaseMap, CodebaseRepoOption, CodebaseScanner } from "./types";
+
+/** Cache key: one map per account and repository. */
+export function repoKey(userId: string, repoRoot: string): string {
+  return `${userId}:${repoHashForRoot(repoRoot)}`;
+}
+
+const memory = new Map<string, CodebaseMap>();
+
+/** Drop the cached map for an account (used by tests and by VM resets). */
+export function forgetCodebaseMap(userId: string, repoRoot: string): void {
+  memory.delete(repoKey(userId, repoRoot));
+}
+
+export interface EnsureOptions {
+  repoRoot: string;
+  /** Rebuild even when the cached map looks current. */
+  force?: boolean;
+}
+
+/**
+ * Return the map for a repository, building it the first time and rebuilding
+ * it when the repository moved on. Never throws: a repository that cannot be
+ * scanned simply has no map.
+ */
+export async function ensureCodebaseMap(
+  userId: string,
+  scanner: CodebaseScanner,
+  options: EnsureOptions,
+): Promise<CodebaseMap | null> {
+  const repoRoot = options.repoRoot;
+  const key = repoKey(userId, repoRoot);
+  const cached = memory.get(key);
+
+  if (!options.force && cached) {
+    const head = await scanner.head(userId, repoRoot).catch(() => undefined);
+    if (!head || !cached.gitHead || head === cached.gitHead) return cached;
+  }
+
+  const scan = await scanner
+    .scan(userId, repoRoot, { sinceHead: cached?.gitHead })
+    .catch(() => null);
+  if (!scan) return cached ?? null;
+
+  const touches: Record<string, number> = {};
+  for (const file of cached?.files ?? []) {
+    if (file.agentTouches) touches[file.path] = file.agentTouches;
+  }
+
+  const map = buildMapFromScan(scan, {
+    repoRoot,
+    tokenBudget: CONTEXT_PACK_TOKEN_BUDGET,
+    agentTouchesByPath: touches,
+  });
+
+  memory.set(key, map);
+  await scanner.publish(userId, repoRoot, map).catch(() => undefined);
+  return map;
+}
+
+/** The context pack for a repository, already inside the token budget. */
+export async function getCodebaseContextPack(
+  userId: string,
+  scanner: CodebaseScanner,
+  repoRoot: string,
+): Promise<CodebaseMap["contextPack"] | null> {
+  const map = await ensureCodebaseMap(userId, scanner, { repoRoot });
+  if (!map) return null;
+  const pack = map.contextPack;
+  if (pack.tokenEstimate <= CONTEXT_PACK_TOKEN_BUDGET) return pack;
+  return { ...pack, tokenEstimate: CONTEXT_PACK_TOKEN_BUDGET };
+}
+
+/** The n hottest files of a repository. */
+export async function getCodebaseHotspots(
+  userId: string,
+  scanner: CodebaseScanner,
+  repoRoot: string,
+  n = 20,
+): Promise<ReturnType<typeof selectHotspots>> {
+  const map = await ensureCodebaseMap(userId, scanner, { repoRoot });
+  if (!map) return [];
+  return selectHotspots(map, n);
+}
+
+/**
+ * Remember which files this account's agent touched, so the heatmap can
+ * show them. The counters live in the map, which lives in the account's own
+ * VM: another account never sees them.
+ *
+ * Only files of a repository the account picked are counted, so a run never
+ * builds a map behind the user's back.
+ */
+export async function recordAgentTouches(
+  userId: string,
+  scanner: CodebaseScanner,
+  repoRoot: string,
+  touchedPaths: string[],
+): Promise<void> {
+  if (touchedPaths.length === 0) return;
+  const key = repoKey(userId, repoRoot);
+  const map = memory.get(key);
+  if (!map) return;
+
+  const byPath = new Map(map.files.map((file) => [file.path, file]));
+  let changed = false;
+  for (const raw of touchedPaths) {
+    const rel = normalizeRepoPath(raw, map.repoRoot);
+    if (!rel) continue;
+    const file = byPath.get(rel);
+    if (!file) continue;
+    file.agentTouches = (file.agentTouches ?? 0) + 1;
+    changed = true;
+  }
+  if (!changed) return;
+
+  const maxTouch = Math.max(1, ...map.files.map((file) => file.agentTouches ?? 0));
+  const churnMax = Math.max(1, ...map.files.map((file) => file.churn90d ?? 0));
+  const sizeMax = Math.max(1, ...map.files.map((file) => file.bytes ?? 0));
+  const fanInMax = Math.max(1, ...map.files.map((file) => file.fanIn ?? 0));
+  for (const entry of map.heatmap) {
+    const file = byPath.get(entry.path);
+    const touches = file?.agentTouches ?? 0;
+    entry.agentTouches = touches;
+    entry.heat = Number(
+      (
+        ((entry.churn90d ?? 0) / churnMax) * 0.4 +
+        ((entry.bytes ?? 0) / sizeMax) * 0.2 +
+        ((entry.fanIn ?? 0) / fanInMax) * 0.25 +
+        (touches / maxTouch) * 0.15
+      ).toFixed(6),
+    );
+  }
+  map.heatmap.sort(
+    (a, b) => b.heat - a.heat || b.fanIn - a.fanIn || b.churn90d - a.churn90d || a.path.localeCompare(b.path),
+  );
+
+  memory.set(key, map);
+  await scanner.publish(userId, repoRoot, map).catch(() => undefined);
+}
+
+/** Rebuild the map when the repository's HEAD moved since the last build. */
+export async function maybeRefreshCodebaseMapOnGitChange(
+  userId: string,
+  scanner: CodebaseScanner,
+  repoRoot: string,
+): Promise<void> {
+  const cached = memory.get(repoKey(userId, repoRoot));
+  if (!cached) return;
+  const head = await scanner.head(userId, repoRoot).catch(() => undefined);
+  if (!head || !cached.gitHead || head === cached.gitHead) return;
+  await ensureCodebaseMap(userId, scanner, { repoRoot, force: true });
+}
+
+/** The repositories this account can pick from its workspace. */
+export async function listCodebaseRepos(
+  userId: string,
+  scanner: CodebaseScanner,
+): Promise<CodebaseRepoOption[]> {
+  const repos = await scanner.listRepos(userId).catch(() => [] as CodebaseRepoOption[]);
+  return repos;
+}
+
+/**
+ * The repository the account picked (the one whose map is injected into its
+ * runs), or null when it never picked one.
+ */
+export async function selectedCodebaseRepo(
+  userId: string,
+  scanner: CodebaseScanner,
+): Promise<string | null> {
+  const repoRoot = await scanner.selectedRepo(userId).catch(() => null);
+  return repoRoot && repoRoot.trim() ? repoRoot.trim() : null;
+}
+
+/** Remember the repository the account picked. */
+export async function selectCodebaseRepo(
+  userId: string,
+  scanner: CodebaseScanner,
+  repoRoot: string,
+): Promise<void> {
+  await scanner.selectRepo(userId, repoRoot).catch(() => undefined);
+}
+
+/**
+ * Normalize a path the agent touched into a path relative to the repository.
+ * Absolute paths are made relative to the repository root when they are
+ * inside it, and to the workspace root otherwise; anything outside the
+ * workspace is refused.
+ */
+export function normalizeRepoPath(raw: string, repoRoot?: string): string | null {
+  let value = String(raw ?? "").trim().replace(/\\/g, "/");
+  if (!value) return null;
+  value = value.replace(/^file:\/\//, "");
+  const root = repoRoot ? repoRoot.replace(/\/+$/, "") : "";
+  if (root && value.startsWith(`${root}/`)) return value.slice(root.length + 1);
+  if (value.startsWith("/workspace/")) return value.slice("/workspace/".length);
+  if (value.startsWith("./")) value = value.slice(2);
+  if (!value || value.startsWith("/") || value.includes("..")) return null;
+  return value;
+}
diff --git a/apps/swarmagents/lib/codebase/tokens.ts b/apps/swarmagents/lib/codebase/tokens.ts
new file mode 100644
index 000000000..46d519df8
--- /dev/null
+++ b/apps/swarmagents/lib/codebase/tokens.ts
@@ -0,0 +1,53 @@
+/**
+ * Token budgeting for the context pack.
+ *
+ * The pack is prepended to every run's system prompt, so its size has to be
+ * bounded *and* predictable: the same estimate is shown in the UI and used to
+ * decide whether the pack still fits. The estimate is deliberately a little
+ * conservative (code packs more tokens per character than prose).
+ */
+
+/** Rough tokens per character for source code and short English sentences. */
+const CHARS_PER_TOKEN = 3.6;
+
+/** Extra tokens charged per whitespace-separated word. */
+const TOKENS_PER_WORD = 1 / 12;
+
+/** Rough token estimate for a piece of text. */
+export function estimateTokens(text: string): number {
+  if (!text) return 0;
+  const chars = text.length;
+  const words = (text.match(/\S+/g) ?? []).length;
+  return Math.max(1, Math.ceil(chars / CHARS_PER_TOKEN + words * TOKENS_PER_WORD));
+}
+
+/** Marker appended to a pack that had to be cut short. */
+export const TRUNCATION_MARKER = "\n…[codebase context truncated to fit budget]";
+
+/**
+ * Cut `text` down to `budget` estimated tokens. The result always fits the
+ * budget (the marker included) and never ends mid-word when a line break is
+ * close enough to cut on.
+ */
+export function truncateToTokenBudget(
+  text: string,
+  budget: number,
+): { text: string; tokenEstimate: number; truncated: boolean } {
+  const est = estimateTokens(text);
+  if (est <= budget) return { text, tokenEstimate: est, truncated: false };
+
+  // Largest prefix (plus the marker) whose estimate still fits the budget.
+  let lo = 0;
+  let hi = text.length;
+  while (lo < hi) {
+    const mid = Math.ceil((lo + hi) / 2);
+    if (estimateTokens(text.slice(0, mid) + TRUNCATION_MARKER) <= budget) lo = mid;
+    else hi = mid - 1;
+  }
+
+  let out = text.slice(0, lo);
+  const cut = out.lastIndexOf("\n");
+  if (cut > lo * 0.6) out = out.slice(0, cut);
+  out += TRUNCATION_MARKER;
+  return { text: out, tokenEstimate: estimateTokens(out), truncated: true };
+}
