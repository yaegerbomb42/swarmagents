diff --git a/apps/swarmagents/minimalist-ui/src/components/CodebasePanel.tsx b/apps/swarmagents/minimalist-ui/src/components/CodebasePanel.tsx
new file mode 100644
index 000000000..73eb4c486
--- /dev/null
+++ b/apps/swarmagents/minimalist-ui/src/components/CodebasePanel.tsx
@@ -0,0 +1,283 @@
+"use client";
+
+import React, { useCallback, useEffect, useMemo, useState } from "react";
+import { AlertTriangle, Boxes, FileCode2, FolderGit2, Loader2, RefreshCw } from "lucide-react";
+import {
+  fetchCodebaseMap,
+  fetchCodebaseRepos,
+  pickCodebaseRepo,
+  type CodebaseHotspot,
+  type CodebaseMapSummary,
+  type CodebaseRepo,
+} from "../../../lib/client/codebase";
+import { squarifiedTreemap } from "../utils/treemap";
+
+/** The logical size of the treemap (the SVG scales to the panel width). */
+const MAP_WIDTH = 320;
+const MAP_HEIGHT = 170;
+
+function formatBytes(bytes: number): string {
+  if (!Number.isFinite(bytes) || bytes <= 0) return "0 B";
+  if (bytes < 1024) return `${bytes} B`;
+  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
+  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
+}
+
+/** The heat colour of one file (cold blue -> hot amber). */
+function heatColor(heat: number): string {
+  const value = Math.max(0, Math.min(1, heat));
+  const hue = 200 - value * 190;
+  return `hsl(${hue.toFixed(0)} 85% ${(28 + value * 26).toFixed(0)}% / ${(0.25 + value * 0.6).toFixed(2)})`;
+}
+
+export function CodebasePanel({ onOpenFile }: { onOpenFile?: (path: string) => void }) {
+  const [repo, setRepo] = useState("");
+  const [repos, setRepos] = useState<CodebaseRepo[]>([]);
+  const [selected, setSelected] = useState<string | null>(null);
+  const [map, setMap] = useState<CodebaseMapSummary | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [picking, setPicking] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [showPack, setShowPack] = useState(false);
+
+  const loadRepos = useCallback(async () => {
+    try {
+      const { repos: list, selected: picked } = await fetchCodebaseRepos();
+      setRepos(list);
+      setSelected(picked);
+      if (picked) setRepo(picked);
+    } catch {
+      setRepos([]);
+    }
+  }, []);
+
+  const loadMap = useCallback(async (target: string) => {
+    setLoading(true);
+    setError(null);
+    try {
+      const data = await fetchCodebaseMap(target, 60);
+      setMap(data.map ?? null);
+      if (!data.map) setError("No codebase map for this repository yet.");
+    } catch (err) {
+      setMap(null);
+      setError(err instanceof Error ? err.message : "Could not load the codebase map.");
+    } finally {
+      setLoading(false);
+    }
+  }, []);
+
+  useEffect(() => {
+    void loadRepos();
+  }, [loadRepos]);
+
+  useEffect(() => {
+    void loadMap(repo);
+  }, [repo, loadMap]);
+
+  /** Pick a repository: build its map and inject its pack into every run. */
+  const pick = useCallback(
+    async (target: string, force = false) => {
+      setPicking(true);
+      setError(null);
+      try {
+        const data = await pickCodebaseRepo(target, force);
+        setMap(data.map ?? null);
+        setSelected(target);
+        if (!data.map) setError("Could not build a map for this repository.");
+      } catch (err) {
+        setError(err instanceof Error ? err.message : "Could not build the codebase map.");
+      } finally {
+        setPicking(false);
+      }
+    },
+    [],
+  );
+
+  const hotspots: CodebaseHotspot[] = useMemo(() => map?.heatmap ?? [], [map]);
+  const rects = useMemo(
+    () =>
+      squarifiedTreemap(
+        hotspots.map((hotspot) => ({ path: hotspot.path, value: hotspot.heat })),
+        MAP_WIDTH,
+        MAP_HEIGHT,
+      ),
+    [hotspots],
+  );
+  const heatByPath = useMemo(
+    () => new Map(hotspots.map((hotspot) => [hotspot.path, hotspot])),
+    [hotspots],
+  );
+
+  const openFile = useCallback(
+    (path: string) => {
+      if (!map) return;
+      onOpenFile?.(`${map.repoRoot}/${path}`);
+    },
+    [map, onOpenFile],
+  );
+
+  return (
+    <div className="flex h-full min-h-0 flex-col gap-2.5" data-testid="codebase-tab">
+      <div className="flex items-start justify-between gap-2">
+        <div className="min-w-0">
+          <div className="flex items-center gap-1.5 text-[11px] font-semibold tracking-wide text-white/85">
+            <Boxes className="h-3.5 w-3.5 shrink-0 text-cyan-300/80" />
+            <span className="truncate">{map?.repoName ?? "Codebase"}</span>
+            {selected && map?.repoRoot === selected && (
+              <span className="shrink-0 rounded-full border border-cyan-400/25 bg-cyan-400/10 px-1.5 py-px text-[9px] font-medium text-cyan-200/80">
+                picked
+              </span>
+            )}
+          </div>
+          <div className="truncate text-[10px] text-white/35">
