index 000000000..bb5a385b7
--- /dev/null
+++ b/apps/swarmagents/lib/codebase/types.ts
@@ -0,0 +1,183 @@
+/**
+ * Types for the codebase map.
+ *
+ * A "codebase map" is built for one repository inside a user's VM workspace
+ * and answers two questions:
+ *
+ *   1. What is this codebase?  -> the context pack (a compact, token-bounded
+ *      summary of languages, entry points, commands, modules and key files).
+ *   2. Where is the heat?       -> the heatmap (per-file churn x size x
+ *      fan-in x the files this account's agent touched before).
+ *
+ * The scan is produced by a small program that runs *inside the user's VM*
+ * (lib/codebase/vm-analyzer-source.ts). Everything that decides ranking,
+ * budgeting or wording happens here on the server, so the same rules apply to
+ * every repo and can be unit tested without a VM.
+ */
+
+/** One file as seen by the scanner: repo-relative, posix paths. */
+export interface CodebaseScannedFile {
+  path: string;
+  bytes: number;
+  lines?: number;
+  language?: string;
+  /** Exported symbol names (empty when the file exports nothing). */
+  exports?: string[];
+  /** Raw import specifiers as written in the file. */
+  imports?: string[];
+  /** The first few hundred characters of the file, used to describe it. */
+  head?: string;
+}
+
+/** The `package.json` facts the pack reports (scripts + tool deps). */
+export interface CodebasePackageJson {
+  name?: string;
+  scripts?: Record<string, string>;
+  dependencies?: Record<string, string>;
+  devDependencies?: Record<string, string>;
+  packageManager?: string;
+}
+
+/** Raw scanner output for one repository. */
+export interface CodebaseScan {
+  /** Absolute path of the repository root (inside the VM). */
+  repoRoot: string;
+  repoName: string;
+  repoHash: string;
+  generatedAt: string;
+  /** HEAD commit of the repository, when it is a git checkout. */
+  gitHead?: string;
+  files: CodebaseScannedFile[];
+  /** path -> lines added+deleted in the last 90 days. */
+  churn: Record<string, number>;
+  packageJson?: CodebasePackageJson;
+  /** Every package.json found in the repository (monorepos have many). */
+  packageFiles?: Array<CodebasePackageJson & { path: string }>;
+  /** Lock files seen in the repository (they say which package manager to use). */
+  lockFiles?: string[];
+  /** True when the scanner hit a file or byte cap and stopped early. */
+  truncated?: boolean;
+}
+
+export interface CodebaseFileInfo {
+  path: string; // repo-relative, posix
+  bytes: number;
+  lines?: number;
+  language?: string;
+  purpose?: string;
+  exports?: string[];
+  fanIn: number;
+  churn90d: number;
+  agentTouches: number;
+  heat: number;
+  lastModifiedMs?: number;
+}
+
+export interface CodebaseModuleInfo {
+  path: string; // top-level dir or file
+  kind: "dir" | "file";
+  purpose: string;
+  files: number;
+  bytes: number;
+}
+
+export interface CodebaseConventions {
+  testFramework?: string;
+  lint?: string;
+  format?: string;
+  packageManager?: string;
+  notes?: string[];
+}
+
+export interface CodebaseContextPack {
+  repoRoot: string;
+  repoName: string;
+  repoHash: string;
+  generatedAt: string;
+  gitHead?: string;
+  languages: Record<string, number>;
+  entryPoints: string[];
+  buildCommands: string[];
+  testCommands: string[];
+  topLevelModules: CodebaseModuleInfo[];
+  keyFiles: Array<{
+    path: string;
+    purpose?: string;
+    exports?: string[];
+    fanIn: number;
+  }>;
+  conventions: CodebaseConventions;
+  tokenEstimate: number;
+  text: string;
+}
+
+export interface CodebaseHeatmapEntry {
+  path: string;
+  churn90d: number;
+  bytes: number;
+  fanIn: number;
+  agentTouches: number;
+  heat: number;
+}
+
+export interface CodebaseMap {
+  version: 1;
+  repoRoot: string;
+  repoName: string;
+  repoHash: string;
+  generatedAt: string;
+  gitHead?: string;
+  buildMs: number;
+  files: CodebaseFileInfo[];
+  topLevelModules: CodebaseModuleInfo[];
+  languages: Record<string, number>;
+  entryPoints: string[];
+  buildCommands: string[];
+  testCommands: string[];
+  conventions: CodebaseConventions;
+  contextPack: CodebaseContextPack;
+  heatmap: CodebaseHeatmapEntry[];
+}
+
+/** One repository the account can pick from its VM workspace. */
+export interface CodebaseRepoOption {
+  /** Workspace-relative path ("" is the workspace root itself). */
+  repo: string;
+  /** Absolute path inside the VM. */
+  repoRoot: string;
+  name: string;
+}
+
+/**
+ * The port the map builder uses to reach a repository. Implemented by the
+ * VM scanner (runs the analyzer inside the user's VM) and by the local
+ * scanner (runs the same analyzer with the host's node).
+ */
+export interface CodebaseScanner {
+  /** Scan one repository. Returns null when the path is not a directory. */
+  scan(
+    userId: string,
+    repoRoot: string,
+    options?: { sinceHead?: string },
+  ): Promise<CodebaseScan | null>;
+  /** Current HEAD of the repository, or undefined when it is not a checkout. */
+  head(userId: string, repoRoot: string): Promise<string | undefined>;
+  /** Persist the finished map inside the VM (map.json + context-pack.md). */
+  publish(userId: string, repoRoot: string, map: CodebaseMap): Promise<void>;
+  /** Read back a map that was published before (no rebuild). */
+  readMap(userId: string, repoRoot: string): Promise<CodebaseMap | null>;
+  /** Repositories available in the workspace (git checkouts). */
+  listRepos(userId: string): Promise<CodebaseRepoOption[]>;
+  /** The repository the account picked (null when it never picked one). */
+  selectedRepo(userId: string): Promise<string | null>;
+  /** Remember which repository the account picked. */
+  selectRepo(userId: string, repoRoot: string): Promise<void>;
+}
+
+export interface BuildCodebaseMapOptions {
+  repoRoot: string;
+  tokenBudget?: number;
+  nowMs?: number;
+  /** path -> how many times this account's agent touched the file. */
+  agentTouchesByPath?: Record<string, number>;
+}
diff --git a/apps/swarmagents/lib/codebase/vm-analyzer-source.ts b/apps/swarmagents/lib/codebase/vm-analyzer-source.ts
new file mode 100644
index 000000000..c853e2dee
--- /dev/null
+++ b/apps/swarmagents/lib/codebase/vm-analyzer-source.ts
@@ -0,0 +1,388 @@
+/**
+ * The codebase scanner that runs *inside the user's VM*.
+ *
+ * The repository lives in the VM, not on the app server, so the scan has to
+ * happen there. This module generates the program that does it: a small,
+ * dependency-free Node script that walks the repository, reads the files it
+ * needs, asks git for the churn of the last 90 days and prints one JSON
+ * document (a `CodebaseScan`) on stdout.
+ *
+ * Every rule it applies comes from lib/codebase/rules.ts, so the VM and the
+ * server can never drift apart on what counts as source, an import or an
+ * export. The server then does all the ranking, budgeting and wording.
+ */
+
+import {
+  DYNAMIC_IMPORT_RE,
+  EXPORT_PATTERNS,
+  EXT_LANG,
+  GO_EXPORT_RE,
+  IGNORE_DIRS,
+  IGNORE_FILES,
+  MAX_IMPORTS_PER_FILE,
+  MAX_PARSED_FILE_BYTES,
+  MAX_SCANNED_FILES,
+  PYTHON_EXPORT_RE,
+  PYTHON_IMPORT_RE,
+  REQUIRE_RE,
+  RUST_EXPORT_RE,
+  SOURCE_EXTS,
+  STATIC_IMPORT_RE,
+} from "./rules";
+
+/** Where the analyzer is written inside the user's VM. */
+export const CODEBASE_ANALYZER_PATH = "/workspace/.swarm/codebase-analyzer.mjs";
+
+function regexLiteral(re: RegExp): string {
+  return `new RegExp(${JSON.stringify(re.source)}, ${JSON.stringify(re.flags)})`;
+}
+
+/** The scanner program, written verbatim into the VM. */
+export function codebaseAnalyzerSource(): string {
+  const lines: string[] = [
+    "#!/usr/bin/env node",
+    "// SwarmAgents codebase scanner (auto-generated). Runs inside the user's VM.",
+    "import fs from 'node:fs';",
+    "import path from 'node:path';",
+    "import crypto from 'node:crypto';",
+    "import { execFileSync } from 'node:child_process';",
+    "",
+    `const EXT_LANG = ${JSON.stringify(EXT_LANG)};`,
+    `const IGNORE_DIRS = new Set(${JSON.stringify(IGNORE_DIRS)});`,
+    `const LOCK_FILES = new Set(['package-lock.json', 'pnpm-lock.yaml', 'yarn.lock', 'bun.lockb', 'bun.lock', 'Cargo.lock', 'poetry.lock', 'composer.lock']);`,
+    `const IGNORE_FILES = new Set(${JSON.stringify(IGNORE_FILES)});`,
+    `const SOURCE_EXTS = new Set(${JSON.stringify(SOURCE_EXTS)});`,
+    `const JS_EXTS = new Set(['.ts', '.tsx', '.js', '.jsx', '.mts', '.cts', '.mjs', '.cjs']);`,
+    `const MAX_PARSED_FILE_BYTES = ${MAX_PARSED_FILE_BYTES};`,
+    `const MAX_SCANNED_FILES = ${MAX_SCANNED_FILES};`,
+    `const MAX_IMPORTS_PER_FILE = ${MAX_IMPORTS_PER_FILE};`,
+    `const STATIC_IMPORT_RE = new RegExp(${regexLiteral(STATIC_IMPORT_RE)});`,
+    `const REQUIRE_RE = new RegExp(${regexLiteral(REQUIRE_RE)});`,
+    `const DYNAMIC_IMPORT_RE = new RegExp(${regexLiteral(DYNAMIC_IMPORT_RE)});`,
+    `const PYTHON_IMPORT_RE = new RegExp(${regexLiteral(PYTHON_IMPORT_RE)});`,
+    `const PYTHON_EXPORT_RE = new RegExp(${regexLiteral(PYTHON_EXPORT_RE)});`,
+    `const GO_EXPORT_RE = new RegExp(${regexLiteral(GO_EXPORT_RE)});`,
+    `const RUST_EXPORT_RE = new RegExp(${regexLiteral(RUST_EXPORT_RE)});`,
+    `const EXPORT_PATTERNS = ${JSON.stringify(EXPORT_PATTERNS.map((p) => ({ re: { source: p.re.source, flags: p.re.flags }, kind: p.kind })))};`,    "",
+    "function repoHash(root) {",
+    "  return crypto.createHash('sha1').update(path.resolve(root)).digest('hex').slice(0, 16);",
+    "}",
+    "",
+    "function walk(root) {",
+    "  const files = [];",
+    "  const lockFiles = [];",
+    "  let truncated = false;",
+    "  const stack = [''];",
+    "  while (stack.length) {",
+    "    const rel = stack.pop();",
+    "    let entries;",
+    "    try {",
+    "      entries = fs.readdirSync(path.join(root, rel), { withFileTypes: true });",
+    "    } catch (err) {",
+    "      continue;",
+    "    }",
+    "    for (const entry of entries) {",
+    "      const childRel = rel ? rel + '/' + entry.name : entry.name;",
+    "      if (entry.isDirectory()) {",
+    "        if (IGNORE_DIRS.has(entry.name)) continue;",
+    "        if (entry.name.startsWith('.')) continue;",
+    "        stack.push(childRel);",
+    "        continue;",
+    "      }",
+    "      if (!entry.isFile()) continue;",
+    "      if (LOCK_FILES.has(entry.name)) { lockFiles.push(entry.name); continue; }",
+    "      if (IGNORE_FILES.has(entry.name)) continue;",
+    "      if (entry.name.startsWith('.') && entry.name !== '.env.example') continue;",
+    "      files.push(childRel);",
+    "      if (files.length >= MAX_SCANNED_FILES) { truncated = true; stack.length = 0; break; }",
+    "    }",
+    "  }",
+    "  files.sort();",
+    "  return { files, lockFiles, truncated };",
+    "}",
+    "",
+    "function countLines(text) {",
+    "  if (!text) return 0;",
+    "  let n = 1;",
+    "  for (let i = 0; i < text.length; i++) if (text.charCodeAt(i) === 10) n++;",
+    "  return n;",
+    "}",
+    "",
+    "function looksBinary(text) {",
+    "  const limit = Math.min(text.length, 8000);",
+    "  for (let i = 0; i < limit; i++) if (text.charCodeAt(i) === 0) return true;",
+    "  return false;",
+    "}",
+    "",
+    "function addName(names, value) {",
+    "  if (!value) return;",
+    "  const name = String(value).trim();",
+    "  if (!name || name === 'default' || name.length > 80) return;",
+    "  names.add(name);",
+    "}",
+    "",
+    "function extractExports(content, ext) {",
+    "  const names = new Set();",
+    "  if (JS_EXTS.has(ext)) {",
+    "    for (const pattern of EXPORT_PATTERNS) {",
+    "      const re = new RegExp(pattern.re.source, pattern.re.flags);",
+    "      let match;",
+    "      while ((match = re.exec(content)) !== null) {",
+    "        if (pattern.kind === 'list') {",
+    "          for (const part of match[1].split(',')) {",
+    "            const bits = part.trim().split(/\\s+as\\s+/i);",
+    "            addName(names, bits[bits.length - 1]);",
+    "          }",
+    "        } else {",
+    "          addName(names, match[1]);",
+    "        }",
+    "      }",
+    "    }",
+    "  } else if (ext === '.py') {",
+    "    const re = new RegExp(PYTHON_EXPORT_RE.source, PYTHON_EXPORT_RE.flags);",
+    "    let match;",
+    "    while ((match = re.exec(content)) !== null) addName(names, match[1]);",
+    "  } else if (ext === '.go') {",
+    "    const re = new RegExp(GO_EXPORT_RE.source, GO_EXPORT_RE.flags);",
+    "    let match;",
+    "    while ((match = re.exec(content)) !== null) addName(names, match[1]);",
+    "  } else if (ext === '.rs') {",
+    "    const re = new RegExp(RUST_EXPORT_RE.source, RUST_EXPORT_RE.flags);",
+    "    let match;",
+    "    while ((match = re.exec(content)) !== null) addName(names, match[1]);",
+    "  }",
+    "  return Array.from(names).slice(0, 20);",
+    "}",
+    "",
+    "function collectImports(content, ext) {",
+    "  const specs = [];",
+    "  if (JS_EXTS.has(ext)) {",
+    "    for (const match of content.matchAll(STATIC_IMPORT_RE)) specs.push(match[1]);",
+    "    for (const match of content.matchAll(REQUIRE_RE)) specs.push(match[1]);",
+    "    for (const match of content.matchAll(DYNAMIC_IMPORT_RE)) specs.push(match[1]);",
+    "  } else if (ext === '.py') {",
+    "    for (const match of content.matchAll(PYTHON_IMPORT_RE)) {",
+    "      const spec = match[1] || match[2];",
+    "      if (spec && spec.startsWith('.')) specs.push(spec);",
+    "    }",
+    "  }",
+    "  const unique = [];",
+    "  const seen = new Set();",
+    "  for (const spec of specs) {",
+    "    if (!spec || seen.has(spec)) continue;",
+    "    seen.add(spec);",
+    "    unique.push(spec);",
+    "    if (unique.length >= MAX_IMPORTS_PER_FILE) break;",
+    "  }",
+    "  return unique;",
+    "}",
+    "",
+    "function languageFor(rel) {",
+    "  const ext = path.extname(rel).slice(1).toLowerCase();",
+    "  if (EXT_LANG[ext]) return EXT_LANG[ext];",
+    "  const base = path.basename(rel).toLowerCase();",
+    "  if (base === 'dockerfile') return 'Dockerfile';",
+    "  if (base === 'makefile') return 'Makefile';",
+    "  return undefined;",
+    "}",
+    "",
+    "function readHead(root) {",
+    "  try {",
+    "    const out = execFileSync('git', ['-C', root, 'rev-parse', 'HEAD'], {",
+    "      encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'],",
+    "    }).trim();",
+    "    return out || undefined;",
+    "  } catch (err) {",
+    "    return undefined;",
+    "  }",
+    "}",
+    "",
+    "function readChurn(root, sinceHead, churnPath) {",
+    "  const churn = {};",
+    "  let range = ['--since=90.days'];",
+    "  // A rebuild after a commit only has to diff the commits that were added",
+    "  // since the last build: the rest of the churn is already on disk.",
+    "  if (sinceHead && churnPath) {",
+    "    let stored = null;",
+    "    try { stored = JSON.parse(fs.readFileSync(churnPath, 'utf8')); } catch (err) { stored = null; }",
+    "    if (stored && stored.churn && typeof stored.churn === 'object') {",
+    "      for (const key of Object.keys(stored.churn)) churn[key] = stored.churn[key];",
+    "      range = [sinceHead + '..HEAD'];",
+    "    }",
+    "  }",
+    "  let out;",
+    "  try {",
+    "    out = execFileSync('git', ['-C', root, 'log', '--relative', '--no-ext-diff', '--no-textconv', '--numstat', '--pretty=format:--'].concat(range), {",
+    "      encoding: 'utf8', maxBuffer: 64 * 1024 * 1024, stdio: ['ignore', 'pipe', 'ignore'],",
+    "    });",
+    "  } catch (err) {",
+    "    // An unusable range (the old commit is gone): fall back to the window.",
+    "    if (range.length === 1) return churn;",
+    "    range = ['--since=90.days'];",
+    "    churn = {};",
+    "    try {",
+    "      out = execFileSync('git', ['-C', root, 'log', '--relative', '--no-ext-diff', '--no-textconv', '--numstat', '--pretty=format:--'].concat(range), {",
+    "        encoding: 'utf8', maxBuffer: 64 * 1024 * 1024, stdio: ['ignore', 'pipe', 'ignore'],",
+    "      });",
+    "    } catch (err2) {",
+    "      return churn;",
+    "    }",
+    "  }",
+    "  for (const line of out.split('\\n')) {",
+    "    if (!line || line.startsWith('--')) continue;",
+    "    const parts = line.split('\\t');",
+    "    if (parts.length < 3) continue;",
+    "    const added = parts[0] === '-' ? 0 : (parseInt(parts[0], 10) || 0);",
+    "    const removed = parts[1] === '-' ? 0 : (parseInt(parts[1], 10) || 0);",
+    "    const file = parts.slice(2).join('\\t').trim();",
+    "    if (!file) continue;",
+    "    churn[file] = (churn[file] || 0) + added + removed;",
+    "  }",
+    "  return churn;",
+    "}",
+    "",
+    "function readPackageJson(root) {",
+    "  try {",
+    "    const raw = fs.readFileSync(path.join(root, 'package.json'), 'utf8');",
+    "    const pkg = JSON.parse(raw);",
+    "    const out = {};",
+    "    if (typeof pkg.name === 'string') out.name = pkg.name;",
+    "    if (pkg.scripts && typeof pkg.scripts === 'object') out.scripts = pkg.scripts;",
+    "    if (pkg.dependencies && typeof pkg.dependencies === 'object') out.dependencies = pkg.dependencies;",
+    "    if (pkg.devDependencies && typeof pkg.devDependencies === 'object') out.devDependencies = pkg.devDependencies;",
+    "    if (typeof pkg.packageManager === 'string') out.packageManager = pkg.packageManager;",
+    "    return out;",
+    "  } catch (err) {",
+    "    return undefined;",
+    "  }",
+    "}",
+    "",
+    "function summarizePackage(rel, raw) {",
+    "  const out = { path: rel };",
+    "  try {",
+    "    const pkg = JSON.parse(raw);",
+    "    if (typeof pkg.name === 'string') out.name = pkg.name;",
+    "    if (pkg.scripts && typeof pkg.scripts === 'object') out.scripts = pkg.scripts;",
+    "    if (pkg.dependencies && typeof pkg.dependencies === 'object') out.dependencies = pkg.dependencies;",
+    "    if (pkg.devDependencies && typeof pkg.devDependencies === 'object') out.devDependencies = pkg.devDependencies;",
+    "    if (typeof pkg.packageManager === 'string') out.packageManager = pkg.packageManager;",
+    "  } catch (err) {",
+    "    return undefined;",
+    "  }",
+    "  return out;",
+    "}",
+    "",
+    "function listRepos(workspace) {",
+    "  const repos = [];",
+    "  let entries;",
+    "  try {",
+    "    entries = fs.readdirSync(workspace, { withFileTypes: true });",
+    "  } catch (err) {",
+    "    return repos;",
+    "  }",
+    "  for (const entry of entries) {",
+    "    if (!entry.isDirectory()) continue;",
+    "    if (entry.name.startsWith('.')) continue;",
+    "    const repoRoot = path.join(workspace, entry.name);",
+    "    let isRepo = false;",
+    "    try { isRepo = fs.existsSync(path.join(repoRoot, '.git')); } catch (err) { isRepo = false; }",
+    "    if (!isRepo) continue;",
+    "    repos.push({ repo: entry.name, repoRoot: repoRoot, name: entry.name });",
+    "  }",
+    "  let workspaceIsRepo = false;",
+    "  try { workspaceIsRepo = fs.existsSync(path.join(workspace, '.git')); } catch (err) { workspaceIsRepo = false; }",
+    "  if (workspaceIsRepo) repos.unshift({ repo: '', repoRoot: workspace, name: path.basename(workspace) });",
+    "  return repos;",
+    "}",
+    "",
+    "function scan(root, sinceHead, churnPath) {",
+    "  const absRoot = path.resolve(root);",
+    "  const walked = walk(absRoot);",
+    "  const files = [];",
+    "  const packageFiles = [];",
+    "  const lockFiles = walked.lockFiles;",
+    "  for (const rel of walked.files) {",
+    "    const abs = path.join(absRoot, rel);",
+    "    let stat;",
+    "    try { stat = fs.statSync(abs); } catch (err) { continue; }",
+    "    const ext = path.extname(rel).toLowerCase();",
+    "    const record = { path: rel, bytes: stat.size, mtimeMs: Math.round(stat.mtimeMs) };",
+    "    const language = languageFor(rel);",
+    "    if (language) record.language = language;",
+    "    const baseName = path.basename(rel);",
+    "    if (LOCK_FILES.has(baseName)) lockFiles.push(baseName);",
+    "    if (path.basename(rel) === 'package.json' && packageFiles.length < 25) {",
+    "      let raw;",
+    "      try { raw = fs.readFileSync(abs, 'utf8'); } catch (err) { raw = null; }",
+    "      if (raw != null) {",
+    "        const summary = summarizePackage(rel, raw);",
+    "        if (summary) packageFiles.push(summary);",
+    "      }",
+    "    }",
+    "    if (SOURCE_EXTS.has(ext) && stat.size <= MAX_PARSED_FILE_BYTES) {",
+    "      let content;",
+    "      try { content = fs.readFileSync(abs, 'utf8'); } catch (err) { content = null; }",
+    "      if (content != null && !looksBinary(content)) {",
+    "        record.lines = countLines(content);",
+    "        record.head = content.slice(0, 300);",
+    "        const exports = extractExports(content, ext);",
+    "        if (exports.length) record.exports = exports;",
+    "        const imports = collectImports(content, ext);",
+    "        if (imports.length) record.imports = imports;",
+    "      }",
+    "    }",
+    "    files.push(record);",
+    "  }",
+    "  const head = readHead(absRoot);",
+    "  const churn = readChurn(absRoot, sinceHead, churnPath);",
+    "  return {",
+    "    repoRoot: absRoot,",
+    "    repoName: path.basename(absRoot) || absRoot,",
+    "    repoHash: repoHash(absRoot),",
+    "    generatedAt: new Date().toISOString(),",
+    "    gitHead: head,",
+    "    files,",
+    "    churn,",
+    "    packageJson: readPackageJson(absRoot),",
+    "    packageFiles,",
+    "    lockFiles,",
+    "    truncated: walked.truncated,",
+    "  };",
+    "}",
+    "",
+    "const args = process.argv.slice(2);",
+    "if (args[0] === '--list-repos') {",
+    "  const workspace = path.resolve(args[1] || '/workspace');",
+    "  process.stdout.write(JSON.stringify({ ok: true, repos: listRepos(workspace) }));",
+    "  process.exit(0);",
+    "}",
+    "",
+    "const target = path.resolve(args[0] || '/workspace');",
+    "const sinceHead = args[1] && args[1] !== '-' ? args[1] : undefined;",
+    "let stat;",
+    "try { stat = fs.statSync(target); } catch (err) { stat = null; }",
+    "if (!stat || !stat.isDirectory()) {",
+    "  process.stdout.write(JSON.stringify({ ok: false, error: 'not_a_directory', repoRoot: target }));",
+    "  process.exit(2);",
+    "}",
+    "",
+    "// The scan is written next to the finished map so the server can read it",
+    "// back without pushing megabytes through the exec output quota.",
+    "const home = process.env.HOME || '/home/node';",
+    "const dir = path.join(home, '.swarm', 'codebase', repoHash(target));",
+    "const scanPath = path.join(dir, 'scan.json');",
+    "const churnPath = path.join(dir, 'churn.json');",
+    "const result = scan(target, sinceHead, churnPath);",
+    "try {",
+    "  fs.mkdirSync(dir, { recursive: true });",
+    "  fs.writeFileSync(scanPath, JSON.stringify(result));",
+    "  fs.writeFileSync(churnPath, JSON.stringify({ head: result.gitHead, churn: result.churn }));",
+    "} catch (err) {",
+    "  process.stdout.write(JSON.stringify({ ok: false, error: 'write_failed', repoRoot: target }));",
+    "  process.exit(3);",
+    "}",
+    "process.stdout.write(JSON.stringify({ ok: true, scanPath: scanPath, files: result.files.length }));",
+    "",
+  ];
+  return lines.join("\n");
+}
diff --git a/apps/swarmagents/lib/codebase/vm-scanner.ts b/apps/swarmagents/lib/codebase/vm-scanner.ts
new file mode 100644
index 000000000..568666f7d
--- /dev/null
+++ b/apps/swarmagents/lib/codebase/vm-scanner.ts
@@ -0,0 +1,173 @@
+/**
+ * The codebase scanner that talks to a user's VM.
+ *
+ * The scanner program (lib/codebase/vm-analyzer-source.ts) is written into
+ * the VM and run there: the repository lives in the VM, so that is the only
+ * place where it can be read. The program leaves its result in
+ * `~/.swarm/codebase/<repoHash>/scan.json`; the app reads that file back and
+ * publishes the finished map next to it.
+ */
+
+import { WORKSPACE_ROOT } from "../vm/files";
+import type { VmManager } from "../vm/manager";
+import { repoHashForRoot } from "./hash";
+import type {
+  CodebaseMap,
+  CodebaseRepoOption,
+  CodebaseScan,
+  CodebaseScanner,
+} from "./types";
+import { CODEBASE_ANALYZER_PATH, codebaseAnalyzerSource } from "./vm-analyzer-source";
+
+/** How long one scan may take inside the VM. */
+const SCAN_TIMEOUT_MS = 120_000;
+
+/** Cached HOME per account (resolved once per VM). */
+const homeCache = new Map<string, string>();
+
+/** The HOME directory inside the user's VM. */
+export async function vmHomeDir(vm: VmManager, userId: string): Promise<string> {
+  const cached = homeCache.get(userId);
+  if (cached) return cached;
+  let out = "";
+  await vm
+    .exec(userId, ["sh", "-c", "echo $HOME"], { onStdout: (chunk) => { out += chunk; } })
+    .catch(() => undefined);
+  const home = out.trim() || "/home/node";
+  homeCache.set(userId, home);
+  return home;
+}
+
+/** Forget the cached HOME (the VM was reset or recreated). */
+export function forgetVmHome(userId: string): void {
+  homeCache.delete(userId);
+}
+
+/** Where a repository's map lives inside the VM. */
+export function vmMapDir(home: string, repoHash: string): string {
+  return `${home}/.swarm/codebase/${repoHash}`;
+}
+
+/** Where the account's choice of repository is remembered inside the VM. */
+export function vmSelectionPath(home: string): string {
+  return `${home}/.swarm/codebase/selection.json`;
+}
+
+/** A scanner that reads and writes inside one user's VM. */
+export function createVmScanner(vm: VmManager): CodebaseScanner {
+  async function runNode(userId: string, args: string[]): Promise<string> {
+    let stdout = "";
+    await vm
+      .exec(userId, ["node", CODEBASE_ANALYZER_PATH, ...args], {
+        timeoutMs: SCAN_TIMEOUT_MS,
+        onStdout: (chunk) => { stdout += chunk; },
+      })
+      .catch(() => undefined);
+    return stdout;
+  }
+
+  return {
+    async scan(
+      userId: string,
+      repoRoot: string,
+      options?: { sinceHead?: string },
+    ): Promise<CodebaseScan | null> {
+      try {
+        await vm.writeFile(userId, CODEBASE_ANALYZER_PATH, codebaseAnalyzerSource());
+      } catch {
+        return null;
+      }
+      const stdout = await runNode(userId, [
+        repoRoot,
+        options?.sinceHead ? options.sinceHead : "-",
+      ]);
+      if (!stdout.trim()) return null;
+      let parsed: { ok?: boolean; scanPath?: string; error?: string };
+      try {
+        parsed = JSON.parse(stdout) as { ok?: boolean; scanPath?: string; error?: string };
+      } catch {
+        return null;
+      }
+      if (!parsed.ok || !parsed.scanPath) return null;
+      try {
+        const raw = await vm.readFile(userId, parsed.scanPath);
+        const scan = JSON.parse(raw) as CodebaseScan;
+        if (!scan || !Array.isArray(scan.files)) return null;
+        return scan;
+      } catch {
+        return null;
+      }
+    },
+
+    async head(userId: string, repoRoot: string): Promise<string | undefined> {
+      let stdout = "";
+      try {
+        await vm.exec(userId, ["git", "-C", repoRoot, "rev-parse", "HEAD"], {
+          timeoutMs: 20_000,
+          onStdout: (chunk) => { stdout += chunk; },
+        });
+      } catch {
+        return undefined;
+      }
+      const head = stdout.trim();
+      return head || undefined;
+    },
+
+    async publish(userId: string, repoRoot: string, map: CodebaseMap): Promise<void> {
+      const home = await vmHomeDir(vm, userId);
+      const dir = vmMapDir(home, map.repoHash || repoHashForRoot(repoRoot));
+      await vm.writeFile(userId, `${dir}/map.json`, `${JSON.stringify(map, null, 2)}\n`).catch(() => undefined);
+      await vm
+        .writeFile(userId, `${dir}/context-pack.md`, map.contextPack.text)
+        .catch(() => undefined);
+    },
+
+    async listRepos(userId: string): Promise<CodebaseRepoOption[]> {
+      try {
+        await vm.writeFile(userId, CODEBASE_ANALYZER_PATH, codebaseAnalyzerSource());
+      } catch {
+        return [];
+      }
+      const stdout = await runNode(userId, ["--list-repos", WORKSPACE_ROOT]);
+      if (!stdout.trim()) return [];
+      try {
+        const parsed = JSON.parse(stdout) as { ok?: boolean; repos?: CodebaseRepoOption[] };
+        if (!parsed.ok || !Array.isArray(parsed.repos)) return [];
+        return parsed.repos;
+      } catch {
+        return [];
+      }
+    },
+
+    async readMap(userId: string, repoRoot: string): Promise<CodebaseMap | null> {
+      const home = await vmHomeDir(vm, userId);
+      const file = `${vmMapDir(home, repoHashForRoot(repoRoot))}/map.json`;
+      try {
+        const raw = await vm.readFile(userId, file);
+        const map = JSON.parse(raw) as CodebaseMap;
+        return map?.contextPack?.text ? map : null;
+      } catch {
+        return null;
+      }
+    },
+
+    async selectedRepo(userId: string): Promise<string | null> {
+      const home = await vmHomeDir(vm, userId);
+      try {
+        const raw = await vm.readFile(userId, vmSelectionPath(home));
+        const parsed = JSON.parse(raw) as { repoRoot?: unknown };
+        const repoRoot = typeof parsed.repoRoot === "string" ? parsed.repoRoot : "";
+        return repoRoot || null;
+      } catch {
+        return null;
+      }
+    },
+
+    async selectRepo(userId: string, repoRoot: string): Promise<void> {
+      const home = await vmHomeDir(vm, userId);
+      await vm
+        .writeFile(userId, vmSelectionPath(home), `${JSON.stringify({ repoRoot }, null, 2)}\n`)
+        .catch(() => undefined);
+    },
+  };
+}
diff --git a/apps/swarmagents/lib/harness/codebase-mcp-source.ts b/apps/swarmagents/lib/harness/codebase-mcp-source.ts
new file mode 100644
index 000000000..690541e0a
--- /dev/null
+++ b/apps/swarmagents/lib/harness/codebase-mcp-source.ts
@@ -0,0 +1,211 @@
+/**
+ * The codebase MCP server.
+ *
+ * The server is written into the user's VM next to the role-switch server and
+ * exposed to the agent as the `codebase` MCP server. It exposes two tools:
+ *
+ *   - codebase_map_get()      — the context pack: languages, entry points,
+ *     commands, module layout and the files everything else depends on.
+ *   - codebase_hotspots(n)    — the hottest files (churn x size x fan-in x
+ *     the files the agent touched before).
+ *
+ * It reads the map the app published in the VM
+ * (`~/.swarm/codebase/<repoHash>/map.json`), so the agent and the UI always
+ * talk about the same map.
+ */
+
+/** Name of the stdio MCP server exposing the codebase tools. */
+export const CODEBASE_MCP_SERVER_NAME = "codebase";
+
+/** Path (inside the VM) the server is written to. */
+export const CODEBASE_MCP_SERVER_PATH = "/workspace/.swarm/codebase-server.mjs";
+
+/** The tool the agent calls to read the map. */
+export const CODEBASE_MAP_TOOL = "codebase_map_get";
+
+/** The tool the agent calls to list the hottest files. */
+export const CODEBASE_HOTSPOTS_TOOL = "codebase_hotspots";
+
+/** The server program, written verbatim into the VM. */
+export function codebaseMcpServerSource(): string {
+  return [
+    "#!/usr/bin/env node",
+    "// SwarmAgents codebase MCP stdio server (auto-generated).",
+    "// Speaks newline-delimited JSON-RPC 2.0 over stdin/stdout.",
+    "import fs from 'node:fs';",
+    "import path from 'node:path';",
+    "import crypto from 'node:crypto';",
+    "",
+    "function repoHash(root) {",
+    "  return crypto.createHash('sha1').update(path.resolve(root)).digest('hex').slice(0, 16);",
+    "}",
+    "",
+    "function readJson(file) {",
+    "  try { return JSON.parse(fs.readFileSync(file, 'utf8')); } catch (err) { return null; }",
+    "}",
+    "",
+    "function mapDir(hash) {",
+    "  const home = process.env.HOME || '/root';",
+    "  return path.join(home, '.swarm', 'codebase', hash);",
+    "}",
+    "",
+    "function loadMap(repoRoot) {",
+    "  const hash = repoHash(repoRoot);",
+    "  const direct = readJson(path.join(mapDir(hash), 'map.json'));",
+    "  if (direct) return direct;",
+    "  // The workspace may hold several repositories: fall back to the newest",
+    "  // map that mentions this repository root.",
+    "  try {",
+    "    const base = path.join(process.env.HOME || '/root', '.swarm', 'codebase');",
+    "    const dirs = fs.readdirSync(base, { withFileTypes: true });",
+    "    const maps = [];",
+    "    for (const dir of dirs) {",
+    "      if (!dir.isDirectory()) continue;",
+    "      const map = readJson(path.join(base, dir.name, 'map.json'));",
+    "      if (map) maps.push(map);",
+    "    }",
+    "    const exact = maps.find((map) => map.repoRoot === repoRoot);",
+    "    if (exact) return exact;",
+    "    maps.sort((a, b) => String(b.generatedAt || '').localeCompare(String(a.generatedAt || '')));",
+    "    return maps[0] || null;",
+    "  } catch (err) {",
+    "    return null;",
+    "  }",
+    "}",
+    "",
+    "const tools = [",
+    "  {",
+    "    name: 'codebase_map_get',",
+    "    description: 'Get the codebase map for the active repository: languages, entry points, build and test commands, top-level modules, key files by import fan-in and the conventions used (test framework, lint, formatting). Use it to orient yourself before editing.',",
+    "    inputSchema: {",
+    "      type: 'object',",
+    "      properties: {",
+    "        repoRoot: { type: 'string', description: 'Optional repository root inside the workspace.' }",
+    "      }",
+    "    }",
+    "  },",
+    "  {",
+    "    name: 'codebase_hotspots',",
+    "    description: 'Get the hottest files of the active repository, ranked by churn (last 90 days) x size x import fan-in x the files this agent touched before. Use it to decide where a change is risky.',",
+    "    inputSchema: {",
+    "      type: 'object',",
+    "      properties: {",
+    "        n: { type: 'number', description: 'How many hotspots to return (default 20, max 200).' },",
+    "        repoRoot: { type: 'string', description: 'Optional repository root inside the workspace.' }",
+    "      }",
+    "    }",
+    "  }",
+    "];",
+    "",
+    "function reply(id, result) {",
+    "  process.stdout.write(JSON.stringify({ jsonrpc: '2.0', id: id, result: result }) + '\\n');",
+    "}",
+    "",
+    "function replyError(id, code, message) {",
+    "  process.stdout.write(JSON.stringify({ jsonrpc: '2.0', id: id, error: { code: code, message: message } }) + '\\n');",
+    "}",
+    "",
+    "function toolResult(payload, isError) {",
+    "  return {",
+    "    content: [{ type: 'text', text: JSON.stringify(payload) }],",
+    "    isError: isError === true",
+    "  };",
+    "}",
+    "",
+    "function callTool(name, args) {",
+    "  const repoRoot = (typeof args.repoRoot === 'string' && args.repoRoot.trim())",
+    "    ? args.repoRoot.trim()",
+    "    : (process.env.SWARM_CODEBASE_REPO_ROOT || '/workspace');",
+    "  const map = loadMap(repoRoot);",
+    "  if (!map) {",
+    "    return toolResult({",
+    "      ok: false,",
+    "      error: 'codebase map not found',",
+    "      repoRoot: repoRoot,",
+    "      hint: 'The map is built when a repository is picked in the Codebase tab.'",
+    "    }, true);",
+    "  }",
+    "  if (name === 'codebase_map_get') {",
+    "    const pack = map.contextPack || {};",
+    "    return toolResult({",
+    "      ok: true,",
+    "      repoRoot: map.repoRoot,",
+    "      repoName: map.repoName,",
+    "      repoHash: map.repoHash,",
+    "      generatedAt: map.generatedAt,",
+    "      gitHead: map.gitHead,",
+    "      buildMs: map.buildMs,",
+    "      tokenEstimate: pack.tokenEstimate,",
+    "      languages: map.languages,",
+    "      entryPoints: map.entryPoints,",
+    "      buildCommands: map.buildCommands,",
+    "      testCommands: map.testCommands,",
+    "      conventions: map.conventions,",
+    "      topLevelModules: map.topLevelModules,",
+    "      keyFiles: (pack.keyFiles || []).slice(0, 40),",
+    "      contextPack: pack.text",
+    "    }, false);",
+    "  }",
+    "  if (name === 'codebase_hotspots') {",
+    "    const raw = Number(args.n);",
+    "    const n = Math.max(1, Math.min(200, Number.isFinite(raw) && raw > 0 ? Math.floor(raw) : 20));",
+    "    const hotspots = Array.isArray(map.heatmap) ? map.heatmap.slice(0, n) : [];",
+    "    return toolResult({",
+    "      ok: true,",
+    "      repoRoot: map.repoRoot,",
+    "      repoHash: map.repoHash,",
+    "      n: n,",
+    "      hotspots: hotspots",
+    "    }, false);",
+    "  }",
+    "  return toolResult({ ok: false, error: 'unknown tool: ' + name }, true);",
+    "}",
+    "",
+    "function handleMessage(msg) {",
+    "  if (!msg || typeof msg !== 'object') return;",
+    "  const hasId = msg.id !== undefined && msg.id !== null;",
+    "  const method = typeof msg.method === 'string' ? msg.method : '';",
+    "  if (method === 'initialize') {",
+    "    if (hasId) reply(msg.id, {",
+    "      protocolVersion: (msg.params && msg.params.protocolVersion) || '2024-11-05',",
+    "      capabilities: { tools: {} },",
+    "      serverInfo: { name: 'swarm-codebase', version: '1.0.0' }",
+    "    });",
+    "    return;",
+    "  }",
+    "  if (method === 'ping') {",
+    "    if (hasId) reply(msg.id, {});",
+    "    return;",
+    "  }",
+    "  if (method === 'tools/list') {",
+    "    if (hasId) reply(msg.id, { tools: tools });",
+    "    return;",
+    "  }",
+    "  if (method === 'tools/call') {",
+    "    const params = msg.params && typeof msg.params === 'object' ? msg.params : {};",
+    "    const name = typeof params.name === 'string' ? params.name : '';",
+    "    const args = params.arguments && typeof params.arguments === 'object' ? params.arguments : {};",
+    "    if (hasId) reply(msg.id, callTool(name, args));",
+    "    return;",
+    "  }",
+    "  if (method === 'notifications/initialized' || method === 'notifications/cancelled') return;",
+    "  if (hasId) replyError(msg.id, -32601, 'Method not found: ' + method);",
+    "}",
+    "",
+    "process.stdin.setEncoding('utf8');",
+    "let buffer = '';",
+    "process.stdin.on('data', (chunk) => {",
+    "  buffer += chunk;",
+    "  let newline;",
+    "  while ((newline = buffer.indexOf('\\n')) !== -1) {",
+    "    const line = buffer.slice(0, newline).trim();",
+    "    buffer = buffer.slice(newline + 1);",
+    "    if (!line) continue;",
+    "    let msg;",
+    "    try { msg = JSON.parse(line); } catch (err) { continue; }",
+    "    handleMessage(msg);",
+    "  }",
+    "});",
+    "",
+  ].join("\n");
+}
diff --git a/apps/swarmagents/lib/harness/codebase-mcp.test.ts b/apps/swarmagents/lib/harness/codebase-mcp.test.ts
new file mode 100644
index 000000000..4f599c1cf
--- /dev/null
+++ b/apps/swarmagents/lib/harness/codebase-mcp.test.ts
@@ -0,0 +1,135 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { spawn } from "node:child_process";
+import crypto from "node:crypto";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { codebaseMcpServerSource } from "./codebase-mcp-source";
+
+interface Rpc {
+  jsonrpc: string;
+  id?: number;
+  result?: any;
+  error?: { code: number; message: string };
+}
+
+function repoHash(repoRoot: string): string {
+  return crypto.createHash("sha1").update(path.resolve(repoRoot)).digest("hex").slice(0, 16);
+}
+
+/** Run the MCP server against a fake map and answer the given requests. */
+async function ask(requests: unknown[], repoRoot: string): Promise<Rpc[]> {
+  const home = fs.mkdtempSync(path.join(os.tmpdir(), "swarm-mcp-"));
+  const mapDir = path.join(home, ".swarm", "codebase", repoHash(repoRoot));
+  fs.mkdirSync(mapDir, { recursive: true });
+  fs.writeFileSync(
+    path.join(mapDir, "map.json"),
+    JSON.stringify({
+      version: 1,
+      repoRoot,
+      repoName: "demo",
+      repoHash: repoHash(repoRoot),
+      generatedAt: new Date(0).toISOString(),
+      gitHead: "head-1",
+      buildMs: 12,
+      files: [],
+      languages: { TypeScript: 3 },
+      entryPoints: ["src/index.ts"],
+      buildCommands: ["npm run build"],
+      testCommands: ["npm test"],
+      conventions: { testFramework: "node:test" },
+      topLevelModules: [{ path: "src", kind: "dir", purpose: "Source", files: 3, bytes: 100 }],
+      contextPack: {
+        repoRoot,
+        repoName: "demo",
+        repoHash: repoHash(repoRoot),
+        generatedAt: new Date(0).toISOString(),
+        languages: { TypeScript: 3 },
+        entryPoints: ["src/index.ts"],
+        buildCommands: ["npm run build"],
+        testCommands: ["npm test"],
+        topLevelModules: [],
+        keyFiles: [{ path: "src/index.ts", fanIn: 3 }],
+        conventions: {},
+        tokenEstimate: 42,
+        text: "# Codebase context: demo",
+      },
+      heatmap: [
+        { path: "src/index.ts", churn90d: 10, bytes: 100, fanIn: 3, agentTouches: 1, heat: 0.9 },
+        { path: "src/other.ts", churn90d: 1, bytes: 50, fanIn: 0, agentTouches: 0, heat: 0.2 },
+      ],
+    }),
+  );
+
+  const serverPath = path.join(home, "codebase-server.mjs");
+  fs.writeFileSync(serverPath, codebaseMcpServerSource(), "utf8");
+
+  const child = spawn("node", [serverPath], {
+    env: { ...process.env, HOME: home, SWARM_CODEBASE_REPO_ROOT: repoRoot },
+    stdio: ["pipe", "pipe", "pipe"],
+  });
+
+  const replies: Rpc[] = [];
+  let buffer = "";
+  child.stdout.on("data", (chunk) => {
+    buffer += String(chunk);
+    let index: number;
+    while ((index = buffer.indexOf("\n")) !== -1) {
+      const line = buffer.slice(0, index).trim();
+      buffer = buffer.slice(index + 1);
+      if (!line) continue;
+      try {
+        replies.push(JSON.parse(line) as Rpc);
+      } catch {
+        // ignore noise
+      }
+    }
+  });
+
+  for (const request of requests) {
+    child.stdin.write(`${JSON.stringify(request)}\n`);
+  }
+  await new Promise((resolve) => setTimeout(resolve, 400));
+  child.kill();
+  fs.rmSync(home, { recursive: true, force: true });
+  return replies;
+}
+
+test("the codebase MCP server lists its two tools", async () => {
+  const replies = await ask(
+    [
+      { jsonrpc: "2.0", id: 1, method: "initialize", params: {} },
+      { jsonrpc: "2.0", id: 2, method: "tools/list", params: {} },
+    ],
+    "/workspace/demo",
+  );
+  const list = replies.find((reply) => reply.id === 2);
+  const names = (list?.result?.tools ?? []).map((tool: { name: string }) => tool.name);
+  assert.deepEqual(names, ["codebase_map_get", "codebase_hotspots"]);
+});
+
+test("codebase_map_get returns the context pack", async () => {
+  const replies = await ask(
+    [{ jsonrpc: "2.0", id: 7, method: "tools/call", params: { name: "codebase_map_get", arguments: {} } }],
+    "/workspace/demo",
+  );
+  const reply = replies.find((item) => item.id === 7);
+  const payload = JSON.parse(reply?.result?.content?.[0]?.text ?? "{}");
+  assert.equal(payload.ok, true);
+  assert.equal(payload.repoName, "demo");
+  assert.match(payload.contextPack, /# Codebase context: demo/);
+  assert.deepEqual(payload.keyFiles, [{ path: "src/index.ts", fanIn: 3 }]);
+});
+
+test("codebase_hotspots returns the hottest files", async () => {
+  const replies = await ask(
+    [{ jsonrpc: "2.0", id: 8, method: "tools/call", params: { name: "codebase_hotspots", arguments: { n: 1 } } }],
+    "/workspace/demo",
+  );
+  const reply = replies.find((item) => item.id === 8);
+  const payload = JSON.parse(reply?.result?.content?.[0]?.text ?? "{}");
+  assert.equal(payload.ok, true);
+  assert.equal(payload.hotspots.length, 1);
+  assert.equal(payload.hotspots[0].path, "src/index.ts");
+});
