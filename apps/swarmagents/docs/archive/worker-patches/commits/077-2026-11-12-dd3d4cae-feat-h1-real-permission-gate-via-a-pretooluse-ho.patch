+test("appends --settings and --permission-mode acceptEdits when a hook settings path is set", async () => {
+  const vm = new ScriptedVm([{ chunks: [FIXTURE] }]);
+  const runner = new ClaudeCodeRunner({ bin: "claude" });
+  const events: TelemetryEvent[] = [];
+
+  const outcome = await runner.run(
+    { prompt: "Hi", env: envWithSecrets, vm, hookSettingsPath: "/tmp/swarm-hook-settings.json" },
+    (e) => events.push(e),
+  );
+
+  assert.equal(outcome.exitCode, 0);
+  const cmd = vm.calls[0].cmd;
+  const settingsIdx = cmd.indexOf("--settings");
+  assert.ok(settingsIdx !== -1, "argv should include --settings");
+  assert.equal(cmd[settingsIdx + 1], "/tmp/swarm-hook-settings.json");
+  const modeIdx = cmd.indexOf("--permission-mode");
+  assert.ok(modeIdx !== -1, "argv should include --permission-mode");
+  assert.equal(cmd[modeIdx + 1], "acceptEdits");
+});
+
+test("ask-classified Bash does not execute before approval; executes after approve", async () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "swarm-approvals-run-"));
+  const id = "appr_gatetest";
+  const M_ASK = {
+    type: "assistant",
+    message: {
+      id: "m_ask",
+      content: [{ type: "tool_use", id: "toolu_ask", name: "Bash", input: { command: "rm -rf /" } }],
+    },
+  };
+  const T_ASK = {
+    type: "user",
+    message: {
+      role: "user",
+      content: [{ type: "tool_result", tool_use_id: "toolu_ask", content: "removed", is_error: false }],
+    },
+  };
+  const lines = [INIT, M_ASK, T_ASK, RESULT];
+
+  // Emulate claude honoring the PreToolUse hook: the tool's result is not
+  // streamed until the approval decision file appears.
+  class HookBlockingVm implements VmExec {
+    calls: Array<{ cmd: string[] }> = [];
+    async exec(cmd: string[], opts?: VmExecOpts): Promise<{ exitCode: number }> {
+      this.calls.push({ cmd });
+      for (const line of lines) {
+        if (line === T_ASK) {
+          const verdict = await pollApprovalDecision(id, dir, 3000);
+          assert.notEqual(verdict, "expired", "expected an approval decision before execution");
+        }
+        opts?.onStdout?.(JSON.stringify(line) + "\n");
+      }
+      return { exitCode: 0 };
+    }
+  }
+
+  const store = new ApprovalStore();
+  const gateway: ApprovalGateway = async (ask) => {
+    const approval = store.create({
+      runId: "r1",
+      userId: "u1",
+      toolName: ask.toolName,
+      action: ask.action,
+      reason: ask.reason,
+      id,
+    });
+    // Simulate the user approving shortly after the request appears.
+    setTimeout(() => {
+      store.resolve(id, "approved");
+      fs.writeFileSync(path.join(dir, decisionFileName(id, true)), "approved");
+    }, 60);
+    return {
+      id: approval.id,
+      expiresAt: approval.expiresAt,
+      timedOut: () => store.get(id)?.timedOut === true,
+      verdict: store.waitFor(id),
+    };
+  };
+
+  const vm = new HookBlockingVm();
+  const runner = new ClaudeCodeRunner({ bin: "claude" });
+  const events: TelemetryEvent[] = [];
+  try {
+    const outcome = await runner.run(
+      { prompt: "Do the risky thing", env: envWithSecrets, vm, approvalGateway: gateway },
+      (e) => events.push(e),
+    );
+
+    assert.equal(outcome.exitCode, 0);
+    const kinds = events.map((e) => e.type);
+    assert.ok(kinds.includes("approval.required"), "expected approval.required");
+    assert.ok(kinds.includes("approval.resolved"), "expected approval.resolved");
+    assert.ok(kinds.includes("tool.result"), "expected tool.result");
+    const resolvedIdx = kinds.indexOf("approval.resolved");
+    const resultIdx = kinds.indexOf("tool.result");
+    assert.ok(resolvedIdx !== -1 && resultIdx !== -1 && resolvedIdx < resultIdx, "tool.result must come after approval resolves");
+  } finally {
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+});
