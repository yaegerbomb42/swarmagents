+++ b/apps/swarmagents/lib/harness/permission-hook.test.ts
@@ -0,0 +1,109 @@
+/**
+ * Tests for the permission-gate hook (h1): settings generation, the generated
+ * classifier bundle (which must agree with risk.ts), the deterministic approval
+ * id shared with the VM-side shell hook, and the decision-file poll protocol.
+ */
+import test from "node:test";
+import assert from "node:assert/strict";
+import { execFileSync } from "node:child_process";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import {
+  APPROVAL_DIR,
+  CLASSIFIER_PATH,
+  decisionFileName,
+  hookApprovalId,
+  HOOK_SCRIPT,
+  HOOK_SETTINGS_PATH,
+  permissionHookSettingsJson,
+  pollApprovalDecision,
+} from "./permission-hook.js";
+import { classifyToolCall } from "./risk.js";
+import { generateClassifier } from "./permission-hook.js";
+
+test("permissionHookSettingsJson registers the PreToolUse hook", () => {
+  const settings = JSON.parse(permissionHookSettingsJson());
+  const hooks = settings.hooks?.PreToolUse;
+  assert.ok(Array.isArray(hooks) && hooks.length === 1, "expected one PreToolUse hook");
+  assert.equal(hooks[0].matcher, "*");
+  assert.ok(hooks[0].hook.includes(HOOK_SCRIPT), "hook command must reference the script");
+  assert.deepEqual(settings.permissions, { allow: [], deny: [], ask: [] });
+});
+
+test("generated classifier agrees with risk.ts for representative calls", () => {
+  const classifierPath = path.join(os.tmpdir(), `swarm-classify-${process.pid}.cjs`);
+  fs.writeFileSync(classifierPath, generateClassifier());
+  try {
+    const cases: Array<[string, unknown]> = [
+      ["Bash", { command: "ls -la" }],
+      ["Bash", { command: "rm -rf /" }],
+      ["Bash", { command: "echo $OPENAI_API_KEY" }],
+      ["Edit", { file_path: "/etc/shadow" }],
+      ["Read", { file_path: "package.json" }],
+      ["WebFetch", { url: "http://10.0.0.5/steal" }],
+    ];
+    for (const [tool, input] of cases) {
+      const raw = execFileSync("node", [classifierPath, tool, JSON.stringify(input)], { encoding: "utf8" }).trim();
+      const decision = JSON.parse(raw);
+      const expected = classifyToolCall(tool, input);
+      assert.equal(decision.level, expected.level, `${tool} level mismatch for ${JSON.stringify(input)}`);
+      assert.equal(decision.reason, expected.reason, `${tool} reason mismatch`);
+    }
+  } finally {
+    fs.rmSync(classifierPath, { force: true });
+  }
+});
+
+test("hookApprovalId is deterministic, canonical, and matches the shared format", () => {
+  const inputA = { command: "rm -rf /", cwd: "/workspace" };
+  const inputB = { cwd: "/workspace", command: "rm -rf /" }; // different key order
+  const a = hookApprovalId("Bash", inputA);
+  const b = hookApprovalId("Bash", inputB);
+  assert.equal(a, b, "id must not depend on key order");
+  assert.ok(a.startsWith("appr_"), "id must be prefixed appr_");
+  assert.match(a.slice("appr_".length), /^[0-9a-f]{24}$/, "id must be 24 hex chars");
+  assert.notEqual(hookApprovalId("Bash", inputA), hookApprovalId("Edit", inputA));
+});
+
+test("decisionFileName encodes approve/deny", () => {
+  assert.equal(decisionFileName("appr_x", true), "appr_x.ok");
+  assert.equal(decisionFileName("appr_x", false), "appr_x.no");
+});
+
+test("pollApprovalDecision resolves on .ok, .no, and expiry", async () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "swarm-approvals-"));
+  const id = "appr_test123";
+  try {
+    // Approved.
+    fs.writeFileSync(path.join(dir, decisionFileName(id, true)), "approved");
+    assert.equal(await pollApprovalDecision(id, dir, 2000), "approved");
+    fs.rmSync(path.join(dir, decisionFileName(id, true)));
+
+    // Denied.
+    fs.writeFileSync(path.join(dir, decisionFileName(id, false)), "denied");
+    assert.equal(await pollApprovalDecision(id, dir, 2000), "denied");
+    fs.rmSync(path.join(dir, decisionFileName(id, false)));
+
+    // File written after a short delay is still observed.
+    setTimeout(() => fs.writeFileSync(path.join(dir, decisionFileName(id, true)), "approved"), 40);
+    assert.equal(await pollApprovalDecision(id, dir, 2000), "approved");
+  } finally {
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+test("pollApprovalDecision expires when nothing is written", async () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "swarm-approvals-exp-"));
+  try {
+    assert.equal(await pollApprovalDecision("appr_expired", dir, 60), "expired");
+  } finally {
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+test("exposes the VM paths the hook and runtime share", () => {
+  assert.equal(APPROVAL_DIR, "/tmp/swarm-approvals");
+  assert.equal(HOOK_SETTINGS_PATH, "/tmp/swarm-hook-settings.json");
+  assert.equal(CLASSIFIER_PATH, "/tmp/swarm-classify.cjs");
+});
diff --git a/apps/swarmagents/lib/harness/permission-hook.ts b/apps/swarmagents/lib/harness/permission-hook.ts
new file mode 100644
index 000000000..4e6961634
--- /dev/null
+++ b/apps/swarmagents/lib/harness/permission-hook.ts
@@ -0,0 +1,178 @@
+/**
+ * Permission-gate hook support (h1).
+ *
+ * The harness's post-hoc approval observer (runner.ts) cannot stop a risky
+ * tool from executing: by the time stream-json reports a `tool_use` block,
+ * Claude has already run the tool. This module supplies a real
+ * PreToolUse hook that runs inside claude in the user's VM and blocks "ask"
+ * and "deny" calls BEFORE they execute.
+ *
+ * The hook is a shell script (`vm-image/swarm-pretooluse.sh`) installed in
+ * the VM image at `HOOK_SCRIPT`. It classifies every call with the exact
+ * same rules as risk.ts by invoking a standalone classifier bundle this
+ * module generates with esbuild and writes into the VM before a run:
+ *
+ *   - "allow" continues (exit 0, decision allow);
+ *   - "deny" blocks the call (exit code 2, decision block, reason);
+ *   - "ask" writes `<id>.req` into `APPROVAL_DIR` and blocks until
+ *     `<id>.ok` / `<id>.no` appears. The runtime writes the decision file
+ *     (via the VM file API) when the user decides on
+ *     `POST /api/runtime/approvals/{id}`; expiry counts as a denial.
+ *
+ * `hookApprovalId` derives a deterministic id from the tool name + canonical
+ * input so the harness and the shell hook agree on the file name without any
+ * out-of-band handshake.
+ */
+
+import { createHash } from "node:crypto";
+import fs from "node:fs/promises";
+import path from "node:path";
+import * as esbuild from "esbuild";
+import { classifyToolCall, type RiskDecision } from "./risk";
+
+/** Directory (inside the VM) where approval request/decision files live. */
+export const APPROVAL_DIR = "/tmp/swarm-approvals";
+/** Path (inside the VM) of the --settings file that registers the hook. */
+export const HOOK_SETTINGS_PATH = "/tmp/swarm-hook-settings.json";
+/** Path (inside the VM image) of the hook shell script. */
+export const HOOK_SCRIPT = "/opt/swarm-hooks/swarm-pretooluse.sh";
+/** Path (inside the VM) where the generated classifier bundle is written. */
+export const CLASSIFIER_PATH = "/tmp/swarm-classify.cjs";
+/** claude permission mode: edits run headless; everything else goes through the hook. */
+export const PERMISSION_MODE = "acceptEdits";
+
+export const DEFAULT_APPROVAL_TTL_MS = 5 * 60 * 1000;
+
+/** Approval TTL in ms (env-overridable, matching the approvals store). */
+export function approvalTtlMs(): number {
+  const sec = Number(process.env.SWARM_APPROVAL_TIMEOUT_SEC);
+  if (Number.isFinite(sec) && sec > 0) return sec * 1000;
+  const ms = Number(process.env.SWARM_APPROVAL_TIMEOUT_MS);
+  if (Number.isFinite(ms) && ms > 0) return ms;
+  return DEFAULT_APPROVAL_TTL_MS;
+}
+
+/** The `--settings` JSON that registers the PreToolUse hook for every tool. */
+export function permissionHookSettingsJson(): string {
+  return JSON.stringify(
+    {
+      hooks: {
+        PreToolUse: [{ matcher: "*", hook: `bash ${HOOK_SCRIPT}` }],
+      },
+      permissions: { allow: [], deny: [], ask: [] },
+    },
+    null,
+    2,
+  );
+}
+
+/** Recursively sort object keys so JSON.stringify yields a canonical form. */
+function canonicalize(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(canonicalize);
+  if (value !== null && typeof value === "object") {
+    const out: Record<string, unknown> = {};
+    for (const key of Object.keys(value as Record<string, unknown>).sort()) {
+      out[key] = canonicalize((value as Record<string, unknown>)[key]);
+    }
+    return out;
+  }
+  return value;
+}
+
+/**
+ * Deterministic approval id shared with the VM-side shell hook. The hook
+ * canonicalizes `.tool_input` with `jq -S -c` and hashes `tool::canonical`
+ * with sha1 (first 24 hex chars) — this must produce the identical string.
+ */
+export function hookApprovalId(toolName: string, input: unknown): string {
+  const canon = JSON.stringify(canonicalize(input ?? {}));
+  const digest = createHash("sha1").update(`${toolName}::${canon}`).digest("hex");
+  return `appr_${digest.slice(0, 24)}`;
+}
+
+/** File name for a decision: `<id>.ok` or `<id>.no`. */
+export function decisionFileName(id: string, approve: boolean): string {
+  return `${id}${approve ? ".ok" : ".no"}`;
+}
+
+/**
+ * Wait (bounded by the approval TTL) for a decision file to appear in `dir`.
+ * Used by tests and by callers that need to block until the runtime writes the
+ * decision; returns the verdict.
+ */
+export async function pollApprovalDecision(
+  id: string,
+  dir = APPROVAL_DIR,
+  timeoutMs = approvalTtlMs(),
+): Promise<"approved" | "denied" | "expired"> {
+  const okPath = path.join(dir, decisionFileName(id, true));
+  const noPath = path.join(dir, decisionFileName(id, false));
+  const deadline = Date.now() + timeoutMs;
+  for (;;) {
+    try {
+      await fs.access(okPath);
+      return "approved";
+    } catch {
+      /* not yet */
+    }
+    try {
+      await fs.access(noPath);
+      return "denied";
+    } catch {
+      /* not yet */
+    }
+    if (Date.now() >= deadline) return "expired";
+    await new Promise((resolve) => setTimeout(resolve, 25));
+  }
+}
+
+/**
+ * A self-contained classifier whose decision logic comes straight from risk.ts.
+ * Bundled once (cached) so the VM-side hook and the harness can never drift.
+ */
+let classifierCache: string | undefined;
+export function generateClassifier(): string {
+  if (classifierCache !== undefined) return classifierCache;
+  const source = `
+import { classifyToolCall } from "./risk";
+const tool = process.argv[2] ?? "";
+const raw = process.argv[3] ?? "{}";
+let input: unknown;
+try { input = JSON.parse(raw); } catch { input = raw; }
+const d = classifyToolCall(tool, input);
+process.stdout.write(JSON.stringify(d));
+`;
+  const result = esbuild.buildSync({
+    stdin: {
+      contents: source,
+      resolveDir: __dirname,
+      sourcefile: "swarm-classify.ts",
+      loader: "ts",
+    },
+    bundle: true,
+    platform: "node",
+    format: "cjs",
+    write: false,
+    logLevel: "silent",
+  });
+  classifierCache = result.outputFiles[0]?.text ?? "";
+  return classifierCache;
+}
+
+export interface HookFile {
+  path: string;
+  content: string;
+}
+
+/** Files the runtime writes into the VM (settings + classifier) before a run. */
+export function permissionHookFiles(): HookFile[] {
+  return [
+    { path: HOOK_SETTINGS_PATH, content: permissionHookSettingsJson() },
+    { path: CLASSIFIER_PATH, content: generateClassifier() },
+  ];
+}
+
+/** Convenience classification that mirrors what the hook evaluates. */
+export function classifyHookCall(name: string, input: unknown): RiskDecision {
+  return classifyToolCall(name, input);
+}
