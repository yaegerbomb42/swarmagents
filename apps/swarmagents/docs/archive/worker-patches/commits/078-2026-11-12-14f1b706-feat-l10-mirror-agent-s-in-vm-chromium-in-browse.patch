diff --git a/apps/swarmagents/lib/browser/cdp-endpoint.test.ts b/apps/swarmagents/lib/browser/cdp-endpoint.test.ts
new file mode 100644
index 000000000..68c7f5f98
--- /dev/null
+++ b/apps/swarmagents/lib/browser/cdp-endpoint.test.ts
@@ -0,0 +1,115 @@
+/**
+ * Unit tests for CDP endpoint resolution (lib/browser/cdp-endpoint.ts).
+ *
+ * The resolver is pure given its injected VM callbacks: no Docker, no
+ * Chromium, no network. Covers the resolution matrix (host forced /
+ * desktop off / no display / forwarder failure / success) and the
+ * socat forwarder argv (idempotent, detached, binds the VM IP, rejects
+ * a hostile host).
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  CDP_FORWARD_PORT,
+  CDP_PORT_IN_VM,
+  IN_VM_BROWSER_MESSAGE,
+  buildForwarderArgv,
+  isHostBrowserForced,
+  resolveCdpEndpoint,
+  type CdpEndpointDeps,
+} from "./cdp-endpoint";
+
+function deps(overrides: Partial<CdpEndpointDeps> = {}): CdpEndpointDeps & {
+  execCalls: Array<{ userId: string; argv: string[] }>;
+} {
+  const execCalls: Array<{ userId: string; argv: string[] }> = [];
+  return {
+    desktopMode: true,
+    hostBrowserForced: false,
+    getDesktopEndpoint: async () => ({ host: "172.18.0.4", port: 6080, password: "secret" }),
+    execInVm: async (userId, argv) => {
+      execCalls.push({ userId, argv });
+      return { exitCode: 0 };
+    },
+    execCalls,
+    ...overrides,
+  };
+}
+
+test("resolves http://<vm-ip>:9223 and starts the socat forwarder on demand", async () => {
+  const d = deps();
+  const res = await resolveCdpEndpoint("alice", d);
+  assert.equal(res.ok, true);
+  if (res.ok) {
+    assert.equal(res.endpoint.url, "http://172.18.0.4:9223");
+    assert.equal(res.endpoint.vmHost, "172.18.0.4");
+    assert.equal(res.endpoint.port, CDP_FORWARD_PORT);
+  }
+  assert.equal(d.execCalls.length, 1);
+  assert.equal(d.execCalls[0]?.userId, "alice");
+  const script = d.execCalls[0]?.argv.join(" ") ?? "";
+  assert.match(script, /socat TCP-LISTEN:9223,bind=172\.18\.0\.4,fork,reuseaddr TCP:127\.0\.0\.1:9222/);
+  // Idempotent: an already-running forwarder is left alone (pgrep guard).
+  assert.match(script, /pgrep -f 'socat TCP-LISTEN:922\[3\]'/);
+});
+
+test("host browser forced (SWARM_BROWSER_HOST=1) resolves to no endpoint without touching the VM", async () => {
+  const d = deps({ hostBrowserForced: true });
+  const res = await resolveCdpEndpoint("alice", d);
+  assert.equal(res.ok, false);
+  if (!res.ok) assert.match(res.reason, /host browser forced/);
+  assert.equal(d.execCalls.length, 0);
+});
+
+test("desktop mode off resolves to no endpoint without touching the VM", async () => {
+  const d = deps({ desktopMode: false });
+  const res = await resolveCdpEndpoint("alice", d);
+  assert.equal(res.ok, false);
+  if (!res.ok) assert.match(res.reason, /desktop mode is off/);
+  assert.equal(d.execCalls.length, 0);
+});
+
+test("fake driver fallback: no display endpoint resolves to no endpoint", async () => {
+  const d = deps({ getDesktopEndpoint: async () => null });
+  const res = await resolveCdpEndpoint("alice", d);
+  assert.equal(res.ok, false);
+  if (!res.ok) assert.match(res.reason, /no display/);
+  assert.equal(d.execCalls.length, 0);
+});
+
+test("forwarder start failure (e.g. socat missing from the image) resolves to no endpoint", async () => {
+  const d = deps({ execInVm: async () => ({ exitCode: 3 }) });
+  const res = await resolveCdpEndpoint("alice", d);
+  assert.equal(res.ok, false);
+  if (!res.ok) assert.match(res.reason, /could not start CDP forwarder \(exit 3\)/);
+});
+
+test("a throwing desktop-endpoint lookup resolves to no endpoint", async () => {
+  const d = deps({
+    getDesktopEndpoint: async () => {
+      throw new Error("container gone");
+    },
+  });
+  const res = await resolveCdpEndpoint("alice", d);
+  assert.equal(res.ok, false);
+  if (!res.ok) assert.match(res.reason, /could not read desktop endpoint: container gone/);
+});
+
+test("forwarder argv rejects a hostile VM host (no shell injection)", () => {
+  assert.throws(() => buildForwarderArgv("1.2.3.4; rm -rf /"), /Invalid VM host/);
+  assert.throws(() => buildForwarderArgv("$(id)"), /Invalid VM host/);
+  assert.throws(() => buildForwarderArgv(""), /Invalid VM host/);
+  // IPv6 loopback-adjacent literals are fine.
+  const argv = buildForwarderArgv("fd00::4");
+  assert.match(argv.join(" "), /bind=fd00::4/);
+});
+
+test("constants: in-VM CDP port, forwarder port, and the user-facing message", () => {
+  assert.equal(CDP_PORT_IN_VM, 9222);
+  assert.equal(CDP_FORWARD_PORT, 9223);
+  assert.equal(IN_VM_BROWSER_MESSAGE, "Browser runs inside your computer — open the Screen tab");
+  assert.equal(isHostBrowserForced({ SWARM_BROWSER_HOST: "1" }), true);
+  assert.equal(isHostBrowserForced({ SWARM_BROWSER_HOST: "0" }), false);
+  assert.equal(isHostBrowserForced({}), false);
+});
diff --git a/apps/swarmagents/lib/browser/cdp-endpoint.ts b/apps/swarmagents/lib/browser/cdp-endpoint.ts
new file mode 100644
index 000000000..3120c1442
--- /dev/null
+++ b/apps/swarmagents/lib/browser/cdp-endpoint.ts
@@ -0,0 +1,154 @@
+/**
+ * CDP endpoint resolution for the Browser tab mirror (task l10).
+ *
+ * When the agent runs in desktop mode it drives the VM's own Chromium (on
+ * the desktop display, via the computer-use / Playwright MCP servers), so
+ * the Browser tab must show *that* page instead of a separate host-side
+ * headless Chromium. The VM's Chromium listens for DevTools connections on
+ * 127.0.0.1:9222 *inside* the VM; the host reaches it through a socat
+ * forwarder started on demand inside the VM (vm.exec) that binds the VM's
+ * own network IP at port 9223 and forwards to 127.0.0.1:9222. Playwright
+ * then attaches with `chromium.connectOverCDP("http://<vm-ip>:9223")`.
+ *
+ * Ownership: the forwarder binds the per-user VM network IP (never
+ * 0.0.0.0), and resolution is always for one authenticated user — the
+ * run's owner — via that user's own desktop endpoint, so one user can only
+ * ever resolve (and attach to) their own VM's Chromium. This is the same
+ * per-user-endpoint shape the display proxy uses; there is no shared
+ * forwarder and no cross-user endpoint.
+ *
+ * What is NOT here yet (dependency gaps, stated in the task): l3's display
+ * proxy does not exist in this tree, the desktop image does not install
+ * socat, and `chromium-launch.sh` does not pass `--remote-debugging-port`.
+ * Until those land, `resolveCdpEndpoint` degrades to "VM has no display" /
+ * "could not start CDP forwarder" and the manager reports the browser as
+ * running inside the user's computer (see IN_VM_BROWSER_MESSAGE) instead
+ * of launching a host Chromium that is not the agent's browser.
+ *
+ * This module is dependency-free (only type imports and lib/vm/desktop, so
+ * the BrowserView client can import IN_VM_BROWSER_MESSAGE from here) and
+ * takes its VM access as injected callbacks so the resolution logic is
+ * unit-testable without Docker.
+ */
+
+import { isDesktopModeEnabled } from "../vm/desktop";
+import type { VmDesktopEndpoint } from "../vm/types";
+
+/** DevTools port the VM's Chromium listens on (inside the VM). */
+export const CDP_PORT_IN_VM = 9222;
+/** Port the on-demand socat forwarder exposes on the VM network IP. */
+export const CDP_FORWARD_PORT = 9223;
+/** Env var forcing the legacy host-launch browser (dev escape hatch). */
+export const SWARM_BROWSER_HOST_ENV = "SWARM_BROWSER_HOST";
+
+/**
+ * Shown in the Browser tab when the browser runs inside the user's computer
+ * and cannot be mirrored (no display / no CDP endpoint): the user watches
+ * it on the Screen tab instead.
+ */
+export const IN_VM_BROWSER_MESSAGE = "Browser runs inside your computer — open the Screen tab";
+
+/** A resolved CDP endpoint for one user's VM. */
+export interface CdpEndpoint {
+  /** `http://<vm-ip>:9223` — the URL `chromium.connectOverCDP` attaches to. */
+  url: string;
+  /** The VM's network IP the forwarder is bound to. */
+  vmHost: string;
+  /** The forwarder port (CDP_FORWARD_PORT). */
+  port: number;
+}
+
+export type CdpResolution =
+  | { ok: true; endpoint: CdpEndpoint }
+  | { ok: false; reason: string };
+
+/** The VM access the resolver needs; injected so tests can stub Docker. */
+export interface CdpEndpointDeps {
+  /** Desktop mode on (SWARM_VM_DESKTOP=1). Read per call so env changes apply. */
+  desktopMode: boolean;
+  /** SWARM_BROWSER_HOST=1 forces the legacy host-launch browser. */
+  hostBrowserForced: boolean;
+  /** The user's desktop (display) endpoint, or null when the VM has no display. */
+  getDesktopEndpoint: (userId: string) => Promise<VmDesktopEndpoint | null>;
+  /** Run an argv command inside the user's VM (vm.exec). */
+  execInVm: (userId: string, argv: string[]) => Promise<{ exitCode: number }>;
+}
+
+/** True when SWARM_BROWSER_HOST=1 (legacy host-launch escape hatch). */
+export function isHostBrowserForced(env: Record<string, string | undefined> = process.env): boolean {
+  return env[SWARM_BROWSER_HOST_ENV] === "1";
+}
+
+/** Resolve the CDP endpoint for a user from the live environment. */
+export function liveCdpEndpointDeps(deps: {
+  getDesktopEndpoint: (userId: string) => Promise<VmDesktopEndpoint | null>;
+  execInVm: (userId: string, argv: string[]) => Promise<{ exitCode: number }>;
+}): CdpEndpointDeps {
+  return {
+    desktopMode: isDesktopModeEnabled(),
+    hostBrowserForced: isHostBrowserForced(),
+    getDesktopEndpoint: deps.getDesktopEndpoint,
+    execInVm: deps.execInVm,
+  };
+}
+
+/** The socat argv that forwards <vmHost>:9223 to 127.0.0.1:9222 in the VM. */
+export function buildForwarderArgv(vmHost: string): string[] {
+  if (!/^[0-9a-fA-F.:]+$/.test(vmHost) || vmHost.length === 0 || vmHost.length > 45) {
+    throw new Error(`Invalid VM host for CDP forwarder: ${JSON.stringify(vmHost)}`);
+  }
+  // Idempotent and detached: if a forwarder is already listening, do
+  // nothing; otherwise start one in the background and return at once.
+  // `command -v socat` fails the exec when socat is not installed in the
+  // image (exit 3) instead of silently launching a dead background job.
+  // The pgrep pattern spells the port as 922[3] so it cannot match this
+  // very `sh -c` command line (which contains the bracketed form, not
+  // the literal port).
+  const script =
+    `pgrep -f 'socat TCP-LISTEN:922[3]' >/dev/null 2>&1 || { ` +
+    `command -v socat >/dev/null 2>&1 || exit 3; ` +
+    `nohup socat TCP-LISTEN:${CDP_FORWARD_PORT},bind=${vmHost},fork,reuseaddr TCP:127.0.0.1:${CDP_PORT_IN_VM} >/dev/null 2>&1 & }`;
+  return ["sh", "-c", script];
+}
+
+/**
+ * Resolve the CDP endpoint for one user's VM, starting the socat forwarder
+ * on demand. Returns `{ok:false}` (with a reason) when there is nothing to
+ * mirror: host browser forced, desktop mode off, no display, or the
+ * forwarder could not be started. Never throws for an expected miss — only
+ * for a bad caller argument.
+ */
+export async function resolveCdpEndpoint(userId: string, deps: CdpEndpointDeps): Promise<CdpResolution> {
+  if (deps.hostBrowserForced) return { ok: false, reason: "host browser forced (SWARM_BROWSER_HOST=1)" };
+  if (!deps.desktopMode) return { ok: false, reason: "desktop mode is off" };
+
+  let desktop: VmDesktopEndpoint | null;
+  try {
+    desktop = await deps.getDesktopEndpoint(userId);
+  } catch (error) {
+    return { ok: false, reason: `could not read desktop endpoint: ${error instanceof Error ? error.message : String(error)}` };
+  }
+  if (!desktop) return { ok: false, reason: "VM has no display" };
+
+  let argv: string[];
+  try {
+    argv = buildForwarderArgv(desktop.host);
+  } catch (error) {
+    return { ok: false, reason: error instanceof Error ? error.message : String(error) };
+  }
+
+  let started: { exitCode: number };
+  try {
+    started = await deps.execInVm(userId, argv);
+  } catch (error) {
+    return { ok: false, reason: `could not start CDP forwarder: ${error instanceof Error ? error.message : String(error)}` };
+  }
+  if (started.exitCode !== 0) {
+    return { ok: false, reason: `could not start CDP forwarder (exit ${started.exitCode})` };
+  }
+
+  return {
+    ok: true,
+    endpoint: { url: `http://${desktop.host}:${CDP_FORWARD_PORT}`, vmHost: desktop.host, port: CDP_FORWARD_PORT },
+  };
+}
