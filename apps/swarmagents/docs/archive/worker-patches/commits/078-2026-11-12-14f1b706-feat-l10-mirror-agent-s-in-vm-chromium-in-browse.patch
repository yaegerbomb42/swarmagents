-import { BrowserManager, MAX_FPS } from "./manager";
+import type { Browser, BrowserContext, Page } from "playwright-core";
+import { BrowserManager, MAX_FPS, type CdpConnector } from "./manager";
+import { IN_VM_BROWSER_MESSAGE, type CdpResolution } from "./cdp-endpoint";
 import { telemetryBus } from "../telemetry/index";
 
 const JPEG = Buffer.from("fake-jpeg-bytes");
@@ -320,3 +321,278 @@ test("close tears the session down and drops the cache", async () => {
   await manager.close(RUN);
   assert.equal(closed, 1);
 });
+
+// --- CDP mirror mode (task l10) ---------------------------------------------
+
+interface FakeCdpPageState {
+  url: string;
+  title: string;
+  gotoCalls: string[];
+  screenshotCalls: number;
+}
+
+function fakeCdpPage(initial: Partial<FakeCdpPageState> = {}) {
+  const state: FakeCdpPageState = {
+    url: initial.url ?? "about:blank",
+    title: initial.title ?? "Agent Page",
+    gotoCalls: [],
+    screenshotCalls: 0,
+  };
+  const listeners = new Map<string, Array<(arg?: unknown) => void>>();
+  const mainFrame = { __mainFrame: true };
+  const page = {
+    url: () => state.url,
+    title: async () => state.title,
+    goto: async (target: string) => {
+      state.gotoCalls.push(target);
+      state.url = target;
+      return null;
+    },
+    screenshot: async () => {
+      state.screenshotCalls += 1;
+      return JPEG;
+    },
+    viewportSize: () => ({ width: 1280, height: 800 }),
+    mainFrame: () => mainFrame,
+    on: (event: string, fn: (arg?: unknown) => void) => {
+      const list = listeners.get(event) ?? [];
+      list.push(fn);
+      listeners.set(event, list);
+    },
+    off: (event: string, fn: (arg?: unknown) => void) => {
+      listeners.set(event, (listeners.get(event) ?? []).filter((f) => f !== fn));
+    },
+    route: () => {},
+  } as unknown as Page;
+  const emit = (event: string, arg?: unknown) => {
+    for (const fn of [...(listeners.get(event) ?? [])]) fn(arg);
+  };
+  return { page, state, mainFrame, emit };
+}
+
+function fakeCdpContext(page: Page) {
+  const state = { closeCalls: 0, newPageCalls: 0 };
+  const listeners = new Map<string, Array<(arg?: unknown) => void>>();
+  const context = {
+    close: async () => {
+      state.closeCalls += 1;
+    },
+    newPage: async () => {
+      state.newPageCalls += 1;
+      return page;
+    },
+    pages: () => [page],
+    on: (event: string, fn: (arg?: unknown) => void) => {
+      const list = listeners.get(event) ?? [];
+      list.push(fn);
+      listeners.set(event, list);
+    },
+    off: (event: string, fn: (arg?: unknown) => void) => {
+      listeners.set(event, (listeners.get(event) ?? []).filter((f) => f !== fn));
+    },
+  } as unknown as BrowserContext;
+  const emit = (event: string, arg?: unknown) => {
+    for (const fn of [...(listeners.get(event) ?? [])]) fn(arg);
+  };
+  return { context, state, emit };
+}
+
+function fakeCdpBrowser(context: BrowserContext) {
+  const state = { closeCalls: 0 };
+  const browser = {
+    contexts: () => [context],
+    close: async () => {
+      state.closeCalls += 1;
