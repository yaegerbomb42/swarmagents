+// Library item types — the shapes the Library UI is built against.
+//
+// These mirror the l1 (Library foundation) API contract:
+//   REST /api/library/{mcp,skills,tools} list/create/update/delete/enable,
+//   owner-only, zod-validated. l1 has NOT merged yet, so the UI talks to
+//   these types through the client in ./client.ts, which ships a clearly
+//   marked stub adapter (`USE_STUB`) until the real API lands. When l1
+//   lands, flip the flag — components never touch fetch directly.
+//
+// HARD RULES (from the l2 task; l1 owns the server side):
+// - Everything is per account. MCP servers / tools / skills execute INSIDE
+//   the user's VM, never on the host or in the Next.js process.
+// - Secrets are encrypted at rest like provider keys and are NEVER returned
+//   to the client unmasked or logged. The API returns masked placeholders
+//   (e.g. "••••••••") for secret values; the client only ever sends a new
+//   value the user typed, never echoes one back.
+// - A role (and the agent) can never get more than the user's settings
+//   allow: `roles` on an item only grants it to roles the user picked.
+
+/** Where an item came from. Shown as a badge on every card. */
+export type LibrarySource =
+  | "builtin"
+  | "catalog"
+  | "custom"
+  | "agent"
+  | "public";
+
+/** The four Library tabs. */
+export type LibraryKind = "connectors" | "mcp" | "skills" | "tools";
+
+export const LIBRARY_KINDS: readonly LibraryKind[] = [
+  "connectors",
+  "mcp",
+  "skills",
+  "tools",
+];
+
+export const LIBRARY_KIND_LABELS: Record<LibraryKind, string> = {
+  connectors: "Connectors",
+  mcp: "MCP Servers",
+  skills: "Skills",
+  tools: "Tools",
+};
+
+/** A secret value as the API returns it: masked, never the real value. */
+export interface MaskedSecret {
+  /** Always a mask such as "••••••••" — never key material. */
+  masked: string;
+  /** True when a value is stored server-side. */
+  set: boolean;
+}
+
+/**
+ * One MCP server / connector entry.
+ *
+ * Connectors and MCP servers share this shape: a connector is the
+ * user-facing account connection (e.g. "GitHub"), an MCP server is the
+ * transport that serves its tools. The l1 API exposes them under
+ * /api/library/mcp (servers) and the Connectors tab lists the same items
+ * grouped as accounts; both tabs read from this one shape so the stub and
+ * the real API stay interchangeable.
+ */
+export interface LibraryMcpItem {
+  id: string;
+  name: string;
+  description: string;
+  source: LibrarySource;
+  /** Transport the server runs over inside the user's VM. */
+  transport: "stdio" | "http" | "sse";
+  /** stdio command, e.g. "npx". Omitted for http/sse. */
+  command?: string;
+  /** stdio argv. */
+  args?: string[];
+  /** http/sse endpoint. */
+  url?: string;
+  /** Env vars / headers. Values are MaskedSecret — never raw secrets. */
+  env?: Record<string, MaskedSecret | string>;
+  enabled: boolean;
+  /** Role ids this item is available to. Empty = available to no role. */
+  roles: string[];
+}
+
+/** One skill entry (a skill is a bundle of files + instructions). */
+export interface LibrarySkillItem {
+  id: string;
+  name: string;
+  description: string;
+  source: LibrarySource;
+  /** Skill files (SKILL.md + friends), relative paths inside the skill. */
+  files: string[];
+  enabled: boolean;
+  roles: string[];
+}
+
+/** One custom / agent / public tool entry. */
+export interface LibraryToolItem {
+  id: string;
+  name: string;
+  description: string;
+  /** JSON Schema for the tool's input. */
+  inputSchema: Record<string, unknown>;
+  /** How the tool runs: a script inside the user's VM, or an HTTP call. */
+  impl: { kind: "script-in-vm"; script: string } | { kind: "http"; url: string };
+  source: "user" | "agent" | "public";
+  enabled: boolean;
+  roles: string[];
+}
+
+export type LibraryItem = LibraryMcpItem | LibrarySkillItem | LibraryToolItem;
+
+/** Fields a user may change on an item (create/update payloads). */
+export type LibraryItemPatch =
+  | Partial<
+      Pick<LibraryMcpItem, "name" | "description" | "transport" | "command" | "args" | "url" | "enabled" | "roles">
+    > & { env?: Record<string, string> }
+  | Partial<Pick<LibrarySkillItem, "name" | "description" | "files" | "enabled" | "roles">>
+  | Partial<Pick<LibraryToolItem, "name" | "description" | "inputSchema" | "impl" | "enabled" | "roles">>;
+
+/** A catalog (browse) entry shown before install — untrusted content is
+ *  always previewed, never auto-installed. */
+export interface LibraryCatalogEntry {
+  id: string;
+  kind: LibraryKind;
+  name: string;
+  description: string;
+  source: Extract<LibrarySource, "catalog" | "public">;
+  /** What the item would install / run — shown in the preview before install. */
+  preview: string;
+  installed: boolean;
+}
+
+/** What the client returns for a list call. */
+export interface LibraryListResult<T extends LibraryItem = LibraryItem> {
+  items: T[];
+  /** Catalog entries available to browse/install for this kind. */
+  catalog: LibraryCatalogEntry[];
+}
