diff --git a/apps/swarmagents/app/globals.css b/apps/swarmagents/app/globals.css
index d20f9a92a..0125c710d 100644
--- a/apps/swarmagents/app/globals.css
+++ b/apps/swarmagents/app/globals.css
@@ -207,18 +207,27 @@ body {
   text-rendering: optimizeLegibility;
 }
 
-button {
-  font: inherit;
-  color: inherit;
-  background: none;
-  border: 0;
-  cursor: pointer;
-  padding: 0;
-}
+/* Base-layer reset: utilities must win over this reset (an unlayered
+ * `button { background: none; }` beats every Tailwind `bg-*` utility on
+ * buttons, which silently killed active tab pills, enable toggles and
+ * accent buttons app-wide — e.g. the Library's toggles rendered with no
+ * track and active tabs with no background). In @layer base the reset
+ * still applies to unstyled buttons, and utilities override it as intended.
+ */
+@layer base {
+  button {
+    font: inherit;
+    color: inherit;
+    background: none;
+    border: 0;
+    cursor: pointer;
+    padding: 0;
+  }
 
-input, textarea, select {
-  font: inherit;
-  color: inherit;
+  input, textarea, select {
+    font: inherit;
+    color: inherit;
+  }
 }
 
 ::selection {
diff --git a/apps/swarmagents/e2e/library.spec.ts b/apps/swarmagents/e2e/library.spec.ts
new file mode 100644
index 000000000..96f5d5da4
--- /dev/null
+++ b/apps/swarmagents/e2e/library.spec.ts
@@ -0,0 +1,197 @@
+// Library page e2e — runs against the stubbed Library client (l1's
+// /api/library API has not merged, so the page serves in-memory preview
+// data; see lib/library/client.ts USE_STUB). The flows below — enable /
+// disable, configure + role assignment, add + remove, catalog install,
+// search — exercise the same UI and client calls the real API will serve,
+// so they become end-to-end against l1 by flipping that one flag.
+import assert from "node:assert/strict";
+import { after, test } from "node:test";
+import type { Page } from "playwright-core";
+import { captureView, closeBrowser, openWorkspace, runPageTest } from "./lib";
+
+after(async () => {
+  await closeBrowser();
+});
+
+async function openLibrary(page: Page) {
+  await page.getByRole("button", { name: "Library", exact: true }).first().click();
+  await page.getByTestId("library-page").waitFor({ state: "visible", timeout: 10_000 });
+}
+
+/** The tab pill crossfades its background (150ms transition); wait for the
+ *  newly selected tab to actually show the active color before screenshotting,
+ *  or the capture catches the fade mid-flight. */
+async function waitForTabActive(page: Page, kind: string) {
+  await page.waitForFunction(
+    (k) => {
+      const el = document.querySelector(`[data-testid="library-tab-${k}"]`);
+      if (!el) return false;
+      const bg = getComputedStyle(el).backgroundColor;
+      return bg !== "rgba(0, 0, 0, 0)" && bg !== "oklab(0 0 0 / 0)" && !bg.includes("0 0 0 / 0");
+    },
+    kind,
+    { timeout: 5_000 },
+  );
+}
+
+test("library: four tabs render installed items", async (t) => {
+  const result = await runPageTest("library: four tabs render installed items", async ({ page, context, consoleErrors }) => {
+    await openWorkspace(page, context);
+    await openLibrary(page);
+
+    // Stub notice: honest about preview data until l1 lands.
+    await page.getByTestId("library-stub-notice").waitFor({ state: "visible", timeout: 5_000 });
+
+    // Connectors tab (default): the GitHub connector is installed.
+    await page.getByTestId("library-card-connector-github").waitFor({ state: "visible", timeout: 5_000 });
+    await captureView(page, "library: four tabs render installed items", "connectors");
+
+    // MCP tab: the four hardcoded servers are installed.
+    await page.getByTestId("library-tab-mcp").click();
+    await page.getByTestId("library-card-github-mcp").waitFor({ state: "visible", timeout: 5_000 });
+    await page.getByTestId("library-card-postgres-mcp").waitFor({ state: "visible", timeout: 5_000 });
+    await waitForTabActive(page, "mcp");
+    await captureView(page, "library: four tabs render installed items", "mcp");
+
+    // Skills tab: the three builtin skills are installed.
+    await page.getByTestId("library-tab-skills").click();
+    await page.getByTestId("library-card-terminal-exec").waitFor({ state: "visible", timeout: 5_000 });
+    await page.getByTestId("library-card-browser-live").waitFor({ state: "visible", timeout: 5_000 });
+    await waitForTabActive(page, "skills");
+    await captureView(page, "library: four tabs render installed items", "skills");
+
+    // Tools tab: the agent-created example tool is installed.
+    await page.getByTestId("library-tab-tools").click();
+    await page.getByTestId("library-card-tool-summarize-diff").waitFor({ state: "visible", timeout: 5_000 });
+    await waitForTabActive(page, "tools");
+    await captureView(page, "library: four tabs render installed items", "tools");
+
+    assert.deepEqual(consoleErrors, [], `unexpected page errors: ${consoleErrors.join(" | ")}`);
+  });
+  if (result.skipped) t.skip(result.skipped);
+});
+
+test("library: enable and disable toggle persists", async (t) => {
+  const result = await runPageTest("library: enable and disable toggle persists", async ({ page, context, consoleErrors }) => {
+    await openWorkspace(page, context);
+    await openLibrary(page);
+    await page.getByTestId("library-tab-mcp").click();
+    await page.getByTestId("library-card-postgres-mcp").waitFor({ state: "visible", timeout: 5_000 });
+
+    const toggle = page.getByTestId("library-toggle-postgres-mcp");
+    assert.equal(await toggle.getAttribute("aria-checked"), "false", "postgres-mcp starts disabled");
+
+    await toggle.click();
+    await page.waitForFunction(
+      () => document.querySelector('[data-testid="library-toggle-postgres-mcp"]')?.getAttribute("aria-checked") === "true",
+      { timeout: 5_000 },
+    );
+    assert.equal(await toggle.getAttribute("aria-checked"), "true", "postgres-mcp enables");
+
+    await toggle.click();
+    await page.waitForFunction(
+      () => document.querySelector('[data-testid="library-toggle-postgres-mcp"]')?.getAttribute("aria-checked") === "false",
+      { timeout: 5_000 },
+    );
+    assert.equal(await toggle.getAttribute("aria-checked"), "false", "postgres-mcp disables again");
+
+    assert.deepEqual(consoleErrors, [], `unexpected page errors: ${consoleErrors.join(" | ")}`);
+  });
+  if (result.skipped) t.skip(result.skipped);
+});
+
+test("library: configure drawer assigns a role", async (t) => {
+  const result = await runPageTest("library: configure drawer assigns a role", async ({ page, context, consoleErrors }) => {
+    await openWorkspace(page, context);
+    await openLibrary(page);
+    await page.getByTestId("library-tab-mcp").click();
+    await page.getByTestId("library-card-github-mcp").waitFor({ state: "visible", timeout: 5_000 });
+
+    await page.getByTestId("library-configure-github-mcp").click();
+    const drawer = page.getByTestId("library-drawer");
+    await drawer.waitFor({ state: "visible", timeout: 5_000 });
+
+    // The GitHub server is masked-secret based: the token field shows a
+    // placeholder, never a value.
+    const secret = page.getByTestId("library-drawer-secret").first();
+    assert.equal(await secret.inputValue(), "", "stored secret must arrive blank (masked)");
+
+    // Assign the Debugger role, which is not assigned initially.
+    const debuggerRole = page.getByTestId("library-role-debugger");
+    assert.equal(await debuggerRole.isChecked(), false, "debugger starts unassigned");
+    await debuggerRole.check();
+    await page.getByTestId("library-drawer-save").click();
+    await drawer.waitFor({ state: "hidden", timeout: 5_000 });
+
+    // Reopen: the assignment stuck.
+    await page.getByTestId("library-configure-github-mcp").click();
+    await drawer.waitFor({ state: "visible", timeout: 5_000 });
+    assert.equal(await page.getByTestId("library-role-debugger").isChecked(), true, "debugger stays assigned after save");
+    // The role list on the card reflects the assignment.
+    await page.keyboard.press("Escape");
+    await drawer.waitFor({ state: "hidden", timeout: 5_000 });
+    const card = page.getByTestId("library-card-github-mcp");
+    assert.match((await card.textContent()) ?? "", /debugger/, "card shows the assigned role");
+
+    assert.deepEqual(consoleErrors, [], `unexpected page errors: ${consoleErrors.join(" | ")}`);
+  });
+  if (result.skipped) t.skip(result.skipped);
+});
+
+test("library: add a custom tool and remove it", async (t) => {
+  const result = await runPageTest("library: add a custom tool and remove it", async ({ page, context, consoleErrors }) => {
+    await openWorkspace(page, context);
+    await openLibrary(page);
+    await page.getByTestId("library-tab-tools").click();
+    await page.getByTestId("library-card-tool-summarize-diff").waitFor({ state: "visible", timeout: 5_000 });
+
+    await page.getByTestId("library-add-tools").click();
+    const drawer = page.getByTestId("library-drawer");
+    await drawer.waitFor({ state: "visible", timeout: 5_000 });
+    await page.getByTestId("library-drawer-name").fill("E2E probe tool");
+    await page.getByTestId("library-drawer-description").fill("A tool added by the e2e spec.");
+    await page.getByTestId("library-drawer-script").fill("probe.sh");
+    await page.getByTestId("library-drawer-save").click();
+    await drawer.waitFor({ state: "hidden", timeout: 5_000 });
+
+    const card = page.locator('[data-testid^="library-card-"]', { hasText: "E2E probe tool" });
+    await card.waitFor({ state: "visible", timeout: 5_000 });
+
+    // Remove with confirm: the card goes away.
+    await card.getByRole("button", { name: /Remove E2E probe tool/ }).click();
+    const confirm = card.getByRole("button", { name: /Confirm remove/ });
+    await confirm.waitFor({ state: "visible", timeout: 5_000 });
+    await confirm.click();
+    await card.waitFor({ state: "hidden", timeout: 5_000 });
+
+    assert.deepEqual(consoleErrors, [], `unexpected page errors: ${consoleErrors.join(" | ")}`);
+  });
+  if (result.skipped) t.skip(result.skipped);
+});
+
+test("library: catalog install and search filter", async (t) => {
+  const result = await runPageTest("library: catalog install and search filter", async ({ page, context, consoleErrors }) => {
+    await openWorkspace(page, context);
+    await openLibrary(page);
+    await page.getByTestId("library-tab-mcp").click();
+    await page.getByTestId("library-card-github-mcp").waitFor({ state: "visible", timeout: 5_000 });
+
+    // Untrusted catalog content is previewed before install.
+    const catalogEntry = page.getByTestId("library-catalog-catalog-sqlite-mcp");
+    assert.match((await catalogEntry.textContent()) ?? "", /Before you install/, "catalog entry shows its preview");
+    await page.getByTestId("library-install-catalog-sqlite-mcp").click();
+    await page.getByTestId("library-card-catalog-sqlite-mcp").waitFor({ state: "visible", timeout: 5_000 });
+
+    // Search narrows the installed list.
+    await page.getByTestId("library-search").fill("postgres");
+    await page.waitForFunction(
+      () => document.querySelectorAll('[data-testid="library-card-github-mcp"]').length === 0,
+      { timeout: 5_000 },
+    );
+    assert.equal(await page.getByTestId("library-card-postgres-mcp").count(), 1, "postgres still matches");
+    assert.equal(await page.getByTestId("library-card-github-mcp").count(), 0, "github is filtered out");
+
+    assert.deepEqual(consoleErrors, [], `unexpected page errors: ${consoleErrors.join(" | ")}`);
+  });
+  if (result.skipped) t.skip(result.skipped);
+});
diff --git a/apps/swarmagents/lib/library/client.test.ts b/apps/swarmagents/lib/library/client.test.ts
new file mode 100644
index 000000000..63b216710
--- /dev/null
+++ b/apps/swarmagents/lib/library/client.test.ts
@@ -0,0 +1,91 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { ROLE_MCP_SERVER_REGISTRY, ROLE_SKILL_REGISTRY } from "../roles";
+import { StubLibraryClient, stripMaskedEnv } from "./client";
+
+test("library stub: seeds mirror the hardcoded registries", async () => {
+  const client = new StubLibraryClient();
+  const mcp = await client.list("mcp");
+  const registryIds = Object.keys(ROLE_MCP_SERVER_REGISTRY).sort();
+  const seededIds = mcp.items.map((item) => item.id).sort();
+  assert.deepEqual(seededIds, registryIds, "stub MCP seeds must match ROLE_MCP_SERVER_REGISTRY");
+
+  const skills = await client.list("skills");
+  const skillRegistryIds = Object.keys(ROLE_SKILL_REGISTRY).sort();
+  const seededSkillIds = skills.items.map((item) => item.id).sort();
+  assert.deepEqual(seededSkillIds, skillRegistryIds, "stub skill seeds must match ROLE_SKILL_REGISTRY");
+});
+
+test("library stub: enable/disable toggles an item", async () => {
+  const client = new StubLibraryClient();
+  const updated = await client.setEnabled("mcp", "postgres-mcp", true);
+  assert.equal(updated.enabled, true);
+  const list = await client.list("mcp");
+  assert.equal(list.items.find((item) => item.id === "postgres-mcp")?.enabled, true);
+  await client.setEnabled("mcp", "postgres-mcp", false);
+  const again = await client.list("mcp");
+  assert.equal(again.items.find((item) => item.id === "postgres-mcp")?.enabled, false);
+});
+
+test("library stub: role assignment round-trips", async () => {
+  const client = new StubLibraryClient();
+  const updated = await client.setRoles("skills", "terminal-exec", ["main", "debugger"]);
+  assert.deepEqual(updated.roles, ["main", "debugger"]);
+  const list = await client.list("skills");
+  assert.deepEqual(list.items.find((item) => item.id === "terminal-exec")?.roles, ["main", "debugger"]);
+});
+
+test("library stub: builtin items cannot be removed, custom ones can", async () => {
+  const client = new StubLibraryClient();
+  await assert.rejects(() => client.remove("mcp", "github-mcp"), /Built-in items cannot be removed/);
+
+  const created = await client.create("tools", {
+    name: "My tool",
+    description: "test tool",
+    impl: { kind: "script-in-vm", script: "run.sh" },
+    inputSchema: { type: "object", properties: {} },
+  });
+  assert.equal(created.source, "user");
+  await client.remove("tools", created.id);
+  const list = await client.list("tools");
+  assert.equal(list.items.some((item) => item.id === created.id), false);
+});
+
+test("library stub: catalog install shows untrusted content first, then installs", async () => {
+  const client = new StubLibraryClient();
+  const before = await client.list("mcp");
+  const entry = before.catalog.find((item) => item.id === "catalog-sqlite-mcp");
+  assert.ok(entry, "expected a SQLite catalog entry");
+  assert.match(entry.preview, /Runs inside your VM/, "catalog preview must state where it runs");
+  assert.equal(entry.installed, false);
+
+  const installed = await client.installFromCatalog("mcp", "catalog-sqlite-mcp");
+  assert.equal(installed.source, "catalog");
+  const after = await client.list("mcp");
+  assert.equal(after.catalog.find((item) => item.id === "catalog-sqlite-mcp")?.installed, true);
+  assert.equal(after.items.some((item) => item.id === "catalog-sqlite-mcp"), true);
+});
+
+test("library stub: create rejects duplicate ids", async () => {
+  const client = new StubLibraryClient();
+  await assert.rejects(
+    () => client.create("skills", { id: "terminal-exec", name: "dup", description: "" }),
+    /already exists/,
+  );
+});
+
+test("library client: masked secret placeholders are never sent back", () => {
+  const patch = stripMaskedEnv({
+    name: "GitHub",
+    env: { GITHUB_TOKEN: "••••••••", OTHER: "real-value" },
+  } as never);
+  const env = (patch as { env?: Record<string, string> }).env ?? {};
+  assert.equal("GITHUB_TOKEN" in env, false, "masked placeholder must be dropped");
+  assert.equal(env.OTHER, "real-value");
+});
+
+test("library stub: unknown ids fail loudly", async () => {
+  const client = new StubLibraryClient();
+  await assert.rejects(() => client.update("tools", "nope", { enabled: false }), /No tools item/);
+  await assert.rejects(() => client.remove("skills", "nope"), /No skills item/);
+});
diff --git a/apps/swarmagents/lib/library/client.ts b/apps/swarmagents/lib/library/client.ts
new file mode 100644
index 000000000..57e1dec8e
--- /dev/null
+++ b/apps/swarmagents/lib/library/client.ts
@@ -0,0 +1,522 @@
+// Library client — the ONE module the Library UI talks to.
+//
+// l1 (Library foundation: per-user store + /api/library/* CRUD API) has NOT
+// merged, so this module ships two adapters behind one interface:
+//
+//   - `StubLibraryClient` — in-memory data seeded from the app's current
+//     hardcoded registries (ROLE_MCP_SERVER_REGISTRY, ROLE_SKILL_REGISTRY,
+//     DEFAULT_MCP_SKILLS). Used while l1 is unmerged.
+//   - `RestLibraryClient` — the real adapter against the l1 REST contract
+//     (GET/POST/PATCH/DELETE /api/library/{mcp,skills,tools}, owner-only,
+//     zod-validated). It is fully written but untested against a live l1
+//     server because none exists on this main yet.
+//
+// Flip the single `USE_STUB` flag below when l1 lands. Components must
+// never call fetch directly — they use `getLibraryClient()` only, so the
+// swap touches this file and nothing else.
+//
+// Secrets: the client NEVER logs or stores secret values. The API returns
+// masked placeholders for env values; `updateItem` only sends env entries
+// the user actually typed (non-empty strings). Masked placeholders are
+// never sent back — sending "••••••••" would overwrite the stored secret.
+
+import {
+  type LibraryCatalogEntry,
+  type LibraryItem,
+  type LibraryItemPatch,
+  type LibraryKind,
+  type LibraryListResult,
+  type LibraryMcpItem,
+  type LibrarySkillItem,
+  type LibraryToolItem,
+} from "./types";
+
+/** Flip to false the moment l1's /api/library routes land on main. */
+export const USE_STUB = true;
+
+export interface LibraryClient {
+  list(kind: LibraryKind): Promise<LibraryListResult>;
+  create(kind: LibraryKind, patch: LibraryItemPatch & { id?: string }): Promise<LibraryItem>;
+  update(kind: LibraryKind, id: string, patch: LibraryItemPatch): Promise<LibraryItem>;
+  remove(kind: LibraryKind, id: string): Promise<void>;
+  setEnabled(kind: LibraryKind, id: string, enabled: boolean): Promise<LibraryItem>;
+  setRoles(kind: LibraryKind, id: string, roles: string[]): Promise<LibraryItem>;
+  installFromCatalog(kind: LibraryKind, catalogId: string): Promise<LibraryItem>;
+}
+
+// ---------------------------------------------------------------------------
+// Stub adapter (in-memory; l1 not merged yet)
+// ---------------------------------------------------------------------------
+
+const MASK = "••••••••";
+
+/** Seed MCP servers — mirrors lib/roles.ts ROLE_MCP_SERVER_REGISTRY. */
+function seedMcp(): LibraryMcpItem[] {
+  return [
+    {
+      id: "postgres-mcp",
+      name: "PostgreSQL",
+      description: "Direct DB query execution, migrations and schema inspection.",
+      source: "builtin",
+      transport: "stdio",
+      command: "npx",
+      args: ["-y", "@modelcontextprotocol/server-postgres"],
+      env: { DATABASE_URL: { masked: MASK, set: false } },
+      enabled: false,
+      roles: ["backend-engineer", "data-analyst"],
+    },
+    {
+      id: "github-mcp",
+      name: "GitHub",
+      description: "Branch management, pull requests and commit checks.",
+      source: "builtin",
+      transport: "stdio",
+      command: "npx",
+      args: ["-y", "@modelcontextprotocol/server-github"],
+      env: { GITHUB_TOKEN: { masked: MASK, set: false } },
+      enabled: true,
+      roles: ["main", "frontend-engineer", "code-reviewer", "devops", "deployer", "security-auditor"],
+    },
+    {
+      id: "computer-mcp",
+      name: "Desktop Computer",
+      description:
+        "Control the on-screen desktop: screenshots, clicks, typing, keys, scrolling and opening apps (desktop VM mode only).",
+      source: "builtin",
+      transport: "stdio",
+      command: "npx",
+      args: ["-y", "@swarmagents/computer-mcp"],
+      enabled: false,
+      roles: [],
+    },
+    {
+      id: "playwright-mcp",
+      name: "Desktop Browser",
+      description:
+        "Drive the visible on-screen Chromium: navigation, clicks, typing and page snapshots (desktop VM mode only).",
+      source: "builtin",
+      transport: "stdio",
+      command: "npx",
+      args: ["-y", "@playwright/mcp"],
+      enabled: false,
+      roles: [],
+    },
+  ];
+}
+
+/** Seed skills — mirrors lib/roles.ts ROLE_SKILL_REGISTRY and
+ *  minimalist-ui/src/data.ts DEFAULT_MCP_SKILLS. */
+function seedSkills(): LibrarySkillItem[] {
+  return [
+    {
+      id: "terminal-exec",
+      name: "Bash & Terminal",
+      description: "Executes shell commands, git and build runners in the VM.",
+      source: "builtin",
+      files: ["SKILL.md"],
+      enabled: true,
+      roles: ["main", "orchestrator", "implementer", "frontend-engineer", "backend-engineer", "debugger", "auditor", "test-writer", "security-auditor", "data-analyst", "technical-writer", "devops", "deployer"],
+    },
+    {
+      id: "browser-live",
+      name: "Live Headed Browser",
+      description: "Interactive browser session streamed into the dashboard.",
+      source: "builtin",
+      files: ["SKILL.md"],
+      enabled: true,
+      roles: ["main", "researcher", "frontend-engineer", "browser-operator", "product-designer"],
+    },
+    {
+      id: "file-editor",
+      name: "Surgical File Editor",
+      description: "Atomic file reading, writing and diff-based patching.",
+      source: "builtin",
+      files: ["SKILL.md"],
+      enabled: true,
+      roles: ["main", "implementer", "frontend-engineer", "backend-engineer", "debugger", "test-writer", "technical-writer", "devops", "deployer"],
+    },
+  ];
+}
+
+/** Seed connectors — the account connections behind the MCP servers. */
+function seedConnectors(): LibraryMcpItem[] {
+  return [
+    {
+      id: "connector-github",
+      name: "GitHub",
+      description: "Connect your GitHub account for repos, PRs and checks.",
+      source: "builtin",
+      transport: "http",
+      url: "https://api.github.com",
+      env: { GITHUB_TOKEN: { masked: MASK, set: false } },
+      enabled: true,
+      roles: ["main"],
+    },
+    {
+      id: "connector-postgres",
+      name: "PostgreSQL",
+      description: "Connect a Postgres database for queries and migrations.",
+      source: "builtin",
+      transport: "stdio",
+      command: "npx",
+      args: ["-y", "@modelcontextprotocol/server-postgres"],
+      env: { DATABASE_URL: { masked: MASK, set: false } },
+      enabled: false,
+      roles: [],
+    },
+  ];
+}
+
+/** Seed tools — one agent-created example so the tab is not empty. */
+function seedTools(): LibraryToolItem[] {
+  return [
+    {
+      id: "tool-summarize-diff",
+      name: "Summarize diff",
+      description: "Summarizes a git diff into a short changelog entry. Created by the agent.",
+      inputSchema: { type: "object", properties: { diff: { type: "string" } }, required: ["diff"] },
+      impl: { kind: "script-in-vm", script: "summarize-diff.sh" },
+      source: "agent",
+      enabled: true,
+      roles: ["main", "code-reviewer"],
+    },
+  ];
+}
+
+/** Untrusted public-catalog entries — always shown before install. */
+function seedCatalog(kind: LibraryKind): LibraryCatalogEntry[] {
+  if (kind === "mcp") {
+    return [
+      {
+        id: "catalog-sqlite-mcp",
+        kind: "mcp",
+        name: "SQLite MCP",
+        description: "Query local SQLite databases from the agent.",
+        source: "catalog",
+        preview: "Installs the @modelcontextprotocol/server-sqlite MCP server (npx, stdio). Runs inside your VM. Requests read access to .db files you point it at — no network, no secrets.",
+        installed: false,
+      },
+      {
+        id: "catalog-filesystem-mcp",
+        kind: "mcp",
+        name: "Filesystem MCP",
+        description: "Scoped file access for the agent beyond the workspace.",
+        source: "catalog",
+        preview: "Installs @modelcontextprotocol/server-filesystem (npx, stdio). Runs inside your VM. You choose which directories it may read — it cannot reach anything outside that list.",
+        installed: false,
+      },
+    ];
+  }
+  if (kind === "skills") {
+    return [
+      {
+        id: "catalog-pdf-reading",
+        kind: "skills",
+        name: "PDF Reading",
+        description: "Extract text and tables from PDF files.",
+        source: "catalog",
+        preview: "Installs the pdf-reading skill (SKILL.md + extract.py). Runs inside your VM. Reads only files you hand it — no network access.",
+        installed: false,
+      },
+    ];
+  }
+  if (kind === "tools") {
+    return [
+      {
+        id: "catalog-weather-tool",
+        kind: "tools",
+        name: "Weather lookup",
+        description: "Current weather for any city, via a public API.",
+        source: "public",
+        preview: "Installs a public tool that calls api.open-meteo.com (GET, no key). Runs as an HTTP call from your VM. Shares only the city name you pass in.",
+        installed: false,
+      },
+    ];
+  }
+  return [
+    {
+      id: "catalog-slack",
+      kind: "connectors",
+      name: "Slack",
+      description: "Connect a Slack workspace for messages and channels.",
+      source: "catalog",
+      preview: "Adds a Slack connector (HTTP). Runs inside your VM. Needs a Slack bot token, stored encrypted — the agent can only read channels you allow.",
+      installed: false,
+    },
+  ];
+}
+
+function slugify(value: string): string {
+  const slug = value
+    .toLowerCase()
+    .trim()
+    .replace(/[^a-z0-9]+/g, "-")
+    .replace(/^-+|-+$/g, "")
+    .slice(0, 48);
+  return slug || "item";
+}
+
+function clone<T>(value: T): T {
+  return JSON.parse(JSON.stringify(value)) as T;
+}
+
+/** In-memory Library client used until l1's API lands. */
+export class StubLibraryClient implements LibraryClient {
+  private readonly store: Record<LibraryKind, LibraryItem[]> = {
+    connectors: seedConnectors(),
+    mcp: seedMcp(),
+    skills: seedSkills(),
+    tools: seedTools(),
+  };
+  private readonly installedCatalog = new Set<string>();
+
+  async list(kind: LibraryKind): Promise<LibraryListResult> {
+    return {
+      items: clone(this.store[kind]),
+      catalog: seedCatalog(kind).map((entry) => ({
+        ...entry,
+        installed: this.installedCatalog.has(entry.id) || this.store[kind].some((item) => item.id === entry.id),
+      })),
+    };
+  }
+
+  async create(kind: LibraryKind, patch: LibraryItemPatch & { id?: string }): Promise<LibraryItem> {
+    const id = patch.id?.trim() || `${slugify((patch as { name?: string }).name ?? "item")}-${Date.now().toString(36)}`;
+    if (this.store[kind].some((item) => item.id === id)) {
+      throw new Error(`An item with id "${id}" already exists.`);
+    }
+    const item = this.buildItem(kind, id, patch);
+    this.store[kind].push(item);
+    return clone(item);
+  }
+
+  async update(kind: LibraryKind, id: string, patch: LibraryItemPatch): Promise<LibraryItem> {
+    const item = this.find(kind, id);
+    this.applyPatch(item, patch);
+    return clone(item);
+  }
+
+  async remove(kind: LibraryKind, id: string): Promise<void> {
+    const index = this.store[kind].findIndex((item) => item.id === id);
+    if (index < 0) throw new Error(`No ${kind} item with id "${id}".`);
+    if (this.store[kind][index].source === "builtin") {
+      throw new Error("Built-in items cannot be removed — disable them instead.");
+    }
+    this.store[kind].splice(index, 1);
+  }
+
+  async setEnabled(kind: LibraryKind, id: string, enabled: boolean): Promise<LibraryItem> {
+    return this.update(kind, id, { enabled } as LibraryItemPatch);
+  }
+
+  async setRoles(kind: LibraryKind, id: string, roles: string[]): Promise<LibraryItem> {
+    return this.update(kind, id, { roles } as LibraryItemPatch);
+  }
+
+  async installFromCatalog(kind: LibraryKind, catalogId: string): Promise<LibraryItem> {
+    const entry = seedCatalog(kind).find((item) => item.id === catalogId);
+    if (!entry) throw new Error(`No catalog entry "${catalogId}".`);
+    if (this.store[kind].some((item) => item.id === entry.id)) {
+      throw new Error(`"${entry.name}" is already installed.`);
+    }
+    const item = this.buildItem(kind, entry.id, {
+      name: entry.name,
+      description: entry.description,
+    } as LibraryItemPatch);
+    item.source = entry.source;
+    this.store[kind].push(item);
+    this.installedCatalog.add(catalogId);
+    return clone(item);
+  }
+
+  private find(kind: LibraryKind, id: string): LibraryItem {
+    const item = this.store[kind].find((candidate) => candidate.id === id);
+    if (!item) throw new Error(`No ${kind} item with id "${id}".`);
+    return item;
+  }
+
+  private buildItem(kind: LibraryKind, id: string, patch: LibraryItemPatch): LibraryItem {
+    const base = {
+      id,
+      name: (patch as { name?: string }).name?.trim() || id,
+      description: (patch as { description?: string }).description?.trim() || "",
+      enabled: (patch as { enabled?: boolean }).enabled ?? true,
+      roles: [...((patch as { roles?: string[] }).roles ?? [])],
+    };
+    if (kind === "mcp" || kind === "connectors") {
+      const mcp = patch as Partial<LibraryMcpItem> & { env?: Record<string, string> };
+      return {
+        ...base,
+        source: "custom",
+        transport: mcp.transport ?? "stdio",
+        ...(mcp.command ? { command: mcp.command } : {}),
+        ...(mcp.args ? { args: mcp.args } : {}),
+        ...(mcp.url ? { url: mcp.url } : {}),
+        env: toMaskedEnv(mcp.env),
+      } satisfies LibraryMcpItem;
+    }
+    if (kind === "skills") {
+      const skill = patch as Partial<LibrarySkillItem>;
+      return { ...base, source: "custom", files: [...(skill.files ?? ["SKILL.md"])] } satisfies LibrarySkillItem;
+    }
+    const tool = patch as Partial<LibraryToolItem>;
+    return {
+      ...base,
+      source: "user",
+      inputSchema: tool.inputSchema ?? { type: "object", properties: {} },
+      impl: tool.impl ?? { kind: "script-in-vm", script: "" },
+    } satisfies LibraryToolItem;
+  }
+
+  private applyPatch(item: LibraryItem, patch: LibraryItemPatch): void {
+    const p = patch as Record<string, unknown>;
+    if (typeof p.name === "string") item.name = p.name.trim() || item.name;
+    if (typeof p.description === "string") item.description = p.description;
+    if (typeof p.enabled === "boolean") item.enabled = p.enabled;
+    if (Array.isArray(p.roles)) {
+      item.roles = [...new Set(p.roles.filter((r): r is string => typeof r === "string"))];
+    }
+    if ("transport" in item && typeof p.transport === "string") {
+      (item as LibraryMcpItem).transport = p.transport as LibraryMcpItem["transport"];
+    }
+    if ("command" in item && typeof p.command === "string") (item as LibraryMcpItem).command = p.command || undefined;
+    if ("args" in item && Array.isArray(p.args)) {
+      (item as LibraryMcpItem).args = p.args.filter((a): a is string => typeof a === "string");
+    }
+    if ("url" in item && typeof p.url === "string") (item as LibraryMcpItem).url = p.url || undefined;
+    if ("env" in item && p.env && typeof p.env === "object") {
+      const next = toMaskedEnv(p.env as Record<string, string>);
+      (item as LibraryMcpItem).env = { ...((item as LibraryMcpItem).env ?? {}), ...next };
+    }
+    if ("files" in item && Array.isArray(p.files)) {
+      (item as LibrarySkillItem).files = p.files.filter((f): f is string => typeof f === "string");
+    }
+    if ("inputSchema" in item && p.inputSchema && typeof p.inputSchema === "object") {
+      (item as LibraryToolItem).inputSchema = p.inputSchema as Record<string, unknown>;
+    }
+    if ("impl" in item && p.impl && typeof p.impl === "object") {
+      (item as LibraryToolItem).impl = p.impl as LibraryToolItem["impl"];
+    }
+  }
+}
+
+/** Turn user-typed env values into masked entries. Empty values are dropped
+ *  (clearing a secret means "leave stored value alone" — the API keeps it).
+ *  The mask placeholder is NEVER treated as a value to store. */
+function toMaskedEnv(env: Record<string, string> | undefined): Record<string, { masked: string; set: boolean }> | undefined {
+  if (!env) return undefined;
+  const out: Record<string, { masked: string; set: boolean }> = {};
+  for (const [key, value] of Object.entries(env)) {
+    if (!key.trim() || !value || value === MASK) continue;
+    out[key.trim()] = { masked: MASK, set: true };
+  }
+  return Object.keys(out).length ? out : undefined;
+}
+
+// ---------------------------------------------------------------------------
+// REST adapter (real l1 API — untested live until l1 merges)
+// ---------------------------------------------------------------------------
+
+const KIND_PATH: Record<LibraryKind, string> = {
+  connectors: "mcp",
+  mcp: "mcp",
+  skills: "skills",
+  tools: "tools",
+};
+
+async function readJson(res: Response): Promise<Record<string, unknown>> {
+  const body = (await res.json().catch(() => ({}))) as Record<string, unknown>;
+  if (!res.ok) {
+    throw new Error(typeof body.error === "string" ? body.error : `Library API returned HTTP ${res.status}`);
+  }
+  return body;
+}
+
+/** REST client against /api/library/{mcp,skills,tools}. */
+export class RestLibraryClient implements LibraryClient {
+  async list(kind: LibraryKind): Promise<LibraryListResult> {
+    const body = await readJson(await fetch(`/api/library/${KIND_PATH[kind]}`, { headers: { Accept: "application/json" } }));
+    const items = (Array.isArray(body.items) ? body.items : []) as LibraryItem[];
+    const catalog = (Array.isArray(body.catalog) ? body.catalog : []) as LibraryCatalogEntry[];
+    return { items, catalog };
+  }
+
+  async create(kind: LibraryKind, patch: LibraryItemPatch & { id?: string }): Promise<LibraryItem> {
+    const body = await readJson(
+      await fetch(`/api/library/${KIND_PATH[kind]}`, {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify(stripMaskedEnv(patch)),
+      }),
+    );
+    return body.item as LibraryItem;
+  }
+
+  async update(kind: LibraryKind, id: string, patch: LibraryItemPatch): Promise<LibraryItem> {
+    const body = await readJson(
+      await fetch(`/api/library/${KIND_PATH[kind]}/${encodeURIComponent(id)}`, {
+        method: "PATCH",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify(stripMaskedEnv(patch)),
+      }),
+    );
+    return body.item as LibraryItem;
+  }
+
+  async remove(kind: LibraryKind, id: string): Promise<void> {
+    await readJson(
+      await fetch(`/api/library/${KIND_PATH[kind]}/${encodeURIComponent(id)}`, { method: "DELETE" }),
+    );
+  }
+
+  async setEnabled(kind: LibraryKind, id: string, enabled: boolean): Promise<LibraryItem> {
+    return this.update(kind, id, { enabled } as LibraryItemPatch);
+  }
+
+  async setRoles(kind: LibraryKind, id: string, roles: string[]): Promise<LibraryItem> {
+    return this.update(kind, id, { roles } as LibraryItemPatch);
+  }
+
+  async installFromCatalog(kind: LibraryKind, catalogId: string): Promise<LibraryItem> {
+    const body = await readJson(
+      await fetch(`/api/library/${KIND_PATH[kind]}/install`, {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({ catalogId }),
+      }),
+    );
+    return body.item as LibraryItem;
+  }
+}
+
+/**
+ * Drop masked placeholders from an outgoing payload: the server keeps the
+ * stored secret when a key is absent, and a "••••••••" value must never be
+ * sent as if it were a real secret.
+ */
+export function stripMaskedEnv(patch: LibraryItemPatch): LibraryItemPatch {
+  const env = (patch as { env?: Record<string, string> }).env;
+  if (!env || typeof env !== "object") return patch;
+  const clean: Record<string, string> = {};
+  for (const [key, value] of Object.entries(env)) {
+    if (value && value !== MASK) clean[key] = value;
+  }
+  return { ...patch, env: clean };
+}
+
+// ---------------------------------------------------------------------------
+// Singleton — every component shares one client (and one stub store).
+// ---------------------------------------------------------------------------
+
+let shared: LibraryClient | null = null;
+
+/** The Library client for the whole app. */
+export function getLibraryClient(): LibraryClient {
+  if (!shared) shared = USE_STUB ? new StubLibraryClient() : new RestLibraryClient();
+  return shared;
+}
+
+/** Test hook: replace the shared client (restores the default afterwards). */
+export function __setLibraryClientForTests(client: LibraryClient | null): void {
+  shared = client;
+}
