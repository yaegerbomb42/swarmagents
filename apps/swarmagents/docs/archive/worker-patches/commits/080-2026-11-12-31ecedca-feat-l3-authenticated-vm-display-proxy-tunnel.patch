diff --git a/apps/swarmagents/app/api/runtime/vm/display/route.ts b/apps/swarmagents/app/api/runtime/vm/display/route.ts
new file mode 100644
index 000000000..520390511
--- /dev/null
+++ b/apps/swarmagents/app/api/runtime/vm/display/route.ts
@@ -0,0 +1,43 @@
+/**
+ * Display availability for the caller's VM.
+ *
+ * GET /api/runtime/vm/display -> {available: boolean, reason?: string}
+ *
+ * When a desktop VM is reachable this returns `available: true`; the browser
+ * then opens the WebSocket tunnel at /api/runtime/vm/display/ws (served by
+ * the custom Node server, see server.ts). Under the headless fake driver —
+ * or any driver without a desktop — there is no endpoint and it returns
+ * `available: false` with a reason. Auth comes from the middleware-set
+ * x-swarm-user header (see lib/auth).
+ */
+
+import { NextResponse, type NextRequest } from "next/server";
+import { USER_HEADER } from "../../../../../lib/auth";
+import { getVmManager } from "../../../../../lib/vm/manager";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+function caller(req: NextRequest): string | null {
+  const user = req.headers.get(USER_HEADER);
+  return user && user.length > 0 && user.length <= 128 ? user : null;
+}
+
+export async function GET(req: NextRequest) {
+  const user = caller(req);
+  if (!user) return NextResponse.json({ error: "Sign in required." }, { status: 401 });
+
+  const vm = getVmManager();
+  try {
+    const endpoint = await vm.desktopEndpoint(user);
+    if (endpoint) {
+      return NextResponse.json({ available: true });
+    }
+    const driver = (process.env.SWARM_VM_DRIVER ?? "").trim().toLowerCase();
+    const reason = driver === "docker" ? "no desktop VM" : "fake driver";
+    return NextResponse.json({ available: false, reason });
+  } catch (err) {
+    const message = err instanceof Error ? err.message : "Could not query display availability.";
+    return NextResponse.json({ available: false, reason: message }, { status: 500 });
+  }
+}
