diff --git a/apps/swarmagents/server.ts b/apps/swarmagents/server.ts
new file mode 100644
index 000000000..da83d156b
--- /dev/null
+++ b/apps/swarmagents/server.ts
@@ -0,0 +1,54 @@
+/**
+ * Production entry: a small custom Node server that wraps the Next.js
+ * standalone handler and adds the authenticated display WebSocket tunnel.
+ *
+ * Next.js route handlers cannot upgrade WebSockets, so we run our own HTTP
+ * server: every normal request is handed to the Next request handler, and the
+ * display proxy's `upgrade` handler owns `/api/runtime/vm/display/ws` (see
+ * lib/vm/display-proxy.ts). Built to `server.js` by `npm run build` and run by
+ * the container (`CMD ["node", "server.js"]`).
+ */
+
+import http from "node:http";
+import next from "next";
+import { createDisplayProxy } from "./lib/vm/display-proxy";
+
+// The `next` types expose NODE_ENV as read-only; the runtime value is what
+// matters (the standalone server does the same).
+(process.env as { NODE_ENV?: string }).NODE_ENV = "production";
+
+const dir = __dirname;
+const app = next({ dev: false, dir });
+const handle = app.getRequestHandler();
+
+const port = Number(process.env.PORT ?? 3777);
+const hostname = process.env.HOSTNAME || "0.0.0.0";
+
+const displayProxy = createDisplayProxy();
+
+app.prepare().then(() => {
+  const server = http.createServer((req, res) => {
+    handle(req, res).catch(() => {
+      if (!res.headersSent) res.writeHead(500);
+      res.end();
+    });
+  });
+  displayProxy.install(server);
+
+  server.listen(port, hostname, () => {
+    // eslint-disable-next-line no-console
+    console.log(`[swarmagents] listening on ${hostname}:${port}`);
+  });
+
+  let shuttingDown = false;
+  const shutdown = () => {
+    if (shuttingDown) return;
+    shuttingDown = true;
+    displayProxy.close().finally(() => server.close(() => process.exit(0)));
+  };
+  process.on("SIGTERM", shutdown);
+  process.on("SIGINT", shutdown);
+}).catch((err) => {
+  console.error("[swarmagents] failed to start:", err);
+  process.exit(1);
+});
