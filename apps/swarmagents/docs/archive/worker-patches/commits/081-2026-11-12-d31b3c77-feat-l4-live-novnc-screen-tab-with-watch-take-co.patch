diff --git a/apps/swarmagents/lib/client/novnc.d.ts b/apps/swarmagents/lib/client/novnc.d.ts
new file mode 100644
index 000000000..2dc110dbe
--- /dev/null
+++ b/apps/swarmagents/lib/client/novnc.d.ts
@@ -0,0 +1,27 @@
+/**
+ * Minimal types for @novnc/novnc (1.7.0), which ships no TypeScript
+ * declarations. Only the RFB surface used by lib/client/useVmDisplay
+ * is typed here, verified against node_modules/@novnc/novnc/core/rfb.js.
+ *
+ * The package's exports field maps the package root to ./core/rfb.js,
+ * so the import specifier is "@novnc/novnc", not "@novnc/novnc/core/rfb".
+ */
+declare module "@novnc/novnc" {
+  export interface RfbOptions {
+    credentials?: Record<string, string>;
+    shared?: boolean;
+    repeaterID?: string;
+    wsProtocols?: string[];
+  }
+
+  export default class RFB extends EventTarget {
+    constructor(target: HTMLElement, url: string, options?: RfbOptions);
+    viewOnly: boolean;
+    scaleViewport: boolean;
+    showDotCursor: boolean;
+    focus(options?: FocusOptions): void;
+    disconnect(): void;
+    sendCtrlAltDel(): void;
+    clipboardPasteFrom(text: string): void;
+  }
+}
diff --git a/apps/swarmagents/lib/client/useVmDisplay.test.ts b/apps/swarmagents/lib/client/useVmDisplay.test.ts
new file mode 100644
index 000000000..5d5425340
--- /dev/null
+++ b/apps/swarmagents/lib/client/useVmDisplay.test.ts
@@ -0,0 +1,172 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  VM_DISPLAY_INITIAL_STATE,
+  parseVmDisplayAvailable,
+  vmDisplayCloseMessage,
+  vmDisplayReducer,
+  type VmDisplayState,
+} from "./useVmDisplay";
+
+function reduce(
+  state: VmDisplayState,
+  ...actions: Parameters<typeof vmDisplayReducer>[1][]
+): VmDisplayState {
+  return actions.reduce(vmDisplayReducer, state);
+}
+
+test("starts out checking for a display", () => {
+  assert.equal(VM_DISPLAY_INITIAL_STATE.status, "checking");
+  assert.equal(VM_DISPLAY_INITIAL_STATE.attempt, 0);
+});
+
+test("available moves checking to connecting, attempt reset", () => {
+  const next = vmDisplayReducer(VM_DISPLAY_INITIAL_STATE, { type: "available" });
+  assert.equal(next.status, "connecting");
+  assert.equal(next.attempt, 0);
+});
+
+test("unavailable shows the empty state and re-checks can connect", () => {
+  const unavailable = reduce(VM_DISPLAY_INITIAL_STATE, { type: "unavailable" });
+  assert.equal(unavailable.status, "unavailable");
+  const connected = vmDisplayReducer(unavailable, { type: "available" });
+  assert.equal(connected.status, "connecting");
+});
+
+test("connected carries the desktop name", () => {
+  const next = reduce(
+    VM_DISPLAY_INITIAL_STATE,
+    { type: "available" },
+    { type: "connected", desktopName: "agent-vm-01" },
+  );
+  assert.equal(next.status, "connected");
+  assert.equal(next.desktopName, "agent-vm-01");
+});
+
+test("a dropped connection reconnects with backoff, doubling each time", () => {
+  const connected = reduce(
+    VM_DISPLAY_INITIAL_STATE,
+    { type: "available" },
+    { type: "connected" },
+  );
+  const first = vmDisplayReducer(connected, { type: "disconnected", clean: false });
+  assert.equal(first.status, "reconnecting");
+  assert.equal(first.attempt, 1);
+  assert.equal(first.retryInMs, 500);
+
+  const retrying = vmDisplayReducer(first, { type: "retry" });
+  assert.equal(retrying.status, "connecting");
+  const second = vmDisplayReducer(retrying, { type: "disconnected", clean: false });
+  assert.equal(second.status, "reconnecting");
+  assert.equal(second.attempt, 2);
+  assert.equal(second.retryInMs, 1000);
+
+  // A clean server-side close with no code still reconnects.
+  const clean = vmDisplayReducer(retrying, { type: "disconnected", clean: true });
+  assert.equal(clean.status, "reconnecting");
+});
+
+test("backoff caps at 30s after many drops", () => {
+  let state = reduce(
+    VM_DISPLAY_INITIAL_STATE,
+    { type: "available" },
+    { type: "connected" },
+  );
+  for (let i = 0; i < 10; i++) {
+    state = vmDisplayReducer(state, { type: "disconnected", clean: false });
+    state = vmDisplayReducer(state, { type: "retry" });
+  }
+  state = vmDisplayReducer(state, { type: "disconnected", clean: false });
+  assert.equal(state.status, "reconnecting");
+  assert.equal(state.retryInMs, 30_000);
+});
+
+test("close codes 4401/4404/4503 are terminal errors with friendly messages", () => {
+  const connected = reduce(
+    VM_DISPLAY_INITIAL_STATE,
+    { type: "available" },
+    { type: "connected" },
+  );
+  for (const code of [4401, 4404, 4503] as const) {
+    const next = vmDisplayReducer(connected, { type: "disconnected", clean: false, code });
+    assert.equal(next.status, "error");
+    assert.equal(next.error, vmDisplayCloseMessage(code));
+    assert.ok(next.error && next.error.length > 0);
+  }
+  assert.match(vmDisplayCloseMessage(4401) ?? "", /denied|sign in/i);
+  assert.match(vmDisplayCloseMessage(4404) ?? "", /no live desktop|not.*found/i);
+  assert.match(vmDisplayCloseMessage(4503) ?? "", /busy/i);
+});
+
+test("unknown close codes reconnect instead of failing", () => {
+  const connected = reduce(
+    VM_DISPLAY_INITIAL_STATE,
+    { type: "available" },
+    { type: "connected" },
+  );
+  const next = vmDisplayReducer(connected, {
+    type: "disconnected",
+    clean: false,
+    code: 1006,
+  });
+  assert.equal(next.status, "reconnecting");
+  assert.equal(vmDisplayCloseMessage(1006), undefined);
+  assert.equal(vmDisplayCloseMessage(1000), undefined);
+});
+
+test("retry from an error re-checks availability first", () => {
+  const errored = reduce(
+    VM_DISPLAY_INITIAL_STATE,
+    { type: "available" },
+    { type: "connected" },
+    { type: "disconnected", clean: false, code: 4401 },
+  );
+  assert.equal(errored.status, "error");
+  const checking = vmDisplayReducer(errored, { type: "check" });
+  assert.equal(checking.status, "checking");
+  assert.equal(checking.error, undefined);
+  const connecting = vmDisplayReducer(checking, { type: "available" });
+  assert.equal(connecting.status, "connecting");
+});
+
+test("availability polls never disturb a live session", () => {
+  const connected = reduce(
+    VM_DISPLAY_INITIAL_STATE,
+    { type: "available" },
+    { type: "connected", desktopName: "agent-vm-01" },
+  );
+  // A stray "available" poll while connected is a no-op.
+  assert.equal(vmDisplayReducer(connected, { type: "available" }), connected);
+  // A stray "unavailable" poll while connected is a no-op.
+  assert.equal(vmDisplayReducer(connected, { type: "unavailable" }), connected);
+  // A desktop name arriving before connect is ignored.
+  const early = vmDisplayReducer(VM_DISPLAY_INITIAL_STATE, {
+    type: "desktopName",
+    name: "agent-vm-01",
+  });
+  assert.equal(early.desktopName, undefined);
+});
+
+test("disconnects while already reconnecting or unavailable are ignored", () => {
+  const unavailable = reduce(VM_DISPLAY_INITIAL_STATE, { type: "unavailable" });
+  assert.equal(
+    vmDisplayReducer(unavailable, { type: "disconnected", clean: false }),
+    unavailable,
+  );
+});
+
+test("parseVmDisplayAvailable reads the flag in its known shapes", () => {
+  assert.equal(parseVmDisplayAvailable({ available: true }), true);
+  assert.equal(parseVmDisplayAvailable({ available: false }), false);
+  assert.equal(parseVmDisplayAvailable({ display: true }), true);
+  assert.equal(parseVmDisplayAvailable({ status: "available" }), true);
+  assert.equal(parseVmDisplayAvailable({ status: "ready" }), true);
+  assert.equal(parseVmDisplayAvailable({ status: "running" }), true);
+  assert.equal(parseVmDisplayAvailable({ status: "unavailable" }), false);
+  assert.equal(parseVmDisplayAvailable({ status: "missing" }), false);
+  assert.equal(parseVmDisplayAvailable({ ok: true }), true);
+  assert.equal(parseVmDisplayAvailable({ ok: false }), false);
+  assert.equal(parseVmDisplayAvailable(null), undefined);
+  assert.equal(parseVmDisplayAvailable("yes"), undefined);
+  assert.equal(parseVmDisplayAvailable({ status: "weird" }), undefined);
+});
diff --git a/apps/swarmagents/lib/client/useVmDisplay.ts b/apps/swarmagents/lib/client/useVmDisplay.ts
new file mode 100644
index 000000000..98d8fb38d
--- /dev/null
+++ b/apps/swarmagents/lib/client/useVmDisplay.ts
@@ -0,0 +1,475 @@
+"use client";
+
+/**
+ * Live VM desktop display — state machine + noVNC (RFB) hook for the
+ * Screen tab (l4).
+ *
+ * The display proxy (l3) is not on main yet, so this is written against
+ * the specified contract and degrades cleanly until it lands:
+ *
+ *   - GET /api/runtime/vm/display says whether a display exists. A
+ *     non-OK response (404 while l3 is absent) or an explicit
+ *     `available: false` means "Desktop not available on this server"
+ *     and nothing throws.
+ *   - wss://<host>/api/runtime/vm/display/ws carries the RFB session.
+ *     noVNC 1.7's RFB only reports `{ clean }` on its `disconnect`
+ *     event — the WebSocket close code never reaches it — so the hook
+ *     also listens for `close` on the underlying socket (RFB's Websock
+ *     assigns `onclose`, which coexists with `addEventListener`) and
+ *     reads the code on a microtask after the RFB event fires. Close
+ *     codes 4401 / 4404 / 4503 map to friendly terminal errors; anything
+ *     else reconnects with the shared exponential backoff.
+ *
+ * The pure reducer (`vmDisplayReducer`) is the unit-tested state
+ * machine; the hook only wires timers, fetches, and RFB events to it.
+ *
+ * @novnc/novnc ships no TypeScript types (1.7.0). The ambient module
+ * declaration in ./novnc.d.ts types the small RFB surface this hook
+ * uses, verified against node_modules/@novnc/novnc/core/rfb.js. RFB is
+ * loaded with a dynamic `import()` inside the hook so the module (and
+ * the node-based unit tests) never evaluate noVNC on the server.
+ */
+
+import { useEffect, useReducer, useRef, useState, type RefObject } from "react";
+import { backoffDelayMs } from "./backoff";
+
+// @novnc/novnc ships no types; the ambient declaration lives in
+// ./novnc.d.ts. RFB is loaded with a dynamic `import()` inside the
+// hook so the module (and the node-based unit tests) never evaluate
+// noVNC on the server.
+
+/** Minimal structural view of RFB for the hook (and its tests). */
+export interface RfbConnection extends EventTarget {
+  viewOnly: boolean;
+  scaleViewport: boolean;
+  showDotCursor: boolean;
+  focus(options?: FocusOptions): void;
+  disconnect(): void;
+  clipboardPasteFrom(text: string): void;
+}
+
+export const VM_DISPLAY_HTTP_PATH = "/api/runtime/vm/display";
+export const VM_DISPLAY_WS_PATH = "/api/runtime/vm/display/ws";
+
+/** How often an unavailable display re-checks for a live desktop. */
+export const VM_DISPLAY_RECHECK_MS = 30_000;
+
+export type VmDisplayStatus =
+  | "checking"
+  | "unavailable"
+  | "connecting"
+  | "connected"
+  | "reconnecting"
+  | "error";
+
+export interface VmDisplayState {
+  status: VmDisplayStatus;
+  /** Desktop name reported by the VNC server, once connected. */
+  desktopName?: string;
+  /** Friendly error message when status is "error". */
+  error?: string;
+  /** Reconnect attempt count (0 = first connect). */
+  attempt: number;
+  /** ms until the next reconnect attempt, while reconnecting. */
+  retryInMs?: number;
+}
+
+export const VM_DISPLAY_INITIAL_STATE: VmDisplayState = {
+  status: "checking",
+  attempt: 0,
+};
+
+export type VmDisplayAction =
+  | { type: "check" }
+  | { type: "available" }
+  | { type: "unavailable" }
+  | { type: "connected"; desktopName?: string }
+  | { type: "desktopName"; name: string }
+  | { type: "disconnected"; clean: boolean; code?: number }
+  | { type: "retry" }
+  | { type: "failed"; message: string };
+
+/**
+ * Map a display-proxy WebSocket close code to a friendly terminal error.
+ * Returns undefined for codes that should reconnect instead of failing.
+ */
+export function vmDisplayCloseMessage(code: number): string | undefined {
+  switch (code) {
+    case 4401:
+      return "Access denied — this screen needs a signed-in session. Reload the page to sign in again.";
+    case 4404:
+      return "No live desktop was found on this server — the VM may not have started yet.";
+    case 4503:
+      return "The desktop service is busy right now. Try again in a moment.";
+    default:
+      return undefined;
+  }
+}
+
+/**
+ * Pure state machine for the display connection.
+ *
+ *  checking -> available -> connecting -> connected
+ *  checking -> unavailable (polls until a display appears)
+ *  connecting/connected -> disconnected -> reconnecting -> retry -> connecting
+ *  disconnected with a 4401/4404/4503 close code -> error (terminal)
+ *  error/unavailable -> check -> checking (manual retry)
+ *
+ * Availability polls never disturb a live session: `available` and
+ * `unavailable` are no-ops unless the machine is checking, unavailable,
+ * or in a terminal error.
+ */
+export function vmDisplayReducer(
+  state: VmDisplayState,
+  action: VmDisplayAction,
+): VmDisplayState {
+  switch (action.type) {
+    case "check":
+      return { ...state, status: "checking", error: undefined, retryInMs: undefined };
+    case "available":
+      if (
+        state.status === "checking" ||
+        state.status === "unavailable" ||
+        state.status === "error"
+      ) {
+        return {
+          ...state,
+          status: "connecting",
+          attempt: 0,
+          error: undefined,
+          retryInMs: undefined,
+        };
+      }
+      return state;
+    case "unavailable":
+      if (state.status === "checking") {
+        return { ...state, status: "unavailable", error: undefined, retryInMs: undefined };
+      }
+      return state;
+    case "connected":
+      return {
+        ...state,
+        status: "connected",
+        desktopName: action.desktopName ?? state.desktopName,
+        error: undefined,
+        retryInMs: undefined,
+      };
+    case "desktopName":
+      return state.status === "connected" ? { ...state, desktopName: action.name } : state;
+    case "disconnected": {
+      // Terminal close codes (auth / not-found / overloaded) fail
+      // outright instead of reconnecting forever.
+      const message =
+        action.code !== undefined ? vmDisplayCloseMessage(action.code) : undefined;
+      if (message !== undefined) {
+        return { ...state, status: "error", error: message, retryInMs: undefined };
+      }
+      if (state.status === "connected" || state.status === "connecting") {
+        const attempt = state.attempt + 1;
+        return {
+          ...state,
+          status: "reconnecting",
+          attempt,
+          retryInMs: backoffDelayMs(attempt - 1),
+        };
+      }
+      return state;
+    }
+    case "retry":
+      return { ...state, status: "connecting", error: undefined, retryInMs: undefined };
+    case "failed":
+      return { ...state, status: "error", error: action.message, retryInMs: undefined };
+  }
+}
+
+/** Read the availability flag out of a GET /api/runtime/vm/display body. */
+export function parseVmDisplayAvailable(data: unknown): boolean | undefined {
+  if (typeof data !== "object" || data === null) return undefined;
+  const d = data as Record<string, unknown>;
+  if (typeof d.available === "boolean") return d.available;
+  if (typeof d.display === "boolean") return d.display;
+  if (typeof d.status === "string") {
+    if (d.status === "available" || d.status === "ready" || d.status === "running") return true;
+    if (
+      d.status === "unavailable" ||
+      d.status === "missing" ||
+      d.status === "stopped" ||
+      d.status === "disabled"
+    ) {
+      return false;
+    }
+    return undefined;
+  }
+  if (typeof d.ok === "boolean") return d.ok;
+  return undefined;
+}
+
+/**
+ * Ask the server whether a live desktop exists. Any failure — non-OK
+ * status (the 404 while l3 is absent), unparseable body, network error —
+ * means "no display", never a throw.
+ */
+export async function checkVmDisplayAvailable(signal?: AbortSignal): Promise<boolean> {
+  try {
+    const res = await fetch(VM_DISPLAY_HTTP_PATH, { signal });
+    if (!res.ok) return false;
+    const data = await res.json().catch(() => null);
+    // A 200 with an unrecognised shape: try the WS and let it decide.
+    return parseVmDisplayAvailable(data) ?? true;
+  } catch {
+    return false;
+  }
+}
+
+/** wss://<host>/api/runtime/vm/display/ws (ws: on plain http). */
+export function vmDisplayWsUrl(): string {
+  const { protocol, host } = window.location;
+  return `${protocol === "https:" ? "wss:" : "ws:"}//${host}${VM_DISPLAY_WS_PATH}`;
+}
+
+/**
+ * Lightweight availability probe for callers that only need to know
+ * whether a display exists (e.g. App picking the default tab). Re-checks
+ * every VM_DISPLAY_RECHECK_MS so a display that appears later is seen.
+ */
+export function useVmDisplayAvailable(enabled = true): boolean {
+  const [available, setAvailable] = useState(false);
+
+  useEffect(() => {
+    if (!enabled) return;
+    let cancelled = false;
+    const load = async () => {
+      const ok = await checkVmDisplayAvailable();
+      if (!cancelled) setAvailable(ok);
+    };
+    void load();
+    const id = setInterval(() => void load(), VM_DISPLAY_RECHECK_MS);
+    return () => {
+      cancelled = true;
+      clearInterval(id);
+    };
+  }, [enabled]);
+
+  return available;
+}
+
+/**
+ * Reach the native WebSocket behind an RFB instance. noVNC's Websock
+ * keeps it at `_sock._websocket`; this is a private field, so anything
+ * missing just means no close-code capture (the hook still reconnects
+ * on RFB's own `disconnect` event).
+ */
+function nativeSocketOf(rfb: RfbConnection): WebSocket | undefined {
+  const sock = (rfb as unknown as { _sock?: { _websocket?: unknown } })._sock;
+  const ws = sock?._websocket;
+  return ws instanceof WebSocket ? ws : undefined;
+}
+
+export interface UseVmDisplayOptions {
+  /** Set false to keep the hook idle (e.g. the tab is not mounted). */
+  enabled?: boolean;
+}
+
+export interface UseVmDisplay {
+  state: VmDisplayState;
+  /** True once GET /api/runtime/vm/display has said a display exists. */
+  available: boolean;
+  /** True while the user holds mouse+keyboard control of the VM. */
+  hasControl: boolean;
+  /** Attach the noVNC canvas here. */
+  targetRef: RefObject<HTMLDivElement | null>;
+  /** Switch the session from view-only to interactive. */
+  takeControl(): void;
+  /** Give the desktop back to view-only mode. */
+  giveBack(): void;
+  /** Paste text into the VM's clipboard (needs control). */
+  pasteClipboard(text: string): void;
+  /** Re-check availability and reconnect (from error / unavailable). */
+  retry(): void;
+}
+
+export function useVmDisplay(options: UseVmDisplayOptions = {}): UseVmDisplay {
+  const { enabled = true } = options;
+  const [state, dispatch] = useReducer(vmDisplayReducer, VM_DISPLAY_INITIAL_STATE);
+  const [hasControl, setHasControl] = useState(false);
+  const targetRef = useRef<HTMLDivElement | null>(null);
+  const rfbRef = useRef<RfbConnection | null>(null);
+  const closeCodeRef = useRef<number | undefined>(undefined);
+
+  // Availability: poll while checking/unavailable only — never while a
+  // live session is up, so a flaky poll can't tear the desktop down.
+  useEffect(() => {
+    if (!enabled) return;
+    if (state.status !== "checking" && state.status !== "unavailable") return;
+    let cancelled = false;
+    const load = async () => {
+      const ok = await checkVmDisplayAvailable();
+      if (cancelled) return;
+      dispatch(ok ? { type: "available" } : { type: "unavailable" });
+    };
+    void load();
+    const id = setInterval(() => void load(), VM_DISPLAY_RECHECK_MS);
+    return () => {
+      cancelled = true;
+      clearInterval(id);
+    };
+  }, [enabled, state.status]);
+
+  // A new RFB session starts each time the machine enters "connecting".
+  // `session` is the stable key: status flips to "connected" must NOT
+  // tear the session down, so the effect keys on this, not the status.
+  const [session, setSession] = useState(0);
+  const prevStatusRef = useRef(state.status);
+  useEffect(() => {
+    if (state.status === "connecting" && prevStatusRef.current !== "connecting") {
+      setSession((s) => s + 1);
+    }
+    prevStatusRef.current = state.status;
+  }, [state.status]);
+
+  // Losing control follows the session, not the button: any disconnect
+  // drops back to view-only.
+  useEffect(() => {
+    if (state.status !== "connected") setHasControl(false);
+  }, [state.status]);
+
+  useEffect(() => {
+    if (!enabled || session === 0) return;
+    const target = targetRef.current;
+    if (!target) {
+      dispatch({ type: "failed", message: "The screen area isn't mounted yet." });
+      return;
+    }
+
+    let disposed = false;
+    let rfb: RfbConnection | null = null;
+    let socket: WebSocket | undefined;
+    let onNativeClose: ((e: CloseEvent) => void) | undefined;
+
+    const onConnect = () => {
+      if (!disposed) dispatch({ type: "connected" });
+    };
+    const onDesktopName = (e: Event) => {
+      const name = (e as CustomEvent<{ name?: unknown }>).detail?.name;
+      if (!disposed && typeof name === "string") dispatch({ type: "desktopName", name });
+    };
+    const onDisconnect = (e: Event) => {
+      const clean = (e as CustomEvent<{ clean?: unknown }>).detail?.clean === true;
+      // The native socket's `close` listener runs after RFB's own
+      // `onclose` handler in the same dispatch, so read the recorded
+      // code on a microtask — after the whole close event has fired.
+      queueMicrotask(() => {
+        if (disposed) return;
+        dispatch({ type: "disconnected", clean, code: closeCodeRef.current });
+        closeCodeRef.current = undefined;
+      });
+    };
+    const onSecurityFailure = (e: Event) => {
+      const detail = (e as CustomEvent<{ status?: unknown; reason?: unknown }>).detail;
+      const reason =
+        typeof detail?.reason === "string" ? detail.reason : "The desktop refused the connection.";
+      if (!disposed) dispatch({ type: "failed", message: reason });
+    };
+
+    const boot = async () => {
+      let RFB: new (
+        target: HTMLElement,
+        url: string,
+        options?: { shared?: boolean },
+      ) => RfbConnection;
+      try {
+        ({ default: RFB } = await import("@novnc/novnc"));
+      } catch {
+        if (!disposed) {
+          dispatch({ type: "failed", message: "Could not load the screen viewer." });
+        }
+        return;
+      }
+      if (disposed) return;
+      const instance = new RFB(target, vmDisplayWsUrl(), { shared: true });
+      instance.viewOnly = true;
+      instance.scaleViewport = true;
+      instance.showDotCursor = true;
+      rfb = instance;
+      rfbRef.current = instance;
+
+      // Capture the proxy's close code (4401/4404/4503) before RFB
+      // swallows it: Websock assigns `onclose`, so an added listener
+      // coexists with it.
+      socket = nativeSocketOf(instance);
+      if (socket) {
+        onNativeClose = (e: CloseEvent) => {
+          closeCodeRef.current = e.code;
+        };
+        socket.addEventListener("close", onNativeClose, { once: true });
+      }
+
+      instance.addEventListener("connect", onConnect);
+      instance.addEventListener("desktopname", onDesktopName);
+      instance.addEventListener("disconnect", onDisconnect);
+      instance.addEventListener("securityfailure", onSecurityFailure);
+    };
+    void boot();
+
+    return () => {
+      disposed = true;
+      if (socket && onNativeClose) socket.removeEventListener("close", onNativeClose);
+      if (rfb) {
+        rfb.removeEventListener("connect", onConnect);
+        rfb.removeEventListener("desktopname", onDesktopName);
+        rfb.removeEventListener("disconnect", onDisconnect);
+        rfb.removeEventListener("securityfailure", onSecurityFailure);
+        try {
+          rfb.disconnect();
+        } catch {
+          /* already disconnected */
+        }
+      }
+      if (rfbRef.current === rfb) rfbRef.current = null;
+    };
+  }, [enabled, session]);
+
+  // Reconnect timer: each drop waits backoffDelayMs(attempt) before the
+  // machine goes back to "connecting" and a fresh session starts.
+  useEffect(() => {
+    if (state.status !== "reconnecting" || state.retryInMs === undefined) return;
+    const id = setTimeout(() => dispatch({ type: "retry" }), state.retryInMs);
+    return () => clearTimeout(id);
+  }, [state.status, state.retryInMs]);
+
+  const takeControl = () => {
+    const rfb = rfbRef.current;
+    if (!rfb || state.status !== "connected") return;
+    rfb.viewOnly = false;
+    rfb.focus({ preventScroll: true });
+    setHasControl(true);
+  };
+
+  const giveBack = () => {
+    const rfb = rfbRef.current;
+    if (rfb) rfb.viewOnly = true;
+    setHasControl(false);
+  };
+
+  const pasteClipboard = (text: string) => {
+    if (!text) return;
+    rfbRef.current?.clipboardPasteFrom(text);
+  };
+
+  const retry = () => {
+    dispatch({ type: "check" });
+  };
+
+  return {
+    state,
+    // Past the availability check (connecting onward, including a
+    // terminal error) means a display exists; checking/unavailable does not.
+    available: state.status !== "checking" && state.status !== "unavailable",
+    hasControl,
+    targetRef,
+    takeControl,
+    giveBack,
+    pasteClipboard,
+    retry,
+  };
+}
