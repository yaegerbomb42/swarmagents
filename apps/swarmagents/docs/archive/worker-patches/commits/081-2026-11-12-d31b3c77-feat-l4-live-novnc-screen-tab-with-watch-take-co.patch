diff --git a/apps/swarmagents/minimalist-ui/src/components/ScreenView.tsx b/apps/swarmagents/minimalist-ui/src/components/ScreenView.tsx
new file mode 100644
index 000000000..200cdd88f
--- /dev/null
+++ b/apps/swarmagents/minimalist-ui/src/components/ScreenView.tsx
@@ -0,0 +1,264 @@
+"use client";
+
+/**
+ * ScreenView — the live noVNC view of the VM desktop (l4).
+ *
+ * Connects RFB to wss://<host>/api/runtime/vm/display/ws through
+ * `useVmDisplay` and renders the remote framebuffer scaled to fit
+ * while keeping its aspect ratio (`scaleViewport`).
+ *
+ * View-only by default ("Watching" pill). "Take control" hands the
+ * mouse+keyboard to the user with an amber "You have control" bar and
+ * a "Give back" button that returns to view-only. A clipboard paste
+ * button sends the system clipboard into the VM (control only), and a
+ * fullscreen button expands the viewport.
+ *
+ * States: connecting shows a skeleton + "Waking your computer…";
+ * reconnecting shows the retry countdown; an unavailable display
+ * (fake driver / l3 not on main yet) shows the empty state and nothing
+ * throws; terminal close codes surface their friendly message with a
+ * "Try again" button.
+ */
+
+import { useEffect, useRef, useState } from "react";
+import {
+  ClipboardPaste,
+  Eye,
+  Maximize,
+  Minimize,
+  Monitor,
+  MousePointer2,
+  RotateCcw,
+  TriangleAlert,
+} from "lucide-react";
+import { useVmDisplay } from "../../../lib/client/useVmDisplay";
+
+export function ScreenView() {
+  const display = useVmDisplay();
+  const { state } = display;
+  const wrapRef = useRef<HTMLDivElement | null>(null);
+  const [isFullscreen, setIsFullscreen] = useState(false);
+  const [pasteError, setPasteError] = useState<string | undefined>(undefined);
+  const [pasteBusy, setPasteBusy] = useState(false);
+
+  useEffect(() => {
+    const onChange = () => setIsFullscreen(Boolean(document.fullscreenElement));
+    document.addEventListener("fullscreenchange", onChange);
+    return () => document.removeEventListener("fullscreenchange", onChange);
+  }, []);
+
+  const toggleFullscreen = async () => {
+    const el = wrapRef.current;
+    if (!el) return;
+    try {
+      if (document.fullscreenElement) {
+        await document.exitFullscreen();
+      } else {
+        await el.requestFullscreen();
+      }
+    } catch {
+      // Fullscreen can be refused (iframe permissions, headless test
+      // envs) — the inline view keeps working, so stay silent.
+    }
+  };
+
+  const pasteFromClipboard = async () => {
+    if (!display.hasControl || pasteBusy) return;
+    setPasteBusy(true);
+    setPasteError(undefined);
+    try {
+      const text = await navigator.clipboard.readText();
+      if (!text) {
+        setPasteError("Clipboard is empty.");
+        return;
+      }
+      display.pasteClipboard(text);
+    } catch {
+      setPasteError("Couldn't read the clipboard — allow clipboard access and try again.");
+    } finally {
+      setPasteBusy(false);
+    }
+  };
+
+  const connected = state.status === "connected";
+  const retryInSeconds =
+    state.status === "reconnecting" && state.retryInMs !== undefined
+      ? Math.max(1, Math.ceil(state.retryInMs / 1000))
+      : undefined;
+
+  return (
+    <div ref={wrapRef} className="flex min-h-0 flex-1 flex-col bg-[#08080c]">
+      {/* Status bar: mode pill on the left, controls on the right. */}
+      <div className="flex items-center justify-between gap-2 border-b border-white/10 bg-[#0a0a10] px-3 py-2">
+        <div className="flex min-w-0 items-center gap-2">
+          {connected && !display.hasControl && (
+            <span className="inline-flex items-center gap-1.5 rounded-full border border-emerald-400/30 bg-emerald-500/15 px-2 py-0.5 text-[10px] font-mono uppercase tracking-wide text-emerald-300">
+              <Eye className="h-3 w-3" /> Watching
+              {state.desktopName ? (
+                <span className="normal-case tracking-normal text-emerald-300/70">
+                  · {state.desktopName}
+                </span>
+              ) : null}
+            </span>
+          )}
+          {connected && display.hasControl && (
+            <span className="inline-flex items-center gap-1.5 rounded-full border border-amber-400/40 bg-amber-500/20 px-2 py-0.5 text-[10px] font-mono uppercase tracking-wide text-amber-300">
+              <MousePointer2 className="h-3 w-3" /> You have control
+            </span>
+          )}
+          {state.status === "connecting" && (
+            <span className="inline-flex items-center gap-1.5 rounded-full border border-sky-400/30 bg-sky-500/15 px-2 py-0.5 text-[10px] font-mono uppercase tracking-wide text-sky-300">
+              <span className="h-1.5 w-1.5 animate-pulse rounded-full bg-sky-400" />
+              Connecting
+            </span>
+          )}
+          {state.status === "reconnecting" && (
+            <span className="inline-flex items-center gap-1.5 rounded-full border border-amber-400/30 bg-amber-500/15 px-2 py-0.5 text-[10px] font-mono uppercase tracking-wide text-amber-300">
+              <span className="h-1.5 w-1.5 animate-pulse rounded-full bg-amber-400" />
+              Reconnecting{retryInSeconds ? ` in ${retryInSeconds}s` : "…"}
+            </span>
+          )}
+          {state.status === "checking" && (
+            <span className="inline-flex items-center gap-1.5 rounded-full border border-white/15 bg-white/5 px-2 py-0.5 text-[10px] font-mono uppercase tracking-wide text-white/50">
+              <span className="h-1.5 w-1.5 animate-pulse rounded-full bg-white/50" />
+              Checking display
+            </span>
+          )}
+          {state.status === "unavailable" && (
+            <span className="inline-flex items-center gap-1.5 rounded-full border border-white/15 bg-white/5 px-2 py-0.5 text-[10px] font-mono uppercase tracking-wide text-white/50">
+              <Monitor className="h-3 w-3" /> No desktop
+            </span>
+          )}
+          {state.status === "error" && (
+            <span className="inline-flex items-center gap-1.5 rounded-full border border-rose-400/30 bg-rose-500/15 px-2 py-0.5 text-[10px] font-mono uppercase tracking-wide text-rose-300">
+              <TriangleAlert className="h-3 w-3" /> Screen error
+            </span>
+          )}
+        </div>
+
+        <div className="flex shrink-0 items-center gap-1.5">
+          {connected && !display.hasControl && (
+            <button
+              type="button"
+              onClick={display.takeControl}
+              className="inline-flex items-center gap-1.5 rounded-full border border-amber-400/40 bg-amber-500/15 px-2.5 py-1 text-[11px] font-mono text-amber-300 transition-colors hover:bg-amber-500/25"
+            >
+              <MousePointer2 className="h-3 w-3" /> Take control
+            </button>
+          )}
+          {connected && display.hasControl && (
+            <button
+              type="button"
+              onClick={display.giveBack}
+              className="inline-flex items-center gap-1.5 rounded-full border border-white/20 bg-white/10 px-2.5 py-1 text-[11px] font-mono text-white/80 transition-colors hover:bg-white/15"
+            >
+              Give back
+            </button>
+          )}
+          <button
+            type="button"
+            onClick={() => void pasteFromClipboard()}
+            disabled={!connected || !display.hasControl || pasteBusy}
+            title={display.hasControl ? "Paste clipboard into the VM" : "Take control to paste"}
+            aria-label="Paste clipboard into the VM"
+            className="inline-flex items-center gap-1.5 rounded-full border border-white/15 bg-white/5 px-2.5 py-1 text-[11px] font-mono text-white/70 transition-colors hover:bg-white/10 disabled:cursor-not-allowed disabled:opacity-40"
+          >
+            <ClipboardPaste className="h-3 w-3" /> Paste
+          </button>
+          <button
+            type="button"
+            onClick={() => void toggleFullscreen()}
+            aria-label={isFullscreen ? "Exit fullscreen" : "Fullscreen screen"}
+            title={isFullscreen ? "Exit fullscreen" : "Fullscreen"}
+            className="inline-flex items-center rounded-full border border-white/15 bg-white/5 p-1.5 text-white/70 transition-colors hover:bg-white/10"
+          >
+            {isFullscreen ? <Minimize className="h-3.5 w-3.5" /> : <Maximize className="h-3.5 w-3.5" />}
+          </button>
+        </div>
+      </div>
+
+      {/* Control banner: what "You have control" means, and how to end it. */}
+      {connected && display.hasControl && (
+        <div className="flex items-center justify-between gap-2 border-b border-amber-400/25 bg-amber-500/10 px-3 py-1.5 text-[11px] font-mono text-amber-200/90">
+          <span>Your mouse and keyboard are driving the VM — clicks and keys go to the desktop.</span>
+          <button
+            type="button"
+            onClick={display.giveBack}
+            className="shrink-0 rounded-full border border-amber-400/40 px-2 py-0.5 text-[10px] uppercase tracking-wide text-amber-300 hover:bg-amber-500/20"
+          >
+            Give back
+          </button>
+        </div>
+      )}
+
+      {/* Viewport: noVNC mounts its canvas here and scales it to fit. */}
+      <div className="relative min-h-0 flex-1 bg-black">
+        <div ref={display.targetRef} className="absolute inset-0 overflow-hidden [&_canvas]:block" />
+
+        {/* Connecting / checking skeleton over the (empty) viewport. */}
+        {(state.status === "connecting" || state.status === "checking") && (
+          <div className="pointer-events-none absolute inset-0 flex flex-col items-center justify-center gap-3 bg-[#08080c]">
+            <div className="h-24 w-3/4 animate-pulse rounded-xl bg-white/5" />
+            <div className="h-3 w-1/2 animate-pulse rounded bg-white/5" />
+            <div className="mt-1 flex items-center gap-2 text-xs font-mono text-white/50">
+              <span className="h-2 w-2 animate-pulse rounded-full bg-sky-400" />
+              {state.status === "connecting" ? "Waking your computer…" : "Checking for a live desktop…"}
+            </div>
+          </div>
+        )}
+
+        {/* Reconnecting: keep the last frame visible underneath, if any. */}
+        {state.status === "reconnecting" && (
+          <div className="absolute inset-x-0 bottom-0 flex items-center justify-center gap-2 bg-black/70 px-3 py-2 text-[11px] font-mono text-amber-200/90">
+            <RotateCcw className="h-3 w-3 animate-spin" />
+            Connection lost — retrying{retryInSeconds ? ` in ${retryInSeconds}s` : ""}…
+            <button
+              type="button"
+              onClick={display.retry}
+              className="rounded-full border border-amber-400/40 px-2 py-0.5 text-[10px] uppercase tracking-wide text-amber-300 hover:bg-amber-500/20"
+            >
+              Retry now
+            </button>
+          </div>
+        )}
+
+        {/* Unavailable: the fake-driver / no-l3-yet empty state. */}
+        {state.status === "unavailable" && (
+          <div className="absolute inset-0 flex flex-col items-center justify-center gap-2 px-6 py-10 text-center">
+            <Monitor className="h-5 w-5 text-white/25" />
+            <div className="text-xs font-medium text-white/50">Desktop not available on this server</div>
+            <div className="max-w-xs text-[11px] leading-relaxed text-white/30">
+              This server doesn&apos;t expose a live desktop — for example, the
+              simulated driver has no real VM to show. The Terminal tab still
+              works.
+            </div>
+          </div>
+        )}
+
+        {/* Terminal error (4401 / 4404 / 4503 / load failure). */}
+        {state.status === "error" && (
+          <div className="absolute inset-0 flex flex-col items-center justify-center gap-2 px-6 py-10 text-center">
+            <TriangleAlert className="h-5 w-5 text-rose-400/70" />
+            <div className="text-xs font-medium text-white/70">Couldn&apos;t show the desktop</div>
+            <div className="max-w-xs text-[11px] leading-relaxed text-white/40">
+              {state.error ?? "The screen connection failed."}
+            </div>
+            <button
+              type="button"
+              onClick={display.retry}
+              className="mt-1 inline-flex items-center gap-1.5 rounded-full border border-white/20 bg-white/10 px-3 py-1 text-[11px] font-mono text-white/80 transition-colors hover:bg-white/15"
+            >
+              <RotateCcw className="h-3 w-3" /> Try again
+            </button>
+          </div>
+        )}
+      </div>
+
+      {pasteError && (
+        <div className="border-t border-amber-500/20 bg-amber-500/10 px-3 py-1.5 font-mono text-[11px] text-amber-200/90">
+          {pasteError}
+        </div>
+      )}
+    </div>
+  );
+}
