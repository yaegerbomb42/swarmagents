diff --git a/apps/swarmagents/lib/harness/runner.test.ts b/apps/swarmagents/lib/harness/runner.test.ts
index 4e1ca0216..a9d534433 100644
--- a/apps/swarmagents/lib/harness/runner.test.ts
+++ b/apps/swarmagents/lib/harness/runner.test.ts
@@ -7,7 +7,7 @@
  */
 import test from "node:test";
 import assert from "node:assert/strict";
-import { ClaudeCodeRunner } from "./runner.js";
+import { CLAUDE_MCP_CONFIG_PATH, ClaudeCodeRunner } from "./runner.js";
 import type { TelemetryEvent, VmExec, VmExecOpts } from "./types.js";
 
 const SECRET_TOKEN = "sk-ant-api03-BENCH-FAKE-TOKEN-0000";
@@ -616,3 +616,150 @@ test("keeps -p and places a dash-leading prompt after --", async () => {
   assert.ok(cmd.includes("stream-json"));
   assert.ok(cmd.includes("--verbose"));
 });
+
+// --- Desktop mode (SWARM_VM_DESKTOP=1): Playwright MCP on the visible Chromium ---
+
+/** Run `fn` with SWARM_VM_DESKTOP set/unset, restoring the previous value after. */
+async function withDesktopMode(value: string | undefined, fn: () => Promise<void>): Promise<void> {
+  const prev = process.env.SWARM_VM_DESKTOP;
+  try {
+    if (value === undefined) delete process.env.SWARM_VM_DESKTOP;
+    else process.env.SWARM_VM_DESKTOP = value;
+    await fn();
+  } finally {
+    if (prev === undefined) delete process.env.SWARM_VM_DESKTOP;
+    else process.env.SWARM_VM_DESKTOP = prev;
+  }
+}
+
+test("desktop mode on: argv adds --mcp-config for the visible-Chromium Playwright config", async () => {
+  await withDesktopMode("1", async () => {
+    const vm = new ScriptedVm([{ chunks: [FIXTURE] }]);
+    const runner = new ClaudeCodeRunner({ bin: "claude" });
+
+    const outcome = await runner.run({ prompt: "Browse the site", env: {}, vm }, () => {});
+
+    assert.equal(outcome.exitCode, 0);
+    assert.deepEqual(vm.calls[0].cmd, [
+      "claude",
+      "-p",
+      "--output-format",
+      "stream-json",
+      "--verbose",
+      "--mcp-config",
+      CLAUDE_MCP_CONFIG_PATH,
+      "--",
+      "Browse the site",
+    ]);
+    assert.equal(CLAUDE_MCP_CONFIG_PATH, "/etc/swarm/claude-mcp.json");
+  });
+});
+
+test("desktop mode on with a role: both --mcp-config flags, role config first", async () => {
+  await withDesktopMode("1", async () => {
+    const vm = new ScriptedVm([{ chunks: [FIXTURE] }]);
+    const runner = new ClaudeCodeRunner({ bin: "claude" });
+
+    const outcome = await runner.run(
+      {
+        prompt: "Browse the site",
+        env: {},
+        vm,
+        rolePhase: {
+          roleId: "engineer",
+          roleName: "Engineer",
+          allowedTools: ["Read"],
+          mcpConfigPath: "/workspace/.swarm/mcp.json",
+        },
+      },
+      () => {},
+    );
+
+    assert.equal(outcome.exitCode, 0);
+    const cmd = vm.calls[0].cmd;
+    // The role config comes first; the CDP Playwright config second, so its
+    // `playwright` server wins over the role config's own-chromium entry.
+    const configs = cmd.filter((arg, i) => cmd[i - 1] === "--mcp-config");
+    assert.deepEqual(configs, ["/workspace/.swarm/mcp.json", "/etc/swarm/claude-mcp.json"]);
+    assert.equal(cmd[cmd.length - 2], "--");
+    assert.equal(cmd[cmd.length - 1], "Browse the site");
+  });
+});
+
+test("desktop mode off: argv has no --mcp-config and is unchanged", async () => {
+  await withDesktopMode(undefined, async () => {
+    const vm = new ScriptedVm([{ chunks: [FIXTURE] }]);
+    const runner = new ClaudeCodeRunner({ bin: "claude" });
+
+    const outcome = await runner.run({ prompt: "Browse the site", env: {}, vm }, () => {});
+
+    assert.equal(outcome.exitCode, 0);
+    assert.deepEqual(vm.calls[0].cmd, [
+      "claude",
+      "-p",
+      "--output-format",
+      "stream-json",
+      "--verbose",
+      "--",
+      "Browse the site",
+    ]);
+  });
+});
+
+test("redacts secrets in mcp__playwright__ tool calls (stream-json + redaction)", async () => {
+  // The visible-browser config names its server `playwright`, so its tools
+  // arrive as mcp__playwright__* — the generic stream-json parser and the
+  // deep redactor must handle those names exactly like any other tool call.
+  const PLAYWRIGHT_CALLS = [
+    {
+      type: "assistant",
+      message: {
+        id: "p1",
+        content: [{
+          type: "tool_use",
+          id: "tu_p1",
+          name: "mcp__playwright__browser_type",
+          input: { element: "password field", text: `hunter2 ${PLAIN_SECRET}` },
+        }],
+      },
+    },
+    {
+      type: "user",
+      message: { role: "user", content: [{ type: "tool_result", tool_use_id: "tu_p1", content: "typed", is_error: false }] },
+    },
+    {
+      type: "assistant",
+      message: {
+        id: "p2",
+        content: [{
+          type: "tool_use",
+          id: "tu_p2",
+          name: "mcp__playwright__browser_navigate",
+          input: { url: "https://example.com" },
+        }],
+      },
+    },
+    {
+      type: "user",
+      message: { role: "user", content: [{ type: "tool_result", tool_use_id: "tu_p2", content: "done", is_error: false }] },
+    },
+  ];
+  const lines = [INIT, ...PLAYWRIGHT_CALLS, M6, RESULT].map((l) => JSON.stringify(l));
+  const vm = new ScriptedVm([{ chunks: [lines.join("\n") + "\n"] }]);
+  const runner = new ClaudeCodeRunner();
+  const events: TelemetryEvent[] = [];
+
+  const outcome = await runner.run({ prompt: "browse", env: envWithSecrets, vm }, (e) => events.push(e));
+
+  assert.equal(outcome.exitCode, 0);
+  const calls = events.filter((e): e is Extract<TelemetryEvent, { type: "tool.call" }> => e.type === "tool.call");
+  assert.equal(calls.length, 2);
+  assert.equal(calls[0].name, "mcp__playwright__browser_type");
+  assert.deepEqual(calls[0].input, { element: "password field", text: "hunter2 [REDACTED]" });
+  assert.equal(calls[1].name, "mcp__playwright__browser_navigate");
+  assert.deepEqual(calls[1].input, { url: "https://example.com" });
+  for (const event of events) {
+    assert.ok(!JSON.stringify(event).includes(PLAIN_SECRET), "playwright call leaked the secret");
+    assert.ok(!JSON.stringify(event).includes(SECRET_TOKEN), "playwright call leaked the API key");
+  }
+});
diff --git a/apps/swarmagents/lib/harness/runner.ts b/apps/swarmagents/lib/harness/runner.ts
index 5af58521e..b5862ed5a 100644
--- a/apps/swarmagents/lib/harness/runner.ts
+++ b/apps/swarmagents/lib/harness/runner.ts
@@ -31,7 +31,7 @@ import type {
 import { createStreamJsonParser } from "./stream-json";
 import { makeRedactor, redactValue } from "./redact";
 import { classifyToolCall } from "./risk";
-import { isRoleListTool, isRoleSwitchTool, ROLE_MCP_CONFIG_PATH } from "./role-mcp";
+import { desktopModeEnabled, isRoleListTool, isRoleSwitchTool, ROLE_MCP_CONFIG_PATH } from "./role-mcp";
 import { computerActionEvent, isDesktopMcpCall } from "./computer-mcp";
 
 export interface ClaudeCodeRunnerOptions {
@@ -39,6 +39,14 @@ export interface ClaudeCodeRunnerOptions {
   bin?: string;
 }
 
+/**
+ * Path (inside the VM) of the Playwright MCP config shipped in the VM image
+ * (vm-image/claude-mcp.json). Its `playwright` server attaches to the visible
+ * Chromium via CDP instead of launching a headless browser, so the agent's
+ * browsing happens on the screen the user watches.
+ */
+export const CLAUDE_MCP_CONFIG_PATH = "/etc/swarm/claude-mcp.json";
+
 interface FinalResultMeta {
   sessionId?: string;
   costUsd?: number;
@@ -488,6 +496,13 @@ export class ClaudeCodeRunner {
       argv.push("--allowedTools", ...role.allowedTools);
       argv.push("--mcp-config", role.mcpConfigPath);
     }
+    // Desktop mode (SWARM_VM_DESKTOP=1): pass the image's Playwright MCP
+    // config so the agent drives the visible Chromium via CDP. It goes after
+    // the role config so its `playwright` server wins over the role config's
+    // own-chromium entry when both are present; argv is unchanged otherwise.
+    if (desktopModeEnabled()) {
+      argv.push("--mcp-config", CLAUDE_MCP_CONFIG_PATH);
+    }
     const appended = [request.agentCard, role?.appendSystemPrompt].filter(Boolean).join("\n\n");
     if (appended) argv.push("--append-system-prompt", appended);
     argv.push("--", request.prompt);
diff --git a/apps/swarmagents/vm-image/Dockerfile b/apps/swarmagents/vm-image/Dockerfile
index 9ba830bcb..a21697354 100644
--- a/apps/swarmagents/vm-image/Dockerfile
+++ b/apps/swarmagents/vm-image/Dockerfile
@@ -49,6 +49,14 @@ RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
     && npm ls -g --depth=0 @anthropic-ai/claude-code \
     && (claude --version || echo "warning: 'claude --version' failed in the build" >&2)
 
+# Pinned Playwright MCP — the agent's browser driver. Same version as the
+# desktop image pins (vm-image-desktop/Dockerfile): bump deliberately in both
+# places, never track "latest". The desktop image inherits this layer, so its
+# own install of the same version is a no-op.
+RUN npm install -g "@playwright/mcp@0.0.85" \
+    && npm cache clean --force \
+    && npm ls -g --depth=0 @playwright/mcp
+
 # Managed (admin-owned) Claude Code settings: pre-allow the standard tools so
 # a headless `claude -p` can actually act. The app's own risk gate
 # (lib/harness/risk.ts) still classifies every tool call the agent makes and
@@ -57,6 +65,17 @@ COPY managed-settings.json /etc/claude-code/managed-settings.json
 RUN chmod 0444 /etc/claude-code/managed-settings.json \
     && chown root:root /etc/claude-code/managed-settings.json
 
+# Playwright MCP config for the visible desktop browser: the `playwright`
+# server attaches to the persistent Chromium on DISPLAY :1 via its CDP
+# endpoint instead of launching a headless browser of its own, so every
+# navigate/click/type happens on the screen the user watches. The runner
+# passes this file with --mcp-config when SWARM_VM_DESKTOP=1
+# (lib/harness/runner.ts); the endpoint itself is provided by the desktop
+# image (vm-image-desktop), not this one.
+COPY claude-mcp.json /etc/swarm/claude-mcp.json
+RUN chmod 0444 /etc/swarm/claude-mcp.json \
+    && chown root:root /etc/swarm/claude-mcp.json
+
 # The driver mounts a per-user named volume at /workspace; docker seeds a
 # fresh named volume from the image's directory, so /workspace must be owned
 # by the unprivileged `node` user (uid 1000) that ships with the base image.
diff --git a/apps/swarmagents/vm-image/claude-mcp.json b/apps/swarmagents/vm-image/claude-mcp.json
new file mode 100644
index 000000000..7d7151227
--- /dev/null
+++ b/apps/swarmagents/vm-image/claude-mcp.json
@@ -0,0 +1,12 @@
+{
+  "mcpServers": {
+    "playwright": {
+      "type": "stdio",
+      "command": "playwright-mcp",
+      "args": [
+        "--cdp-endpoint",
+        "http://127.0.0.1:9222"
+      ]
+    }
+  }
+}
