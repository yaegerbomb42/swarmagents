+/**
+ * GET/PATCH/DELETE /api/library/tools/[id]
+ *
+ * Edit and delete a custom tool. Secrets omitted on PATCH keep their saved
+ * value; the response only ever carries last-4 masks.
+ */
+
+import { NextResponse } from "next/server";
+import {
+  deleteUserTool,
+  listUserTools,
+  updateUserTool,
+} from "../../../../../lib/library/store";
+import {
+  NO_STORE,
+  errorResponse,
+  libraryOwner,
+  readJsonBody,
+  unauthorized,
+} from "../../../../../lib/library/api";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+interface RouteContext {
+  params: Promise<{ id: string }>;
+}
+
+async function routeId(ctx: RouteContext): Promise<string> {
+  const params = await Promise.resolve(ctx.params);
+  return typeof params?.id === "string" ? params.id : "";
+}
+
+export async function GET(request: Request, ctx: RouteContext) {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    const id = await routeId(ctx);
+    const tool = listUserTools(owner).find((candidate) => candidate.id === id);
+    if (!tool) return NextResponse.json({ error: "Unknown tool." }, { status: 404, headers: NO_STORE });
+    return NextResponse.json({ tool }, { headers: NO_STORE });
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
+
+export async function PATCH(request: Request, ctx: RouteContext) {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    const id = await routeId(ctx);
+    const body = await readJsonBody(request);
+    const tool = updateUserTool(owner, id, body.tool !== undefined ? body.tool : body);
+    return NextResponse.json({ tool }, { headers: NO_STORE });
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
+
+export async function DELETE(request: Request, ctx: RouteContext) {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    const id = await routeId(ctx);
+    deleteUserTool(owner, id);
+    return NextResponse.json({ ok: true }, { headers: NO_STORE });
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
