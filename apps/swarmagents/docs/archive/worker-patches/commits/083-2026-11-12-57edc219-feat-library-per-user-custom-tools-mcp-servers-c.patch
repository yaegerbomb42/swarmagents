+// ---------------------------------------------------------------------------
+// MCP servers
+// ---------------------------------------------------------------------------
+
+interface McpDraft {
+  id: string;
+  title: string;
+  description: string;
+  transport: McpTransport;
+  command: string;
+  args: string;
+  url: string;
+  headers: ToolHeader[];
+  env: ToolHeader[];
+  secrets: ToolHeader[];
+}
+
+function emptyMcpDraft(): McpDraft {
+  return {
+    id: "",
+    title: "",
+    description: "",
+    transport: "stdio",
+    command: "",
+    args: "",
+    url: "",
+    headers: [],
+    env: [],
+    secrets: [],
+  };
+}
+
+function McpTab({
+  snapshot,
+  query,
+  reload,
+  onNotice,
+}: {
+  snapshot: LibrarySnapshot;
+  query: string;
+  reload: () => Promise<void>;
+  onNotice: (text: string, tone: "ok" | "error") => void;
+}) {
+  const [adding, setAdding] = useState(false);
+  const [saving, setSaving] = useState(false);
+  const [draft, setDraft] = useState<McpDraft>(emptyMcpDraft);
+  const decorations = useMemo(() => {
+    const q = query.trim().toLowerCase();
+    const all = snapshot.catalogs.mcpServers;
+    if (!q) return all;
+    return all.filter((entry) =>
+      [entry.title, entry.category, entry.description, entry.id].some((v) => v.toLowerCase().includes(q)),
+    );
+  }, [snapshot.catalogs.mcpServers, query]);
+  const [values, setValues] = useState<Record<string, Record<string, string>>>({});
+
+  const toggle = async (server: UserMcpServerRow) => {
+    try {
+      await api("/api/library/mcp-servers", {
+        method: "PATCH",
