+/**
+ * The generated user-tools MCP server.
+ *
+ * Before every role-driven run the runtime seeds a small stdio MCP server, a
+ * spec of the user's enabled tools, and a secrets file into the user's VM.
+ * The server exposes each tool as an MCP tool, so the agent sees the user's
+ * tools in the same tool list as the built-ins. Nothing executes on the host:
+ * script tools spawn an interpreter inside the VM and HTTP tools fetch from
+ * the VM with the SSRF guards embedded below.
+ *
+ * The agent can also call `create_tool` to add a tool for itself; it is
+ * appended to a JSONL file the host merges into the user's library after the
+ * run (see store.mergeAgentCreatedTools).
+ */
+
+import type { UserTool } from "./types";
+
+export const USER_TOOLS_MCP_SERVER_NAME = "user-tools";
+export const USER_TOOLS_CREATE_TOOL = "create_tool";
+
+/** Paths inside the user's VM. */
+export const USER_TOOLS_MCP_SERVER_PATH = "/workspace/.swarm/user-tools-server.mjs";
+export const USER_TOOLS_SPEC_PATH = "/workspace/.swarm/user-tools.json";
+export const USER_TOOLS_SECRETS_PATH = "/workspace/.swarm/user-tools-secrets.json";
+export const USER_TOOLS_CREATED_PATH = "/workspace/.swarm/user-tools-created.jsonl";
+export const USER_TOOLS_RUN_DIR = "/workspace/.swarm/run";
+
+/** Public spec (no secret values) for the VM server. */
+export function buildUserToolsSpec(tools: readonly UserTool[]): string {
+  return JSON.stringify(
+    {
+      version: 1,
+      tools: tools.map((tool) => ({
+        id: tool.id,
+        title: tool.title,
+        description: tool.description,
+        inputSchema: tool.inputSchema,
+        kind: tool.kind,
+        ...(tool.script ? { script: tool.script } : {}),
+        ...(tool.http ? { http: tool.http } : {}),
+        timeoutMs: tool.timeoutMs,
+        maxOutputBytes: tool.maxOutputBytes,
+        enabled: tool.enabled,
+      })),
+    },
+    null,
+    2,
+  );
+}
+
+/** Secret values keyed by tool id. Written into the VM, never to a client. */
+export function buildUserToolsSecrets(
+  tools: ReadonlyArray<UserTool & { secrets?: Record<string, string> }>,
+): string {
+  const out: Record<string, Record<string, string>> = {};
+  for (const tool of tools) {
+    if (tool.secrets && Object.keys(tool.secrets).length > 0) out[tool.id] = tool.secrets;
+  }
+  return JSON.stringify({ tools: out }, null, 2);
+}
+
+/** The `--mcp-config` entry for the generated server. */
+export function userToolsMcpServerEntry(): Record<string, unknown> {
+  return {
+    type: "stdio",
+    command: "node",
+    args: [USER_TOOLS_MCP_SERVER_PATH],
+    env: {
+      SWARM_USER_TOOLS_SPEC: USER_TOOLS_SPEC_PATH,
+      SWARM_USER_TOOLS_SECRETS: USER_TOOLS_SECRETS_PATH,
+      SWARM_USER_TOOLS_CREATED: USER_TOOLS_CREATED_PATH,
+      SWARM_USER_TOOLS_RUN_DIR: USER_TOOLS_RUN_DIR,
+    },
+  };
+}
+
+/** Seed files to write into the VM before a run. */
+export function userToolsSeedFiles(
+  tools: ReadonlyArray<UserTool & { secrets?: Record<string, string> }>,
+): Array<{ path: string; content: string }> {
+  return [
+    { path: USER_TOOLS_MCP_SERVER_PATH, content: USER_TOOLS_MCP_SERVER_SOURCE },
+    { path: USER_TOOLS_SPEC_PATH, content: buildUserToolsSpec(tools) },
+    { path: USER_TOOLS_SECRETS_PATH, content: buildUserToolsSecrets(tools) },
+  ];
+}
+
+/** Parse the JSONL the agent appended with create_tool. Bad lines are skipped. */
+export function parseCreatedToolLines(text: string): unknown[] {
+  const out: unknown[] = [];
+  for (const line of text.split("\n")) {
+    const trimmed = line.trim();
+    if (!trimmed) continue;
+    try {
+      out.push(JSON.parse(trimmed));
+    } catch {
+      // A truncated/partial line is ignored; the rest still merge.
+    }
+  }
+  return out;
+}
+
+/** The command the host runs for a "Try it" call (same code path as MCP). */
+export function userToolRunArgv(toolId: string): string[] {
+  return ["node", USER_TOOLS_MCP_SERVER_PATH, "--run", toolId];
+}
+
+/**
+ * Generated server source (written verbatim into the VM as `.mjs`).
+ *
+ * Node ESM, newline-delimited JSON-RPC 2.0 on stdin/stdout. No dependencies.
+ */
+export const USER_TOOLS_MCP_SERVER_SOURCE = `#!/usr/bin/env node
+// SwarmAgents user-tools MCP stdio server (auto-generated; do not edit).
+import fs from "node:fs";
+import { spawn } from "node:child_process";
+import { lookup } from "node:dns/promises";
+import { isIP } from "node:net";
+import path from "node:path";
+
+const specPath = process.env.SWARM_USER_TOOLS_SPEC || "";
+const secretsPath = process.env.SWARM_USER_TOOLS_SECRETS || "";
+const createdPath = process.env.SWARM_USER_TOOLS_CREATED || "/workspace/.swarm/user-tools-created.jsonl";
+const runDir = process.env.SWARM_USER_TOOLS_RUN_DIR || "/workspace/.swarm/run";
+const workspace = process.env.SWARM_USER_TOOLS_CWD || "/workspace";
+const HARD_MAX_OUTPUT = 1000000;
+const HARD_MAX_TIMEOUT = 60000;
+
+const spec = readJson(specPath, { tools: [] });
+const secretFile = readJson(secretsPath, { tools: {} });
+const secretsByTool = secretFile && typeof secretFile.tools === "object" ? secretFile.tools : {};
+
+function readJson(file, fallback) {
+  try { return JSON.parse(fs.readFileSync(file, "utf8")); } catch (err) { return fallback; }
+}
+
+function secretsFor(id) {
+  const map = secretsByTool[id];
+  return map && typeof map === "object" ? map : {};
+}
+
+function loadTools() {
+  const map = new Map();
+  const list = spec && Array.isArray(spec.tools) ? spec.tools : [];
+  for (const tool of list) if (tool && typeof tool.id === "string") map.set(tool.id, tool);
+  try {
+    const text = fs.readFileSync(createdPath, "utf8");
+    for (const line of text.split("\\n")) {
+      if (!line.trim()) continue;
+      try {
+        const tool = JSON.parse(line);
+        if (tool && typeof tool.id === "string" && map.size < 200) map.set(tool.id, tool);
+      } catch (err) { /* skip a partial line */ }
+    }
+  } catch (err) { /* no agent-created tools yet */ }
+  return map;
+}
+
+let toolMap = loadTools();
+
+function toolDefs() {
+  toolMap = loadTools();
+  const defs = [];
+  for (const tool of toolMap.values()) {
+    if (!tool || tool.id === "create_tool") continue;
+    defs.push({
+      name: tool.id,
+      description: (tool.description || tool.title || tool.id) + " (custom user tool; args are a JSON object)",
+      inputSchema: tool.inputSchema || { type: "object", properties: {} }
+    });
+  }
+  defs.push({
+    name: "create_tool",
+    description: "Create a new custom tool for yourself. Script tools run inside this VM: bash, node or python with the JSON args on stdin and stdout as the result. The tool becomes callable immediately and is saved to the user's Library.",
+    inputSchema: {
+      type: "object",
+      properties: {
+        name: { type: "string", description: "Lowercase tool id (a-z, 0-9, underscore)." },
+        title: { type: "string", description: "Human title." },
+        description: { type: "string", description: "What the tool does." },
+        inputSchema: { type: "object", description: "JSON Schema object for the args." },
+        language: { type: "string", description: "bash, node or python (default bash)." },
+        source: { type: "string", description: "Script source. Reads JSON args on stdin, writes the result to stdout." },
+        timeoutMs: { type: "number", description: "Timeout in ms (max 60000)." }
+      },
+      required: ["name", "source"]
+    }
+  });
+  return defs;
+}
+
+function resultText(payload, isError) {
+  return { content: [{ type: "text", text: typeof payload === "string" ? payload : JSON.stringify(payload) }], isError: isError === true };
+}
+
+function validateArgs(tool, args) {
+  const schema = tool.inputSchema;
+  if (!schema || typeof schema !== "object") return;
+  const required = Array.isArray(schema.required) ? schema.required : [];
+  for (const name of required) {
+    if (args[name] === undefined || args[name] === null) throw new Error("Missing required argument: " + name);
+  }
+  const props = schema.properties && typeof schema.properties === "object" ? schema.properties : {};
+  for (const [name, prop] of Object.entries(props)) {
+    const value = args[name];
+    if (value === undefined || value === null) continue;
+    if (!prop || typeof prop !== "object") continue;
+    if (prop.type === "string" && typeof value !== "string") throw new Error("Argument " + name + " must be a string");
+    if (prop.type === "number" && typeof value !== "number") throw new Error("Argument " + name + " must be a number");
+    if (prop.type === "integer" && !Number.isInteger(value)) throw new Error("Argument " + name + " must be an integer");
+    if (prop.type === "boolean" && typeof value !== "boolean") throw new Error("Argument " + name + " must be a boolean");
+  }
+}
+
+function runProcess(argv, stdinText, timeoutMs, maxBytes) {
+  return new Promise((resolve) => {
+    const started = Date.now();
+    let stdout = "";
+    let stderr = "";
+    let truncated = false;
+    let timedOut = false;
+    let settled = false;
+    let child;
+    const limit = Math.min(Math.max(1024, Number(maxBytes) || 100000), HARD_MAX_OUTPUT);
+    const budget = Math.min(Math.max(1000, Number(timeoutMs) || 15000), HARD_MAX_TIMEOUT);
+    const finish = (code, error) => {
+      if (settled) return;
+      settled = true;
+      clearTimeout(timer);
+      let output = stdout;
+      if (stderr.trim()) output += (output ? "\\n" : "") + "[stderr] " + stderr.trim();
+      if (error) output += (output ? "\\n" : "") + "[error] " + String(error.message || error);
+      resolve({ ok: code === 0 && !timedOut && !error, output, truncated, timedOut, exitCode: typeof code === "number" ? code : -1, durationMs: Date.now() - started });
+    };
+    const kill = () => {
+      // Kill the whole process group so a timed-out/over-cap tool cannot leave
+      // a grandchild (sleep, subprocess) holding the stdout pipe open.
+      try { process.kill(-child.pid, "SIGKILL"); } catch (err) { try { child.kill("SIGKILL"); } catch (inner) {} }
+    };
+    const timer = setTimeout(() => { timedOut = true; kill(); }, budget);
+    try {
+      child = spawn(argv[0], argv.slice(1), { cwd: workspace, env: process.env, detached: true, stdio: ["pipe", "pipe", "pipe"] });
+    } catch (err) {
+      finish(-1, err);
+      return;
+    }
+    child.on("error", (err) => finish(-1, err));
+    child.on("close", (code) => finish(code, null));
+    child.stdout.on("data", (chunk) => {
+      const room = limit - Buffer.byteLength(stdout, "utf8");
+      if (chunk.length > room) {
+        stdout += chunk.slice(0, Math.max(0, room)).toString("utf8");
+        truncated = true;
+        kill();
+      } else {
+        stdout += chunk.toString("utf8");
+      }
+    });
+    child.stderr.on("data", (chunk) => {
+      if (Buffer.byteLength(stderr, "utf8") < 20000) stderr += chunk.toString("utf8");
+    });
+    child.stdin.on("error", () => {});
+    child.stdin.end(stdinText);
+  });
+}
+
+function interpreterFor(language) {
+  if (language === "python") return ["python3", ".py"];
+  if (language === "node") return ["node", ".mjs"];
+  return ["bash", ".sh"];
+}
+
+async function executeScript(tool, args) {
+  if (!tool.script || typeof tool.script.source !== "string") throw new Error("This tool has no script.");
+  const [command, ext] = interpreterFor(tool.script.language);
+  fs.mkdirSync(runDir, { recursive: true, mode: 0o700 });
+  const safe = String(tool.id).replace(/[^a-z0-9_]/g, "_");
+  const file = path.join(runDir, "tool_" + safe + ext);
+  fs.writeFileSync(file, tool.script.source, { encoding: "utf8", mode: 0o600 });
+  const res = await runProcess([command, file], JSON.stringify(args), tool.timeoutMs, tool.maxOutputBytes);
+  return res;
+}
+
+// --- SSRF guard (mirrors lib/library/ssrf.ts) ---
+
+function ipv4ToInt(address) {
+  const parts = String(address).split(".");
+  if (parts.length !== 4) return null;
+  let value = 0;
+  for (const part of parts) {
+    if (!/^\\d{1,3}$/.test(part)) return null;
+    const n = Number(part);
+    if (n > 255) return null;
+    value = value * 256 + n;
+  }
+  return value;
+}
+
+function inRange(value, cidr) {
+  const parts = cidr.split("/");
