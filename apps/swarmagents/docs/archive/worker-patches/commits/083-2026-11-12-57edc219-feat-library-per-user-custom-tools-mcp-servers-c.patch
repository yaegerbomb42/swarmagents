--- /dev/null
+++ b/apps/swarmagents/lib/library/types.test.ts
@@ -0,0 +1,169 @@
+/**
+ * Library data-model rules: titles become safe MCP tool ids, form fields
+ * become a flat object schema, raw schemas are validated, and secrets are
+ * masked to a last-4 marker. These are the same functions the API uses.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  DEFAULT_TOOL_MAX_OUTPUT_BYTES,
+  DEFAULT_TOOL_TIMEOUT_MS,
+  MAX_TOOL_TIMEOUT_MS,
+  LibraryValidationError,
+  isValidSecretName,
+  isValidToolId,
+  maskSecret,
+  normalizeMcpServerInput,
+  normalizeSkillInput,
+  normalizeUserToolInput,
+  parseInputSchema,
+  schemaFromFields,
+  secretRefsIn,
+  slugifyToolId,
+} from "./types";
+
+test("slugifyToolId produces a lowercase MCP-safe id", () => {
+  assert.equal(slugifyToolId("Word Count"), "word_count");
+  assert.equal(slugifyToolId("  Héllo, Wörld!  "), "hello_world");
+  assert.equal(slugifyToolId("***"), "tool");
+  assert.ok(isValidToolId(slugifyToolId("A very long title".repeat(10))));
+  assert.equal(isValidToolId("1starts_with_digit"), false);
+  assert.equal(isValidToolId("has-dash"), false);
+  assert.ok(isValidSecretName("API_TOKEN"));
+  assert.equal(isValidSecretName("api-token"), false);
+});
+
+test("schemaFromFields drops invalid/duplicate names and records required", () => {
+  const schema = schemaFromFields([
+    { name: "query", type: "string", description: "what to look up", required: true },
+    { name: "limit", type: "integer", required: false },
+    { name: "query", type: "number", required: true },
+    { name: "not valid", type: "string", required: true },
+  ]);
+  assert.deepEqual(schema, {
+    type: "object",
+    properties: {
+      query: { type: "string", description: "what to look up" },
+      limit: { type: "integer" },
+    },
+    required: ["query"],
+  });
+});
+
+test("parseInputSchema accepts a JSON string and rejects non-object schemas", () => {
+  const parsed = parseInputSchema('{"type":"object","properties":{"q":{"type":"string"}},"required":["q","missing"]}');
+  assert.deepEqual(parsed, { type: "object", properties: { q: { type: "string" } }, required: ["q"] });
+  assert.deepEqual(parseInputSchema("  "), { type: "object", properties: {} });
+
+  assert.throws(() => parseInputSchema("{not json"), LibraryValidationError);
+  assert.throws(() => parseInputSchema({ type: "array", properties: {} }), /must be "object"/);
+  assert.throws(() => parseInputSchema({ type: "object", properties: { x: { type: "object" } } }), /string, number, integer or boolean/);
+});
+
+test("normalizeUserToolInput validates a script tool and clamps limits", () => {
+  const tool = normalizeUserToolInput({
+    title: "Word Count",
+    description: "Count words",
+    inputSchema: {
+      type: "object",
+      properties: { text: { type: "string" } },
+      required: ["text"],
+    },
+    kind: "script",
+    script: { language: "node", source: "console.log(1)" },
+    timeoutMs: 1,
+    maxOutputBytes: 10_000_000,
+    secrets: [{ name: "API_TOKEN", value: "abc" }],
+  });
+  assert.equal(tool.id, "word_count");
+  assert.equal(tool.timeoutMs, 1_000);
+  assert.equal(tool.maxOutputBytes, 1_000_000);
+  assert.equal(tool.kind, "script");
+  assert.deepEqual(tool.script, { language: "node", source: "console.log(1)" });
+  assert.deepEqual(tool.secrets, [{ name: "API_TOKEN", value: "abc" }]);
+
+  assert.throws(
+    () => normalizeUserToolInput({ title: "x", kind: "script", script: { language: "bash", source: "  " } }),
+    /script source is required/,
+  );
+  assert.throws(
+    () => normalizeUserToolInput({ title: "x", kind: "script" }),
+    /Script language must be/,
+  );
+});
+
+test("normalizeUserToolInput validates an HTTP template", () => {
+  const tool = normalizeUserToolInput({
+    title: "Lookup",
+    kind: "http",
+    inputSchema: "{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"}}}",
+    http: {
+      method: "post",
+      url: "https://api.example.com/items/{{id}}",
+      headers: [{ name: "Authorization", value: "Bearer {{secret.API_TOKEN}}" }],
+      bodyTemplate: '{"name":"{{secret.API_TOKEN}}"}',
+    },
+  });
+  assert.equal(tool.kind, "http");
+  assert.equal(tool.http?.method, "POST");
+  assert.deepEqual(tool.http?.headers, [{ name: "Authorization", value: "Bearer {{secret.API_TOKEN}}" }]);
+  assert.throws(() => normalizeUserToolInput({ title: "x", kind: "http" }), /URL is required/);
+  assert.throws(
+    () => normalizeUserToolInput({ title: "x", kind: "http", http: { url: "https://x", method: "TRACE" } }),
+    /Method must be one of/,
+  );
+});
+
+test("normalizeMcpServerInput handles stdio and http transports", () => {
+  const stdio = normalizeMcpServerInput({
+    title: "Docs",
+    transport: "stdio",
+    command: "npx",
+    args: ["-y", "docs-mcp", "--token", "{{secret.API_TOKEN}}"],
+    secrets: [{ name: "API_TOKEN", value: "secret" }],
+  });
+  assert.equal(stdio.id, "docs");
+  assert.deepEqual(stdio.args, ["-y", "docs-mcp", "--token", "{{secret.API_TOKEN}}"]);
+
+  const http = normalizeMcpServerInput({ title: "Remote", transport: "http", url: "https://mcp.example.com" });
+  assert.equal(http.transport, "http");
+  assert.equal(http.url, "https://mcp.example.com");
+
+  assert.throws(() => normalizeMcpServerInput({ title: "x", transport: "http" }), /needs a url/);
+  assert.throws(() => normalizeMcpServerInput({ title: "x", transport: "stdio" }), /needs a command/);
+  assert.throws(() => normalizeMcpServerInput({ title: "x", transport: "smtp" }), /transport/);
+});
+
+test("normalizeSkillInput accepts catalog and custom skills", () => {
+  const skill = normalizeSkillInput({ title: "Careful edits", instructions: "Read before writing." });
+  assert.equal(skill.id, "careful_edits");
+  assert.equal(skill.source, "catalog");
+  const custom = normalizeSkillInput({ title: "Mine", instructions: "x", source: "custom" });
+  assert.equal(custom.source, "custom");
+  assert.throws(() => normalizeSkillInput({ instructions: "x" }), /name is required/);
+});
+
+test("maskSecret only exposes the last four characters", () => {
+  assert.equal(maskSecret("sk-super-secret-1234"), "••••1234");
+  assert.equal(maskSecret("abcd"), "••••");
+  assert.equal(maskSecret(""), "••••");
+});
+
+test("secretRefsIn finds template references once", () => {
+  assert.deepEqual(
+    secretRefsIn("Bearer {{secret.API_TOKEN}} and {{ secret.OTHER }} and {{secret.API_TOKEN}}"),
+    ["API_TOKEN", "OTHER"],
+  );
+});
+
+test("defaults are what the UI advertises", () => {
+  const tool = normalizeUserToolInput({
+    title: "Defaults",
+    kind: "script",
+    script: { language: "bash", source: "echo hi" },
+  });
+  assert.equal(tool.timeoutMs, DEFAULT_TOOL_TIMEOUT_MS);
+  assert.equal(tool.maxOutputBytes, DEFAULT_TOOL_MAX_OUTPUT_BYTES);
+  assert.ok(MAX_TOOL_TIMEOUT_MS >= DEFAULT_TOOL_TIMEOUT_MS);
+});
