+/**
+ * The generated user-tools MCP server, exercised as a real Node process.
+ *
+ * This is the code that runs inside a user's VM. The tests cover the contract
+ * the host relies on: JSON args on stdin / JSON result on stdout, a hard
+ * timeout, an output cap, the SSRF guard, secret substitution, tools/list, and
+ * the agent's create_tool flow.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { spawnSync } from "node:child_process";
+import {
+  USER_TOOLS_MCP_SERVER_SOURCE,
+  buildUserToolsSecrets,
+  buildUserToolsSpec,
+  parseCreatedToolLines,
+  userToolRunArgv,
+} from "./user-tools-mcp";
+import type { UserTool } from "./types";
+
+let dir: string;
+let serverPath: string;
+let specPath: string;
+let secretsPath: string;
+let createdPath: string;
+let runDir: string;
+let env: NodeJS.ProcessEnv;
+
+test.beforeEach(() => {
+  dir = mkdtempSync(join(tmpdir(), "swarm-user-tools-server-"));
+  serverPath = join(dir, "server.mjs");
+  specPath = join(dir, "tools.json");
+  secretsPath = join(dir, "secrets.json");
+  createdPath = join(dir, "created.jsonl");
+  runDir = join(dir, "run");
+  writeFileSync(serverPath, USER_TOOLS_MCP_SERVER_SOURCE);
+  env = {
+    ...(process.env as Record<string, string>),
+    SWARM_USER_TOOLS_SPEC: specPath,
+    SWARM_USER_TOOLS_SECRETS: secretsPath,
+    SWARM_USER_TOOLS_CREATED: createdPath,
+    SWARM_USER_TOOLS_RUN_DIR: runDir,
+    SWARM_USER_TOOLS_CWD: dir,
+  } as unknown as NodeJS.ProcessEnv;
+});
+
+test.afterEach(() => {
+  rmSync(dir, { recursive: true, force: true });
+});
+
+function writeSpec(tools: Array<UserTool & { secrets?: Record<string, string> }>): void {
+  writeFileSync(specPath, buildUserToolsSpec(tools));
+  writeFileSync(secretsPath, buildUserToolsSecrets(tools));
+}
+
+function tool(
+  overrides: Partial<UserTool> & { secrets?: Record<string, string> },
+): UserTool & { secrets?: Record<string, string> } {
+  return {
+    id: "tool",
+    title: "Tool",
+    description: "Test tool",
+    inputSchema: { type: "object", properties: {} },
+    kind: "script",
+    script: { language: "node", source: "console.log('ok')" },
+    timeoutMs: 5_000,
+    maxOutputBytes: 100_000,
+    enabled: true,
+    source: "user",
+    createdAt: 1,
+    updatedAt: 1,
+    ...overrides,
+  };
+}
+
+interface RunOutput {
+  ok: boolean;
+  output: string;
+  truncated: boolean;
+  timedOut?: boolean;
+  exitCode?: number;
+  durationMs?: number;
+}
+
+/** Invoke `server.mjs --run <id>` with JSON input, like the host does. */
+function runTool(id: string, input: unknown, overrideEnv: Record<string, string> = {}): RunOutput {
+  const argv = userToolRunArgv(id).map((part) => (part === "/workspace/.swarm/user-tools-server.mjs" ? serverPath : part));
+  const rules = spawnSync(argv[0], argv.slice(1), {
+    env: { ...env, ...overrideEnv } as NodeJS.ProcessEnv,
+    input: JSON.stringify(input),
+    encoding: "utf-8",
+    timeout: 20_000,
+  });
+  assert.equal(rules.error, undefined, `spawn failed: ${rules.error?.message}`);
+  const lines = (rules.stdout ?? "").trim().split("\n").filter(Boolean);
+  const last = lines[lines.length - 1] ?? "";
+  assert.ok(last, `no output; stderr: ${rules.stderr}`);
+  return JSON.parse(last) as RunOutput;
+}
+
+test("script tools receive JSON args on stdin and return stdout as the result", () => {
+  writeSpec([
+    tool({
+      id: "echo_args",
+      script: {
+        language: "node",
+        source: "import fs from 'node:fs'; const a = JSON.parse(fs.readFileSync(0, 'utf8')); console.log('hi ' + a.name);",
+      },
+      inputSchema: { type: "object", properties: { name: { type: "string" } }, required: ["name"] },
+    }),
+  ]);
+  const result = runTool("echo_args", { name: "jimmy" });
+  assert.equal(result.ok, true);
+  assert.equal(result.output.trim(), "hi jimmy");
+  assert.equal(result.truncated, false);
+
+  const missing = runTool("echo_args", {});
+  assert.equal(missing.ok, false);
+  assert.match(missing.output, /Missing required argument: name/);
+});
+
+test("a script that runs too long is killed and reports timedOut", () => {
+  writeSpec([
+    tool({
+      id: "sleepy",
+      timeoutMs: 1_000,
+      script: { language: "node", source: "setTimeout(() => console.log('late'), 10000);" },
+    }),
+  ]);
+  const started = Date.now();
+  const result = runTool("sleepy", {});
+  const elapsed = Date.now() - started;
+  assert.equal(result.timedOut, true);
+  assert.equal(result.ok, false);
+  assert.ok(elapsed < 8_000, `timeout did not interrupt the child (took ${elapsed}ms)`);
+  assert.ok((result.durationMs ?? 0) < 5_000);
+});
+
+test("stdout is capped at maxOutputBytes and marked truncated", () => {
+  writeSpec([
+    tool({
+      id: "chatty",
+      maxOutputBytes: 1_024,
+      script: { language: "node", source: "process.stdout.write('a'.repeat(50_000));" },
+    }),
+  ]);
+  const result = runTool("chatty", {});
+  assert.equal(result.truncated, true);
+  assert.ok(Buffer.byteLength(result.output, "utf8") <= 1_024, "output exceeds the cap");
+});
+
+test("HTTP tools block private and metadata addresses", () => {
+  writeSpec([
+    tool({
+      id: "metadata_fetch",
+      kind: "http",
+      script: undefined,
+      http: { method: "GET", url: "http://169.254.169.254/latest/meta-data", headers: [] },
+    }),
+    tool({
+      id: "localhost_fetch",
+      kind: "http",
+      script: undefined,
+      http: { method: "GET", url: "http://localhost:6379/", headers: [] },
+    }),
+  ]);
+  const metadata = runTool("metadata_fetch", {});
+  assert.equal(metadata.ok, false);
+  assert.match(metadata.output, /private or reserved/);
+  const local = runTool("localhost_fetch", {});
+  assert.equal(local.ok, false);
+  assert.match(local.output, /local or internal/);
+});
+
+test("a missing secret fails before any request is made", () => {
+  writeSpec([
+    tool({
+      id: "secret_fetch",
+      kind: "http",
+      script: undefined,
+      inputSchema: { type: "object", properties: { id: { type: "string" } } },
+      http: { method: "GET", url: "https://api.example.com/{{secret.NOPE}}", headers: [] },
+    }),
+  ]);
+  const result = runTool("secret_fetch", { id: "1" });
+  assert.equal(result.ok, false);
+  assert.match(result.output, /Missing secret: NOPE/);
+});
+
+test("tools/list exposes each tool plus create_tool, and create_tool saves a runnable tool", () => {
+  writeSpec([tool({ id: "word_count" })]);
+  const messages = [
+    JSON.stringify({ jsonrpc: "2.0", id: 1, method: "initialize", params: { protocolVersion: "2024-11-05" } }),
+    JSON.stringify({ jsonrpc: "2.0", id: 2, method: "tools/list" }),
+    JSON.stringify({
+      jsonrpc: "2.0",
+      id: 3,
+      method: "tools/call",
+      params: {
+        name: "create_tool",
+        arguments: {
+          name: "agent_echo",
+          title: "Agent echo",
+          description: "Echo input",
+          language: "node",
+          source: "import fs from 'node:fs'; const a = JSON.parse(fs.readFileSync(0, 'utf8')); console.log(a.text);",
+          inputSchema: { type: "object", properties: { text: { type: "string" } } },
+        },
+      },
+    }),
+    JSON.stringify({
+      jsonrpc: "2.0",
+      id: 4,
+      method: "tools/list",
+    }),
+  ].join("\n") + "\n";
+
+  const rules = spawnSync("node", [serverPath], { env, input: messages, encoding: "utf-8", timeout: 20_000 });
+  const replies = (rules.stdout ?? "").trim().split("\n").filter(Boolean).map((line) => JSON.parse(line));
+  const list = replies.find((reply) => reply.id === 2);
