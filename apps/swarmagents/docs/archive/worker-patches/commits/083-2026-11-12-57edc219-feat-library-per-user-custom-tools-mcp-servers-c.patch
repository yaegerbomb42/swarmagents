diff --git a/apps/swarmagents/lib/runtime/manager.user-tools.test.ts b/apps/swarmagents/lib/runtime/manager.user-tools.test.ts
new file mode 100644
index 000000000..7ab9da414
--- /dev/null
+++ b/apps/swarmagents/lib/runtime/manager.user-tools.test.ts
@@ -0,0 +1,110 @@
+/**
+ * End-to-end fake-claude run: a user with a saved custom tool gets the
+ * generated `user-tools` MCP server wired into the claude invocation, the
+ * agent calls the tool, and the call shows up in telemetry like a built-in.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { RuntimeManager, type RunSummary } from "./manager";
+import { VmManager } from "../vm/manager";
+import { FakeVmDriver } from "../vm/fake-driver";
+import { FAKE_CLAUDE_USER_TOOL_NAME, FAKE_CLAUDE_USER_TOOL_TRIGGER } from "../vm/fake-claude";
+import { telemetryBus } from "../telemetry/bus";
+import { createUserTool } from "../library/store";
+import type { ExecOptions, ExecResult, VmHandle } from "../vm/types";
+import {
+  USER_TOOLS_MCP_SERVER_PATH,
+  USER_TOOLS_SECRETS_PATH,
+  USER_TOOLS_SPEC_PATH,
+} from "../library/user-tools-mcp";
+import { ROLE_MCP_CONFIG_PATH } from "../harness/role-mcp";
+
+const USER = "alice@example.com";
+const SECRET = "sk-runtime-secret-a1b2";
+const sleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));
+
+class UserToolDriver extends FakeVmDriver {
+  writes = new Map<string, string>();
+  claudeArgv: string[][] = [];
+
+  override async writeFile(handle: VmHandle, path: string, content: string): Promise<void> {
+    this.writes.set(path, content);
+    return super.writeFile(handle, path, content);
+  }
+
+  override async exec(handle: VmHandle, cmd: string[], opts?: ExecOptions): Promise<ExecResult> {
+    if (cmd[0] === "claude") this.claudeArgv.push(cmd);
+    return super.exec(handle, cmd, opts);
+  }
+}
+
+async function waitFor(manager: RuntimeManager, runId: string): Promise<RunSummary> {
+  for (let i = 0; i < 500; i++) {
+    const run = manager.list(USER).find((candidate) => candidate.runId === runId);
+    if (run && run.status !== "running" && run.status !== "queued") return run;
+    await sleep(10);
+  }
+  throw new Error("timed out waiting for run to finish");
+}
+
+test("a fake-claude run wires the user-tools MCP server and renders the tool call", async () => {
+  const previousHome = process.env.SWARM_HOME;
+  const home = mkdtempSync(join(tmpdir(), "swarm-runtime-user-tools-"));
+  process.env.SWARM_HOME = home;
+  try {
+    createUserTool(
+      USER,
+      {
+        title: "Word Count",
+        description: "Count words in text",
+        inputSchema: { type: "object", properties: { text: { type: "string" } }, required: ["text"] },
+        kind: "script",
+        script: {
+          language: "node",
+          source: "import fs from 'node:fs'; const a = JSON.parse(fs.readFileSync(0, 'utf8')); console.log(a.text.split(/\\s+/).length);",
+        },
+        secrets: [{ name: "API_TOKEN", value: SECRET }],
+      },
+      { env: { SWARM_HOME: home } },
+    );
+
+    const driver = new UserToolDriver();
+    const manager = new RuntimeManager({ vm: new VmManager({ customDriver: driver }) });
+    const started = manager.start(USER, { prompt: `Please ${FAKE_CLAUDE_USER_TOOL_TRIGGER}` });
+    assert.equal(started.accepted, true);
+
+    const events: Array<{ type?: string; name?: string }> = [];
+    telemetryBus.subscribe(started.runId, 0, (event) => events.push(event as { type?: string; name?: string }));
+
+    const run = await waitFor(manager, started.runId);
+    assert.equal(run.status, "finished");
+
+    // The generated server + public spec + secrets were seeded into the VM.
+    const specText = driver.writes.get(USER_TOOLS_SPEC_PATH) ?? "";
+    assert.match(specText, /word_count/, "spec must list the user's tool");
+    assert.equal(specText.includes(SECRET), false, "the public spec must not contain secrets");
+    const secretsText = driver.writes.get(USER_TOOLS_SECRETS_PATH) ?? "";
+    assert.match(secretsText, /API_TOKEN/);
+    assert.match(driver.writes.get(USER_TOOLS_MCP_SERVER_PATH) ?? "", /user-tools MCP stdio server/);
+
+    // The role mcp-config includes the server, and --allowedTools grants it.
+    const mcpConfig = driver.writes.get(ROLE_MCP_CONFIG_PATH) ?? "";
+    assert.match(mcpConfig, /"user-tools"/);
+    const argv = driver.claudeArgv.at(-1) ?? [];
+    assert.ok(argv.includes("--mcp-config"), "claude must receive --mcp-config");
+    assert.ok(argv.includes("--allowedTools"), "claude must receive --allowedTools");
+    assert.ok(argv.includes("mcp__user-tools__*"), "the user-tools server must be allowed");
+
+    // The agent's call renders as a tool.call event, same as a built-in.
+    const call = events.find((event) => event.type === "tool.call" && event.name === FAKE_CLAUDE_USER_TOOL_NAME);
+    assert.ok(call, "telemetry must include the user tool call");
+  } finally {
+    if (previousHome === undefined) delete process.env.SWARM_HOME;
+    else process.env.SWARM_HOME = previousHome;
+    rmSync(home, { recursive: true, force: true });
+  }
+});
