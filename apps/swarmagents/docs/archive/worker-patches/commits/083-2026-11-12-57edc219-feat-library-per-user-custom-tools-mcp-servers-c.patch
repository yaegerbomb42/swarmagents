+        (snapshot?.catalogs.skills.length ?? 0) +
+        (snapshot?.catalogs.mcpServers.length ?? 0) +
+        (snapshot?.catalogs.connectors.length ?? 0),
+    }),
+    [snapshot],
+  );
+
+  return (
+    <main className="relative min-h-screen overflow-hidden bg-[#07070a] text-white antialiased">
+      <div className="pointer-events-none fixed inset-0">
+        <div className="blob left-[12%] top-[12%] h-[420px] w-[420px] bg-[#5b5bf7]" />
+        <div className="blob bottom-[4%] right-[6%] h-[460px] w-[460px] bg-[#0ea5a4]" style={{ animationDelay: "-6s" }} />
+        <div className="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_0%,#07070a_75%)]" />
+      </div>
+
+      <div className="relative z-10 mx-auto w-full max-w-6xl px-6 py-10">
+        <div className="mb-1 flex items-center justify-between gap-3">
+          <div className="flex items-center gap-2 text-2xl font-semibold tracking-tight">
+            <Boxes className="h-6 w-6 text-cyan-300" /> Library
+          </div>
+          <a href="/" className="text-xs text-white/45 hover:text-white/75">
+            ← Back to workspace
+          </a>
+        </div>
+        <p className="mb-6 max-w-2xl text-sm text-white/50">
+          Everything here belongs to your account and runs inside your VM. Secrets are encrypted at
+          rest and only ever shown as a last-4 mask. Catalog entries are untrusted public content —
+          review each one before installing.
+        </p>
+
+        <div className="mb-6 flex flex-col gap-3">
+          <div className="relative max-w-md">
+            <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-white/35" />
+            <input
+              type="search"
+              value={query}
+              onChange={(e) => setQuery(e.target.value)}
+              placeholder="Search this catalog…"
+              aria-label="Search the library"
+              spellCheck={false}
+              className="w-full rounded-full bg-white/[0.04] py-2 pl-9 pr-3 text-sm text-white/85 ring-1 ring-white/10 placeholder:text-white/30 focus:outline-none focus:ring-cyan-400/40"
+            />
+          </div>
+          <div className="flex flex-wrap gap-2" role="tablist" aria-label="Library sections">
+            {TABS.map((entry) => {
+              const active = tab === entry.id;
+              const count = counts[entry.id];
+              return (
+                <button
+                  key={entry.id}
+                  type="button"
+                  role="tab"
+                  aria-selected={active}
+                  onClick={() => {
+                    setTab(entry.id);
+                    setQuery("");
+                  }}
+                  className={
+                    active
+                      ? "flex items-center gap-1.5 rounded-full bg-cyan-400/15 px-3 py-1.5 text-xs font-medium text-cyan-200 ring-1 ring-cyan-400/40"
+                      : "flex items-center gap-1.5 rounded-full bg-white/[0.04] px-3 py-1.5 text-xs text-white/55 ring-1 ring-white/10 transition hover:bg-white/[0.08] hover:text-white/80"
+                  }
+                >
+                  <entry.icon className="h-3.5 w-3.5" />
+                  {entry.label}
+                  <span className="text-[10px] text-white/35">{count}</span>
+                </button>
+              );
+            })}
+          </div>
+        </div>
+
+        <Notice text={error} tone="error" />
+        <Notice text={notice} tone="ok" />
+
+        {!snapshot ? (
+          <div className="flex items-center gap-2 py-16 text-sm text-white/45">
+            <Loader2 className="h-4 w-4 animate-spin" /> Loading your library…
+          </div>
+        ) : (
+          <>
+            {tab === "connectors" && (
+              <ConnectorsTab
+                snapshot={snapshot}
+                query={query}
+                reload={reload}
+                onNotice={onNotice}
+              />
+            )}
+            {tab === "mcp" && <McpTab snapshot={snapshot} query={query} reload={reload} onNotice={onNotice} />}
+            {tab === "skills" && <SkillsTab snapshot={snapshot} query={query} reload={reload} onNotice={onNotice} />}
+            {tab === "tools" && <ToolsTab snapshot={snapshot} query={query} reload={reload} onNotice={onNotice} />}
+            {tab === "public" && (
+              <PublicTab snapshot={snapshot} query={query} reload={reload} onNotice={onNotice} onOpenTab={setTab} />
+            )}
+          </>
+        )}
+      </div>
+    </main>
+  );
+}
