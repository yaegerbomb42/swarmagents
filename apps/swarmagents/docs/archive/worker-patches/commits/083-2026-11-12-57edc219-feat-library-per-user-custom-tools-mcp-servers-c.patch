+                url: draft.url,
+                headers: draft.headers.filter((header) => header.name.trim()),
+                ...(draft.bodyTemplate ? { bodyTemplate: draft.bodyTemplate } : {}),
+              },
+            }),
+        timeoutMs: draft.timeoutMs,
+        maxOutputBytes: draft.maxOutputBytes,
+        enabled: existing?.enabled ?? true,
+        source: existing?.source ?? "user",
+        secrets: draft.secrets
+          .filter((secret) => secret.name.trim())
+          .map((secret) => ({ name: secret.name.trim(), value: secret.value })),
+      };
+      const out = existing
+        ? await api<{ tool: UserToolRow }>(`/api/library/tools/${encodeURIComponent(existing.id)}`, {
+            method: "PATCH",
+            body: JSON.stringify({ tool }),
