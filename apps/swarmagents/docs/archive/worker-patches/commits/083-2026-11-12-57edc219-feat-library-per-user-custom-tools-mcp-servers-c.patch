+}
+
+function slugId(value) {
+  return String(value || "").toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_+|_+$/g, "").slice(0, 60);
+}
+
+function createTool(args) {
+  const name = slugId(args.name);
+  if (!/^[a-z][a-z0-9_]{0,59}$/.test(name)) throw new Error("name must be a lowercase id (a-z, 0-9, underscore).");
+  if (typeof args.source !== "string" || !args.source.trim()) throw new Error("source is required.");
+  if (args.source.length > 64000) throw new Error("source is too long.");
+  let inputSchema = args.inputSchema;
+  if (typeof inputSchema === "string") {
+    try { inputSchema = JSON.parse(inputSchema); } catch (err) { throw new Error("inputSchema is not valid JSON."); }
+  }
+  if (!inputSchema || typeof inputSchema !== "object" || Array.isArray(inputSchema)) inputSchema = { type: "object", properties: {} };
+  const language = args.language === "node" || args.language === "python" ? args.language : "bash";
+  const tool = {
+    id: name,
+    title: String(args.title || args.name).slice(0, 80),
+    description: String(args.description || "").slice(0, 2000),
+    inputSchema,
+    kind: "script",
+    script: { language, source: args.source },
+    timeoutMs: Math.min(60000, Math.max(1000, Number(args.timeoutMs) || 15000)),
+    maxOutputBytes: 100000,
+    enabled: true,
+    source: "agent"
+  };
+  try {
+    const stat = fs.statSync(createdPath);
+    if (stat.size > 200000) throw new Error("The agent-created tool file is full.");
+  } catch (err) { if (err && err.code !== "ENOENT") throw err; }
+  fs.mkdirSync(path.dirname(createdPath), { recursive: true, mode: 0o700 });
+  fs.appendFileSync(createdPath, JSON.stringify(tool) + "\\n", { encoding: "utf8", mode: 0o600 });
+  toolMap = loadTools();
+  return { ok: true, tool: { id: tool.id, title: tool.title, language: language, saved_to_library: true } };
+}
+
+async function callTool(name, args) {
+  if (name === "create_tool") return resultText(createTool(args), false);
+  toolMap = loadTools();
+  const tool = toolMap.get(name);
+  if (!tool) return resultText({ error: "unknown_tool", message: "Unknown tool: " + name }, true);
+  try {
+    const res = await executeTool(tool, args);
+    return resultText(res.output, !res.ok);
+  } catch (err) {
+    return resultText({ error: "tool_failed", message: String(err && err.message ? err.message : err) }, true);
+  }
+}
+
+function reply(id, result) {
+  process.stdout.write(JSON.stringify({ jsonrpc: "2.0", id: id, result: result }) + "\\n");
+}
+
+function replyError(id, code, message) {
+  process.stdout.write(JSON.stringify({ jsonrpc: "2.0", id: id, error: { code: code, message: message } }) + "\\n");
+}
+
+function handleMessage(msg) {
+  if (!msg || typeof msg !== "object") return;
+  const hasId = msg.id !== undefined && msg.id !== null;
+  const method = typeof msg.method === "string" ? msg.method : "";
+  if (method === "initialize") {
+    if (hasId) reply(msg.id, {
+      protocolVersion: (msg.params && msg.params.protocolVersion) || "2024-11-05",
+      capabilities: { tools: {} },
+      serverInfo: { name: "swarm-user-tools", version: "1.0.0" }
+    });
+    return;
+  }
+  if (method === "ping") { if (hasId) reply(msg.id, {}); return; }
+  if (method === "tools/list") { if (hasId) reply(msg.id, { tools: toolDefs() }); return; }
+  if (method === "tools/call") {
+    if (!hasId) return;
+    const params = msg.params && typeof msg.params === "object" ? msg.params : {};
+    const name = typeof params.name === "string" ? params.name : "";
+    const args = params.arguments && typeof params.arguments === "object" ? params.arguments : {};
+    Promise.resolve(callTool(name, args)).then((result) => reply(msg.id, result), (err) => {
+      reply(msg.id, resultText({ error: "tool_failed", message: String(err && err.message ? err.message : err) }, true));
+    });
+    return;
+  }
+  if (method === "notifications/initialized" || method === "notifications/cancelled") return;
+  if (hasId) replyError(msg.id, -32601, "Method not found: " + method);
+}
+
+function readStdin() {
+  return new Promise((resolve) => {
+    let text = "";
+    process.stdin.setEncoding("utf8");
+    process.stdin.on("data", (chunk) => { text += chunk; });
+    process.stdin.on("end", () => resolve(text));
+  });
+}
+
+const runIndex = process.argv.indexOf("--run");
+if (runIndex !== -1) {
+  const id = process.argv[runIndex + 1] || "";
+  readStdin().then(async (text) => {
+    let args = {};
+    try { args = text.trim() ? JSON.parse(text) : {}; } catch (err) {
+      process.stdout.write(JSON.stringify({ ok: false, output: "Input must be a JSON object: " + String(err.message || err) }) + "\\n");
+      return;
+    }
+    toolMap = loadTools();
+    const tool = toolMap.get(id);
+    if (!tool) {
+      process.stdout.write(JSON.stringify({ ok: false, output: "Unknown tool: " + id }) + "\\n");
+      return;
+    }
+    try {
+      const res = await executeTool(tool, args);
+      process.stdout.write(JSON.stringify(res) + "\\n");
+    } catch (err) {
+      process.stdout.write(JSON.stringify({ ok: false, output: String(err && err.message ? err.message : err) }) + "\\n");
+    }
+  });
+} else {
+  process.stdin.setEncoding("utf8");
+  let buffer = "";
+  process.stdin.on("data", (chunk) => {
+    buffer += chunk;
+    let newline;
+    while ((newline = buffer.indexOf("\\n")) !== -1) {
+      const line = buffer.slice(0, newline).trim();
+      buffer = buffer.slice(newline + 1);
+      if (!line) continue;
+      let msg;
+      try { msg = JSON.parse(line); } catch (err) { continue; }
+      handleMessage(msg);
+    }
+  });
+}
+`;
