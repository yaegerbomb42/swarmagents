+}
+
+function blockedV6(address) {
+  const bytes = parseV6(address);
+  if (!bytes) return true;
+  if (bytes.every((b) => b === 0)) return true;
+  if (bytes.slice(0, 15).every((b) => b === 0) && bytes[15] === 1) return true;
+  if (bytes.slice(0, 10).every((b) => b === 0) && bytes[10] === 0xff && bytes[11] === 0xff) return blockedV4(bytes.slice(12).join("."));
+  if (bytes[0] === 0x00 && bytes[1] === 0x64 && bytes[2] === 0xff && bytes[3] === 0x9b) return blockedV4(bytes.slice(12).join("."));
+  if ((bytes[0] & 0xfe) === 0xfc) return true;
+  if (bytes[0] === 0xfe && (bytes[1] & 0xc0) === 0x80) return true;
+  if (bytes[0] === 0xff) return true;
+  if (bytes[0] === 0x20 && bytes[1] === 0x01 && bytes[2] === 0x0d && bytes[3] === 0xb8) return true;
+  return false;
+}
+
+function blockedIp(address) {
+  const family = isIP(address);
+  if (family === 4) return blockedV4(address);
+  if (family === 6) return blockedV6(address);
+  return true;
+}
+
+const BLOCKED_NAMES = ["localhost","localhost.localdomain","ip6-localhost","ip6-loopback","metadata","metadata.google.internal","metadata.azure.internal","instance-data"];
+const BLOCKED_SUFFIXES = [".localhost",".local",".internal",".lan",".home.arpa",".intranet"];
+
+function blockedHostname(host) {
+  const name = String(host).trim().toLowerCase().replace(/^\\[|\\]$/g, "").replace(/\\.$/, "");
+  if (!name) return true;
+  if (BLOCKED_NAMES.indexOf(name) !== -1) return true;
+  return BLOCKED_SUFFIXES.some((suffix) => name.endsWith(suffix));
+}
+
+async function assertSafeUrl(raw) {
+  let url;
+  try { url = new URL(raw); } catch (err) { throw new Error("The URL is not valid."); }
+  if (url.protocol !== "http:" && url.protocol !== "https:") throw new Error("Only http and https URLs are allowed.");
+  if (url.username || url.password) throw new Error("URLs with embedded credentials are not allowed.");
+  const host = url.hostname.replace(/^\\[|\\]$/g, "");
+  if (blockedHostname(host)) throw new Error("Requests to local or internal hosts are not allowed.");
+  if (isIP(host)) {
+    if (blockedIp(host)) throw new Error("Requests to private or reserved addresses are not allowed.");
+    return url;
+  }
