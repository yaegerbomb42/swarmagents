+/**
+ * POST /api/library/tools — create a custom tool.
+ *
+ * Body is either the tool itself or `{ tool: {...} }` (the Library form sends
+ * the latter). The response is the masked row; secret values never come back.
+ */
+
+import { NextResponse } from "next/server";
+import { createUserTool, listUserTools } from "../../../../lib/library/store";
+import {
+  NO_STORE,
+  errorResponse,
+  libraryOwner,
+  readJsonBody,
+  unauthorized,
+} from "../../../../lib/library/api";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+function toolBody(body: Record<string, unknown>): unknown {
+  return body.tool !== undefined ? body.tool : body;
+}
+
+export function GET(request: Request) {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    return NextResponse.json({ tools: listUserTools(owner) }, { headers: NO_STORE });
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
+
+export async function POST(request: Request) {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    const body = await readJsonBody(request);
+    const tool = createUserTool(owner, toolBody(body));
+    return NextResponse.json({ tool }, { status: 201, headers: NO_STORE });
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
