--- /dev/null
+++ b/apps/swarmagents/lib/library/connectors.ts
@@ -0,0 +1,91 @@
+/**
+ * Connector → MCP server wiring.
+ *
+ * The public connector catalog carries a copy-paste `install` string. For a
+ * user-installed connector we turn that into a real MCP server definition so
+ * the agent can use it: an HTTP URL stays as-is, a stdio command line is
+ * split into command + args, and `$VAR` placeholders become
+ * `{{secret.VAR}}` references resolved from the user's sealed secrets.
+ */
+
+import type { ConnectorCatalogEntry } from "./catalog";
+import type { SecretInput, UserMcpServerInput } from "./types";
+
+/** Split a documented command line into argv, honouring simple quoting. */
+export function splitCommandLine(input: string): string[] {
+  const out: string[] = [];
+  let current = "";
+  let quote: '"' | "'" | null = null;
+  let escaped = false;
+  for (const char of input) {
+    if (escaped) {
+      current += char;
+      escaped = false;
+      continue;
+    }
+    if (char === "\\") {
+      escaped = true;
+      continue;
+    }
+    if (quote) {
+      if (char === quote) quote = null;
+      else current += char;
+      continue;
+    }
+    if (char === '"' || char === "'") {
+      quote = char;
+      continue;
+    }
+    if (/\s/.test(char)) {
+      if (current) {
+        out.push(current);
+        current = "";
+      }
+      continue;
+    }
+    current += char;
+  }
+  if (current) out.push(current);
+  return out;
+}
+
+/** `$NAME` / `${NAME}` -> {{secret.NAME}} so the VM config resolver can fill it. */
+export function convertShellVars(value: string): string {
+  return value.replace(/\$\{?([A-Za-z_][A-Za-z0-9_]*)\}?/g, (_match, name: string) => `{{secret.${name}}}`);
+}
+
+/** Build the MCP server definition for a connector catalog entry. */
+export function connectorToMcpServer(
+  entry: ConnectorCatalogEntry,
+  values: Record<string, string>,
+): UserMcpServerInput | null {
+  const secrets: SecretInput[] = (entry.requiredFields ?? [])
+    .filter((field) => field.key)
+    .map((field) => ({ name: field.key, value: values[field.key] ?? "" }));
+
+  const base = {
+    id: entry.id.replace(/[^a-z0-9]+/g, "_").replace(/^_+|_+$/g, "") || "connector",
+    title: entry.name,
+    description: entry.description,
+    enabled: true,
+    source: "connector" as const,
+    headers: [],
+    env: [],
+    secrets,
+  };
+
+  if (entry.transport === "http") {
+    if (!/^https?:\/\//i.test(entry.install)) return null;
+    return { ...base, transport: "http", url: entry.install };
+  }
+
+  const argv = splitCommandLine(entry.install);
+  if (argv.length === 0) return null;
+  const [command, ...args] = argv;
+  return {
+    ...base,
+    transport: "stdio",
+    command,
+    args: args.map(convertShellVars),
+  };
+}
