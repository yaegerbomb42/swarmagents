+/**
+ * POST/DELETE /api/library/skills
+ *
+ * Install a skill from the public catalog (`{id}`), install a custom skill
+ * (`{skill: {...}}`), toggle one (`PATCH {id, enabled}`), or remove one
+ * (`DELETE ?id=`). Installs copy the catalog text into the caller's library;
+ * the catalog itself is not trusted at runtime.
+ */
+
+import { NextResponse } from "next/server";
+import { skillCatalog } from "../../../../lib/library/catalog";
+import {
+  installCatalogSkill,
+  installSkill,
+  removeSkill,
+  setSkillEnabled,
+} from "../../../../lib/library/store";
+import {
+  NO_STORE,
+  badRequest,
+  errorResponse,
+  libraryOwner,
+  queryParam,
+  readJsonBody,
+  unauthorized,
+} from "../../../../lib/library/api";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+export async function POST(request: Request) {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    const body = await readJsonBody(request);
+    if (body.skill !== undefined) {
+      return NextResponse.json({ skill: installSkill(owner, body.skill) }, { status: 201, headers: NO_STORE });
+    }
+    const id = typeof body.id === "string" ? body.id : "";
+    const entry = skillCatalog().find((candidate) => candidate.id === id);
+    if (!entry) return badRequest("Unknown catalog skill.", 404);
+    return NextResponse.json({ skill: installCatalogSkill(owner, entry) }, { status: 201, headers: NO_STORE });
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
+
+export async function PATCH(request: Request) {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    const body = await readJsonBody(request);
+    const id = typeof body.id === "string" ? body.id : "";
+    if (!id) return badRequest("id is required.");
+    if (typeof body.enabled !== "boolean") return badRequest("enabled must be a boolean.");
+    return NextResponse.json({ skill: setSkillEnabled(owner, id, body.enabled) }, { headers: NO_STORE });
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
+
+export async function DELETE(request: Request) {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    const id = queryParam(request, "id");
+    if (!id) return badRequest("id is required.");
+    removeSkill(owner, id);
+    return NextResponse.json({ ok: true }, { headers: NO_STORE });
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
