+      await api("/api/library/mcp-servers", {
+        method: "POST",
+        body: JSON.stringify({ catalogId: entry.id, values: values[entry.id] ?? {} }),
+      });
+      onNotice(`${entry.title} was added to this account.`, "ok");
+      await reload();
