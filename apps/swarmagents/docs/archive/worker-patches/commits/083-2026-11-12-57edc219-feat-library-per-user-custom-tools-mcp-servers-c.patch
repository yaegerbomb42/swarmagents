+    }
+  };
+
+  return (
+    <div className="space-y-8">
+      <section>
+        <div className="flex items-center justify-between">
+          <SectionHeading title="Your MCP servers" subtitle="Enabled servers are added to every run's --mcp-config." />
+          <button
+            type="button"
+            onClick={() => setAdding((v) => !v)}
+            className="mb-3 flex items-center gap-1.5 rounded-full bg-cyan-400/15 px-3 py-1.5 text-xs font-medium text-cyan-200 ring-1 ring-cyan-400/30 hover:bg-cyan-400/25"
+          >
+            {adding ? <X className="h-3.5 w-3.5" /> : <Plus className="h-3.5 w-3.5" />}
+            {adding ? "Cancel" : "Add server"}
+          </button>
+        </div>
+
+        {adding && (
+          <form onSubmit={save} className="mb-4 grid gap-3 rounded-2xl border border-white/10 bg-white/[0.03] p-4 sm:grid-cols-2">
+            <label className="block">
+              <span className={labelClass}>Name</span>
+              <input
+                required
+                value={draft.title}
+                onChange={(e) => setDraft({ ...draft, title: e.target.value, id: draft.id || slugifyToolId(e.target.value) })}
