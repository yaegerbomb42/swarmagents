+    try {
+      const tool = {
+        id: draft.id || slugifyToolId(draft.title),
+        title: draft.title,
+        description: draft.description,
+        inputSchema: draft.schemaMode === "fields" ? schemaFromFields(draft.fields) : draft.rawSchema,
+        kind: draft.kind,
+        ...(draft.kind === "script"
+          ? { script: { language: draft.language, source: draft.source } }
