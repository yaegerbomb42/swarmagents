+  const missing = 8 - groups.length - tailGroups.length;
+  if (missing < 0) return null;
+  const all = halves.length === 2 ? groups.concat(Array(missing).fill(0), tailGroups) : groups.concat(tailGroups);
+  if (all.length !== 8) return null;
+  const bytes = [];
+  for (const group of all) bytes.push((group >> 8) & 0xff, group & 0xff);
