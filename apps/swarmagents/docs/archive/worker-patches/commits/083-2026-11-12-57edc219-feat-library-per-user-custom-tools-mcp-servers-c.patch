+      onNotice(errText(error), "error");
+    }
+  };
+
+  const remove = async (server: UserMcpServerRow) => {
+    try {
+      await api(`/api/library/mcp-servers?id=${encodeURIComponent(server.id)}`, { method: "DELETE" });
