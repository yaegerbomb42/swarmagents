+}
+
+function ToolsTab({
+  snapshot,
+  query,
+  reload,
+  onNotice,
+}: {
+  snapshot: LibrarySnapshot;
+  query: string;
+  reload: () => Promise<void>;
+  onNotice: (text: string, tone: "ok" | "error") => void;
+}) {
+  const [editor, setEditor] = useState<{ open: boolean; existing: UserToolRow | null }>({ open: false, existing: null });
+  const [tryTool, setTryTool] = useState<string>("");
+
+  const tools = useMemo(() => {
+    const q = query.trim().toLowerCase();
+    if (!q) return snapshot.tools;
+    return snapshot.tools.filter((tool) =>
+      [tool.title, tool.description, tool.id].some((v) => v.toLowerCase().includes(q)),
+    );
+  }, [snapshot.tools, query]);
+
+  const toggle = async (tool: UserToolRow) => {
+    try {
+      await api(`/api/library/tools/${encodeURIComponent(tool.id)}`, {
+        method: "PATCH",
+        body: JSON.stringify({
+          tool: {
+            id: tool.id,
+            title: tool.title,
+            description: tool.description,
+            inputSchema: tool.inputSchema,
+            kind: tool.kind,
+            script: tool.script,
+            http: tool.http,
+            timeoutMs: tool.timeoutMs,
+            maxOutputBytes: tool.maxOutputBytes,
+            enabled: !tool.enabled,
+            source: tool.source,
+            secrets: tool.secrets.map((secret) => ({ name: secret.name })),
+          },
+        }),
+      });
+      await reload();
+    } catch (error) {
+      onNotice(errText(error), "error");
+    }
+  };
+
+  const remove = async (tool: UserToolRow) => {
+    try {
+      await api(`/api/library/tools/${encodeURIComponent(tool.id)}`, { method: "DELETE" });
+      onNotice(`${tool.title} was deleted.`, "ok");
+      await reload();
+    } catch (error) {
+      onNotice(errText(error), "error");
+    }
+  };
+
+  return (
+    <div className="space-y-5">
+      <div className="flex items-center justify-between">
+        <SectionHeading
+          title="Your tools"
+          subtitle="Served to the agent by the generated user-tools MCP server inside your VM."
+        />
+        <button
+          type="button"
+          onClick={() => setEditor({ open: true, existing: null })}
+          className="mb-3 flex items-center gap-1.5 rounded-full bg-cyan-400/15 px-3 py-1.5 text-xs font-medium text-cyan-200 ring-1 ring-cyan-400/30 hover:bg-cyan-400/25"
+        >
+          <Plus className="h-3.5 w-3.5" /> New tool
+        </button>
+      </div>
+
+      {editor.open && (
+        <ToolEditor
+          key={editor.existing?.id ?? "new"}
+          existing={editor.existing}
+          onCancel={() => setEditor({ open: false, existing: null })}
+          onSaved={async (tool) => {
+            await reload();
+            setEditor({ open: true, existing: tool });
+          }}
+          onNotice={onNotice}
+        />
+      )}
+
+      {tools.length === 0 ? (
+        <EmptyState text="No custom tools yet. Create one, or install one from the Public Library tab." />
+      ) : (
+        <div className="grid gap-3 lg:grid-cols-2">
+          {tools.map((tool) => (
+            <div key={tool.id} className="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
+              <div className="flex items-start justify-between gap-2">
+                <div>
+                  <div className="flex items-center gap-2 text-sm font-medium text-white/85">
+                    {tool.title}
+                    <Badge tone={tool.source === "agent" ? "amber" : tool.source === "catalog" ? "cyan" : "slate"}>
+                      {tool.source === "agent" ? "agent-made" : tool.source}
+                    </Badge>
+                  </div>
+                  <div className="font-mono text-[10px] text-white/35">{tool.id}</div>
+                </div>
+                <div className="flex items-center gap-2">
+                  <Badge tone={tool.kind === "http" ? "cyan" : "slate"}>
+                    {tool.kind === "http" ? `${tool.http?.method ?? "HTTP"} HTTP` : tool.script?.language ?? "script"}
+                  </Badge>
+                  <Toggle checked={tool.enabled} onChange={() => void toggle(tool)} label={`Toggle ${tool.title}`} />
+                  <button
+                    type="button"
+                    aria-label={`Delete ${tool.title}`}
+                    onClick={() => void remove(tool)}
+                    className="grid h-7 w-7 place-items-center rounded-lg text-white/40 ring-1 ring-white/10 hover:text-red-300"
+                  >
+                    <Trash2 className="h-3.5 w-3.5" />
+                  </button>
+                </div>
+              </div>
+              {tool.description && <p className="mt-1 text-xs text-white/50">{tool.description}</p>}
+              <div className="mt-2 flex flex-wrap gap-1">
+                {Object.keys(tool.inputSchema.properties ?? {}).map((name) => (
+                  <Badge key={name}>{name}</Badge>
+                ))}
+                {tool.secrets.map((secret) => (
+                  <Badge key={secret.name} tone="amber">
+                    {secret.name}: {secret.mask}
+                  </Badge>
+                ))}
+                <Badge>{tool.timeoutMs} ms</Badge>
+                <Badge>{tool.maxOutputBytes.toLocaleString()} B cap</Badge>
+              </div>
+              <div className="mt-3 flex gap-2">
+                <button
+                  type="button"
+                  onClick={() => setEditor({ open: true, existing: tool })}
+                  className="rounded-xl bg-white/5 px-3 py-1.5 text-[11px] text-white/70 ring-1 ring-white/10 hover:bg-white/10"
+                >
+                  Edit
+                </button>
+                <button
+                  type="button"
+                  onClick={() => setTryTool((current) => (current === tool.id ? "" : tool.id))}
+                  className="flex items-center gap-1 rounded-xl bg-cyan-400/10 px-3 py-1.5 text-[11px] text-cyan-200 ring-1 ring-cyan-400/25 hover:bg-cyan-400/20"
+                >
+                  <Terminal className="h-3 w-3" /> Try it
+                </button>
+              </div>
+              {tryTool === tool.id && (
+                <div className="mt-3">
+                  <TryItPanel tool={tool} />
+                </div>
+              )}
+            </div>
+          ))}
+        </div>
+      )}
+    </div>
+  );
+}
+
+// ---------------------------------------------------------------------------
+// Public library
+// ---------------------------------------------------------------------------
+
+function PublicTab({
+  snapshot,
+  query,
+  reload,
+  onNotice,
+  onOpenTab,
+}: {
+  snapshot: LibrarySnapshot;
+  query: string;
+  reload: () => Promise<void>;
+  onNotice: (text: string, tone: "ok" | "error") => void;
+  onOpenTab: (tab: Tab) => void;
+}) {
+  const [installing, setInstalling] = useState("");
+  const tools = useMemo(() => {
+    const q = query.trim().toLowerCase();
+    const all: CatalogTool[] = snapshot.catalogs.tools;
+    if (!q) return all;
+    return all.filter((entry) =>
+      [entry.title, entry.category, entry.description, entry.id].some((v) => v.toLowerCase().includes(q)),
+    );
+  }, [snapshot.catalogs.tools, query]);
+
+  const install = async (entry: CatalogTool) => {
+    setInstalling(entry.id);
+    try {
+      await api("/api/library/tools", {
+        method: "POST",
+        body: JSON.stringify({
+          tool: {
+            id: entry.id,
+            title: entry.title,
+            description: entry.description,
+            inputSchema: entry.inputSchema,
+            kind: entry.kind,
+            script: entry.script,
+            http: entry.http,
+            source: "catalog",
+          },
+        }),
+      });
+      onNotice(`${entry.title} was installed into your tools.`, "ok");
+      await reload();
+    } catch (error) {
+      onNotice(errText(error), "error");
+    } finally {
+      setInstalling("");
+    }
+  };
+
+  return (
+    <div className="space-y-8">
+      <div className="grid gap-3 sm:grid-cols-3">
+        {[
+          { label: "Public tools", count: snapshot.catalogs.tools.length, tab: "public" as Tab, icon: Wrench },
+          { label: "Public skills", count: snapshot.catalogs.skills.length, tab: "skills" as Tab, icon: BookOpen },
+          { label: "Public MCP servers", count: snapshot.catalogs.mcpServers.length, tab: "mcp" as Tab, icon: Boxes },
+        ].map((card) => (
+          <button
+            key={card.label}
+            type="button"
+            onClick={() => onOpenTab(card.tab === "public" ? "public" : card.tab)}
+            className="flex items-center justify-between rounded-2xl border border-white/10 bg-white/[0.03] p-4 text-left transition hover:bg-white/[0.06]"
+          >
+            <div className="flex items-center gap-2 text-xs text-white/60">
+              <card.icon className="h-4 w-4 text-cyan-300" /> {card.label}
+            </div>
+            <span className="text-lg font-semibold text-white/85">{card.count}</span>
+          </button>
+        ))}
+      </div>
+
+      <section>
+        <SectionHeading
+          title="Public tool library"
+          subtitle="Untrusted public content — inputs and implementation are shown before install."
+        />
+        <div className="grid gap-3 lg:grid-cols-2">
+          {tools.map((entry) => {
+            const installed = snapshot.tools.some((tool) => tool.id === entry.id);
+            const busy = installing === entry.id;
+            return (
+              <div key={entry.id} className="flex flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-4">
+                <div className="mb-1 flex items-start justify-between gap-2">
+                  <div>
+                    <div className="flex items-center gap-2 text-sm font-medium text-white/85">
+                      {entry.title}
+                      {entry.verified && <ShieldCheck className="h-3.5 w-3.5 text-emerald-400" />}
+                    </div>
+                    <div className="text-[11px] text-white/35">{entry.category}</div>
+                  </div>
+                  <Badge tone={entry.kind === "http" ? "cyan" : "slate"}>{entry.kind}</Badge>
+                </div>
+                <p className="mb-2 text-xs leading-relaxed text-white/55">{entry.description}</p>
+                <details className="mb-3 rounded-xl bg-black/30 px-3 py-2 text-[11px] text-white/45 ring-1 ring-white/5">
+                  <summary className="cursor-pointer select-none text-white/55">Review inputs and implementation</summary>
+                  <div className="mt-2 space-y-2">
+                    <div>
+                      <div className="mb-1 flex items-center gap-1 text-white/60">
+                        <Braces className="h-3 w-3" /> Inputs
+                      </div>
+                      <pre className="max-h-32 overflow-auto whitespace-pre-wrap font-mono text-[10px]">
+                        {JSON.stringify(entry.inputSchema, null, 2)}
+                      </pre>
+                    </div>
+                    {entry.kind === "script" && entry.script && (
+                      <div>
+                        <div className="mb-1 text-white/60">Script ({entry.script.language})</div>
+                        <pre className="max-h-48 overflow-auto whitespace-pre-wrap font-mono text-[10px]">{entry.script.source}</pre>
+                      </div>
+                    )}
+                    {entry.kind === "http" && entry.http && (
+                      <div className="break-all font-mono">
+                        {entry.http.method} {entry.http.url}
+                      </div>
+                    )}
+                    {entry.sourceUrl && (
+                      <a
+                        href={entry.sourceUrl}
+                        target="_blank"
+                        rel="noreferrer noopener"
+                        className="inline-flex items-center gap-1 font-sans text-cyan-300 hover:text-cyan-200"
+                      >
+                        Source <ExternalLink className="h-3 w-3" />
+                      </a>
+                    )}
+                  </div>
+                </details>
+                <button
+                  type="button"
+                  disabled={installed || busy}
+                  onClick={() => void install(entry)}
+                  className={`mt-auto flex items-center justify-center gap-1.5 rounded-xl px-3 py-1.5 text-xs font-medium transition ${
+                    installed
+                      ? "bg-white/5 text-white/35"
+                      : "bg-cyan-400/15 text-cyan-200 ring-1 ring-cyan-400/30 hover:bg-cyan-400/25"
+                  }`}
+                >
+                  {busy && <Loader2 className="h-3.5 w-3.5 animate-spin" />}
+                  {installed ? "Installed" : busy ? "Installing…" : "Install tool"}
+                </button>
+              </div>
+            );
+          })}
+        </div>
+      </section>
+    </div>
+  );
+}
+
+function EmptyState({ text }: { text: string }) {
+  return (
+    <div className="rounded-2xl border border-dashed border-white/10 bg-white/[0.02] px-4 py-8 text-center text-xs text-white/40">
+      {text}
+    </div>
+  );
+}
