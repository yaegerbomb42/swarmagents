+}) {
+  const [draft, setDraft] = useState<ToolDraft>(() => (existing ? draftFromTool(existing) : emptyToolDraft()));
+  const [saving, setSaving] = useState(false);
+
+  const secretNames = useMemo(() => {
+    const text = [draft.url, draft.bodyTemplate, ...draft.headers.map((h) => h.value)].join("\n");
+    return secretRefsIn(text);
+  }, [draft.url, draft.bodyTemplate, draft.headers]);
+
+  const save = async (event: FormEvent) => {
