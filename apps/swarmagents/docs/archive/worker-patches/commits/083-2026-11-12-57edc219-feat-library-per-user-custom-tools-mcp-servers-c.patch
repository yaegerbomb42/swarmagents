+  for (const entry of addresses) {
+    if (blockedIp(entry.address)) throw new Error(host + " resolves to a private or reserved address.");
+  }
+  return url;
+}
+
+function substitute(template, args, secrets) {
+  return String(template).replace(/\\{\\{\\s*(secret\\.)?([A-Za-z_][A-Za-z0-9_]*)\\s*\\}\\}/g, (match, isSecret, name) => {
+    if (isSecret) {
+      if (secrets[name] === undefined) throw new Error("Missing secret: " + name);
+      return String(secrets[name]);
+    }
+    if (args[name] === undefined) return match;
+    const value = args[name];
+    return typeof value === "string" ? value : JSON.stringify(value);
+  });
+}
+
+async function readCapped(response, maxBytes) {
+  const limit = Math.min(Math.max(1024, Number(maxBytes) || 100000), HARD_MAX_OUTPUT);
+  if (!response.body) return { text: "", truncated: false };
+  const reader = response.body.getReader();
+  const chunks = [];
+  let total = 0;
+  let truncated = false;
+  while (true) {
+    const step = await reader.read();
+    if (step.done) break;
+    const value = step.value;
+    if (total + value.length > limit) {
+      chunks.push(value.slice(0, Math.max(0, limit - total)));
+      truncated = true;
+      try { await reader.cancel(); } catch (err) {}
+      break;
+    }
+    chunks.push(value);
+    total += value.length;
+  }
+  return { text: Buffer.concat(chunks).toString("utf8"), truncated };
+}
+
+async function executeHttp(tool, args, secrets) {
+  if (!tool.http || typeof tool.http.url !== "string") throw new Error("This tool has no HTTP template.");
