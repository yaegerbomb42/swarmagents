index 000000000..573b838ed
--- /dev/null
+++ b/apps/swarmagents/app/api/library/connectors/route.ts
@@ -0,0 +1,88 @@
+/**
+ * POST/DELETE /api/library/connectors
+ *
+ * Install a connector from the public catalog (`{id, values?}`), which also
+ * registers its MCP server for the user; toggle one (`PATCH {id, enabled}`);
+ * or remove it (`DELETE ?id=`).
+ */
+
+import { NextResponse } from "next/server";
+import { connectorCatalog } from "../../../../lib/library/catalog";
+import { connectorToMcpServer } from "../../../../lib/library/connectors";
+import {
+  addUserMcpServer,
+  installConnector,
+  removeConnector,
+  setConnectorEnabled,
+} from "../../../../lib/library/store";
+import {
+  NO_STORE,
+  badRequest,
+  errorResponse,
+  libraryOwner,
+  queryParam,
+  readJsonBody,
+  unauthorized,
+} from "../../../../lib/library/api";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+export async function POST(request: Request) {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    const body = await readJsonBody(request);
+    const id = typeof body.id === "string" ? body.id : "";
+    const entry = connectorCatalog().find((candidate) => candidate.id === id);
+    if (!entry) return badRequest("Unknown connector.", 404);
+    const rawValues = body.values && typeof body.values === "object" && !Array.isArray(body.values)
+      ? (body.values as Record<string, unknown>)
+      : {};
+    const values: Record<string, string> = {};
+    for (const [key, value] of Object.entries(rawValues)) {
+      if (typeof value === "string") values[key] = value;
+    }
+    const connector = installConnector(owner, entry);
+    const serverInput = connectorToMcpServer(entry, values);
+    let server = null;
+    if (serverInput) {
+      try {
+        server = addUserMcpServer(owner, serverInput);
+      } catch {
+        // The connector row is installed even if an MCP server with that id
+        // already exists; the existing server stays as the user configured it.
+      }
+    }
+    return NextResponse.json({ connector, server }, { status: 201, headers: NO_STORE });
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
+
+export async function PATCH(request: Request) {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    const body = await readJsonBody(request);
+    const id = typeof body.id === "string" ? body.id : "";
+    if (!id) return badRequest("id is required.");
+    if (typeof body.enabled !== "boolean") return badRequest("enabled must be a boolean.");
+    return NextResponse.json({ connector: setConnectorEnabled(owner, id, body.enabled) }, { headers: NO_STORE });
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
+
+export async function DELETE(request: Request) {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    const id = queryParam(request, "id");
+    if (!id) return badRequest("id is required.");
+    removeConnector(owner, id);
+    return NextResponse.json({ ok: true }, { headers: NO_STORE });
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
diff --git a/apps/swarmagents/app/api/library/mcp-servers/route.ts b/apps/swarmagents/app/api/library/mcp-servers/route.ts
new file mode 100644
index 000000000..dfe3a2d9a
--- /dev/null
+++ b/apps/swarmagents/app/api/library/mcp-servers/route.ts
@@ -0,0 +1,102 @@
+/**
+ * POST/PATCH/DELETE /api/library/mcp-servers
+ *
+ * Add a user MCP server (`{server: {...}}`), install one from the public
+ * catalog (`{catalogId, values?}`), edit/toggle one (`PATCH {id, ...patch}`),
+ * or remove one (`DELETE ?id=`). Secrets are sealed on write and only masks
+ * are returned.
+ */
+
+import { NextResponse } from "next/server";
+import { mcpServerCatalog } from "../../../../lib/library/catalog";
+import {
+  addUserMcpServer,
+  deleteUserMcpServer,
+  installCatalogMcpServer,
+  updateUserMcpServer,
+  type RuntimeMcpServer,
+} from "../../../../lib/library/store";
+import {
+  NO_STORE,
+  badRequest,
+  errorResponse,
+  libraryOwner,
+  queryParam,
+  readJsonBody,
+  unauthorized,
+} from "../../../../lib/library/api";
+import { readUserLibrary, mcpServerRow } from "../../../../lib/library/store";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+export async function POST(request: Request) {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    const body = await readJsonBody(request);
+    const catalogId = typeof body.catalogId === "string" ? body.catalogId : "";
+    if (catalogId) {
+      const entry = mcpServerCatalog().find((candidate) => candidate.id === catalogId);
+      if (!entry) return badRequest("Unknown catalog server.", 404);
+      const rawValues = body.values && typeof body.values === "object" && !Array.isArray(body.values)
+        ? (body.values as Record<string, unknown>)
+        : {};
+      const values: Record<string, string> = {};
+      for (const [key, value] of Object.entries(rawValues)) {
+        if (typeof value === "string") values[key] = value;
+      }
+      return NextResponse.json({ server: installCatalogMcpServer(owner, entry, values) }, { status: 201, headers: NO_STORE });
+    }
+    const server = addUserMcpServer(owner, body.server !== undefined ? body.server : body);
+    return NextResponse.json({ server }, { status: 201, headers: NO_STORE });
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
+
+/** Read the raw server so a PATCH can merge onto the existing definition. */
+function existingServer(owner: string, id: string): Record<string, unknown> | null {
+  const lib = readUserLibrary(owner);
+  const server = lib.mcpServers.find((candidate) => candidate.id === id);
+  if (!server) return null;
+  // mcpServerRow masks secrets; the update path keeps saved values for names
+  // whose value is omitted, so only the names are needed here.
+  const row = mcpServerRow(server, {});
+  const { secrets: _secrets, ...rest } = row;
+  void _secrets;
+  return rest as Record<string, unknown>;
+}
+
+export async function PATCH(request: Request) {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    const body = await readJsonBody(request);
+    const id = typeof body.id === "string" ? body.id : "";
+    if (!id) return badRequest("id is required.");
+    const patch = body.server !== undefined ? body.server : body;
+    const current = existingServer(owner, id);
+    if (!current) return badRequest("Unknown MCP server.", 404);
+    const merged: Record<string, unknown> = { ...current, ...(patch as Record<string, unknown>), id };
+    if (body.secrets !== undefined) merged.secrets = body.secrets;
+    return NextResponse.json({ server: updateUserMcpServer(owner, id, merged) }, { headers: NO_STORE });
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
+
+export async function DELETE(request: Request) {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    const id = queryParam(request, "id");
+    if (!id) return badRequest("id is required.");
+    deleteUserMcpServer(owner, id);
+    return NextResponse.json({ ok: true }, { headers: NO_STORE });
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
+
+export type { RuntimeMcpServer };
diff --git a/apps/swarmagents/app/api/library/route.test.ts b/apps/swarmagents/app/api/library/route.test.ts
new file mode 100644
index 000000000..afa223670
--- /dev/null
+++ b/apps/swarmagents/app/api/library/route.test.ts
@@ -0,0 +1,310 @@
+/**
+ * Library API routes end to end (handlers called directly).
+ *
+ * Per-account isolation, create/edit/delete for script and HTTP tools, masked
+ * secrets, and the "Try it" route driving the user's VM. The VM driver is a
+ * fake that returns the same JSON contract the generated server produces.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { GET as GET_LIBRARY } from "./route";
+import { GET as LIST_TOOLS, POST as CREATE_TOOL } from "./tools/route";
+import { DELETE as DELETE_TOOL, GET as GET_TOOL, PATCH as PATCH_TOOL } from "./tools/[id]/route";
+import { POST as RUN_TOOL } from "./tools/[id]/run/route";
+import { POST as POST_SKILL, PATCH as PATCH_SKILL, DELETE as DELETE_SKILL } from "./skills/route";
+import { POST as POST_CONNECTOR, DELETE as DELETE_CONNECTOR } from "./connectors/route";
+import { POST as POST_MCP, PATCH as PATCH_MCP, DELETE as DELETE_MCP } from "./mcp-servers/route";
+import { VmManager, setVmManagerForTesting } from "../../../lib/vm/manager";
+import { FakeVmDriver } from "../../../lib/vm/fake-driver";
+import type { ExecOptions, ExecResult, VmHandle } from "../../../lib/vm/types";
+
+const ALICE = "alice@example.com";
+const BOB = "bob@example.com";
+const SECRET = "sk-route-secret-a1b2";
+
+let tempDir: string;
+let previousHome: string | undefined;
+let driver: ToolVmDriver;
+
+class ToolVmDriver extends FakeVmDriver {
+  calls: string[][] = [];
+
+  override async exec(handle: VmHandle, cmd: string[], opts?: ExecOptions): Promise<ExecResult> {
+    if (cmd[0] === "node" && cmd[2] === "--run") {
+      this.calls.push(cmd);
+      const id = cmd[3];
+      const input = JSON.parse(String(opts?.stdin ?? "{}")) as Record<string, unknown>;
+      const result =
+        id === "echo_tool"
+          ? { ok: true, output: `hello ${String(input.name ?? "")}`, truncated: false, exitCode: 0, durationMs: 1 }
+          : { ok: false, output: "blocked by fake", truncated: false, exitCode: 1 };
+      opts?.onStdout?.(`${JSON.stringify(result)}\n`);
+      return { exitCode: 0 };
+    }
+    return super.exec(handle, cmd, opts);
+  }
+}
+
+test.beforeEach(() => {
+  tempDir = mkdtempSync(join(tmpdir(), "swarm-library-api-"));
+  previousHome = process.env.SWARM_HOME;
+  process.env.SWARM_HOME = tempDir;
+  driver = new ToolVmDriver();
+  setVmManagerForTesting(new VmManager({ customDriver: driver }));
+});
+
+test.afterEach(() => {
+  setVmManagerForTesting(null);
+  if (previousHome === undefined) delete process.env.SWARM_HOME;
+  else process.env.SWARM_HOME = previousHome;
+  rmSync(tempDir, { recursive: true, force: true });
+});
+
+function request(method: string, url: string, user: string | null, body?: unknown): Request {
+  const headers = new Headers();
+  if (user) headers.set("x-swarm-user", user);
+  if (body !== undefined) headers.set("content-type", "application/json");
+  return new Request(`http://localhost${url}`, {
+    method,
+    headers,
+    ...(body !== undefined ? { body: JSON.stringify(body) } : {}),
+  });
+}
+
+function ctx(id: string) {
+  return { params: Promise.resolve({ id }) };
+}
+
+async function createToolAs(user: string, tool: Record<string, unknown>) {
+  const res = await CREATE_TOOL(request("POST", "/api/library/tools", user, { tool }));
+  const body = (await res.json()) as { tool?: Record<string, unknown>; error?: string };
+  return { res, body };
+}
+
+function scriptTool(overrides: Record<string, unknown> = {}): Record<string, unknown> {
+  return {
+    title: "Echo Tool",
+    description: "Echo a name",
+    inputSchema: { type: "object", properties: { name: { type: "string" } }, required: ["name"] },
+    kind: "script",
+    script: { language: "node", source: "console.log('hi')" },
+    timeoutMs: 2_000,
+    maxOutputBytes: 1_024,
+    secrets: [{ name: "API_TOKEN", value: SECRET }],
+    ...overrides,
+  };
+}
+
+test("create, list, read, edit and delete a script tool without leaking secrets", async () => {
+  const { res, body } = await createToolAs(ALICE, scriptTool());
+  assert.equal(res.status, 201);
+  const text = JSON.stringify(body);
+  assert.equal(text.includes(SECRET), false, "create response leaked the secret");
+  assert.deepEqual((body.tool as { secrets: unknown }).secrets, [{ name: "API_TOKEN", mask: "••••a1b2" }]);
+
+  const listed = await (await LIST_TOOLS(request("GET", "/api/library/tools", ALICE))).json();
+  assert.equal((listed as { tools: unknown[] }).tools.length, 1);
+
+  const read = await GET_TOOL(request("GET", "/api/library/tools/echo_tool", ALICE), ctx("echo_tool"));
+  assert.equal(read.status, 200);
+  assert.equal(JSON.stringify(await read.json()).includes(SECRET), false);
+
+  // Editing without a secret value keeps the saved one (mask still a1b2).
+  const patched = await PATCH_TOOL(
+    request("PATCH", "/api/library/tools/echo_tool", ALICE, {
+      tool: scriptTool({ title: "Echo Tool v2", secrets: [{ name: "API_TOKEN" }] }),
+    }),
+    ctx("echo_tool"),
+  );
+  assert.equal(patched.status, 200);
+  const patchedBody = (await patched.json()) as { tool: { title: string; secrets: Array<{ mask: string }> } };
+  assert.equal(patchedBody.tool.title, "Echo Tool v2");
+  assert.deepEqual(patchedBody.tool.secrets, [{ name: "API_TOKEN", mask: "••••a1b2" }]);
+
+  const removed = await DELETE_TOOL(request("DELETE", "/api/library/tools/echo_tool", ALICE), ctx("echo_tool"));
+  assert.equal(removed.status, 200);
+  const after = await (await LIST_TOOLS(request("GET", "/api/library/tools", ALICE))).json();
+  assert.deepEqual((after as { tools: unknown[] }).tools, []);
+});
+
+test("an HTTP tool with an SSRF-sensitive target is rejected before it can run", async () => {
+  const { res } = await createToolAs(
+    ALICE,
+    scriptTool({
+      title: "Meta fetch",
+      kind: "http",
+      script: undefined,
+      http: { method: "GET", url: "http://169.254.169.254/latest/meta-data", headers: [] },
+      secrets: [],
+    }),
+  );
+  assert.equal(res.status, 201);
+
+  const run = await RUN_TOOL(
+    request("POST", "/api/library/tools/meta_fetch/run", ALICE, { input: {} }),
+    ctx("meta_fetch"),
+  );
+  assert.equal(run.status, 400);
+  const body = (await run.json()) as { error?: string };
+  assert.match(body.error ?? "", /private or reserved/);
+});
+
+test("create, edit, test and delete an HTTP tool", async () => {
+  const created = await createToolAs(
+    ALICE,
+    scriptTool({
+      id: "status_check",
+      title: "Status check",
+      kind: "http",
+      script: undefined,
+      http: {
+        method: "GET",
+        url: "https://api.example.com/status/{{id}}",
+        headers: [{ name: "Authorization", value: "Bearer {{secret.API_TOKEN}}" }],
+      },
+      inputSchema: { type: "object", properties: { id: { type: "string" } }, required: ["id"] },
+    }),
+  );
+  assert.equal(created.res.status, 201);
+  assert.equal((created.body.tool as { kind: string }).kind, "http");
+
+  const read = await GET_TOOL(request("GET", "/api/library/tools/status_check", ALICE), ctx("status_check"));
+  assert.equal(read.status, 200);
+
+  const patched = await PATCH_TOOL(
+    request("PATCH", "/api/library/tools/status_check", ALICE, {
+      tool: scriptTool({
+        id: "status_check",
+        title: "Status check v2",
+        kind: "http",
+        script: undefined,
+        http: { method: "POST", url: "https://api.example.com/status", headers: [] },
+        secrets: [{ name: "API_TOKEN" }],
+      }),
+    }),
+    ctx("status_check"),
+  );
+  assert.equal(patched.status, 200);
+  const patchedBody = (await patched.json()) as { tool: { title: string; http: { method: string }; secrets: unknown[] } };
+  assert.equal(patchedBody.tool.title, "Status check v2");
+  assert.equal(patchedBody.tool.http.method, "POST");
+  assert.deepEqual(patchedBody.tool.secrets, [{ name: "API_TOKEN", mask: "••••a1b2" }]);
+
+  // The "Try it" route drives the same VM path for HTTP tools.
+  const run = await RUN_TOOL(
+    request("POST", "/api/library/tools/status_check/run", ALICE, { input: { id: "1" } }),
+    ctx("status_check"),
+  );
+  assert.equal(run.status, 200);
+  assert.equal(driver.calls.length, 1, "the HTTP tool ran via the VM exec path");
+
+  const removed = await DELETE_TOOL(request("DELETE", "/api/library/tools/status_check", ALICE), ctx("status_check"));
+  assert.equal(removed.status, 200);
+  assert.equal((await GET_TOOL(request("GET", "/api/library/tools/status_check", ALICE), ctx("status_check"))).status, 404);
+});
+
+test("Try it runs through the user's VM and returns its result", async () => {
+  await createToolAs(ALICE, scriptTool({ secrets: [] }));
+  const res = await RUN_TOOL(
+    request("POST", "/api/library/tools/echo_tool/run", ALICE, { input: { name: "jimmy" } }),
+    ctx("echo_tool"),
+  );
+  assert.equal(res.status, 200);
+  const body = (await res.json()) as { result: { ok: boolean; output: string } };
+  assert.equal(body.result.ok, true);
+  assert.equal(body.result.output, "hello jimmy");
+  assert.equal(driver.calls.length, 1, "the tool ran via the VM exec path");
+});
+
+test("Bob cannot read, edit, run or delete Alice's tool, and the snapshot is per account", async () => {
+  await createToolAs(ALICE, scriptTool());
+
+  const list = await (await LIST_TOOLS(request("GET", "/api/library/tools", BOB))).json();
+  assert.deepEqual((list as { tools: unknown[] }).tools, []);
+  assert.equal((await GET_TOOL(request("GET", "/api/library/tools/echo_tool", BOB), ctx("echo_tool"))).status, 404);
+  assert.equal(
+    (await PATCH_TOOL(request("PATCH", "/api/library/tools/echo_tool", BOB, { tool: scriptTool() }), ctx("echo_tool"))).status,
+    404,
+  );
+  assert.equal(
+    (await DELETE_TOOL(request("DELETE", "/api/library/tools/echo_tool", BOB), ctx("echo_tool"))).status,
+    404,
+  );
+  assert.equal(
+    (await RUN_TOOL(request("POST", "/api/library/tools/echo_tool/run", BOB, { input: {} }), ctx("echo_tool"))).status,
+    404,
+  );
+
+  const aliceSnapshot = (await (await GET_LIBRARY(request("GET", "/api/library", ALICE))).json()) as {
+    tools: unknown[];
+    catalogs: { tools: unknown[]; skills: unknown[]; mcpServers: unknown[] };
+  };
+  assert.equal(aliceSnapshot.tools.length, 1);
+  assert.ok(aliceSnapshot.catalogs.tools.length > 0, "public tool catalog is included");
+  assert.ok(aliceSnapshot.catalogs.skills.length > 0, "public skill catalog is included");
+  assert.ok(aliceSnapshot.catalogs.mcpServers.length > 0, "public MCP catalog is included");
+
+  const bobSnapshot = (await (await GET_LIBRARY(request("GET", "/api/library", BOB))).json()) as { tools: unknown[] };
+  assert.deepEqual(bobSnapshot.tools, []);
+});
+
+test("skills install, toggle and delete through the route", async () => {
+  const installed = await POST_SKILL(request("POST", "/api/library/skills", ALICE, { id: "code-review" }));
+  assert.equal(installed.status, 201);
+  const installedBody = (await installed.json()) as { skill: { id: string } };
+  const id = installedBody.skill.id;
+  assert.equal(id, "focused_code_review");
+  const toggled = await PATCH_SKILL(
+    request("PATCH", "/api/library/skills", ALICE, { id, enabled: false }),
+  );
+  assert.equal(((await toggled.json()) as { skill: { enabled: boolean } }).skill.enabled, false);
+  assert.equal((await DELETE_SKILL(request("DELETE", `/api/library/skills?id=${id}`, ALICE))).status, 200);
+});
+
+test("installing a connector also registers its MCP server", async () => {
+  const res = await POST_CONNECTOR(
+    request("POST", "/api/library/connectors", ALICE, { id: "slack", values: {} }),
+  );
+  assert.equal(res.status, 201);
+  const body = (await res.json()) as { connector: { id: string }; server: { id: string } | null };
+  assert.equal(body.connector.id, "slack");
+  assert.ok(body.server, "connector install should create an MCP server entry");
+  assert.equal((await DELETE_CONNECTOR(request("DELETE", "/api/library/connectors?id=slack", ALICE))).status, 200);
+});
+
+test("MCP servers can be added, toggled and removed, and catalog installs seal values", async () => {
+  const added = await POST_MCP(
+    request("POST", "/api/library/mcp-servers", ALICE, {
+      server: {
+        title: "My docs",
+        transport: "stdio",
+        command: "npx",
+        args: ["-y", "docs-mcp"],
+        secrets: [{ name: "API_TOKEN", value: SECRET }],
+      },
+    }),
+  );
+  assert.equal(added.status, 201);
+  assert.equal((await added.text()).includes(SECRET), false);
+
+  const toggled = await PATCH_MCP(
+    request("PATCH", "/api/library/mcp-servers", ALICE, {
+      id: "my_docs",
+      enabled: false,
+      secrets: [{ name: "API_TOKEN" }],
+    }),
+  );
+  assert.equal(toggled.status, 200);
+  assert.equal(((await toggled.json()) as { server: { enabled: boolean } }).server.enabled, false);
+
+  const catalog = await POST_MCP(
+    request("POST", "/api/library/mcp-servers", ALICE, { catalogId: "filesystem-mcp", values: {} }),
+  );
+  assert.equal(catalog.status, 201);
+
+  assert.equal((await DELETE_MCP(request("DELETE", "/api/library/mcp-servers?id=my_docs", ALICE))).status, 200);
+});
