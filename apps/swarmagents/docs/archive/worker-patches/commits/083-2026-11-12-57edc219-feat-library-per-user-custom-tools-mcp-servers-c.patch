+/**
+ * POST /api/library/tools/[id]/run — the "Try it" panel.
+ *
+ * Runs the tool once inside the caller's own VM (script tools spawn their
+ * interpreter there; HTTP tools fetch from there through the SSRF guard) and
+ * returns the result. This route never executes user code in the Next.js
+ * process and never echoes secret values.
+ */
+
+import { NextResponse } from "next/server";
+import { resolveUserTool } from "../../../../../../lib/library/store";
+import { runUserToolInVm } from "../../../../../../lib/library/execute";
+import {
+  NO_STORE,
+  badRequest,
+  errorResponse,
+  libraryOwner,
+  readJsonBody,
+  unauthorized,
+} from "../../../../../../lib/library/api";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+interface RouteContext {
+  params: Promise<{ id: string }>;
+}
+
+async function routeId(ctx: RouteContext): Promise<string> {
+  const params = await Promise.resolve(ctx.params);
+  return typeof params?.id === "string" ? params.id : "";
+}
+
+export async function POST(request: Request, ctx: RouteContext) {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    const id = await routeId(ctx);
+    const tool = resolveUserTool(owner, id);
+    if (!tool) return NextResponse.json({ error: "Unknown tool." }, { status: 404, headers: NO_STORE });
+
+    const body = await readJsonBody(request);
+    const input = body.input !== undefined ? body.input : {};
+    if (!input || typeof input !== "object" || Array.isArray(input)) {
+      return badRequest("input must be a JSON object.");
+    }
+    const result = await runUserToolInVm(owner, tool, input as Record<string, unknown>);
+    return NextResponse.json({ result }, { headers: NO_STORE });
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
