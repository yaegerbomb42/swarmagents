diff --git a/apps/swarmagents/lib/library/api.ts b/apps/swarmagents/lib/library/api.ts
new file mode 100644
index 000000000..05c094000
--- /dev/null
+++ b/apps/swarmagents/lib/library/api.ts
@@ -0,0 +1,64 @@
+/**
+ * Shared plumbing for the Library API routes.
+ *
+ * Ownership comes from the middleware-set x-swarm-user header (local mode
+ * falls back to the "local" owner, matching providers). Every mutation is
+ * scoped to that owner — there is no cross-account path.
+ */
+
+import { NextResponse } from "next/server";
+import { providerOwner } from "../providers/owner";
+import { LibraryValidationError } from "./types";
+
+export const NO_STORE = { "cache-control": "no-store" } as const;
+export const MAX_LIBRARY_BODY_BYTES = 512 * 1024;
+
+export function libraryOwner(request: Request): string | null {
+  return providerOwner(request);
+}
+
+export function unauthorized(): NextResponse {
+  return NextResponse.json({ error: "Sign in required." }, { status: 401, headers: NO_STORE });
+}
+
+export function badRequest(message: string, status = 400): NextResponse {
+  return NextResponse.json({ error: message }, { status, headers: NO_STORE });
+}
+
+export async function readJsonBody(request: Request): Promise<Record<string, unknown>> {
+  const text = await request.text();
+  if (text.length > MAX_LIBRARY_BODY_BYTES) {
+    throw new LibraryValidationError("Request body too large.", 413);
+  }
+  let body: unknown;
+  try {
+    body = text ? JSON.parse(text) : {};
+  } catch {
+    throw new LibraryValidationError("Invalid JSON body.");
+  }
+  if (!body || typeof body !== "object" || Array.isArray(body)) {
+    throw new LibraryValidationError("Body must be a JSON object.");
+  }
+  return body as Record<string, unknown>;
+}
+
+/** Map a thrown error to a safe JSON response (never echoes a secret). */
+export function errorResponse(error: unknown): NextResponse {
+  if (error instanceof LibraryValidationError) {
+    return badRequest(error.message, error.status);
+  }
+  if (error instanceof Error && /quota|timed out|timeout/i.test(error.message)) {
+    return badRequest(error.message, 429);
+  }
+  // Unexpected failures are logged server-side without request payloads.
+  console.error("[swarm-library] request failed:", error instanceof Error ? error.name : "unknown error");
+  return badRequest("The request could not be completed.", 500);
+}
+
+export function queryParam(request: Request, name: string): string {
+  try {
+    return new URL(request.url).searchParams.get(name) ?? "";
+  } catch {
+    return "";
+  }
+}
diff --git a/apps/swarmagents/lib/library/catalog.ts b/apps/swarmagents/lib/library/catalog.ts
new file mode 100644
index 000000000..13d70a4d4
--- /dev/null
+++ b/apps/swarmagents/lib/library/catalog.ts
@@ -0,0 +1,154 @@
+/**
+ * Public Library catalogs.
+ *
+ * These files are shipped read-only with the app. They are *untrusted content*:
+ * the Library page always renders an entry's description/source before the
+ * install action, and install copies a normalized definition into the user's
+ * own library — the catalog itself is never executed.
+ */
+
+import connectorsJson from "./catalog/connectors.json";
+import skillsJson from "./catalog/skills.json";
+import toolsJson from "./catalog/tools.json";
+import mcpServersJson from "./catalog/mcp-servers.json";
+import type { CatalogMcpServer, CatalogSkill, CatalogTool, HttpMethod } from "./types";
+import { HTTP_METHODS } from "./types";
+
+export interface ConnectorCatalogEntry {
+  id: string;
+  name: string;
+  category: string;
+  description: string;
+  transport: "http" | "stdio";
+  install: string;
+  requiredFields: Array<{ key: string; label: string; secret?: boolean; helpUrl?: string }>;
+  auth: string;
+  tools: string[];
+  sourceUrl: string;
+  verified: boolean;
+  verifiedHow: string;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function normalizeMethod(value: unknown): HttpMethod {
+  const method = typeof value === "string" ? value.toUpperCase() : "GET";
+  return (HTTP_METHODS as readonly string[]).includes(method) ? (method as HttpMethod) : "GET";
+}
+
+/** Connector catalog, validated down to the fields the UI relies on. */
+export function connectorCatalog(): ConnectorCatalogEntry[] {
+  return (connectorsJson as unknown[])
+    .filter(isRecord)
+    .map((entry) => ({
+      id: String(entry.id ?? ""),
+      name: String(entry.name ?? entry.id ?? ""),
+      category: String(entry.category ?? "other"),
+      description: String(entry.description ?? ""),
+      transport: (entry.transport === "stdio" ? "stdio" : "http") as ConnectorCatalogEntry["transport"],
+      install: String(entry.install ?? ""),
+      requiredFields: Array.isArray(entry.requiredFields)
+        ? entry.requiredFields.filter(isRecord).map((field) => ({
+            key: String(field.key ?? ""),
+            label: String(field.label ?? field.key ?? ""),
+            ...(field.secret === true ? { secret: true } : {}),
+            ...(typeof field.helpUrl === "string" ? { helpUrl: field.helpUrl } : {}),
+          }))
+        : [],
+      auth: String(entry.auth ?? ""),
+      tools: Array.isArray(entry.tools) ? entry.tools.filter((tool): tool is string => typeof tool === "string") : [],
+      sourceUrl: String(entry.sourceUrl ?? ""),
+      verified: entry.verified === true,
+      verifiedHow: String(entry.verifiedHow ?? ""),
+    }))
+    .filter((entry) => entry.id.length > 0);
+}
+
+export function skillCatalog(): CatalogSkill[] {
+  return (skillsJson as unknown[]).filter(isRecord).map((entry) => ({
+    id: String(entry.id ?? ""),
+    title: String(entry.title ?? ""),
+    description: String(entry.description ?? ""),
+    category: String(entry.category ?? "general"),
+    instructions: String(entry.instructions ?? ""),
+    ...(typeof entry.sourceUrl === "string" ? { sourceUrl: entry.sourceUrl } : {}),
+    ...(entry.verified === true ? { verified: true } : {}),
+  })).filter((entry) => entry.id.length > 0 && entry.title.length > 0);
+}
+
+export function toolCatalog(): CatalogTool[] {
+  return (toolsJson as unknown[]).filter(isRecord).map((entry) => ({
+    id: String(entry.id ?? ""),
+    title: String(entry.title ?? ""),
+    description: String(entry.description ?? ""),
+    category: String(entry.category ?? "general"),
+    kind: (entry.kind === "http" ? "http" : "script") as CatalogTool["kind"],
+    inputSchema: isRecord(entry.inputSchema)
+      ? (entry.inputSchema as CatalogTool["inputSchema"])
+      : ({ type: "object", properties: {} } as CatalogTool["inputSchema"]),
+    ...(isRecord(entry.script)
+      ? {
+          script: {
+            language: (entry.script.language === "bash" || entry.script.language === "python" ? entry.script.language : "node") as
+              | "bash"
+              | "node"
+              | "python",
+            source: String(entry.script.source ?? ""),
+          },
+        }
+      : {}),
+    ...(isRecord(entry.http)
+      ? {
+          http: {
+            method: normalizeMethod(entry.http.method),
+            url: String(entry.http.url ?? ""),
+            headers: Array.isArray(entry.http.headers)
+              ? entry.http.headers.filter(isRecord).map((header) => ({
+                  name: String(header.name ?? ""),
+                  value: String(header.value ?? ""),
+                }))
+              : [],
+            ...(typeof entry.http.bodyTemplate === "string" ? { bodyTemplate: entry.http.bodyTemplate } : {}),
+          },
+        }
+      : {}),
+    ...(typeof entry.sourceUrl === "string" ? { sourceUrl: entry.sourceUrl } : {}),
+    ...(entry.verified === true ? { verified: true } : {}),
+  })).filter((entry) => entry.id.length > 0 && entry.title.length > 0);
+}
+
+export function mcpServerCatalog(): CatalogMcpServer[] {
+  return (mcpServersJson as unknown[]).filter(isRecord).map((entry) => ({
+    id: String(entry.id ?? ""),
+    title: String(entry.title ?? ""),
+    description: String(entry.description ?? ""),
+    category: String(entry.category ?? "general"),
+    transport: (entry.transport === "http" ? "http" : "stdio") as CatalogMcpServer["transport"],
+    ...(typeof entry.command === "string" ? { command: entry.command } : {}),
+    ...(Array.isArray(entry.args) ? { args: entry.args.filter((arg): arg is string => typeof arg === "string") } : {}),
+    ...(typeof entry.url === "string" ? { url: entry.url } : {}),
+    ...(Array.isArray(entry.requiredFields)
+      ? {
+          requiredFields: entry.requiredFields.filter(isRecord).map((field) => ({
+            key: String(field.key ?? ""),
+            label: String(field.label ?? field.key ?? ""),
+            ...(field.secret === true ? { secret: true } : {}),
+          })),
+        }
+      : {}),
+    ...(typeof entry.sourceUrl === "string" ? { sourceUrl: entry.sourceUrl } : {}),
+    ...(entry.verified === true ? { verified: true } : {}),
+  })).filter((entry) => entry.id.length > 0 && entry.title.length > 0);
+}
+
+/** Everything GET /api/library ships alongside the user's installed rows. */
+export function publicCatalogs() {
+  return {
+    connectors: connectorCatalog() as unknown as Array<Record<string, unknown>>,
+    skills: skillCatalog(),
+    tools: toolCatalog(),
+    mcpServers: mcpServerCatalog(),
+  };
+}
