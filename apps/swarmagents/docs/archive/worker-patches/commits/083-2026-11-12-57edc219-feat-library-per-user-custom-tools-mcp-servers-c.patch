@@ -0,0 +1,762 @@
+/**
+ * Per-user Library store.
+ *
+ * A user's installed connectors, MCP servers, skills and custom tools live in
+ * `<data dir>/users/<hash(userId)>/library.json` — the same per-user layout as
+ * providers and roles. There is no server-wide library: an account's entries
+ * are its own, and every function takes the owner's user id first.
+ *
+ * Secret values are sealed with AES-256-GCM (lib/providers/secret-box) and
+ * bound to the owner + entry, exactly like provider keys. Read paths that
+ * return rows for the browser expose only a last-4 mask; only the runtime
+ * path (`runtimeLibrary`) opens values, and it hands them to the user's VM —
+ * never to a client response and never to a log line.
+ */
+
+import fs from "node:fs";
+import path from "node:path";
+import { open, seal } from "../providers/secret-box";
+import { resolveDataDir, userDirName, type DataDirOptions } from "../providers/store";
+import {
+  LIBRARY_SCHEMA,
+  LIBRARY_SCHEMA_VERSION,
+  LibraryValidationError,
+  maskSecret,
+  normalizeMcpServerInput,
+  normalizeSkillInput,
+  normalizeUserToolInput,
+  type CatalogMcpServer,
+  type CatalogSkill,
+  type CatalogTool,
+  type InstalledConnector,
+  type InstalledSkill,
+  type LibrarySnapshot,
+  type SecretInput,
+  type SecretRow,
+  type ToolHeader,
+  type UserMcpServer,
+  type UserMcpServerRow,
+  type UserTool,
+  type UserToolRow,
+} from "./types";
+
+export const USER_LIBRARY_FILE = "library.json";
+const MAX_USER_ID_LEN = 256;
+
+function requireUserId(userId: string): string {
+  if (typeof userId !== "string" || userId.length === 0 || userId.length > MAX_USER_ID_LEN) {
+    throw new LibraryValidationError("A signed-in user is required.", 401);
+  }
+  return userId;
+}
+
+export function userLibraryFilePath(userId: string, options: DataDirOptions = {}): string {
+  return path.join(resolveDataDir(options), "users", userDirName(userId), USER_LIBRARY_FILE);
+}
+
+interface StoredTool extends UserTool {
+  /** Secret name -> sealed value. Never returned to a client. */
+  sealedSecrets: Record<string, string>;
+}
+
+interface StoredMcpServer extends UserMcpServer {
+  sealedSecrets: Record<string, string>;
+}
+
+interface StoredLibrary {
+  schema: string;
+  version: number;
+  userId: string;
+  tools: StoredTool[];
+  mcpServers: StoredMcpServer[];
+  skills: InstalledSkill[];
+  connectors: InstalledConnector[];
+}
+
+function emptyLibrary(userId: string): StoredLibrary {
+  return {
+    schema: LIBRARY_SCHEMA,
+    version: LIBRARY_SCHEMA_VERSION,
+    userId,
+    tools: [],
+    mcpServers: [],
+    skills: [],
+    connectors: [],
+  };
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function asString(value: unknown, max = 500): string {
+  return typeof value === "string" ? value.slice(0, max) : "";
+}
+
+/** Defensive parse; malformed entries are dropped rather than failing the page. */
+function parseLibrary(raw: unknown, userId: string): StoredLibrary {
+  if (!isRecord(raw)) return emptyLibrary(userId);
+  if (asString(raw.userId, MAX_USER_ID_LEN) !== userId) return emptyLibrary(userId);
+  const lib = emptyLibrary(userId);
+  if (Array.isArray(raw.tools)) {
+    for (const item of raw.tools.slice(0, 200)) {
+      const normalized = safeNormalizeTool(item, "catalog");
+      if (!normalized) continue;
+      const sealedSecrets: Record<string, string> = {};
+      if (isRecord(item) && isRecord(item.sealedSecrets)) {
+        for (const [name, value] of Object.entries(item.sealedSecrets)) {
+          if (typeof value === "string") sealedSecrets[name] = value;
+        }
+      }
+      lib.tools.push({ ...normalized, sealedSecrets });
+    }
+  }
+  if (Array.isArray(raw.mcpServers)) {
+    for (const item of raw.mcpServers.slice(0, 64)) {
+      const normalized = safeNormalizeMcp(item);
+      if (!normalized) continue;
+      const sealedSecrets: Record<string, string> = {};
+      if (isRecord(item) && isRecord(item.sealedSecrets)) {
+        for (const [name, value] of Object.entries(item.sealedSecrets)) {
+          if (typeof value === "string") sealedSecrets[name] = value;
+        }
+      }
+      lib.mcpServers.push({ ...normalized, sealedSecrets });
+    }
+  }
+  if (Array.isArray(raw.skills)) {
+    for (const item of raw.skills.slice(0, 200)) {
+      try {
+        const skill = normalizeSkillInput(item);
+        lib.skills.push({
+          ...skill,
+          source: skill.source,
+          createdAt: typeof (item as { createdAt?: unknown }).createdAt === "number" ? (item as { createdAt: number }).createdAt : Date.now(),
+          updatedAt: typeof (item as { updatedAt?: unknown }).updatedAt === "number" ? (item as { updatedAt: number }).updatedAt : Date.now(),
+        });
+      } catch {
+        // Drop a malformed entry; the rest of the library still loads.
+      }
+    }
+  }
+  if (Array.isArray(raw.connectors)) {
+    for (const item of raw.connectors.slice(0, 200)) {
+      if (!isRecord(item)) continue;
+      const id = asString(item.id, 60);
+      if (!id) continue;
+      lib.connectors.push({
+        id,
+        name: asString(item.name, 80) || id,
+        transport: item.transport === "stdio" ? "stdio" : "http",
+        install: asString(item.install, 2_000),
+        auth: asString(item.auth, 40),
+        enabled: item.enabled !== false,
+        installedAt: typeof item.installedAt === "number" ? item.installedAt : Date.now(),
+      });
+    }
+  }
+  return lib;
+}
+
+function safeNormalizeTool(raw: unknown, source: UserTool["source"]): UserTool | null {
+  try {
+    const body = isRecord(raw) ? raw : {};
+    const input = normalizeUserToolInput({ ...body, source: body.source ?? source });
+    return {
+      id: input.id,
+      title: input.title,
+      description: input.description,
+      inputSchema: input.inputSchema,
+      kind: input.kind,
+      ...(input.script ? { script: input.script } : {}),
+      ...(input.http ? { http: input.http } : {}),
+      timeoutMs: input.timeoutMs,
+      maxOutputBytes: input.maxOutputBytes,
+      enabled: input.enabled,
+      source: input.source,
+      createdAt: typeof (raw as { createdAt?: unknown })?.createdAt === "number" ? (raw as { createdAt: number }).createdAt : Date.now(),
+      updatedAt: typeof (raw as { updatedAt?: unknown })?.updatedAt === "number" ? (raw as { updatedAt: number }).updatedAt : Date.now(),
+    };
+  } catch {
+    return null;
+  }
+}
+
+function safeNormalizeMcp(raw: unknown): UserMcpServer | null {
+  try {
+    const body = isRecord(raw) ? raw : {};
+    const input = normalizeMcpServerInput(body);
+    return {
+      id: input.id,
+      title: input.title,
+      description: input.description,
+      transport: input.transport,
+      ...(input.command ? { command: input.command } : {}),
+      ...(input.args ? { args: input.args } : {}),
+      ...(input.url ? { url: input.url } : {}),
+      headers: input.headers,
+      env: input.env,
+      enabled: input.enabled,
+      source: input.source,
+      createdAt: typeof (raw as { createdAt?: unknown })?.createdAt === "number" ? (raw as { createdAt: number }).createdAt : Date.now(),
+      updatedAt: typeof (raw as { updatedAt?: unknown })?.updatedAt === "number" ? (raw as { updatedAt: number }).updatedAt : Date.now(),
+    };
+  } catch {
+    return null;
+  }
+}
+
+/** Read one user's library. Missing, foreign or malformed files read empty. */
+export function readUserLibrary(userId: string, options: DataDirOptions = {}): StoredLibrary {
+  requireUserId(userId);
+  const file = userLibraryFilePath(userId, options);
+  if (!fs.existsSync(file)) return emptyLibrary(userId);
+  let text: string;
+  try {
+    text = fs.readFileSync(file, "utf-8");
+  } catch (error) {
+    console.error(`[swarm-library] ignoring unreadable library file: ${String(error)}`);
+    return emptyLibrary(userId);
+  }
+  try {
+    return parseLibrary(JSON.parse(text), userId);
+  } catch (error) {
+    console.error(`[swarm-library] ignoring malformed library file: ${String(error)}`);
+    return emptyLibrary(userId);
+  }
+}
+
+function writeUserLibrary(userId: string, lib: StoredLibrary, options: DataDirOptions = {}): void {
+  requireUserId(userId);
+  const file = userLibraryFilePath(userId, options);
+  const dir = path.dirname(file);
+  fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
+  try {
+    fs.chmodSync(dir, 0o700);
+  } catch {
+    // Best effort on read-only/foreign mounts.
+  }
+  const body: StoredLibrary = { ...lib, schema: LIBRARY_SCHEMA, version: LIBRARY_SCHEMA_VERSION, userId };
+  const tmp = `${file}.tmp.${process.pid}.${Date.now()}`;
+  fs.writeFileSync(tmp, JSON.stringify(body, null, 2) + "\n", { encoding: "utf-8", mode: 0o600 });
+  fs.renameSync(tmp, file);
+  try {
+    fs.chmodSync(file, 0o600);
+  } catch {
+    // Best effort.
+  }
+}
+
+function secretOptions(options: DataDirOptions) {
+  return { env: options.env ?? process.env, dataDir: resolveDataDir(options) };
+}
+
+function toolPurpose(toolId: string, name: string): string {
+  return `tool:${toolId.slice(0, 60)}:${name.slice(0, 64)}`;
+}
+
+function mcpPurpose(serverId: string, name: string): string {
+  return `mcp:${serverId.slice(0, 60)}:${name.slice(0, 64)}`;
+}
+
+/** Seal the supplied secrets, keeping an existing value when none is given. */
+function sealSecrets(
+  userId: string,
+  current: Record<string, string>,
+  secrets: readonly SecretInput[],
+  purpose: (name: string) => string,
+  options: DataDirOptions,
+  requireValues: boolean,
+): Record<string, string> {
+  const out: Record<string, string> = {};
+  for (const secret of secrets) {
+    if (secret.value !== undefined && secret.value !== "") {
+      out[secret.name] = seal(secret.value, userId, purpose(secret.name), secretOptions(options));
+      continue;
+    }
+    if (current[secret.name]) {
+      out[secret.name] = current[secret.name];
+      continue;
+    }
+    if (requireValues && secret.value === "") {
+      out[secret.name] = seal("", userId, purpose(secret.name), secretOptions(options));
+      continue;
+    }
+    throw new LibraryValidationError(`Secret "${secret.name}" needs a value.`);
+  }
+  return out;
+}
+
+function openSecrets(
+  userId: string,
+  sealed: Record<string, string>,
+  purpose: (name: string) => string,
+  options: DataDirOptions,
+): Record<string, string> {
+  const out: Record<string, string> = {};
+  for (const [name, value] of Object.entries(sealed)) {
+    try {
+      out[name] = open(value, userId, purpose(name), secretOptions(options));
+    } catch {
+      // A value sealed under a missing/old secret is skipped, not fatal: the
+      // tool still loads, and a call that references it fails loudly.
+    }
+  }
+  return out;
+}
+
+function secretRows(sealed: Record<string, string>, values: Record<string, string>): SecretRow[] {
+  return Object.keys(sealed)
+    .sort()
+    .map((name) => ({ name, mask: values[name] === undefined ? "••••" : maskSecret(values[name]) }));
+}
+
+// ---------------------------------------------------------------------------
+// Client rows
+// ---------------------------------------------------------------------------
+
+export function toolRow(tool: StoredTool, values: Record<string, string>): UserToolRow {
+  const { sealedSecrets: _sealed, ...publicTool } = tool;
+  void _sealed;
+  return { ...publicTool, secrets: secretRows(tool.sealedSecrets, values) };
+}
+
+export function mcpServerRow(server: StoredMcpServer, values: Record<string, string>): UserMcpServerRow {
+  const { sealedSecrets: _sealed, ...publicServer } = server;
+  void _sealed;
+  return { ...publicServer, secrets: secretRows(server.sealedSecrets, values) };
+}
+
+/** The full library as the browser sees it: masks only, never values. */
+export function librarySnapshot(
+  userId: string,
+  catalogs: LibrarySnapshot["catalogs"],
+  options: DataDirOptions = {},
+): LibrarySnapshot {
+  const lib = readUserLibrary(userId, options);
+  return {
+    tools: lib.tools.map((tool) =>
+      toolRow(tool, openSecrets(userId, tool.sealedSecrets, (name) => toolPurpose(tool.id, name), options)),
+    ),
+    mcpServers: lib.mcpServers.map((server) =>
+      mcpServerRow(server, openSecrets(userId, server.sealedSecrets, (name) => mcpPurpose(server.id, name), options)),
+    ),
+    skills: lib.skills,
+    connectors: lib.connectors,
+    catalogs,
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Tools
+// ---------------------------------------------------------------------------
+
+export function createUserTool(userId: string, raw: unknown, options: DataDirOptions = {}): UserToolRow {
+  const lib = readUserLibrary(userId, options);
+  const input = normalizeUserToolInput(raw);
+  if (lib.tools.some((tool) => tool.id === input.id)) {
+    throw new LibraryValidationError(`A tool named "${input.id}" already exists.`, 409);
+  }
+  const now = Date.now();
+  const sealed = sealSecrets(userId, {}, input.secrets, (name) => toolPurpose(input.id, name), options, true);
+  const stored: StoredTool = {
+    id: input.id,
+    title: input.title,
+    description: input.description,
+    inputSchema: input.inputSchema,
+    kind: input.kind,
+    ...(input.script ? { script: input.script } : {}),
+    ...(input.http ? { http: input.http } : {}),
+    timeoutMs: input.timeoutMs,
+    maxOutputBytes: input.maxOutputBytes,
+    enabled: input.enabled,
+    source: input.source,
+    createdAt: now,
+    updatedAt: now,
+    sealedSecrets: sealed,
+  };
+  lib.tools.push(stored);
+  writeUserLibrary(userId, lib, options);
+  return toolRow(stored, openSecrets(userId, sealed, (name) => toolPurpose(input.id, name), options));
+}
+
+export function updateUserTool(userId: string, id: string, raw: unknown, options: DataDirOptions = {}): UserToolRow {
+  const lib = readUserLibrary(userId, options);
+  const index = lib.tools.findIndex((tool) => tool.id === id);
+  if (index === -1) throw new LibraryValidationError("Unknown tool.", 404);
+  const existing = lib.tools[index];
+  const input = normalizeUserToolInput({ ...(raw as Record<string, unknown>), id }, id);
+  if (input.id !== id && lib.tools.some((tool) => tool.id === input.id)) {
+    throw new LibraryValidationError(`A tool named "${input.id}" already exists.`, 409);
+  }
+  const sealed = sealSecrets(userId, existing.sealedSecrets, input.secrets, (name) => toolPurpose(input.id, name), options, false);
+  const stored: StoredTool = {
+    id: input.id,
+    title: input.title,
+    description: input.description,
+    inputSchema: input.inputSchema,
+    kind: input.kind,
+    ...(input.script ? { script: input.script } : {}),
+    ...(input.http ? { http: input.http } : {}),
+    timeoutMs: input.timeoutMs,
+    maxOutputBytes: input.maxOutputBytes,
+    enabled: input.enabled,
+    source: input.source,
+    createdAt: existing.createdAt,
+    updatedAt: Date.now(),
+    sealedSecrets: sealed,
+  };
+  lib.tools[index] = stored;
+  writeUserLibrary(userId, lib, options);
+  return toolRow(stored, openSecrets(userId, sealed, (name) => toolPurpose(input.id, name), options));
+}
+
+export function deleteUserTool(userId: string, id: string, options: DataDirOptions = {}): void {
+  const lib = readUserLibrary(userId, options);
+  const index = lib.tools.findIndex((tool) => tool.id === id);
+  if (index === -1) throw new LibraryValidationError("Unknown tool.", 404);
+  lib.tools.splice(index, 1);
+  writeUserLibrary(userId, lib, options);
+}
+
+/** Resolve a tool with secret values for execution (server-side only). */
+export interface ResolvedUserTool extends UserTool {
+  secrets: Record<string, string>;
+}
+
+export function resolveUserTool(userId: string, id: string, options: DataDirOptions = {}): ResolvedUserTool | null {
+  const lib = readUserLibrary(userId, options);
+  const tool = lib.tools.find((candidate) => candidate.id === id);
+  if (!tool) return null;
+  const { sealedSecrets, ...publicTool } = tool;
+  return {
+    ...publicTool,
+    secrets: openSecrets(userId, sealedSecrets, (name) => toolPurpose(tool.id, name), options),
+  };
+}
+
+/** Tools the runtime should expose to the agent (enabled only). */
+export function runtimeTools(userId: string, options: DataDirOptions = {}): Array<UserTool & { secrets: Record<string, string> }> {
+  const lib = readUserLibrary(userId, options);
+  return lib.tools
+    .filter((tool) => tool.enabled)
+    .map((tool) => {
+      const { sealedSecrets, ...publicTool } = tool;
+      return {
+        ...publicTool,
+        secrets: openSecrets(userId, sealedSecrets, (name) => toolPurpose(tool.id, name), options),
+      };
+    });
+}
+
+// ---------------------------------------------------------------------------
+// MCP servers
+// ---------------------------------------------------------------------------
+
+export function addUserMcpServer(userId: string, raw: unknown, options: DataDirOptions = {}): UserMcpServerRow {
+  const lib = readUserLibrary(userId, options);
+  const input = normalizeMcpServerInput(raw);
+  if (lib.mcpServers.some((server) => server.id === input.id)) {
+    throw new LibraryValidationError(`An MCP server named "${input.id}" already exists.`, 409);
+  }
+  const now = Date.now();
+  const sealed = sealSecrets(userId, {}, input.secrets, (name) => mcpPurpose(input.id, name), options, true);
+  const stored: StoredMcpServer = {
+    id: input.id,
+    title: input.title,
+    description: input.description,
+    transport: input.transport,
+    ...(input.command ? { command: input.command } : {}),
+    ...(input.args ? { args: input.args } : {}),
+    ...(input.url ? { url: input.url } : {}),
+    headers: input.headers,
+    env: input.env,
+    enabled: input.enabled,
+    source: input.source,
+    createdAt: now,
+    updatedAt: now,
+    sealedSecrets: sealed,
+  };
+  lib.mcpServers.push(stored);
+  writeUserLibrary(userId, lib, options);
+  return mcpServerRow(stored, openSecrets(userId, sealed, (name) => mcpPurpose(input.id, name), options));
+}
+
+export function updateUserMcpServer(userId: string, id: string, raw: unknown, options: DataDirOptions = {}): UserMcpServerRow {
+  const lib = readUserLibrary(userId, options);
+  const index = lib.mcpServers.findIndex((server) => server.id === id);
+  if (index === -1) throw new LibraryValidationError("Unknown MCP server.", 404);
+  const existing = lib.mcpServers[index];
+  const input = normalizeMcpServerInput({ ...(raw as Record<string, unknown>), id }, id);
+  const sealed = sealSecrets(userId, existing.sealedSecrets, input.secrets, (name) => mcpPurpose(input.id, name), options, false);
+  const stored: StoredMcpServer = {
+    id: input.id,
+    title: input.title,
+    description: input.description,
+    transport: input.transport,
+    ...(input.command ? { command: input.command } : {}),
+    ...(input.args ? { args: input.args } : {}),
+    ...(input.url ? { url: input.url } : {}),
+    headers: input.headers,
+    env: input.env,
+    enabled: input.enabled,
+    source: input.source,
+    createdAt: existing.createdAt,
+    updatedAt: Date.now(),
+    sealedSecrets: sealed,
+  };
+  lib.mcpServers[index] = stored;
+  writeUserLibrary(userId, lib, options);
+  return mcpServerRow(stored, openSecrets(userId, sealed, (name) => mcpPurpose(input.id, name), options));
+}
+
+export function deleteUserMcpServer(userId: string, id: string, options: DataDirOptions = {}): void {
+  const lib = readUserLibrary(userId, options);
+  const index = lib.mcpServers.findIndex((server) => server.id === id);
+  if (index === -1) throw new LibraryValidationError("Unknown MCP server.", 404);
+  lib.mcpServers.splice(index, 1);
+  writeUserLibrary(userId, lib, options);
+}
+
+/** Install a catalog MCP server with user-supplied secret values. */
+export function installCatalogMcpServer(
+  userId: string,
+  catalogEntry: CatalogMcpServer,
+  values: Record<string, string>,
+  options: DataDirOptions = {},
+): UserMcpServerRow {
+  const secrets: SecretInput[] = (catalogEntry.requiredFields ?? [])
+    .filter((field) => typeof values[field.key] === "string" && values[field.key] !== "")
+    .map((field) => ({ name: field.key, value: values[field.key] }));
+  return addUserMcpServer(
+    userId,
+    {
+      id: catalogEntry.id,
+      title: catalogEntry.title,
+      description: catalogEntry.description,
+      transport: catalogEntry.transport,
+      command: catalogEntry.command,
+      args: catalogEntry.args,
+      url: catalogEntry.url,
+      headers: [],
+      env: [],
+      source: "catalog",
+      secrets,
+    },
+    options,
+  );
+}
+
+// ---------------------------------------------------------------------------
+// Skills
+// ---------------------------------------------------------------------------
+
+export function installSkill(userId: string, raw: unknown, options: DataDirOptions = {}): InstalledSkill {
+  const lib = readUserLibrary(userId, options);
+  const input = normalizeSkillInput(raw);
+  if (lib.skills.some((skill) => skill.id === input.id)) {
+    throw new LibraryValidationError(`Skill "${input.id}" is already installed.`, 409);
+  }
+  const now = Date.now();
+  const skill: InstalledSkill = { ...input, createdAt: now, updatedAt: now };
+  lib.skills.push(skill);
+  writeUserLibrary(userId, lib, options);
+  return skill;
+}
+
+export function installCatalogSkill(userId: string, entry: CatalogSkill, options: DataDirOptions = {}): InstalledSkill {
+  return installSkill(
+    userId,
+    {
+      id: entry.id,
+      title: entry.title,
+      description: entry.description,
+      instructions: entry.instructions,
+      source: "catalog",
+      enabled: true,
+    },
+    options,
+  );
+}
+
+export function setSkillEnabled(userId: string, id: string, enabled: boolean, options: DataDirOptions = {}): InstalledSkill {
+  const lib = readUserLibrary(userId, options);
+  const skill = lib.skills.find((candidate) => candidate.id === id);
+  if (!skill) throw new LibraryValidationError("Unknown skill.", 404);
+  skill.enabled = enabled;
+  skill.updatedAt = Date.now();
+  writeUserLibrary(userId, lib, options);
+  return skill;
+}
+
+export function removeSkill(userId: string, id: string, options: DataDirOptions = {}): void {
+  const lib = readUserLibrary(userId, options);
+  const index = lib.skills.findIndex((skill) => skill.id === id);
+  if (index === -1) throw new LibraryValidationError("Unknown skill.", 404);
+  lib.skills.splice(index, 1);
+  writeUserLibrary(userId, lib, options);
+}
+
+// ---------------------------------------------------------------------------
+// Connectors
+// ---------------------------------------------------------------------------
+
+export function installConnector(
+  userId: string,
+  entry: { id: string; name: string; transport?: string; install: string; auth?: string },
+  options: DataDirOptions = {},
+): InstalledConnector {
+  const lib = readUserLibrary(userId, options);
+  if (lib.connectors.some((connector) => connector.id === entry.id)) {
+    throw new LibraryValidationError(`Connector "${entry.id}" is already installed.`, 409);
+  }
+  const connector: InstalledConnector = {
+    id: entry.id,
+    name: entry.name,
+    transport: entry.transport === "stdio" ? "stdio" : "http",
+    install: entry.install,
+    auth: entry.auth ?? "",
+    enabled: true,
+    installedAt: Date.now(),
+  };
+  lib.connectors.push(connector);
+  writeUserLibrary(userId, lib, options);
+  return connector;
+}
+
+export function setConnectorEnabled(userId: string, id: string, enabled: boolean, options: DataDirOptions = {}): InstalledConnector {
+  const lib = readUserLibrary(userId, options);
+  const connector = lib.connectors.find((candidate) => candidate.id === id);
+  if (!connector) throw new LibraryValidationError("Unknown connector.", 404);
+  connector.enabled = enabled;
+  writeUserLibrary(userId, lib, options);
+  return connector;
+}
+
+export function removeConnector(userId: string, id: string, options: DataDirOptions = {}): void {
+  const lib = readUserLibrary(userId, options);
+  const index = lib.connectors.findIndex((connector) => connector.id === id);
+  if (index === -1) throw new LibraryValidationError("Unknown connector.", 404);
+  lib.connectors.splice(index, 1);
+  writeUserLibrary(userId, lib, options);
+}
+
+// ---------------------------------------------------------------------------
+// Agent-created tools
+// ---------------------------------------------------------------------------
+
+/**
+ * Merge tools the agent wrote for itself during a run. Existing same-id tools
+ * created by the agent are replaced; a user-owned tool is never overwritten.
+ */
+export function mergeAgentCreatedTools(
+  userId: string,
+  created: readonly unknown[],
+  options: DataDirOptions = {},
+): UserToolRow[] {
+  if (created.length === 0) return [];
+  const lib = readUserLibrary(userId, options);
+  const merged: UserToolRow[] = [];
+  for (const raw of created.slice(0, 20)) {
+    let input;
+    try {
+      input = normalizeUserToolInput({ ...(raw as Record<string, unknown>), source: "agent" });
+    } catch {
+      continue;
+    }
+    const index = lib.tools.findIndex((tool) => tool.id === input.id);
+    if (index !== -1 && lib.tools[index].source !== "agent") continue;
+    const now = Date.now();
+    const sealed = sealSecrets(userId, index === -1 ? {} : lib.tools[index].sealedSecrets, input.secrets, (name) => toolPurpose(input.id, name), options, false);
+    const stored: StoredTool = {
+      id: input.id,
+      title: input.title,
+      description: input.description,
+      inputSchema: input.inputSchema,
+      kind: input.kind,
+      ...(input.script ? { script: input.script } : {}),
+      ...(input.http ? { http: input.http } : {}),
+      timeoutMs: input.timeoutMs,
+      maxOutputBytes: input.maxOutputBytes,
+      enabled: true,
+      source: "agent",
+      createdAt: index === -1 ? now : lib.tools[index].createdAt,
+      updatedAt: now,
+      sealedSecrets: sealed,
+    };
+    if (index === -1) lib.tools.push(stored);
+    else lib.tools[index] = stored;
+    merged.push(toolRow(stored, openSecrets(userId, sealed, (name) => toolPurpose(input.id, name), options)));
+  }
+  if (merged.length > 0) writeUserLibrary(userId, lib, options);
+  return merged;
+}
+
+// ---------------------------------------------------------------------------
+// Runtime view
+// ---------------------------------------------------------------------------
+
+/** A user MCP server with secret references resolved for the user's VM. */
+export interface RuntimeMcpServer {
+  id: string;
+  transport: "stdio" | "http";
+  command?: string;
+  args?: string[];
+  url?: string;
+  headers: Array<{ name: string; value: string }>;
+  env: Array<{ name: string; value: string }>;
+}
+
+export function resolveTemplate(template: string, secrets: Record<string, string>): string {
+  return template.replace(/\{\{\s*secret\.([A-Za-z_][A-Za-z0-9_]*)\s*\}\}/g, (match, name: string) =>
+    secrets[name] === undefined ? match : secrets[name],
+  );
+}
+
+/**
+ * The runtime view for a run: enabled tools with resolved secrets (sealed
+ * values are opened here) and enabled MCP servers with secret references
+ * resolved for the VM. This is server-only data; never serialize it to a
+ * client response or a log.
+ */
+export function runtimeLibrary(
+  userId: string,
+  options: DataDirOptions = {},
+): { tools: Array<UserTool & { secrets: Record<string, string> }>; mcpServers: RuntimeMcpServer[] } {
+  const lib = readUserLibrary(userId, options);
+  const tools = lib.tools
+    .filter((tool) => tool.enabled)
+    .map((tool) => {
+      const { sealedSecrets, ...publicTool } = tool;
+      return { ...publicTool, secrets: openSecrets(userId, sealedSecrets, (name) => toolPurpose(tool.id, name), options) };
+    });
+  const mcpServers = lib.mcpServers
+    .filter((server) => server.enabled)
+    .map((server) => {
+      const { sealedSecrets, ...publicServer } = server;
+      const secrets = openSecrets(userId, sealedSecrets, (name) => mcpPurpose(server.id, name), options);
+      return {
+        id: publicServer.id,
+        transport: publicServer.transport,
+        ...(publicServer.command ? { command: publicServer.command } : {}),
+        ...(publicServer.args
+          ? { args: publicServer.args.map((arg) => resolveTemplate(arg, secrets)) }
+          : {}),
+        ...(publicServer.url ? { url: publicServer.url } : {}),
+        headers: (publicServer.headers ?? []).map((header): ToolHeader => ({ name: header.name, value: resolveTemplate(header.value, secrets) })),
+        env: (publicServer.env ?? []).map((header): ToolHeader => ({ name: header.name, value: resolveTemplate(header.value, secrets) })),
+      };
+    });
+  return { tools, mcpServers };
+}
+
+/** All installed tools (enabled or not) for the Library page. */
+export function listUserTools(userId: string, options: DataDirOptions = {}): UserToolRow[] {
+  const lib = readUserLibrary(userId, options);
+  return lib.tools.map((tool) =>
+    toolRow(tool, openSecrets(userId, tool.sealedSecrets, (name) => toolPurpose(tool.id, name), options)),
+  );
+}
+
+/** Test/UI helper: catalog data for a client snapshot. */
+export type { CatalogTool, CatalogSkill, CatalogMcpServer };
