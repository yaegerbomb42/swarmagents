+// ---------------------------------------------------------------------------
+// Tools
+// ---------------------------------------------------------------------------
+
+interface ToolDraft {
+  id: string;
+  title: string;
+  description: string;
+  schemaMode: "fields" | "raw";
+  fields: ToolFieldDraft[];
+  rawSchema: string;
+  kind: UserToolKind;
+  language: ToolLanguage;
+  source: string;
+  method: HttpMethod;
+  url: string;
+  headers: ToolHeader[];
+  bodyTemplate: string;
+  timeoutMs: number;
+  maxOutputBytes: number;
+  secrets: ToolHeader[];
+}
+
+function emptyToolDraft(): ToolDraft {
+  return {
+    id: "",
+    title: "",
+    description: "",
+    schemaMode: "fields",
+    fields: [],
+    rawSchema: JSON.stringify({ type: "object", properties: {} }, null, 2),
+    kind: "script",
+    language: "node",
+    source: 'import fs from "node:fs";\nconst args = JSON.parse(fs.readFileSync(0, "utf8"));\nconsole.log(JSON.stringify(args));\n',
+    method: "GET",
+    url: "",
+    headers: [],
+    bodyTemplate: "",
+    timeoutMs: DEFAULT_TOOL_TIMEOUT_MS,
+    maxOutputBytes: DEFAULT_TOOL_MAX_OUTPUT_BYTES,
+    secrets: [],
+  };
+}
+
+function draftFromTool(tool: UserToolRow): ToolDraft {
+  return {
+    id: tool.id,
+    title: tool.title,
+    description: tool.description,
+    schemaMode: "raw",
+    fields: fieldsFromSchema(tool.inputSchema),
+    rawSchema: JSON.stringify(tool.inputSchema, null, 2),
+    kind: tool.kind,
+    language: tool.script?.language ?? "node",
+    source: tool.script?.source ?? emptyToolDraft().source,
+    method: tool.http?.method ?? "GET",
+    url: tool.http?.url ?? "",
+    headers: tool.http?.headers ?? [],
+    bodyTemplate: tool.http?.bodyTemplate ?? "",
+    timeoutMs: tool.timeoutMs,
+    maxOutputBytes: tool.maxOutputBytes,
+    secrets: tool.secrets.map((secret) => ({ name: secret.name, value: "" })),
+  };
+}
+
+function TryItPanel({ tool }: { tool: UserToolRow }) {
+  const [input, setInput] = useState(() => sampleInput(tool.inputSchema));
+  const [running, setRunning] = useState(false);
+  const [result, setResult] = useState<
+    | { ok: boolean; output: string; truncated?: boolean; timedOut?: boolean; exitCode?: number; durationMs?: number }
+    | null
+  >(null);
+  const [error, setError] = useState("");
+
+  const run = async () => {
+    setRunning(true);
+    setError("");
+    setResult(null);
+    try {
+      const body = JSON.parse(input || "{}") as unknown;
+      const out = await api<{ result: typeof result }>(`/api/library/tools/${encodeURIComponent(tool.id)}/run`, {
+        method: "POST",
+        body: JSON.stringify({ input: body }),
+      });
+      setResult(out.result);
+    } catch (err) {
+      setError(errText(err));
+    } finally {
+      setRunning(false);
+    }
+  };
+
+  return (
+    <div className="rounded-2xl border border-white/10 bg-black/30 p-4">
+      <div className="mb-2 flex items-center gap-2 text-xs font-semibold text-white/70">
+        <Sparkles className="h-3.5 w-3.5 text-cyan-300" /> Try it
+        <span className="font-normal text-white/35">runs inside your VM</span>
+      </div>
+      <label className="block">
+        <span className={labelClass}>Sample input (JSON)</span>
+        <textarea
+          rows={4}
+          value={input}
+          onChange={(e) => setInput(e.target.value)}
+          className={`${fieldClass} font-mono`}
+          spellCheck={false}
+          aria-label={`Sample input for ${tool.title}`}
+        />
+      </label>
+      <div className="mt-2 flex items-center gap-3">
+        <button
+          type="button"
+          onClick={() => void run()}
+          disabled={running}
+          className="flex items-center gap-1.5 rounded-xl bg-cyan-400/20 px-4 py-1.5 text-xs font-medium text-cyan-100 ring-1 ring-cyan-400/40 hover:bg-cyan-400/30 disabled:opacity-60"
+        >
+          {running ? <Loader2 className="h-3.5 w-3.5 animate-spin" /> : <Terminal className="h-3.5 w-3.5" />}
+          {running ? "Running…" : "Run tool"}
+        </button>
+        <span className="text-[11px] text-white/30">
+          timeout {tool.timeoutMs} ms · cap {tool.maxOutputBytes.toLocaleString()} bytes
+        </span>
+      </div>
+      {error && <div className="mt-3 rounded-xl border border-red-400/20 bg-red-400/10 px-3 py-2 text-xs text-red-300">{error}</div>}
+      {result && (
+        <div className="mt-3 rounded-xl border border-white/10 bg-black/40 p-3">
+          <div className="mb-2 flex flex-wrap items-center gap-2 text-[11px]">
+            <Badge tone={result.ok ? "emerald" : "amber"}>{result.ok ? "ok" : "failed"}</Badge>
+            {typeof result.exitCode === "number" && <Badge>exit {result.exitCode}</Badge>}
+            {typeof result.durationMs === "number" && <Badge>{result.durationMs} ms</Badge>}
+            {result.truncated && <Badge tone="amber">output truncated</Badge>}
+            {result.timedOut && <Badge tone="amber">timed out</Badge>}
+          </div>
+          <pre className="max-h-64 overflow-auto whitespace-pre-wrap break-words font-mono text-[11px] leading-relaxed text-white/70">
+            {result.output || "(no output)"}
+          </pre>
+        </div>
+      )}
+    </div>
+  );
+}
+
