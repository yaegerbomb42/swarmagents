+
+export function LibraryPage() {
+  const [snapshot, setSnapshot] = useState<LibrarySnapshot | null>(null);
+  const [tab, setTab] = useState<Tab>("connectors");
+  const [query, setQuery] = useState("");
+  const [error, setError] = useState("");
+  const [notice, setNotice] = useState("");
+
+  const reload = useCallback(async () => {
+    try {
+      const data = await api<LibrarySnapshot>("/api/library");
+      setSnapshot(data);
+      setError("");
+    } catch (err) {
+      setError(errText(err));
+    }
+  }, []);
+
+  useEffect(() => {
+    void reload();
+  }, [reload]);
+
+  const onNotice = useCallback((text: string, tone: "ok" | "error") => {
+    if (tone === "error") {
+      setError(text);
+      setNotice("");
+    } else {
+      setNotice(text);
+      setError("");
+    }
+  }, []);
+
+  const counts = useMemo(
+    () => ({
+      connectors: snapshot?.connectors.length ?? 0,
+      mcp: snapshot?.mcpServers.length ?? 0,
+      skills: snapshot?.skills.length ?? 0,
+      tools: snapshot?.tools.length ?? 0,
+      public:
