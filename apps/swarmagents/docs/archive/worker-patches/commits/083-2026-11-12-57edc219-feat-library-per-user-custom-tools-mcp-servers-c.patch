+
+function SkillsTab({
+  snapshot,
+  query,
+  reload,
+  onNotice,
+}: {
+  snapshot: LibrarySnapshot;
+  query: string;
+  reload: () => Promise<void>;
+  onNotice: (text: string, tone: "ok" | "error") => void;
+}) {
+  const [writing, setWriting] = useState(false);
+  const [saving, setSaving] = useState(false);
+  const [custom, setCustom] = useState({ title: "", description: "", instructions: "" });
+  const catalog = useMemo(() => {
+    const q = query.trim().toLowerCase();
+    const all: CatalogSkill[] = snapshot.catalogs.skills;
+    if (!q) return all;
+    return all.filter((entry) =>
+      [entry.title, entry.category, entry.description, entry.id].some((v) => v.toLowerCase().includes(q)),
+    );
+  }, [snapshot.catalogs.skills, query]);
+
+  const install = async (entry: CatalogSkill) => {
+    try {
+      await api("/api/library/skills", { method: "POST", body: JSON.stringify({ id: entry.id }) });
+      onNotice(`${entry.title} was installed.`, "ok");
+      await reload();
+    } catch (error) {
+      onNotice(errText(error), "error");
+    }
+  };
+
+  const toggle = async (skill: InstalledSkill) => {
+    try {
+      await api("/api/library/skills", {
+        method: "PATCH",
+        body: JSON.stringify({ id: skill.id, enabled: !skill.enabled }),
+      });
+      await reload();
+    } catch (error) {
+      onNotice(errText(error), "error");
+    }
+  };
+
+  const remove = async (skill: InstalledSkill) => {
+    try {
+      await api(`/api/library/skills?id=${encodeURIComponent(skill.id)}`, { method: "DELETE" });
+      await reload();
+    } catch (error) {
+      onNotice(errText(error), "error");
+    }
+  };
+
+  const saveCustom = async (event: FormEvent) => {
+    event.preventDefault();
+    setSaving(true);
+    try {
+      await api("/api/library/skills", {
+        method: "POST",
+        body: JSON.stringify({ skill: { ...custom, source: "custom" } }),
+      });
+      setCustom({ title: "", description: "", instructions: "" });
+      setWriting(false);
+      onNotice("Custom skill installed.", "ok");
+      await reload();
+    } catch (error) {
+      onNotice(errText(error), "error");
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  return (
+    <div className="space-y-8">
+      <section>
+        <div className="flex items-center justify-between">
+          <SectionHeading title="Installed skills" subtitle="Enabled skills are appended to the agent prompt." />
+          <button
+            type="button"
