+                  spellCheck={false}
+                />
+              </label>
+            )}
+            <div className="sm:col-span-2">
+              <KeyValueRows
+                label="Headers"
+                rows={draft.headers}
+                onChange={(headers) => setDraft({ ...draft, headers })}
+                placeholderName="Authorization"
+                placeholderValue="Bearer {{secret.API_TOKEN}}"
+              />
+            </div>
+            <div className="sm:col-span-2">
+              <KeyValueRows
+                label="Environment"
+                rows={draft.env}
+                onChange={(env) => setDraft({ ...draft, env })}
+                placeholderName="ENV_VAR"
+                placeholderValue="{{secret.API_TOKEN}}"
+              />
+            </div>
+            <div className="sm:col-span-2">
+              <KeyValueRows
+                label="Secrets (encrypted at rest)"
+                rows={draft.secrets}
+                onChange={(secrets) => setDraft({ ...draft, secrets })}
+                placeholderName="API_TOKEN"
+                placeholderValue="secret value"
+              />
+            </div>
+            <div className="sm:col-span-2 flex justify-end">
+              <button
+                type="submit"
+                disabled={saving}
+                className="flex items-center gap-1.5 rounded-xl bg-cyan-400/20 px-4 py-2 text-xs font-medium text-cyan-100 ring-1 ring-cyan-400/40 hover:bg-cyan-400/30 disabled:opacity-60"
+              >
+                {saving && <Loader2 className="h-3.5 w-3.5 animate-spin" />}
+                Add server
+              </button>
+            </div>
+          </form>
+        )}
+
+        {snapshot.mcpServers.length === 0 ? (
+          <EmptyState text="No MCP servers added yet." />
+        ) : (
+          <div className="grid gap-3 sm:grid-cols-2">
+            {snapshot.mcpServers.map((server) => (
+              <div key={server.id} className="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
+                <div className="mb-1 flex items-start justify-between gap-2">
+                  <div>
+                    <div className="text-sm font-medium text-white/85">{server.title}</div>
