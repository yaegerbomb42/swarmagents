--- /dev/null
+++ b/apps/swarmagents/lib/library/execute.ts
@@ -0,0 +1,133 @@
+/**
+ * Host-side helpers that drive the generated user-tools MCP server inside a
+ * user's VM.
+ *
+ * The "Try it" panel and the runtime use the exact same VM server code path:
+ * the host writes the spec + secrets, then runs `node ... --run <tool>` inside
+ * the VM with the JSON args on stdin. Nothing executes in the Next.js process.
+ */
+
+import { getVmManager } from "../vm/manager";
+import type { VmManager } from "../vm/manager";
+import type { UserTool } from "./types";
+import {
+  USER_TOOLS_CREATED_PATH,
+  USER_TOOLS_MCP_SERVER_PATH,
+  USER_TOOLS_MCP_SERVER_SOURCE,
+  USER_TOOLS_SECRETS_PATH,
+  USER_TOOLS_SPEC_PATH,
+  buildUserToolsSecrets,
+  buildUserToolsSpec,
+  parseCreatedToolLines,
+  userToolRunArgv,
+} from "./user-tools-mcp";
+import { mergeAgentCreatedTools } from "./store";
+import { assertToolUrlTemplate } from "./ssrf";
+import { LibraryValidationError } from "./types";
+
+export interface ToolRunResult {
+  ok: boolean;
+  output: string;
+  truncated: boolean;
+  timedOut?: boolean;
+  exitCode?: number;
+  durationMs?: number;
+}
+
+/** Write the generated server, spec and secrets into a user's VM. */
+export async function seedUserToolsInVm(
+  userId: string,
+  tools: ReadonlyArray<UserTool & { secrets?: Record<string, string> }>,
+  vm: VmManager = getVmManager(),
+): Promise<void> {
+  await vm.writeFile(userId, USER_TOOLS_MCP_SERVER_PATH, USER_TOOLS_MCP_SERVER_SOURCE);
+  await vm.writeFile(userId, USER_TOOLS_SPEC_PATH, buildUserToolsSpec(tools));
+  await vm.writeFile(userId, USER_TOOLS_SECRETS_PATH, buildUserToolsSecrets(tools));
+}
+
+/**
+ * Run one tool inside the user's VM and parse the runner's JSON result.
+ * Only enabled-or-explicitly-tried tools reach here; the route validates the
+ * owner before calling.
+ */
+export async function runUserToolInVm(
+  userId: string,
+  tool: UserTool & { secrets?: Record<string, string> },
+  input: Record<string, unknown>,
+  vm: VmManager = getVmManager(),
+): Promise<ToolRunResult> {
+  if (tool.http) {
+    try {
+      assertToolUrlTemplate(tool.http.url);
+    } catch (error) {
+      // Reject an obviously unsafe target before seeding or spawning anything.
+      throw new LibraryValidationError(error instanceof Error ? error.message : "The request URL is not valid.");
+    }
+  }
+  await seedUserToolsInVm(userId, [tool], vm);
+
+  let stdout = "";
+  let stderr = "";
+  const timeoutMs = Math.min(tool.timeoutMs + 15_000, 90_000);
+  const result = await vm.exec(userId, userToolRunArgv(tool.id), {
+    stdin: JSON.stringify(input),
+    timeoutMs,
+    onStdout: (chunk) => {
+      // Keep at most one extra chunk beyond the tool cap so a runaway process
+      // cannot grow host memory; the VM runner already truncates.
+      if (stdout.length < tool.maxOutputBytes + 16_384) stdout += chunk;
+    },
+    onStderr: (chunk) => {
+      if (stderr.length < 16_384) stderr += chunk;
+    },
+  });
+
+  const line = stdout
+    .split("\n")
+    .map((entry) => entry.trim())
+    .filter(Boolean)
+    .pop();
+  if (!line) {
+    return {
+      ok: false,
+      output: stderr.trim() || `The tool exited with code ${result.exitCode} and produced no output.`,
+      truncated: result.truncated === true,
+      exitCode: result.exitCode,
+    };
+  }
+  try {
+    const parsed = JSON.parse(line) as Partial<ToolRunResult>;
+    return {
+      ok: parsed.ok === true,
+      output: typeof parsed.output === "string" ? parsed.output : "",
+      truncated: parsed.truncated === true,
+      ...(parsed.timedOut === true ? { timedOut: true } : {}),
+      exitCode: typeof parsed.exitCode === "number" ? parsed.exitCode : result.exitCode,
+      ...(typeof parsed.durationMs === "number" ? { durationMs: parsed.durationMs } : {}),
+    };
+  } catch {
+    return { ok: false, output: line.slice(0, tool.maxOutputBytes), truncated: false, exitCode: result.exitCode };
+  }
+}
+
+/**
+ * Merge tools the agent created for itself during a run, then clear the VM's
+ * JSONL so the same definitions are not imported twice.
+ */
+export async function importAgentCreatedTools(
+  userId: string,
+  vm: VmManager = getVmManager(),
+): Promise<number> {
+  let text: string;
+  try {
+    text = await vm.readFile(userId, USER_TOOLS_CREATED_PATH);
+  } catch {
+    return 0;
+  }
+  if (!text.trim()) return 0;
+  const merged = mergeAgentCreatedTools(userId, parseCreatedToolLines(text));
+  await vm.writeFile(userId, USER_TOOLS_CREATED_PATH, "").catch(() => {
+    // Best effort: the next run will overwrite the file anyway.
+  });
+  return merged.length;
+}
diff --git a/apps/swarmagents/lib/library/ssrf.test.ts b/apps/swarmagents/lib/library/ssrf.test.ts
new file mode 100644
index 000000000..b53458e94
--- /dev/null
+++ b/apps/swarmagents/lib/library/ssrf.test.ts
@@ -0,0 +1,71 @@
+/**
+ * SSRF guards for HTTP tools. Every literal private/reserved address and every
+ * hostname that resolves to one is rejected before a request; redirects are
+ * re-checked by the caller using the same functions.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  assertSafeToolUrl,
+  assertToolUrlTemplate,
+  isBlockedHostname,
+  isBlockedIp,
+  isBlockedIpv4,
+  isBlockedIpv6,
+} from "./ssrf";
+
+const publicLookup = async () => [{ address: "93.184.216.34", family: 4 }];
+const privateLookup = async () => [{ address: "10.0.0.7", family: 4 }];
+const mixedLookup = async () => [
+  { address: "93.184.216.34", family: 4 },
+  { address: "127.0.0.1", family: 4 },
+];
+
+test("private, loopback, link-local and reserved IPv4 ranges are blocked", () => {
+  for (const address of ["127.0.0.1", "10.1.2.3", "172.16.0.1", "192.168.1.1", "169.254.169.254", "100.64.0.1", "0.0.0.0"]) {
+    assert.equal(isBlockedIpv4(address), true, address);
+  }
+  assert.equal(isBlockedIpv4("8.8.8.8"), false);
+});
+
+test("IPv6 loopback, ULA, link-local, multicast and mapped IPv4 are blocked", () => {
+  for (const address of ["::1", "::", "fc00::1", "fd12:3456::1", "fe80::1", "ff02::1", "::ffff:192.168.0.1", "64:ff9b::10.0.0.1"]) {
+    assert.equal(isBlockedIpv6(address), true, address);
+  }
+  assert.equal(isBlockedIpv6("2606:4700:4700::1111"), false);
+  assert.equal(isBlockedIp("2606:4700:4700::1111"), false);
+});
+
+test("local hostnames are rejected before DNS", () => {
+  for (const host of ["localhost", "api.localhost", "metadata.google.internal", "db.internal", "box.local", "router.lan", "x.home.arpa"]) {
+    assert.equal(isBlockedHostname(host), true, host);
+  }
+  assert.equal(isBlockedHostname("example.com"), false);
+});
+
+test("assertSafeToolUrl accepts a public host and blocks private resolutions", async () => {
+  const url = await assertSafeToolUrl("https://example.com/items?q=1", { lookup: publicLookup });
+  assert.equal(url.hostname, "example.com");
+
+  await assert.rejects(() => assertSafeToolUrl("https://internal.example.com", { lookup: privateLookup }), /private or reserved/);
+  await assert.rejects(() => assertSafeToolUrl("https://mixed.example.com", { lookup: mixedLookup }), /private or reserved/);
+  await assert.rejects(() => assertSafeToolUrl("http://169.254.169.254/latest/meta-data"), /private or reserved/);
+  await assert.rejects(() => assertSafeToolUrl("http://[::1]:8080/"), /private or reserved/);
+  await assert.rejects(() => assertSafeToolUrl("http://localhost:3000"), /local or internal/);
+  await assert.rejects(() => assertSafeToolUrl("file:///etc/passwd"), /Only http and https/);
+  await assert.rejects(() => assertSafeToolUrl("https://user:pass@example.com"), /embedded credentials/);
+  await assert.rejects(() => assertSafeToolUrl("https://does-not-resolve.example", {
+    lookup: async () => {
+      throw new Error("ENOTFOUND");
+    },
+  }), /Could not resolve/);
+});
+
+test("assertToolUrlTemplate rejects literal internal targets but allows placeholders", () => {
+  assert.doesNotThrow(() => assertToolUrlTemplate("https://api.example.com/items/{{id}}?token={{secret.API_TOKEN}}"));
+  assert.throws(() => assertToolUrlTemplate("http://127.0.0.1:9000/x"), /private or reserved/);
+  assert.throws(() => assertToolUrlTemplate("http://localhost/x"), /local or internal/);
+  assert.throws(() => assertToolUrlTemplate("ftp://example.com/file"), /Only http and https/);
+  assert.throws(() => assertToolUrlTemplate("not a url"), /not valid/);
+});
diff --git a/apps/swarmagents/lib/library/ssrf.ts b/apps/swarmagents/lib/library/ssrf.ts
new file mode 100644
index 000000000..ac3de6b06
--- /dev/null
+++ b/apps/swarmagents/lib/library/ssrf.ts
@@ -0,0 +1,247 @@
+/**
+ * SSRF guards for HTTP tools.
+ *
+ * HTTP tools execute inside the user's VM, but "inside the VM" is still a
+ * network position from which loopback, RFC1918 ranges, link-local metadata
+ * endpoints and docker-internal names are reachable. Every request (including
+ * each redirect hop) is checked against this module before it is made.
+ *
+ * The same address rules are embedded in the generated VM runner
+ * (lib/library/user-tools-mcp.ts); keep the two in sync.
+ */
+
+import { lookup as dnsLookup } from "node:dns/promises";
+import { isIP } from "node:net";
+
+export type LookupFn = (
+  hostname: string,
+  options: { all: true; verbatim: true },
+) => Promise<Array<{ address: string; family: number }>>;
+
+/** Blocked by name, before DNS resolution. */
+const BLOCKED_HOSTNAMES = new Set([
+  "localhost",
+  "localhost.localdomain",
+  "ip6-localhost",
+  "ip6-loopback",
+  "metadata",
+  "metadata.google.internal",
+  "metadata.azure.internal",
+  "instance-data",
+]);
+
+const BLOCKED_HOST_SUFFIXES = [".localhost", ".local", ".internal", ".lan", ".home.arpa", ".intranet"];
+
+export function normalizeHost(host: string): string {
+  return host.trim().toLowerCase().replace(/^\[|\]$/g, "").replace(/\.$/, "");
+}
+
+/** True for a hostname that must never be reached (before DNS). */
+export function isBlockedHostname(rawHost: string): boolean {
+  const host = normalizeHost(rawHost);
+  if (!host) return true;
+  if (BLOCKED_HOSTNAMES.has(host)) return true;
+  return BLOCKED_HOST_SUFFIXES.some((suffix) => host.endsWith(suffix));
+}
+
+function ipv4ToInt(address: string): number | null {
+  const parts = address.split(".");
+  if (parts.length !== 4) return null;
+  let value = 0;
+  for (const part of parts) {
+    if (!/^\d{1,3}$/.test(part)) return null;
+    const n = Number(part);
+    if (n > 255) return null;
+    value = value * 256 + n;
+  }
+  return value;
+}
+
+function inRange(value: number, cidr: string): boolean {
+  const [base, bitsRaw] = cidr.split("/");
+  const baseInt = ipv4ToInt(base);
+  if (baseInt === null) return false;
+  const bits = Number(bitsRaw);
+  if (!Number.isInteger(bits) || bits < 0 || bits > 32) return false;
+  const mask = bits === 0 ? 0 : (0xffffffff << (32 - bits)) >>> 0;
+  return ((value & mask) >>> 0) === ((baseInt & mask) >>> 0);
+}
+
+/** Ranges that can never be a legitimate public HTTP target. */
+const BLOCKED_IPV4_RANGES = [
+  "0.0.0.0/8",
+  "10.0.0.0/8",
+  "100.64.0.0/10",
+  "127.0.0.0/8",
+  "169.254.0.0/16",
+  "172.16.0.0/12",
+  "192.0.0.0/24",
+  "192.0.2.0/24",
+  "192.168.0.0/16",
+  "198.18.0.0/15",
+  "198.51.100.0/24",
+  "203.0.113.0/24",
+  "224.0.0.0/4",
+  "240.0.0.0/4",
+  "255.255.255.255/32",
+];
+
+export function isBlockedIpv4(address: string): boolean {
+  const value = ipv4ToInt(address);
+  if (value === null) return true;
+  return BLOCKED_IPV4_RANGES.some((range) => inRange(value, range));
+}
+
+/** Expand an IPv6 address to 16 bytes. Returns null for invalid input. */
+function parseIpv6(address: string): number[] | null {
+  let text = address.toLowerCase();
+  if (text.startsWith("[") && text.endsWith("]")) text = text.slice(1, -1);
+  const zone = text.indexOf("%");
+  if (zone !== -1) text = text.slice(0, zone);
+  // Embedded IPv4 tail (e.g. ::ffff:192.168.0.1) becomes two hex groups.
+  const lastColon = text.lastIndexOf(":");
+  const tail = text.slice(lastColon + 1);
+  if (tail.includes(".")) {
+    const v4 = ipv4ToInt(tail);
+    if (v4 === null) return null;
+    const high = ((v4 >>> 16) & 0xffff).toString(16);
+    const low = (v4 & 0xffff).toString(16);
+    text = `${text.slice(0, lastColon + 1)}${high}:${low}`;
+  }
+  const halves = text.split("::");
+  if (halves.length > 2) return null;
+  const head = halves[0] ? halves[0].split(":") : [];
+  const tailParts = halves.length === 2 && halves[1] ? halves[1].split(":") : [];
+  const groups: number[] = [];
+  for (const part of head) {
+    if (!/^[0-9a-f]{1,4}$/.test(part)) return null;
+    groups.push(parseInt(part, 16));
+  }
+  const tailGroups: number[] = [];
+  for (const part of tailParts) {
+    if (!/^[0-9a-f]{1,4}$/.test(part)) return null;
+    tailGroups.push(parseInt(part, 16));
+  }
+  const missing = 8 - head.length - tailGroups.length;
+  if (missing < 0) return null;
+  if (halves.length === 2 && missing === 0) return null;
+  const all = halves.length === 2 ? [...groups, ...Array(missing).fill(0), ...tailGroups] : [...groups, ...tailGroups];
+  if (all.length !== 8) return null;
+  const bytes: number[] = [];
+  for (const group of all) {
+    bytes.push((group >> 8) & 0xff, group & 0xff);
+  }
+  return bytes;
+}
+
+/** True for any IPv6 address that is not a global unicast target. */
+export function isBlockedIpv6(rawAddress: string): boolean {
+  const bytes = parseIpv6(rawAddress);
+  if (!bytes) return true;
+  const allZero = bytes.every((b) => b === 0);
+  if (allZero) return true;
+  // ::1 loopback
+  if (bytes.slice(0, 15).every((b) => b === 0) && bytes[15] === 1) return true;
+  // ::ffff:a.b.c.d — IPv4-mapped; judge the embedded v4 address.
+  if (bytes.slice(0, 10).every((b) => b === 0) && bytes[10] === 0xff && bytes[11] === 0xff) {
+    return isBlockedIpv4(bytes.slice(12).join("."));
+  }
+  // 64:ff9b::/96 NAT64 — judge the embedded v4 address.
+  if (bytes[0] === 0x00 && bytes[1] === 0x64 && bytes[2] === 0xff && bytes[3] === 0x9b) {
+    return isBlockedIpv4(bytes.slice(12).join("."));
+  }
+  // fc00::/7 unique-local
+  if ((bytes[0] & 0xfe) === 0xfc) return true;
+  // fe80::/10 link-local
+  if (bytes[0] === 0xfe && (bytes[1] & 0xc0) === 0x80) return true;
+  // ff00::/8 multicast
+  if (bytes[0] === 0xff) return true;
+  // 2001:db8::/32 documentation
+  if (bytes[0] === 0x20 && bytes[1] === 0x01 && bytes[2] === 0x0d && bytes[3] === 0xb8) return true;
+  return false;
+}
+
+/** True when an IP literal (v4 or v6) must not be reached. */
+export function isBlockedIp(address: string): boolean {
+  const bare = address.replace(/^\[|\]$/g, "");
+  const family = isIP(bare);
+  if (family === 4) return isBlockedIpv4(bare);
+  if (family === 6) return isBlockedIpv6(bare);
+  return true;
+}
+
+export interface SafeUrlOptions {
+  /** Injectable resolver (tests); defaults to node:dns lookup. */
+  lookup?: LookupFn;
+  /** Allow loopback/private targets (tests only; never exposed to users). */
+  allowPrivate?: boolean;
+}
+
+/**
+ * Validate a URL and every resolved address before a request is made.
+ * Throws an Error whose message is safe to show to the user.
+ */
+export async function assertSafeToolUrl(raw: string, options: SafeUrlOptions = {}): Promise<URL> {
+  let url: URL;
+  try {
+    url = new URL(raw);
+  } catch {
+    throw new Error("The URL is not valid.");
+  }
+  if (url.protocol !== "http:" && url.protocol !== "https:") {
+    throw new Error("Only http and https URLs are allowed.");
+  }
+  if (url.username || url.password) throw new Error("URLs with embedded credentials are not allowed.");
+  if (options.allowPrivate) return url;
+
+  const host = normalizeHost(url.hostname);
+  if (isBlockedHostname(host)) throw new Error("Requests to local or internal hosts are not allowed.");
+
+  const family = isIP(host);
+  if (family !== 0) {
+    if (isBlockedIp(host)) throw new Error("Requests to private or reserved addresses are not allowed.");
+    return url;
+  }
+
+  const resolver: LookupFn = options.lookup ?? (dnsLookup as unknown as LookupFn);
+  let addresses: Array<{ address: string; family: number }>;
+  try {
+    addresses = await resolver(host, { all: true, verbatim: true });
+  } catch {
+    throw new Error(`Could not resolve ${host}.`);
+  }
+  if (addresses.length === 0) throw new Error(`Could not resolve ${host}.`);
+  for (const resolved of addresses) {
+    if (isBlockedIp(resolved.address)) {
+      throw new Error(`${host} resolves to a private or reserved address.`);
+    }
+  }
+  return url;
+}
+
+/**
+ * Static pre-flight for an HTTP tool definition. Template placeholders in the
+ * host make full resolution impossible here, so only literal local/internal
+ * hosts and non-http schemes are rejected; the VM runner re-checks at call
+ * time (including redirects).
+ */
+export function assertToolUrlTemplate(template: string): void {
+  const probe = template.replace(/\{\{[^}]{0,80}\}\}/g, "placeholder");
+  let url: URL;
+  try {
+    url = new URL(probe);
+  } catch {
+    throw new Error("The request URL is not valid.");
+  }
+  if (url.protocol !== "http:" && url.protocol !== "https:") {
+    throw new Error("Only http and https URLs are allowed.");
+  }
+  if (url.username || url.password) throw new Error("URLs with embedded credentials are not allowed.");
+  if (isBlockedHostname(url.hostname)) {
+    throw new Error("Requests to local or internal hosts are not allowed.");
+  }
+  const family = isIP(normalizeHost(url.hostname));
+  if (family !== 0 && isBlockedIp(url.hostname)) {
+    throw new Error("Requests to private or reserved addresses are not allowed.");
+  }
+}
diff --git a/apps/swarmagents/lib/library/store.test.ts b/apps/swarmagents/lib/library/store.test.ts
new file mode 100644
index 000000000..7d0240222
--- /dev/null
+++ b/apps/swarmagents/lib/library/store.test.ts
@@ -0,0 +1,296 @@
+/**
+ * Per-account Library store: one library.json per hashed user, secrets sealed
+ * at rest, masked client rows, and a runtime view that only opens secrets when
+ * the host is about to seed a user's VM.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import {
+  addUserMcpServer,
+  createUserTool,
+  deleteUserMcpServer,
+  deleteUserTool,
+  installCatalogMcpServer,
+  installCatalogSkill,
+  installConnector,
+  installSkill,
+  librarySnapshot,
+  listUserTools,
+  mergeAgentCreatedTools,
+  readUserLibrary,
+  removeConnector,
+  removeSkill,
+  resolveUserTool,
+  runtimeLibrary,
+  setConnectorEnabled,
+  setSkillEnabled,
+  updateUserMcpServer,
+  updateUserTool,
+  userLibraryFilePath,
+} from "./store";
+import { LibraryValidationError } from "./types";
+import type { DataDirOptions } from "../providers/store";
+
+const ALICE = "user_alice@example.com";
+const BOB = "user_bob@example.com";
+const SECRET = "sk-library-secret-a1b2";
+
+let tempDir: string;
+let options: DataDirOptions;
+
+test.beforeEach(() => {
+  tempDir = mkdtempSync(join(tmpdir(), "swarm-library-store-"));
+  options = { env: { SWARM_HOME: tempDir } };
+});
+
+test.afterEach(() => {
+  rmSync(tempDir, { recursive: true, force: true });
+});
+
+function scriptTool(overrides: Record<string, unknown> = {}) {
+  return {
+    title: "Word Count",
+    description: "Count words in text",
+    inputSchema: { type: "object", properties: { text: { type: "string" } }, required: ["text"] },
+    kind: "script",
+    script: { language: "node", source: "console.log(1)" },
+    secrets: [{ name: "API_TOKEN", value: SECRET }],
+    ...overrides,
+  };
+}
+
+test("each account has its own library file and cannot see the other's tools", () => {
+  assert.ok(userLibraryFilePath(ALICE, options).startsWith(tempDir));
+  assert.notEqual(userLibraryFilePath(ALICE, options), userLibraryFilePath(BOB, options));
+
+  createUserTool(ALICE, scriptTool(), options);
+  assert.deepEqual(readUserLibrary(ALICE, options).tools.map((t) => t.id), ["word_count"]);
+  assert.deepEqual(readUserLibrary(BOB, options).tools, []);
+  assert.equal(resolveUserTool(BOB, "word_count", options), null);
+  assert.throws(() => deleteUserTool(BOB, "word_count", options), /Unknown tool/);
+});
+
+test("secrets are sealed at rest and never appear in a client row", () => {
+  const row = createUserTool(ALICE, scriptTool(), options);
+  assert.deepEqual(row.secrets, [{ name: "API_TOKEN", mask: "••••a1b2" }]);
+  assert.equal(JSON.stringify(row).includes(SECRET), false, "client row leaked the secret");
+
+  const file = userLibraryFilePath(ALICE, options);
+  const raw = fs.readFileSync(file, "utf-8");
+  assert.equal(raw.includes(SECRET), false, "library.json stored the secret in plaintext");
+  assert.match(raw, /"sealedSecrets"/);
+  assert.equal(fs.statSync(file).mode & 0o777, 0o600);
+
+  const resolved = resolveUserTool(ALICE, "word_count", options);
+  assert.equal(resolved?.secrets.API_TOKEN, SECRET);
+});
+
+test("duplicate ids are rejected; update keeps a secret when its value is omitted", () => {
+  createUserTool(ALICE, scriptTool(), options);
+  assert.throws(() => createUserTool(ALICE, scriptTool(), options), /already exists/);
+
+  const updated = updateUserTool(
+    ALICE,
+    "word_count",
+    scriptTool({ title: "Word Counter", timeoutMs: 5_000, secrets: [{ name: "API_TOKEN" }] }),
+    options,
+  );
+  assert.equal(updated.title, "Word Counter");
+  assert.equal(updated.timeoutMs, 5_000);
+  assert.deepEqual(updated.secrets, [{ name: "API_TOKEN", mask: "••••a1b2" }]);
+  assert.equal(resolveUserTool(ALICE, "word_count", options)?.secrets.API_TOKEN, SECRET);
+
+  const rotated = updateUserTool(
+    ALICE,
+    "word_count",
+    scriptTool({ secrets: [{ name: "API_TOKEN", value: "rotated-zzzz" }] }),
+    options,
+  );
+  assert.deepEqual(rotated.secrets, [{ name: "API_TOKEN", mask: "••••zzzz" }]);
+
+  deleteUserTool(ALICE, "word_count", options);
+  assert.equal(listUserTools(ALICE, options).length, 0);
+});
+
+test("runtimeLibrary opens secrets only for enabled entries and resolves templates", () => {
+  createUserTool(ALICE, scriptTool({ enabled: false }), options);
+  createUserTool(ALICE, scriptTool({ title: "Enabled Tool", id: "enabled_tool", secrets: [] }), options);
+
+  addUserMcpServer(
+    ALICE,
+    {
+      id: "docs",
+      title: "Docs",
+      transport: "http",
+      url: "https://mcp.example.com",
+      headers: [{ name: "Authorization", value: "Bearer {{secret.API_TOKEN}}" }],
+      enabled: true,
+      secrets: [{ name: "API_TOKEN", value: SECRET }],
+    },
+    options,
+  );
+  addUserMcpServer(
+    ALICE,
+    {
+      id: "off",
+      title: "Off",
+      transport: "stdio",
+      command: "npx",
+      enabled: false,
+      secrets: [],
+    },
+    options,
+  );
+
+  const runtime = runtimeLibrary(ALICE, options);
+  assert.deepEqual(runtime.tools.map((tool) => tool.id), ["enabled_tool"]);
+  assert.deepEqual(runtime.mcpServers.map((server) => server.id), ["docs"]);
+  assert.equal(runtime.mcpServers[0].headers[0].value, `Bearer ${SECRET}`);
+
+  const serverWithArgs = addUserMcpServer(
+    ALICE,
+    {
+      id: "stdio_docs",
+      title: "Stdio docs",
+      transport: "stdio",
+      command: "npx",
+      args: ["-y", "docs-mcp", "--token", "{{secret.API_TOKEN}}"],
+      env: [{ name: "TOKEN", value: "{{secret.API_TOKEN}}" }],
+      secrets: [{ name: "API_TOKEN", value: SECRET }],
+    },
+    options,
+  );
+  assert.equal(serverWithArgs.secrets[0].mask, "••••a1b2");
+  const stdio = runtimeLibrary(ALICE, options).mcpServers.find((server) => server.id === "stdio_docs");
+  assert.deepEqual(stdio?.args, ["-y", "docs-mcp", "--token", SECRET]);
+  assert.deepEqual(stdio?.env, [{ name: "TOKEN", value: SECRET }]);
+
+  updateUserMcpServer(
+    ALICE,
+    "docs",
+    { title: "Docs", transport: "http", url: "https://mcp.example.com", enabled: false, secrets: [{ name: "API_TOKEN" }] },
+    options,
+  );
+  assert.deepEqual(runtimeLibrary(ALICE, options).mcpServers.map((server) => server.id), ["stdio_docs"]);
+
+  deleteUserMcpServer(ALICE, "stdio_docs", options);
+  assert.equal(runtimeLibrary(ALICE, options).mcpServers.some((server) => server.id === "stdio_docs"), false);
+});
+
+test("catalog MCP installs only seal non-empty values", () => {
+  const row = installCatalogMcpServer(
+    ALICE,
+    {
+      id: "github_mcp",
+      title: "GitHub",
+      description: "GitHub tools",
+      category: "dev",
+      transport: "stdio",
+      command: "npx",
+      args: ["-y", "@modelcontextprotocol/server-github"],
+      requiredFields: [
+        { key: "GITHUB_TOKEN", label: "Token", secret: true },
+        { key: "GITHUB_ORG", label: "Org" },
+      ],
+    },
+    { GITHUB_TOKEN: SECRET },
+    options,
+  );
+  assert.deepEqual(row.secrets, [{ name: "GITHUB_TOKEN", mask: "••••a1b2" }]);
+  assert.equal(row.source, "catalog");
+  assert.equal(readUserLibrary(ALICE, options).mcpServers[0].sealedSecrets.GITHUB_ORG, undefined);
+});
+
+test("skills install, toggle and remove per account", () => {
+  const skill = installCatalogSkill(
+    ALICE,
+    { id: "careful_edits", title: "Careful edits", description: "", category: "general", instructions: "Read first." },
+    options,
+  );
+  assert.equal(skill.source, "catalog");
+  installSkill(ALICE, { title: "Mine", instructions: "x", source: "custom" }, options);
+  assert.equal(readUserLibrary(ALICE, options).skills.length, 2);
+  assert.equal(readUserLibrary(BOB, options).skills.length, 0);
+
+  assert.equal(setSkillEnabled(ALICE, "careful_edits", false, options).enabled, false);
+  removeSkill(ALICE, "careful_edits", options);
+  assert.deepEqual(readUserLibrary(ALICE, options).skills.map((entry) => entry.id), ["mine"]);
+});
+
+test("connectors install, toggle and remove", () => {
+  const connector = installConnector(
+    ALICE,
+    { id: "slack", name: "Slack", transport: "http", install: "https://mcp.slack.com", auth: "oauth" },
+    options,
+  );
+  assert.equal(connector.enabled, true);
+  assert.equal(setConnectorEnabled(ALICE, "slack", false, options).enabled, false);
+  removeConnector(ALICE, "slack", options);
+  assert.deepEqual(readUserLibrary(ALICE, options).connectors, []);
+});
+
+test("agent-created tools merge but never overwrite a user-owned tool", () => {
+  createUserTool(ALICE, scriptTool(), options);
+  const merged = mergeAgentCreatedTools(
+    ALICE,
+    [
+      {
+        id: "word_count",
+        title: "Agent word count",
+        kind: "script",
+        script: { language: "bash", source: "echo agent" },
+      },
+      {
+        id: "agent_helper",
+        title: "Agent helper",
+        kind: "script",
+        script: { language: "node", source: "console.log('ok')" },
+      },
+    ],
+    options,
+  );
+  assert.deepEqual(merged.map((tool) => tool.id), ["agent_helper"]);
+  const lib = readUserLibrary(ALICE, options);
+  const wordCount = lib.tools.find((tool) => tool.id === "word_count");
+  assert.equal(wordCount?.source, "user", "a user-owned tool must not be replaced");
+  assert.equal(wordCount?.title, "Word Count");
+  assert.equal(lib.tools.find((tool) => tool.id === "agent_helper")?.source, "agent");
+
+  // A second agent update replaces its own tool.
+  mergeAgentCreatedTools(
+    ALICE,
+    [{ id: "agent_helper", title: "Agent helper v2", kind: "script", script: { language: "node", source: "2" } }],
+    options,
+  );
+  assert.equal(readUserLibrary(ALICE, options).tools.find((tool) => tool.id === "agent_helper")?.title, "Agent helper v2");
+});
+
+test("librarySnapshot masks secrets and passes catalogs through", () => {
+  createUserTool(ALICE, scriptTool(), options);
+  const catalogs = {
+    skills: [],
+    tools: [],
+    mcpServers: [],
+    connectors: [{ id: "slack" }],
+  };
+  const snapshot = librarySnapshot(ALICE, catalogs, options);
+  assert.equal(JSON.stringify(snapshot).includes(SECRET), false);
+  assert.deepEqual(snapshot.tools[0].secrets, [{ name: "API_TOKEN", mask: "••••a1b2" }]);
+  assert.deepEqual(snapshot.catalogs.connectors, [{ id: "slack" }]);
+});
+
+test("invalid entries are rejected with typed errors", () => {
+  assert.throws(
