+/**
+ * Library data model: user-added tools, MCP servers, skills and connectors.
+ *
+ * Everything here is per account (the store keys files by user id). Secrets a
+ * user attaches to a tool or MCP server are sealed at rest by the store and
+ * are never part of a client row — the browser only ever sees last-4 masks.
+ *
+ * The types in this module are dependency-free (no React, no node:*) so the
+ * Library page can validate drafts in the browser with the same helpers the
+ * API uses on the server.
+ */
+
+export const LIBRARY_SCHEMA = "swarmagents.library";
+export const LIBRARY_SCHEMA_VERSION = 1;
+
+/** How a custom tool is implemented. */
+export type UserToolKind = "script" | "http";
+
+/** Interpreter a script tool runs under, inside the user's VM. */
+export type ToolLanguage = "bash" | "node" | "python";
+
+export const TOOL_LANGUAGES: readonly ToolLanguage[] = ["bash", "node", "python"];
+export const HTTP_METHODS = ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD"] as const;
+export type HttpMethod = (typeof HTTP_METHODS)[number];
+
+/** Default / hard limits. The UI shows these; the store clamps to them. */
+export const DEFAULT_TOOL_TIMEOUT_MS = 15_000;
+export const MIN_TOOL_TIMEOUT_MS = 1_000;
+export const MAX_TOOL_TIMEOUT_MS = 60_000;
+export const DEFAULT_TOOL_MAX_OUTPUT_BYTES = 100_000;
+export const MIN_TOOL_MAX_OUTPUT_BYTES = 1_024;
+export const MAX_TOOL_MAX_OUTPUT_BYTES = 1_000_000;
+export const MAX_TOOL_SOURCE_LEN = 64_000;
+export const MAX_TOOL_SCHEMA_LEN = 32_000;
+export const MAX_TOOL_DESCRIPTION_LEN = 2_000;
+export const MAX_TOOL_TITLE_LEN = 80;
+export const MAX_SECRETS_PER_ITEM = 16;
+export const MAX_SECRET_VALUE_LEN = 8_192;
+
+/** A secret the user supplies; the value is only ever sent on create/update. */
+export interface SecretInput {
+  /** Environment-style name referenced as {{secret.NAME}} in templates. */
+  name: string;
+  /** Omitted when an edit should keep the saved value. */
+  value?: string;
+}
+
+/** Client-facing secret row: a name and a last-4 mask, never the value. */
+export interface SecretRow {
+  name: string;
+  mask: string;
+}
+
+/** One HTTP header; `value` may reference {{secret.NAME}} or {{arg}}. */
+export interface ToolHeader {
+  name: string;
+  value: string;
+}
+
+export interface ScriptImplementation {
+  language: ToolLanguage;
+  /** Script text executed inside the user's VM. */
+  source: string;
+}
+
+export interface HttpImplementation {
+  method: HttpMethod;
+  /** URL template; supports {{arg}} and {{secret.NAME}} placeholders. */
+  url: string;
+  headers: ToolHeader[];
+  /** Request body template; omitted for GET/HEAD. */
+  bodyTemplate?: string;
+}
+
+/** A tool as stored (secrets are held separately and sealed by the store). */
+export interface UserTool {
+  /** Stable slug; also the MCP tool name exposed to the agent. */
+  id: string;
+  /** Human title shown in the Library. */
+  title: string;
+  description: string;
+  /** JSON Schema object describing the tool's arguments. */
+  inputSchema: JSONSchema;
+  kind: UserToolKind;
+  script?: ScriptImplementation;
+  http?: HttpImplementation;
+  timeoutMs: number;
+  maxOutputBytes: number;
+  enabled: boolean;
+  /** Who created it: the user, the agent itself, or a catalog install. */
+  source: "user" | "agent" | "catalog";
+  createdAt: number;
+  updatedAt: number;
+}
+
+/** A tool row as returned to the browser (masked). */
+export interface UserToolRow extends UserTool {
+  secrets: SecretRow[];
+}
+
+/** An input field in the form builder (turns into JSON Schema). */
+export interface ToolFieldDraft {
+  name: string;
+  label?: string;
+  type: "string" | "number" | "integer" | "boolean";
+  description?: string;
+  required?: boolean;
+}
+
+export interface JSONSchema {
+  type: "object";
+  properties: Record<string, JSONSchemaProperty>;
+  required?: string[];
+  [key: string]: unknown;
+}
+
+export interface JSONSchemaProperty {
+  type: "string" | "number" | "integer" | "boolean";
+  description?: string;
+  [key: string]: unknown;
+}
+
+/** A user-added MCP server. */
+export type McpTransport = "stdio" | "http";
+
+export interface UserMcpServer {
+  id: string;
+  title: string;
+  description: string;
+  transport: McpTransport;
+  /** stdio only. */
+  command?: string;
+  args?: string[];
+  /** http only. */
+  url?: string;
+  /** Literal header/env values; each may reference {{secret.NAME}}. */
+  headers?: ToolHeader[];
+  env?: ToolHeader[];
+  enabled: boolean;
+  source: "user" | "catalog" | "connector";
+  createdAt: number;
+  updatedAt: number;
+}
+
+export interface UserMcpServerRow extends UserMcpServer {
+  secrets: SecretRow[];
+}
+
+/** A skill installed from the public catalog or written by the user. */
+export interface InstalledSkill {
+  id: string;
+  title: string;
+  description: string;
+  /** Instructions appended to the agent prompt while the skill is enabled. */
+  instructions: string;
+  enabled: boolean;
+  source: "catalog" | "custom";
+  createdAt: number;
+  updatedAt: number;
+}
+
+/** An installed connector (public connector catalog entry). */
+export interface InstalledConnector {
+  id: string;
+  name: string;
+  transport: "http" | "stdio";
+  /** The configured server URL / package, recorded at install time. */
+  install: string;
+  auth: string;
+  enabled: boolean;
+  installedAt: number;
+}
+
+/** Public catalog entries (untrusted content shown before install). */
+export interface CatalogSkill {
+  id: string;
+  title: string;
+  description: string;
+  category: string;
+  instructions: string;
+  sourceUrl?: string;
+  verified?: boolean;
+}
+
+export interface CatalogTool {
+  id: string;
+  title: string;
+  description: string;
+  category: string;
+  kind: UserToolKind;
+  inputSchema: JSONSchema;
+  script?: ScriptImplementation;
+  http?: HttpImplementation;
+  verified?: boolean;
+  sourceUrl?: string;
+}
+
+export interface CatalogMcpServer {
+  id: string;
+  title: string;
+  description: string;
+  category: string;
+  transport: McpTransport;
+  command?: string;
+  args?: string[];
+  url?: string;
+  requiredFields?: Array<{ key: string; label: string; secret?: boolean }>;
+  sourceUrl?: string;
+  verified?: boolean;
+}
+
+/** The full client snapshot GET /api/library returns. */
+export interface LibrarySnapshot {
+  tools: UserToolRow[];
+  mcpServers: UserMcpServerRow[];
+  skills: InstalledSkill[];
+  connectors: InstalledConnector[];
+  catalogs: {
+    skills: CatalogSkill[];
+    tools: CatalogTool[];
+    mcpServers: CatalogMcpServer[];
+    connectors: Array<Record<string, unknown>>;
+  };
+}
+
+/** A rejected library mutation. */
+export class LibraryValidationError extends Error {
+  readonly status: number;
+  constructor(message: string, status = 400) {
+    super(message);
+    this.name = "LibraryValidationError";
+    this.status = status;
+  }
+}
+
+const asRecord = (value: unknown): Record<string, unknown> | null =>
+  value && typeof value === "object" && !Array.isArray(value) ? (value as Record<string, unknown>) : null;
+
+const asText = (value: unknown, max: number): string =>
+  typeof value === "string" ? value.trim().slice(0, max) : "";
+
+const clampInt = (value: unknown, fallback: number, min: number, max: number): number => {
+  const n = typeof value === "number" ? value : Number(value);
+  if (!Number.isFinite(n)) return fallback;
+  return Math.min(max, Math.max(min, Math.trunc(n)));
+};
+
+/** Turn a display title into an MCP-safe tool id (lowercase, underscores). */
+export function slugifyToolId(value: string): string {
+  const slug = value
+    .toLowerCase()
+    .normalize("NFKD")
+    .replace(/[\u0300-\u036f]/g, "")
+    .replace(/[^a-z0-9]+/g, "_")
+    .slice(0, 60)
+    .replace(/^_+|_+$/g, "");
+  return slug || "tool";
+}
+
+export function isValidToolId(value: string): boolean {
+  return /^[a-z][a-z0-9_]{0,59}$/.test(value);
+}
+
+export function isValidSecretName(value: string): boolean {
+  return /^[A-Za-z_][A-Za-z0-9_]{0,63}$/.test(value);
+}
+
+function normalizeSecrets(raw: unknown, required: boolean): SecretInput[] {
+  if (raw === undefined || raw === null) {
+    if (required) return [];
+    return [];
+  }
+  if (!Array.isArray(raw)) throw new LibraryValidationError("secrets must be an array.");
+  if (raw.length > MAX_SECRETS_PER_ITEM) {
+    throw new LibraryValidationError(`At most ${MAX_SECRETS_PER_ITEM} secrets are allowed.`);
+  }
+  const seen = new Set<string>();
+  const out: SecretInput[] = [];
+  for (const item of raw) {
+    const r = asRecord(item);
+    if (!r) throw new LibraryValidationError("Each secret must be an object with a name.");
+    const name = asText(r.name, 64);
+    if (!isValidSecretName(name)) {
+      throw new LibraryValidationError("Secret names must look like ENV_VAR names (A-Z, 0-9, _).");
+    }
+    if (seen.has(name)) throw new LibraryValidationError(`Secret "${name}" is listed twice.`);
+    seen.add(name);
+    const valueRaw = r.value;
+    if (valueRaw !== undefined && typeof valueRaw !== "string") {
+      throw new LibraryValidationError(`Secret "${name}" must be a string.`);
+    }
+    if (typeof valueRaw === "string" && valueRaw.length > MAX_SECRET_VALUE_LEN) {
+      throw new LibraryValidationError(`Secret "${name}" is too long.`);
+    }
+    out.push(valueRaw === undefined ? { name } : { name, value: valueRaw });
+  }
+  return out;
+}
+
+function normalizeHeaders(raw: unknown, label: string): ToolHeader[] {
+  if (raw === undefined || raw === null) return [];
+  if (!Array.isArray(raw)) throw new LibraryValidationError(`${label} must be an array.`);
+  if (raw.length > 32) throw new LibraryValidationError(`At most 32 ${label.toLowerCase()} are allowed.`);
+  const out: ToolHeader[] = [];
+  const seen = new Set<string>();
+  for (const item of raw) {
+    const r = asRecord(item);
+    if (!r) throw new LibraryValidationError(`Each ${label.toLowerCase()} entry needs a name and value.`);
+    const name = asText(r.name, 80);
+    if (!/^[A-Za-z0-9!#$%&'*+.^_`|~-]{1,80}$/.test(name)) {
+      throw new LibraryValidationError(`Invalid ${label.toLowerCase()} name: "${name}".`);
+    }
+    if (seen.has(name.toLowerCase())) {
+      throw new LibraryValidationError(`${label} "${name}" is listed twice.`);
+    }
+    seen.add(name.toLowerCase());
+    const value = asText(r.value, 2_000);
+    out.push({ name, value });
+  }
+  return out;
+}
+
+/** Build a JSON Schema object from the form builder's field drafts. */
+export function schemaFromFields(fields: readonly ToolFieldDraft[]): JSONSchema {
+  const properties: Record<string, JSONSchemaProperty> = {};
+  const required: string[] = [];
+  const seen = new Set<string>();
+  for (const field of fields) {
+    const name = field.name.trim();
+    if (!/^[A-Za-z_][A-Za-z0-9_]{0,63}$/.test(name) || seen.has(name)) continue;
+    seen.add(name);
+    properties[name] = {
+      type: field.type,
+      ...(field.description?.trim() ? { description: field.description.trim().slice(0, 300) } : {}),
+    };
+    if (field.required) required.push(name);
+  }
+  return { type: "object", properties, ...(required.length > 0 ? { required } : {}) };
+}
+
+/**
+ * Parse an input schema supplied either as an object or as a JSON string.
+ * Only flat object schemas are supported (the generated MCP tool relies on
+ * them); nested structures are preserved but required names are validated.
+ */
+export function parseInputSchema(raw: unknown): JSONSchema {
+  let value: unknown = raw;
+  if (typeof raw === "string") {
+    const text = raw.trim();
+    if (!text) return { type: "object", properties: {} };
+    if (text.length > MAX_TOOL_SCHEMA_LEN) throw new LibraryValidationError("The input schema is too large.");
+    try {
+      value = JSON.parse(text);
+    } catch {
+      throw new LibraryValidationError("The input schema is not valid JSON.");
+    }
+  }
+  if (value === undefined || value === null) return { type: "object", properties: {} };
+  const r = asRecord(value);
+  if (!r) throw new LibraryValidationError("The input schema must be a JSON object.");
+  if (r.type !== undefined && r.type !== "object") {
+    throw new LibraryValidationError('The input schema type must be "object".');
+  }
+  const rawProps = r.properties === undefined ? {} : asRecord(r.properties);
+  if (!rawProps) throw new LibraryValidationError("The input schema properties must be an object.");
+  const properties: Record<string, JSONSchemaProperty> = {};
+  for (const [name, prop] of Object.entries(rawProps).slice(0, 64)) {
+    if (!/^[A-Za-z_][A-Za-z0-9_]{0,63}$/.test(name)) {
+      throw new LibraryValidationError(`Invalid input field name: "${name}".`);
+    }
+    const p = asRecord(prop) ?? {};
+    const type = p.type;
+    if (type !== "string" && type !== "number" && type !== "integer" && type !== "boolean") {
+      throw new LibraryValidationError(`Field "${name}" must be string, number, integer or boolean.`);
+    }
+    properties[name] = {
+      ...p,
+      type,
+      ...(typeof p.description === "string" ? { description: p.description.slice(0, 300) } : {}),
+    };
+  }
+  let required: string[] = [];
+  if (r.required !== undefined) {
+    if (!Array.isArray(r.required)) throw new LibraryValidationError("The input schema required list must be an array.");
+    required = r.required
+      .filter((name): name is string => typeof name === "string" && name in properties)
+      .slice(0, 64);
+  }
+  return { ...r, type: "object", properties, ...(required.length > 0 ? { required } : {}) } as JSONSchema;
+}
+
+export interface UserToolInput {
+  id: string;
+  title: string;
+  description: string;
+  inputSchema: JSONSchema;
+  kind: UserToolKind;
+  script?: ScriptImplementation;
+  http?: HttpImplementation;
+  timeoutMs: number;
+  maxOutputBytes: number;
+  enabled: boolean;
+  source: "user" | "agent" | "catalog";
+  secrets: SecretInput[];
+}
+
+/** Validate and normalize a create/update payload for a custom tool. */
+export function normalizeUserToolInput(raw: unknown, fallbackIdSeed = ""): UserToolInput {
+  const r = asRecord(raw);
+  if (!r) throw new LibraryValidationError("A tool body is required.");
+  const title = asText(r.title ?? r.name, MAX_TOOL_TITLE_LEN);
+  if (!title) throw new LibraryValidationError("A tool name is required.");
+  const description = asText(r.description, MAX_TOOL_DESCRIPTION_LEN);
+  const kindRaw = asText(r.kind, 20).toLowerCase();
+  const kind: UserToolKind = kindRaw === "http" ? "http" : kindRaw === "script" || kindRaw === "" ? "script" : "script";
+  if (kindRaw && kindRaw !== "script" && kindRaw !== "http") {
+    throw new LibraryValidationError('kind must be "script" or "http".');
+  }
+  const inputSchema = parseInputSchema(r.inputSchema);
+  const timeoutMs = clampInt(r.timeoutMs, DEFAULT_TOOL_TIMEOUT_MS, MIN_TOOL_TIMEOUT_MS, MAX_TOOL_TIMEOUT_MS);
+  const maxOutputBytes = clampInt(
+    r.maxOutputBytes,
+    DEFAULT_TOOL_MAX_OUTPUT_BYTES,
+    MIN_TOOL_MAX_OUTPUT_BYTES,
+    MAX_TOOL_MAX_OUTPUT_BYTES,
+  );
+
+  let script: ScriptImplementation | undefined;
+  let http: HttpImplementation | undefined;
+  if (kind === "script") {
+    const s = asRecord(r.script) ?? {};
+    const language = asText(s.language, 10).toLowerCase();
+    if (!TOOL_LANGUAGES.includes(language as ToolLanguage)) {
+      throw new LibraryValidationError('Script language must be "bash", "node" or "python".');
+    }
+    const source = typeof s.source === "string" ? s.source : "";
+    if (!source.trim()) throw new LibraryValidationError("The script source is required.");
+    if (source.length > MAX_TOOL_SOURCE_LEN) throw new LibraryValidationError("The script source is too long.");
+    script = { language: language as ToolLanguage, source };
+  } else {
+    const h = asRecord(r.http) ?? {};
+    const method = asText(h.method, 10).toUpperCase() || "GET";
+    if (!HTTP_METHODS.includes(method as HttpMethod)) {
+      throw new LibraryValidationError(`Method must be one of ${HTTP_METHODS.join(", ")}.`);
+    }
+    const url = asText(h.url, 2_000);
+    if (!url) throw new LibraryValidationError("The request URL is required.");
+    const headers = normalizeHeaders(h.headers, "Headers");
+    const bodyTemplate = asText(h.bodyTemplate, 32_000);
+    http = {
+      method: method as HttpMethod,
+      url,
+      headers,
+      ...(bodyTemplate ? { bodyTemplate } : {}),
+    };
+  }
+
+  const idRaw = asText(r.id, 60);
+  const id = idRaw && isValidToolId(idRaw) ? idRaw : slugifyToolId(title || fallbackIdSeed);
+  return {
+    id,
+    title,
+    description,
+    inputSchema,
+    kind,
+    ...(script ? { script } : {}),
+    ...(http ? { http } : {}),
+    timeoutMs,
+    maxOutputBytes,
+    enabled: r.enabled === undefined ? true : r.enabled === true,
+    source: r.source === "agent" ? "agent" : r.source === "catalog" ? "catalog" : "user",
+    secrets: normalizeSecrets(r.secrets, true),
+  };
+}
+
+export interface UserMcpServerInput {
+  id: string;
+  title: string;
+  description: string;
+  transport: McpTransport;
+  command?: string;
+  args?: string[];
+  url?: string;
+  headers: ToolHeader[];
+  env: ToolHeader[];
+  enabled: boolean;
+  source: "user" | "catalog" | "connector";
+  secrets: SecretInput[];
+}
+
+/** Validate and normalize a user-added MCP server. */
+export function normalizeMcpServerInput(raw: unknown, fallbackIdSeed = ""): UserMcpServerInput {
+  const r = asRecord(raw);
+  if (!r) throw new LibraryValidationError("An MCP server body is required.");
+  const title = asText(r.title ?? r.name, MAX_TOOL_TITLE_LEN);
+  if (!title) throw new LibraryValidationError("A server name is required.");
+  const transportRaw = asText(r.transport, 10).toLowerCase();
+  if (transportRaw !== "stdio" && transportRaw !== "http") {
+    throw new LibraryValidationError('transport must be "stdio" or "http".');
+  }
+  const transport = transportRaw as McpTransport;
+  let command: string | undefined;
+  let args: string[] | undefined;
+  let url: string | undefined;
+  if (transport === "stdio") {
+    command = asText(r.command, 200);
+    if (!command) throw new LibraryValidationError("A stdio server needs a command.");
+    if (r.args !== undefined) {
+      if (!Array.isArray(r.args)) throw new LibraryValidationError("args must be an array.");
+      args = r.args.filter((a): a is string => typeof a === "string").map((a) => a.slice(0, 500)).slice(0, 32);
+    }
+  } else {
+    url = asText(r.url, 2_000);
+    if (!url) throw new LibraryValidationError("An HTTP server needs a url.");
+  }
+  const idRaw = asText(r.id, 60);
+  const id = idRaw && isValidToolId(idRaw) ? idRaw : slugifyToolId(title || fallbackIdSeed);
+  return {
+    id,
+    title,
+    description: asText(r.description, MAX_TOOL_DESCRIPTION_LEN),
+    transport,
+    ...(command ? { command } : {}),
+    ...(args && args.length > 0 ? { args } : {}),
+    ...(url ? { url } : {}),
+    headers: normalizeHeaders(r.headers, "Headers"),
+    env: normalizeHeaders(r.env, "Environment"),
+    enabled: r.enabled === undefined ? true : r.enabled === true,
+    source: r.source === "catalog" ? "catalog" : r.source === "connector" ? "connector" : "user",
+    secrets: normalizeSecrets(r.secrets, true),
+  };
+}
+
+/** Normalize an installed skill (custom or from the catalog). */
+export function normalizeSkillInput(raw: unknown): Omit<InstalledSkill, "createdAt" | "updatedAt"> {
+  const r = asRecord(raw);
+  if (!r) throw new LibraryValidationError("A skill body is required.");
+  const title = asText(r.title ?? r.name, MAX_TOOL_TITLE_LEN);
+  if (!title) throw new LibraryValidationError("A skill name is required.");
+  const idRaw = asText(r.id, 60);
+  return {
+    id: idRaw && isValidToolId(idRaw) ? idRaw : slugifyToolId(title),
+    title,
+    description: asText(r.description, MAX_TOOL_DESCRIPTION_LEN),
+    instructions: asText(r.instructions, MAX_TOOL_SOURCE_LEN),
+    enabled: r.enabled === undefined ? true : r.enabled === true,
+    source: r.source === "custom" ? "custom" : "catalog",
+  };
+}
+
+/** Mask a secret value down to a last-4 marker (short values fully masked). */
+export function maskSecret(value: string): string {
+  const v = value.trim();
+  if (v.length < 5) return "••••";
+  return `••••${v.slice(-4)}`;
+}
+
+/** Names of the secrets referenced by a tool template (for UI hints). */
+export function secretRefsIn(text: string): string[] {
+  const out = new Set<string>();
+  const re = /\{\{\s*secret\.([A-Za-z_][A-Za-z0-9_]*)\s*\}\}/g;
+  let m: RegExpExecArray | null;
+  while ((m = re.exec(text)) !== null) out.add(m[1]);
+  return [...out];
+}
