+
+async function executeTool(tool, args) {
+  if (!tool || typeof tool !== "object") throw new Error("Unknown tool.");
+  if (args === null || typeof args !== "object" || Array.isArray(args)) throw new Error("Tool arguments must be a JSON object.");
