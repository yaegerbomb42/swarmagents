+
+  const save = async (event: FormEvent) => {
+    event.preventDefault();
+    setSaving(true);
+    try {
+      await api("/api/library/mcp-servers", {
+        method: "POST",
+        body: JSON.stringify({
+          server: {
+            id: draft.id || slugifyToolId(draft.title),
