@@ -0,0 +1,2050 @@
+"use client";
+
+/**
+ * The per-account Library.
+ *
+ * Five tabs mirror the public catalogs + what the user has installed:
+ * Connectors, MCP Servers, Skills, Tools and Public Library. Catalog entries
+ * are untrusted content: every one is rendered with its category, description,
+ * source link and an expandable definition before the install button, and
+ * installs copy a normalized copy into the user's own library.
+ *
+ * Custom tools get a form builder (or a raw JSON Schema) plus a script or HTTP
+ * implementation and a "Try it" panel. Try it runs inside the user's VM via
+ * the same generated MCP server the agent uses — nothing executes in the
+ * browser or the Next.js process. Secret values are only sent on save and the
+ * server returns last-4 masks, never the values.
+ */
+
+import { useCallback, useEffect, useMemo, useState } from "react";
+import type { FormEvent, ReactNode } from "react";
+import {
+  BookOpen,
+  Boxes,
+  Braces,
+  Code2,
+  ExternalLink,
+  Globe,
+  Loader2,
+  Plug,
+  Plus,
+  Search,
+  ShieldCheck,
+  Sparkles,
+  Terminal,
+  Trash2,
+  Wrench,
+  X,
+} from "lucide-react";
+import {
+  DEFAULT_TOOL_MAX_OUTPUT_BYTES,
+  DEFAULT_TOOL_TIMEOUT_MS,
+  HTTP_METHODS,
+  MAX_TOOL_MAX_OUTPUT_BYTES,
+  MAX_TOOL_TIMEOUT_MS,
+  MIN_TOOL_MAX_OUTPUT_BYTES,
+  MIN_TOOL_TIMEOUT_MS,
+  TOOL_LANGUAGES,
+  schemaFromFields,
+  secretRefsIn,
+  slugifyToolId,
+} from "../lib/library/types";
+import type {
+  CatalogMcpServer,
+  CatalogSkill,
+  CatalogTool,
+  HttpMethod,
+  InstalledConnector,
+  InstalledSkill,
+  JSONSchema,
+  LibrarySnapshot,
+  McpTransport,
+  ToolFieldDraft,
+  ToolHeader,
+  ToolLanguage,
+  UserMcpServerRow,
+  UserToolKind,
+  UserToolRow,
+} from "../lib/library/types";
+import type { ConnectorCatalogEntry } from "../lib/library/catalog";
+
+type Tab = "connectors" | "mcp" | "skills" | "tools" | "public";
+
+const TABS: ReadonlyArray<{ id: Tab; label: string; icon: typeof Plug }> = [
+  { id: "connectors", label: "Connectors", icon: Plug },
+  { id: "mcp", label: "MCP Servers", icon: Boxes },
+  { id: "skills", label: "Skills", icon: BookOpen },
+  { id: "tools", label: "Tools", icon: Wrench },
+  { id: "public", label: "Public Library", icon: Globe },
+];
+
+const fieldClass =
+  "w-full rounded-xl bg-white/[0.04] px-3 py-2 text-sm text-white/85 ring-1 ring-white/10 placeholder:text-white/25 focus:outline-none focus:ring-cyan-400/40";
+const labelClass = "mb-1 block text-[11px] font-medium uppercase tracking-wide text-white/45";
+const pillClass = "rounded-full px-2 py-0.5 text-[10px] font-medium";
+
+async function api<T>(url: string, init: RequestInit = {}): Promise<T> {
+  const headers = new Headers(init.headers);
+  if (init.body !== undefined) headers.set("content-type", "application/json");
+  const res = await fetch(url, { cache: "no-store", ...init, headers });
+  const text = await res.text();
+  let body: unknown = {};
+  try {
+    body = text ? JSON.parse(text) : {};
+  } catch {
+    body = {};
+  }
+  if (!res.ok) {
+    const message =
+      body && typeof body === "object" && typeof (body as { error?: unknown }).error === "string"
+        ? (body as { error: string }).error
+        : `HTTP ${res.status}`;
+    throw new Error(message);
+  }
+  return body as T;
+}
+
+function errText(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
+
+function sampleInput(schema: JSONSchema | undefined): string {
+  const obj: Record<string, unknown> = {};
+  for (const [name, prop] of Object.entries(schema?.properties ?? {})) {
+    obj[name] = prop.type === "boolean" ? false : prop.type === "string" ? "" : 0;
+  }
+  return JSON.stringify(obj, null, 2);
+}
+
+/** Fields the editor derives from an existing schema. */
+function fieldsFromSchema(schema: JSONSchema | undefined): ToolFieldDraft[] {
+  const required = new Set(schema?.required ?? []);
+  return Object.entries(schema?.properties ?? {}).map(([name, prop]) => ({
+    name,
+    type: prop.type,
+    description: typeof prop.description === "string" ? prop.description : "",
+    required: required.has(name),
+  }));
+}
+
+function Toggle({
+  checked,
+  onChange,
+  label,
+}: {
+  checked: boolean;
+  onChange: () => void;
+  label: string;
+}) {
+  return (
+    <button
+      type="button"
+      role="switch"
+      aria-checked={checked}
+      aria-label={label}
+      onClick={onChange}
+      className={`relative h-5 w-9 shrink-0 rounded-full transition-colors ${
+        checked ? "bg-emerald-400/80" : "bg-white/15"
+      }`}
+    >
+      <span
+        className={`absolute top-0.5 h-4 w-4 rounded-full bg-white transition-all ${
+          checked ? "left-[18px]" : "left-0.5"
+        }`}
+      />
+    </button>
+  );
+}
+
+function Badge({ children, tone = "slate" }: { children: ReactNode; tone?: "slate" | "cyan" | "emerald" | "amber" }) {
+  const tones = {
+    slate: "bg-white/[0.06] text-white/55 ring-white/10",
+    cyan: "bg-cyan-400/10 text-cyan-300 ring-cyan-400/30",
+    emerald: "bg-emerald-400/10 text-emerald-300 ring-emerald-400/30",
+    amber: "bg-amber-400/10 text-amber-300 ring-amber-400/30",
+  } as const;
+  return <span className={`${pillClass} ring-1 ${tones[tone]}`}>{children}</span>;
+}
+
+function Notice({ text, tone }: { text: string; tone: "ok" | "error" }) {
+  if (!text) return null;
+  return (
+    <div
+      role={tone === "error" ? "alert" : "status"}
+      className={`mb-4 rounded-2xl px-4 py-3 text-sm ${
+        tone === "error"
+          ? "border border-red-400/20 bg-red-400/10 text-red-300"
+          : "border border-emerald-400/20 bg-emerald-400/10 text-emerald-300"
+      }`}
+    >
+      {text}
+    </div>
+  );
+}
+
+function SectionHeading({ title, subtitle }: { title: string; subtitle?: string }) {
+  return (
+    <div className="mb-3">
+      <h2 className="text-sm font-semibold text-white/85">{title}</h2>
+      {subtitle && <p className="mt-0.5 text-xs text-white/40">{subtitle}</p>}
+    </div>
+  );
+}
+
+function KeyValueRows({
+  label,
+  rows,
+  onChange,
+  placeholderName,
+  placeholderValue,
+}: {
+  label: string;
+  rows: ToolHeader[];
+  onChange: (rows: ToolHeader[]) => void;
+  placeholderName: string;
+  placeholderValue: string;
+}) {
+  return (
+    <div>
+      <div className="mb-1 flex items-center justify-between">
+        <span className={labelClass}>{label}</span>
+        <button
+          type="button"
+          onClick={() => onChange([...rows, { name: "", value: "" }])}
+          className="flex items-center gap-1 text-[11px] text-cyan-300 hover:text-cyan-200"
+        >
+          <Plus className="h-3 w-3" /> Add
+        </button>
+      </div>
+      <div className="space-y-2">
+        {rows.map((row, index) => (
+          <div key={index} className="flex gap-2">
+            <input
+              value={row.name}
+              onChange={(e) => onChange(rows.map((r, i) => (i === index ? { ...r, name: e.target.value } : r)))}
+              placeholder={placeholderName}
+              aria-label={`${label} name ${index + 1}`}
+              className={`${fieldClass} max-w-[40%]`}
+              spellCheck={false}
+            />
+            <input
+              value={row.value}
+              onChange={(e) => onChange(rows.map((r, i) => (i === index ? { ...r, value: e.target.value } : r)))}
+              placeholder={placeholderValue}
+              aria-label={`${label} value ${index + 1}`}
+              className={fieldClass}
+              spellCheck={false}
+            />
+            <button
+              type="button"
+              aria-label={`Remove ${label} ${index + 1}`}
+              onClick={() => onChange(rows.filter((_, i) => i !== index))}
+              className="grid h-9 w-9 shrink-0 place-items-center rounded-xl text-white/40 ring-1 ring-white/10 hover:bg-white/5 hover:text-red-300"
+            >
+              <X className="h-3.5 w-3.5" />
+            </button>
+          </div>
+        ))}
+        {rows.length === 0 && <p className="text-xs text-white/30">None.</p>}
+      </div>
+    </div>
+  );
+}
+
+// ---------------------------------------------------------------------------
+// Connectors
+// ---------------------------------------------------------------------------
+
+function ConnectorsTab({
+  snapshot,
+  query,
+  reload,
+  onNotice,
+}: {
+  snapshot: LibrarySnapshot;
+  query: string;
+  reload: () => Promise<void>;
+  onNotice: (text: string, tone: "ok" | "error") => void;
+}) {
+  const [installing, setInstalling] = useState("");
+  const entries = useMemo(() => {
+    const all = snapshot.catalogs.connectors as unknown as ConnectorCatalogEntry[];
+    const q = query.trim().toLowerCase();
+    if (!q) return all;
+    return all.filter((entry) =>
+      [entry.name, entry.category, entry.description, entry.id].some((v) => v.toLowerCase().includes(q)),
+    );
+  }, [snapshot.catalogs.connectors, query]);
+  const [values, setValues] = useState<Record<string, Record<string, string>>>({});
+
+  const install = async (entry: ConnectorCatalogEntry) => {
+    setInstalling(entry.id);
+    try {
+      await api("/api/library/connectors", {
