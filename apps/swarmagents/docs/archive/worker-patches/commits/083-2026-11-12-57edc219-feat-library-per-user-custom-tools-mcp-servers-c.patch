+/**
+ * GET /api/library
+ *
+ * The signed-in user's Library snapshot: installed connectors, MCP servers,
+ * skills and custom tools (secrets masked), plus the public catalogs the
+ * Library page browses. Only the caller's own rows are ever returned.
+ */
+
+import { NextResponse } from "next/server";
+import { publicCatalogs } from "../../../lib/library/catalog";
+import { librarySnapshot } from "../../../lib/library/store";
+import { NO_STORE, errorResponse, libraryOwner, unauthorized } from "../../../lib/library/api";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+export function GET(request: Request) {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    return NextResponse.json(librarySnapshot(owner, publicCatalogs()), { headers: NO_STORE });
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
