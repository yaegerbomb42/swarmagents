+            step={1024}
+            value={draft.maxOutputBytes}
+            onChange={(e) => setDraft({ ...draft, maxOutputBytes: Number(e.target.value) })}
+            className={fieldClass}
+          />
+        </label>
+      </div>
+
+      <div>
+        <KeyValueRows
+          label={existing ? "Secrets (leave value blank to keep the saved one)" : "Secrets (encrypted at rest)"}
