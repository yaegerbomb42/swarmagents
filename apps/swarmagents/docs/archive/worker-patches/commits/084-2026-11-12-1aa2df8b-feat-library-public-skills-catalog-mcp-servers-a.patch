+/**
+ * Merge the skills the user installed into their library with the built-ins.
+ * A built-in id always wins, so an installed skill can never shadow one.
+ */
+export function mergeMcpSkills(
+  installed: Array<{ id: string; name: string; description: string }>,
+  base: McpSkill[] = DEFAULT_MCP_SKILLS,
+): McpSkill[] {
+  const out = [...base];
+  const known = new Set(base.map((skill) => skill.id));
+  for (const skill of installed) {
+    if (!skill.id || known.has(skill.id)) continue;
+    known.add(skill.id);
