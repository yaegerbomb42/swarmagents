+/**
+ * Build the public skills catalog index.
+ *
+ * The index is a snapshot of real, public skill collections: for every source
+ * in `lib/library/catalog/skill-sources.json` this script downloads the
+ * repository tarball, walks its `SKILL.md` files, parses their frontmatter and
+ * records the name, description, source URL and license of each skill.
+ *
+ * Nothing here is invented: an entry only exists when a SKILL.md with that
+ * name and description was really present in the repository at build time.
+ *
+ * Usage:
+ *   npx tsx scripts/build-skills-index.ts [--only <sourceId>] [--out <file>]
+ *   npx tsx scripts/build-skills-index.ts --sources <file>
+ *
+ * The generated file is committed so the app never has to reach GitHub to
+ * show the catalog; installing a skill from the catalog fetches the files
+ * (SKILL.md + its companions) from raw.githubusercontent.com on demand.
+ */
+
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import zlib from "node:zlib";
+import { Readable } from "node:stream";
+import { pipeline } from "node:stream/promises";
+
+import {
+  isValidSkillName,
+  parseSkillDocument,
+  slugifySkillName,
+} from "../lib/library/skills/format";
+
+interface SourceFile {
+  id: string;
+  name: string;
+  repo: string;
+  branch: string;
+  homepage?: string;
+  license?: string;
+  licenseUrl?: string;
+  verified?: boolean;
+  verifiedHow?: string;
+  category?: string;
+  maxSkills?: number;
+}
+
+interface CatalogEntry {
+  id: string;
+  name: string;
+  description: string;
+  repo: string;
+  branch: string;
+  path: string;
+  files: string[];
+  sourceUrl: string;
+  license: string;
+  licenseUrl: string;
+  category: string;
+  source: string;
+  sourceName: string;
+  verified: boolean;
+}
+
+interface TarEntry {
+  path: string;
+  size: number;
+  type: string;
+  offset: number;
+}
+
+const ROOT = path.resolve(__dirname, "..");
+const DEFAULT_SOURCES = path.join(ROOT, "lib/library/catalog/skill-sources.json");
+const DEFAULT_OUT = path.join(ROOT, "lib/library/catalog/skills-index.json");
+const CACHE_DIR = path.join(os.tmpdir(), "swarmagents-skills-index");
+
+const CATEGORY_RULES: Array<[string, string[]]> = [
+  ["documents", ["pdf", "docx", "xlsx", "pptx", "document", "spreadsheet", "slide", "writing", "markdown", "office", "word"]],
+  ["data-science", ["data", "analysis", "scientific", "research", "chart", "plot", "notebook", "statistic", "bio", "chemistry", "physics", "dataset", "pandas"]],
+  ["development", ["code", "coding", "git", "github", "test", "debug", "review", "refactor", "api", "sdk", "frontend", "backend", "python", "javascript", "typescript", "rust", "golang", "java", "compiler", "regex", "lint", "cli"]],
+  ["devops", ["deploy", "docker", "kubernetes", "terraform", "cloud", "aws", "gcp", "azure", "server", "infrastructure", "devops", "monitor", "logging", "pipeline"]],
+  ["security", ["security", "vulnerab", "audit", "pentest", "threat", "secret", "compliance"]],
+  ["marketing", ["marketing", "seo", "copywriting", "social", "campaign", "brand", "sales"]],
+  ["productivity", ["email", "calendar", "task", "todo", "meeting", "workflow", "automation", "summary", "translate", "note"]],
+  ["design", ["design", "figma", "svg", "animation", "typography", "palette", "webapp", "frontend-design"]],
+  ["communication", ["slack", "discord", "newsletter", "communication", "comms", "messaging"]],
+  ["collections", ["collection", "bundle", "starter", "template"]],
+];
+
+/** Classify a skill into a UI category from its name/description. */
+export function classifySkill(name: string, description: string, fallback: string): string {
+  const title = name.toLowerCase();
+  const body = description.toLowerCase();
+  const scores = new Map<string, number>();
+  for (const [category, keywords] of CATEGORY_RULES) {
+    let score = 0;
+    for (const keyword of keywords) {
+      if (title.includes(keyword)) score += 4;
+      else if (new RegExp(`\\b${keyword}\\b`).test(body)) score += 1;
+    }
+    if (score > 0) scores.set(category, score);
+  }
+  let best = "";
+  let bestScore = 0;
+  for (const [category, score] of scores) {
+    if (score > bestScore || (score === bestScore && category < best)) {
+      best = category;
+      bestScore = score;
+    }
+  }
+  return bestScore >= 2 ? best : fallback || "other";
+}
+
+// ---------------------------------------------------------------------------
+// tar reading (ustar / gnu, streaming over a gunzip stream)
+// ---------------------------------------------------------------------------
+
+class ChunkReader {
+  private queue: Buffer[] = [];
+  private queued = 0;
+  private eof = false;
+
+  constructor(private readonly iterator: AsyncIterator<Buffer>) {}
+
+  private async pull(): Promise<void> {
+    if (this.eof) return;
+    const next = await this.iterator.next();
+    if (next.done) {
+      this.eof = true;
+      return;
+    }
+    this.queue.push(next.value);
+    this.queued += next.value.length;
+  }
+
+  /** Read exactly `size` bytes (fewer only at the end of the stream). */
+  async read(size: number): Promise<Buffer> {
+    while (this.queued < size && !this.eof) await this.pull();
+    const take = Math.min(size, this.queued);
+    const out = Buffer.allocUnsafe(take);
+    let written = 0;
+    while (written < take) {
+      const chunk = this.queue[0];
+      if (!chunk) break;
+      const need = take - written;
+      if (chunk.length <= need) {
+        chunk.copy(out, written);
+        written += chunk.length;
+        this.queue.shift();
+        this.queued -= chunk.length;
+      } else {
+        chunk.copy(out, written, 0, need);
+        this.queue[0] = chunk.subarray(need);
+        written += need;
+        this.queued -= need;
+      }
+    }
+    return out;
+  }
+}
+
+/** Parse a tar header block into a path/size/type triple. */
+function parseTarHeader(block: Buffer): { path: string; size: number; type: string } | null {
+  if (block.length < 512) return null;
+  let name = block.subarray(0, 100).toString("utf-8").replace(/\0.*$/, "");
+  const sizeField = block.subarray(124, 136).toString("ascii").replace(/\0.*$/, "").trim();
+  const type = String.fromCharCode(block[156]) || "0";
+  const prefix = block.subarray(345, 500).toString("utf-8").replace(/\0.*$/, "");
+  let size = 0;
+  if (sizeField.length > 0) {
+    if (sizeField[0] === "\x80" || sizeField[0] === "\xff") {
+      size = Number.parseInt(sizeField.slice(1), 16) || 0;
+    } else {
+      size = Number.parseInt(sizeField, 8) || 0;
+    }
+  }
+  if (prefix) name = `${prefix}/${name}`;
+  return { path: name, size, type };
+}
+
+/** List the entries of a gzipped tarball. */
+async function listTar(file: string): Promise<TarEntry[]> {
+  const entries: TarEntry[] = [];
+  const gunzip = zlib.createGunzip();
+  const source = fs.createReadStream(file);
+  source.pipe(gunzip);
+  const iterator = gunzip[Symbol.asyncIterator]() as AsyncIterator<Buffer>;
+  const reader = new ChunkReader(iterator);
+  let offset = 0;
+  let longName: string | null = null;
+  for (;;) {
+    const header = await reader.read(512);
+    if (header.length < 512) break;
+    const parsed = parseTarHeader(header);
+    if (!parsed) break;
+    const padded = Math.ceil(parsed.size / 512) * 512;
+    if (parsed.type === "L") {
+      const content = await reader.read(parsed.size);
+      longName = content.toString("utf-8").replace(/\0.*$/, "");
+      offset += 512 + padded;
+      continue;
+    }
+    if (parsed.type === "0" || parsed.type === "" || parsed.type === "7") {
+      entries.push({ path: longName ?? parsed.path, size: parsed.size, type: parsed.type, offset: offset + 512 });
+    }
+    longName = null;
+    offset += 512 + padded;
+    if (parsed.size > 0) await reader.read(padded);
+  }
+  gunzip.destroy();
+  source.destroy();
+  return entries;
+}
+
+/** Extract specific files from a gzipped tarball. */
+async function extractFiles(file: string, wanted: Set<string>): Promise<Map<string, Buffer>> {
+  const found = new Map<string, Buffer>();
+  if (wanted.size === 0) return found;
+  const gunzip = zlib.createGunzip();
+  const source = fs.createReadStream(file);
+  source.pipe(gunzip);
+  const iterator = gunzip[Symbol.asyncIterator]() as AsyncIterator<Buffer>;
+  const reader = new ChunkReader(iterator);
+  let longName: string | null = null;
+  for (;;) {
+    const header = await reader.read(512);
+    if (header.length < 512) break;
+    const parsed = parseTarHeader(header);
+    if (!parsed) break;
+    const padded = Math.ceil(parsed.size / 512) * 512;
+    if (parsed.type === "L") {
+      const content = await reader.read(parsed.size);
+      longName = content.toString("utf-8").replace(/\0.*$/, "");
+      continue;
+    }
+    const name = longName ?? parsed.path;
+    longName = null;
+    if (parsed.type === "0" || parsed.type === "" || parsed.type === "7") {
+      if (wanted.has(name)) {
+        const content = await reader.read(parsed.size);
+        found.set(name, content);
+        const remaining = padded - parsed.size;
+        if (remaining > 0) await reader.read(remaining);
+        if (found.size === wanted.size) break;
+        continue;
+      }
+    }
+    if (parsed.size > 0) await reader.read(padded);
+  }
+  gunzip.destroy();
+  source.destroy();
+  return found;
+}
+
+// ---------------------------------------------------------------------------
+// download
+// ---------------------------------------------------------------------------
+
+async function downloadTarball(repo: string, branch: string): Promise<string> {
+  fs.mkdirSync(CACHE_DIR, { recursive: true });
+  const file = path.join(CACHE_DIR, `${repo.replace(/\//g, "__")}-${branch.replace(/\//g, "_")}.tar.gz`);
+  if (fs.existsSync(file) && fs.statSync(file).size > 0) return file;
+  const url = `https://codeload.github.com/${repo}/tar.gz/refs/heads/${branch}`;
+  const response = await fetch(url, { headers: { "user-agent": "swarmagents-skill-indexer" } });
+  if (!response.ok || !response.body) {
+    throw new Error(`tarball download failed for ${repo}@${branch}: HTTP ${response.status}`);
+  }
+  const tmp = `${file}.tmp`;
+  await pipeline(Readable.fromWeb(response.body as never), fs.createWriteStream(tmp));
+  fs.renameSync(tmp, file);
+  return file;
+}
+
+// ---------------------------------------------------------------------------
+// main
+// ---------------------------------------------------------------------------
+
+function parseArgs(argv: string[]): { only?: string; out: string; sources: string; maxPerSource?: number } {
+  const args = { out: DEFAULT_OUT, sources: DEFAULT_SOURCES } as {
+    only?: string;
+    out: string;
+    sources: string;
+    maxPerSource?: number;
+  };
+  for (let i = 0; i < argv.length; i += 1) {
+    const arg = argv[i];
+    if (arg === "--only") args.only = argv[++i];
+    else if (arg === "--out") args.out = path.resolve(argv[++i] ?? DEFAULT_OUT);
+    else if (arg === "--sources") args.sources = path.resolve(argv[++i] ?? DEFAULT_SOURCES);
+    else if (arg === "--max-per-source") args.maxPerSource = Number(argv[++i]);
+  }
+  return args;
+}
+
+async function main(): Promise<void> {
+  const args = parseArgs(process.argv.slice(2));
+  const sourceDoc = JSON.parse(fs.readFileSync(args.sources, "utf-8")) as { sources: SourceFile[] };
+  const sources = sourceDoc.sources.filter((source) => !args.only || source.id === args.only);
+  if (sources.length === 0) {
+    throw new Error("No matching sources.");
+  }
+
+  const skills: CatalogEntry[] = [];
+  const sourceSummaries: Array<Record<string, unknown>> = [];
+
+  for (const source of sources) {
+    const started = Date.now();
+    let tarball: string;
+    try {
+      tarball = await downloadTarball(source.repo, source.branch);
+    } catch (error) {
+      console.error(`[skills-index] skipping ${source.repo}: ${(error as Error).message}`);
+      continue;
+    }
+    const entries = await listTar(tarball);
+    const prefix = `${source.repo.split("/")[1]}-${source.branch}/`;
+    // `rel` is the path inside the repository; `raw` is the path inside the tarball.
+    const paths = entries.map((entry) => ({
+      raw: entry.path,
+      path: entry.path.startsWith(prefix) ? entry.path.slice(prefix.length) : entry.path,
+      size: entry.size,
+    }));
+    const skillFiles = paths.filter((entry) => /(^|\/)SKILL\.md$/i.test(entry.path));
+    const limit = args.maxPerSource ?? source.maxSkills ?? 400;
+
+    // Group the files that belong to each skill folder.
+    const folders = new Map<string, string[]>();
+    for (const entry of skillFiles) {
+      const folder = entry.path.replace(/(^|\/)SKILL\.md$/i, "").replace(/\/$/, "");
+      const files = folders.get(folder) ?? [];
+      files.push(entry.path);
+      folders.set(folder, files);
+    }
+    const selected: Array<{ folder: string; skillPath: string }> = [];
+    for (const [folder, files] of folders) {
+      if (selected.length >= limit) break;
+      const skillPath = files[0];
+      if (!skillPath) continue;
+      selected.push({ folder, skillPath });
+    }
+
+    // Collect the files that must be extracted: SKILL.md plus its companions.
+    const wanted = new Set<string>();
+    const companionMap = new Map<string, string[]>();
+    const allSkillFolders = [...folders.keys()].sort((a, b) => a.length - b.length);
+    for (const { folder, skillPath } of selected) {
+      const prefixFolder = folder ? `${folder}/` : "";
+      // Files that belong to a nested skill folder are not ours.
+      const nestedPrefixes = allSkillFolders
+        .filter((other) => other !== folder && other.startsWith(prefixFolder))
+        .map((other) => `${other}/`);
+      const companions = paths
+        .filter((entry) => entry.path.startsWith(prefixFolder) && entry.path !== skillPath)
+        .filter((entry) => !nestedPrefixes.some((nested) => entry.path.startsWith(nested)))
+        .filter((entry) => !/(^|\/)SKILL\.md$/i.test(entry.path))
+        .slice(0, 60)
+        .map((entry) => entry.path);
+      companionMap.set(folder, companions);
+      wanted.add(skillPath);
+      for (const companion of companions) wanted.add(companion);
+    }
+    const rawByRel = new Map(paths.map((entry) => [entry.path, entry.raw]));
+    const wantedRaw = new Set<string>();
+    for (const rel of wanted) {
+      const raw = rawByRel.get(rel);
+      if (raw) wantedRaw.add(raw);
+    }
+
+    const contents = await extractFiles(tarball, wantedRaw);
+    const added: CatalogEntry[] = [];
+    for (const { folder, skillPath } of selected) {
+      const raw = contents.get(rawByRel.get(skillPath) ?? skillPath);
+      if (!raw) continue;
+      const text = raw.toString("utf-8");
+      if (text.length > 512 * 1024) continue;
+      const document = parseSkillDocument(text);
+      const name = document.name || path.basename(folder);
+      const description = document.description || "";
+      if (!description) continue;
+      const idName = isValidSkillName(name) ? name : slugifySkillName(name);
+      const companions = (companionMap.get(folder) ?? []).map((companion) =>
+        companion.startsWith(`${folder}/`) ? companion.slice(folder.length + 1) : companion,
+      );
+      const licenseUrl = source.licenseUrl ?? source.homepage ?? `https://github.com/${source.repo}`;
+      added.push({
+        id: `${source.id}--${idName}`,
+        name,
+        description: description.slice(0, 512),
+        repo: source.repo,
+        branch: source.branch,
+        path: folder,
+        files: ["SKILL.md", ...companions].slice(0, 60),
+        sourceUrl: folder
+          ? `https://github.com/${source.repo}/tree/${source.branch}/${folder}`
+          : `https://github.com/${source.repo}/tree/${source.branch}`,
+        license: source.license || document.license || "unknown",
+        licenseUrl,
+        category: classifySkill(name, description, source.category ?? "other"),
+        source: source.id,
+        sourceName: source.name,
+        verified: source.verified !== false,
+        ...(document.license && document.license !== source.license
+          ? { declaredLicense: document.license }
+          : {}),
+      });
+    }
+    // De-duplicate by id, keeping the first (repository order) entry.
+    const seen = new Set<string>();
+    const unique = added.filter((entry) => {
+      if (seen.has(entry.id)) return false;
+      seen.add(entry.id);
+      return true;
+    });
+    skills.push(...unique);
+    sourceSummaries.push({
+      id: source.id,
+      name: source.name,
+      repo: source.repo,
+      branch: source.branch,
+      homepage: source.homepage ?? `https://github.com/${source.repo}`,
+      license: source.license ?? "unknown",
+      licenseUrl: source.licenseUrl ?? "",
+      verified: source.verified !== false,
+      verifiedHow: source.verifiedHow ?? "",
+      skillCount: unique.length,
+    });
+    console.log(
+      `[skills-index] ${source.repo}: ${unique.length} skills (${selected.length} folders scanned, ${((Date.now() - started) / 1000).toFixed(1)}s)`,
+    );
+  }
+
+  skills.sort((a, b) => a.id.localeCompare(b.id));
+  const categories = [...new Set(skills.map((skill) => skill.category))].sort();
+  const index = {
+    schema: "swarmagents.library.skills-index",
+    version: 1,
+    generatedAt: new Date().toISOString(),
+    total: skills.length,
+    categories,
+    sources: sourceSummaries,
+    skills,
+  };
+  fs.mkdirSync(path.dirname(args.out), { recursive: true });
+  fs.writeFileSync(args.out, `${JSON.stringify(index, null, 1)}\n`, "utf-8");
+  console.log(`[skills-index] wrote ${skills.length} skills to ${args.out}`);
+}
+
+main().catch((error) => {
+  console.error(`[skills-index] ${(error as Error).message}`);
+  process.exitCode = 1;
+});
