+/**
+ * Browse the public library catalogs.
+ *
+ * GET /api/library/catalog?type=skills|tools|connectors&q=…&category=…&source=…
+ *
+ * The catalogs are bundled with the app, so browsing never touches the
+ * network and never needs the caller's account — but the route still requires
+ * a signed-in user, like every other library route.
+ */
+
+import { NextResponse } from "next/server";
+
+import { NO_STORE, libraryErrorResponse, libraryOwner, unauthorized } from "../../../../lib/library/api";
+import {
+  catalogCategories,
+  catalogConnectors,
+  catalogSources,
+  connectorCategories,
+  searchCatalogSkills,
+  searchCatalogTools,
+} from "../../../../lib/library/catalog";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+export async function GET(request: Request): Promise<NextResponse> {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    const url = new URL(request.url);
+    const type = (url.searchParams.get("type") ?? "skills").toLowerCase();
+    const query = url.searchParams.get("q") ?? "";
+    const category = url.searchParams.get("category") ?? "";
+    const source = url.searchParams.get("source") ?? "";
+    const limit = Number(url.searchParams.get("limit") ?? "60") || 60;
+    const offset = Number(url.searchParams.get("offset") ?? "0") || 0;
+
+    if (type === "tools") {
+      return NextResponse.json(
+        { type, tools: searchCatalogTools({ query, limit }) },
+        { headers: NO_STORE },
+      );
+    }
+    if (type === "connectors") {
+      const connectors = catalogConnectors().filter((connector) => {
+        if (category && connector.category !== category) return false;
+        if (!query) return true;
+        const haystack = `${connector.name} ${connector.description} ${connector.category}`.toLowerCase();
+        return haystack.includes(query.toLowerCase());
+      });
+      return NextResponse.json(
+        { type, connectors, categories: connectorCategories() },
+        { headers: NO_STORE },
+      );
+    }
+    const result = searchCatalogSkills({ query, category, source, limit, offset });
+    return NextResponse.json(
+      {
+        type: "skills",
+        skills: result.skills,
+        total: result.total,
+        categories: result.categories.length > 0 ? result.categories : catalogCategories(),
+        sources: catalogSources(),
+      },
+      { headers: NO_STORE },
+    );
+  } catch (error) {
+    return libraryErrorResponse(error);
+  }
+}
