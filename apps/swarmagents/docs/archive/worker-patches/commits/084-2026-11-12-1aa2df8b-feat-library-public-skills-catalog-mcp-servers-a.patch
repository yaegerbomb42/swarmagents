+export function fetchLibrary(): Promise<LibrarySnapshot> {
+  return request<LibrarySnapshot>("/api/library");
+}
+
+/** The public skill catalog. */
+export function fetchCatalogSkills(params: {
+  query?: string;
+  category?: string;
+  source?: string;
+  limit?: number;
+  offset?: number;
+} = {}): Promise<{
+  skills: CatalogSkill[];
+  total: number;
+  categories: Array<{ id: string; label: string; count: number }>;
+  sources: Array<{ id: string; name: string; repo: string; license: string; verified: boolean; skillCount: number }>;
+}> {
+  const search = new URLSearchParams({ type: "skills" });
+  if (params.query) search.set("q", params.query);
+  if (params.category) search.set("category", params.category);
+  if (params.source) search.set("source", params.source);
+  if (params.limit) search.set("limit", String(params.limit));
+  if (params.offset) search.set("offset", String(params.offset));
+  return request(`/api/library/catalog?${search.toString()}`);
+}
+
+/** The public tool library. */
+export function fetchCatalogTools(query = ""): Promise<{ tools: CatalogTool[] }> {
+  const search = new URLSearchParams({ type: "tools" });
+  if (query) search.set("q", query);
+  return request(`/api/library/catalog?${search.toString()}`);
+}
+
+/** The MCP connector catalog. */
+export function fetchCatalogConnectors(query = ""): Promise<{ connectors: CatalogConnector[] }> {
+  const search = new URLSearchParams({ type: "connectors" });
+  if (query) search.set("q", query);
+  return request(`/api/library/catalog?${search.toString()}`);
+}
+
+/** Stage an import from the catalog. */
+export function importSkillFromCatalog(catalogId: string): Promise<{ preview: SkillPreview }> {
+  return request("/api/library/skills/import", {
+    method: "POST",
+    body: JSON.stringify({ source: "catalog", catalogId }),
+  });
+}
+
+/** Stage an import from a GitHub URL. */
+export function importSkillFromUrl(url: string): Promise<{ preview: SkillPreview }> {
+  return request("/api/library/skills/import", {
+    method: "POST",
+    body: JSON.stringify({ source: "url", url }),
+  });
+}
+
+/** Stage an import from the in-app editor. */
+export function importSkillFromEditor(input: {
+  name: string;
+  description: string;
+  markdown: string;
+}): Promise<{ preview: SkillPreview }> {
+  return request("/api/library/skills/import", {
+    method: "POST",
+    body: JSON.stringify({ source: "editor", ...input }),
+  });
+}
+
+/** Stage an import from an uploaded zip archive. */
+export async function importSkillFromZip(file: File): Promise<{ preview: SkillPreview }> {
+  const form = new FormData();
+  form.append("file", file);
+  return request("/api/library/skills/import", { method: "POST", body: form });
+}
+
+/** Install a staged import. */
+export function installStagedSkill(id: string): Promise<{ skill: InstalledSkill }> {
+  return request("/api/library/skills/install", {
+    method: "POST",
+    body: JSON.stringify({ id }),
+  });
+}
+
+/** Discard a staged import. */
+export function discardStagedSkill(id: string): Promise<{ removed: boolean }> {
+  return request(`/api/library/skills/install?id=${encodeURIComponent(id)}`, { method: "DELETE" });
+}
+
+/** Uninstall a skill. */
+export function uninstallSkill(id: string): Promise<{ removed: boolean }> {
+  return request(`/api/library/skills/${encodeURIComponent(id)}`, { method: "DELETE" });
+}
+
+/** Mark a skill as reviewed / trusted. */
+export function updateSkillFlags(
+  id: string,
+  flags: { reviewed?: boolean; trusted?: boolean },
+): Promise<{ skill: InstalledSkill }> {
+  return request(`/api/library/skills/${encodeURIComponent(id)}`, {
+    method: "PATCH",
+    body: JSON.stringify(flags),
+  });
+}
+
+/** Add an MCP server. */
+export function addMcpServer(input: {
+  id?: string;
+  name: string;
+  description?: string;
+  transport: "http" | "stdio";
+  url?: string;
+  command?: string;
+  args?: string[];
+  env?: Record<string, string>;
+  secrets?: Record<string, string>;
+  tools?: string[];
+  sourceUrl?: string;
+  verified?: boolean;
+}): Promise<{ mcpServer: InstalledMcpServer }> {
+  return request("/api/library/mcp", { method: "POST", body: JSON.stringify(input) });
+}
+
+/** Remove an MCP server. */
+export function removeMcpServer(id: string): Promise<{ removed: boolean }> {
+  return request(`/api/library/mcp/${encodeURIComponent(id)}`, { method: "DELETE" });
+}
+
+/** Add a custom tool. */
+export function addCustomTool(input: {
+  name: string;
+  description?: string;
+  source: string;
+  inputSchema?: Record<string, unknown>;
+}): Promise<{ tool: InstalledTool }> {
+  return request("/api/library/tools", { method: "POST", body: JSON.stringify(input) });
+}
+
+/** Remove a custom tool. */
+export function removeCustomTool(id: string): Promise<{ removed: boolean }> {
+  return request(`/api/library/tools/${encodeURIComponent(id)}`, { method: "DELETE" });
+}
+
+/** Assign library items to a role. */
+export function setRoleAssignments(input: {
+  roleId: string;
+  skills?: string[];
+  mcpServers?: string[];
+  tools?: string[];
+}): Promise<{ assignments: { skills: string[]; mcpServers: string[]; tools: string[] } }> {
+  return request("/api/library/assignments", { method: "POST", body: JSON.stringify(input) });
+}
