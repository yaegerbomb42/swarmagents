+/**
+ * The user's MCP servers.
+ *
+ * GET  /api/library/mcp   the servers (never any secret value)
+ * POST /api/library/mcp   add a server
+ */
+
+import { NextResponse } from "next/server";
+
+import {
+  NO_STORE,
+  libraryErrorResponse,
+  libraryOwner,
+  readJson,
+  unauthorized,
+} from "../../../../lib/library/api";
+import { addMcpServer, listMcpServers } from "../../../../lib/library/mcp/store";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+function asRecord(value: unknown): Record<string, unknown> {
+  return value && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : {};
+}
+
+function stringMap(value: unknown): Record<string, string> {
+  const out: Record<string, string> = {};
+  for (const [key, entry] of Object.entries(asRecord(value))) {
+    if (typeof entry === "string") out[key] = entry;
+  }
+  return out;
+}
+
+function stringList(value: unknown): string[] {
+  return Array.isArray(value) ? value.filter((item): item is string => typeof item === "string") : [];
+}
+
+export async function GET(request: Request): Promise<NextResponse> {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    return NextResponse.json({ mcpServers: listMcpServers(owner) }, { headers: NO_STORE });
+  } catch (error) {
+    return libraryErrorResponse(error);
+  }
+}
+
+export async function POST(request: Request): Promise<NextResponse> {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    const body = asRecord(await readJson(request));
+    const transport = body.transport === "stdio" ? "stdio" : "http";
+    const record = addMcpServer(owner, {
+      id: typeof body.id === "string" ? body.id : undefined,
+      name: typeof body.name === "string" ? body.name : "",
+      description: typeof body.description === "string" ? body.description : "",
+      transport,
+      url: typeof body.url === "string" ? body.url : "",
+      command: typeof body.command === "string" ? body.command : "",
+      args: stringList(body.args),
+      env: stringMap(body.env),
+      secrets: stringMap(body.secrets),
+      tools: stringList(body.tools),
+      sourceUrl: typeof body.sourceUrl === "string" ? body.sourceUrl : "",
+      verified: body.verified === true,
+    });
+    return NextResponse.json({ mcpServer: record }, { status: 201, headers: NO_STORE });
+  } catch (error) {
+    return libraryErrorResponse(error);
+  }
+}
diff --git a/apps/swarmagents/app/api/library/route.test.ts b/apps/swarmagents/app/api/library/route.test.ts
new file mode 100644
index 000000000..431b257bc
--- /dev/null
+++ b/apps/swarmagents/app/api/library/route.test.ts
@@ -0,0 +1,200 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { NextRequest } from "next/server";
+
+import { GET as getLibrary } from "./route";
+import { GET as getCatalog } from "./catalog/route";
+import { POST as postImport } from "./skills/import/route";
+import { POST as postInstall, GET as getStaged } from "./skills/install/route";
+import { GET as getSkill, DELETE as deleteSkill } from "./skills/[id]/route";
+import { POST as postMcp, GET as getMcp } from "./mcp/route";
+import { POST as postTool, GET as getTools } from "./tools/route";
+import { POST as postAssignments } from "./assignments/route";
+
+const ALICE = "alice@example.com";
+const BOB = "bob@example.com";
+/** A per-run suffix so the tests never see the state of an earlier run. */
+const SUFFIX = process.pid.toString(36);
+
+type NextRequestInit = ConstructorParameters<typeof NextRequest>[1];
+
+function request(path: string, user: string | null = ALICE, init?: NextRequestInit): NextRequest {
+  const headers = new Headers(init?.headers);
+  headers.set("content-type", "application/json");
+  if (user) headers.set("x-swarm-user", user);
+  return new NextRequest(`http://localhost${path}`, { ...init, headers });
+}
+
+async function json(response: Response): Promise<Record<string, unknown>> {
+  return (await response.json()) as Record<string, unknown>;
+}
+
+test("the library of an account is private", async () => {
+  await postImport(
+    request("/api/library/skills/import", ALICE, {
+      method: "POST",
+      body: JSON.stringify({
+        source: "editor",
+        name: `demo-${SUFFIX}`,
+        description: "A demo skill.",
+        markdown: "Do the thing.",
+      }),
+    }),
+  );
+  const staged = await json(await getStaged(request("/api/library/skills/install")));
+  const preview = (staged.staged as Array<{ id: string }>)[0];
+  assert.ok(preview);
+  await postInstall(request("/api/library/skills/install", ALICE, { method: "POST", body: JSON.stringify({ id: preview.id }) }));
+
+  const alice = await json(await getLibrary(request("/api/library", ALICE)));
+  const aliceSkills = (alice.skills as Array<{ id: string }>).map((skill) => skill.id);
+  assert.equal(aliceSkills.includes(`demo-${SUFFIX}`), true);
+  const bob = await json(await getLibrary(request("/api/library", BOB)));
+  const bobSkills = (bob.skills as Array<{ id: string }>).map((skill) => skill.id);
+  assert.equal(bobSkills.includes(`demo-${SUFFIX}`), false);
+});
+
+test("the library route needs a signed-in user", async () => {
+  const previous = process.env.SWARM_SERVER_MODE;
+  process.env.SWARM_SERVER_MODE = "1";
+  try {
+    const response = await getLibrary(request("/api/library", null));
+    assert.equal(response.status, 401);
+  } finally {
+    if (previous === undefined) delete process.env.SWARM_SERVER_MODE;
+    else process.env.SWARM_SERVER_MODE = previous;
+  }
+});
+
+test("the catalog is browsable and searchable", async () => {
+  const all = await json(await getCatalog(request("/api/library/catalog?type=skills")));
+  const skills = all.skills as Array<{ id: string; name: string; description: string; sourceUrl: string }>;
+  assert.ok(skills.length > 0);
+  assert.ok(skills.every((skill) => skill.id && skill.name && skill.description && skill.sourceUrl));
+
+  const searched = await json(await getCatalog(request("/api/library/catalog?type=skills&q=pdf")));
+  assert.ok((searched.skills as unknown[]).length > 0);
+  assert.ok((searched.total as number) > 0);
+
+  const tools = await json(await getCatalog(request("/api/library/catalog?type=tools")));
+  assert.ok((tools.tools as unknown[]).length > 0);
+});
+
+test("an import is staged with the untrusted warning and then installed", async () => {
+  const response = await postImport(
+    request("/api/library/skills/import", ALICE, {
+      method: "POST",
+      body: JSON.stringify({
+        source: "editor",
+        name: `editor-skill-${SUFFIX}`,
+        description: "Written in the editor.",
+        markdown: "Body",
+      }),
+    }),
+  );
+  assert.equal(response.status, 201);
+  const body = await json(response);
+  const preview = body.preview as { id: string; warning: string; skillMarkdown: string; scripts: string[] };
+  assert.match(preview.warning, /Untrusted content/);
+  assert.match(preview.skillMarkdown, /name: editor-skill/);
+  assert.deepEqual(preview.scripts, []);
+
+  const installed = await postInstall(
+    request("/api/library/skills/install", ALICE, {
+      method: "POST",
+      body: JSON.stringify({ id: preview.id }),
+    }),
+  );
+  assert.equal(installed.status, 201);
+  const skill = (await json(installed)).skill as { id: string; origin: string };
+  assert.equal(skill.id, `editor-skill-${SUFFIX}`);
+  assert.equal(skill.origin, "editor");
+
+  const detail = await getSkill(request(`/api/library/skills/editor-skill-${SUFFIX}`, ALICE), {
+    params: Promise.resolve({ id: `editor-skill-${SUFFIX}` }),
+  });
+  assert.equal(detail.status, 200);
+  const detailBody = await json(detail);
+  const files = (detailBody.skill as { files: Array<{ path: string; content: string }> }).files;
+  assert.equal(files[0].path, "SKILL.md");
+  assert.match(files[0].content, new RegExp(`name: editor-skill-${SUFFIX}`));
+});
+
+test("a skill of another account cannot be read or removed", async () => {
+  const response = await getSkill(request(`/api/library/skills/editor-skill-${SUFFIX}`, BOB), {
+    params: Promise.resolve({ id: `editor-skill-${SUFFIX}` }),
+  });
+  assert.equal(response.status, 404);
+  const removal = await deleteSkill(request(`/api/library/skills/editor-skill-${SUFFIX}`, BOB), {
+    params: Promise.resolve({ id: `editor-skill-${SUFFIX}` }),
+  });
+  assert.equal(removal.status, 404);
+});
+
+test("an MCP server is added without leaking its secret", async () => {
+  const response = await postMcp(
+    request("/api/library/mcp", ALICE, {
+      method: "POST",
+      body: JSON.stringify({
+        name: "GitHub",
+        transport: "http",
+        url: "https://example.com/mcp",
+        secrets: { Authorization: "top-secret-value" },
+      }),
+    }),
+  );
+  assert.equal(response.status, 201);
+  const body = await json(response);
+  assert.equal(JSON.stringify(body).includes("top-secret-value"), false);
+  const server = body.mcpServer as { secretEnv: string[] };
+  assert.deepEqual(server.secretEnv, ["Authorization"]);
+
+  const listed = await json(await getMcp(request("/api/library/mcp", ALICE)));
+  assert.equal(JSON.stringify(listed).includes("top-secret-value"), false);
+});
+
+test("an invalid MCP server is refused", async () => {
+  const response = await postMcp(
+    request("/api/library/mcp", ALICE, {
+      method: "POST",
+      body: JSON.stringify({ name: "bad", transport: "http", url: "javascript:alert(1)" }),
+    }),
+  );
+  assert.equal(response.status, 400);
+});
+
+test("a custom tool is added and removed", async () => {
+  const created = await postTool(
+    request("/api/library/tools", ALICE, {
+      method: "POST",
+      body: JSON.stringify({
+        name: "my-tool",
+        description: "Counts things.",
+        source: "process.stdout.write('ok')",
+      }),
+    }),
+  );
+  assert.equal(created.status, 201);
+  const listed = await json(await getTools(request("/api/library/tools", ALICE)));
+  assert.equal((listed.tools as unknown[]).length >= 1, true);
+});
+
+test("assignments only keep installed items", async () => {
+  const response = await postAssignments(
+    request("/api/library/assignments", ALICE, {
+      method: "POST",
+      body: JSON.stringify({ roleId: "main", skills: [`editor-skill-${SUFFIX}`, "not-installed"] }),
+    }),
+  );
+  assert.equal(response.status, 200);
+  const body = await json(response);
+  const assignments = body.assignments as { skills: string[] };
+  assert.deepEqual(assignments.skills, [`editor-skill-${SUFFIX}`]);
+});
+
+test("an import without a source is refused", async () => {
+  const response = await postImport(
+    request("/api/library/skills/import", ALICE, { method: "POST", body: JSON.stringify({}) }),
+  );
+  assert.equal(response.status, 400);
+});
