index 000000000..9e61b7fe3
--- /dev/null
+++ b/apps/swarmagents/lib/library/skills/vm-sync.ts
@@ -0,0 +1,329 @@
+/**
+ * The library inside the user's VM.
+ *
+ * Everything the library installs runs *inside the user's own VM*, never in
+ * the Next.js process:
+ *
+ *   /workspace/.claude/skills/<skill>/…   the installed skills. Claude Code
+ *                                        picks them up as project skills.
+ *   /workspace/.swarm/library/tools.json  the custom tools of the user.
+ *   /workspace/.swarm/library/tools.mjs   the MCP server that runs them.
+ *   /workspace/.swarm/agent-tools/…       tools the agent wrote for itself
+ *                                        during a run; they are harvested
+ *                                        back into the library afterwards.
+ *
+ * The MCP servers of the user are wired into the run's --mcp-config (see
+ * lib/harness/role-mcp.ts), with their secrets injected as environment
+ * variables or HTTP headers inside the VM.
+ */
+
+import {
+  installTool,
+  listInstalledSkills,
+  readLibraryFile,
+  readLibraryState,
+  userSkillDir,
+  userToolDir,
+  type CustomToolRecord,
+  type DataDirOptions,
+  type InstalledSkill,
+} from "../store";
+import { getVmManager, type VmManager } from "../../vm/manager";
+
+/** Where the skills live inside the VM (Claude Code reads them from here). */
+export const VM_SKILLS_DIR = "/workspace/.claude/skills";
+/** Where the library's own files live inside the VM. */
+export const VM_LIBRARY_DIR = "/workspace/.swarm/library";
+/** The manifest of the custom tools. */
+export const VM_TOOLS_MANIFEST = `${VM_LIBRARY_DIR}/tools.json`;
+/** The MCP server that runs the custom tools. */
+export const VM_TOOLS_SERVER = `${VM_LIBRARY_DIR}/tools.mjs`;
+/** Where the agent writes the tools it creates for itself. */
+export const VM_AGENT_TOOLS_DIR = "/workspace/.swarm/agent-tools";
+
+/** The manager used to talk to the VM (overridable in tests). */
+function vm(manager?: VmManager): VmManager {
+  return manager ?? getVmManager();
+}
+
+/** The skills one role may use: the ones assigned to it and installed. */
+export function skillsForRole(userId: string, roleId: string, options: DataDirOptions = {}): InstalledSkill[] {
+  const state = readLibraryState(userId, options);
+  const assigned = new Set(state.roleSkills[roleId] ?? []);
+  return listInstalledSkills(userId, options).filter((skill) => assigned.has(skill.id));
+}
+
+/**
+ * Write the installed skills of a role into the user's VM.
+ * Returns the paths that were written.
+ */
+export async function syncRoleSkillsToVm(
+  userId: string,
+  roleId: string,
+  options: DataDirOptions = {},
+  manager?: VmManager,
+): Promise<string[]> {
+  const skills = skillsForRole(userId, roleId, options);
+  return syncSkillsToVm(userId, skills, options, manager);
+}
+
+/** Write a list of skills into the user's VM. */
+export async function syncSkillsToVm(
+  userId: string,
+  skills: readonly InstalledSkill[],
+  options: DataDirOptions = {},
+  manager?: VmManager,
+): Promise<string[]> {
+  const target = vm(manager);
+  const written: string[] = [];
+  for (const skill of skills) {
+    const state = readLibraryState(userId, options);
+    const dir = `${VM_SKILLS_DIR}/${skill.id}`;
+    for (const file of skill.files) {
+      const content = readSkillFile(userId, skill.id, file.path, options);
+      if (content === null) continue;
+      await target.writeFile(userId, `${dir}/${file.path}`, content);
+      written.push(`${dir}/${file.path}`);
+    }
+    void state;
+  }
+  return written;
+}
+
+/** Read one file of an installed skill (from the account directory). */
+export function readSkillFile(
+  userId: string,
+  skillId: string,
+  filePath: string,
+  options: DataDirOptions = {},
+): string | null {
+  return readLibraryFile(userSkillDir(userId, skillId, options), filePath);
+}
+
+/** The MCP config entry of one custom tool. */
+export interface VmToolEntry {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  command: string;
+  args: string[];
+}
+
+/** The tool manifest written into the VM. */
+export interface VmToolsManifest {
+  tools: VmToolEntry[];
+}
+
+/** The custom tools of one user, as they are exposed inside the VM. */
+export function toolManifest(
+  userId: string,
+  options: DataDirOptions = {},
+): VmToolsManifest {
+  const state = readLibraryState(userId, options);
+  const tools: VmToolEntry[] = Object.values(state.tools).map((tool) => ({
+    name: tool.name,
+    description: tool.description,
+    inputSchema:
+      Object.keys(tool.inputSchema).length > 0
+        ? tool.inputSchema
+        : { type: "object", properties: {}, additionalProperties: true },
+    command: "node",
+    args: [`${VM_LIBRARY_DIR}/tools/${tool.id}/tool.mjs`],
+  }));
+  return { tools };
+}
+
+/** Write the custom tools (and their MCP server) into the user's VM. */
+export async function syncToolsToVm(
+  userId: string,
+  options: DataDirOptions = {},
+  manager?: VmManager,
+): Promise<string[]> {
+  const target = vm(manager);
+  const state = readLibraryState(userId, options);
+  const written: string[] = [];
+  for (const tool of Object.values(state.tools)) {
+    const source = readToolSource(userId, tool.id, options);
+    if (source === null) continue;
+    const path = `${VM_LIBRARY_DIR}/tools/${tool.id}/tool.mjs`;
+    await target.writeFile(userId, path, source);
+    written.push(path);
+  }
+  await target.writeFile(userId, VM_TOOLS_MANIFEST, JSON.stringify(toolManifest(userId, options), null, 2));
+  await target.writeFile(userId, VM_TOOLS_SERVER, LIBRARY_TOOLS_SERVER_SOURCE);
+  written.push(VM_TOOLS_MANIFEST, VM_TOOLS_SERVER);
+  return written;
+}
+
+/** Read the source of one custom tool. */
+export function readToolSource(
+  userId: string,
+  toolId: string,
+  options: DataDirOptions = {},
+): string | null {
+  return readLibraryFile(userToolDir(userId, toolId, options), "tool.mjs");
+}
+
+/**
+ * Harvest the tools the agent created for itself during a run.
+ *
+ * The agent writes a tool as `/workspace/.swarm/agent-tools/<name>/tool.mjs`.
+ * After the run the files are read back and stored in the user's library, so
+ * the tool is available to every later run.
+ */
+export async function harvestAgentTools(
+  userId: string,
+  options: DataDirOptions = {},
+  manager?: VmManager,
+): Promise<CustomToolRecord[]> {
+  const target = vm(manager);
+  let entries: Array<{ name: string; path: string; type: string }> = [];
+  try {
+    entries = await target.listDir(userId, VM_AGENT_TOOLS_DIR);
+  } catch {
+    return [];
+  }
+  const harvested: CustomToolRecord[] = [];
+  for (const entry of entries) {
+    if (entry.type !== "directory") continue;
+    const source = await target.readFile(userId, `${entry.path}/tool.mjs`).catch(() => null);
+    if (!source || source.trim().length === 0) continue;
+    const description = await target.readFile(userId, `${entry.path}/README.md`).catch(() => null);
+    const id = entry.name.replace(/[^a-z0-9-]/gi, "-").toLowerCase().replace(/-+/g, "-").replace(/^-|-$/g, "");
+    if (!id) continue;
+    const record = installTool(
+      userId,
+      {
+        id,
+        name: id,
+        description: (description ?? "Tool created by the agent.").slice(0, 400),
+        origin: "agent",
+        files: { "tool.mjs": source },
+      },
+      options,
+    );
+    harvested.push(record);
+  }
+  return harvested;
+}
+
+/**
+ * The MCP stdio server that runs the user's custom tools inside the VM.
+ *
+ * A custom tool is a script: it receives the tool arguments as JSON on
+ * stdin and prints its result on stdout. The server exposes one MCP tool per
+ * script.
+ */
+export const LIBRARY_TOOLS_SERVER_SOURCE = [
+  "#!/usr/bin/env node",
+  "// SwarmAgents library tools MCP stdio server (auto-generated).",
+  "// Runs the user's custom tools inside their own VM.",
+  "import { spawn } from \"node:child_process\";",
+  "import fs from \"node:fs\";",
+  "",
+  "const manifestPath = process.env.SWARM_LIBRARY_TOOLS || \"/workspace/.swarm/library/tools.json\";",
+  "let tools = [];",
+  "try {",
+  "  const parsed = JSON.parse(fs.readFileSync(manifestPath, \"utf8\"));",
+  "  if (Array.isArray(parsed.tools)) tools = parsed.tools;",
+  "} catch (err) {",
+  "  tools = [];",
+  "}",
+  "",
+  "function send(message) {",
+  "  try {",
+  "    process.stdout.write(JSON.stringify(message) + \"\\n\");",
+  "  } catch (err) {",
+  "    /* the pipe closed */",
+  "  }",
+  "}",
+  "",
+  "function runTool(tool, args) {",
+  "  return new Promise((resolve) => {",
+  "    let child;",
+  "    try {",
+  "      child = spawn(tool.command, tool.args || [], { cwd: tool.cwd || \"/workspace\" });",
+  "    } catch (error) {",
+  "      resolve({ ok: false, stdout: \"\", stderr: String(error && error.message ? error.message : error) });",
+  "      return;",
+  "    }",
+  "    let stdout = \"\";",
+  "    let stderr = \"\";",
+  "    child.stdout.on(\"data\", (chunk) => { stdout += chunk; });",
+  "    child.stderr.on(\"data\", (chunk) => { stderr += chunk; });",
+  "    child.on(\"error\", (error) => {",
+  "      resolve({ ok: false, stdout, stderr: String(error && error.message ? error.message : error) });",
+  "    });",
+  "    child.on(\"close\", (code) => {",
+  "      resolve({ ok: code === 0, stdout, stderr, code });",
+  "    });",
+  "    try {",
+  "      child.stdin.write(typeof args === \"string\" ? args : JSON.stringify(args ?? {}));",
+  "      child.stdin.end();",
+  "    } catch (error) {",
+  "      /* the tool closed stdin */",
+  "    }",
+  "  });",
+  "}",
+  "",
+  "async function handle(message) {",
+  "  const id = message && message.id;",
+  "  const method = message && message.method;",
+  "  const params = (message && message.params) || {};",
+  "  if (method === \"initialize\") {",
+  "    send({ jsonrpc: \"2.0\", id, result: {",
+  "      protocolVersion: \"2024-11-05\",",
+  "      capabilities: { tools: {} },",
+  "      serverInfo: { name: \"swarm-library-tools\", version: \"1.0.0\" },",
+  "    } });",
+  "    return;",
+  "  }",
+  "  if (!method || method.indexOf(\"notifications/\") === 0) return;",
+  "  if (method === \"ping\") { send({ jsonrpc: \"2.0\", id, result: {} }); return; }",
+  "  if (method === \"tools/list\") {",
+  "    send({ jsonrpc: \"2.0\", id, result: { tools: tools.map((tool) => ({",
+  "      name: tool.name,",
+  "      description: tool.description || \"\",",
+  "      inputSchema: tool.inputSchema || { type: \"object\", properties: {} },",
+  "    })) } });",
+  "    return;",
+  "  }",
+  "  if (method === \"tools/call\") {",
+  "    const tool = tools.find((candidate) => candidate.name === params.name);",
+  "    if (!tool) {",
+  "      send({ jsonrpc: \"2.0\", id, error: { code: -32602, message: \"Unknown tool: \" + String(params.name) } });",
+  "      return;",
+  "    }",
+  "    const result = await runTool(tool, params.arguments || {});",
+  "    const text = result.ok",
+  "      ? String(result.stdout || \"\")",
+  "      : \"Tool failed: \" + String(result.stderr || result.stdout || \"unknown error\");",
+  "    send({ jsonrpc: \"2.0\", id, result: {",
+  "      content: [{ type: \"text\", text }],",
+  "      isError: !result.ok,",
+  "    } });",
+  "    return;",
+  "  }",
+  "  if (id !== undefined) {",
+  "    send({ jsonrpc: \"2.0\", id, error: { code: -32601, message: \"Unknown method: \" + String(method) } });",
+  "  }",
+  "}",
+  "",
+  "let buffer = \"\";",
+  "process.stdin.setEncoding(\"utf8\");",
+  "process.stdin.on(\"data\", (chunk) => {",
+  "  buffer += chunk;",
+  "  let index = buffer.indexOf(\"\\n\");",
+  "  while (index >= 0) {",
+  "    const line = buffer.slice(0, index).trim();",
+  "    buffer = buffer.slice(index + 1);",
+  "    if (line) {",
+  "      let message = null;",
+  "      try { message = JSON.parse(line); } catch (error) { message = null; }",
+  "      if (message) handle(message);",
+  "    }",
+  "    index = buffer.indexOf(\"\\n\");",
+  "  }",
+  "});",
+  "process.stdin.on(\"end\", () => { process.exit(0); });",
+].join("\n");
