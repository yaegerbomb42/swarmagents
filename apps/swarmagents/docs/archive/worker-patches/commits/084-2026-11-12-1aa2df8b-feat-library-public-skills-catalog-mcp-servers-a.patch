@@ -0,0 +1,98 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+
+import {
+  catalogCategories,
+  catalogConnectors,
+  catalogSkill,
+  catalogSkillCount,
+  catalogSources,
+  catalogTools,
+  searchCatalogSkills,
+  searchCatalogTools,
+} from "./index";
+
+test("the public catalog holds hundreds of real skills", () => {
+  const count = catalogSkillCount();
+  assert.ok(count >= 500, `expected hundreds of skills, found ${count}`);
+});
+
+test("every catalog entry is complete and points at a real source", () => {
+  for (const skill of catalogSkillsSample()) {
+    assert.ok(skill.id.length > 0);
+    assert.ok(skill.name.length > 0);
+    assert.ok(skill.description.length > 10, `short description for ${skill.id}`);
+    assert.match(skill.repo, /^[\w.-]+\/[\w.-]+$/);
+    assert.ok(skill.sourceUrl.startsWith("https://github.com/"));
+    assert.ok(skill.license.length > 0);
+    assert.ok(skill.files.includes("SKILL.md"));
+  }
+});
+
+function catalogSkillsSample() {
+  const all = searchCatalogSkills({ limit: 500 }).skills;
+  assert.ok(all.length > 0);
+  return all;
+}
+
+test("the catalog comes from verified public collections", () => {
+  const sources = catalogSources();
+  assert.ok(sources.length >= 5);
+  for (const source of sources) {
+    assert.equal(source.verified, true);
+    assert.ok(source.repo.includes("/"));
+    assert.ok(source.skillCount > 0);
+  }
+});
+
+test("the categories are usable for browsing", () => {
+  const categories = catalogCategories();
+  assert.ok(categories.length >= 4);
+  const total = categories.reduce((sum, entry) => sum + entry.count, 0);
+  assert.equal(total, catalogSkillCount());
+  assert.ok(categories.every((entry) => entry.label.length > 0));
+});
+
+test("searching finds skills by name and by description", () => {
+  const byName = searchCatalogSkills({ query: "pdf" });
+  assert.ok(byName.total > 0);
+  assert.ok(
+    byName.skills.some((skill) => skill.name.toLowerCase().includes("pdf")),
+    "a name search should match a skill name",
+  );
+
+  const byDescription = searchCatalogSkills({ query: "spreadsheet" });
+  assert.ok(byDescription.total > 0);
+
+  const nothing = searchCatalogSkills({ query: "zzz-not-a-real-skill-zzz" });
+  assert.equal(nothing.total, 0);
+});
+
+test("the catalog can be filtered by category and by collection", () => {
+  const category = catalogCategories()[0];
+  assert.ok(category);
+  const filtered = searchCatalogSkills({ category: category.id, limit: 10 });
+  assert.ok(filtered.total > 0);
+  assert.ok(filtered.skills.every((skill) => skill.category === category.id));
+
+  const source = catalogSources()[0];
+  const bySource = searchCatalogSkills({ source: source.id, limit: 10 });
+  assert.ok(bySource.total > 0);
+  assert.ok(bySource.skills.every((skill) => skill.source === source.id));
+});
+
+test("one catalog skill can be looked up by id", () => {
+  const first = searchCatalogSkills({ limit: 1 }).skills[0];
+  assert.ok(first);
+  assert.equal(catalogSkill(first.id)?.id, first.id);
+  assert.equal(catalogSkill("does-not-exist"), null);
+});
+
+test("the public tool library and the connector catalog are browsable", () => {
+  assert.ok(catalogTools().length > 50);
+  const tools = searchCatalogTools({ query: "github" });
+  assert.ok(tools.length > 0);
+  assert.ok(tools.every((tool) => tool.id.length > 0));
+  assert.ok(catalogConnectors().length > 10);
+  assert.ok(catalogConnectors().every((connector) => connector.name.length > 0));
+});
diff --git a/apps/swarmagents/lib/library/catalog/index.ts b/apps/swarmagents/lib/library/catalog/index.ts
new file mode 100644
index 000000000..4248c12c4
--- /dev/null
+++ b/apps/swarmagents/lib/library/catalog/index.ts
@@ -0,0 +1,255 @@
+/**
+ * The public library catalog.
+ *
+ * Three catalogs are browsable from here:
+ *
+ *   - the skills catalog (lib/library/catalog/skills-index.json): real skills
+ *     from verified public repositories, generated by
+ *     scripts/build-skills-index.ts;
+ *   - the tool library (lib/library/catalog/tools-index.json): MCP servers
+ *     from the official registry plus the verified connector catalog;
+ *   - the connector catalog (lib/library/catalog/connectors.json).
+ *
+ * The data is bundled with the app, so browsing never touches the network.
+ * Installing a skill does fetch its files from GitHub — that happens in
+ * lib/library/skills/import.ts, after the user asked for it.
+ */
+
+import skillsIndex from "./skills-index.json";
+import toolsIndex from "./tools-index.json";
+import connectorCatalog from "./connectors.json";
+
+/** One skill in the public catalog. */
+export interface CatalogSkill {
+  id: string;
+  name: string;
+  description: string;
+  repo: string;
+  branch: string;
+  path: string;
+  files: string[];
+  sourceUrl: string;
+  license: string;
+  licenseUrl: string;
+  category: string;
+  source: string;
+  sourceName: string;
+  verified: boolean;
+  /** The license the skill's own SKILL.md declares (when it differs). */
+  declaredLicense?: string;
+}
+
+/** One entry of the public tool library. */
+export interface CatalogTool {
+  id: string;
+  name: string;
+  title: string;
+  description: string;
+  transport: "http" | "stdio";
+  install: string;
+  tools: string[];
+  sourceUrl: string;
+  publisher: string;
+  verified: boolean;
+  origin: "registry" | "connector";
+}
+
+/** One connector of the MCP connector catalog. */
+export interface CatalogConnector {
+  id: string;
+  name: string;
+  category: string;
+  description: string;
+  transport: string;
+  install: string;
+  requiredFields: Array<{ key: string; label: string; secret: boolean; helpUrl?: string }>;
+  auth: string;
+  tools: string[];
+  sourceUrl: string;
+  verified: boolean;
+  verifiedHow: string;
+}
+
+/** One verified source collection of the skills catalog. */
+export interface CatalogSource {
+  id: string;
+  name: string;
+  repo: string;
+  branch: string;
+  homepage: string;
+  license: string;
+  licenseUrl: string;
+  verified: boolean;
+  verifiedHow: string;
+  skillCount: number;
+}
+
+interface SkillsIndexFile {
+  schema: string;
+  version: number;
+  generatedAt: string;
+  total: number;
+  categories: string[];
+  sources: CatalogSource[];
+  skills: CatalogSkill[];
+}
+
+interface ToolsIndexFile {
+  schema: string;
+  version: number;
+  generatedAt: string;
+  total: number;
+  registryCount: number;
+  connectorCount: number;
+  entries: CatalogTool[];
+}
+
+const SKILLS = skillsIndex as unknown as SkillsIndexFile;
+const TOOLS = toolsIndex as unknown as ToolsIndexFile;
+const CONNECTORS = connectorCatalog as unknown as CatalogConnector[];
+
+/** Every skill of the public catalog. */
+export function catalogSkills(): CatalogSkill[] {
+  return SKILLS.skills ?? [];
+}
+
+/** The number of skills in the public catalog. */
+export function catalogSkillCount(): number {
+  return SKILLS.skills?.length ?? 0;
+}
+
+/** The verified source collections of the skills catalog. */
+export function catalogSources(): CatalogSource[] {
+  return SKILLS.sources ?? [];
+}
+
+/** The categories of the skills catalog, with how many skills each has. */
+export function catalogCategories(): Array<{ id: string; label: string; count: number }> {
+  const counts = new Map<string, number>();
+  for (const skill of catalogSkills()) {
+    const key = skill.category || "other";
+    counts.set(key, (counts.get(key) ?? 0) + 1);
+  }
+  return [...counts.entries()]
+    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
+    .map(([id, count]) => ({ id, label: categoryLabel(id), count }));
+}
+
+/** A human readable label for a category id. */
+export function categoryLabel(id: string): string {
+  return id
+    .split(/[-_\s]+/)
+    .filter(Boolean)
+    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
+    .join(" ");
+}
+
+/** The search parameters of the skills catalog. */
+export interface CatalogSearch {
+  query?: string;
+  category?: string;
+  source?: string;
+  limit?: number;
+  offset?: number;
+}
+
+/** The result of a catalog search. */
+export interface CatalogSearchResult {
+  total: number;
+  skills: CatalogSkill[];
+  categories: Array<{ id: string; label: string; count: number }>;
+  sources: CatalogSource[];
+}
+
+/**
+ * Search the skills catalog. The query matches the name, the description and
+ * the source; the results are ordered by relevance (name matches first).
+ */
+export function searchCatalogSkills(search: CatalogSearch = {}): CatalogSearchResult {
+  const query = (search.query ?? "").trim().toLowerCase();
+  const category = (search.category ?? "").trim().toLowerCase();
+  const source = (search.source ?? "").trim().toLowerCase();
+  const limit = Math.min(Math.max(Number(search.limit) || 60, 1), 500);
+  const offset = Math.max(Number(search.offset) || 0, 0);
+
+  const scored: Array<{ skill: CatalogSkill; score: number }> = [];
+  for (const skill of catalogSkills()) {
+    if (category && (skill.category || "other").toLowerCase() !== category) continue;
+    if (source && skill.source.toLowerCase() !== source) continue;
+    if (!query) {
+      scored.push({ skill, score: 0 });
+      continue;
+    }
+    const name = skill.name.toLowerCase();
+    const description = skill.description.toLowerCase();
+    const sourceName = skill.sourceName.toLowerCase();
+    let score = 0;
+    if (name === query) score += 100;
+    if (name.startsWith(query)) score += 40;
+    if (name.includes(query)) score += 20;
+    if (sourceName.includes(query)) score += 8;
+    if (description.includes(query)) score += 5;
+    if (score > 0) scored.push({ skill, score });
+  }
+  scored.sort((a, b) => b.score - a.score || a.skill.name.localeCompare(b.skill.name));
+  return {
+    total: scored.length,
+    skills: scored.slice(offset, offset + limit).map((entry) => entry.skill),
+    categories: catalogCategories(),
+    sources: catalogSources(),
+  };
+}
+
+/** One skill of the public catalog (or null). */
+export function catalogSkill(id: string): CatalogSkill | null {
+  return catalogSkills().find((skill) => skill.id === id) ?? null;
+}
+
+/** The public tool library. */
+export function catalogTools(): CatalogTool[] {
+  return TOOLS.entries ?? [];
+}
+
+/** Search the public tool library. */
+export function searchCatalogTools(search: { query?: string; limit?: number } = {}): CatalogTool[] {
+  const query = (search.query ?? "").trim().toLowerCase();
+  const limit = Math.min(Math.max(Number(search.limit) || 60, 1), 500);
+  if (!query) return catalogTools().slice(0, limit);
+  const scored = catalogTools()
+    .map((entry) => {
+      const name = entry.name.toLowerCase();
+      const description = entry.description.toLowerCase();
+      const publisher = entry.publisher.toLowerCase();
+      let score = 0;
+      if (name === query) score += 100;
+      if (name.startsWith(query)) score += 40;
+      if (name.includes(query)) score += 20;
+      if (publisher.includes(query)) score += 10;
+      if (description.includes(query)) score += 5;
+      return { entry, score };
+    })
+    .filter((item) => item.score > 0)
+    .sort((a, b) => b.score - a.score || a.entry.name.localeCompare(b.entry.name));
+  return scored.slice(0, limit).map((item) => item.entry);
+}
+
+/** The MCP connector catalog. */
+export function catalogConnectors(): CatalogConnector[] {
+  return CONNECTORS;
+}
+
+/** The categories of the connector catalog. */
+export function connectorCategories(): Array<{ id: string; label: string; count: number }> {
+  const counts = new Map<string, number>();
+  for (const connector of CONNECTORS) {
+    counts.set(connector.category, (counts.get(connector.category) ?? 0) + 1);
+  }
+  return [...counts.entries()]
+    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
+    .map(([id, count]) => ({ id, label: categoryLabel(id), count }));
+}
+
+/** One connector of the catalog (or null). */
+export function catalogConnector(id: string): CatalogConnector | null {
+  return CONNECTORS.find((connector) => connector.id === id) ?? null;
+}
