index 000000000..91afd410f
--- /dev/null
+++ b/apps/swarmagents/lib/library/harness-bridge.ts
@@ -0,0 +1,150 @@
+/**
+ * The bridge between the user's library and a run.
+ *
+ * Before a run starts, the library contributes:
+ *
+ *   - the skills assigned to the role (written into the user's VM so Claude
+ *     Code picks them up);
+ *   - the custom tools of the user (written into the VM and wired into the
+ *     run's --mcp-config);
+ *   - the MCP servers the user installed and assigned to the role (wired into
+ *     the run's --mcp-config, with their secrets injected inside the VM).
+ *
+ * Nothing runs in the Next.js process: the servers and the tools are started
+ * by Claude Code inside the user's own VM.
+ */
+
+import { mcpServerWithSecrets } from "./mcp/store";
+import { readLibraryFile, readLibraryState, userToolDir, type DataDirOptions } from "./store";
+import {
+  LIBRARY_TOOLS_SERVER_SOURCE,
+  VM_LIBRARY_DIR,
+  VM_TOOLS_MANIFEST,
+  VM_TOOLS_SERVER,
+  readSkillFile,
+  toolManifest,
+} from "./skills/vm-sync";
+
+/** The name of the MCP server that exposes the user's custom tools. */
+export const LIBRARY_TOOLS_SERVER_NAME = "library";
+
+/** What a run needs from the library. */
+export interface LibraryRunContext {
+  /** The MCP servers to wire into the run's --mcp-config. */
+  extraServers: Record<string, unknown>;
+  /** The files to seed into the user's VM. */
+  extraFiles: Array<{ path: string; content: string }>;
+  /** The note appended to the role's system prompt. */
+  libraryNote: string;
+}
+
+/** The MCP config entry of one user-installed MCP server. */
+export function mcpServerEntry(
+  server: {
+    id: string;
+    transport: "http" | "stdio";
+    url: string;
+    command: string;
+    args: string[];
+    env: Record<string, string>;
+  },
+  secrets: Record<string, string>,
+): Record<string, unknown> {
+  if (server.transport === "http") {
+    const headers: Record<string, string> = {};
+    for (const [name, value] of Object.entries(secrets)) {
+      if (!/^[A-Za-z0-9-]{1,64}$/.test(name)) continue;
+      headers[name] = value;
+    }
+    return { type: "http", url: server.url, ...(Object.keys(headers).length ? { headers } : {}) };
+  }
+  const env: Record<string, string> = { ...server.env };
+  for (const [name, value] of Object.entries(secrets)) {
+    env[name] = value;
+  }
+  return { type: "stdio", command: server.command, args: server.args, env };
+}
+
+/** Build the library context of a run for one role. */
+export function buildLibraryRunContext(
+  userId: string,
+  roleId: string,
+  options: DataDirOptions = {},
+): LibraryRunContext {
+  const state = readLibraryState(userId, options);
+  const extraServers: Record<string, unknown> = {};
+  const extraFiles: Array<{ path: string; content: string }> = [];
+
+  // 1) The skills assigned to the role.
+  const skillIds = state.roleSkills[roleId] ?? [];
+  const skillNames: string[] = [];
+  for (const skillId of skillIds) {
+    const skill = state.skills[skillId];
+    if (!skill) continue;
+    skillNames.push(skill.name);
+    for (const file of skill.files) {
+      const content = readSkillFile(userId, skillId, file.path, options);
+      if (content === null) continue;
+      extraFiles.push({ path: `/workspace/.claude/skills/${skill.id}/${file.path}`, content });
+    }
+  }
+
+  // 2) The custom tools of the user.
+  const tools = Object.values(state.tools);
+  const toolIds = new Set(state.roleTools[roleId] ?? []);
+  const toolNames: string[] = [];
+  for (const tool of tools) {
+    if (!toolIds.has(tool.id)) continue;
+    toolNames.push(tool.name);
+  }
+  if (tools.length > 0) {
+    extraServers[LIBRARY_TOOLS_SERVER_NAME] = {
+      type: "stdio",
+      command: "node",
+      args: [VM_TOOLS_SERVER],
+      env: { SWARM_LIBRARY_TOOLS: VM_TOOLS_MANIFEST },
+    };
+    extraFiles.push({
+      path: VM_TOOLS_MANIFEST,
+      content: JSON.stringify(toolManifest(userId, options), null, 2),
+    });
+    extraFiles.push({ path: VM_TOOLS_SERVER, content: LIBRARY_TOOLS_SERVER_SOURCE });
+    for (const tool of tools) {
+      const source = readToolSourceFor(userId, tool.id, options);
+      if (source === null) continue;
+      extraFiles.push({ path: `${VM_LIBRARY_DIR}/tools/${tool.id}/tool.mjs`, content: source });
+    }
+  }
+
+  // 3) The MCP servers assigned to the role.
+  for (const serverId of state.roleMcpServers[roleId] ?? []) {
+    const server = mcpServerWithSecrets(userId, serverId, options);
+    if (!server) continue;
+    extraServers[server.id] = mcpServerEntry(server, server.secretValues);
+  }
+
+  // 4) The note that tells the agent what the library offers.
+  const notes: string[] = [];
+  if (skillNames.length > 0) {
+    notes.push(
+      `[library] Skills available to you: ${skillNames.join(", ")}. They live in /workspace/.claude/skills and you load one with the Skill tool.`,
+    );
+  }
+  if (toolNames.length > 0) {
+    notes.push(
+      `[library] Custom tools available through the "${LIBRARY_TOOLS_SERVER_NAME}" MCP server: ${toolNames.join(", ")}.`,
+    );
+  }
+  if (tools.length > 0 || skillNames.length > 0) {
+    notes.push(
+      `[library] You can create a tool for yourself: write a Node script to /workspace/.swarm/agent-tools/<name>/tool.mjs that reads its JSON arguments on stdin and prints the result on stdout. It is added to the user's library after this run.`,
+    );
+  }
+
+  return { extraServers, extraFiles, libraryNote: notes.join("\n") };
+}
+
+/** Read the source of one custom tool. */
+function readToolSourceFor(userId: string, toolId: string, options: DataDirOptions = {}): string | null {
+  return readLibraryFile(userToolDir(userId, toolId, options), "tool.mjs");
+}
diff --git a/apps/swarmagents/lib/library/mcp/store.test.ts b/apps/swarmagents/lib/library/mcp/store.test.ts
new file mode 100644
index 000000000..b485410c1
--- /dev/null
+++ b/apps/swarmagents/lib/library/mcp/store.test.ts
@@ -0,0 +1,162 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+import {
+  addMcpServer,
+  isAllowedMcpCommand,
+  isAllowedMcpUrl,
+  listMcpServers,
+  mcpServerWithSecrets,
+  readMcpSecrets,
+  removeMcpServer,
+  updateMcpServer,
+} from "./store";
+import { userLibraryDir } from "../store";
+
+const SECRET = "super-secret-token-value";
+let counter = 0;
+/** A fresh account id so the tests never share state. */
+function account(prefix: string): string {
+  counter += 1;
+  return `${prefix}-${counter}@example.com`;
+}
+
+function tempHome(): string {
+  return fs.mkdtempSync(path.join(os.tmpdir(), "swarm-library-mcp-"));
+}
+
+test("an MCP server is stored per account", () => {
+  const alice = account("alice");
+  const bob = account("bob");
+
+
+  addMcpServer(alice, {
+    name: "My Server",
+    transport: "http",
+    url: "https://example.com/mcp",
+  });
+  assert.equal(listMcpServers(alice).length, 1);
+  assert.equal(listMcpServers(bob).length, 0);
+});
+
+test("secrets are encrypted at rest and never returned to the client", () => {
+  const alice = account("alice");
+  const bob = account("bob");
+
+
+  const home = tempHome();
+  const record = addMcpServer(alice, {
+    name: "GitHub",
+    transport: "http",
+    url: "https://example.com/mcp",
+    secrets: { Authorization: SECRET },
+  });
+  assert.deepEqual(record.secretEnv, ["Authorization"]);
+
+  // The client view never carries the value.
+  const listed = listMcpServers(alice)[0];
+  assert.equal(JSON.stringify(listed).includes(SECRET), false);
+
+  // On disk the value is sealed.
+  const secretsFile = path.join(userLibraryDir(alice), "mcp-secrets.json");
+  const raw = fs.readFileSync(secretsFile, "utf-8");
+  assert.equal(raw.includes(SECRET), false);
+  assert.match(raw, /v1\.[ksf]\./);
+  assert.equal(fs.statSync(secretsFile).mode & 0o777, 0o600);
+
+  // The sealed value only opens for its owner.
+  const sealed = readMcpSecrets(alice)["github"]?.Authorization ?? "";
+  assert.equal(sealed.includes(SECRET), false);
+  const withSecrets = mcpServerWithSecrets(alice, "github");
+  assert.equal(withSecrets?.secretValues.Authorization, SECRET);
+  assert.equal(mcpServerWithSecrets(bob, "github"), null);
+  fs.rmSync(home, { recursive: true, force: true });
+});
+
+test("a server without a valid url is refused", () => {
+  const alice = account("alice");
+
+
+  assert.throws(() =>
+    addMcpServer(alice, { name: "bad", transport: "http", url: "javascript:alert(1)" }),
+  );
+  assert.throws(() =>
+    addMcpServer(alice, { name: "bad", transport: "http", url: "http://example.com/mcp" }),
+  );
+});
+
+test("only https endpoints (and loopback http) are allowed", () => {
+
+
+  assert.equal(isAllowedMcpUrl("https://example.com/mcp"), true);
+  assert.equal(isAllowedMcpUrl("http://localhost:3000/mcp"), true);
+  assert.equal(isAllowedMcpUrl("http://example.com/mcp"), false);
+  assert.equal(isAllowedMcpUrl("file:///etc/passwd"), false);
+});
+
+test("a stdio server needs a safe command", () => {
+  const alice = account("alice");
+
+
+  assert.equal(isAllowedMcpCommand("node"), true);
+  assert.equal(isAllowedMcpCommand("/usr/bin/node"), true);
+  assert.equal(isAllowedMcpCommand("node; rm -rf /"), false);
+  assert.equal(isAllowedMcpCommand("../node"), false);
+  assert.throws(() =>
+    addMcpServer(alice, { name: "bad", transport: "stdio", command: "node; rm -rf /" }),
+  );
+});
+
+test("a stdio server keeps its plain environment but never a secret value", () => {
+  const alice = account("alice");
+
+
+  addMcpServer(alice, {
+    name: "Local",
+    transport: "stdio",
+    command: "node",
+    args: ["server.mjs"],
+    env: { LOG_LEVEL: "info" },
+    secrets: { API_KEY: SECRET },
+  });
+  const record = listMcpServers(alice)[0];
+  assert.deepEqual(record.env, { LOG_LEVEL: "info" });
+  assert.deepEqual(record.secretEnv, ["API_KEY"]);
+  assert.equal(JSON.stringify(record).includes(SECRET), false);
+  const withSecrets = mcpServerWithSecrets(alice, "local");
+  assert.equal(withSecrets?.secretValues.API_KEY, SECRET);
+});
+
+test("updating a server keeps its secrets when none are sent", () => {
+  const alice = account("alice");
+
+
+  addMcpServer(alice, {
+    name: "GitHub",
+    transport: "http",
+    url: "https://example.com/mcp",
+    secrets: { Authorization: SECRET },
+  });
+  const updated = updateMcpServer(alice, "github", { description: "now with a description" });
+  assert.equal(updated.description, "now with a description");
+  assert.deepEqual(updated.secretEnv, ["Authorization"]);
+  assert.equal(mcpServerWithSecrets(alice, "github")?.secretValues.Authorization, SECRET);
+});
+
+test("removing a server removes its secrets", () => {
+  const alice = account("alice");
+
+
+  addMcpServer(alice, {
+    name: "GitHub",
+    transport: "http",
+    url: "https://example.com/mcp",
+    secrets: { Authorization: SECRET },
+  });
+  assert.equal(removeMcpServer(alice, "github"), true);
+  assert.equal(listMcpServers(alice).length, 0);
+  assert.deepEqual(readMcpSecrets(alice)["github"], undefined);
+});
diff --git a/apps/swarmagents/lib/library/mcp/store.ts b/apps/swarmagents/lib/library/mcp/store.ts
new file mode 100644
index 000000000..ee3b94f9b
--- /dev/null
+++ b/apps/swarmagents/lib/library/mcp/store.ts
@@ -0,0 +1,309 @@
+/**
+ * Per-user MCP servers.
+ *
+ * A user can add MCP servers to their library: one of the verified public
+ * connectors, or a custom one (a remote HTTP endpoint or a stdio program that
+ * runs inside their own VM).
+ *
+ * The server record lives in the user's library state; the credentials live in
+ * a separate `mcp-secrets.json` inside the same account directory and are
+ * sealed with AES-256-GCM (see lib/providers/secret-box.ts). The API never
+ * returns a secret value — only the names of the secret variables.
+ */
+
+import fs from "node:fs";
+import path from "node:path";
+
+import {
+  LibraryError,
+  emptyLibraryState,
+  libraryStatePath,
+  readLibraryState,
+  userLibraryDir,
+  writeLibraryState,
+  type DataDirOptions,
+  type McpServerRecord,
+  type McpTransport,
+} from "../store";
+import { openSecret, sealSecret } from "../store";
+import { slugifySkillName } from "../skills/format";
+
+export const MCP_SECRETS_FILE = "mcp-secrets.json";
+
+/** The maximum size of one MCP server's URL/command definition. */
+const MAX_URL_LENGTH = 2048;
+const MAX_ARGS = 16;
+const MAX_ENV_VARS = 32;
+
+/** The sealed secrets of one MCP server. */
+export type McpSecrets = Record<string, string>;
+
+/** The path of one user's MCP secrets file. */
+export function mcpSecretsPath(userId: string, options: DataDirOptions = {}): string {
+  return path.join(userLibraryDir(userId, options), MCP_SECRETS_FILE);
+}
+
+/** Read one user's sealed MCP secrets (never throws). */
+export function readMcpSecrets(userId: string, options: DataDirOptions = {}): Record<string, McpSecrets> {
+  const file = mcpSecretsPath(userId, options);
+  if (!fs.existsSync(file)) return {};
+  try {
+    const parsed = JSON.parse(fs.readFileSync(file, "utf-8")) as Record<string, unknown>;
+    const out: Record<string, McpSecrets> = {};
+    for (const [serverId, value] of Object.entries(parsed ?? {})) {
+      if (!value || typeof value !== "object" || Array.isArray(value)) continue;
+      const secrets: McpSecrets = {};
+      for (const [name, sealed] of Object.entries(value as Record<string, unknown>)) {
+        if (typeof sealed === "string") secrets[name] = sealed;
+      }
+      out[serverId] = secrets;
+    }
+    return out;
+  } catch (error) {
+    console.error(`[swarm-library] ignoring unreadable MCP secrets file ${file}: ${String(error)}`);
+    return {};
+  }
+}
+
+/** Write one user's sealed MCP secrets (atomic, mode 600). */
+export function writeMcpSecrets(
+  userId: string,
+  secrets: Record<string, McpSecrets>,
+  options: DataDirOptions = {},
+): void {
+  const file = mcpSecretsPath(userId, options);
+  fs.mkdirSync(path.dirname(file), { recursive: true, mode: 0o700 });
+  const tmp = `${file}.tmp.${process.pid}.${Date.now()}`;
+  fs.writeFileSync(tmp, `${JSON.stringify(secrets, null, 2)}\n`, { encoding: "utf-8", mode: 0o600 });
+  fs.renameSync(tmp, file);
+  try {
+    fs.chmodSync(file, 0o600);
+  } catch {
+    /* best effort */
+  }
+}
+
+/** Is this a plausible remote MCP endpoint? */
+export function isAllowedMcpUrl(raw: string): boolean {
+  let url: URL;
+  try {
+    url = new URL(raw);
+  } catch {
+    return false;
+  }
+  if (url.protocol !== "https:") {
+    // Plain http is only allowed for loopback (a server inside the user's VM).
+    return url.protocol === "http:" && ["localhost", "127.0.0.1", "::1"].includes(url.hostname);
+  }
+  return true;
+}
+
+/** Is this a plausible stdio command (no shell, no path tricks)? */
+export function isAllowedMcpCommand(raw: string): boolean {
+  return /^[A-Za-z0-9._@:/-]{1,120}$/.test(raw) && !raw.includes("..") && !raw.startsWith("-");
+}
+
+/** The input accepted when adding or updating an MCP server. */
+export interface McpServerInput {
+  id?: string;
+  name: string;
+  description?: string;
+  transport: McpTransport;
+  url?: string;
+  command?: string;
+  args?: string[];
+  env?: Record<string, string>;
+  secrets?: Record<string, string>;
+  tools?: string[];
+  sourceUrl?: string;
+  verified?: boolean;
+}
+
+function validateInput(input: McpServerInput): void {
+  if (!input || typeof input !== "object") {
+    throw new LibraryError("Invalid MCP server definition.", 400, "invalid_request");
+  }
+  if (!input.name || input.name.trim().length === 0 || input.name.length > 80) {
+    throw new LibraryError("The MCP server needs a name.", 400, "invalid_name");
+  }
+  if (input.transport === "http") {
+    const url = (input.url ?? "").trim();
+    if (!url || url.length > MAX_URL_LENGTH || !isAllowedMcpUrl(url)) {
+      throw new LibraryError(
+        "The MCP server needs a valid https:// endpoint (http:// is only allowed for loopback).",
+        400,
+        "invalid_url",
+      );
+    }
+  } else if (input.transport === "stdio") {
+    const command = (input.command ?? "").trim();
+    if (!command || !isAllowedMcpCommand(command)) {
+      throw new LibraryError("The MCP server needs a valid command to run inside your VM.", 400, "invalid_command");
+    }
+    const args = input.args ?? [];
+    if (args.length > MAX_ARGS) {
+      throw new LibraryError("Too many command arguments.", 400, "invalid_command");
+    }
+    for (const arg of args) {
+      if (typeof arg !== "string" || arg.length > 512 || /[\x00-\x1f]/.test(arg)) {
+        throw new LibraryError("Invalid command argument.", 400, "invalid_command");
+      }
+    }
+  } else {
+    throw new LibraryError("Unknown MCP transport.", 400, "invalid_transport");
+  }
+  const env = input.env ?? {};
+  if (Object.keys(env).length > MAX_ENV_VARS) {
+    throw new LibraryError("Too many environment variables.", 400, "invalid_env");
+  }
+  for (const [key, value] of Object.entries(env)) {
+    if (!/^[A-Za-z_][A-Za-z0-9_]{0,64}$/.test(key) || typeof value !== "string" || value.length > 4096) {
+      throw new LibraryError("Invalid environment variable.", 400, "invalid_env");
+    }
+  }
+  const secrets = input.secrets ?? {};
+  for (const [key, value] of Object.entries(secrets)) {
+    if (!/^[A-Za-z_][A-Za-z0-9_]{0,64}$/.test(key) || typeof value !== "string" || value.length > 8192) {
+      throw new LibraryError("Invalid secret.", 400, "invalid_secret");
+    }
+  }
+}
+
+/** Add (or replace) an MCP server for one user. */
+export function addMcpServer(
+  userId: string,
+  input: McpServerInput,
+  options: DataDirOptions = {},
+): McpServerRecord {
+  validateInput(input);
+  const state = readLibraryState(userId, options);
+  const id = slugifySkillName(input.id || input.name);
+  if (!id) throw new LibraryError("The MCP server needs a name.", 400, "invalid_name");
+  const now = Date.now();
+  const record: McpServerRecord = {
+    id,
+    name: input.name.trim(),
+    description: (input.description ?? "").slice(0, 500),
+    transport: input.transport,
+    url: input.transport === "http" ? (input.url ?? "").trim() : "",
+    command: input.transport === "stdio" ? (input.command ?? "").trim() : "",
+    args: input.transport === "stdio" ? (input.args ?? []).slice(0, MAX_ARGS) : [],
+    env: input.transport === "stdio" ? { ...(input.env ?? {}) } : {},
+    secretEnv:
+      input.secrets !== undefined
+        ? Object.keys(input.secrets)
+        : (state.mcpServers[id]?.secretEnv ?? []),
+    tools: (input.tools ?? []).slice(0, 100),
+    sourceUrl: (input.sourceUrl ?? "").slice(0, MAX_URL_LENGTH),
+    verified: input.verified === true,
+    createdAt: state.mcpServers[id]?.createdAt ?? now,
+    updatedAt: now,
+  };
+  state.mcpServers[id] = record;
+  writeLibraryState(userId, state, options);
+
+  // The secrets are only replaced when the caller sends new ones: an update
+  // without secrets keeps the stored (encrypted) values.
+  if (input.secrets !== undefined) {
+    const secrets = readMcpSecrets(userId, options);
+    const sealed: McpSecrets = {};
+    for (const [name, value] of Object.entries(input.secrets)) {
+      sealed[name] = sealSecret(value, userId, `library:mcp:${id}:${name}`, options);
+    }
+    secrets[id] = sealed;
+    writeMcpSecrets(userId, secrets, options);
+  }
+  return record;
+}
+
+/** Update an existing MCP server (only the given fields change). */
+export function updateMcpServer(
+  userId: string,
+  id: string,
+  patch: Partial<McpServerInput>,
+  options: DataDirOptions = {},
+): McpServerRecord {
+  const state = readLibraryState(userId, options);
+  const current = state.mcpServers[id];
+  if (!current) throw new LibraryError("Unknown MCP server.", 404, "not_found");
+  const merged: McpServerInput = {
+    id,
+    name: patch.name ?? current.name,
+    description: patch.description ?? current.description,
+    transport: patch.transport ?? current.transport,
+    url: patch.url ?? current.url,
+    command: patch.command ?? current.command,
+    args: patch.args ?? current.args,
+    env: patch.env ?? current.env,
+    secrets: patch.secrets,
+    tools: patch.tools ?? current.tools,
+    sourceUrl: patch.sourceUrl ?? current.sourceUrl,
+    verified: patch.verified ?? current.verified,
+  };
+  const record = addMcpServer(userId, merged, options);
+  if (patch.secrets === undefined) {
+    // Keep the existing secrets when the update does not carry new ones.
+    const previous = readMcpSecrets(userId, options)[id] ?? {};
+    if (Object.keys(previous).length > 0) record.secretEnv = Object.keys(previous);
+  }
+  return record;
+}
+
+/** Remove an MCP server (and its secrets). */
+export function removeMcpServer(userId: string, id: string, options: DataDirOptions = {}): boolean {
+  const state = readLibraryState(userId, options);
+  if (!state.mcpServers[id]) return false;
+  delete state.mcpServers[id];
+  for (const [roleId, ids] of Object.entries(state.roleMcpServers)) {
+    const next = ids.filter((serverId) => serverId !== id);
+    if (next.length !== ids.length) state.roleMcpServers[roleId] = next;
+  }
+  writeLibraryState(userId, state, options);
+  const secrets = readMcpSecrets(userId, options);
+  if (secrets[id]) {
+    delete secrets[id];
+    writeMcpSecrets(userId, secrets, options);
+  }
+  return true;
+}
+
+/** The MCP servers one user has added (no secret values). */
+export function listMcpServers(userId: string, options: DataDirOptions = {}): McpServerRecord[] {
+  const state = readLibraryState(userId, options);
+  return Object.values(state.mcpServers).sort((a, b) => a.name.localeCompare(b.name));
+}
+
+/**
+ * The full definition of one MCP server, with the secrets opened. Server
+ * side only: never send the result to a client.
+ */
+export function mcpServerWithSecrets(
+  userId: string,
+  id: string,
+  options: DataDirOptions = {},
+): (McpServerRecord & { secretValues: Record<string, string> }) | null {
+  const state = readLibraryState(userId, options);
+  const record = state.mcpServers[id];
+  if (!record) return null;
+  const secrets = readMcpSecrets(userId, options)[id] ?? {};
+  const secretValues: Record<string, string> = {};
+  for (const [name, sealed] of Object.entries(secrets)) {
+    try {
+      secretValues[name] = openSecret(sealed, userId, `library:mcp:${id}:${name}`, options);
+    } catch (error) {
+      console.error(`[swarm-library] could not open a secret for MCP server ${id}: ${String(error)}`);
+    }
+  }
+  return { ...record, secretValues };
+}
+
+/** Reset the library of one user (used by tests and by "clear library"). */
+export function clearLibrary(userId: string, options: DataDirOptions = {}): void {
+  writeLibraryState(userId, emptyLibraryState(userId), options);
+  const file = libraryStatePath(userId, options);
+  try {
+    fs.chmodSync(file, 0o600);
+  } catch {
+    /* best effort */
+  }
+}
diff --git a/apps/swarmagents/lib/library/skills/format.test.ts b/apps/swarmagents/lib/library/skills/format.test.ts
new file mode 100644
index 000000000..6f03e20fc
--- /dev/null
+++ b/apps/swarmagents/lib/library/skills/format.test.ts
@@ -0,0 +1,142 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+
+import {
+  SKILL_LIMITS,
+  findSkillFile,
+  isValidSkillName,
+  parseFrontmatter,
+  parseSkillDocument,
+  renderSkillDocument,
+  skillSummary,
+  slugifySkillName,
+  validateSkill,
+  SkillFormatError,
+} from "./format";
+
+const GOOD_SKILL = `---
+name: pdf-tools
+description: Read, split and merge PDF files inside the agent VM.
+license: MIT
+---
+
+# PDF tools
+
+Use this skill when the user asks about PDFs.
+
+\`\`\`bash
+python scripts/merge.py a.pdf b.pdf
+\`\`\`
+`;
+
+test("the frontmatter of a SKILL.md is parsed", () => {
+  const document = parseSkillDocument(GOOD_SKILL);
+  assert.equal(document.name, "pdf-tools");
+  assert.equal(document.description, "Read, split and merge PDF files inside the agent VM.");
+  assert.equal(document.license, "MIT");
+  assert.match(document.body, /# PDF tools/);
+  assert.equal(document.body.includes("---"), false);
+});
+
+test("frontmatter values may be quoted or span several lines", () => {
+  const { fields } = parseFrontmatter(`---
+name: "quoted-name"
+description: |
+  A long description
+  over two lines.
+allowed-tools: Read, Bash
+---
+body
+`);
+  assert.equal(fields.name, "quoted-name");
+  assert.match(fields.description, /A long description/);
+  assert.match(fields.description, /over two lines/);
+  assert.equal(fields["allowed-tools"], "Read, Bash");
+});
+
+test("skill names are lowercase slugs", () => {
+  assert.equal(isValidSkillName("pdf-tools"), true);
+  assert.equal(isValidSkillName("pdf_tools"), false);
+  assert.equal(isValidSkillName("PDF-Tools"), false);
+  assert.equal(isValidSkillName(""), false);
+  assert.equal(isValidSkillName("a".repeat(65)), false);
+  assert.equal(slugifySkillName("PDF Tools!"), "pdf-tools");
+});
+
+test("a well formed skill validates", () => {
+  const validated = validateSkill({ "SKILL.md": GOOD_SKILL });
+  assert.equal(validated.name, "pdf-tools");
+  assert.equal(validated.id, "pdf-tools");
+  assert.equal(validated.description, "Read, split and merge PDF files inside the agent VM.");
+});
+
+test("a skill without a SKILL.md is refused", () => {
+  assert.throws(
+    () => validateSkill({ "readme.md": "# nope" }),
+    (error: unknown) => error instanceof SkillFormatError && error.code === "missing_skill_md",
+  );
+});
+
+test("a skill without frontmatter is refused", () => {
+  assert.throws(
+    () => validateSkill({ "SKILL.md": "# just markdown" }),
+    (error: unknown) => error instanceof SkillFormatError && error.code === "invalid_frontmatter",
+  );
+});
+
+test("a skill without a description is refused", () => {
+  assert.throws(
+    () => validateSkill({ "SKILL.md": "---\nname: x\n---\nbody" }),
+    (error: unknown) => error instanceof SkillFormatError && error.code === "missing_description",
+  );
+});
+
+test("a skill with an illegal name is refused", () => {
+  assert.throws(
+    () => validateSkill({ "SKILL.md": "---\nname: Not A Slug\ndescription: d\n---\nbody" }),
+    (error: unknown) => error instanceof SkillFormatError && error.code === "invalid_name",
+  );
+});
+
+test("the file count and size caps are enforced", () => {
+  const many: Record<string, string> = { "SKILL.md": GOOD_SKILL };
+  for (let i = 0; i < SKILL_LIMITS.maxFiles + 5; i += 1) many[`f${i}.md`] = "x";
+  assert.throws(
+    () => validateSkill(many),
+    (error: unknown) => error instanceof SkillFormatError && error.code === "too_many_files",
+  );
+
+  const big: Record<string, string> = { "SKILL.md": GOOD_SKILL };
+  big["big.txt"] = "x".repeat(SKILL_LIMITS.maxFileBytes + 10);
+  assert.throws(
+    () => validateSkill(big),
+    (error: unknown) => error instanceof SkillFormatError && error.code === "too_large",
+  );
+});
+
+test("the SKILL.md is found in a nested folder", () => {
+  assert.equal(findSkillFile({ "skills/pdf/SKILL.md": "x" }), "skills/pdf/SKILL.md");
+  assert.equal(findSkillFile({ "SKILL.md": "x" }), "SKILL.md");
+  assert.equal(findSkillFile({ "other.md": "x" }), null);
+});
+
+test("a document renders back into a SKILL.md", () => {
+  const rendered = renderSkillDocument({
+    name: "my-skill",
+    description: "Does a thing.",
+    license: "MIT",
+    body: "# Body\n\nText.",
+  });
+  const parsed = parseSkillDocument(rendered);
+  assert.equal(parsed.name, "my-skill");
+  assert.equal(parsed.description, "Does a thing.");
+  assert.equal(parsed.license, "MIT");
+  assert.match(parsed.body, /# Body/);
+});
+
+test("the summary strips code blocks", () => {
+  const document = parseSkillDocument(GOOD_SKILL);
+  const summary = skillSummary(document);
+  assert.equal(summary.includes("python scripts/merge.py"), false);
+  assert.match(summary, /Use this skill/);
+});
diff --git a/apps/swarmagents/lib/library/skills/format.ts b/apps/swarmagents/lib/library/skills/format.ts
new file mode 100644
index 000000000..5d31c205d
--- /dev/null
+++ b/apps/swarmagents/lib/library/skills/format.ts
@@ -0,0 +1,305 @@
+/**
+ * The Agent Skills file format.
+ *
+ * A skill is a folder that contains a `SKILL.md` file with YAML frontmatter
+ * (`name` + `description`) followed by a markdown body. Optional `scripts/`,
+ * `references/` and `assets/` folders live next to it.
+ *
+ * This module is dependency-free and pure: it parses and validates text, it
+ * never touches the filesystem or the network. The importer uses it to decide
+ * whether an untrusted folder is a well-formed skill, and the installer uses
+ * it to write the skill back out in a canonical shape.
+ *
+ * Everything a skill can contain is untrusted: the body and every companion
+ * file may contain scripts. Callers must show the content to the user before
+ * installing it (see lib/library/skills/import.ts).
+ */
+
+/** Hard caps applied to every imported skill. */
+export const SKILL_LIMITS = {
+  /** Maximum size of SKILL.md itself. */
+  maxSkillFileBytes: 256 * 1024,
+  /** Maximum size of a single companion file. */
+  maxFileBytes: 1024 * 1024,
+  /** Maximum size of the whole skill folder. */
+  maxSkillBytes: 4 * 1024 * 1024,
+  /** Maximum number of files in one skill folder. */
+  maxFiles: 200,
+  /** Maximum length of the frontmatter description. */
+  maxDescriptionLength: 1024,
+  /** Maximum length of a skill name. */
+  maxNameLength: 64,
+} as const;
+
+/** The file that must exist in a skill folder. */
+export const SKILL_ENTRY_FILE = "SKILL.md";
+
+/** A parsed SKILL.md: frontmatter fields plus the markdown body. */
+export interface SkillDocument {
+  /** The `name` from the frontmatter (may be empty when the file has none). */
+  name: string;
+  /** The `description` from the frontmatter. */
+  description: string;
+  /** The optional `license` from the frontmatter. */
+  license: string;
+  /** The optional `version` from the frontmatter. */
+  version: string;
+  /** The optional `allowed-tools` from the frontmatter (comma separated). */
+  allowedTools: string[];
+  /** Any other frontmatter keys, verbatim. */
+  extra: Record<string, string>;
+  /** The markdown body (frontmatter removed). */
+  body: string;
+  /** The raw file content. */
+  raw: string;
+}
+
+/** Why a skill folder was rejected. */
+export type SkillFormatErrorCode =
+  | "missing_skill_md"
+  | "invalid_frontmatter"
+  | "invalid_name"
+  | "missing_description"
+  | "too_large"
+  | "too_many_files"
+  | "unsafe_path";
+
+export class SkillFormatError extends Error {
+  readonly code: SkillFormatErrorCode;
+
+  constructor(code: SkillFormatErrorCode, message: string) {
+    super(message);
+    this.name = "SkillFormatError";
+    this.code = code;
+  }
+}
+
+/** Is this a legal skill name (lowercase slug, per the Agent Skills spec)? */
+export function isValidSkillName(name: string): boolean {
+  if (!name || name.length > SKILL_LIMITS.maxNameLength) return false;
+  return /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(name);
+}
+
+/** Turn any title into a legal skill name (slug). */
+export function slugifySkillName(raw: string): string {
+  const base = (raw || "")
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, "-")
+    .replace(/^-+|-+$/g, "")
+    .slice(0, SKILL_LIMITS.maxNameLength)
+    .replace(/-+$/g, "");
+  return base || "skill";
+}
+
+/**
+ * Parse the YAML-ish frontmatter of a SKILL.md.
+ *
+ * A deliberately small subset is supported: top level `key: value` pairs,
+ * quoted values, and `|`/`>` block scalars. Nested maps are kept as their
+ * raw text so nothing is silently dropped from the preview.
+ */
+export function parseFrontmatter(raw: string): { fields: Record<string, string>; body: string } {
+  const text = raw.replace(/^\uFEFF/, "");
+  const match = /^---[ \t]*\r?\n([\s\S]*?)\r?\n---[ \t]*(?:\r?\n|$)/.exec(text);
+  if (!match) return { fields: {}, body: text };
+  const fields = parseFrontmatterFields(match[1] ?? "");
+  const body = text.slice(match[0].length);
+  return { fields, body };
+}
+
+/** Parse the key/value block of a frontmatter section. */
+export function parseFrontmatterFields(block: string): Record<string, string> {
+  const fields: Record<string, string> = {};
+  const lines = block.split(/\r?\n/);
+  for (let i = 0; i < lines.length; i += 1) {
+    const line = lines[i] ?? "";
+    if (!line.trim() || line.trimStart().startsWith("#")) continue;
+    const sep = line.indexOf(":");
+    if (sep <= 0) continue;
+    const key = line.slice(0, sep).trim();
+    if (!/^[A-Za-z0-9_.-]+$/.test(key)) continue;
+    let value = line.slice(sep + 1).trim();
+    if (value === "|" || value === ">" || value === "|-" || value === ">-") {
+      const chunk: string[] = [];
+      let j = i + 1;
+      for (; j < lines.length; j += 1) {
+        const next = lines[j] ?? "";
+        if (next.trim() === "") {
+          chunk.push("");
+          continue;
+        }
+        if (!/^\s/.test(next)) break;
+        chunk.push(next.trim());
+      }
+      value = value.startsWith("|") ? chunk.join("\n") : chunk.join(" ");
+      i = j - 1;
+    }
+    value = unquote(value);
+    fields[key] = value;
+  }
+  return fields;
+}
+
+function unquote(value: string): string {
+  if (value.length >= 2) {
+    const first = value[0];
+    const last = value[value.length - 1];
+    if ((first === '"' && last === '"') || (first === "'" && last === "'")) {
+      return value.slice(1, -1);
+    }
+  }
+  // Strip a trailing comment on an unquoted scalar.
+  const hash = value.indexOf(" #");
+  if (hash > 0) return value.slice(0, hash).trim();
+  return value;
+}
+
+/** Parse a SKILL.md into its frontmatter fields and body. */
+export function parseSkillDocument(raw: string): SkillDocument {
+  const { fields, body } = parseFrontmatter(raw);
+  const known = new Set(["name", "description", "license", "version", "allowed-tools", "allowed_tools"]);
+  const extra: Record<string, string> = {};
+  for (const [key, value] of Object.entries(fields)) {
+    if (!known.has(key)) extra[key] = value;
+  }
+  const allowed = (fields["allowed-tools"] ?? fields["allowed_tools"] ?? "")
+    .split(",")
+    .map((part) => part.trim())
+    .filter(Boolean);
+  return {
+    name: (fields.name ?? "").trim(),
+    description: (fields.description ?? "").trim(),
+    license: (fields.license ?? "").trim(),
+    version: (fields.version ?? "").trim(),
+    allowedTools: allowed,
+    extra,
+    body,
+    raw,
+  };
+}
+
+/** A skill document plus the checks it passed. */
+export interface ValidatedSkill {
+  document: SkillDocument;
+  /** The skill id (the folder name inside the user's library). */
+  id: string;
+  /** The name that will be shown to the user. */
+  name: string;
+  /** The description that will be shown to the user. */
+  description: string;
+}
+
+/**
+ * Validate a SKILL.md and the skill folder it belongs to.
+ *
+ * Throws a SkillFormatError when the folder cannot be installed: no SKILL.md,
+ * no frontmatter, an illegal name, a missing description, or a folder over the
+ * size/file-count caps.
+ */
+export function validateSkill(
+  files: Record<string, string>,
+  options: { id?: string; totalBytes?: number } = {},
+): ValidatedSkill {
+  const skillPath = findSkillFile(files);
+  if (!skillPath) {
+    throw new SkillFormatError("missing_skill_md", "The folder has no SKILL.md file.");
+  }
+  const raw = files[skillPath] ?? "";
+  const bytes = Buffer.byteLength(raw, "utf-8");
+  if (bytes > SKILL_LIMITS.maxSkillFileBytes) {
+    throw new SkillFormatError("too_large", "SKILL.md is larger than the 256 KB limit.");
+  }
+  const entries = Object.entries(files);
+  if (entries.length > SKILL_LIMITS.maxFiles) {
+    throw new SkillFormatError(
+      "too_many_files",
+      `The skill has ${entries.length} files; the limit is ${SKILL_LIMITS.maxFiles}.`,
+    );
+  }
+  for (const [file, content] of entries) {
+    const size = Buffer.byteLength(content, "utf-8");
+    if (size > SKILL_LIMITS.maxFileBytes) {
+      throw new SkillFormatError(
+        "too_large",
+        `${file} is larger than the ${Math.round(SKILL_LIMITS.maxFileBytes / 1024)} KB file limit.`,
+      );
+    }
+  }
+  let total = options.totalBytes ?? 0;
+  if (!options.totalBytes) {
+    for (const [, content] of entries) total += Buffer.byteLength(content, "utf-8");
+  }
+  if (total > SKILL_LIMITS.maxSkillBytes) {
+    throw new SkillFormatError("too_large", "The skill is larger than the 4 MB limit.");
+  }
+
+  const document = parseSkillDocument(raw);
+  if (!document.name && !document.description) {
+    throw new SkillFormatError(
+      "invalid_frontmatter",
+      "SKILL.md has no frontmatter. Add `name:` and `description:` to the YAML header.",
+    );
+  }
+  const name = document.name || slugifySkillName(options.id || "skill");
+  if (!isValidSkillName(name)) {
+    throw new SkillFormatError(
+      "invalid_name",
+      `Skill name "${name}" is invalid. Use lowercase letters, digits and dashes.`,
+    );
+  }
+  if (!document.description) {
+    throw new SkillFormatError("missing_description", "SKILL.md has no description.");
+  }
+  if (document.description.length > SKILL_LIMITS.maxDescriptionLength) {
+    throw new SkillFormatError(
+      "invalid_frontmatter",
+      `The description is longer than ${SKILL_LIMITS.maxDescriptionLength} characters.`,
+    );
+  }
+  return {
+    document,
+    id: options.id ? slugifySkillName(options.id) : name,
+    name,
+    description: document.description,
+  };
+}
+
+/**
+ * Find the SKILL.md inside a folder map. A map may be keyed by the full
+ * relative path (`skills/pdf/SKILL.md`) or by the file name alone.
+ */
+export function findSkillFile(files: Record<string, string>): string | null {
+  const direct = Object.keys(files).find((path) => path === SKILL_ENTRY_FILE);
+  if (direct) return direct;
+  const matches = Object.keys(files)
+    .filter((path) => path.toLowerCase().endsWith(`/${SKILL_ENTRY_FILE.toLowerCase()}`))
+    .sort((a, b) => a.length - b.length);
+  return matches[0] ?? null;
+}
+
+/** Render a SKILL.md with frontmatter from a document's fields. */
+export function renderSkillDocument(fields: {
+  name: string;
+  description: string;
+  license?: string;
+  version?: string;
+  body: string;
+}): string {
+  const lines = ["---", `name: ${fields.name}`, `description: ${fields.description}`];
+  if (fields.license) lines.push(`license: ${fields.license}`);
+  if (fields.version) lines.push(`version: ${fields.version}`);
+  lines.push("---", "");
+  const body = fields.body.replace(/^\n+/, "");
+  return `${lines.join("\n")}\n${body}`.replace(/\n+$/, "\n");
+}
+
+/** The first paragraph of a skill body, trimmed for list previews. */
+export function skillSummary(document: SkillDocument, maxLength = 240): string {
+  const text = document.body
+    .replace(/```[\s\S]*?```/g, " ")
+    .replace(/[#>*_`\-]+/g, " ")
+    .replace(/\s+/g, " ")
+    .trim();
+  if (text.length <= maxLength) return text;
+  return `${text.slice(0, maxLength - 1).trimEnd()}…`;
+}
