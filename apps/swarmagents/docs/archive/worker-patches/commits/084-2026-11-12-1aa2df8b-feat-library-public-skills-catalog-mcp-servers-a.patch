+/**
+ * The user's library: installed skills, MCP servers and custom tools.
+ *
+ * GET /api/library
+ */
+
+import { NextResponse } from "next/server";
+
+import { NO_STORE, libraryErrorResponse, libraryOwner, unauthorized } from "../../../lib/library/api";
+import {
+  listInstalledSkills,
+  listInstalledTools,
+  readLibraryState,
+} from "../../../lib/library/store";
+import { listMcpServers } from "../../../lib/library/mcp/store";
+import { catalogSkillCount } from "../../../lib/library/catalog";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+export async function GET(request: Request): Promise<NextResponse> {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    const state = readLibraryState(owner);
+    const skills = listInstalledSkills(owner);
+    const mcpServers = listMcpServers(owner);
+    const tools = listInstalledTools(owner);
+    return NextResponse.json(
+      {
+        skills,
+        mcpServers,
+        tools,
+        roleAssignments: {
+          skills: state.roleSkills,
+          mcpServers: state.roleMcpServers,
+          tools: state.roleTools,
+        },
+        catalog: { skills: catalogSkillCount() },
+      },
+      { headers: NO_STORE },
+    );
+  } catch (error) {
+    return libraryErrorResponse(error);
+  }
+}
