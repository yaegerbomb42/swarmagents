@@ -0,0 +1,242 @@
+/**
+ * A small, defensive ZIP reader for skill uploads.
+ *
+ * Skill archives come from the outside world, so the reader is written to be
+ * paranoid:
+ *
+ *   - no path may escape the archive root (`..`, absolute paths, drive
+ *     letters, backslashes) — the classic "zip slip";
+ *   - symlinks and other non-regular entries are refused;
+ *   - entry count, per-entry size, total size and the compression ratio are
+ *     capped, so a zip bomb cannot exhaust the server;
+ *   - only "stored" and "deflate" entries are supported (no zip64, no
+ *     encryption).
+ *
+ * The reader is dependency-free: zlib does the inflate.
+ */
+
+import zlib from "node:zlib";
+
+/** Caps applied to every uploaded archive. */
+export const ZIP_LIMITS = {
+  /** Maximum number of entries in the archive. */
+  maxEntries: 500,
+  /** Maximum size of one extracted file. */
+  maxFileBytes: 1024 * 1024,
+  /** Maximum total size of all extracted files. */
+  maxTotalBytes: 8 * 1024 * 1024,
+  /** Maximum size of the uploaded archive itself. */
+  maxArchiveBytes: 16 * 1024 * 1024,
+  /** Maximum expansion factor (uncompressed / compressed). */
+  maxRatio: 150,
+} as const;
+
+/** Why an archive was refused. */
+export type ZipErrorCode =
+  | "not_a_zip"
+  | "too_many_entries"
+  | "too_large"
+  | "unsafe_path"
+  | "unsupported"
+  | "corrupt";
+
+export class ZipError extends Error {
+  readonly code: ZipErrorCode;
+
+  constructor(code: ZipErrorCode, message: string) {
+    super(message);
+    this.name = "ZipError";
+    this.code = code;
+  }
+}
+
+interface ZipEntry {
+  name: string;
+  isDirectory: boolean;
+  uncompressedSize: number;
+  compressedSize: number;
+  method: number;
+  localHeaderOffset: number;
+  externalAttributes: number;
+  flags: number;
+}
+
+const EOCD_SIGNATURE = 0x06054b50;
+const CENTRAL_SIGNATURE = 0x02014b50;
+const LOCAL_SIGNATURE = 0x04034b50;
+
+/** Read the central directory of a zip archive. */
+export function readZipEntries(buffer: Buffer): ZipEntry[] {
+  if (buffer.length < 22) throw new ZipError("not_a_zip", "The file is not a zip archive.");
+  let eocd = -1;
+  const min = Math.max(0, buffer.length - 22 - 0xffff);
+  for (let i = buffer.length - 22; i >= min; i -= 1) {
+    if (buffer.readUInt32LE(i) === EOCD_SIGNATURE) {
+      eocd = i;
+      break;
+    }
+  }
+  if (eocd < 0) throw new ZipError("not_a_zip", "The file is not a zip archive.");
+  const entryCount = buffer.readUInt16LE(eocd + 10);
+  const centralSize = buffer.readUInt32LE(eocd + 12);
+  const centralOffset = buffer.readUInt32LE(eocd + 16);
+  if (centralOffset === 0xffffffff || centralSize === 0xffffffff) {
+    throw new ZipError("unsupported", "Zip64 archives are not supported.");
+  }
+  if (entryCount > ZIP_LIMITS.maxEntries) {
+    throw new ZipError(
+      "too_many_entries",
+      `The archive has ${entryCount} entries; the limit is ${ZIP_LIMITS.maxEntries}.`,
+    );
+  }
+  const entries: ZipEntry[] = [];
+  let offset = centralOffset;
+  for (let i = 0; i < entryCount; i += 1) {
+    if (offset + 46 > buffer.length || buffer.readUInt32LE(offset) !== CENTRAL_SIGNATURE) {
+      throw new ZipError("corrupt", "The zip archive is corrupt.");
+    }
+    const flags = buffer.readUInt16LE(offset + 8);
+    const method = buffer.readUInt16LE(offset + 10);
+    const compressedSize = buffer.readUInt32LE(offset + 20);
+    const uncompressedSize = buffer.readUInt32LE(offset + 24);
+    const nameLength = buffer.readUInt16LE(offset + 28);
+    const extraLength = buffer.readUInt16LE(offset + 30);
+    const commentLength = buffer.readUInt16LE(offset + 32);
+    const externalAttributes = buffer.readUInt32LE(offset + 38);
+    const localHeaderOffset = buffer.readUInt32LE(offset + 42);
+    const name = buffer.subarray(offset + 46, offset + 46 + nameLength).toString("utf-8");
+    if (compressedSize === 0xffffffff || uncompressedSize === 0xffffffff || localHeaderOffset === 0xffffffff) {
+      throw new ZipError("unsupported", "Zip64 archives are not supported.");
+    }
+    if ((flags & 0x1) !== 0) {
+      throw new ZipError("unsupported", "Encrypted zip archives are not supported.");
+    }
+    entries.push({
+      name,
+      isDirectory: name.endsWith("/"),
+      uncompressedSize,
+      compressedSize,
+      method,
+      localHeaderOffset,
+      externalAttributes,
+      flags,
+    });
+    offset += 46 + nameLength + extraLength + commentLength;
+  }
+  return entries;
+}
+
+/**
+ * Normalize an archive entry path and refuse anything that escapes the root.
+ * Returns the safe relative path.
+ */
+export function safeArchivePath(name: string): string {
+  const raw = name.replace(/\\/g, "/");
+  if (raw.length === 0 || raw.length > 512) {
+    throw new ZipError("unsafe_path", "The archive contains an invalid path.");
+  }
+  if (raw.startsWith("/") || /^[a-zA-Z]:/.test(raw)) {
+    throw new ZipError("unsafe_path", `The archive contains an absolute path: ${name}`);
+  }
+  const parts: string[] = [];
+  for (const part of raw.split("/")) {
+    if (part === "" || part === ".") continue;
+    if (part === "..") {
+      throw new ZipError("unsafe_path", `The archive contains a path that escapes its root: ${name}`);
+    }
+    if (part.includes("\0")) {
+      throw new ZipError("unsafe_path", "The archive contains an invalid path.");
+    }
+    parts.push(part);
+  }
+  if (parts.length === 0) {
+    throw new ZipError("unsafe_path", "The archive contains an invalid path.");
+  }
+  return parts.join("/");
+}
+
+/** Is this entry a symlink (or another non-regular file)? */
+function isUnsafeFileType(entry: ZipEntry): boolean {
+  if (entry.externalAttributes === 0) return false;
+  const unixMode = (entry.externalAttributes >>> 16) & 0xffff;
+  if (unixMode === 0) return false;
+  const type = unixMode & 0o170000;
+  // Regular file (0o100000) and directory (0o040000) are fine.
+  return type !== 0o100000 && type !== 0o040000 && type !== 0;
+}
+
+/** Extract every file of a zip archive into a path -> text map. */
+export function extractZipFiles(buffer: Buffer): Record<string, string> {
+  if (buffer.length > ZIP_LIMITS.maxArchiveBytes) {
+    throw new ZipError("too_large", "The archive is larger than the 16 MB limit.");
+  }
+  const entries = readZipEntries(buffer);
+  const files: Record<string, string> = {};
+  let total = 0;
+  for (const entry of entries) {
+    if (entry.isDirectory) continue;
+    if (isUnsafeFileType(entry)) {
+      throw new ZipError("unsafe_path", `The archive contains a link or special file: ${entry.name}`);
+    }
+    const safe = safeArchivePath(entry.name);
+    if (entry.uncompressedSize > ZIP_LIMITS.maxFileBytes) {
+      throw new ZipError("too_large", `The archive contains a file larger than 1 MB: ${entry.name}`);
+    }
+    if (entry.compressedSize > 0 && entry.uncompressedSize / entry.compressedSize > ZIP_LIMITS.maxRatio) {
+      throw new ZipError("too_large", `The archive expands too much: ${entry.name}`);
+    }
+    const content = inflateEntry(buffer, entry);
+    total += content.length;
+    if (total > ZIP_LIMITS.maxTotalBytes) {
+      throw new ZipError("too_large", "The archive expands to more than 8 MB.");
+    }
+    if (files[safe] !== undefined) {
+      throw new ZipError("corrupt", `The archive contains the file twice: ${safe}`);
+    }
+    files[safe] = content.toString("utf-8");
+  }
+  return files;
+}
+
+/** Read and decompress one entry. */
+function inflateEntry(buffer: Buffer, entry: ZipEntry): Buffer {
+  const offset = entry.localHeaderOffset;
+  if (offset + 30 > buffer.length || buffer.readUInt32LE(offset) !== LOCAL_SIGNATURE) {
+    throw new ZipError("corrupt", "The zip archive is corrupt.");
+  }
+  const nameLength = buffer.readUInt16LE(offset + 26);
+  const extraLength = buffer.readUInt16LE(offset + 28);
+  const start = offset + 30 + nameLength + extraLength;
+  const end = start + entry.compressedSize;
+  if (end > buffer.length) throw new ZipError("corrupt", "The zip archive is corrupt.");
+  const raw = buffer.subarray(start, end);
+  if (entry.method === 0) return raw;
+  if (entry.method !== 8) {
+    throw new ZipError("unsupported", `Unsupported compression method ${entry.method}.`);
+  }
+  try {
+    return zlib.inflateRawSync(raw, { maxOutputLength: ZIP_LIMITS.maxFileBytes });
+  } catch (error) {
+    throw new ZipError("corrupt", `The zip archive is corrupt: ${(error as Error).message}`);
+  }
+}
+
+/**
+ * Strip the common top-level folder of an archive: when every file lives under
+ * one folder, that folder is the skill root.
+ */
+export function stripCommonRoot(files: Record<string, string>): Record<string, string> {
+  const names = Object.keys(files);
+  if (names.length === 0) return files;
+  const roots = new Set(names.map((name) => name.split("/")[0] ?? ""));
+  if (roots.size !== 1) return files;
+  const root = [...roots][0] ?? "";
+  if (!root) return files;
+  // Only a real folder is stripped: a single file at the root is the skill.
+  if (!names.every((name) => name.includes("/"))) return files;
+  const stripped: Record<string, string> = {};
+  for (const [name, content] of Object.entries(files)) {
+    stripped[name.slice(root.length + 1)] = content;
+  }
+  return stripped;
+}
diff --git a/apps/swarmagents/lib/library/store.test.ts b/apps/swarmagents/lib/library/store.test.ts
new file mode 100644
index 000000000..612a6d63c
--- /dev/null
+++ b/apps/swarmagents/lib/library/store.test.ts
@@ -0,0 +1,182 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+import {
+  getInstalledSkill,
+  getRoleAssignments,
+  installSkill,
+  installTool,
+  listInstalledSkills,
+  listInstalledTools,
+  readLibraryState,
+  resolveLibraryPath,
+  setRoleAssignments,
+  uninstallSkill,
+  uninstallTool,
+  userLibraryDir,
+  userSkillDir,
+} from "./store";
+
+const ALICE = "alice@example.com";
+const BOB = "bob@example.com";
+let counter = 0;
+/** A fresh account id so the tests never share state. */
+function account(prefix: string): string {
+  counter += 1;
+  return `${prefix}-${counter}@example.com`;
+}
+
+function tempHome(): string {
+  return fs.mkdtempSync(path.join(os.tmpdir(), "swarm-library-store-"));
+}
+
+const SKILL_FILES = {
+  "SKILL.md": "---\nname: demo\ndescription: A demo skill.\n---\n\nBody\n",
+  "scripts/run.sh": "echo hi\n",
+};
+
+test("a skill is installed per account", () => {
+  const alice = account("alice");
+
+  const home = tempHome();
+  const skill = installSkill(alice, {
+    name: "demo",
+    description: "A demo skill.",
+    origin: "editor",
+    files: SKILL_FILES,
+  });
+  assert.equal(skill.id, "demo");
+  assert.equal(skill.files.length, 2);
+  assert.equal(skill.totalBytes > 0, true);
+
+  // The files live in the owner's account directory, not in a shared place.
+  const dir = userSkillDir(alice, "demo");
+  assert.equal(fs.existsSync(path.join(dir, "SKILL.md")), true);
+  assert.equal(fs.existsSync(path.join(dir, "scripts/run.sh")), true);
+  fs.rmSync(home, { recursive: true, force: true });
+});
+
+test("one account never sees the skills of another", () => {
+  const alice = account("alice");
+  const bob = account("bob");
+
+  installSkill(alice, {
+    name: "alice-only",
+    description: "Only Alice has this.",
+    origin: "editor",
+    files: { "SKILL.md": "---\nname: alice-only\ndescription: d\n---\n" },
+  });
+  assert.equal(listInstalledSkills(alice).length, 1);
+  assert.equal(listInstalledSkills(bob).length, 0);
+  assert.equal(getInstalledSkill(bob, "alice-only"), null);
+});
+
+test("the library state file is private to its owner", () => {
+  const alice = account("alice");
+
+  installSkill(alice, { name: "demo", description: "d", origin: "editor", files: SKILL_FILES });
+  const file = path.join(userLibraryDir(alice), "library.json");
+  assert.equal(fs.existsSync(file), true);
+  const mode = fs.statSync(file).mode & 0o777;
+  assert.equal(mode, 0o600);
+  const parsed = JSON.parse(fs.readFileSync(file, "utf-8")) as { userId: string };
+  assert.equal(parsed.userId, alice);
+});
+
+test("a state file of another account is ignored", () => {
+  const alice = account("alice");
+  const bob = account("bob");
+
+  const home = tempHome();
+  const dir = userLibraryDir(bob);
+  fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
+  fs.writeFileSync(
+    path.join(dir, "library.json"),
+    JSON.stringify({
+      schema: "swarmagents.library",
+      version: 1,
+      userId: alice,
+      skills: {
+        stolen: {
+          id: "stolen",
+          name: "stolen",
+          description: "not yours",
+          files: [],
+        },
+      },
+    }),
+  );
+  assert.equal(listInstalledSkills(bob).length, 0);
+  fs.rmSync(home, { recursive: true, force: true });
+});
+
+test("uninstalling a skill removes its files", () => {
+  const alice = account("alice");
+
+  installSkill(alice, { name: "demo", description: "d", origin: "editor", files: SKILL_FILES });
+  const dir = userSkillDir(alice, "demo");
+  assert.equal(uninstallSkill(alice, "demo"), true);
+  assert.equal(fs.existsSync(dir), false);
+  assert.equal(uninstallSkill(alice, "demo"), false);
+});
+
+test("the library refuses paths that escape the folder", () => {
+
+  assert.throws(() => resolveLibraryPath("../escape"));
+  assert.throws(() => resolveLibraryPath("/etc/passwd"));
+  assert.throws(() => resolveLibraryPath("a/../../b"));
+  assert.throws(() => resolveLibraryPath("a\\b"));
+  assert.equal(resolveLibraryPath("scripts/run.sh"), "scripts/run.sh");
+});
+
+test("role assignments only keep installed items", () => {
+  const alice = account("alice");
+
+  installSkill(alice, { name: "demo", description: "d", origin: "editor", files: SKILL_FILES });
+  installTool(alice, { name: "my-tool", files: { "tool.mjs": "// tool" } });
+  const assignments = setRoleAssignments(alice, "main", {
+    skills: ["demo", "not-installed"],
+    mcpServers: ["also-not-installed"],
+    tools: ["my-tool"],
+  });
+  assert.deepEqual(assignments.skills, ["demo"]);
+  assert.deepEqual(assignments.mcpServers, []);
+  assert.deepEqual(assignments.tools, ["my-tool"]);
+  const stored = getRoleAssignments(alice);
+  assert.deepEqual(stored.main?.skills, ["demo"]);
+});
+
+test("uninstalling a skill clears its role assignments", () => {
+  const alice = account("alice");
+
+  installSkill(alice, { name: "demo", description: "d", origin: "editor", files: SKILL_FILES });
+  setRoleAssignments(alice, "main", { skills: ["demo"] });
+  uninstallSkill(alice, "demo");
+  assert.deepEqual(getRoleAssignments(alice).main?.skills ?? [], []);
+});
+
+test("tools are stored per account and can be removed", () => {
+  const alice = account("alice");
+  const bob = account("bob");
+
+  installTool(alice, { name: "my-tool", description: "d", files: { "tool.mjs": "// tool" } });
+  assert.equal(listInstalledTools(alice).length, 1);
+  assert.equal(listInstalledTools(bob).length, 0);
+  assert.equal(uninstallTool(alice, "my-tool"), true);
+  assert.equal(listInstalledTools(alice).length, 0);
+});
+
+test("a broken state file does not throw", () => {
+  const alice = account("alice");
+
+  const home = tempHome();
+  const dir = userLibraryDir(alice);
+  fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
+  fs.writeFileSync(path.join(dir, "library.json"), "{not json");
+  const state = readLibraryState(alice);
+  assert.deepEqual(Object.keys(state.skills), []);
+  fs.rmSync(home, { recursive: true, force: true });
+});
diff --git a/apps/swarmagents/lib/library/store.ts b/apps/swarmagents/lib/library/store.ts
new file mode 100644
index 000000000..2ef025a0b
--- /dev/null
+++ b/apps/swarmagents/lib/library/store.ts
@@ -0,0 +1,619 @@
+/**
+ * Per-user library state.
+ *
+ * Everything a user installs lives under their own account directory:
+ *
+ *   <data dir>/users/<hash(userId)>/library/
+ *     library.json          state (mode 600): installed skills, MCP servers,
+ *                           custom tools and the per-role assignments
+ *     skills/<skillId>/…    the files of each installed skill
+ *     tools/<toolId>/…      the files of each custom tool
+ *
+ * Every function takes the owner's user id first, so a caller can never reach
+ * another account's library. The state file records its owner and is ignored
+ * when it belongs to somebody else.
+ *
+ * Secrets (MCP server credentials) are sealed with AES-256-GCM through
+ * lib/providers/secret-box.ts, bound to the owner and the server id. The
+ * client-facing views in lib/library/views.ts never include them.
+ */
+
+import fs from "node:fs";
+import path from "node:path";
+
+import { providerDataDir, userDirName } from "../providers/store";
+import type { DataDirOptions } from "../providers/store";
+
+export type { DataDirOptions };
+import { isSealed, open, seal } from "../providers/secret-box";
+import { slugifySkillName } from "./skills/format";
+
+export const LIBRARY_SCHEMA = "swarmagents.library";
+export const LIBRARY_SCHEMA_VERSION = 1;
+export const LIBRARY_STATE_FILE = "library.json";
+export const SKILLS_DIR = "skills";
+export const TOOLS_DIR = "tools";
+/** The MCP entrypoint a custom tool exposes inside the VM. */
+export const TOOL_ENTRY_FILE = "tool.mjs";
+
+const MAX_USER_ID_LEN = 256;
+
+/** Where a skill came from. */
+export type SkillOrigin = "catalog" | "github" | "zip" | "editor" | "agent";
+
+/** One file inside an installed skill or tool. */
+export interface LibraryFile {
+  /** The path relative to the skill/tool folder. */
+  path: string;
+  /** The file size in bytes. */
+  bytes: number;
+}
+
+/** An installed skill (metadata only — the files live next to the state). */
+export interface InstalledSkill {
+  id: string;
+  name: string;
+  description: string;
+  version: string;
+  license: string;
+  category: string;
+  origin: SkillOrigin;
+  /** Where the skill was installed from (a URL or a label). */
+  sourceUrl: string;
+  sourceLabel: string;
+  files: LibraryFile[];
+  totalBytes: number;
+  installedAt: number;
+  updatedAt: number;
+  /** The user reviewed the skill's scripts before installing it. */
+  reviewed: boolean;
+  /** The user explicitly marked the skill as trusted. */
+  trusted: boolean;
+}
+
+/** How an MCP server is reached. */
+export type McpTransport = "http" | "stdio";
+
+/** A user-installed MCP server. */
+export interface McpServerRecord {
+  id: string;
+  name: string;
+  description: string;
+  transport: McpTransport;
+  /** The remote endpoint (http transport). */
+  url: string;
+  /** The command to run inside the VM (stdio transport). */
+  command: string;
+  /** The command arguments (stdio transport). */
+  args: string[];
+  /** Plain (non-secret) environment variables passed to the server. */
+  env: Record<string, string>;
+  /** The names of the secret environment variables. */
+  secretEnv: string[];
+  /** The tool names the server exposes (documentation only). */
+  tools: string[];
+  sourceUrl: string;
+  verified: boolean;
+  createdAt: number;
+  updatedAt: number;
+}
+
+/** A custom tool the user (or the agent) wrote. */
+export interface CustomToolRecord {
+  id: string;
+  name: string;
+  description: string;
+  /** The tool names the skill exposes. */
+  origin: "user" | "agent";
+  inputSchema: Record<string, unknown>;
+  files: LibraryFile[];
+  totalBytes: number;
+  createdAt: number;
+  updatedAt: number;
+}
+
+/** The per-role assignment maps. */
+export interface RoleAssignments {
+  skills: string[];
+  mcpServers: string[];
+  tools: string[];
+}
+
+/** The whole library state of one account. */
+export interface LibraryState {
+  schema: string;
+  version: number;
+  userId: string;
+  updatedAt: number;
+  skills: Record<string, InstalledSkill>;
+  mcpServers: Record<string, McpServerRecord>;
+  tools: Record<string, CustomToolRecord>;
+  roleSkills: Record<string, string[]>;
+  roleMcpServers: Record<string, string[]>;
+  roleTools: Record<string, string[]>;
+}
+
+/** A rejected library mutation (bad input, missing owner, too large, ...). */
+export class LibraryError extends Error {
+  /** The HTTP status the API should answer with. */
+  readonly status: number;
+  /** A machine readable code. */
+  readonly code: string;
+
+  constructor(message: string, status = 400, code = "invalid_request") {
+    super(message);
+    this.name = "LibraryError";
+    this.status = status;
+    this.code = code;
+  }
+}
+
+function requireUserId(userId: string): string {
+  if (typeof userId !== "string" || userId.length === 0 || userId.length > MAX_USER_ID_LEN) {
+    throw new LibraryError("A signed-in user is required.", 401, "unauthorized");
+  }
+  return userId;
+}
+
+/** The directory that holds one user's library. */
+export function userLibraryDir(userId: string, options: DataDirOptions = {}): string {
+  return path.join(providerDataDir(options), "users", userDirName(userId), "library");
+}
+
+/** The path of one user's library state file. */
+export function libraryStatePath(userId: string, options: DataDirOptions = {}): string {
+  return path.join(userLibraryDir(userId, options), LIBRARY_STATE_FILE);
+}
+
+/** The directory that holds one installed skill's files. */
+export function userSkillDir(userId: string, skillId: string, options: DataDirOptions = {}): string {
+  return path.join(userLibraryDir(userId, options), SKILLS_DIR, skillId);
+}
+
+/** The directory that holds one custom tool's files. */
+export function userToolDir(userId: string, toolId: string, options: DataDirOptions = {}): string {
+  return path.join(userLibraryDir(userId, options), TOOLS_DIR, toolId);
+}
+
+/** An empty library state. */
+export function emptyLibraryState(userId: string): LibraryState {
+  return {
+    schema: LIBRARY_SCHEMA,
+    version: LIBRARY_SCHEMA_VERSION,
+    userId,
+    updatedAt: Date.now(),
+    skills: {},
+    mcpServers: {},
+    tools: {},
+    roleSkills: {},
+    roleMcpServers: {},
+    roleTools: {},
+  };
+}
+
+/** Read one user's library state (never throws on a broken file). */
+export function readLibraryState(userId: string, options: DataDirOptions = {}): LibraryState {
+  requireUserId(userId);
+  const file = libraryStatePath(userId, options);
+  if (!fs.existsSync(file)) return emptyLibraryState(userId);
+  let raw: string;
+  try {
+    raw = fs.readFileSync(file, "utf-8");
+  } catch (error) {
+    console.error(`[swarm-library] ignoring unreadable library file ${file}: ${String(error)}`);
+    return emptyLibraryState(userId);
+  }
+  let data: unknown;
+  try {
+    data = JSON.parse(raw);
+  } catch (error) {
+    console.error(`[swarm-library] ignoring malformed library file ${file}: ${String(error)}`);
+    return emptyLibraryState(userId);
+  }
+  if (data && typeof data === "object" && !Array.isArray(data)) {
+    const record = data as Record<string, unknown>;
+    if (typeof record.userId === "string" && record.userId !== userId) {
+      console.error(`[swarm-library] ignoring library file ${file}: owner mismatch.`);
+      return emptyLibraryState(userId);
+    }
+  }
+  return normalizeLibraryState(userId, data);
+}
+
+/** Coerce anything that claims to be a library state into a valid one. */
+export function normalizeLibraryState(userId: string, data: unknown): LibraryState {
+  const base = emptyLibraryState(userId);
+  if (!data || typeof data !== "object" || Array.isArray(data)) return base;
+  const record = data as Record<string, unknown>;
+  const asRecord = (value: unknown): Record<string, unknown> =>
+    value && typeof value === "object" && !Array.isArray(value) ? (value as Record<string, unknown>) : {};
+  const asList = (value: unknown): string[] =>
+    Array.isArray(value) ? value.filter((item): item is string => typeof item === "string") : [];
+  const skills: Record<string, InstalledSkill> = {};
+  for (const [id, value] of Object.entries(asRecord(record.skills))) {
+    const skill = asRecord(value);
+    const name = typeof skill.name === "string" ? skill.name : id;
+    skills[id] = {
+      id,
+      name,
+      description: typeof skill.description === "string" ? skill.description : "",
+      version: typeof skill.version === "string" ? skill.version : "",
+      license: typeof skill.license === "string" ? skill.license : "unknown",
+      category: typeof skill.category === "string" ? skill.category : "other",
+      origin: (typeof skill.origin === "string" ? skill.origin : "editor") as SkillOrigin,
+      sourceUrl: typeof skill.sourceUrl === "string" ? skill.sourceUrl : "",
+      sourceLabel: typeof skill.sourceLabel === "string" ? skill.sourceLabel : "",
+      files: Array.isArray(skill.files)
+        ? skill.files
+            .map((file) => asRecord(file))
+            .filter((file) => typeof file.path === "string")
+            .map((file) => ({ path: file.path as string, bytes: Number(file.bytes) || 0 }))
+        : [],
+      totalBytes: Number(skill.totalBytes) || 0,
+      installedAt: Number(skill.installedAt) || Date.now(),
+      updatedAt: Number(skill.updatedAt) || Date.now(),
+      reviewed: skill.reviewed === true,
+      trusted: skill.trusted === true,
+    };
+  }
+  const mcpServers: Record<string, McpServerRecord> = {};
+  for (const [id, value] of Object.entries(asRecord(record.mcpServers))) {
+    const server = asRecord(value);
+    const transport = server.transport === "stdio" ? "stdio" : "http";
+    mcpServers[id] = {
+      id,
+      name: typeof server.name === "string" ? server.name : id,
+      description: typeof server.description === "string" ? server.description : "",
+      transport,
+      url: typeof server.url === "string" ? server.url : "",
+      command: typeof server.command === "string" ? server.command : "",
+      args: asList(server.args),
+      env: Object.fromEntries(
+        Object.entries(asRecord(server.env))
+          .filter(([, value]) => typeof value === "string")
+          .map(([key, value]) => [key, value as string]),
+      ),
+      secretEnv: asList(server.secretEnv),
+      tools: asList(server.tools),
+      sourceUrl: typeof server.sourceUrl === "string" ? server.sourceUrl : "",
+      verified: server.verified === true,
+      createdAt: Number(server.createdAt) || Date.now(),
+      updatedAt: Number(server.updatedAt) || Date.now(),
+    };
+  }
+  const tools: Record<string, CustomToolRecord> = {};
+  for (const [id, value] of Object.entries(asRecord(record.tools))) {
+    const tool = asRecord(value);
+    tools[id] = {
+      id,
+      name: typeof tool.name === "string" ? tool.name : id,
+      description: typeof tool.description === "string" ? tool.description : "",
+      origin: tool.origin === "agent" ? "agent" : "user",
+      inputSchema: asRecord(tool.inputSchema),
+      files: Array.isArray(tool.files)
+        ? tool.files
+            .map((file) => asRecord(file))
+            .filter((file) => typeof file.path === "string")
+            .map((file) => ({ path: file.path as string, bytes: Number(file.bytes) || 0 }))
+        : [],
+      totalBytes: Number(tool.totalBytes) || 0,
+      createdAt: Number(tool.createdAt) || Date.now(),
+      updatedAt: Number(tool.updatedAt) || Date.now(),
+    };
+  }
+  return {
+    schema: LIBRARY_SCHEMA,
+    version: LIBRARY_SCHEMA_VERSION,
+    userId,
+    updatedAt: Number(record.updatedAt) || Date.now(),
+    skills,
+    mcpServers,
+    tools,
+    roleSkills: normalizeAssignments(record.roleSkills),
+    roleMcpServers: normalizeAssignments(record.roleMcpServers),
+    roleTools: normalizeAssignments(record.roleTools),
+  };
+}
+
+function normalizeAssignments(value: unknown): Record<string, string[]> {
+  const out: Record<string, string[]> = {};
+  if (!value || typeof value !== "object" || Array.isArray(value)) return out;
+  for (const [roleId, ids] of Object.entries(value as Record<string, unknown>)) {
+    if (!Array.isArray(ids)) continue;
+    out[roleId] = [...new Set(ids.filter((id): id is string => typeof id === "string"))];
+  }
+  return out;
+}
+
+/** Write one user's library state (atomic, mode 600). */
+export function writeLibraryState(userId: string, state: LibraryState, options: DataDirOptions = {}): string {
+  requireUserId(userId);
+  const file = libraryStatePath(userId, options);
+  const dir = path.dirname(file);
+  fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
+  try {
+    fs.chmodSync(dir, 0o700);
+  } catch {
+    /* best effort */
+  }
+  const body: LibraryState = {
+    ...state,
+    schema: LIBRARY_SCHEMA,
+    version: LIBRARY_SCHEMA_VERSION,
+    userId,
+    updatedAt: Date.now(),
+  };
+  const tmp = `${file}.tmp.${process.pid}.${Date.now()}`;
+  fs.writeFileSync(tmp, `${JSON.stringify(body, null, 2)}\n`, { encoding: "utf-8", mode: 0o600 });
+  fs.renameSync(tmp, file);
+  try {
+    fs.chmodSync(file, 0o600);
+  } catch {
+    /* best effort */
+  }
+  return file;
+}
+
+/**
+ * Resolve a relative path inside a skill/tool folder. Rejects absolute paths,
+ * `..` segments and anything that would escape the folder.
+ */
+export function resolveLibraryPath(relative: string): string {
+  if (typeof relative !== "string" || relative.length === 0 || relative.length > 512) {
+    throw new LibraryError("Invalid file path.", 400, "invalid_path");
+  }
+  if (relative.includes("\0") || /[\x00-\x1f]/.test(relative)) {
+    throw new LibraryError("Invalid file path.", 400, "invalid_path");
+  }
+  if (relative.includes("\\")) {
+    throw new LibraryError("Invalid file path.", 400, "invalid_path");
+  }
+  if (path.isAbsolute(relative) || relative.startsWith("/")) {
+    throw new LibraryError("Invalid file path.", 400, "invalid_path");
+  }
+  const parts = relative.split("/").filter((part) => part.length > 0);
+  if (parts.length === 0) {
+    throw new LibraryError("Invalid file path.", 400, "invalid_path");
+  }
+  for (const part of parts) {
+    if (part === "." || part === "..") {
+      throw new LibraryError("Invalid file path.", 400, "invalid_path");
+    }
+  }
+  return parts.join("/");
+}
+
+/** Write a file inside a user's library folder (creating the folders). */
+export function writeLibraryFile(
+  baseDir: string,
+  relative: string,
+  content: string,
+): { path: string; bytes: number } {
+  const safe = resolveLibraryPath(relative);
+  const target = path.join(baseDir, safe);
+  const dir = path.dirname(target);
+  fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
+  fs.writeFileSync(target, content, { encoding: "utf-8", mode: 0o600 });
+  return { path: safe, bytes: Buffer.byteLength(content, "utf-8") };
+}
+
+/** Read a file inside a user's library folder. */
+export function readLibraryFile(baseDir: string, relative: string): string | null {
+  const safe = resolveLibraryPath(relative);
+  const target = path.join(baseDir, safe);
+  if (!fs.existsSync(target)) return null;
+  const stat = fs.statSync(target);
+  if (!stat.isFile()) return null;
+  return fs.readFileSync(target, "utf-8");
+}
+
+/** Remove a folder recursively (best effort). */
+export function removeLibraryDir(dir: string): void {
+  try {
+    fs.rmSync(dir, { recursive: true, force: true });
+  } catch (error) {
+    console.error(`[swarm-library] could not remove ${dir}: ${String(error)}`);
+  }
+}
+
+/** Install (or replace) a skill for one user. */
+export function installSkill(
+  userId: string,
+  input: {
+    id?: string;
+    name: string;
+    description: string;
+    version?: string;
+    license?: string;
+    category?: string;
+    origin: SkillOrigin;
+    sourceUrl?: string;
+    sourceLabel?: string;
+    files: Record<string, string>;
+    reviewed?: boolean;
+    trusted?: boolean;
+  },
+  options: DataDirOptions = {},
+): InstalledSkill {
+  requireUserId(userId);
+  const state = readLibraryState(userId, options);
+  const id = slugifySkillName(input.id || input.name);
+  if (!id) throw new LibraryError("The skill needs a name.", 400, "invalid_name");
+  const dir = userSkillDir(userId, id, options);
+  removeLibraryDir(dir);
+  const files: LibraryFile[] = [];
+  let totalBytes = 0;
+  for (const [relative, content] of Object.entries(input.files)) {
+    const written = writeLibraryFile(dir, relative, content);
+    files.push(written);
+    totalBytes += written.bytes;
+  }
+  const now = Date.now();
+  const skill: InstalledSkill = {
+    id,
+    name: input.name,
+    description: input.description,
+    version: input.version ?? "",
+    license: input.license ?? "unknown",
+    category: input.category ?? "other",
+    origin: input.origin,
+    sourceUrl: input.sourceUrl ?? "",
+    sourceLabel: input.sourceLabel ?? "",
+    files,
+    totalBytes,
+    installedAt: state.skills[id]?.installedAt ?? now,
+    updatedAt: now,
+    reviewed: input.reviewed === true,
+    trusted: input.trusted === true,
+  };
+  state.skills[id] = skill;
+  writeLibraryState(userId, state, options);
+  return skill;
+}
+
+/** Uninstall a skill (and its files). */
+export function uninstallSkill(userId: string, skillId: string, options: DataDirOptions = {}): boolean {
+  requireUserId(userId);
+  const state = readLibraryState(userId, options);
+  if (!state.skills[skillId]) return false;
+  delete state.skills[skillId];
+  for (const [roleId, ids] of Object.entries(state.roleSkills)) {
+    const next = ids.filter((id) => id !== skillId);
+    if (next.length !== ids.length) state.roleSkills[roleId] = next;
+  }
+  removeLibraryDir(userSkillDir(userId, skillId, options));
+  writeLibraryState(userId, state, options);
+  return true;
+}
+
+/** The skills one user has installed, newest first. */
+export function listInstalledSkills(userId: string, options: DataDirOptions = {}): InstalledSkill[] {
+  const state = readLibraryState(userId, options);
+  return Object.values(state.skills).sort((a, b) => b.installedAt - a.installedAt);
+}
+
+/** One installed skill (or null). */
+export function getInstalledSkill(
+  userId: string,
+  skillId: string,
+  options: DataDirOptions = {},
+): InstalledSkill | null {
+  return readLibraryState(userId, options).skills[skillId] ?? null;
+}
+
+/** Install (or replace) a custom tool for one user. */
+export function installTool(
+  userId: string,
+  input: {
+    id?: string;
+    name: string;
+    description?: string;
+    origin?: "user" | "agent";
+    inputSchema?: Record<string, unknown>;
+    files: Record<string, string>;
+  },
+  options: DataDirOptions = {},
+): CustomToolRecord {
+  requireUserId(userId);
+  const state = readLibraryState(userId, options);
+  const id = slugifySkillName(input.id || input.name);
+  if (!id) throw new LibraryError("The tool needs a name.", 400, "invalid_name");
+  const dir = userToolDir(userId, id, options);
+  removeLibraryDir(dir);
+  const files: LibraryFile[] = [];
+  let totalBytes = 0;
+  for (const [relative, content] of Object.entries(input.files)) {
+    const written = writeLibraryFile(dir, relative, content);
+    files.push(written);
+    totalBytes += written.bytes;
+  }
+  const now = Date.now();
+  const tool: CustomToolRecord = {
+    id,
+    name: input.name,
+    description: input.description ?? "",
+    origin: input.origin ?? "user",
+    inputSchema: input.inputSchema ?? {},
+    files,
+    totalBytes,
+    createdAt: state.tools[id]?.createdAt ?? now,
+    updatedAt: now,
+  };
+  state.tools[id] = tool;
+  writeLibraryState(userId, state, options);
+  return tool;
+}
+
+/** Remove a custom tool. */
+export function uninstallTool(userId: string, toolId: string, options: DataDirOptions = {}): boolean {
+  requireUserId(userId);
+  const state = readLibraryState(userId, options);
+  if (!state.tools[toolId]) return false;
+  delete state.tools[toolId];
+  for (const [roleId, ids] of Object.entries(state.roleTools)) {
+    const next = ids.filter((id) => id !== toolId);
+    if (next.length !== ids.length) state.roleTools[roleId] = next;
+  }
+  removeLibraryDir(userToolDir(userId, toolId, options));
+  writeLibraryState(userId, state, options);
+  return true;
+}
+
+/** The custom tools one user has installed. */
+export function listInstalledTools(userId: string, options: DataDirOptions = {}): CustomToolRecord[] {
+  const state = readLibraryState(userId, options);
+  return Object.values(state.tools).sort((a, b) => b.createdAt - a.createdAt);
+}
+
+/** The per-role assignment maps of one user. */
+export function getRoleAssignments(userId: string, options: DataDirOptions = {}): Record<string, RoleAssignments> {
+  const state = readLibraryState(userId, options);
+  const roleIds = new Set([
+    ...Object.keys(state.roleSkills),
+    ...Object.keys(state.roleMcpServers),
+    ...Object.keys(state.roleTools),
+  ]);
+  const out: Record<string, RoleAssignments> = {};
+  for (const roleId of roleIds) {
+    out[roleId] = {
+      skills: state.roleSkills[roleId] ?? [],
+      mcpServers: state.roleMcpServers[roleId] ?? [],
+      tools: state.roleTools[roleId] ?? [],
+    };
+  }
+  return out;
+}
+
+/** Replace the assignments of one role (only known ids are kept). */
+export function setRoleAssignments(
+  userId: string,
+  roleId: string,
+  assignments: Partial<RoleAssignments>,
+  options: DataDirOptions = {},
+): RoleAssignments {
+  requireUserId(userId);
+  const state = readLibraryState(userId, options);
+  const clean = (ids: string[] | undefined, known: Set<string>): string[] =>
+    [...new Set((ids ?? []).filter((id) => known.has(id)))];
+  const next: RoleAssignments = {
+    skills: clean(assignments.skills, new Set(Object.keys(state.skills))),
+    mcpServers: clean(assignments.mcpServers, new Set(Object.keys(state.mcpServers))),
+    tools: clean(assignments.tools, new Set(Object.keys(state.tools))),
+  };
+  state.roleSkills[roleId] = next.skills;
+  state.roleMcpServers[roleId] = next.mcpServers;
+  state.roleTools[roleId] = next.tools;
+  writeLibraryState(userId, state, options);
+  return next;
+}
+
+/** Seal a secret value for one account. */
+export function sealSecret(value: string, userId: string, purpose: string, options: DataDirOptions = {}): string {
+  return seal(value, userId, purpose, { env: options.env, dataDir: providerDataDir(options) });
+}
+
+/** Open a sealed secret for one account. */
+export function openSecret(value: string, userId: string, purpose: string, options: DataDirOptions = {}): string {
+  if (!isSealed(value)) return value;
+  return open(value, userId, purpose, { env: options.env, dataDir: providerDataDir(options) });
+}
