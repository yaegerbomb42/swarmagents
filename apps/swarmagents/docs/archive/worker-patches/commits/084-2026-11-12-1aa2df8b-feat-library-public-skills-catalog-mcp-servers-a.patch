@@ -0,0 +1,78 @@
+/**
+ * The user's custom tools.
+ *
+ * A custom tool is a script that runs inside the user's own VM: it receives
+ * the tool arguments as JSON on stdin and prints the result on stdout. The
+ * app exposes it to the agent through the library MCP server.
+ *
+ * GET  /api/library/tools   the installed tools
+ * POST /api/library/tools   add a tool
+ */
+
+import { NextResponse } from "next/server";
+
+import {
+  NO_STORE,
+  libraryErrorResponse,
+  libraryOwner,
+  readJson,
+  unauthorized,
+} from "../../../../lib/library/api";
+import { installTool, listInstalledTools } from "../../../../lib/library/store";
+import { LibraryError } from "../../../../lib/library/store";
+
+/** The maximum size of a custom tool's source. */
+const MAX_TOOL_SOURCE_BYTES = 256 * 1024;
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+function asRecord(value: unknown): Record<string, unknown> {
+  return value && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : {};
+}
+
+export async function GET(request: Request): Promise<NextResponse> {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    return NextResponse.json({ tools: listInstalledTools(owner) }, { headers: NO_STORE });
+  } catch (error) {
+    return libraryErrorResponse(error);
+  }
+}
+
+export async function POST(request: Request): Promise<NextResponse> {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    const body = asRecord(await readJson(request));
+    const name = typeof body.name === "string" ? body.name.trim() : "";
+    if (!name) {
+      return NextResponse.json({ error: "The tool needs a name." }, { status: 400, headers: NO_STORE });
+    }
+    const source = typeof body.source === "string" ? body.source : "";
+    if (!source.trim()) {
+      return NextResponse.json({ error: "The tool needs some code." }, { status: 400, headers: NO_STORE });
+    }
+    if (Buffer.byteLength(source, "utf-8") > MAX_TOOL_SOURCE_BYTES) {
+      return NextResponse.json(
+        { error: "The tool is larger than the 256 KB limit." },
+        { status: 413, headers: NO_STORE },
+      );
+    }
+    const tool = installTool(owner, {
+      id: name,
+      name,
+      description: typeof body.description === "string" ? body.description.slice(0, 400) : "",
+      origin: "user",
+      inputSchema: asRecord(body.inputSchema),
+      files: { "tool.mjs": source },
+    });
+    return NextResponse.json({ tool }, { status: 201, headers: NO_STORE });
+  } catch (error) {
+    if (error instanceof LibraryError) return libraryErrorResponse(error);
+    return libraryErrorResponse(error);
+  }
+}
