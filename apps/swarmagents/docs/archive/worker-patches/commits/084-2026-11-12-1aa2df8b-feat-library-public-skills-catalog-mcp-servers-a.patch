+import test from "node:test";
+import assert from "node:assert/strict";
+
+import {
+  findSkillFolders,
+  githubFolderUrl,
+  githubRawUrl,
+  parseGitHubUrl,
+} from "./github";
+
+test("a repository URL is parsed", () => {
+  const target = parseGitHubUrl("https://github.com/anthropics/skills");
+  assert.deepEqual(target, { repo: "anthropics/skills", ref: "HEAD", path: "", kind: "repo" });
+});
+
+test("a folder URL is parsed", () => {
+  const target = parseGitHubUrl("https://github.com/anthropics/skills/tree/main/skills/pdf");
+  assert.equal(target?.repo, "anthropics/skills");
+  assert.equal(target?.ref, "main");
+  assert.equal(target?.path, "skills/pdf");
+  assert.equal(target?.kind, "folder");
+});
+
+test("a file URL is parsed", () => {
+  const target = parseGitHubUrl("https://github.com/anthropics/skills/blob/main/skills/pdf/SKILL.md");
+  assert.equal(target?.repo, "anthropics/skills");
+  assert.equal(target?.ref, "main");
+  assert.equal(target?.path, "skills/pdf/SKILL.md");
+  assert.equal(target?.kind, "file");
+});
+
+test("a raw URL is parsed", () => {
+  const target = parseGitHubUrl(
+    "https://raw.githubusercontent.com/anthropics/skills/main/skills/pdf/SKILL.md",
+  );
+  assert.equal(target?.repo, "anthropics/skills");
+  assert.equal(target?.ref, "main");
+  assert.equal(target?.path, "skills/pdf/SKILL.md");
+});
+
+test("an ssh URL is parsed", () => {
+  const target = parseGitHubUrl("git@github.com:owner/repo.git");
+  assert.equal(target?.repo, "owner/repo");
+});
+
+test("a non-GitHub URL is refused", () => {
+  assert.equal(parseGitHubUrl("https://example.com/skills/pdf"), null);
+  assert.equal(parseGitHubUrl("not a url"), null);
+  assert.equal(parseGitHubUrl(""), null);
+  assert.equal(parseGitHubUrl("https://github.com/only-owner"), null);
+});
+
+test("the skill folders of a repository are found", () => {
+  const folders = findSkillFolders([
+    "README.md",
+    "skills/pdf/SKILL.md",
+    "skills/pdf/reference.md",
+    "skills/pdf/other/SKILL.md",
+    "skills/xlsx/SKILL.md",
+  ]);
+  assert.deepEqual(folders, ["skills/pdf", "skills/pdf/other", "skills/xlsx"]);
+});
+
+test("the public URLs are built", () => {
+  assert.equal(
+    githubFolderUrl("anthropics/skills", "main", "skills/pdf"),
+    "https://github.com/anthropics/skills/tree/main/skills/pdf",
+  );
+  assert.equal(
+    githubRawUrl("anthropics/skills", "main", "skills/pdf/SKILL.md"),
+    "https://raw.githubusercontent.com/anthropics/skills/main/skills/pdf/SKILL.md",
+  );
+});
diff --git a/apps/swarmagents/lib/library/skills/github.ts b/apps/swarmagents/lib/library/skills/github.ts
new file mode 100644
index 000000000..dd5ba2334
--- /dev/null
+++ b/apps/swarmagents/lib/library/skills/github.ts
@@ -0,0 +1,390 @@
+/**
+ * Importing a skill from a public GitHub repository.
+ *
+ * The user pastes a URL that points at a skill folder (or at a repo that
+ * contains one). We resolve the folder's files and fetch their contents. The
+ * content is untrusted: the caller must show it to the user before it is
+ * installed (see lib/library/skills/import.ts).
+ *
+ * Only public repositories are supported, and only the file listing
+ * (git trees) plus the raw file contents are read. The repository tree is
+ * cached on disk for a few hours so browsing a repo does not hit the GitHub
+ * API on every click.
+ */
+
+import fs from "node:fs";
+import path from "node:path";
+
+import { providerDataDir, type DataDirOptions } from "../../providers/store";
+import { LibraryError } from "../store";
+import { gunzipStream, walkTar } from "./tar";
+
+/** Where a GitHub URL points. */
+export interface GitHubTarget {
+  /** "owner/repo". */
+  repo: string;
+  /** The branch, tag or commit. */
+  ref: string;
+  /** The folder (or file) inside the repository. */
+  path: string;
+  /** What the URL pointed at. */
+  kind: "repo" | "folder" | "file";
+}
+
+/** How long a repository tree stays cached. */
+const TREE_CACHE_TTL_MS = 6 * 60 * 60 * 1000;
+const FETCH_TIMEOUT_MS = 20_000;
+
+/**
+ * Parse a GitHub URL into a repository, a ref and a path.
+ * Returns null when the URL is not a GitHub URL we understand.
+ */
+export function parseGitHubUrl(raw: string): GitHubTarget | null {
+  const text = (raw ?? "").trim();
+  if (!text || text.length > 2048) return null;
+  let url: URL;
+  if (/^git@github\.com:/i.test(text)) {
+    const repo = text.replace(/^git@github\.com:/i, "").replace(/\.git$/i, "");
+    if (!/^[\w.-]+\/[\w.-]+$/.test(repo)) return null;
+    return { repo, ref: "HEAD", path: "", kind: "repo" };
+  }
+  if (!/^https?:\/\//i.test(text)) return null;
+  try {
+    url = new URL(text);
+  } catch {
+    return null;
+  }
+  const host = url.hostname.toLowerCase();
+  if (host === "raw.githubusercontent.com") {
+    const parts = url.pathname.replace(/^\//, "").split("/");
+    if (parts.length < 3) return null;
+    const [owner, repo, ref, ...rest] = parts;
+    if (!owner || !repo || !ref) return null;
+    const joined = rest.join("/");
+    return {
+      repo: `${owner}/${repo}`,
+      ref,
+      path: joined,
+      kind: joined.toLowerCase().endsWith("skill.md") ? "file" : "folder",
+    };
+  }
+  if (host !== "github.com" && host !== "www.github.com") return null;
+  const parts = url.pathname.replace(/^\//, "").split("/");
+  if (parts.length < 2) return null;
+  const [owner, repo, ...rest] = parts;
+  if (!owner || !repo) return null;
+  const repoName = repo.replace(/\.git$/i, "");
+  if (!/^[\w.-]+$/.test(owner) || !/^[\w.-]+$/.test(repoName)) return null;
+  if (rest.length === 0) return { repo: `${owner}/${repoName}`, ref: "HEAD", path: "", kind: "repo" };
+  const [kind, ref, ...pathParts] = rest;
+  if ((kind === "tree" || kind === "blob") && ref) {
+    const joined = pathParts.join("/");
+    return {
+      repo: `${owner}/${repoName}`,
+      ref,
+      path: joined,
+      kind: kind === "blob" ? "file" : "folder",
+    };
+  }
+  return { repo: `${owner}/${repoName}`, ref: "HEAD", path: "", kind: "repo" };
+}
+
+/** The public URL of a folder inside a repository. */
+export function githubFolderUrl(repo: string, ref: string, folder: string): string {
+  const suffix = folder ? `/tree/${ref}/${folder}` : "";
+  return `https://github.com/${repo}${suffix}`;
+}
+
+/** The raw URL of one file inside a repository. */
+export function githubRawUrl(repo: string, ref: string, filePath: string): string {
+  const encoded = filePath
+    .split("/")
+    .map((part) => encodeURIComponent(part))
+    .join("/");
+  return `https://raw.githubusercontent.com/${repo}/${ref}/${encoded}`;
+}
+
+interface RepoTree {
+  fetchedAt: number;
+  ref: string;
+  files: string[];
+}
+
+function treeCacheDir(options: DataDirOptions = {}): string {
+  return path.join(providerDataDir(options), "cache", "github");
+}
+
+function treeCacheFile(repo: string, ref: string, options: DataDirOptions = {}): string {
+  return path.join(treeCacheDir(options), `${repo.replace(/[^a-z0-9.-]/gi, "_")}--${ref.replace(/[^a-z0-9.-]/gi, "_")}.json`);
+}
+
+/** Read a cached repository tree (or null). */
+function readCachedTree(repo: string, ref: string, options: DataDirOptions = {}): string[] | null {
+  const file = treeCacheFile(repo, ref, options);
+  if (!fs.existsSync(file)) return null;
+  try {
+    const parsed = JSON.parse(fs.readFileSync(file, "utf-8")) as RepoTree;
+    if (!parsed || !Array.isArray(parsed.files)) return null;
+    if (Date.now() - Number(parsed.fetchedAt) > TREE_CACHE_TTL_MS) return null;
+    return parsed.files;
+  } catch {
+    return null;
+  }
+}
+
+/** Cache a repository tree on disk. */
+function writeCachedTree(repo: string, ref: string, files: string[], options: DataDirOptions = {}): void {
+  const file = treeCacheFile(repo, ref, options);
+  try {
+    fs.mkdirSync(path.dirname(file), { recursive: true, mode: 0o700 });
+    const body: RepoTree = { fetchedAt: Date.now(), ref, files };
+    fs.writeFileSync(file, JSON.stringify(body), { encoding: "utf-8", mode: 0o600 });
+  } catch (error) {
+    console.error(`[swarm-library] could not cache the GitHub tree for ${repo}: ${String(error)}`);
+  }
+}
+
+/** The file listing of a repository (cached). */
+export async function fetchRepoTree(
+  repo: string,
+  ref = "HEAD",
+  options: DataDirOptions = {},
+): Promise<string[]> {
+  const cached = readCachedTree(repo, ref, options);
+  if (cached) return cached;
+  const url = `https://api.github.com/repos/${repo}/git/trees/${encodeURIComponent(ref)}?recursive=1`;
+  let response: Response;
+  try {
+    response = await fetch(url, {
+      headers: {
+        "user-agent": "swarmagents-library",
+        accept: "application/vnd.github+json",
+        ...(process.env.GITHUB_TOKEN ? { authorization: `Bearer ${process.env.GITHUB_TOKEN}` } : {}),
+      },
+      signal: AbortSignal.timeout(FETCH_TIMEOUT_MS),
+    });
+  } catch (error) {
+    throw new LibraryError(
+      `Could not reach GitHub to read ${repo}: ${(error as Error).message}`,
+      502,
+      "github_unreachable",
+    );
+  }
+  if (!response.ok) {
+    throw new LibraryError(
+      response.status === 403 || response.status === 429
+        ? "GitHub is rate limiting the skill lookup. Try again in a few minutes."
+        : `GitHub could not list ${repo} (HTTP ${response.status}).`,
+      502,
+      "github_error",
+    );
+  }
+  const payload = (await response.json()) as { tree?: Array<{ path: string; type: string }>; truncated?: boolean };
+  const files = (payload.tree ?? [])
+    .filter((entry) => entry.type === "blob")
+    .map((entry) => entry.path);
+  if (payload.truncated) {
+    throw new LibraryError(
+      `${repo} is too large to list; open the skill folder in GitHub and paste that URL.`,
+      400,
+      "repo_too_large",
+    );
+  }
+  writeCachedTree(repo, ref, files, options);
+  return files;
+}
+
+/** Fetch one text file from a repository. */
+export async function fetchRepoFile(
+  repo: string,
+  ref: string,
+  filePath: string,
+): Promise<string> {
+  const url = githubRawUrl(repo, ref, filePath);
+  let response: Response;
+  try {
+    response = await fetch(url, {
+      headers: { "user-agent": "swarmagents-library" },
+      signal: AbortSignal.timeout(FETCH_TIMEOUT_MS),
+    });
+  } catch (error) {
+    throw new LibraryError(
+      `Could not download ${filePath} from ${repo}: ${(error as Error).message}`,
+      502,
+      "github_unreachable",
+    );
+  }
+  if (!response.ok) {
+    throw new LibraryError(
+      `GitHub could not return ${filePath} (HTTP ${response.status}).`,
+      502,
+      "github_error",
+    );
+  }
+  return response.text();
+}
+
+/** The skill folders inside a repository tree. */
+export function findSkillFolders(files: readonly string[]): string[] {
+  const folders = new Set<string>();
+  for (const file of files) {
+    if (!/(^|\/)SKILL\.md$/i.test(file)) continue;
+    folders.add(file.replace(/(^|\/)SKILL\.md$/i, "").replace(/\/$/, ""));
+  }
+  return [...folders].sort();
+}
+
+/** A skill folder fetched from a repository. */
+export interface RemoteSkill {
+  repo: string;
+  ref: string;
+  /** The folder inside the repository. */
+  folder: string;
+  /** The files of the skill, keyed by their path inside the folder. */
+  files: Record<string, string>;
+  /** The public URL of the folder. */
+  sourceUrl: string;
+}
+
+/** The maximum size of the tarball fallback download. */
+const MAX_TARBALL_BYTES = 64 * 1024 * 1024;
+/** The maximum size of one file read from a tarball. */
+const MAX_TARBALL_FILE_BYTES = 1024 * 1024;
+/** The maximum total size of the files read from a tarball. */
+const MAX_TARBALL_TOTAL_BYTES = 4 * 1024 * 1024;
+
+/** What a tarball scan found. */
+interface TarballScan {
+  /** The skill folders inside the repository. */
+  skillFolders: string[];
+  /** The files of the requested folder, keyed by their path inside it. */
+  files: Record<string, string>;
+}
+
+/**
+ * Read a repository tarball (the GitHub API rate limit is per IP and can be
+ * exhausted by other users of the same host). The tarball is streamed and
+ * only the requested folder is kept in memory.
+ */
+async function scanRepoTarball(repo: string, ref: string, folder: string): Promise<TarballScan> {
+  const urls = [
+    `https://codeload.github.com/${repo}/tar.gz/refs/heads/${ref}`,
+    `https://codeload.github.com/${repo}/tar.gz/${ref}`,
+  ];
+  let response: Response | null = null;
+  for (const url of urls) {
+    const attempt = await fetch(url, {
+      headers: { "user-agent": "swarmagents-library" },
+      signal: AbortSignal.timeout(FETCH_TIMEOUT_MS),
+    }).catch(() => null);
+    if (attempt?.ok && attempt.body) {
+      response = attempt;
+      break;
+    }
+  }
+  if (!response?.body) {
+    throw new LibraryError(
+      `Could not download ${repo} from GitHub. Try again in a few minutes.`,
+      502,
+      "github_unreachable",
+    );
+  }
+  const skillFolders: string[] = [];
+  const files: Record<string, string> = {};
+  const prefix = folder ? `${folder}/` : "";
+  let total = 0;
+  await walkTar(gunzipStream(response.body), async (entry, read) => {
+    const parts = entry.path.split("/");
+    // The archive root is "<repo>-<ref>/".
+    const rel = parts.slice(1).join("/");
+    if (!rel) return;
+    if (/(^|\/)SKILL\.md$/i.test(rel)) {
+      skillFolders.push(rel.replace(/(^|\/)SKILL\.md$/i, "").replace(/\/$/, ""));
+    }
+    if (!folder || !rel.startsWith(prefix)) return;
+    if (/(^|\/)SKILL\.md$/i.test(rel) && rel !== `${folder}/SKILL.md`) return;
+    if (entry.size > MAX_TARBALL_FILE_BYTES) return;
+    if (total + entry.size > MAX_TARBALL_TOTAL_BYTES) return;
+    const content = await read();
+    total += content.length;
+    files[rel.slice(prefix.length)] = content.toString("utf-8");
+  });
+  return { skillFolders, files };
+}
+
+/** The skill folders of a repository, read from its tarball. */
+export async function scanRepoTarballForFolders(
+  repo: string,
+  ref: string,
+): Promise<{ skillFolders: string[] }> {
+  const scan = await scanRepoTarball(repo, ref, "");
+  return { skillFolders: scan.skillFolders };
+}
+
+/** Fetch the files of one skill folder from a repository. */
+export async function fetchSkillFolder(
+  repo: string,
+  ref: string,
+  folder: string,
+  options: DataDirOptions = {},
+): Promise<RemoteSkill> {
+  let files: string[];
+  try {
+    files = await fetchRepoTree(repo, ref, options);
+  } catch (error) {
+    if (error instanceof LibraryError && error.code === "github_error") {
+      // The API is rate limited: read the folder from the repository tarball.
+      const scan = await scanRepoTarball(repo, ref, folder);
+      if (!scan.files["SKILL.md"]) {
+        throw new LibraryError(
+          folder ? `There is no SKILL.md in ${repo}/${folder}.` : `There is no SKILL.md in ${repo}.`,
+          400,
+          "no_skill_md",
+        );
+      }
+      return {
+        repo,
+        ref,
+        folder,
+        files: scan.files,
+        sourceUrl: githubFolderUrl(repo, ref, folder),
+      };
+    }
+    throw error;
+  }
+  const prefix = folder ? `${folder}/` : "";
+  const members = files.filter((file) => file.startsWith(prefix));
+  const skillFile = members.find((file) => /(^|\/)SKILL\.md$/i.test(file));
+  if (!skillFile) {
+    throw new LibraryError(
+      folder
+        ? `There is no SKILL.md in ${repo}/${folder}.`
+        : `There is no SKILL.md in ${repo}.`,
+      400,
+      "no_skill_md",
+    );
+  }
+  const nested = new Set(
+    members
+      .filter((file) => file !== skillFile && /(^|\/)SKILL\.md$/i.test(file))
+      .map((file) => file.slice(0, file.lastIndexOf("/") + 1)),
+  );
+  const wanted = members
+    .filter((file) => file !== skillFile)
+    .filter((file) => ![...nested].some((nestedPrefix) => file.startsWith(nestedPrefix)))
+    .slice(0, 60);
+  const out: Record<string, string> = {};
+  const content = await fetchRepoFile(repo, ref, skillFile);
+  out[skillFile.slice(prefix.length)] = content;
+  for (const file of wanted) {
+    const text = await fetchRepoFile(repo, ref, file);
+    out[file.slice(prefix.length)] = text;
+  }
+  return {
+    repo,
+    ref,
+    folder,
+    files: out,
+    sourceUrl: githubFolderUrl(repo, ref, folder),
+  };
+}
diff --git a/apps/swarmagents/lib/library/skills/import.test.ts b/apps/swarmagents/lib/library/skills/import.test.ts
