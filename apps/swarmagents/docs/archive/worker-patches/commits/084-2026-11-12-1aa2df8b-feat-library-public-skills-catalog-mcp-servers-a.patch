diff --git a/apps/swarmagents/app/api/library/mcp/[id]/route.ts b/apps/swarmagents/app/api/library/mcp/[id]/route.ts
new file mode 100644
index 000000000..8909135f1
--- /dev/null
+++ b/apps/swarmagents/app/api/library/mcp/[id]/route.ts
@@ -0,0 +1,85 @@
+/**
+ * One MCP server of the user.
+ *
+ * PATCH  /api/library/mcp/<id>   update it (secrets are replaced, never read back)
+ * DELETE /api/library/mcp/<id>   remove it
+ */
+
+import { NextResponse } from "next/server";
+
+import {
+  NO_STORE,
+  libraryErrorResponse,
+  libraryOwner,
+  readJson,
+  unauthorized,
+} from "../../../../../lib/library/api";
+import { removeMcpServer, updateMcpServer } from "../../../../../lib/library/mcp/store";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+interface RouteContext {
+  params: Promise<{ id: string }>;
+}
+
+async function routeId(ctx: RouteContext): Promise<string> {
+  const params = await Promise.resolve(ctx.params);
+  return typeof params?.id === "string" ? params.id : "";
+}
+
+function asRecord(value: unknown): Record<string, unknown> {
+  return value && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : {};
+}
+
+function stringMap(value: unknown): Record<string, string> {
+  const out: Record<string, string> = {};
+  for (const [key, entry] of Object.entries(asRecord(value))) {
+    if (typeof entry === "string") out[key] = entry;
+  }
+  return out;
+}
+
+function stringList(value: unknown): string[] {
+  return Array.isArray(value) ? value.filter((item): item is string => typeof item === "string") : [];
+}
+
+export async function PATCH(request: Request, ctx: RouteContext): Promise<NextResponse> {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    const id = await routeId(ctx);
+    const body = asRecord(await readJson(request));
+    const record = updateMcpServer(owner, id, {
+      name: typeof body.name === "string" ? body.name : undefined,
+      description: typeof body.description === "string" ? body.description : undefined,
+      transport: body.transport === "http" || body.transport === "stdio" ? body.transport : undefined,
+      url: typeof body.url === "string" ? body.url : undefined,
+      command: typeof body.command === "string" ? body.command : undefined,
+      args: body.args === undefined ? undefined : stringList(body.args),
+      env: body.env === undefined ? undefined : stringMap(body.env),
+      secrets: body.secrets === undefined ? undefined : stringMap(body.secrets),
+      tools: body.tools === undefined ? undefined : stringList(body.tools),
+    });
+    return NextResponse.json({ mcpServer: record }, { headers: NO_STORE });
+  } catch (error) {
+    return libraryErrorResponse(error);
+  }
+}
+
+export async function DELETE(request: Request, ctx: RouteContext): Promise<NextResponse> {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    const id = await routeId(ctx);
+    const removed = removeMcpServer(owner, id);
+    if (!removed) {
+      return NextResponse.json({ error: "MCP server not found." }, { status: 404, headers: NO_STORE });
+    }
+    return NextResponse.json({ removed: true }, { headers: NO_STORE });
+  } catch (error) {
+    return libraryErrorResponse(error);
+  }
+}
