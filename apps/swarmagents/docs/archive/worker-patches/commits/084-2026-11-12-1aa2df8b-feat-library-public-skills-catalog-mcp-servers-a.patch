+/**
+ * Build the public tool library index.
+ *
+ * The tool library is what a user browses when they want to give the agent
+ * more capabilities: MCP servers published in the official MCP registry plus
+ * the verified connector catalog that already ships with the app.
+ *
+ * Every entry comes from the public registry API or from the connector
+ * catalog in this repository — nothing is invented here.
+ *
+ * Usage: npx tsx scripts/build-tools-index.ts [--out <file>] [--limit N]
+ */
+
+import fs from "node:fs";
+import path from "node:path";
+
+import connectorCatalog from "../lib/library/catalog/connectors.json";
+
+const ROOT = path.resolve(__dirname, "..");
+const DEFAULT_OUT = path.join(ROOT, "lib/library/catalog/tools-index.json");
+const REGISTRY_URL = "https://registry.modelcontextprotocol.io/v0.1/servers";
+const PAGE_SIZE = 100;
+const FETCH_TIMEOUT_MS = 30_000;
+
+interface RegistryServer {
+  server?: {
+    name?: string;
+    title?: string;
+    description?: string;
+    version?: string;
+    remotes?: Array<{ type?: string; url?: string }>;
+    packages?: Array<{ registry_type?: string; name?: string; version?: string }>;
+    repository?: { url?: string; source?: string };
+    websiteUrl?: string;
+  };
+  _meta?: {
+    "io.modelcontextprotocol.registry/official"?: {
+      status?: string;
+      publishedAt?: string;
+      updatedAt?: string;
+    };
+  };
+}
+
+interface RegistryResponse {
+  servers?: RegistryServer[];
+  metadata?: { nextCursor?: string; count?: number };
+}
+
+export interface ToolIndexEntry {
+  id: string;
+  name: string;
+  title: string;
+  description: string;
+  transport: "http" | "stdio";
+  install: string;
+  tools: string[];
+  sourceUrl: string;
+  publisher: string;
+  verified: boolean;
+  origin: "registry" | "connector";
+}
+
+function parseArgs(argv: string[]): { out: string; limit: number } {
+  const args = { out: DEFAULT_OUT, limit: 2000 };
+  for (let i = 0; i < argv.length; i += 1) {
+    if (argv[i] === "--out") args.out = path.resolve(argv[++i] ?? DEFAULT_OUT);
+    else if (argv[i] === "--limit") args.limit = Number(argv[++i]);
+  }
+  return args;
+}
+
+/** The registry's server name is a reverse-domain id: io.github.owner/server. */
+function publisherOf(name: string): string {
+  const parts = name.split("/");
+  return parts.length > 1 ? parts[0] : name;
+}
+
+async function fetchRegistry(maxEntries: number): Promise<RegistryServer[]> {
+  const servers: RegistryServer[] = [];
+  let cursor: string | undefined;
+  for (let page = 0; page < 60; page += 1) {
+    const url = new URL(REGISTRY_URL);
+    url.searchParams.set("limit", String(PAGE_SIZE));
+    if (cursor) url.searchParams.set("cursor", cursor);
+    const response = await fetch(url, {
+      headers: { "user-agent": "swarmagents-tool-indexer", accept: "application/json" },
+      signal: AbortSignal.timeout(FETCH_TIMEOUT_MS),
+    });
+    if (!response.ok) {
+      throw new Error(`registry request failed: HTTP ${response.status}`);
+    }
+    const payload = (await response.json()) as RegistryResponse;
+    const batch = payload.servers ?? [];
+    servers.push(...batch);
+    cursor = payload.metadata?.nextCursor;
+    if (!cursor || batch.length === 0) break;
+    if (servers.length >= maxEntries) break;
+  }
+  return servers;
+}
+
+async function main(): Promise<void> {
+  const args = parseArgs(process.argv.slice(2));
+  const entries = new Map<string, ToolIndexEntry>();
+
+  // 1) The official MCP registry.
+  let registryCount = 0;
+  try {
+    const servers = await fetchRegistry(args.limit);
+    for (const item of servers) {
+      const server = item.server;
+      if (!server?.name) continue;
+      const id = server.name;
+      if (entries.has(id)) continue;
+      const remote = (server.remotes ?? []).find((entry) => typeof entry.url === "string");
+      const pkg = (server.packages ?? []).find((entry) => typeof entry.name === "string");
+      const install = remote?.url ?? "";
+      if (!install && !pkg) continue;
+      entries.set(id, {
+        id,
+        name: server.title || id.split("/").pop() || id,
+        title: server.title ?? "",
+        description: (server.description ?? "").slice(0, 600),
+        transport: remote ? "http" : "stdio",
+        install: install || (pkg?.registry_type === "npm" ? `npx ${pkg.name}` : ""),
+        tools: [],
+        sourceUrl: server.repository?.url ?? server.websiteUrl ?? `https://registry.modelcontextprotocol.io/v0.1/servers?search=${encodeURIComponent(id)}`,
+        publisher: publisherOf(id),
+        verified: item._meta?.["io.modelcontextprotocol.registry/official"]?.status === "active",
+        origin: "registry",
+      });
+      registryCount += 1;
+    }
+  } catch (error) {
+    console.error(`[tools-index] the MCP registry could not be read: ${(error as Error).message}`);
+  }
+
+  // 2) The verified connector catalog that ships with the app.
+  const connectors = connectorCatalog as Array<{
+    id: string;
+    name: string;
+    category: string;
+    description: string;
+    transport: string;
+    install: string;
+    tools?: string[];
+    sourceUrl?: string;
+    verified?: boolean;
+  }>;
+  for (const connector of connectors) {
+    const id = `connector.${connector.id}`;
+    entries.set(id, {
+      id,
+      name: connector.name,
+      title: "",
+      description: connector.description,
+      transport: connector.transport === "stdio" ? "stdio" : "http",
+      install: connector.install,
+      tools: connector.tools ?? [],
+      sourceUrl: connector.sourceUrl ?? "",
+      publisher: "swarmagents",
+      verified: connector.verified === true,
+      origin: "connector",
+    });
+  }
+
+  const list = [...entries.values()].sort((a, b) => a.name.localeCompare(b.name));
+  const index = {
+    schema: "swarmagents.library.tools-index",
+    version: 1,
+    generatedAt: new Date().toISOString(),
+    total: list.length,
+    registryCount,
+    connectorCount: connectors.length,
+    entries: list,
+  };
+  fs.mkdirSync(path.dirname(args.out), { recursive: true });
+  fs.writeFileSync(args.out, `${JSON.stringify(index, null, 1)}\n`, "utf-8");
+  console.log(`[tools-index] wrote ${list.length} entries (${registryCount} from the registry) to ${args.out}`);
+}
+
+main().catch((error) => {
+  console.error(`[tools-index] ${(error as Error).message}`);
+  process.exitCode = 1;
+});
