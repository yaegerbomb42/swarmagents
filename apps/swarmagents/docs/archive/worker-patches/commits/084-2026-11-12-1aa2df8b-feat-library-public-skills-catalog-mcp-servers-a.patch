@@ -0,0 +1,128 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+
+import { VmManager } from "../../vm/manager";
+import { FakeVmDriver } from "../../vm/fake-driver";
+import {
+  harvestAgentTools,
+  syncSkillsToVm,
+  toolManifest,
+  VM_SKILLS_DIR,
+  VM_TOOLS_MANIFEST,
+  VM_TOOLS_SERVER,
+} from "./vm-sync";
+import { installSkill, installTool, setRoleAssignments } from "../store";
+
+let counter = 0;
+function account(): string {
+  counter += 1;
+  return `vmsync-${counter}@example.com`;
+}
+
+const SKILL_MD = "---\nname: demo\ndescription: A demo skill for the VM tests.\n---\n\nBody.\n";
+
+test("a skill is written into the user's VM (where Claude Code reads it)", async () => {
+  const user = account();
+  installSkill(user, {
+    name: "demo",
+    description: "A demo skill for the VM tests.",
+    origin: "editor",
+    files: { "SKILL.md": SKILL_MD, "scripts/run.sh": "echo hi\n" },
+  });
+  const driver = new FakeVmDriver();
+  const vm = new VmManager({ customDriver: driver });
+
+  const written = await syncSkillsToVm(
+    user,
+    [
+      {
+        id: "demo",
+        name: "demo",
+        description: "A demo skill for the VM tests.",
+        version: "",
+        license: "unknown",
+        category: "other",
+        origin: "editor",
+        sourceUrl: "",
+        sourceLabel: "",
+        files: [
+          { path: "SKILL.md", bytes: SKILL_MD.length },
+          { path: "scripts/run.sh", bytes: 9 },
+        ],
+        totalBytes: 0,
+        installedAt: Date.now(),
+        updatedAt: Date.now(),
+        reviewed: false,
+        trusted: false,
+      },
+    ],
+    {},
+    vm,
+  );
+  assert.equal(written.length, 2);
+  assert.equal(written.includes(`${VM_SKILLS_DIR}/demo/SKILL.md`), true);
+
+  const inVm = await vm.readFile(user, `${VM_SKILLS_DIR}/demo/SKILL.md`);
+  assert.equal(inVm, SKILL_MD);
+  const script = await vm.readFile(user, `${VM_SKILLS_DIR}/demo/scripts/run.sh`);
+  assert.equal(script, "echo hi\n");
+
+  // Another account never sees it.
+  await assert.rejects(() => vm.readFile(account(), `${VM_SKILLS_DIR}/demo/SKILL.md`));
+});
+
+test("the tool manifest lists the custom tools of the user", () => {
+  const user = account();
+  installTool(user, {
+    name: "my-tool",
+    description: "A tool of mine.",
+    files: { "tool.mjs": "// tool" },
+  });
+  const manifest = toolManifest(user);
+  assert.equal(manifest.tools.length, 1);
+  assert.equal(manifest.tools[0].name, "my-tool");
+  assert.equal(manifest.tools[0].command, "node");
+  assert.equal(manifest.tools[0].args[0].includes("/tools/my-tool/tool.mjs"), true);
+  assert.equal(manifest.tools[0].inputSchema.type, "object");
+});
+
+test("a tool the agent wrote for itself is harvested into the library", async () => {
+  const user = account();
+  const driver = new FakeVmDriver();
+  const vm = new VmManager({ customDriver: driver });
+  await vm.writeFile(user, "/workspace/.swarm/agent-tools/word-count/tool.mjs", "// counts words\n");
+  await vm.writeFile(user, "/workspace/.swarm/agent-tools/word-count/README.md", "Counts the words of a text.\n");
+
+  const harvested = await harvestAgentTools(user, {}, vm);
+  assert.equal(harvested.length, 1);
+  assert.equal(harvested[0].id, "word-count");
+  assert.equal(harvested[0].origin, "agent");
+  assert.match(harvested[0].description, /Counts the words/);
+});
+
+test("the tools server and manifest paths are stable", () => {
+  assert.equal(VM_TOOLS_MANIFEST, "/workspace/.swarm/library/tools.json");
+  assert.equal(VM_TOOLS_SERVER, "/workspace/.swarm/library/tools.mjs");
+});
+
+test("a role only gets the skills assigned to it", async () => {
+  const user = account();
+  installSkill(user, {
+    name: "assigned",
+    description: "Assigned to the role.",
+    origin: "editor",
+    files: { "SKILL.md": SKILL_MD },
+  });
+  installSkill(user, {
+    name: "unassigned",
+    description: "Not assigned to the role.",
+    origin: "editor",
+    files: { "SKILL.md": SKILL_MD },
+  });
+  setRoleAssignments(user, "main", { skills: ["assigned"] });
+  const driver = new FakeVmDriver();
+  const vm = new VmManager({ customDriver: driver });
+  const { skillsForRole } = await import("./vm-sync");
+  const roleSkills = skillsForRole(user, "main");
+  assert.deepEqual(roleSkills.map((skill) => skill.id), ["assigned"]);
+});
diff --git a/apps/swarmagents/lib/library/skills/vm-sync.ts b/apps/swarmagents/lib/library/skills/vm-sync.ts
