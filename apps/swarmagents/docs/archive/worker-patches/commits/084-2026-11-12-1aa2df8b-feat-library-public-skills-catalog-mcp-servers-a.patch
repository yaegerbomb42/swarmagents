@@ -0,0 +1,64 @@
+/**
+ * Which library items a role may use.
+ *
+ * POST /api/library/assignments
+ *   { "roleId": "main", "skills": ["pdf"], "mcpServers": ["github"], "tools": ["my-tool"] }
+ *
+ * Only items the user has actually installed are kept: a role can never get
+ * more than the account allows.
+ */
+
+import { NextResponse } from "next/server";
+
+import {
+  NO_STORE,
+  libraryErrorResponse,
+  libraryOwner,
+  readJson,
+  unauthorized,
+} from "../../../../lib/library/api";
+import { getRoleAssignments, setRoleAssignments } from "../../../../lib/library/store";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+function asRecord(value: unknown): Record<string, unknown> {
+  return value && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : {};
+}
+
+function stringList(value: unknown): string[] | undefined {
+  if (!Array.isArray(value)) return undefined;
+  return value.filter((item): item is string => typeof item === "string");
+}
+
+export async function GET(request: Request): Promise<NextResponse> {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    return NextResponse.json({ assignments: getRoleAssignments(owner) }, { headers: NO_STORE });
+  } catch (error) {
+    return libraryErrorResponse(error);
+  }
+}
+
+export async function POST(request: Request): Promise<NextResponse> {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    const body = asRecord(await readJson(request));
+    const roleId = typeof body.roleId === "string" ? body.roleId.trim() : "";
+    if (!roleId || roleId.length > 64) {
+      return NextResponse.json({ error: "Which role should get these?" }, { status: 400, headers: NO_STORE });
+    }
+    const assignments = setRoleAssignments(owner, roleId, {
+      skills: stringList(body.skills),
+      mcpServers: stringList(body.mcpServers),
+      tools: stringList(body.tools),
+    });
+    return NextResponse.json({ roleId, assignments }, { headers: NO_STORE });
+  } catch (error) {
+    return libraryErrorResponse(error);
+  }
+}
