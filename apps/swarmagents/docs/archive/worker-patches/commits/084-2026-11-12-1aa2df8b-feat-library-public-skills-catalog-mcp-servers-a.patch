diff --git a/apps/swarmagents/lib/library/api.ts b/apps/swarmagents/lib/library/api.ts
new file mode 100644
index 000000000..04b629f10
--- /dev/null
+++ b/apps/swarmagents/lib/library/api.ts
@@ -0,0 +1,49 @@
+/**
+ * Shared helpers for the library API routes.
+ *
+ * Every library route is per account: the owner is taken from the header the
+ * middleware sets (a client can never forge it) or from the session, and the
+ * routes refuse to answer without one.
+ */
+
+import { NextResponse } from "next/server";
+
+import { USER_HEADER, requestUser, serverMode } from "../auth";
+import { LibraryError } from "./store";
+
+export const NO_STORE = { "cache-control": "no-store" } as const;
+
+/** The account a library request belongs to (or null when unauthenticated). */
+export function libraryOwner(request: Request): string | null {
+  const header = request.headers.get(USER_HEADER);
+  if (header && header.length > 0 && header.length <= 256) return header;
+  const user = requestUser(request);
+  if (user?.id) return user.id;
+  return serverMode() ? null : "local";
+}
+
+/** The 401 answer of the library routes. */
+export function unauthorized(): NextResponse {
+  return NextResponse.json({ error: "Sign in required." }, { status: 401, headers: NO_STORE });
+}
+
+/** Turn any thrown error into a JSON answer. */
+export function libraryErrorResponse(error: unknown): NextResponse {
+  if (error instanceof LibraryError) {
+    return NextResponse.json(
+      { error: error.message, code: error.code },
+      { status: error.status, headers: NO_STORE },
+    );
+  }
+  const message = error instanceof Error ? error.message : "The library request failed.";
+  return NextResponse.json({ error: message }, { status: 500, headers: NO_STORE });
+}
+
+/** Read a JSON body, answering 400 when it is not valid JSON. */
+export async function readJson(request: Request): Promise<unknown | null> {
+  try {
+    return await request.json();
+  } catch {
+    return null;
+  }
+}
