@@ -0,0 +1,143 @@
+/**
+ * A minimal streaming tar reader (gzipped).
+ *
+ * Used to read a repository tarball without extracting it to disk and
+ * without any dependency. The same reader powers the catalog indexer
+ * (scripts/build-skills-index.ts) and the GitHub import fallback: when the
+ * GitHub API rate-limits us, the skill folder is read from the tarball
+ * instead.
+ */
+
+import { Readable } from "node:stream";
+import zlib from "node:zlib";
+
+/** One entry of a tar archive. */
+export interface TarEntry {
+  /** The path inside the archive. */
+  path: string;
+  /** The size of the file in bytes. */
+  size: number;
+  /** The type flag ("0" = file, "5" = directory, ...). */
+  type: string;
+}
+
+/** Reads bytes from an async iterable of buffers. */
+export class ChunkReader {
+  private queue: Buffer[] = [];
+  private queued = 0;
+  private eof = false;
+
+  constructor(private readonly iterator: AsyncIterator<Buffer>) {}
+
+  private async pull(): Promise<void> {
+    if (this.eof) return;
+    const next = await this.iterator.next();
+    if (next.done) {
+      this.eof = true;
+      return;
+    }
+    this.queue.push(next.value);
+    this.queued += next.value.length;
+  }
+
+  /** Read exactly `size` bytes (fewer only at the end of the stream). */
+  async read(size: number): Promise<Buffer> {
+    while (this.queued < size && !this.eof) await this.pull();
+    const take = Math.min(size, this.queued);
+    const out = Buffer.allocUnsafe(take);
+    let written = 0;
+    while (written < take) {
+      const chunk = this.queue[0];
+      if (!chunk) break;
+      const need = take - written;
+      if (chunk.length <= need) {
+        chunk.copy(out, written);
+        written += chunk.length;
+        this.queue.shift();
+        this.queued -= chunk.length;
+      } else {
+        chunk.copy(out, written, 0, need);
+        this.queue[0] = chunk.subarray(need);
+        written += need;
+        this.queued -= need;
+      }
+    }
+    return out;
+  }
+}
+
+/** Parse a 512 byte tar header block. */
+export function parseTarHeader(block: Buffer): { path: string; size: number; type: string } | null {
+  if (block.length < 512) return null;
+  let name = block.subarray(0, 100).toString("utf-8").replace(/\0.*$/, "");
+  const sizeField = block.subarray(124, 136).toString("ascii").replace(/\0.*$/, "").trim();
+  const type = String.fromCharCode(block[156]) || "0";
+  const prefix = block.subarray(345, 500).toString("utf-8").replace(/\0.*$/, "");
+  let size = 0;
+  if (sizeField.length > 0) {
+    if (sizeField[0] === "\x80" || sizeField[0] === "\xff") {
+      size = Number.parseInt(sizeField.slice(1), 16) || 0;
+    } else {
+      size = Number.parseInt(sizeField, 8) || 0;
+    }
+  }
+  if (prefix) name = `${prefix}/${name}`;
+  return { path: name, size, type };
+}
+
+/**
+ * Walk a gzipped tar stream. `onEntry` receives every file entry; return
+ * `false` from it to stop the walk.
+ */
+export async function walkTar(
+  stream: AsyncIterable<Buffer>,
+  onEntry: (entry: TarEntry, read: () => Promise<Buffer>) => Promise<boolean | void> | boolean | void,
+): Promise<void> {
+  const iterator = stream[Symbol.asyncIterator]() as AsyncIterator<Buffer>;
+  const reader = new ChunkReader(iterator);
+  let longName: string | null = null;
+  for (;;) {
+    const header = await reader.read(512);
+    if (header.length < 512) break;
+    const parsed = parseTarHeader(header);
+    if (!parsed) break;
+    const padded = Math.ceil(parsed.size / 512) * 512;
+    if (parsed.type === "L") {
+      const content = await reader.read(parsed.size);
+      longName = content.toString("utf-8").replace(/\0.*$/, "");
+      continue;
+    }
+    const name = longName ?? parsed.path;
+    longName = null;
+    if (parsed.type === "0" || parsed.type === "" || parsed.type === "7") {
+      let taken = false;
+      const read = async (): Promise<Buffer> => {
+        const content = await reader.read(parsed.size);
+        taken = true;
+        const rest = padded - parsed.size;
+        if (rest > 0) await reader.read(rest);
+        return content;
+      };
+      const keep = await onEntry({ path: name, size: parsed.size, type: parsed.type }, read);
+      if (taken) {
+        if (keep === false) return;
+        continue;
+      }
+      if (keep === false) return;
+    }
+    if (parsed.size > 0) await reader.read(padded);
+  }
+}
+
+/** A gunzip stream factory for a fetch response body. */
+export function gunzipStream(body: ReadableStream<Uint8Array>): AsyncIterable<Buffer> {
+  const gunzip = zlib.createGunzip();
+  const source = ReadableStreamToNode(body);
+  source.pipe(gunzip);
+  return gunzip as unknown as AsyncIterable<Buffer>;
+}
+
+/** Bridge a web stream to a node stream. */
+function ReadableStreamToNode(body: ReadableStream<Uint8Array>): NodeJS.ReadableStream {
+  return Readable.fromWeb(body as never) as unknown as NodeJS.ReadableStream;
+}
