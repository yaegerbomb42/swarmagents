@@ -0,0 +1,98 @@
+/**
+ * One installed skill: its metadata, its SKILL.md and its files.
+ *
+ * GET    /api/library/skills/<id>   the skill with its content
+ * PATCH  /api/library/skills/<id>   { reviewed: true, trusted: true }
+ * DELETE /api/library/skills/<id>   uninstall it
+ */
+
+import { NextResponse } from "next/server";
+
+import {
+  NO_STORE,
+  libraryErrorResponse,
+  libraryOwner,
+  readJson,
+  unauthorized,
+} from "../../../../../lib/library/api";
+import {
+  getInstalledSkill,
+  readLibraryFile,
+  uninstallSkill,
+  userSkillDir,
+  writeLibraryState,
+  readLibraryState,
+} from "../../../../../lib/library/store";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+interface RouteContext {
+  params: Promise<{ id: string }>;
+}
+
+async function routeId(ctx: RouteContext): Promise<string> {
+  const params = await Promise.resolve(ctx.params);
+  return typeof params?.id === "string" ? params.id : "";
+}
+
+export async function GET(request: Request, ctx: RouteContext): Promise<NextResponse> {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    const id = await routeId(ctx);
+    const skill = getInstalledSkill(owner, id);
+    if (!skill) {
+      return NextResponse.json({ error: "Skill not found." }, { status: 404, headers: NO_STORE });
+    }
+    const dir = userSkillDir(owner, id);
+    const files = skill.files.map((file) => ({
+      ...file,
+      content: readLibraryFile(dir, file.path) ?? "",
+    }));
+    return NextResponse.json({ skill: { ...skill, files } }, { headers: NO_STORE });
+  } catch (error) {
+    return libraryErrorResponse(error);
+  }
+}
+
+export async function PATCH(request: Request, ctx: RouteContext): Promise<NextResponse> {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    const id = await routeId(ctx);
+    const skill = getInstalledSkill(owner, id);
+    if (!skill) {
+      return NextResponse.json({ error: "Skill not found." }, { status: 404, headers: NO_STORE });
+    }
+    const body = ((await readJson(request)) ?? {}) as { reviewed?: unknown; trusted?: unknown };
+    const state = readLibraryState(owner);
+    const current = state.skills[id];
+    if (!current) {
+      return NextResponse.json({ error: "Skill not found." }, { status: 404, headers: NO_STORE });
+    }
+    if (typeof body.reviewed === "boolean") current.reviewed = body.reviewed;
+    if (typeof body.trusted === "boolean") current.trusted = body.trusted;
+    current.updatedAt = Date.now();
+    state.skills[id] = current;
+    writeLibraryState(owner, state);
+    return NextResponse.json({ skill: current }, { headers: NO_STORE });
+  } catch (error) {
+    return libraryErrorResponse(error);
+  }
+}
+
+export async function DELETE(request: Request, ctx: RouteContext): Promise<NextResponse> {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    const id = await routeId(ctx);
+    const removed = uninstallSkill(owner, id);
+    if (!removed) {
+      return NextResponse.json({ error: "Skill not found." }, { status: 404, headers: NO_STORE });
+    }
+    return NextResponse.json({ removed: true }, { headers: NO_STORE });
+  } catch (error) {
+    return libraryErrorResponse(error);
+  }
+}
diff --git a/apps/swarmagents/app/api/library/skills/import/route.ts b/apps/swarmagents/app/api/library/skills/import/route.ts
new file mode 100644
index 000000000..978d5d285
--- /dev/null
+++ b/apps/swarmagents/app/api/library/skills/import/route.ts
@@ -0,0 +1,113 @@
+/**
+ * Import a skill into the library (staged first, installed after review).
+ *
+ * POST /api/library/skills/import
+ *   { "source": "catalog", "catalogId": "anthropics-skills--pdf" }
+ *   { "source": "url", "url": "https://github.com/owner/repo/tree/main/skills/pdf" }
+ *   { "source": "editor", "name": "my-skill", "description": "…", "markdown": "…" }
+ *   (multipart/form-data with a "file" field: a zip archive)
+ *
+ * The answer is the preview: the SKILL.md, the file list and the untrusted
+ * content warning. Nothing is installed until the user posts to
+ * /api/library/skills/install.
+ */
+
+import { NextResponse } from "next/server";
+
+import {
+  NO_STORE,
+  libraryErrorResponse,
+  libraryOwner,
+  readJson,
+  unauthorized,
+} from "../../../../../lib/library/api";
+import {
+  stageSkillFromCatalog,
+  stageSkillFromEditor,
+  stageSkillFromUrl,
+  stageSkillFromZip,
+} from "../../../../../lib/library/skills/import";
+import { ZIP_LIMITS } from "../../../../../lib/library/skills/zip";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+function asRecord(value: unknown): Record<string, unknown> {
+  return value && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : {};
+}
+
+export async function POST(request: Request): Promise<NextResponse> {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    const contentType = request.headers.get("content-type") ?? "";
+    if (contentType.includes("multipart/form-data")) {
+      const declared = Number(request.headers.get("content-length") ?? "0") || 0;
+      if (declared > ZIP_LIMITS.maxArchiveBytes) {
+        return NextResponse.json(
+          { error: "The archive is larger than the 16 MB limit." },
+          { status: 413, headers: NO_STORE },
+        );
+      }
+      const form = await request.formData();
+      const file = form.get("file");
+      if (!file || typeof file === "string") {
+        return NextResponse.json({ error: "No archive was uploaded." }, { status: 400, headers: NO_STORE });
+      }
+      const arrayBuffer = await file.arrayBuffer();
+      if (arrayBuffer.byteLength > ZIP_LIMITS.maxArchiveBytes) {
+        return NextResponse.json(
+          { error: "The archive is larger than the 16 MB limit." },
+          { status: 413, headers: NO_STORE },
+        );
+      }
+      const preview = stageSkillFromZip(owner, Buffer.from(arrayBuffer));
+      return NextResponse.json({ preview }, { status: 201, headers: NO_STORE });
+    }
+
+    const body = asRecord(await readJson(request));
+    const source = typeof body.source === "string" ? body.source : "";
+    if (source === "catalog") {
+      const catalogId = typeof body.catalogId === "string" ? body.catalogId : "";
+      if (!catalogId) {
+        return NextResponse.json({ error: "Pick a skill from the catalog." }, { status: 400, headers: NO_STORE });
+      }
+      const preview = await stageSkillFromCatalog(owner, catalogId);
+      return NextResponse.json({ preview }, { status: 201, headers: NO_STORE });
+    }
+    if (source === "url") {
+      const url = typeof body.url === "string" ? body.url : "";
+      if (!url) {
+        return NextResponse.json({ error: "Paste the URL of a skill." }, { status: 400, headers: NO_STORE });
+      }
+      const preview = await stageSkillFromUrl(owner, url);
+      return NextResponse.json({ preview }, { status: 201, headers: NO_STORE });
+    }
+    if (source === "editor") {
+      const files = asRecord(body.files);
+      const textFiles: Record<string, string> = {};
+      for (const [name, content] of Object.entries(files)) {
+        if (typeof content !== "string") continue;
+        if (name.length > 256 || content.length > 512 * 1024) continue;
+        textFiles[name] = content;
+      }
+      const preview = stageSkillFromEditor(owner, {
+        name: typeof body.name === "string" ? body.name : "",
+        description: typeof body.description === "string" ? body.description : "",
+        markdown: typeof body.markdown === "string" ? body.markdown : "",
+        license: typeof body.license === "string" ? body.license : "",
+        category: typeof body.category === "string" ? body.category : "",
+        files: textFiles,
+      });
+      return NextResponse.json({ preview }, { status: 201, headers: NO_STORE });
+    }
+    return NextResponse.json(
+      { error: "Unknown import source." },
+      { status: 400, headers: NO_STORE },
+    );
+  } catch (error) {
+    return libraryErrorResponse(error);
+  }
+}
