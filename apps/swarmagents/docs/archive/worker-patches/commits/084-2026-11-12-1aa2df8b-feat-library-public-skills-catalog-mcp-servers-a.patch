--- /dev/null
+++ b/apps/swarmagents/lib/library/skills/zip.test.ts
@@ -0,0 +1,159 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import zlib from "node:zlib";
+
+import { ZIP_LIMITS, ZipError, extractZipFiles, readZipEntries, safeArchivePath, stripCommonRoot } from "./zip";
+
+/** Build a zip archive (stored, no compression) for the tests. */
+function makeZip(entries: Array<{ name: string; content: string | Buffer; deflate?: boolean }>): Buffer {
+  const locals: Buffer[] = [];
+  const centrals: Buffer[] = [];
+  let offset = 0;
+  for (const entry of entries) {
+    const name = Buffer.from(entry.name, "utf-8");
+    const raw = Buffer.isBuffer(entry.content) ? entry.content : Buffer.from(entry.content, "utf-8");
+    const compressed = entry.deflate ? zlib.deflateRawSync(raw) : raw;
+    const method = entry.deflate ? 8 : 0;
+    const crc = crc32(raw);
+    const local = Buffer.alloc(30);
+    local.writeUInt32LE(0x04034b50, 0);
+    local.writeUInt16LE(20, 4);
+    local.writeUInt16LE(0, 6);
+    local.writeUInt16LE(method, 8);
+    local.writeUInt32LE(crc, 14);
+    local.writeUInt32LE(compressed.length, 18);
+    local.writeUInt32LE(raw.length, 22);
+    local.writeUInt16LE(name.length, 26);
+    locals.push(local, name, compressed);
+
+    const central = Buffer.alloc(46);
+    central.writeUInt32LE(0x02014b50, 0);
+    central.writeUInt16LE(20, 4);
+    central.writeUInt16LE(20, 6);
+    central.writeUInt16LE(method, 10);
+    central.writeUInt32LE(crc, 16);
+    central.writeUInt32LE(compressed.length, 20);
+    central.writeUInt32LE(raw.length, 24);
+    central.writeUInt16LE(name.length, 28);
+    central.writeUInt32LE(offset, 42);
+    centrals.push(central, name);
+    offset += local.length + name.length + compressed.length;
+  }
+  const centralBuffer = Buffer.concat(centrals);
+  const eocd = Buffer.alloc(22);
+  eocd.writeUInt32LE(0x06054b50, 0);
+  eocd.writeUInt16LE(entries.length, 8);
+  eocd.writeUInt16LE(entries.length, 10);
+  eocd.writeUInt32LE(centralBuffer.length, 12);
+  eocd.writeUInt32LE(offset, 16);
+  return Buffer.concat([...locals, centralBuffer, eocd]);
+}
+
+function crc32(buffer: Buffer): number {
+  let crc = 0xffffffff;
+  for (const byte of buffer) {
+    crc ^= byte;
+    for (let bit = 0; bit < 8; bit += 1) {
+      crc = crc & 1 ? (crc >>> 1) ^ 0xedb88320 : crc >>> 1;
+    }
+  }
+  return (crc ^ 0xffffffff) >>> 0;
+}
+
+test("a normal archive is extracted", () => {
+  const zip = makeZip([
+    { name: "SKILL.md", content: "---\nname: demo\ndescription: d\n---\nbody" },
+    { name: "scripts/run.sh", content: "echo hi" },
+  ]);
+  const files = extractZipFiles(zip);
+  assert.equal(files["SKILL.md"].includes("name: demo"), true);
+  assert.equal(files["scripts/run.sh"], "echo hi");
+});
+
+test("a deflated archive is extracted", () => {
+  const body = "The agent reads a PDF and merges the pages.\n".repeat(120);
+  const zip = makeZip([{ name: "SKILL.md", content: body, deflate: true }]);
+  const files = extractZipFiles(zip);
+  assert.equal(files["SKILL.md"].length, body.length);
+});
+
+test("zip slip is refused (path traversal)", () => {
+  for (const name of ["../escape.md", "a/../../escape.md", "/etc/passwd", "..\\windows.md"]) {
+    const zip = makeZip([{ name, content: "x" }]);
+    assert.throws(
+      () => extractZipFiles(zip),
+      (error: unknown) => error instanceof ZipError && error.code === "unsafe_path",
+      `expected ${name} to be refused`,
+    );
+  }
+});
+
+test("a symlink entry is refused", () => {
+  const zip = makeZip([{ name: "link", content: "/etc/passwd" }]);
+  // Turn the entry into a symlink (unix mode 0o120000 in the external attrs).
+  const central = zip.lastIndexOf(Buffer.from([0x50, 0x4b, 0x01, 0x02]));
+  zip.writeUInt32LE((0o120777 << 16) >>> 0, central + 38);
+  assert.throws(
+    () => extractZipFiles(zip),
+    (error: unknown) => error instanceof ZipError && error.code === "unsafe_path",
+  );
+});
+
+test("too many entries are refused", () => {
+  const entries = Array.from({ length: ZIP_LIMITS.maxEntries + 5 }, (_, index) => ({
+    name: `file-${index}.md`,
+    content: "x",
+  }));
+  const zip = makeZip(entries);
+  assert.throws(
+    () => extractZipFiles(zip),
+    (error: unknown) => error instanceof ZipError && error.code === "too_many_entries",
+  );
+});
+
+test("a file over the size cap is refused", () => {
+  const zip = makeZip([{ name: "big.md", content: "x".repeat(ZIP_LIMITS.maxFileBytes + 16) }]);
+  assert.throws(
+    () => extractZipFiles(zip),
+    (error: unknown) => error instanceof ZipError && error.code === "too_large",
+  );
+});
+
+test("a zip bomb is refused (compression ratio)", () => {
+  const zip = makeZip([
+    { name: "bomb.txt", content: "0".repeat(ZIP_LIMITS.maxFileBytes), deflate: true },
+  ]);
+  assert.throws(
+    () => extractZipFiles(zip),
+    (error: unknown) => error instanceof ZipError && error.code === "too_large",
+  );
+});
+
+test("a file that is not a zip is refused", () => {
+  assert.throws(
+    () => extractZipFiles(Buffer.from("not a zip at all")),
+    (error: unknown) => error instanceof ZipError && error.code === "not_a_zip",
+  );
+});
+
+test("safeArchivePath normalizes and refuses escapes", () => {
+  assert.equal(safeArchivePath("skills/pdf/SKILL.md"), "skills/pdf/SKILL.md");
+  assert.equal(safeArchivePath("./skills//pdf/SKILL.md"), "skills/pdf/SKILL.md");
+  assert.throws(() => safeArchivePath("../x"), ZipError);
+  assert.throws(() => safeArchivePath("/x"), ZipError);
+});
+
+test("the common root folder is stripped", () => {
+  const stripped = stripCommonRoot({
+    "my-skill/SKILL.md": "a",
+    "my-skill/scripts/run.sh": "b",
+  });
+  assert.deepEqual(Object.keys(stripped).sort(), ["SKILL.md", "scripts/run.sh"]);
+});
+
+test("the central directory is readable", () => {
+  const zip = makeZip([{ name: "a.md", content: "x" }]);
+  const entries = readZipEntries(zip);
+  assert.equal(entries.length, 1);
+  assert.equal(entries[0].name, "a.md");
+});
