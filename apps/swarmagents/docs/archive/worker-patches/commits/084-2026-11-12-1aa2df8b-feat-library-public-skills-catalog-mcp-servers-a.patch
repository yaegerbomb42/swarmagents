@@ -0,0 +1,65 @@
+/**
+ * Install a staged skill, or discard the staged import.
+ *
+ * POST /api/library/skills/install   { "id": "<staged id>" }
+ * DELETE /api/library/skills/install?id=<staged id>
+ */
+
+import { NextResponse } from "next/server";
+
+import {
+  NO_STORE,
+  libraryErrorResponse,
+  libraryOwner,
+  readJson,
+  unauthorized,
+} from "../../../../../lib/library/api";
+import {
+  discardStagedSkill,
+  installStagedSkill,
+  listStagedSkills,
+} from "../../../../../lib/library/skills/import";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+export async function GET(request: Request): Promise<NextResponse> {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    return NextResponse.json({ staged: listStagedSkills(owner) }, { headers: NO_STORE });
+  } catch (error) {
+    return libraryErrorResponse(error);
+  }
+}
+
+export async function POST(request: Request): Promise<NextResponse> {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    const body = (await readJson(request)) as { id?: unknown } | null;
+    const id = typeof body?.id === "string" ? body.id : "";
+    if (!id) {
+      return NextResponse.json({ error: "Which import should be installed?" }, { status: 400, headers: NO_STORE });
+    }
+    const skill = installStagedSkill(owner, id);
+    return NextResponse.json({ skill }, { status: 201, headers: NO_STORE });
+  } catch (error) {
+    return libraryErrorResponse(error);
+  }
+}
+
+export async function DELETE(request: Request): Promise<NextResponse> {
+  const owner = libraryOwner(request);
+  if (!owner) return unauthorized();
+  try {
+    const id = new URL(request.url).searchParams.get("id") ?? "";
+    if (!id) {
+      return NextResponse.json({ error: "Which import should be discarded?" }, { status: 400, headers: NO_STORE });
+    }
+    const removed = discardStagedSkill(owner, id);
+    return NextResponse.json({ removed }, { headers: NO_STORE });
+  } catch (error) {
+    return libraryErrorResponse(error);
+  }
+}
