index 000000000..46447d226
--- /dev/null
+++ b/apps/swarmagents/lib/library/skills/import.test.ts
@@ -0,0 +1,143 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+
+import {
+  discardStagedSkill,
+  installStagedSkill,
+  listStagedSkills,
+  scriptFiles,
+  stageSkill,
+  stageSkillFromEditor,
+  stageSkillFromZip,
+  UNTRUSTED_WARNING,
+} from "./import";
+import { listInstalledSkills } from "../store";
+
+let counter = 0;
+function account(): string {
+  counter += 1;
+  return `importer-${counter}@example.com`;
+}
+
+const SKILL_MD = "---\nname: demo\ndescription: A demo skill for the tests.\n---\n\nBody of the skill.\n";
+
+test("a staged import shows the content and the untrusted warning", () => {
+  const user = account();
+  const preview = stageSkill(user, {
+    origin: "editor",
+    files: { "SKILL.md": SKILL_MD, "scripts/run.sh": "echo hi\n" },
+    sourceLabel: "test",
+  });
+  assert.equal(preview.name, "demo");
+  assert.equal(preview.description, "A demo skill for the tests.");
+  assert.equal(preview.warning, UNTRUSTED_WARNING);
+  assert.match(preview.warning, /Untrusted content/);
+  assert.equal(preview.skillMarkdown, SKILL_MD);
+  assert.deepEqual(preview.scripts, ["scripts/run.sh"]);
+  assert.equal(preview.files.length, 2);
+  assert.equal(listStagedSkills(user).length, 1);
+  // Nothing is installed before the user accepts.
+  assert.equal(listInstalledSkills(user).length, 0);
+});
+
+test("installing a staged import writes the skill", () => {
+  const user = account();
+  const preview = stageSkill(user, {
+    origin: "editor",
+    files: { "SKILL.md": SKILL_MD, "scripts/run.sh": "echo hi\n" },
+  });
+  const skill = installStagedSkill(user, preview.id);
+  assert.equal(skill.id, "demo");
+  assert.equal(skill.origin, "editor");
+  assert.equal(skill.reviewed, true);
+  assert.equal(listInstalledSkills(user).length, 1);
+  // The staged import is consumed.
+  assert.equal(listStagedSkills(user).length, 0);
+});
+
+test("a staged import can be discarded", () => {
+  const user = account();
+  const preview = stageSkill(user, { origin: "editor", files: { "SKILL.md": SKILL_MD } });
+  assert.equal(discardStagedSkill(user, preview.id), true);
+  assert.equal(listStagedSkills(user).length, 0);
+  assert.equal(listInstalledSkills(user).length, 0);
+});
+
+test("the staged imports of one account are not visible to another", () => {
+  const alice = account();
+  const bob = account();
+  stageSkill(alice, { origin: "editor", files: { "SKILL.md": SKILL_MD } });
+  assert.equal(listStagedSkills(alice).length, 1);
+  assert.equal(listStagedSkills(bob).length, 0);
+});
+
+test("a broken skill is refused before it is staged", () => {
+  const user = account();
+  assert.throws(() => stageSkill(user, { origin: "editor", files: { "readme.md": "x" } }));
+  assert.throws(() =>
+    stageSkill(user, { origin: "editor", files: { "SKILL.md": "no frontmatter here" } }),
+  );
+  assert.equal(listStagedSkills(user).length, 0);
+});
+
+test("the editor flow builds a SKILL.md from the form", () => {
+  const user = account();
+  const preview = stageSkillFromEditor(user, {
+    name: "My Skill",
+    description: "Does a useful thing.",
+    markdown: "Instructions for the agent.",
+  });
+  assert.equal(preview.id, "my-skill");
+  assert.match(preview.skillMarkdown, /name: my-skill/);
+  assert.match(preview.skillMarkdown, /description: Does a useful thing./);
+  assert.match(preview.skillMarkdown, /Instructions for the agent./);
+});
+
+test("a zip upload is staged (and a zip slip is refused)", () => {
+  const user = account();
+  const preview = stageSkillFromZip(user, makeZip([{ name: "SKILL.md", content: SKILL_MD }]));
+  assert.equal(preview.name, "demo");
+  assert.equal(preview.origin, "zip");
+
+  assert.throws(() => stageSkillFromZip(user, makeZip([{ name: "../evil.md", content: "x" }])));
+});
+
+test("the script list marks the files that can execute code", () => {
+  assert.deepEqual(scriptFiles(["SKILL.md", "scripts/run.sh", "references/notes.md"]), [
+    "scripts/run.sh",
+  ]);
+  assert.deepEqual(scriptFiles(["SKILL.md", "tool.py"]), ["tool.py"]);
+});
+
+/** A tiny zip writer (stored entries) for the tests. */
+function makeZip(entries: Array<{ name: string; content: string }>): Buffer {
+  const locals: Buffer[] = [];
+  const centrals: Buffer[] = [];
+  let offset = 0;
+  for (const entry of entries) {
+    const name = Buffer.from(entry.name, "utf-8");
+    const data = Buffer.from(entry.content, "utf-8");
+    const local = Buffer.alloc(30);
+    local.writeUInt32LE(0x04034b50, 0);
+    local.writeUInt32LE(data.length, 18);
+    local.writeUInt32LE(data.length, 22);
+    local.writeUInt16LE(name.length, 26);
+    locals.push(local, name, data);
+    const central = Buffer.alloc(46);
+    central.writeUInt32LE(0x02014b50, 0);
+    central.writeUInt32LE(data.length, 20);
+    central.writeUInt32LE(data.length, 24);
+    central.writeUInt16LE(name.length, 28);
+    central.writeUInt32LE(offset, 42);
+    centrals.push(central, name);
+    offset += local.length + name.length + data.length;
+  }
+  const centralBuffer = Buffer.concat(centrals);
+  const eocd = Buffer.alloc(22);
+  eocd.writeUInt32LE(0x06054b50, 0);
+  eocd.writeUInt16LE(entries.length, 8);
+  eocd.writeUInt16LE(entries.length, 10);
+  eocd.writeUInt32LE(centralBuffer.length, 12);
+  eocd.writeUInt32LE(offset, 16);
+  return Buffer.concat([...locals, centralBuffer, eocd]);
+}
diff --git a/apps/swarmagents/lib/library/skills/import.ts b/apps/swarmagents/lib/library/skills/import.ts
new file mode 100644
index 000000000..f8f5d5b48
--- /dev/null
+++ b/apps/swarmagents/lib/library/skills/import.ts
@@ -0,0 +1,460 @@
+/**
+ * Importing skills into the user's library.
+ *
+ * A skill can come from four places:
+ *
+ *   (a) the public catalog (a real skill from a verified public repository),
+ *   (b) a GitHub URL the user pasted,
+ *   (c) a zip archive the user uploaded,
+ *   (d) the in-app editor.
+ *
+ * All four end in the same place: the content is *staged* first. The user
+ * sees the SKILL.md, the file list and the untrusted-content warning, and
+ * only then installs it. Nothing is executed and nothing is written into the
+ * user's VM before that confirmation.
+ */
+
+import fs from "node:fs";
+import path from "node:path";
+
+import {
+  LibraryError,
+  installSkill,
+  readLibraryState,
+  userLibraryDir,
+  writeLibraryState,
+  type DataDirOptions,
+  type InstalledSkill,
+  type SkillOrigin,
+} from "../store";
+import { catalogSkill } from "../catalog";
+import {
+  SKILL_LIMITS,
+  findSkillFile,
+  parseSkillDocument,
+  renderSkillDocument,
+  slugifySkillName,
+  validateSkill,
+} from "./format";
+import {
+  fetchRepoTree,
+  fetchSkillFolder,
+  findSkillFolders,
+  parseGitHubUrl,
+  scanRepoTarballForFolders,
+  type GitHubTarget,
+} from "./github";
+import { extractZipFiles, stripCommonRoot, ZipError } from "./zip";
+
+/** The warning shown next to every untrusted skill body. */
+export const UNTRUSTED_WARNING =
+  "Untrusted content — review the scripts below before installing. A skill can run code inside your VM.";
+
+/** The directory that holds one user's staged imports. */
+export function stagingDir(userId: string, options: DataDirOptions = {}): string {
+  return path.join(userLibraryDir(userId, options), "staging");
+}
+
+/** A staged import: the preview the user has to accept. */
+export interface StagedSkill {
+  id: string;
+  origin: SkillOrigin;
+  name: string;
+  description: string;
+  version: string;
+  license: string;
+  category: string;
+  sourceUrl: string;
+  sourceLabel: string;
+  files: Array<{ path: string; bytes: number }>;
+  totalBytes: number;
+  /** The SKILL.md the user is asked to review. */
+  skillMarkdown: string;
+  /** The scripts the skill would run inside the VM. */
+  scripts: string[];
+  /** The warning shown above the content. */
+  warning: string;
+  createdAt: number;
+}
+
+/** The staged import on disk (the preview plus the file contents). */
+interface StagedFile extends StagedSkill {
+  contents: Record<string, string>;
+  /** The owner of the staging file (a file of another account is ignored). */
+  userId?: string;
+}
+
+const SCRIPT_EXTENSIONS = [".sh", ".bash", ".zsh", ".py", ".js", ".mjs", ".cjs", ".ts", ".rb", ".pl", ".sh"];
+
+/** The files of a skill that could execute code. */
+export function scriptFiles(files: readonly string[]): string[] {
+  return files.filter((file) => {
+    const lower = file.toLowerCase();
+    if (lower.startsWith("scripts/")) return true;
+    return SCRIPT_EXTENSIONS.some((extension) => lower.endsWith(extension));
+  });
+}
+
+/** Read the staged imports of one user (newest first). */
+export function listStagedSkills(userId: string, options: DataDirOptions = {}): StagedSkill[] {
+  const dir = stagingDir(userId, options);
+  if (!fs.existsSync(dir)) return [];
+  const out: StagedSkill[] = [];
+  for (const name of fs.readdirSync(dir)) {
+    if (!name.endsWith(".json")) continue;
+    try {
+      const parsed = JSON.parse(fs.readFileSync(path.join(dir, name), "utf-8")) as StagedFile;
+      if (parsed.userId && parsed.userId !== userId) continue;
+      const { contents: _contents, userId: _owner, ...preview } = parsed;
+      out.push(preview);
+    } catch {
+      /* ignore a broken staging file */
+    }
+  }
+  return out.sort((a, b) => b.createdAt - a.createdAt);
+}
+
+/** One staged import (with its contents) — internal. */
+function readStaged(userId: string, id: string, options: DataDirOptions = {}): StagedFile | null {
+  const file = path.join(stagingDir(userId, options), `${id}.json`);
+  if (!fs.existsSync(file)) return null;
+  try {
+    const parsed = JSON.parse(fs.readFileSync(file, "utf-8")) as StagedFile & { userId?: string };
+    if (parsed.userId && parsed.userId !== userId) return null;
+    return parsed;
+  } catch {
+    return null;
+  }
+}
+
+/** One staged import (the preview only). */
+export function getStagedSkill(userId: string, id: string, options: DataDirOptions = {}): StagedSkill | null {
+  const staged = readStaged(userId, id, options);
+  if (!staged) return null;
+  const { contents: _contents, ...preview } = staged;
+  return preview;
+}
+
+/** Drop a staged import. */
+export function discardStagedSkill(userId: string, id: string, options: DataDirOptions = {}): boolean {
+  const file = path.join(stagingDir(userId, options), `${id}.json`);
+  if (!fs.existsSync(file)) return false;
+  try {
+    fs.rmSync(file, { force: true });
+  } catch {
+    return false;
+  }
+  return true;
+}
+
+/** Keep at most 20 staged imports per user. */
+function pruneStaging(userId: string, options: DataDirOptions = {}): void {
+  const staged = listStagedSkills(userId, options);
+  for (const entry of staged.slice(20)) {
+    discardStagedSkill(userId, entry.id, options);
+  }
+}
+
+/**
+ * Stage a skill: validate the files, build the preview and store it until the
+ * user accepts it.
+ */
+export function stageSkill(
+  userId: string,
+  input: {
+    origin: SkillOrigin;
+    files: Record<string, string>;
+    sourceUrl?: string;
+    sourceLabel?: string;
+    category?: string;
+    license?: string;
+    id?: string;
+  },
+  options: DataDirOptions = {},
+): StagedSkill {
+  const files = input.files ?? {};
+  let validated;
+  try {
+    validated = validateSkill(files, { id: input.id });
+  } catch (error) {
+    if (error instanceof Error && error.name === "SkillFormatError") {
+      throw new LibraryError(error.message, 400, "invalid_skill");
+    }
+    throw error;
+  }
+  const skillPath = findSkillFile(files) ?? "SKILL.md";
+  const markdown = files[skillPath] ?? "";
+  const document = parseSkillDocument(markdown);
+  const names = Object.keys(files);
+  const totalBytes = Object.values(files).reduce((sum, content) => sum + Buffer.byteLength(content, "utf-8"), 0);
+  const id = slugifySkillName(input.id || validated.name);
+  const staged: StagedFile = {
+    id,
+    origin: input.origin,
+    name: validated.name,
+    description: validated.description,
+    version: document.version,
+    license: input.license || document.license || "unknown",
+    category: input.category || "other",
+    sourceUrl: input.sourceUrl ?? "",
+    sourceLabel: input.sourceLabel ?? "",
+    files: names
+      .map((file) => ({ path: file, bytes: Buffer.byteLength(files[file] ?? "", "utf-8") }))
+      .sort((a, b) => a.path.localeCompare(b.path)),
+    totalBytes,
+    skillMarkdown: markdown,
+    scripts: scriptFiles(names),
+    warning: UNTRUSTED_WARNING,
+    createdAt: Date.now(),
+    contents: files,
+  };
+  const dir = stagingDir(userId, options);
+  fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
+  const file = path.join(dir, `${id}.json`);
+  fs.writeFileSync(file, `${JSON.stringify({ ...staged, userId }, null, 2)}\n`, {
+    encoding: "utf-8",
+    mode: 0o600,
+  });
+  pruneStaging(userId, options);
+  const { contents: _contents, ...preview } = staged;
+  return preview;
+}
+
+/** Stage a skill from the public catalog. */
+export async function stageSkillFromCatalog(
+  userId: string,
+  catalogId: string,
+  options: DataDirOptions = {},
+): Promise<StagedSkill> {
+  const entry = catalogSkill(catalogId);
+  if (!entry) throw new LibraryError("That skill is not in the catalog.", 404, "not_found");
+  const remote = await fetchSkillFolder(entry.repo, entry.branch, entry.path, options);
+  return stageSkill(
+    userId,
+    {
+      origin: "catalog",
+      files: remote.files,
+      sourceUrl: remote.sourceUrl,
+      sourceLabel: entry.sourceName,
+      category: entry.category,
+      license: entry.license,
+      id: slugifySkillName(entry.name),
+    },
+    options,
+  );
+}
+
+/** Stage a skill from a GitHub URL. */
+export async function stageSkillFromUrl(
+  userId: string,
+  url: string,
+  options: DataDirOptions = {},
+): Promise<StagedSkill> {
+  const target = parseGitHubUrl(url);
+  if (!target) {
+    throw new LibraryError(
+      "That does not look like a GitHub URL. Paste a link to a skill folder, a SKILL.md file or a repository.",
+      400,
+      "invalid_url",
+    );
+  }
+  return stageSkillFromTarget(userId, target, options);
+}
+
+/** Stage a skill from a parsed GitHub target. */
+export async function stageSkillFromTarget(
+  userId: string,
+  target: GitHubTarget,
+  options: DataDirOptions = {},
+): Promise<StagedSkill> {
+  const { repo, ref } = target;
+  const resolved = await resolveRef(repo, ref, options);
+  let folder = target.path;
+  if (target.kind === "file") {
+    folder = target.path.replace(/(^|\/)SKILL\.md$/i, "").replace(/\/$/, "");
+  }
+  if (!folder) {
+    // No folder in the URL: find the skill folder(s) inside the repository.
+    const folders = await findSkillFoldersRemote(repo, resolved, options);
+    if (folders.length === 0) {
+      throw new LibraryError(`There is no SKILL.md in ${repo}.`, 400, "no_skill_md");
+    }
+    if (folders.length > 1) {
+      throw new LibraryError(
+        `${repo} contains ${folders.length} skills. Paste the URL of the skill folder you want.`,
+        400,
+        "many_skills",
+      );
+    }
+    folder = folders[0] ?? "";
+  }
+  const remote = await fetchSkillFolder(repo, resolved, folder, options);
+  return stageSkill(
+    userId,
+    {
+      origin: "github",
+      files: remote.files,
+      sourceUrl: remote.sourceUrl,
+      sourceLabel: `${repo}`,
+      category: "other",
+      license: "unknown",
+    },
+    options,
+  );
+}
+
+/** Stage a skill from an uploaded zip archive. */
+export function stageSkillFromZip(
+  userId: string,
+  archive: Buffer,
+  options: DataDirOptions = {},
+): StagedSkill {
+  let files: Record<string, string>;
+  try {
+    files = extractZipFiles(archive);
+  } catch (error) {
+    if (error instanceof ZipError) {
+      const status = error.code === "too_large" ? 413 : 400;
+      throw new LibraryError(error.message, status, error.code);
+    }
+    throw error;
+  }
+  const stripped = stripCommonRoot(files);
+  return stageSkill(
+    userId,
+    {
+      origin: "zip",
+      files: stripped,
+      sourceLabel: "Uploaded archive",
+      category: "other",
+      license: "unknown",
+    },
+    options,
+  );
+}
+
+/** Stage a skill the user wrote in the in-app editor. */
+export function stageSkillFromEditor(
+  userId: string,
+  input: {
+    name?: string;
+    description?: string;
+    markdown?: string;
+    files?: Record<string, string>;
+    license?: string;
+    category?: string;
+  },
+  options: DataDirOptions = {},
+): StagedSkill {
+  const name = slugifySkillName(input.name ?? "");
+  if (!name) throw new LibraryError("The skill needs a name.", 400, "invalid_name");
+  const description = (input.description ?? "").trim();
+  if (!description) {
+    throw new LibraryError("The skill needs a description.", 400, "invalid_description");
+  }
+  const written = (input.markdown ?? "").trim();
+  // A pasted SKILL.md keeps its own frontmatter; a plain body gets one.
+  const markdown = written.startsWith("---")
+    ? written
+    : renderSkillDocument({ name, description, body: written });
+  const files: Record<string, string> = { "SKILL.md": markdown };
+  for (const [file, content] of Object.entries(input.files ?? {})) {
+    if (file === "SKILL.md") continue;
+    files[file] = content;
+  }
+  return stageSkill(
+    userId,
+    {
+      origin: "editor",
+      files,
+      sourceLabel: "Written in the editor",
+      category: input.category ?? "other",
+      license: input.license ?? "unknown",
+      id: name,
+    },
+    options,
+  );
+}
+
+/** Install a staged import for one user. */
+export function installStagedSkill(
+  userId: string,
+  id: string,
+  options: DataDirOptions = {},
+): InstalledSkill {
+  const staged = readStaged(userId, id, options);
+  if (!staged) throw new LibraryError("That import is no longer available.", 404, "not_found");
+  const skill = installSkill(
+    userId,
+    {
+      id: staged.id,
+      name: staged.name,
+      description: staged.description,
+      version: staged.version,
+      license: staged.license,
+      category: staged.category,
+      origin: staged.origin,
+      sourceUrl: staged.sourceUrl,
+      sourceLabel: staged.sourceLabel,
+      files: staged.contents,
+      reviewed: true,
+    },
+    options,
+  );
+  discardStagedSkill(userId, id, options);
+  return skill;
+}
+
+/** Resolve a ref ("HEAD", a branch or a tag) to a concrete branch name. */
+async function resolveRef(repo: string, ref: string, options: DataDirOptions = {}): Promise<string> {
+  if (ref && ref !== "HEAD") return ref;
+  // "HEAD" means the default branch of the repository.
+  const meta = await fetchRepoMeta(repo);
+  return meta.default_branch ?? "main";
+}
+
+/**
+ * The skill folders of a repository. The GitHub API is used first; when it
+ * is rate limited the repository tarball is read instead.
+ */
+async function findSkillFoldersRemote(
+  repo: string,
+  ref: string,
+  options: DataDirOptions = {},
+): Promise<string[]> {
+  try {
+    return findSkillFolders(await fetchRepoTree(repo, ref, options));
+  } catch (error) {
+    if (error instanceof LibraryError && error.code === "github_error") {
+      const scan = await scanRepoTarballForFolders(repo, ref);
+      return scan.skillFolders;
+    }
+    throw error;
+  }
+}
+
+/** The metadata of a repository (used for the default branch). */
+async function fetchRepoMeta(repo: string): Promise<{ default_branch?: string }> {
+  try {
+    const response = await fetch(`https://api.github.com/repos/${repo}`, {
+      headers: {
+        "user-agent": "swarmagents-library",
+        accept: "application/vnd.github+json",
+        ...(process.env.GITHUB_TOKEN ? { authorization: `Bearer ${process.env.GITHUB_TOKEN}` } : {}),
+      },
+      signal: AbortSignal.timeout(20_000),
+    });
+    if (!response.ok) return {};
+    const payload = (await response.json()) as { default_branch?: string };
+    return payload;
+  } catch {
+    return {};
+  }
+}
+
+/** The number of skills a user has installed. */
+export function installedSkillCount(userId: string, options: DataDirOptions = {}): number {
+  return Object.keys(readLibraryState(userId, options).skills).length;
+}
+
+export { SKILL_LIMITS };
