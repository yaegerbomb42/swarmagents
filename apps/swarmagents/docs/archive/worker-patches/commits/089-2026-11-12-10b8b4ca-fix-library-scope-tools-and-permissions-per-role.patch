+test("roleAllowedTools grants library servers assigned to the role (and the tools server)", () => {
+  const role = mainRole();
+  const withLibrary = { ...role, mcpServers: [...role.mcpServers, "my-own-mcp"] };
+  const tools = roleAllowedTools(withLibrary, { extraMcpServers: ["my-own-mcp", "library"] });
+  assert.ok(tools.includes("mcp__my-own-mcp__*"), "a user-installed server keeps its permission");
+  assert.ok(tools.includes("mcp__library__*"), "the custom tools server is callable");
+  // A server the role did not name is not granted just because it exists.
+  const withoutIt = roleAllowedTools({ ...role, mcpServers: [] }, { extraMcpServers: ["library"] });
+  assert.ok(!withoutIt.includes("mcp__my-own-mcp__*"));
+  assert.ok(withoutIt.includes("mcp__library__*"));
+});
+
