 /** One staged import (with its contents) — internal. */
+function stagingFile(userId: string, id: string, options: DataDirOptions = {}): string | null {
+  // A staged id is always a slug. Refusing anything else keeps a caller from
+  // walking out of the staging folder with id="../../something".
+  if (!/^[a-z0-9][a-z0-9-]{0,63}$/.test(id)) return null;
+  return path.join(stagingDir(userId, options), `${id}.json`);
+}
+
