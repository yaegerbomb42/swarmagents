@@ -0,0 +1,85 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+
+import { buildLibraryRunContext, LIBRARY_TOOLS_SERVER_NAME } from "./harness-bridge";
+import { installSkill, installTool, setRoleAssignments } from "./store";
+import { addMcpServer } from "./mcp/store";
+import { VM_TOOLS_MANIFEST } from "./skills/vm-sync";
+
+let counter = 0;
+function account(): string {
+  counter += 1;
+  return `bridge-${counter}@example.com`;
+}
+
+test("a role only gets the custom tools assigned to it", () => {
+  const user = account();
+  installTool(user, {
+    name: "assigned-tool",
+    description: "Assigned.",
+    files: { "tool.mjs": "// assigned" },
+  });
+  installTool(user, {
+    name: "other-tool",
+    description: "Not assigned.",
+    files: { "tool.mjs": "// other" },
+  });
+  setRoleAssignments(user, "main", { tools: ["assigned-tool"] });
+
+  const context = buildLibraryRunContext(user, "main");
+  assert.ok(context.extraServers[LIBRARY_TOOLS_SERVER_NAME], "the tools server is wired");
+  const manifest = context.extraFiles.find((file) => file.path === VM_TOOLS_MANIFEST);
+  assert.ok(manifest);
+  const parsed = JSON.parse(manifest.content) as { tools: Array<{ name: string }> };
+  assert.deepEqual(parsed.tools.map((tool) => tool.name), ["assigned-tool"]);
+  assert.equal(
+    context.extraFiles.some((file) => file.path.includes("/tools/other-tool/")),
+    false,
+    "the unassigned tool's script is never seeded",
+  );
+  assert.match(context.libraryNote, /assigned-tool/);
+  assert.doesNotMatch(context.libraryNote, /other-tool/);
+});
+
+test("a role with no assigned tools gets no tools server", () => {
+  const user = account();
+  installTool(user, { name: "unassigned", files: { "tool.mjs": "// tool" } });
+  const context = buildLibraryRunContext(user, "main");
+  assert.equal(context.extraServers[LIBRARY_TOOLS_SERVER_NAME], undefined);
+  assert.equal(context.extraFiles.some((file) => file.path === VM_TOOLS_MANIFEST), false);
+});
+
+test("a role only gets the MCP servers assigned to it", () => {
+  const user = account();
+  addMcpServer(user, { id: "assigned-mcp", name: "Assigned MCP", transport: "http", url: "https://a.example/mcp" });
+  addMcpServer(user, { id: "other-mcp", name: "Other MCP", transport: "http", url: "https://b.example/mcp" });
+  setRoleAssignments(user, "main", { mcpServers: ["assigned-mcp"] });
+
+  const context = buildLibraryRunContext(user, "main");
+  assert.ok(context.extraServers["assigned-mcp"]);
+  assert.equal(context.extraServers["other-mcp"], undefined);
+});
+
+test("a role only gets the skills assigned to it", () => {
+  const user = account();
+  installSkill(user, {
+    name: "assigned-skill",
+    description: "Assigned.",
+    origin: "editor",
+    files: { "SKILL.md": "---\nname: assigned-skill\ndescription: Assigned.\n---\n\nBody.\n" },
+  });
+  installSkill(user, {
+    name: "other-skill",
+    description: "Not assigned.",
+    origin: "editor",
+    files: { "SKILL.md": "---\nname: other-skill\ndescription: Not assigned.\n---\n\nBody.\n" },
+  });
+  setRoleAssignments(user, "main", { skills: ["assigned-skill"] });
+
+  const context = buildLibraryRunContext(user, "main");
+  assert.equal(
+    context.extraFiles.some((file) => file.path.includes("/assigned-skill/")),
+    true,
+  );
+  assert.equal(context.extraFiles.some((file) => file.path.includes("/other-skill/")), false);
+});
