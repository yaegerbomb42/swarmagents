index 000000000..83f9a468f
--- /dev/null
+++ b/apps/swarmagents/lib/library/catalog/service.ts
@@ -0,0 +1,332 @@
+/**
+ * l3 connect / test / disconnect service.
+ *
+ * Runs entirely against the l1 seam (lib/library/seam.ts): `ConnectorStore`
+ * for per-account persistence and `LibraryVmRunner` for execution inside
+ * the owning user's VM. l1 is not on main yet, so this file has no real
+ * store wired in — the tests use fakes, and l1 plugs in its implementation
+ * of the seam interfaces.
+ *
+ * Security rules enforced here:
+ * - A connection can only be opened/tested under its own ownerId; the
+ *   store's secret-box AAD binds sealed values to owner + connector +
+ *   field, so a copied ciphertext fails to open instead of working.
+ * - Plaintext field values are never logged and never appear in any
+ *   client-facing view (see `toClientView` — secrets are masked).
+ * - Secrets never appear in argv: the probe receives them via stdin/env
+ *   only (see buildServerCommand in connectors.ts).
+ * - A role (and the agent) can never get more than the user's settings
+ *   allow: `serversForRun` intersects connections with the policy
+ *   allowlist before handing anything to run wiring.
+ */
+
+import {
+  CONNECTORS,
+  buildServerCommand,
+  getConnector,
+  maskSecret,
+  missingRequiredFields,
+  type CatalogConnector,
+  type ServerCommand,
+} from "./connectors";
+import { MCP_PROBE_SOURCE } from "./probe-source";
+import {
+  MCP_PROBE_PATH,
+  isConnectorAllowed,
+  type ConnectorConnectionRecord,
+  type ConnectorPolicy,
+  type ConnectorStore,
+  type DiscoveredTool,
+  type LibraryVmRunner,
+} from "../seam";
+
+export interface ClientFieldView {
+  key: string;
+  label: string;
+  /** Masked value for secret fields, plaintext for non-secret fields. */
+  value: string;
+  secret: boolean;
+  required: boolean;
+}
+
+export interface ClientConnectionView {
+  id: string;
+  connectorId: string;
+  connectorName: string;
+  label: string;
+  fields: ClientFieldView[];
+  createdAt: number;
+  updatedAt: number;
+  lastTestedAt?: number;
+  lastTestedOk?: boolean;
+  /** Tools discovered by the last successful test (advertised list before then). */
+  tools: DiscoveredTool[];
+}
+
+export interface TestConnectionResult {
+  ok: boolean;
+  tools?: DiscoveredTool[];
+  error?: string;
+  testedAt: number;
+}
+
+export class ConnectorServiceError extends Error {
+  constructor(
+    message: string,
+    public readonly code:
+      | "not-found"
+      | "not-allowed"
+      | "needs-oauth"
+      | "missing-fields"
+      | "probe-failed",
+  ) {
+    super(message);
+    this.name = "ConnectorServiceError";
+  }
+}
+
+/** Connectors the user may add, honoring the settings allowlist. */
+export function allowedConnectors(policy: ConnectorPolicy | null | undefined): CatalogConnector[] {
+  return CONNECTORS.filter((c) => isConnectorAllowed(policy, c.id));
+}
+
+/**
+ * Client-safe view of a stored connection. Secret field values are masked;
+ * non-secret values (URLs, paths, usernames) are shown as stored. The
+ * sealed ciphertext is never exposed.
+ */
+export function toClientView(
+  record: ConnectorConnectionRecord,
+  values: Record<string, string>,
+  connector?: CatalogConnector,
+): ClientConnectionView {
+  const resolved: CatalogConnector = connector ?? getConnector(record.connectorId) ?? {
+    id: record.connectorId,
+    name: record.connectorId,
+    icon: "?",
+    description: "",
+    category: "",
+    run: { kind: "npx", package: "" },
+    fields: [],
+    tools: [],
+    verified: false,
+    source: "official",
+  };
+  const secretSet = new Set(record.secretFields);
+  return {
+    id: record.id,
+    connectorId: record.connectorId,
+    connectorName: resolved.name,
+    label: record.label,
+    fields: resolved.fields.map((f) => ({
+      key: f.key,
+      label: f.label,
+      value: secretSet.has(f.key) ? maskSecret(values[f.key] ?? "") : (values[f.key] ?? ""),
+      secret: f.secret,
+      required: f.required,
+    })),
+    createdAt: record.createdAt,
+    updatedAt: record.updatedAt,
+    lastTestedAt: record.lastTestedAt,
+    lastTestedOk: record.lastTestedOk,
+    tools: record.lastTools ?? resolved.tools,
+  };
+}
+
+function probeInput(command: ServerCommand): Record<string, unknown> {
+  if (command.kind === "remote") {
+    return {
+      kind: "remote",
+      url: command.url,
+      transport: command.transport,
+      headers: command.headers,
+    };
+  }
+  return {
+    kind: "stdio",
+    command: command.command,
+    args: command.args,
+    env: command.env,
+  };
+}
+
+/**
+ * Run the probe inside the user's VM and return the discovered tools.
+ * The probe script is seeded into the VM first; the server command, args
+ * and env travel on stdin — secrets never appear in argv.
+ */
+export async function probeServer(
+  runner: LibraryVmRunner,
+  ownerId: string,
+  command: ServerCommand,
+): Promise<TestConnectionResult> {
+  const testedAt = Date.now();
+  await runner.writeFile(ownerId, MCP_PROBE_PATH, MCP_PROBE_SOURCE);
+  const result = await runner.exec(ownerId, ["node", MCP_PROBE_PATH], {
+    stdin: JSON.stringify(probeInput(command)),
+    timeoutMs: 120_000,
+  });
+  const line = result.stdout
+    .split("\n")
+    .map((l) => l.trim())
+    .find((l) => l.startsWith("{"));
+  if (line) {
+    try {
+      const parsed = JSON.parse(line) as { ok: boolean; tools?: DiscoveredTool[]; error?: string };
+      if (parsed.ok) return { ok: true, tools: parsed.tools ?? [], testedAt };
+      return { ok: false, error: parsed.error ?? "probe failed", testedAt };
+    } catch {
+      // Fall through to the unreadable-output error below.
+    }
+  }
+  const stderrTail = result.stderr.trim().split("\n").slice(-3).join(" ");
+  return {
+    ok: false,
+    error: `probe produced no readable output (exit ${result.exitCode})${stderrTail ? `: ${stderrTail}` : ""}`,
+    testedAt,
+  };
+}
+
+/** Save a new connection (form values -> sealed store), then return its client view. */
+export async function connect(
+  store: ConnectorStore,
+  policy: ConnectorPolicy | null | undefined,
+  ownerId: string,
+  connectorId: string,
+  values: Record<string, string>,
+  label?: string,
+): Promise<ClientConnectionView> {
+  const connector = getConnector(connectorId);
+  if (!connector) {
+    throw new ConnectorServiceError(`unknown connector "${connectorId}"`, "not-found");
+  }
+  if (!isConnectorAllowed(policy, connectorId)) {
+    throw new ConnectorServiceError(
+      `"${connector.name}" is not allowed by the user's settings`,
+      "not-allowed",
+    );
+  }
+  if (connector.needsOAuth) {
+    throw new ConnectorServiceError(
+      `"${connector.name}" ${connector.needsOAuth} — connect will be available once OAuth lands`,
+      "needs-oauth",
+    );
+  }
+  const missing = missingRequiredFields(connector, values);
+  if (missing.length > 0) {
+    throw new ConnectorServiceError(
+      `missing required field(s): ${missing.join(", ")}`,
+      "missing-fields",
+    );
+  }
+  const record = await store.save(ownerId, {
+    connectorId,
+    label: label?.trim() || connector.name,
+    values,
+    secretFields: connector.fields.filter((f) => f.secret).map((f) => f.key),
+  });
+  return toClientView(record, values, connector);
+}
+
+/**
+ * Test a stored connection: unseal its values (server-only), run the
+ * probe in the owner's VM, record the outcome, and return the discovered
+ * tools or a readable error.
+ */
+export async function testConnection(
+  store: ConnectorStore,
+  runner: LibraryVmRunner,
+  ownerId: string,
+  connectionId: string,
+): Promise<TestConnectionResult> {
+  const record = await store.get(ownerId, connectionId);
+  if (!record) {
+    throw new ConnectorServiceError(`unknown connection "${connectionId}"`, "not-found");
+  }
+  const connector = getConnector(record.connectorId);
+  if (!connector) {
+    throw new ConnectorServiceError(
+      `connector "${record.connectorId}" is no longer in the catalog`,
+      "not-found",
+    );
+  }
+  const values = await store.openValues(ownerId, connectionId);
+  if (!values) {
+    throw new ConnectorServiceError(`could not open values for "${connectionId}"`, "not-found");
+  }
+  let command: ServerCommand;
+  try {
+    command = buildServerCommand(connector, values);
+  } catch (err) {
+    throw new ConnectorServiceError(
+      err instanceof Error ? err.message : String(err),
+      "missing-fields",
+    );
+  }
+  const result = await probeServer(runner, ownerId, command);
+  await store.updateTest(ownerId, connectionId, {
+    ok: result.ok,
+    tools: result.tools,
+    testedAt: result.testedAt,
+  });
+  return result;
+}
+
+/** Disconnect: remove the stored connection (and its sealed secrets). */
+export async function disconnect(
+  store: ConnectorStore,
+  ownerId: string,
+  connectionId: string,
+): Promise<boolean> {
+  return store.remove(ownerId, connectionId);
+}
+
+/** List the owner's connections as client-safe (masked) views. */
+export async function listConnections(
+  store: ConnectorStore,
+  ownerId: string,
+): Promise<ClientConnectionView[]> {
+  const records = await store.list(ownerId);
+  const views: ClientConnectionView[] = [];
+  for (const record of records) {
+    // Server-side only: unseal to build the view, but return masked
+    // secrets and non-secret values only — never the raw opened values.
+    const values = await store.openValues(ownerId, record.id);
+    if (!values) continue;
+    views.push(toClientView(record, values, getConnector(record.connectorId)));
+  }
+  return views;
+}
+
+export interface RunServer {
+  connectorId: string;
+  command: ServerCommand;
+}
+
+/**
+ * Resolve the servers a run may use: the owner's stored connections,
+ * intersected with the settings allowlist. l1's run wiring feeds this
+ * into the agent's --mcp-config. Connections whose connector is no longer
+ * in the catalog, or whose values fail to open, are skipped (never fatal).
+ */
+export async function serversForRun(
+  store: ConnectorStore,
+  policy: ConnectorPolicy | null | undefined,
+  ownerId: string,
+): Promise<RunServer[]> {
+  const records = await store.list(ownerId);
+  const servers: RunServer[] = [];
+  for (const record of records) {
+    if (!isConnectorAllowed(policy, record.connectorId)) continue;
+    const connector = getConnector(record.connectorId);
+    if (!connector) continue;
+    const values = await store.openValues(ownerId, record.id);
+    if (!values) continue;
+    try {
+      servers.push({ connectorId: record.connectorId, command: buildServerCommand(connector, values) });
+    } catch {
+      continue;
+    }
+  }
+  return servers;
+}
