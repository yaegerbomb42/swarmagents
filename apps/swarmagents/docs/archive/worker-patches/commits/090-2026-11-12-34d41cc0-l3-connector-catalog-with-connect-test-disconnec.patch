@@ -0,0 +1,176 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  CONNECTORS,
+  buildServerCommand,
+  getConnector,
+  maskSecret,
+  missingRequiredFields,
+} from "./connectors";
+
+const REQUIRED_IDS = [
+  "github",
+  "gitlab",
+  "slack",
+  "notion",
+  "linear",
+  "jira",
+  "google-drive",
+  "gmail",
+  "google-calendar",
+  "postgres",
+  "sqlite",
+  "supabase",
+  "stripe",
+  "sentry",
+  "figma",
+  "brave-search",
+  "exa-search",
+  "fetch",
+  "filesystem",
+  "memory",
+  "playwright",
+  "puppeteer",
+  "docker",
+  "cloudflare",
+  "vercel",
+  "airtable",
+];
+
+test("catalog covers every required connector with a unique id", () => {
+  const ids = CONNECTORS.map((c) => c.id);
+  assert.equal(new Set(ids).size, ids.length, "duplicate connector ids");
+  for (const id of REQUIRED_IDS) {
+    assert.ok(getConnector(id), `missing required connector ${id}`);
+  }
+  assert.ok(CONNECTORS.length >= 25, `expected ~25 connectors, got ${CONNECTORS.length}`);
+});
+
+test("every catalog entry is complete and honest about verification", () => {
+  for (const c of CONNECTORS) {
+    assert.ok(c.name.trim(), `${c.id}: empty name`);
+    assert.ok(c.description.trim(), `${c.id}: empty description`);
+    assert.ok(c.icon.trim(), `${c.id}: empty icon`);
+    assert.ok(c.tools.length > 0, `${c.id}: no advertised tools`);
+    for (const f of c.fields) {
+      assert.ok(f.help.trim(), `${c.id}/${f.key}: empty help text`);
+      assert.ok(f.link.startsWith("https://"), `${c.id}/${f.key}: help link is not https`);
+    }
+    // Unverified entries must be remote URLs curl could not check from the
+    // build VM — never an npx/uvx package we failed to verify.
+    if (!c.verified) {
+      assert.equal(c.run.kind, "remote", `${c.id}: unverified non-remote entry`);
+    }
+    if (c.run.kind !== "remote") {
+      assert.ok(c.run.package.trim(), `${c.id}: empty package name`);
+    }
+  }
+});
+
+test("OAuth-only connectors are flagged, not silently connectable", () => {
+  for (const id of ["google-drive", "gmail", "google-calendar", "figma", "vercel"]) {
+    const c = getConnector(id);
+    assert.ok(c?.needsOAuth?.includes("OAuth"), `${id} should be flagged needs OAuth`);
+  }
+});
+
+test("maskSecret never returns the full value", () => {
+  assert.equal(maskSecret(""), "••••••••");
+  assert.equal(maskSecret("short"), "••••••••");
+  const masked = maskSecret("ghp_abcdefghijklmnop1234");
+  assert.ok(!masked.includes("abcdefghijklmnop"), "masked value leaks the middle");
+  assert.ok(masked.startsWith("ghp_"), "masked value keeps a recognizable prefix");
+  assert.ok(masked.endsWith("1234"), "masked value keeps a recognizable suffix");
+});
+
+test("buildServerCommand: GitHub token goes to env, never argv", () => {
+  const cmd = buildServerCommand(getConnector("github")!, { token: "ghp_secret123" });
+  assert.equal(cmd.kind, "npx");
+  if (cmd.kind === "npx") {
+    assert.deepEqual(cmd.args, ["-y", "@modelcontextprotocol/server-github"]);
+    assert.equal(cmd.env.GITHUB_PERSONAL_ACCESS_TOKEN, "ghp_secret123");
+    assert.equal(cmd.args.join(" ").includes("ghp_secret123"), false);
+  }
+});
+
+test("buildServerCommand: a secret in argv is rejected unless explicitly allowed", () => {
+  // Synthetic connector: a secret placeholder in args with no opt-in.
+  const bad = {
+    id: "bad",
+    name: "Bad",
+    icon: "B",
+    description: "test-only",
+    category: "Test",
+    run: { kind: "npx", package: "some-pkg", args: ["{token}"] },
+    fields: [{ key: "token", label: "Token", help: "h", link: "https://example.com", secret: true, required: true }],
+    tools: [{ name: "t", description: "t" }],
+    verified: true,
+    source: "official",
+  } as const;
+  assert.throws(
+    () => buildServerCommand(bad as never, { token: "secret123" }),
+    /must not appear in argv/,
+  );
+});
+
+test("buildServerCommand: Postgres is the single documented argv exception", () => {
+  // server-postgres takes its connection string only as a positional argv
+  // argument (no env alternative); it runs inside the user's own VM.
+  const postgres = getConnector("postgres")!;
+  assert.deepEqual(postgres.run.kind === "npx" ? postgres.run.allowSecretInArgv : [], [
+    "connectionString",
+  ]);
+  const cmd = buildServerCommand(postgres, {
+    connectionString: "postgres://u:p@h:5432/db",
+  });
+  assert.equal(cmd.kind, "npx");
+  if (cmd.kind === "npx") {
+    assert.deepEqual(cmd.args, [
+      "-y",
+      "@modelcontextprotocol/server-postgres",
+      "postgres://u:p@h:5432/db",
+    ]);
+  }
+  // No other catalog entry allows a secret in argv.
+  for (const c of CONNECTORS) {
+    if (c.id === "postgres") continue;
+    if (c.run.kind === "remote") continue;
+    assert.equal(c.run.allowSecretInArgv?.length ?? 0, 0, `${c.id} allows a secret in argv`);
+  }
+});
+
+test("buildServerCommand: Fetch needs no fields and runs npx", () => {
+  const cmd = buildServerCommand(getConnector("fetch")!, {});
+  assert.equal(cmd.kind, "npx");
+  if (cmd.kind === "npx") {
+    assert.deepEqual(cmd.args, ["-y", "@kazuph/mcp-fetch"]);
+    assert.deepEqual(cmd.env, {});
+  }
+});
+
+test("buildServerCommand: remote Linear substitutes the API key into the header only", () => {
+  const cmd = buildServerCommand(getConnector("linear")!, { apiKey: "lin_api_secret" });
+  assert.equal(cmd.kind, "remote");
+  if (cmd.kind === "remote") {
+    assert.equal(cmd.url, "https://mcp.linear.app/sse");
+    assert.equal(cmd.transport, "sse");
+    assert.equal(cmd.headers.Authorization, "Bearer lin_api_secret");
+  }
+});
+
+test("buildServerCommand: missing required fields throw", () => {
+  assert.throws(() => buildServerCommand(getConnector("github")!, {}), /missing required field/);
+  assert.throws(
+    () => buildServerCommand(getConnector("github")!, { token: "   " }),
+    /missing required field/,
+  );
+  assert.deepEqual(missingRequiredFields(getConnector("slack")!, { botToken: "x" }), ["teamId"]);
+});
+
+test("buildServerCommand: Filesystem is VM-scoped to /workspace", () => {
+  const cmd = buildServerCommand(getConnector("filesystem")!, {});
+  assert.equal(cmd.kind, "npx");
+  if (cmd.kind === "npx") {
+    assert.deepEqual(cmd.args, ["-y", "@modelcontextprotocol/server-filesystem", "/workspace"]);
+  }
+});
