+export function getConnector(id: string): CatalogConnector | undefined {
+  return CONNECTORS.find((c) => c.id === id);
+}
+
+/** Required field keys that have no value (empty string counts as missing). */
+export function missingRequiredFields(
+  connector: CatalogConnector,
+  values: Record<string, string>,
+): string[] {
+  return connector.fields
+    .filter((f) => f.required && !(values[f.key] ?? "").trim())
+    .map((f) => f.key);
+}
+
+/**
+ * Mask a secret for display: first 4 + last 4 chars with the middle hidden.
+ * Short values are fully hidden. Never returns the full value.
+ */
+export function maskSecret(value: string): string {
+  if (value.length <= 8) return "••••••••";
+  return `${value.slice(0, 4)}••••${value.slice(-4)}`;
+}
+
+export type ServerCommand =
+  | {
+      kind: "npx" | "uvx";
+      /** argv to run inside the VM (secrets NEVER appear here). */
+      command: string;
+      args: string[];
+      /** Env for the child process (secrets travel here). */
+      env: Record<string, string>;
+    }
+  | {
+      kind: "remote";
+      url: string;
+      transport: "sse" | "streamable-http";
+      headers: Record<string, string>;
+    };
+
+function substitute(template: string, values: Record<string, string>): string {
+  return template.replace(/\{([A-Za-z0-9_]+)\}/g, (_m, key: string) => values[key] ?? "");
+}
+
+/**
+ * Resolve a connector + stored field values into the command the VM runs.
+ * Throws when a required field is missing, when a `{placeholder}` has no
+ * value, or when a secret field would land in argv (secrets go in env
+ * only). The returned env values are the plaintext secrets — callers must
+ * keep them out of logs and pass them only to the VM runner's stdin.
+ */
+export function buildServerCommand(
+  connector: CatalogConnector,
+  values: Record<string, string>,
+): ServerCommand {
+  const missing = missingRequiredFields(connector, values);
+  if (missing.length > 0) {
+    throw new Error(`missing required field(s): ${missing.join(", ")}`);
+  }
+  const secretKeys = new Set(connector.fields.filter((f) => f.secret).map((f) => f.key));
+  const run = connector.run;
+  if (run.kind === "remote") {
+    const headers: Record<string, string> = {};
+    for (const [name, template] of Object.entries(run.headers ?? {})) {
+      headers[name] = substitute(template, values);
+    }
+    return { kind: "remote", url: run.url, transport: run.transport, headers };
+  }
+  const allowedInArgv = new Set(run.allowSecretInArgv ?? []);
+  const args: string[] = ["-y", run.package];
+  for (const raw of run.args ?? []) {
+    const placeholderKeys = [...raw.matchAll(/\{([A-Za-z0-9_]+)\}/g)].map((m) => m[1]);
+    for (const key of placeholderKeys) {
+      if (secretKeys.has(key) && !allowedInArgv.has(key)) {
+        throw new Error(`secret field "${key}" must not appear in argv; use env instead`);
+      }
+      if (!(values[key] ?? "").trim()) {
+        throw new Error(`missing value for arg placeholder "{${key}}"`);
+      }
+    }
+    args.push(substitute(raw, values));
+  }
+  const env: Record<string, string> = {};
+  for (const [name, key] of Object.entries(run.env ?? {})) {
+    const value = values[key];
+    if (value === undefined || value === "") continue;
+    env[name] = value;
+  }
+  return { kind: run.kind, command: run.kind, args, env };
+}
