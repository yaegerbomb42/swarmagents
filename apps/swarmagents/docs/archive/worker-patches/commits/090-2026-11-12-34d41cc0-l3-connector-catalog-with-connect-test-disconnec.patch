+/**
+ * l3 connector catalog: the curated list of common connectors a user can
+ * add from the Library (l2's Connectors tab renders this catalog).
+ *
+ * Every entry is per-account: a connection stores its field values sealed
+ * (see lib/library/seam.ts) and every server executes inside the owning
+ * user's VM, never on the host or in the Next.js process. Secrets are
+ * never returned to the client unmasked (see `maskSecret`) and never
+ * appear in argv (see `buildServerCommand` — secrets travel only in env,
+ * which the probe receives on stdin) — with one documented exception:
+ * Postgres, whose vendor server takes its connection string only as an
+ * argv argument (see `allowSecretInArgv`).
+ *
+ * Verification (2026-11-12, from this VM):
+ * - npx packages checked with `npm view <pkg> version`; uvx packages with
+ *   `pip index versions`. Entries marked `verified: true` passed that
+ *   check. `verified: false` means the endpoint is the vendor's documented
+ *   remote MCP URL but could NOT be curl-verified from this VM (outbound
+ *   curl is blocked by the egress proxy — `curl` returns 000 for every
+ *   host). Those entries are kept because the task requires them, but they
+ *   are flagged here and in the submission report.
+ * - Dropped: `@modelcontextprotocol/server-sqlite` and
+ *   `@modelcontextprotocol/server-fetch` both 404 on npm, so the catalog
+ *   uses the community packages `mcp-server-sqlite` and `@kazuph/mcp-fetch`
+ *   instead. `@modelcontextprotocol/server-docker` also 404s; the catalog
+ *   uses community `mcp-server-docker`.
+ * - OAuth-only services (Google Drive, Gmail, Google Calendar, Figma,
+ *   Vercel) are marked `needsOAuth: "needs OAuth (coming soon)"` and the
+ *   service layer refuses to connect them until l1 ships an OAuth flow.
+ * - One argv exception: Postgres. `@modelcontextprotocol/server-postgres`
+ *   accepts its connection string ONLY as a positional argv argument — no
+ *   env alternative exists. Its `allowSecretInArgv` opt-in is the single
+ *   exception to the secrets-never-in-argv rule, and it stays inside the
+ *   user's own VM (the user's own secret, the user's own process list);
+ *   the probe's own argv never carries secrets, and nothing is logged.
+ */
+
+export type ConnectorRun =
+  | {
+      kind: "npx" | "uvx";
+      /** Package name, verified to exist on npm / PyPI (see header). */
+      package: string;
+      /**
+       * Args passed after `-y <package>`. May contain `{fieldKey}`
+       * placeholders, replaced with the stored field value. Placeholders
+       * MUST only reference non-secret fields — a secret in argv would
+       * leak it into process listings and logs — unless the field key is
+       * listed in `allowSecretInArgv` (see below). `buildServerCommand`
+       * enforces this and throws otherwise.
+       */
+      args?: string[];
+      /** Env var name -> field key. Secrets travel here, never in argv. */
+      env?: Record<string, string>;
+      /**
+       * Escape hatch, used ONLY by Postgres: field keys whose values may
+       * appear in argv because the vendor's server accepts them no other
+       * way (server-postgres takes its connection string as a positional
+       * argument; there is no env alternative). The value still runs
+       * inside the user's own VM only, and is never logged. Keep this
+       * list empty for every other connector.
+       */
+      allowSecretInArgv?: string[];
+    }
+  | {
+      kind: "remote";
+      /** Vendor's MCP endpoint. */
+      url: string;
+      transport: "sse" | "streamable-http";
+      /**
+       * Header name -> value template. May contain `{fieldKey}`
+       * placeholders (e.g. `"Bearer {apiKey}"`).
+       */
+      headers?: Record<string, string>;
+    };
+
+export interface ConnectorField {
+  key: string;
+  label: string;
+  /** What the value is and where to get it. Shown in the connect form. */
+  help: string;
+  /** Link to the page where the user creates the key / token. */
+  link: string;
+  /** Secret values are sealed at rest and masked in every client view. */
+  secret: boolean;
+  required: boolean;
+  placeholder?: string;
+}
+
+export interface AdvertisedTool {
+  name: string;
+  description: string;
+}
+
+export interface CatalogConnector {
+  id: string;
+  name: string;
+  /** Short glyph shown on the connector card (l2 renders it). */
+  icon: string;
+  description: string;
+  category: string;
+  run: ConnectorRun;
+  fields: ConnectorField[];
+  /**
+   * Tools the server is expected to expose. Shown BEFORE install so the
+   * user sees what they are granting; the real list comes from
+   * "Test connection" (MCP tools/list) and replaces this on display.
+   */
+  tools: AdvertisedTool[];
+  /**
+   * Set when the connector cannot be connected with a pasted key/token
+   * today: "needs OAuth (coming soon)" (or a more specific note). The
+   * service layer refuses `connect` while this is set.
+   */
+  needsOAuth?: string;
+  /** True when the package name / URL was verified from this VM. */
+  verified: boolean;
+  /** "official" = published by the service vendor or the MCP project. */
+  source: "official" | "community";
+}
+
+const field = (
+  key: string,
+  label: string,
+  help: string,
+  link: string,
+  secret: boolean,
+  required = true,
+  placeholder?: string,
+): ConnectorField => ({ key, label, help, link, secret, required, placeholder });
+
