+/**
+ * The MCP probe: a dependency-free Node script that runs INSIDE the user's
+ * VM and discovers what tools one MCP server exposes.
+ *
+ * The service (service.ts) seeds this source into the VM at
+ * MCP_PROBE_PATH and runs `node <path>` with a JSON config on stdin:
+ *
+ *   { "kind": "stdio", "command": "npx", "args": ["-y", "pkg"], "env": {...} }
+ *   { "kind": "remote", "url": "https://…", "transport": "sse" | "streamable-http",
+ *     "headers": {...} }
+ *
+ * It prints exactly one JSON line on stdout:
+ *   { "ok": true, "tools": [{ "name", "description" }] }
+ *   { "ok": false, "error": "<readable message>" }
+ * and exits 0 either way (a failed probe is a result, not a crash).
+ *
+ * No MCP SDK dependency: the probe speaks raw JSON-RPC 2.0 (initialize →
+ * notifications/initialized → tools/list) over stdio, SSE, and
+ * streamable-HTTP, so it works in a bare VM with only node installed.
+ * Secrets arrive on stdin / in env, never in argv, and are never logged.
+ *
+ * This file holds the probe as a template string so the Next.js server can
+ * seed it into the VM without a filesystem read. Keep the string valid
+ * Node (no TS): probe.test.ts executes it for real against fake servers.
+ */
+
+export const MCP_PROBE_SOURCE = `// MCP probe — dependency-free, runs inside the user's VM.
+// Input: JSON config on stdin. Output: one JSON line on stdout.
+import { spawn } from "node:child_process";
+
+const TIMEOUT_MS = 120_000;
+
+function fail(message) {
+  process.stdout.write(JSON.stringify({ ok: false, error: message }) + "\\n");
+  process.exit(0);
+}
+
+async function readStdin() {
+  const chunks = [];
+  for await (const chunk of process.stdin) chunks.push(chunk);
+  return Buffer.concat(chunks).toString("utf8");
+}
+
+// --- stdio transport: spawn the server, speak JSON-RPC over its pipes. ---
+async function probeStdio(config) {
+  const child = spawn(config.command, config.args ?? [], {
+    env: { ...process.env, ...(config.env ?? {}) },
+    stdio: ["pipe", "pipe", "pipe"],
+  });
+  let stdout = "";
+  let stderr = "";
+  const pending = new Map();
+  let nextId = 1;
+  child.stdout.setEncoding("utf8");
+  child.stdout.on("data", (d) => {
+    stdout += d;
+    const lines = stdout.split("\\n");
+    stdout = lines.pop() ?? "";
+    for (const line of lines) {
+      const trimmed = line.trim();
+      if (!trimmed) continue;
+      let msg;
+      try { msg = JSON.parse(trimmed); } catch { continue; }
+      if (msg.id !== undefined && pending.has(msg.id)) {
+        pending.get(msg.id).resolve(msg);
+        pending.delete(msg.id);
+      }
+    }
+  });
+  child.stderr.setEncoding("utf8");
+  child.stderr.on("data", (d) => { stderr += d; });
+  const exited = new Promise((resolve) => child.on("exit", (code, signal) => resolve({ code, signal })));
+  // If the server dies, fail pending calls at once instead of waiting out
+  // the per-call timeout — a dead server is a fast, readable error.
+  child.on("exit", (code, signal) => {
+    for (const [id, entry] of pending) {
+      clearTimeout(entry.timer);
+      entry.reject(new Error("server exited" + (code !== null ? " with code " + code : " (" + signal + ")") + " before responding to " + entry.method));
+      pending.delete(id);
+    }
+  });
+  child.on("error", (err) => {
+    for (const [id, entry] of pending) {
+      clearTimeout(entry.timer);
+      entry.reject(new Error("failed to start server: " + err.message));
+      pending.delete(id);
+    }
+  });
+  const send = (method, params) => new Promise((resolve, reject) => {
+    if (child.exitCode !== null || child.signalCode !== null) {
+      reject(new Error("server already exited before " + method));
+      return;
+    }
+    const id = nextId++;
+    const timer = setTimeout(() => { pending.delete(id); reject(new Error("timed out waiting for " + method)); }, TIMEOUT_MS);
+    pending.set(id, { method, timer, resolve: (msg) => { clearTimeout(timer); resolve(msg); }, reject });
+    try {
+      child.stdin.write(JSON.stringify({ jsonrpc: "2.0", id, method, params }) + "\\n");
+    } catch (err) {
+      clearTimeout(timer);
+      pending.delete(id);
+      reject(new Error("failed to write to server: " + err.message));
+    }
+  });
+  const notify = (method, params) => {
+    child.stdin.write(JSON.stringify({ jsonrpc: "2.0", method, params }) + "\\n");
+  };
+  const kill = () => { try { child.kill("SIGKILL"); } catch {} };
+  const timeout = setTimeout(kill, TIMEOUT_MS);
+  try {
+    const init = await send("initialize", {
+      protocolVersion: "2024-11-05",
+      capabilities: {},
+      clientInfo: { name: "swarm-mcp-probe", version: "1.0.0" },
+    });
+    if (init.error) throw new Error("initialize failed: " + (init.error.message ?? JSON.stringify(init.error)));
+    notify("notifications/initialized");
+    const list = await send("tools/list", {});
+    if (list.error) throw new Error("tools/list failed: " + (list.error.message ?? JSON.stringify(list.error)));
+    const tools = (list.result?.tools ?? []).map((t) => ({ name: t.name, description: t.description ?? "" }));
+    clearTimeout(timeout);
+    kill();
+    await exited;
+    return tools;
+  } catch (err) {
+    clearTimeout(timeout);
+    kill();
+    await exited;
+    const tail = stderr.trim().split("\\n").slice(-3).join(" ");
+    throw new Error(err.message + (tail ? " (server stderr: " + tail + ")" : ""));
+  }
+}
+
+// --- HTTP transports: incremental SSE parsing (the stream stays open). ---
+function createSseParser(onMessage) {
+  let buf = "";
+  let event = "";
+  let data = "";
+  const flush = () => {
+    if (data !== "") onMessage(event || "message", data);
+    event = "";
+    data = "";
+  };
+  return {
+    feed(chunk) {
+      buf += chunk;
+      let idx;
+      while ((idx = buf.indexOf("\\n")) >= 0) {
+        const line = buf.slice(0, idx).replace(/\\r$/, "");
+        buf = buf.slice(idx + 1);
+        if (line === "") { flush(); continue; }
+        if (line.startsWith("event:")) event = line.slice(6).trim();
+        else if (line.startsWith("data:")) data += line.slice(5).trim();
+      }
+    },
+    finish() { flush(); },
+  };
+}
+
+async function pumpSse(res, onMessage) {
+  const reader = res.body.getReader();
+  const parser = createSseParser(onMessage);
+  const decoder = new TextDecoder();
+  try {
+    for (;;) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      parser.feed(decoder.decode(value, { stream: true }));
+    }
+    parser.feed(decoder.decode());
+    parser.finish();
+  } catch { /* stream closed early; callers use what arrived */ }
+}
+
+async function probeSse(config) {
+  const res = await fetch(config.url, { method: "GET", headers: { Accept: "text/event-stream", ...(config.headers ?? {}) } });
+  if (!res.ok) throw new Error("SSE GET " + config.url + " failed: HTTP " + res.status);
+  let endpoint = null;
+  const messages = [];
+  // Pump in the background; messages arrive while we wait below.
+  pumpSse(res, (event, data) => {
+    if (event === "endpoint") endpoint = data;
+    else {
+      try { messages.push(JSON.parse(data)); } catch {}
+    }
+  });
+  const waitFor = async (pred, what) => {
+    const deadline = Date.now() + TIMEOUT_MS;
+    while (Date.now() < deadline) {
+      const i = messages.findIndex(pred);
+      if (i >= 0) return messages.splice(i, 1)[0];
+      await new Promise((r) => setTimeout(r, 50));
+    }
+    throw new Error("timed out waiting for " + what);
+  };
+  const deadline = Date.now() + TIMEOUT_MS;
+  while (!endpoint && Date.now() < deadline) await new Promise((r) => setTimeout(r, 50));
+  if (!endpoint) throw new Error("SSE stream gave no endpoint event");
+  const postUrl = new URL(endpoint, config.url).toString();
+  let nextId = 1;
+  const rpc = async (method, params) => {
+    const id = nextId++;
+    const r = await fetch(postUrl, {
+      method: "POST",
+      headers: { "Content-Type": "application/json", Accept: "application/json, text/event-stream", ...(config.headers ?? {}) },
+      body: JSON.stringify({ jsonrpc: "2.0", id, method, params }),
+    });
+    if (!r.ok) throw new Error("POST " + method + " failed: HTTP " + r.status);
+    return waitFor((m) => m.id === id, method);
+  };
+  const init = await rpc("initialize", {
+    protocolVersion: "2024-11-05",
+    capabilities: {},
+    clientInfo: { name: "swarm-mcp-probe", version: "1.0.0" },
+  });
+  if (init.error) throw new Error("initialize failed: " + (init.error.message ?? JSON.stringify(init.error)));
+  await fetch(postUrl, {
+    method: "POST",
+    headers: { "Content-Type": "application/json", Accept: "application/json, text/event-stream", ...(config.headers ?? {}) },
+    body: JSON.stringify({ jsonrpc: "2.0", method: "notifications/initialized" }),
+  });
+  const list = await rpc("tools/list", {});
+  if (list.error) throw new Error("tools/list failed: " + (list.error.message ?? JSON.stringify(list.error)));
+  return (list.result?.tools ?? []).map((t) => ({ name: t.name, description: t.description ?? "" }));
+}
+
+async function probeStreamableHttp(config) {
+  let sessionId = null;
+  const post = async (body) => {
+    const headers = { "Content-Type": "application/json", Accept: "application/json, text/event-stream", ...(config.headers ?? {}) };
+    if (sessionId) headers["Mcp-Session-Id"] = sessionId;
+    const r = await fetch(config.url, { method: "POST", headers, body: JSON.stringify(body) });
+    if (!r.ok) throw new Error("POST " + config.url + " failed: HTTP " + r.status);
+    sessionId = r.headers.get("mcp-session-id") ?? sessionId;
+    const contentType = r.headers.get("content-type") ?? "";
+    if (contentType.includes("application/json")) return await r.json();
+    const messages = [];
+    await pumpSse(r, (event, data) => {
+      if (event === "message" || event === "") { try { messages.push(JSON.parse(data)); } catch {} }
+    });
+    return messages.find((m) => m.id !== undefined && m.method === undefined) ?? messages[0];
+  };
+  let nextId = 1;
+  const init = await post({ jsonrpc: "2.0", id: nextId++, method: "initialize", params: {
+    protocolVersion: "2024-11-05",
+    capabilities: {},
+    clientInfo: { name: "swarm-mcp-probe", version: "1.0.0" },
+  } });
+  if (!init || init.error) throw new Error("initialize failed: " + (init?.error?.message ?? "no response"));
+  await post({ jsonrpc: "2.0", method: "notifications/initialized" });
+  const list = await post({ jsonrpc: "2.0", id: nextId++, method: "tools/list", params: {} });
+  if (!list || list.error) throw new Error("tools/list failed: " + (list?.error?.message ?? "no response"));
+  return (list.result?.tools ?? []).map((t) => ({ name: t.name, description: t.description ?? "" }));
+}
+
+const main = async () => {
+  let config;
+  try {
+    config = JSON.parse(await readStdin());
+  } catch {
+    fail("probe input was not valid JSON");
+    return;
+  }
+  try {
+    let tools;
+    if (config.kind === "stdio") tools = await probeStdio(config);
+    else if (config.kind === "remote" && config.transport === "sse") tools = await probeSse(config);
+    else if (config.kind === "remote" && config.transport === "streamable-http") tools = await probeStreamableHttp(config);
+    else throw new Error("unknown probe config kind/transport");
+    process.stdout.write(JSON.stringify({ ok: true, tools }) + "\\n");
+    process.exit(0);
+  } catch (err) {
+    fail(err instanceof Error ? err.message : String(err));
+  }
+};
+
+main();
+`;
diff --git a/apps/swarmagents/lib/library/catalog/probe.test.ts b/apps/swarmagents/lib/library/catalog/probe.test.ts
new file mode 100644
index 000000000..cc3565073
--- /dev/null
+++ b/apps/swarmagents/lib/library/catalog/probe.test.ts
@@ -0,0 +1,216 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { spawn } from "node:child_process";
+import fs from "node:fs";
+import http from "node:http";
+import os from "node:os";
+import path from "node:path";
+import { MCP_PROBE_SOURCE } from "./probe-source";
+
+/** Run the probe source as a real node process with a JSON config on stdin. */
+function runProbe(config: Record<string, unknown>): Promise<{ stdout: string; stderr: string; code: number | null }> {
+  return new Promise((resolve, reject) => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), "swarm-probe-"));
+    const probePath = path.join(dir, "mcp-probe.mjs");
+    fs.writeFileSync(probePath, MCP_PROBE_SOURCE);
+    const child = spawn(process.execPath, [probePath], { stdio: ["pipe", "pipe", "pipe"] });
+    let stdout = "";
+    let stderr = "";
+    child.stdout.setEncoding("utf8");
+    child.stdout.on("data", (d: string) => {
+      stdout += d;
+    });
+    child.stderr.setEncoding("utf8");
+    child.stderr.on("data", (d: string) => {
+      stderr += d;
+    });
+    child.on("error", reject);
+    child.on("exit", (code) => resolve({ stdout, stderr, code }));
+    child.stdin.end(JSON.stringify(config));
+  });
+}
+
+/** A fake MCP server speaking JSON-RPC over stdio. */
+const FAKE_STDIO_SERVER = `
+import readline from "node:readline";
+const rl = readline.createInterface({ input: process.stdin });
+rl.on("line", (line) => {
+  let msg;
+  try { msg = JSON.parse(line); } catch { return; }
+  if (msg.method === "initialize") {
+    process.stdout.write(JSON.stringify({ jsonrpc: "2.0", id: msg.id, result: {
+      protocolVersion: "2024-11-05", capabilities: {},
+      serverInfo: { name: "fake", version: "0" },
+    } }) + "\\n");
+  } else if (msg.method === "tools/list") {
+    process.stdout.write(JSON.stringify({ jsonrpc: "2.0", id: msg.id, result: { tools: [
+      { name: "search_repositories", description: "Search repos." },
+      { name: "create_issue", description: "Create issue." },
+    ] } }) + "\\n");
+  }
+  // notifications/initialized gets no reply, by design.
+});
+`;
+
+function writeFakeServer(contents: string): string {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "swarm-fake-mcp-"));
+  const p = path.join(dir, "fake-server.mjs");
+  fs.writeFileSync(p, contents);
+  return p;
+}
+
+test("probe discovers tools from a stdio MCP server", async () => {
+  const server = writeFakeServer(FAKE_STDIO_SERVER);
+  const { stdout, stderr, code } = await runProbe({
+    kind: "stdio",
+    command: process.execPath,
+    args: [server],
+    env: {},
+  });
+  assert.equal(code, 0);
+  assert.equal(stderr, "");
+  const lines = stdout.trim().split("\n");
+  assert.equal(lines.length, 1, `probe must print exactly one JSON line, got: ${stdout}`);
+  const result = JSON.parse(lines[0]) as { ok: boolean; tools?: { name: string }[] };
+  assert.equal(result.ok, true);
+  assert.deepEqual(
+    (result.tools ?? []).map((t) => t.name),
+    ["search_repositories", "create_issue"],
+  );
+});
+
+test("probe reports a readable error when the server dies immediately", async () => {
+  const server = writeFakeServer(`process.stderr.write("boom: bad config\\n"); process.exit(1);\n`);
+  const { stdout, code } = await runProbe({
+    kind: "stdio",
+    command: process.execPath,
+    args: [server],
+    env: {},
+  });
+  assert.equal(code, 0, "a failed probe is a result, not a crash");
+  const result = JSON.parse(stdout.trim()) as { ok: boolean; error?: string };
+  assert.equal(result.ok, false);
+  assert.ok(result.error && result.error.length > 0, "error must be readable");
+});
+
+test("probe reports invalid input instead of crashing", async () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "swarm-probe-"));
+  const probePath = path.join(dir, "mcp-probe.mjs");
+  fs.writeFileSync(probePath, MCP_PROBE_SOURCE);
+  const child = spawn(process.execPath, [probePath], { stdio: ["pipe", "pipe", "pipe"] });
+  let stdout = "";
+  child.stdout.setEncoding("utf8");
+  child.stdout.on("data", (d: string) => {
+    stdout += d;
+  });
+  const code = await new Promise<number | null>((resolve) => {
+    child.on("exit", resolve);
+    child.stdin.end("not json");
+  });
+  assert.equal(code, 0);
+  const result = JSON.parse(stdout.trim()) as { ok: boolean; error?: string };
+  assert.equal(result.ok, false);
+  assert.match(result.error ?? "", /not valid JSON/);
+});
+
+test("probe discovers tools from an SSE MCP server", async () => {
+  // Minimal SSE MCP server: GET /sse opens the stream and announces the
+  // POST endpoint; POST /messages answers JSON-RPC via the stream.
+  // Holder object so TS does not narrow the closure-assigned response away.
+  const sseHolder: { res: http.ServerResponse | null } = { res: null };
+  const server = http.createServer((req, res) => {
+    if (req.url === "/sse" && req.method === "GET") {
+      res.writeHead(200, { "Content-Type": "text/event-stream", "Cache-Control": "no-cache" });
+      res.write("event: endpoint\ndata: /messages\n\n");
+      sseHolder.res = res;
+      return;
+    }
+    if (req.url === "/messages" && req.method === "POST") {
+      let body = "";
+      req.on("data", (c: Buffer) => {
+        body += c.toString();
+      });
+      req.on("end", () => {
+        const msg = JSON.parse(body) as { id?: number; method?: string };
+        res.writeHead(202);
+        res.end();
+        if (msg.method === "initialize") {
+          sseHolder.res?.write(
+            `event: message\ndata: ${JSON.stringify({ jsonrpc: "2.0", id: msg.id, result: { protocolVersion: "2024-11-05", capabilities: {}, serverInfo: { name: "fake-sse", version: "0" } } })}\n\n`,
+          );
+        } else if (msg.method === "tools/list") {
+          sseHolder.res?.write(
+            `event: message\ndata: ${JSON.stringify({ jsonrpc: "2.0", id: msg.id, result: { tools: [{ name: "list_issues", description: "List issues." }] } })}\n\n`,
+          );
+        }
+      });
+      return;
+    }
+    res.writeHead(404);
+    res.end();
+  });
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const addr = server.address();
+  assert.ok(addr && typeof addr === "object");
+  try {
+    const { stdout, code } = await runProbe({
+      kind: "remote",
+      url: `http://127.0.0.1:${addr.port}/sse`,
+      transport: "sse",
+      headers: {},
+    });
+    assert.equal(code, 0);
+    const result = JSON.parse(stdout.trim()) as { ok: boolean; tools?: { name: string }[]; error?: string };
+    assert.equal(result.ok, true, `probe failed: ${result.error ?? ""}`);
+    assert.deepEqual((result.tools ?? []).map((t) => t.name), ["list_issues"]);
+  } finally {
+    sseHolder.res?.end();
+    server.close();
+  }
+});
+
+test("probe discovers tools over streamable HTTP", async () => {
+  const server = http.createServer((req, res) => {
+    if (req.method !== "POST") {
+      res.writeHead(404);
+      res.end();
+      return;
+    }
+    let body = "";
+    req.on("data", (c: Buffer) => {
+      body += c.toString();
+    });
+    req.on("end", () => {
+      const msg = JSON.parse(body) as { id?: number; method?: string };
+      res.writeHead(200, { "Content-Type": "application/json" });
+      if (msg.method === "initialize") {
+        res.end(
+          JSON.stringify({ jsonrpc: "2.0", id: msg.id, result: { protocolVersion: "2024-11-05", capabilities: {}, serverInfo: { name: "fake-http", version: "0" } } }),
+        );
+      } else if (msg.method === "tools/list") {
+        res.end(
+          JSON.stringify({ jsonrpc: "2.0", id: msg.id, result: { tools: [{ name: "list_projects", description: "List projects." }] } }),
+        );
+      } else {
+        res.end(JSON.stringify({ jsonrpc: "2.0", id: msg.id ?? null, result: {} }));
+      }
+    });
+  });
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const addr = server.address();
+  assert.ok(addr && typeof addr === "object");
+  try {
+    const { stdout, code } = await runProbe({
+      kind: "remote",
+      url: `http://127.0.0.1:${addr.port}/mcp`,
+      transport: "streamable-http",
+      headers: { Authorization: "Bearer test-key" },
+    });
+    assert.equal(code, 0);
+    const result = JSON.parse(stdout.trim()) as { ok: boolean; tools?: { name: string }[]; error?: string };
+    assert.equal(result.ok, true, `probe failed: ${result.error ?? ""}`);
+    assert.deepEqual((result.tools ?? []).map((t) => t.name), ["list_projects"]);
+  } finally {
+    server.close();
+  }
+});
