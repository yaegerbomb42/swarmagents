+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  connect,
+  disconnect,
+  listConnections,
+  probeServer,
+  serversForRun,
+  testConnection,
+  toClientView,
+  ConnectorServiceError,
+} from "./service";
+import { getConnector } from "./connectors";
+import type {
+  ConnectorConnectionRecord,
+  ConnectorStore,
+  DiscoveredTool,
+  LibraryVmRunner,
+  SaveConnectionInput,
+  TestRecord,
+  VmRunResult,
+} from "../seam";
+
+/**
+ * In-memory fake of the l1 store. NOTE: this fake keeps values in
+ * plaintext only because it is test-only; the real l1 store seals them
+ * with secret-box before they touch disk (see seam.ts).
+ */
+class FakeStore implements ConnectorStore {
+  records = new Map<string, ConnectorConnectionRecord>();
+  values = new Map<string, Record<string, string>>();
+  counter = 0;
+
+  async list(ownerId: string): Promise<ConnectorConnectionRecord[]> {
+    return [...this.records.values()].filter((r) => r.ownerId === ownerId);
+  }
+  async get(ownerId: string, id: string): Promise<ConnectorConnectionRecord | null> {
+    const r = this.records.get(id);
+    return r && r.ownerId === ownerId ? r : null;
+  }
+  async save(ownerId: string, input: SaveConnectionInput): Promise<ConnectorConnectionRecord> {
+    const id = `conn-${++this.counter}`;
+    const now = Date.now();
+    const record: ConnectorConnectionRecord = {
+      id,
+      connectorId: input.connectorId,
+      ownerId,
+      label: input.label ?? input.connectorId,
+      sealedFields: {},
+      secretFields: input.secretFields,
+      createdAt: now,
+      updatedAt: now,
+    };
+    this.records.set(id, record);
+    this.values.set(id, { ...input.values });
+    return record;
+  }
+  async remove(ownerId: string, id: string): Promise<boolean> {
+    const r = this.records.get(id);
+    if (!r || r.ownerId !== ownerId) return false;
+    this.records.delete(id);
+    this.values.delete(id);
+    return true;
+  }
+  async updateTest(ownerId: string, id: string, result: TestRecord): Promise<void> {
+    const r = this.records.get(id);
+    if (!r || r.ownerId !== ownerId) return;
+    r.lastTestedAt = result.testedAt;
+    r.lastTestedOk = result.ok;
+    r.lastTools = result.tools;
+  }
+  async openValues(ownerId: string, id: string): Promise<Record<string, string> | null> {
+    const r = this.records.get(id);
+    if (!r || r.ownerId !== ownerId) return null;
+    return { ...this.values.get(id) };
+  }
+}
+
+class FakeRunner implements LibraryVmRunner {
+  execCalls: { argv: string[]; stdin?: string }[] = [];
+  written = new Map<string, string>();
+  /** Handler decides the probe result for each exec call. */
+  handler: (argv: string[], stdin?: string) => VmRunResult = () => ({
+    exitCode: 0,
+    stdout: JSON.stringify({ ok: true, tools: [{ name: "fake_tool", description: "fake" }] }) + "\n",
+    stderr: "",
+  });
+
+  async exec(ownerId: string, argv: string[], opts?: { stdin?: string; timeoutMs?: number }): Promise<VmRunResult> {
+    void ownerId;
+    void opts?.timeoutMs;
+    this.execCalls.push({ argv, stdin: opts?.stdin });
+    return this.handler(argv, opts?.stdin);
+  }
+  async writeFile(ownerId: string, path: string, contents: string): Promise<void> {
+    void ownerId;
+    this.written.set(path, contents);
+  }
+}
+
+const OWNER = "user-alice";
+
+test("connect saves a GitHub connection and returns a masked view", async () => {
+  const store = new FakeStore();
+  const view = await connect(store, null, OWNER, "github", { token: "ghp_secret1234567890" });
+  assert.equal(view.connectorId, "github");
+  assert.equal(view.connectorName, "GitHub");
+  assert.equal(view.fields.length, 1);
+  assert.equal(view.fields[0].secret, true);
+  assert.equal(view.fields[0].value.includes("secret1234567890"), false);
+  assert.ok(view.fields[0].value.startsWith("ghp_"));
+  assert.deepEqual(view.tools, getConnector("github")!.tools);
+  assert.equal((await store.list(OWNER)).length, 1);
+});
+
+test("connect refuses unknown connectors, disallowed connectors, and OAuth-only ones", async () => {
+  const store = new FakeStore();
+  await assert.rejects(connect(store, null, OWNER, "nope", {}), (e: unknown) => {
+    assert.ok(e instanceof ConnectorServiceError && e.code === "not-found");
+    return true;
+  });
+  await assert.rejects(
+    connect(store, { allowedConnectorIds: ["fetch"] }, OWNER, "github", { token: "x" }),
+    (e: unknown) => {
+      assert.ok(e instanceof ConnectorServiceError && e.code === "not-allowed");
+      return true;
+    },
+  );
+  await assert.rejects(connect(store, null, OWNER, "google-drive", {}), (e: unknown) => {
+    assert.ok(e instanceof ConnectorServiceError && e.code === "needs-oauth");
+    return true;
+  });
+});
+
+test("connect rejects missing required fields", async () => {
+  const store = new FakeStore();
+  await assert.rejects(connect(store, null, OWNER, "github", {}), (e: unknown) => {
+    assert.ok(e instanceof ConnectorServiceError && e.code === "missing-fields");
+    return true;
+  });
+  assert.equal((await store.list(OWNER)).length, 0);
+});
+
+test("testConnection runs the probe in the VM and records discovered tools", async () => {
+  const store = new FakeStore();
+  const runner = new FakeRunner();
+  const discovered: DiscoveredTool[] = [
+    { name: "search_repositories", description: "Search repos." },
+    { name: "create_issue", description: "Create issue." },
+  ];
+  runner.handler = () => ({
+    exitCode: 0,
+    stdout: JSON.stringify({ ok: true, tools: discovered }) + "\n",
+    stderr: "",
+  });
+  const view = await connect(store, null, OWNER, "github", { token: "ghp_secret1234567890" });
+  const result = await testConnection(store, runner, OWNER, view.id);
+  assert.equal(result.ok, true);
+  assert.deepEqual(result.tools, discovered);
+
+  // The probe script was seeded, and the probe was run with no secrets in argv.
+  assert.ok(runner.written.has("/workspace/.swarm/mcp-probe.mjs"));
+  assert.equal(runner.execCalls.length, 1);
+  const call = runner.execCalls[0];
+  assert.deepEqual(call.argv, ["node", "/workspace/.swarm/mcp-probe.mjs"]);
+  assert.equal(call.argv.join(" ").includes("ghp_secret"), false);
+  // Secrets travel on stdin (inside the probe config), never in argv.
+  assert.ok(call.stdin?.includes("ghp_secret1234567890"));
+
+  const stored = await store.get(OWNER, view.id);
+  assert.equal(stored?.lastTestedOk, true);
+  assert.deepEqual(stored?.lastTools, discovered);
+});
+
+test("testConnection surfaces a readable probe error and records the failure", async () => {
+  const store = new FakeStore();
+  const runner = new FakeRunner();
+  runner.handler = () => ({
+    exitCode: 0,
+    stdout: JSON.stringify({ ok: false, error: "initialize failed: bad token" }) + "\n",
+    stderr: "",
+  });
+  const view = await connect(store, null, OWNER, "fetch", {});
+  const result = await testConnection(store, runner, OWNER, view.id);
+  assert.equal(result.ok, false);
+  assert.match(result.error ?? "", /bad token/);
+  const stored = await store.get(OWNER, view.id);
+  assert.equal(stored?.lastTestedOk, false);
+});
+
+test("testConnection handles a probe that produced no output", async () => {
+  const store = new FakeStore();
+  const runner = new FakeRunner();
+  runner.handler = () => ({ exitCode: 1, stdout: "", stderr: "node: bad flag\n" });
+  const view = await connect(store, null, OWNER, "fetch", {});
+  const result = await testConnection(store, runner, OWNER, view.id);
+  assert.equal(result.ok, false);
+  assert.match(result.error ?? "", /no readable output/);
+});
+
+test("probeServer: GitHub/Fetch/Postgres flows use the right server command", async () => {
+  const runner = new FakeRunner();
+  const seen: string[] = [];
+  runner.handler = (_argv, stdin) => {
+    seen.push(stdin ?? "");
+    return { exitCode: 0, stdout: JSON.stringify({ ok: true, tools: [] }) + "\n", stderr: "" };
+  };
+  const store = new FakeStore();
+  const gh = await connect(store, null, OWNER, "github", { token: "ghp_abc" });
+  const fe = await connect(store, null, OWNER, "fetch", {});
+  const pg = await connect(store, null, OWNER, "postgres", {
+    connectionString: "postgres://u:p@h:5432/db",
+  });
+  for (const v of [gh, fe, pg]) {
+    const r = await testConnection(store, runner, OWNER, v.id);
+    assert.equal(r.ok, true);
+  }
+  const configs = seen.map((s) => JSON.parse(s) as Record<string, unknown>);
+  assert.deepEqual(configs[0].args, ["-y", "@modelcontextprotocol/server-github"]);
+  assert.deepEqual(configs[1].args, ["-y", "@kazuph/mcp-fetch"]);
+  assert.deepEqual(configs[2].args, [
+    "-y",
+    "@modelcontextprotocol/server-postgres",
+    "postgres://u:p@h:5432/db",
+  ]);
+  // The probe's own argv never carries a secret.
+  for (const call of runner.execCalls) {
+    assert.equal(call.argv.join(" ").includes("ghp_abc"), false);
+    assert.equal(call.argv.join(" ").includes("postgres://"), false);
+  }
+});
+
+test("disconnect removes the connection; listConnections masks secrets", async () => {
+  const store = new FakeStore();
+  const gh = await connect(store, null, OWNER, "github", { token: "ghp_secret1234567890" });
+  const pg = await connect(store, null, OWNER, "postgres", {
+    connectionString: "postgres://u:p@h:5432/db",
+  });
+  const listed = await listConnections(store, OWNER);
+  assert.equal(listed.length, 2);
+  const ghView = listed.find((v) => v.id === gh.id)!;
+  assert.equal(ghView.fields[0].value.includes("secret1234567890"), false);
+  assert.equal(await disconnect(store, OWNER, gh.id), true);
+  assert.equal(await disconnect(store, OWNER, gh.id), false);
+  assert.deepEqual(
+    (await listConnections(store, OWNER)).map((v) => v.id),
+    [pg.id],
+  );
+});
+
+test("toClientView never exposes a secret value, even for non-catalog connectors", () => {
+  const record: ConnectorConnectionRecord = {
+    id: "c1",
+    connectorId: "github",
+    ownerId: OWNER,
+    label: "GitHub",
+    sealedFields: {},
+    secretFields: ["token"],
+    createdAt: 1,
+    updatedAt: 1,
+  };
+  const view = toClientView(record, { token: "ghp_secret1234567890" });
+  assert.equal(view.fields[0].value.includes("secret1234567890"), false);
+  assert.equal(JSON.stringify(view).includes("ghp_secret1234567890"), false);
+});
+
+test("serversForRun intersects connections with the settings allowlist", async () => {
+  const store = new FakeStore();
+  await connect(store, null, OWNER, "github", { token: "ghp_abc" });
+  await connect(store, null, OWNER, "fetch", {});
+  const all = await serversForRun(store, null, OWNER);
+  assert.deepEqual(
+    all.map((s) => s.connectorId).sort(),
+    ["fetch", "github"],
+  );
+  const onlyFetch = await serversForRun(store, { allowedConnectorIds: ["fetch"] }, OWNER);
+  assert.deepEqual(
+    onlyFetch.map((s) => s.connectorId),
+    ["fetch"],
+  );
+  const none = await serversForRun(store, { allowedConnectorIds: [] }, OWNER);
+  assert.deepEqual(none, []);
+});
+
+test("probeServer returns the error when the VM run itself fails", async () => {
+  const runner = new FakeRunner();
+  runner.handler = () => ({ exitCode: 1, stdout: "", stderr: "boom\n" });
+  const result = await probeServer(runner, OWNER, {
+    kind: "npx",
+    command: "npx",
+    args: ["-y", "@kazuph/mcp-fetch"],
+    env: {},
+  });
+  assert.equal(result.ok, false);
+  assert.match(result.error ?? "", /exit 1/);
+});
diff --git a/apps/swarmagents/lib/library/catalog/service.ts b/apps/swarmagents/lib/library/catalog/service.ts
