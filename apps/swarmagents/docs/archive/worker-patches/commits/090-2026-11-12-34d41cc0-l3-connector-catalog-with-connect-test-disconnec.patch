new file mode 100644
index 000000000..b64f9c680
--- /dev/null
+++ b/apps/swarmagents/lib/library/seam.ts
@@ -0,0 +1,124 @@
+/**
+ * The l1 seam: the minimal interfaces l3 (connector catalog) needs from l1
+ * (per-user extension store + run wiring) and from the runtime (VM exec).
+ *
+ * l1 and l2 are NOT on main yet, so nothing here is wired to a real store.
+ * This file only defines the contract and the rules l1 must follow when it
+ * implements it. The catalog service (service.ts) and the probe (probe.ts)
+ * run entirely against these interfaces, with fakes in the tests.
+ *
+ * What l1 must supply
+ * -------------------
+ * - `ConnectorStore`: per-account persistence for connector connections.
+ *   Field values are sealed with `lib/providers/secret-box` `seal(value,
+ *   ownerId, "library/connector:<connectorId>:<fieldKey>")` before they
+ *   touch disk, in a mode-600 file inside a mode-700 per-account directory,
+ *   exactly like the provider store. `openValues` is server-only: it unseals
+ *   values for VM execution and must never be called from a route handler
+ *   that returns its result to the client.
+ * - `ConnectorPolicy`: the user's settings allowlist. A role (and the agent)
+ *   can never get more than the user's settings allow: run wiring must
+ *   intersect the role's connector ids with this allowlist before building
+ *   `--mcp-config`. `allowedConnectorIds: null` means "every catalog entry".
+ *
+ * What the runtime must supply
+ * -----------------------------
+ * - `LibraryVmRunner`: run a command inside the owning user's VM and seed
+ *   files into it. The production implementation adapts
+ *   `lib/vm` `vmManager.exec` / `writeFile`. The probe only ever runs
+ *   `node /workspace/.swarm/mcp-probe.mjs` with the server command, args and
+ *   env as JSON on stdin — secrets never appear in argv.
+ *
+ * What l1 must NOT do
+ * --------------------
+ * - Never store a field value in plaintext, never log one, and never return
+ *   one to the client. Client views carry masked values only (see
+ *   `maskSecret` in catalog/connectors.ts).
+ * - Never let one account's connection be opened under another account:
+ *   the secret-box AAD binds each sealed value to its owner + connector +
+ *   field, so a copied ciphertext fails to open instead of working.
+ */
+
+export interface DiscoveredTool {
+  name: string;
+  description?: string;
+}
+
+/**
+ * One stored connector connection. `sealedFields` holds secret-box
+ * ciphertext, never plaintext. Non-secret field values (URLs, paths,
+ * usernames) are stored sealed too, so the store has one code path.
+ */
+export interface ConnectorConnectionRecord {
+  id: string;
+  connectorId: string;
+  ownerId: string;
+  label: string;
+  sealedFields: Record<string, string>;
+  /** Field keys whose values are secrets (masked in every client view). */
+  secretFields: string[];
+  createdAt: number;
+  updatedAt: number;
+  lastTestedAt?: number;
+  lastTestedOk?: boolean;
+  lastTools?: DiscoveredTool[];
+}
+
+export interface SaveConnectionInput {
+  connectorId: string;
+  /** Human label; defaults to the connector's name. */
+  label?: string;
+  /** Plaintext field values. The store seals them before persisting. */
+  values: Record<string, string>;
+  secretFields: string[];
+}
+
+export interface TestRecord {
+  ok: boolean;
+  tools?: DiscoveredTool[];
+  testedAt: number;
+}
+
+/** Per-account persistence for connector connections (implemented by l1). */
+export interface ConnectorStore {
+  list(ownerId: string): Promise<ConnectorConnectionRecord[]>;
+  get(ownerId: string, connectionId: string): Promise<ConnectorConnectionRecord | null>;
+  save(ownerId: string, input: SaveConnectionInput): Promise<ConnectorConnectionRecord>;
+  remove(ownerId: string, connectionId: string): Promise<boolean>;
+  updateTest(ownerId: string, connectionId: string, result: TestRecord): Promise<void>;
+  /**
+   * Server-only: unseal the field values for VM execution (probe / run
+   * wiring). MUST NOT be reachable from any client-facing route.
+   */
+  openValues(ownerId: string, connectionId: string): Promise<Record<string, string> | null>;
+}
+
+/** One command run inside the owning user's VM. */
+export interface VmRunResult {
+  exitCode: number;
+  stdout: string;
+  stderr: string;
+}
+
+/** Run commands and seed files inside the owning user's VM (runtime). */
+export interface LibraryVmRunner {
+  exec(
+    ownerId: string,
+    argv: string[],
+    opts?: { stdin?: string; timeoutMs?: number },
+  ): Promise<VmRunResult>;
+  writeFile(ownerId: string, path: string, contents: string): Promise<void>;
+}
+
+/** The user's settings allowlist for connectors. `null` allows the catalog. */
+export interface ConnectorPolicy {
+  allowedConnectorIds: string[] | null;
+}
+
+export function isConnectorAllowed(policy: ConnectorPolicy | null | undefined, connectorId: string): boolean {
+  if (!policy || policy.allowedConnectorIds === null) return true;
+  return policy.allowedConnectorIds.includes(connectorId);
+}
+
+/** Path inside the user's VM where the probe script is seeded. */
+export const MCP_PROBE_PATH = "/workspace/.swarm/mcp-probe.mjs";
