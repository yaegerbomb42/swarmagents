@@ -0,0 +1,446 @@
+/**
+ * Test-connection probe for a user MCP server (board task l4).
+ *
+ * The probe is a dependency-free Node script (MCP_PROBE_SOURCE) that speaks
+ * the MCP handshake itself — stdio via a spawned process, remote via fetch
+ * (streamable HTTP or SSE) — and prints one JSON result line to stdout:
+ *
+ *   {ok, tools: [{name, description}], resources: [{name}], prompts: [{name}], ms}
+ *   {ok: false, error, stderrTail?, ms}
+ *
+ * It runs INSIDE the user's VM (seeded with vm.writeFile, executed with
+ * vm.exec), never in the Next.js process: a stdio server the user added must
+ * only ever spawn in their VM, and a remote server must only be reached from
+ * the VM's network. `runMcpProbeLocally` is the same script spawned on the
+ * host — a test/dev helper only; no route uses it.
+ *
+ * The script is written to mirror the SDK's handshake (initialize with
+ * protocolVersion 2024-11-05, notifications/initialized, tools/list,
+ * resources/list, prompts/list) without needing the SDK installed in the VM.
+ */
+
+import { spawn } from "node:child_process";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import type { McpTransport, UserMcpServer } from "./mcp-servers";
+import { plainEnv } from "./mcp-servers";
+
+/** Path inside the user's VM where the probe script is seeded. */
+export const MCP_PROBE_PATH = "/workspace/.swarm/mcp-probe.mjs";
+
+/** Default probe timeout (the whole handshake must finish inside this). */
+export const MCP_PROBE_TIMEOUT_MS = 15000;
+
+export interface McpProbeConfig {
+  transport: McpTransport;
+  command?: string;
+  args?: string[];
+  env?: Record<string, string>;
+  url?: string;
+  headers?: Record<string, string>;
+  timeoutMs?: number;
+}
+
+export interface McpProbeTool {
+  name: string;
+  description: string;
+}
+
+export interface McpProbeResult {
+  ok: boolean;
+  tools: McpProbeTool[];
+  resources: McpProbeTool[];
+  prompts: McpProbeTool[];
+  /** Milliseconds the handshake took. */
+  ms: number;
+  error?: string;
+  /** Last ~2KB of the stdio server's stderr (failure diagnosis only). */
+  stderrTail?: string;
+}
+
+/** Minimal VM surface the probe needs (VmManager satisfies it structurally). */
+export interface VmProbeRunner {
+  writeFile(userId: string, path: string, content: string): Promise<void>;
+  exec(
+    userId: string,
+    cmd: string[],
+    opts?: {
+      stdin?: string;
+      timeoutMs?: number;
+      onStdout?: (chunk: string) => void;
+      onStderr?: (chunk: string) => void;
+    },
+  ): Promise<{ exitCode: number; truncated?: boolean }>;
+}
+
+// ---------------------------------------------------------------------------
+// The probe script (dependency-free Node; runs inside the user's VM)
+// ---------------------------------------------------------------------------
+
+export const MCP_PROBE_SOURCE = [
+  "// SwarmAgents MCP test-connection probe (auto-generated, dependency-free).",
+  "// Reads one JSON config from stdin, runs the MCP handshake, prints one",
+  "// JSON result line to stdout. Diagnostics go to stderr, never stdout.",
+  "import { spawn } from 'node:child_process';",
+  "",
+  "const started = Date.now();",
+  "const out = (result) => { process.stdout.write(JSON.stringify({ ...result, ms: Date.now() - started }) + '\\n'); };",
+  "const fail = (error, extra) => { out({ ok: false, tools: [], resources: [], prompts: [], error, ...(extra || {}) }); };",
+  "",
+  "let config;",
+  "try {",
+  "  const text = await new Promise((resolve, reject) => {",
+  "    let buf = '';",
+  "    process.stdin.setEncoding('utf-8');",
+  "    process.stdin.on('data', (c) => { buf += c; });",
+  "    process.stdin.on('end', () => resolve(buf));",
+  "    process.stdin.on('error', reject);",
+  "  });",
+  "  config = JSON.parse(text);",
+  "} catch (e) { fail('Probe config was not valid JSON: ' + (e && e.message ? e.message : String(e))); process.exit(0); }",
+  "",
+  "const timeoutMs = typeof config.timeoutMs === 'number' && config.timeoutMs > 0 ? config.timeoutMs : 15000;",
+  "const deadline = setTimeout(() => { fail('Timed out after ' + timeoutMs + 'ms waiting for the server to answer.'); process.exit(0); }, timeoutMs);",
+  "const clear = () => clearTimeout(deadline);",
+  "",
+  "const CLIENT = { protocolVersion: '2024-11-05', capabilities: {}, clientInfo: { name: 'swarmagents-probe', version: '1.0.0' } };",
+  "const names = (list) => (Array.isArray(list) ? list : []).filter((t) => t && typeof t.name === 'string').map((t) => ({ name: t.name, description: typeof t.description === 'string' ? t.description : '' }));",
+  "",
+  "// ---- stdio ------------------------------------------------------------",
+  "async function probeStdio() {",
+  "  const child = spawn(config.command, Array.isArray(config.args) ? config.args : [], {",
+  "    env: { ...process.env, ...(config.env || {}) },",
+  "    stdio: ['pipe', 'pipe', 'pipe'],",
+  "  });",
+  "  let stderr = '';",
+  "  child.stderr.setEncoding('utf-8');",
+  "  child.stderr.on('data', (c) => { stderr += c; if (stderr.length > 8192) stderr = stderr.slice(-8192); });",
+  "  const send = (msg) => new Promise((resolve, reject) => {",
+  "    child.stdin.write(JSON.stringify(msg) + '\\n', (err) => (err ? reject(err) : resolve()));",
+  "  });",
+  "  let nextId = 1;",
+  "  const pending = new Map();",
+  "  let buf = '';",
+  "  child.stdout.setEncoding('utf-8');",
+  "  child.stdout.on('data', (chunk) => {",
+  "    buf += chunk;",
+  "    let idx;",
+  "    while ((idx = buf.indexOf('\\n')) >= 0) {",
+  "      const line = buf.slice(0, idx).trim();",
+  "      buf = buf.slice(idx + 1);",
+  "      if (!line) continue;",
+  "      let msg;",
+  "      try { msg = JSON.parse(line); } catch { continue; }",
+  "      if (msg && typeof msg.id !== 'undefined' && pending.has(msg.id)) {",
+  "        const { resolve, reject } = pending.get(msg.id);",
+  "        pending.delete(msg.id);",
+  "        if (msg.error) reject(new Error(msg.error.message || 'JSON-RPC error ' + msg.error.code));",
+  "        else resolve(msg.result);",
+  "      }",
+  "    }",
+  "  });",
+  "  const request = (method, params) => new Promise((resolve, reject) => {",
+  "    const id = nextId++;",
+  "    pending.set(id, { resolve, reject });",
+  "    send({ jsonrpc: '2.0', id, method, params }).catch(reject);",
+  "  });",
+  "  const notify = (method) => send({ jsonrpc: '2.0', method }).catch(() => {});",
+  "  const list = async (method, key) => {",
+  "    try { const r = await request(method, {}); return names(r ? r[key] : []); }",
+  "    catch { return []; }",
+  "  };",
+  "  try {",
+  "    const earlyFailure = new Promise((_, reject) => {",
+  "      child.once('error', (e) => reject(e));",
+  "      child.once('exit', (code, signal) => reject(new Error('Server exited before answering (code ' + code + ', signal ' + signal + ')')));",
+  "    });",
+  "    const init = await Promise.race([request('initialize', CLIENT), earlyFailure]);",
+  "    if (!init || typeof init !== 'object') throw new Error('Server answered initialize with no result.');",
+  "    await notify('notifications/initialized');",
+  "    const [tools, resources, prompts] = await Promise.all([",
+  "      list('tools/list', 'tools'), list('resources/list', 'resources'), list('prompts/list', 'prompts'),",
+  "    ]);",
+  "    clear();",
+  "    child.kill();",
+  "    out({ ok: true, tools, resources, prompts });",
+  "  } catch (e) {",
+  "    clear();",
+  "    try { child.kill(); } catch {}",
+  "    const tail = stderr.trim().slice(-2000);",
+  "    fail('stdio probe failed: ' + (e && e.message ? e.message : String(e)), tail ? { stderrTail: tail } : undefined);",
+  "  }",
+  "  process.exit(0);",
+  "}",
+  "",
+  "// ---- remote (streamable HTTP / SSE) ------------------------------------",
+  "function parseSse(text) {",
+  "  const frames = [];",
+  "  for (const block of text.split(/\\r?\\n\\r?\\n/)) {",
+  "    if (!block.trim()) continue;",
+  "    let event = 'message';",
+  "    const data = [];",
+  "    for (const line of block.split(/\\r?\\n/)) {",
+  "      if (line.startsWith('event:')) event = line.slice(6).trim();",
+  "      else if (line.startsWith('data:')) data.push(line.slice(5).replace(/^ /, ''));",
+  "    }",
+  "    if (data.length) frames.push({ event, data: data.join('\\n') });",
+  "  }",
+  "  return frames;",
+  "}",
+  "",
+  "async function postRpc(url, body, sessionId) {",
+  "  const headers = { 'content-type': 'application/json', accept: 'application/json, text/event-stream', ...(config.headers || {}) };",
+  "  if (sessionId) headers['mcp-session-id'] = sessionId;",
+  "  const res = await fetch(url, { method: 'POST', headers, body: JSON.stringify(body), signal: AbortSignal.timeout(timeoutMs) });",
+  "  const nextSession = res.headers.get('mcp-session-id') || sessionId;",
+  "  if (res.status === 202 || res.status === 204) return { sessionId: nextSession };",
+  "  const text = await res.text();",
+  "  if (!res.ok) throw new Error('Server answered HTTP ' + res.status + (text ? ': ' + text.slice(0, 300) : ''));",
+  "  const ctype = (res.headers.get('content-type') || '').toLowerCase();",
+  "  if (ctype.includes('text/event-stream')) {",
+  "    for (const frame of parseSse(text)) {",
+  "      try {",
+  "        const msg = JSON.parse(frame.data);",
+  "        if (msg && typeof msg.id !== 'undefined') {",
+  "          if (msg.error) throw new Error(msg.error.message || 'JSON-RPC error ' + msg.error.code);",
+  "          return { result: msg.result, sessionId: nextSession };",
+  "        }",
+  "      } catch (e) { if (e && e.message && e.message.startsWith('JSON-RPC')) throw e; }",
+  "    }",
+  "    return { sessionId: nextSession };",
+  "  }",
+  "  let msg;",
+  "  try { msg = JSON.parse(text); } catch { throw new Error('Server answered with non-JSON: ' + text.slice(0, 200)); }",
+  "  if (msg && msg.error) throw new Error(msg.error.message || 'JSON-RPC error ' + msg.error.code);",
+  "  return { result: msg ? msg.result : undefined, sessionId: nextSession };",
+  "}",
+  "",
+  "async function probeStreamableHttp() {",
+  "  try {",
+  "    let nextId = 1;",
+  "    let sessionId;",
+  "    const call = async (method, params) => {",
+  "      const r = await postRpc(config.url, { jsonrpc: '2.0', id: nextId++, method, params }, sessionId);",
+  "      sessionId = r.sessionId;",
+  "      return r.result;",
+  "    };",
+  "    const init = await call('initialize', CLIENT);",
+  "    if (!init || typeof init !== 'object') throw new Error('Server answered initialize with no result.');",
+  "    await postRpc(config.url, { jsonrpc: '2.0', method: 'notifications/initialized' }, sessionId).catch(() => {});",
+  "    const list = async (method, key) => { try { const r = await call(method, {}); return names(r ? r[key] : []); } catch { return []; } };",
+  "    const [tools, resources, prompts] = await Promise.all([",
+  "      list('tools/list', 'tools'), list('resources/list', 'resources'), list('prompts/list', 'prompts'),",
+  "    ]);",
+  "    clear();",
+  "    out({ ok: true, tools, resources, prompts });",
+  "  } catch (e) {",
+  "    clear();",
+  "    fail('Remote probe failed: ' + (e && e.message ? e.message : String(e)));",
+  "  }",
+  "  process.exit(0);",
+  "}",
+  "",
+  "async function probeSse() {",
+  "  try {",
+  "    const ctrl = new AbortController();",
+  "    const res = await fetch(config.url, { headers: { accept: 'text/event-stream', ...(config.headers || {}) }, signal: ctrl.signal });",
+  "    if (!res.ok || !res.body) throw new Error('Server answered HTTP ' + res.status + ' opening the SSE stream.');",
+  "    const reader = res.body.getReader();",
+  "    const decoder = new TextDecoder();",
+  "    let buffer = '';",
+  "    let endpoint = null;",
+  "    const inbox = [];",
+  "    const waiters = new Map();",
+  "    const deliver = (msg) => {",
+  "      if (msg && typeof msg.id !== 'undefined' && waiters.has(msg.id)) {",
+  "        const { resolve, reject } = waiters.get(msg.id);",
+  "        waiters.delete(msg.id);",
+  "        if (msg.error) reject(new Error(msg.error.message || 'JSON-RPC error ' + msg.error.code));",
+  "        else resolve(msg.result);",
+  "      } else if (msg) inbox.push(msg);",
+  "    };",
+  "    const pump = (async () => {",
+  "      try {",
+  "        for (;;) {",
+  "          const { done, value } = await reader.read();",
+  "          if (done) break;",
+  "          buffer += decoder.decode(value, { stream: true });",
+  "          let idx;",
+  "          while ((idx = buffer.indexOf('\\n\\n')) >= 0) {",
+  "            const block = buffer.slice(0, idx);",
+  "            buffer = buffer.slice(idx + 2);",
+  "            for (const frame of parseSse(block + '\\n\\n')) {",
+  "              if (frame.event === 'endpoint') { endpoint = new URL(frame.data.trim(), config.url).toString(); continue; }",
+  "              try { deliver(JSON.parse(frame.data)); } catch {}",
+  "            }",
+  "          }",
+  "        }",
+  "      } catch {}",
+  "    })();",
+  "    const waitEndpoint = new Promise((resolve, reject) => {",
+  "      const t0 = Date.now();",
+  "      const tick = () => {",
+  "        if (endpoint) return resolve(endpoint);",
+  "        if (Date.now() - t0 > 8000) return reject(new Error('Server never sent an SSE endpoint.'));",
+  "        setTimeout(tick, 50);",
+  "      };",
+  "      tick();",
+  "    });",
+  "    const endpointUrl = await waitEndpoint;",
+  "    let nextId = 1;",
+  "    const call = (method, params) => new Promise((resolve, reject) => {",
+  "      const id = nextId++;",
+  "      waiters.set(id, { resolve, reject });",
+  "      fetch(endpointUrl, { method: 'POST', headers: { 'content-type': 'application/json', accept: 'application/json, text/event-stream', ...(config.headers || {}) }, body: JSON.stringify({ jsonrpc: '2.0', id, method, params }), signal: AbortSignal.timeout(timeoutMs) }).then(async (r) => {",
+  "        const text = await r.text().catch(() => '');",
+  "        if (!r.ok) { waiters.delete(id); return reject(new Error('Server answered HTTP ' + r.status)); }",
+  "        try { const msg = JSON.parse(text); if (msg && typeof msg.id !== 'undefined') deliver(msg); }",
+  "        catch { for (const frame of parseSse(text)) { try { deliver(JSON.parse(frame.data)); } catch {} } }",
+  "      }).catch((e) => { waiters.delete(id); reject(e); });",
+  "      setTimeout(() => { if (waiters.has(id)) { waiters.delete(id); reject(new Error('No answer to ' + method + ' within ' + timeoutMs + 'ms.')); } }, timeoutMs);",
+  "    });",
+  "    const list = async (method, key) => { try { const r = await call(method, {}); return names(r ? r[key] : []); } catch { return []; } };",
+  "    const init = await call('initialize', CLIENT);",
+  "    if (!init || typeof init !== 'object') throw new Error('Server answered initialize with no result.');",
+  "    await fetch(endpointUrl, { method: 'POST', headers: { 'content-type': 'application/json', ...(config.headers || {}) }, body: JSON.stringify({ jsonrpc: '2.0', method: 'notifications/initialized' }), signal: AbortSignal.timeout(timeoutMs) }).catch(() => {});",
+  "    const [tools, resources, prompts] = await Promise.all([",
+  "      list('tools/list', 'tools'), list('resources/list', 'resources'), list('prompts/list', 'prompts'),",
+  "    ]);",
+  "    ctrl.abort();",
+  "    await pump.catch(() => {});",
+  "    clear();",
+  "    out({ ok: true, tools, resources, prompts });",
+  "  } catch (e) {",
+  "    clear();",
+  "    fail('Remote probe failed: ' + (e && e.message ? e.message : String(e)));",
+  "  }",
+  "  process.exit(0);",
+  "}",
+  "",
+  "if (config.transport === 'stdio') await probeStdio();",
+  "else if (config.transport === 'sse') await probeSse();",
+  "else if (config.transport === 'streamable-http') await probeStreamableHttp();",
+  "else { clear(); fail('Unknown transport: ' + String(config.transport)); process.exit(0); }",
+].join("\n");
+
+/** Probe config for a stored server (decrypted env — server-side only). */
+export function probeConfigForServer(server: UserMcpServer, opts: { timeoutMs?: number } = {}): McpProbeConfig {
+  const base = { timeoutMs: opts.timeoutMs ?? MCP_PROBE_TIMEOUT_MS };
+  if (server.transport === "stdio") {
+    return { ...base, transport: "stdio", command: server.command ?? "", args: server.args ?? [], env: plainEnv(server.env) };
+  }
+  return {
+    ...base,
+    transport: server.transport,
+    url: server.url ?? "",
+    headers: plainEnv(server.headers),
+  };
+}
+
+/** Parse the probe's stdout: one JSON result line. Throws on garbage. */
+export function parseProbeResult(stdout: string): McpProbeResult {
+  const line = stdout
+    .split("\n")
+    .map((l) => l.trim())
+    .find((l) => l.startsWith("{"));
+  if (!line) throw new Error("The probe printed no result.");
+  let data: unknown;
+  try {
+    data = JSON.parse(line);
+  } catch {
+    throw new Error("The probe printed an unreadable result.");
+  }
+  if (!data || typeof data !== "object") throw new Error("The probe printed an unreadable result.");
+  const r = data as Record<string, unknown>;
+  const names = (value: unknown): McpProbeTool[] =>
+    Array.isArray(value)
+      ? value
+          .filter((t): t is Record<string, unknown> => !!t && typeof t === "object" && typeof (t as Record<string, unknown>).name === "string")
+          .map((t) => ({
+            name: (t as Record<string, unknown>).name as string,
+            description: typeof (t as Record<string, unknown>).description === "string" ? ((t as Record<string, unknown>).description as string) : "",
+          }))
+      : [];
+  return {
+    ok: r.ok === true,
+    tools: names(r.tools),
+    resources: names(r.resources),
+    prompts: names(r.prompts),
+    ms: typeof r.ms === "number" ? r.ms : 0,
+    ...(typeof r.error === "string" ? { error: r.error } : {}),
+    ...(typeof r.stderrTail === "string" ? { stderrTail: r.stderrTail } : {}),
+  };
+}
+
+/**
+ * Run the probe script on this host. Test/dev helper ONLY — routes must use
+ * probeMcpServerInVm so user servers never execute in the Next.js process.
+ */
+export async function runMcpProbeLocally(config: McpProbeConfig): Promise<McpProbeResult> {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "swarm-mcp-probe-"));
+  const scriptPath = path.join(dir, "probe.mjs");
+  try {
+    fs.writeFileSync(scriptPath, MCP_PROBE_SOURCE, "utf-8");
+    const child = spawn(process.execPath, [scriptPath], { stdio: ["pipe", "pipe", "pipe"] });
+    let stdout = "";
+    let stderr = "";
+    child.stdout.setEncoding("utf-8");
+    child.stderr.setEncoding("utf-8");
+    child.stdout.on("data", (c: string) => {
+      stdout += c;
+    });
+    child.stderr.on("data", (c: string) => {
+      stderr += c;
+    });
+    child.stdin.end(JSON.stringify(config));
+    const code = await new Promise<number | null>((resolve) => {
+      child.once("exit", (c) => resolve(c));
+      child.once("error", () => resolve(null));
+    });
+    if (code === null) throw new Error("Could not start the probe (node unavailable).");
+    try {
+      return parseProbeResult(stdout);
+    } catch {
+      throw new Error(`The probe exited (${code}) without a result.${stderr ? ` stderr: ${stderr.slice(-500)}` : ""}`);
+    }
+  } finally {
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+}
+
+/**
+ * Test a stored server inside the user's VM: seed the probe script, run it
+ * with the server's config on stdin, parse the one-line JSON result.
+ */
+export async function probeMcpServerInVm(
+  vm: VmProbeRunner,
+  userId: string,
+  server: UserMcpServer,
+  opts: { timeoutMs?: number } = {},
+): Promise<McpProbeResult> {
+  const config = probeConfigForServer(server, opts);
+  await vm.writeFile(userId, MCP_PROBE_PATH, MCP_PROBE_SOURCE);
+  let stdout = "";
+  let stderr = "";
+  const result = await vm.exec(userId, ["node", MCP_PROBE_PATH], {
+    stdin: JSON.stringify(config),
+    timeoutMs: (opts.timeoutMs ?? MCP_PROBE_TIMEOUT_MS) + 5000,
+    onStdout: (chunk) => {
+      stdout += chunk;
+    },
+    onStderr: (chunk) => {
+      stderr += chunk;
+    },
+  });
+  if (result.exitCode !== 0) {
+    try {
+      return parseProbeResult(stdout);
+    } catch {
+      throw new Error(
+        `The probe failed inside the VM (exit ${result.exitCode}).${stderr ? ` ${stderr.slice(-500)}` : ""}`,
+      );
+    }
+  }
+  return parseProbeResult(stdout);
+}
