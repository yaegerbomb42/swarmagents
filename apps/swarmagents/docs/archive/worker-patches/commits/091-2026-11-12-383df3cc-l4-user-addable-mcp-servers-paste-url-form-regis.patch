+/**
+ * Official MCP registry search + entry normalization.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import { normalizeRegistryServer, RegistryError, searchRegistry } from "./mcp-registry";
+
+const REMOTE_ENTRY = {
+  server: {
+    name: "ac.inference.sh/mcp",
+    title: "inference.sh",
+    description: "Run 150+ AI apps.",
+    version: "1.0.0",
+    repository: { url: "https://github.com/example/inference" },
+    remotes: [{ type: "streamable-http", url: "https://api.inference.sh/mcp" }],
+  },
+};
+
+const STDIO_ENTRY = {
+  server: {
+    name: "io.github.modelcontextprotocol/filesystem",
+    description: "Filesystem access.",
+    version: "2025.1.1",
+    repository: { url: "https://github.com/modelcontextprotocol/servers" },
+    packages: [
+      {
+        registryType: "npm",
+        identifier: "@modelcontextprotocol/server-filesystem",
+        version: "2025.1.1",
+        runtimeHint: "npx",
+        transport: { type: "stdio" },
+        runtimeArguments: [{ type: "positional", value: "/workspace" }],
+        environmentVariables: [
+          { name: "ALLOWED_DIR", description: "Directory to allow.", isRequired: false, isSecret: false },
+          { name: "FS_API_KEY", description: "API key.", isRequired: true, isSecret: true },
+        ],
+      },
+    ],
+  },
+};
+
+test("normalizeRegistryServer: remote entry keeps its URL and transport", () => {
+  const out = normalizeRegistryServer(REMOTE_ENTRY);
+  assert.ok(out);
+  assert.equal(out.id, "ac.inference.sh/mcp");
+  assert.equal(out.transport, "streamable-http");
+  assert.equal(out.url, "https://api.inference.sh/mcp");
+  assert.equal(out.homepage, "https://github.com/example/inference");
+  assert.deepEqual(out.envVars, []);
+});
+
+test("normalizeRegistryServer: stdio npm entry becomes an npx command", () => {
+  const out = normalizeRegistryServer(STDIO_ENTRY);
+  assert.ok(out);
+  assert.equal(out.transport, "stdio");
+  assert.equal(out.command, "npx");
+  assert.deepEqual(out.args, ["-y", "@modelcontextprotocol/server-filesystem", "/workspace"]);
+  assert.equal(out.envVars.length, 2);
+  assert.equal(out.envVars[1].name, "FS_API_KEY");
+  assert.equal(out.envVars[1].required, true);
+  assert.equal(out.envVars[1].secret, true);
+});
+
+test("normalizeRegistryServer: entries with no usable transport are skipped", () => {
+  assert.equal(normalizeRegistryServer({ server: { name: "x", packages: [{ identifier: "y", runtimeHint: "weird" }] } }), null);
+  assert.equal(normalizeRegistryServer({ server: { name: "x" } }), null);
+  assert.equal(normalizeRegistryServer({ nope: true }), null);
+  assert.equal(normalizeRegistryServer(null), null);
+});
+
+test("searchRegistry: stubbed fetch returns real-shaped results", async () => {
+  const fetchImpl = async (url: string) => {
+    assert.ok(url.startsWith("https://registry.modelcontextprotocol.io/v0/servers?"));
+    assert.ok(url.includes("search=filesystem"));
+    return {
+      ok: true,
+      status: 200,
+      json: async () => ({ servers: [STDIO_ENTRY, REMOTE_ENTRY, { server: { name: "broken" } }] }),
+    };
+  };
+  const results = await searchRegistry("filesystem", { fetchImpl });
+  assert.equal(results.length, 2);
+  assert.equal(results[0].transport, "stdio");
+  assert.equal(results[1].transport, "streamable-http");
+});
+
+test("searchRegistry: registry errors surface, never fake results", async () => {
+  const failing = async () => ({ ok: false, status: 500, json: async () => ({}) });
+  await assert.rejects(() => searchRegistry("x", { fetchImpl: failing }), RegistryError);
+  const down = async () => {
+    throw new Error("ECONNREFUSED");
+  };
+  await assert.rejects(() => searchRegistry("x", { fetchImpl: down }), /could not be reached/);
+});
diff --git a/apps/swarmagents/lib/mcp-registry.ts b/apps/swarmagents/lib/mcp-registry.ts
new file mode 100644
index 000000000..fb86c0512
--- /dev/null
+++ b/apps/swarmagents/lib/mcp-registry.ts
@@ -0,0 +1,241 @@
+/**
+ * Search the official MCP registry (registry.modelcontextprotocol.io).
+ *
+ * The registry API is real and reachable: GET
+ * https://registry.modelcontextprotocol.io/v0/servers?search=<q>&limit=<n>
+ * returns `{servers: [{server: {...}, _meta: {...}}]}` (verified 2026-11-12).
+ * Entries are normalized into the small RegistryServer shape the UI installs
+ * from; nothing is invented — an entry the registry does not return never
+ * appears, and a registry outage surfaces as an error, never fake results.
+ *
+ * A registry entry is untrusted catalog content: it is shown to the user
+ * (name, description, required env vars, transport) before install, and
+ * install only stores what the user explicitly confirmed, with env values
+ * they typed themselves.
+ */
+
+import type { McpTransport } from "./mcp-servers";
+
+export const REGISTRY_API_BASE = "https://registry.modelcontextprotocol.io";
+
+/** A registry entry reduced to what the UI needs to show + install. */
+export interface RegistryServer {
+  /** Registry name, e.g. "io.github.modelcontextprotocol/filesystem". */
+  id: string;
+  name: string;
+  title: string;
+  description: string;
+  version: string;
+  homepage: string;
+  transport: McpTransport;
+  /** stdio installs. */
+  command?: string;
+  args?: string[];
+  /** Remote installs. */
+  url?: string;
+  envVars: RegistryEnvVar[];
+}
+
+export interface RegistryEnvVar {
+  name: string;
+  description: string;
+  required: boolean;
+  secret: boolean;
+  defaultValue: string;
+}
+
+/** The registry (or the network) could not be reached. */
+export class RegistryError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "RegistryError";
+  }
+}
+
+type FetchFn = (url: string, init?: { signal?: AbortSignal }) => Promise<{
+  ok: boolean;
+  status: number;
+  json(): Promise<unknown>;
+}>;
+
+const asRecord = (value: unknown): Record<string, unknown> | null =>
+  value && typeof value === "object" && !Array.isArray(value) ? (value as Record<string, unknown>) : null;
+
+const asText = (value: unknown, max = 280): string =>
+  typeof value === "string" ? value.trim().slice(0, max) : "";
+
+/**
+ * Normalize one registry API entry (`{server: {...}}`) into a RegistryServer.
+ * Returns null when the entry has no usable transport (no remotes, no
+ * runnable package) — it is skipped, never invented.
+ */
+export function normalizeRegistryServer(entry: unknown): RegistryServer | null {
+  const root = asRecord(entry);
+  const server = root ? asRecord(root.server) : null;
+  if (!server) return null;
+  const name = asText(server.name, 200);
+  if (!name) return null;
+  const description = asText(server.description);
+  const repository = asRecord(server.repository);
+  const homepage = asText(repository?.url, 500);
+
+  const envVars: RegistryEnvVar[] = [];
+  const readEnvVars = (list: unknown): void => {
+    if (!Array.isArray(list)) return;
+    for (const item of list) {
+      const v = asRecord(item);
+      if (!v || typeof v.name !== "string" || !v.name.trim()) continue;
+      envVars.push({
+        name: v.name.trim().slice(0, 128),
+        description: asText(v.description, 280),
+        required: v.isRequired === true,
+        secret: v.isSecret === true,
+        defaultValue: typeof v.default === "string" ? v.default.slice(0, 512) : "",
+      });
+    }
+  };
+
+  // Remote first: a streamable-HTTP or SSE endpoint needs no install.
+  const remotes = Array.isArray(server.remotes) ? server.remotes : [];
+  for (const remote of remotes) {
+    const r = asRecord(remote);
+    if (!r || typeof r.url !== "string" || !r.url.trim()) continue;
+    const type = typeof r.type === "string" ? r.type.trim().toLowerCase() : "";
+    if (type !== "streamable-http" && type !== "sse") continue;
+    return {
+      id: name,
+      name,
+      title: asText(server.title, 120),
+      description,
+      version: asText(server.version, 40),
+      homepage,
+      transport: type,
+      url: r.url.trim(),
+      envVars,
+    };
+  }
+
+  // stdio: pick the first runnable package (npm via npx, python via uvx,
+  // docker image, or a plain node entry).
+  const packages = Array.isArray(server.packages) ? server.packages : [];
+  for (const pkg of packages) {
+    const p = asRecord(pkg);
+    if (!p || typeof p.identifier !== "string" || !p.identifier.trim()) continue;
+    const identifier = p.identifier.trim().slice(0, 256);
+    const runtimeHint = typeof p.runtimeHint === "string" ? p.runtimeHint.trim().toLowerCase() : "";
+    const transport = asRecord(p.transport);
+    if (transport && typeof transport.type === "string" && transport.type !== "stdio") continue;
+    readEnvVars(p.environmentVariables);
+    const runtimeArgs: string[] = [];
+    if (Array.isArray(p.runtimeArguments)) {
+      for (const arg of p.runtimeArguments) {
+        const a = asRecord(arg);
+        if (!a || typeof a.value !== "string") continue;
+        if (a.type === "named" && typeof a.name === "string" && a.name.trim()) {
+          runtimeArgs.push(`--${a.name.trim()}`, a.value);
+        } else {
+          runtimeArgs.push(a.value);
+        }
+      }
+    }
+    if (runtimeHint === "npx") {
+      return {
+        id: name,
+        name,
+        title: asText(server.title, 120),
+        description,
+        version: asText(server.version, 40),
+        homepage,
+        transport: "stdio",
+        command: "npx",
+        args: ["-y", identifier, ...runtimeArgs],
+        envVars,
+      };
+    }
+    if (runtimeHint === "uvx") {
+      return {
+        id: name,
+        name,
+        title: asText(server.title, 120),
+        description,
+        version: asText(server.version, 40),
+        homepage,
+        transport: "stdio",
+        command: "uvx",
+        args: [identifier, ...runtimeArgs],
+        envVars,
+      };
+    }
+    if (runtimeHint === "docker") {
+      return {
+        id: name,
+        name,
+        title: asText(server.title, 120),
+        description,
+        version: asText(server.version, 40),
+        homepage,
+        transport: "stdio",
+        command: "docker",
+        args: ["run", "-i", "--rm", identifier, ...runtimeArgs],
+        envVars,
+      };
+    }
+    if (runtimeHint === "node") {
+      return {
+        id: name,
+        name,
+        title: asText(server.title, 120),
+        description,
+        version: asText(server.version, 40),
+        homepage,
+        transport: "stdio",
+        command: "node",
+        args: [identifier, ...runtimeArgs],
+        envVars,
+      };
+    }
+    // Unknown runtime hint: skip this package, try the next one.
+  }
+  return null;
+}
+
+/**
+ * Search the official registry. `query` empty lists the latest servers.
+ * `fetchImpl` is injectable for tests; defaults to the global fetch.
+ */
+export async function searchRegistry(
+  query: string,
+  opts: { limit?: number; fetchImpl?: FetchFn; timeoutMs?: number } = {},
+): Promise<RegistryServer[]> {
+  const limit = Math.min(Math.max(opts.limit ?? 20, 1), 50);
+  const params = new URLSearchParams({ limit: String(limit) });
+  const q = query.trim();
+  if (q) params.set("search", q);
+  const url = `${REGISTRY_API_BASE}/v0/servers?${params.toString()}`;
+  const fetchImpl: FetchFn = opts.fetchImpl ?? ((u: string, init?: { signal?: AbortSignal }) => fetch(u, init));
+  let res;
+  try {
+    res = await fetchImpl(url, { signal: AbortSignal.timeout(opts.timeoutMs ?? 10000) });
+  } catch (err) {
+    throw new RegistryError(
+      `The MCP registry could not be reached (${err instanceof Error ? err.message : String(err)}).`,
+    );
+  }
+  if (!res.ok) {
+    throw new RegistryError(`The MCP registry answered ${res.status}. Try again in a moment.`);
+  }
+  let data: unknown;
+  try {
+    data = await res.json();
+  } catch {
+    throw new RegistryError("The MCP registry answered with invalid JSON.");
+  }
+  const root = asRecord(data);
+  const servers = root && Array.isArray(root.servers) ? root.servers : [];
+  const out: RegistryServer[] = [];
+  for (const entry of servers) {
+    const normalized = normalizeRegistryServer(entry);
+    if (normalized) out.push(normalized);
+  }
+  return out;
+}
