@@ -0,0 +1,31 @@
+import { NextResponse } from "next/server";
+import { searchRegistry, RegistryError } from "@/lib/mcp-registry";
+import { providerOwner } from "@/lib/providers/owner";
+
+export const dynamic = "force-dynamic";
+
+const NO_STORE = { "cache-control": "no-store" } as const;
+
+/**
+ * GET /api/mcp-servers/registry?q=<query>&limit=<n> — search the official MCP
+ * registry (registry.modelcontextprotocol.io). Results are real registry
+ * entries, normalized; a registry outage returns 502, never fake results.
+ */
+export async function GET(request: Request) {
+  const owner = providerOwner(request);
+  if (!owner) {
+    return NextResponse.json({ error: "Sign in required." }, { status: 401, headers: NO_STORE });
+  }
+  const url = new URL(request.url);
+  const q = url.searchParams.get("q") ?? "";
+  const limit = Number(url.searchParams.get("limit") ?? "20");
+  try {
+    const servers = await searchRegistry(q, { limit: Number.isFinite(limit) ? limit : 20 });
+    return NextResponse.json({ servers }, { headers: NO_STORE });
+  } catch (err) {
+    if (err instanceof RegistryError) {
+      return NextResponse.json({ error: err.message }, { status: 502, headers: NO_STORE });
+    }
+    throw err;
+  }
+}
diff --git a/apps/swarmagents/app/api/mcp-servers/route.ts b/apps/swarmagents/app/api/mcp-servers/route.ts
new file mode 100644
index 000000000..48cd374ab
--- /dev/null
+++ b/apps/swarmagents/app/api/mcp-servers/route.ts
@@ -0,0 +1,214 @@
+import { NextResponse } from "next/server";
+import { recordAudit } from "@/lib/audit";
+import {
+  classifyEnv,
+  draftFromForm,
+  draftFromRemoteUrl,
+  McpServerError,
+  parseMcpConfigJson,
+  validateServerDraft,
+  type McpServerDraft,
+} from "@/lib/mcp-servers";
+import {
+  addUserMcpServers,
+  readUserMcpServers,
+} from "@/lib/mcp-servers-store";
+import { providerOwner } from "@/lib/providers/owner";
+
+export const dynamic = "force-dynamic";
+
+const NO_STORE = { "cache-control": "no-store" } as const;
+const MAX_BODY_SIZE = 64 * 1024;
+
+function unauthorized() {
+  return NextResponse.json({ error: "Sign in required." }, { status: 401, headers: NO_STORE });
+}
+
+/**
+ * GET /api/mcp-servers — the signed-in user's MCP servers (client-safe rows;
+ * secret env values are masked, never returned).
+ */
+export function GET(request: Request) {
+  const owner = providerOwner(request);
+  if (!owner) return unauthorized();
+  return NextResponse.json({ servers: readUserMcpServers(owner) }, { headers: NO_STORE });
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function parseHeaders(raw: unknown): Record<string, string> {
+  if (!isRecord(raw)) return {};
+  const out: Record<string, string> = {};
+  for (const [key, value] of Object.entries(raw)) {
+    if (typeof value === "string" && key.trim()) out[key.trim()] = value;
+  }
+  return out;
+}
+
+function parseEnv(raw: unknown): Record<string, string> {
+  return parseHeaders(raw);
+}
+
+/**
+ * POST /api/mcp-servers — add one or more servers. Body variants:
+ *
+ *   {paste: "..."}            claude_desktop_config / .mcp.json block (one or many servers)
+ *   {url, name?, headers?}    remote server URL (streamable HTTP / SSE)
+ *   {form: {name, command, args?, env?, description?}}
+ *   {registry: {...}, env?}   a normalized registry entry + user-typed env values
+ *
+ * With {preview: true} nothing is saved: the parsed drafts (with secret
+ * flags) are returned so the UI can show them before the user confirms.
+ */
+export async function POST(request: Request) {
+  const owner = providerOwner(request);
+  if (!owner) return unauthorized();
+
+  let text: string;
+  try {
+    text = await request.text();
+  } catch {
+    return NextResponse.json({ error: "Could not read request body." }, { status: 400, headers: NO_STORE });
+  }
+  if (text.length > MAX_BODY_SIZE) {
+    return NextResponse.json({ error: "Request body too large." }, { status: 413, headers: NO_STORE });
+  }
+  let body: unknown;
+  try {
+    body = JSON.parse(text);
+  } catch {
+    return NextResponse.json({ error: "Invalid JSON body." }, { status: 400, headers: NO_STORE });
+  }
+  if (!isRecord(body)) {
+    return NextResponse.json({ error: "Body must be a JSON object." }, { status: 400, headers: NO_STORE });
+  }
+  const preview = body.preview === true;
+
+  let drafts: McpServerDraft[] = [];
+  const errors: string[] = [];
+  try {
+    if (typeof body.paste === "string") {
+      const parsed = parseMcpConfigJson(body.paste);
+      drafts = parsed.servers;
+      errors.push(...parsed.errors);
+      if (drafts.length === 0 && errors.length === 0) errors.push("No servers found in that config.");
+    } else if (typeof body.url === "string") {
+      drafts = [draftFromRemoteUrl(body.url, typeof body.name === "string" ? body.name : undefined, parseHeaders(body.headers))];
+    } else if (isRecord(body.form)) {
+      const form = body.form;
+      if (typeof form.name !== "string" || typeof form.command !== "string") {
+        return NextResponse.json({ error: "The form needs a name and a command." }, { status: 400, headers: NO_STORE });
+      }
+      const args = Array.isArray(form.args)
+        ? (form.args as unknown[]).filter((a): a is string => typeof a === "string")
+        : [];
+      drafts = [
+        draftFromForm({
+          name: form.name,
+          command: form.command,
+          args,
+          env: parseEnv(form.env),
+          description: typeof form.description === "string" ? form.description : undefined,
+        }),
+      ];
+    } else if (isRecord(body.registry)) {
+      const entry = body.registry;
+      const name = typeof entry.name === "string" ? entry.name : typeof entry.id === "string" ? entry.id : "";
+      const env = parseEnv(body.env);
+      if (entry.transport === "stdio" && typeof entry.command === "string") {
+        drafts = [
+          {
+            name,
+            description: typeof entry.description === "string" ? entry.description : "",
+            transport: "stdio",
+            command: entry.command,
+            args: Array.isArray(entry.args)
+              ? (entry.args as unknown[]).filter((a): a is string => typeof a === "string")
+              : [],
+            env: classifyEnv(env),
+            source: "registry",
+            registryId: typeof entry.id === "string" ? entry.id : undefined,
+          },
+        ];
+      } else if ((entry.transport === "streamable-http" || entry.transport === "sse") && typeof entry.url === "string") {
+        drafts = [
+          {
+            name,
+            description: typeof entry.description === "string" ? entry.description : "",
+            transport: entry.transport,
+            url: entry.url,
+            headers: classifyEnv(env),
+            source: "registry",
+            registryId: typeof entry.id === "string" ? entry.id : undefined,
+          },
+        ];
+      } else {
+        return NextResponse.json(
+          { error: "That registry entry has no usable transport (no command or url)." },
+          { status: 400, headers: NO_STORE },
+        );
+      }
+    } else {
+      return NextResponse.json(
+        { error: "Send a paste, a url, a form, or a registry entry." },
+        { status: 400, headers: NO_STORE },
+      );
+    }
+  } catch (err) {
+    if (err instanceof McpServerError) {
+      return NextResponse.json({ error: err.message }, { status: 400, headers: NO_STORE });
+    }
+    throw err;
+  }
+
+  for (const draft of drafts) errors.push(...validateServerDraft(draft));
+  if (drafts.length === 0) {
+    return NextResponse.json({ error: errors[0] ?? "No servers found.", errors }, { status: 400, headers: NO_STORE });
+  }
+
+  if (preview) {
+    // Preview shape mirrors the client row but is explicitly unsaved: the UI
+    // shows transport, command/url and which env values will be encrypted.
+    return NextResponse.json(
+      {
+        preview: drafts.map((draft) => ({
+          name: draft.name,
+          description: draft.description,
+          transport: draft.transport,
+          ...(draft.command ? { command: draft.command } : {}),
+          ...(draft.args?.length ? { args: draft.args } : {}),
+          ...(draft.url ? { url: draft.url } : {}),
+          env: Object.fromEntries(
+            Object.entries(draft.env ?? {}).map(([k, v]) => [k, v.secret ? "••••••••" : v.value]),
+          ),
+          headers: Object.fromEntries(
+            Object.entries(draft.headers ?? {}).map(([k, v]) => [k, v.secret ? "••••••••" : v.value]),
+          ),
+          secretKeys: [
+            ...Object.entries(draft.env ?? {}).filter(([, v]) => v.secret).map(([k]) => `env:${k}`),
+            ...Object.entries(draft.headers ?? {}).filter(([, v]) => v.secret).map(([k]) => `header:${k}`),
+          ],
+          source: draft.source,
+          ...(draft.registryId ? { registryId: draft.registryId } : {}),
+        })),
+        errors,
+      },
+      { headers: NO_STORE },
+    );
+  }
+
+  try {
+    const created = addUserMcpServers(owner, drafts);
+    for (const row of created) {
+      recordAudit({ user: owner, action: "mcp-server.add", target: row.id, result: "success" });
+    }
+    return NextResponse.json({ created, errors }, { status: 201, headers: NO_STORE });
+  } catch (err) {
+    return NextResponse.json(
+      { error: err instanceof Error ? err.message : "Could not save the server." },
+      { status: 400, headers: NO_STORE },
+    );
+  }
+}
