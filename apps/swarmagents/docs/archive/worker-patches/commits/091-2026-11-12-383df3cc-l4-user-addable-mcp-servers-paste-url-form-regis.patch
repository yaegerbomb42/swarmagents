index 000000000..55466fbf9
--- /dev/null
+++ b/apps/swarmagents/lib/mcp-servers.test.ts
@@ -0,0 +1,243 @@
+/**
+ * Parsing, validation, secret detection and SSRF guards for user MCP servers.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  assertPublicResolvedIps,
+  assertSafeRemoteUrl,
+  draftFromForm,
+  draftFromRemoteUrl,
+  isBlockedRemoteHost,
+  isPrivateIp,
+  looksLikeSecret,
+  maskServerForClient,
+  McpServerError,
+  normalizeUserMcpServer,
+  parseMcpConfigJson,
+  slugifyMcpServerId,
+  toClaudeMcpConfigEntry,
+  validateServerDraft,
+  type UserMcpServer,
+} from "./mcp-servers";
+
+const MULTI_SERVER_PASTE = JSON.stringify({
+  mcpServers: {
+    filesystem: {
+      command: "npx",
+      args: ["-y", "@modelcontextprotocol/server-filesystem", "/workspace"],
+      env: { ALLOWED_DIR: "/workspace" },
+    },
+    "my-remote": {
+      url: "https://mcp.example.com/sse",
+      type: "sse",
+      headers: { Authorization: "Bearer sk-test-1234567890abcdefghij" },
+    },
+    sqlite: {
+      command: "uvx",
+      args: ["mcp-server-sqlite", "--db-path", "/tmp/test.db"],
+      env: { SQLITE_KEY: "sk-abcdefghijklmnopqrstuvwx" },
+    },
+  },
+});
+
+test("parseMcpConfigJson: a multi-server paste creates multiple entries", () => {
+  const { servers, errors } = parseMcpConfigJson(MULTI_SERVER_PASTE);
+  assert.equal(errors.length, 0);
+  assert.equal(servers.length, 3);
+  const fs = servers.find((s) => s.name === "filesystem")!;
+  assert.equal(fs.transport, "stdio");
+  assert.equal(fs.command, "npx");
+  assert.deepEqual(fs.args, ["-y", "@modelcontextprotocol/server-filesystem", "/workspace"]);
+  assert.equal(fs.env?.ALLOWED_DIR.secret, false);
+  const remote = servers.find((s) => s.name === "my-remote")!;
+  assert.equal(remote.transport, "sse");
+  assert.equal(remote.url, "https://mcp.example.com/sse");
+  assert.equal(remote.headers?.Authorization.secret, true);
+  const sqlite = servers.find((s) => s.name === "sqlite")!;
+  assert.equal(sqlite.transport, "stdio");
+  assert.equal(sqlite.env?.SQLITE_KEY.secret, true);
+});
+
+test("parseMcpConfigJson: bare map, single server object, and bad input", () => {
+  const bare = parseMcpConfigJson(JSON.stringify({ solo: { command: "npx", args: ["-y", "x"] } }));
+  assert.equal(bare.servers.length, 1);
+  assert.equal(bare.servers[0].name, "solo");
+
+  const single = parseMcpConfigJson(JSON.stringify({ name: "solo", command: "node", args: ["server.js"] }));
+  assert.equal(single.servers.length, 1);
+  assert.equal(single.servers[0].transport, "stdio");
+
+  const invalid = parseMcpConfigJson("{not json");
+  assert.equal(invalid.servers.length, 0);
+  assert.ok(invalid.errors.length > 0);
+
+  const missing = parseMcpConfigJson(JSON.stringify({ mcpServers: { bad: { foo: 1 } } }));
+  assert.equal(missing.servers.length, 0);
+  assert.ok(missing.errors[0].includes("needs a"));
+
+  const empty = parseMcpConfigJson(JSON.stringify({ mcpServers: {} }));
+  assert.equal(empty.servers.length, 0);
+  assert.ok(empty.errors.length > 0);
+});
+
+test("parseMcpConfigJson: entries without command or url are skipped, not fatal", () => {
+  const { servers, errors } = parseMcpConfigJson(
+    JSON.stringify({ mcpServers: { good: { command: "npx" }, bad: { nope: true } } }),
+  );
+  assert.equal(servers.length, 1);
+  assert.equal(servers[0].name, "good");
+  assert.equal(errors.length, 1);
+});
+
+test("looksLikeSecret flags key names, known prefixes and high-entropy values", () => {
+  assert.equal(looksLikeSecret("API_KEY", "anything"), true);
+  assert.equal(looksLikeSecret("GITHUB_TOKEN", "x"), true);
+  assert.equal(looksLikeSecret("MY_SECRET", "x"), true);
+  assert.equal(looksLikeSecret("PASSWORD", "x"), true);
+  assert.equal(looksLikeSecret("ENDPOINT", "sk-abcdefghijklmnopqrstuvwx"), true);
+  assert.equal(looksLikeSecret("ENDPOINT", "ghp_abcdefghijklmnopqrstuv"), true);
+  assert.equal(looksLikeSecret("ENDPOINT", "AKIAIOSFODNN7EXAMPLE"), true);
+  assert.equal(looksLikeSecret("ALLOWED_DIR", "/workspace"), false);
+  assert.equal(looksLikeSecret("MODEL", "gpt-4o"), false);
+  assert.equal(looksLikeSecret("PORT", "8080"), false);
+});
+
+test("draftFromRemoteUrl and draftFromForm validate their input", () => {
+  const remote = draftFromRemoteUrl("https://mcp.example.com/mcp", "Example", { Authorization: "Bearer abc" });
+  assert.equal(remote.transport, "streamable-http");
+  assert.equal(remote.name, "Example");
+  assert.equal(remote.headers?.Authorization.secret, true);
+
+  assert.throws(() => draftFromRemoteUrl("http://mcp.example.com/mcp", undefined, undefined), McpServerError);
+  assert.throws(() => draftFromRemoteUrl("https://169.254.169.254/latest", undefined, undefined), McpServerError);
+
+  const form = draftFromForm({ name: "FS", command: "npx", args: ["-y", "x"], env: { KEY: "v" } });
+  assert.equal(form.transport, "stdio");
+  assert.throws(() => draftFromForm({ name: "", command: "npx" }), McpServerError);
+  assert.throws(() => draftFromForm({ name: "x", command: "" }), McpServerError);
+});
+
+test("SSRF: private, loopback, link-local and metadata hosts are blocked", () => {
+  for (const host of [
+    "localhost",
+    "127.0.0.1",
+    "127.0.0.2",
+    "10.0.0.5",
+    "172.16.0.1",
+    "172.31.255.255",
+    "192.168.1.1",
+    "169.254.169.254",
+    "0.0.0.0",
+    "::1",
+    "fe80::1",
+    "fc00::1",
+    "metadata.google.internal",
+    "foo.local",
+    "foo.internal",
+  ]) {
+    assert.equal(isBlockedRemoteHost(host), true, host);
+    assert.throws(() => assertSafeRemoteUrl(`https://${host}/mcp`), McpServerError, host);
+  }
+  for (const host of ["mcp.example.com", "8.8.8.8", "1.1.1.1", "2001:4860:4860::8888"]) {
+    assert.equal(isBlockedRemoteHost(host), false, host);
+    assert.equal(isPrivateIp(host), false, host);
+  }
+  // Public IPs stay reachable.
+  assert.equal(assertSafeRemoteUrl("https://mcp.example.com/mcp").hostname, "mcp.example.com");
+  // http is refused (headers would travel in the clear).
+  assert.throws(() => assertSafeRemoteUrl("http://mcp.example.com/mcp"), /https/);
+  // Embedded credentials are refused.
+  assert.throws(() => assertSafeRemoteUrl("https://user:pass@mcp.example.com/mcp"), /credentials/);
+});
+
+test("SSRF: DNS-resolved private addresses are blocked", () => {
+  assert.throws(() => assertPublicResolvedIps("mcp.example.com", ["93.184.216.34", "10.0.0.1"]), /private address 10\.0\.0\.1/);
+  assert.throws(() => assertPublicResolvedIps("mcp.example.com", ["::1"]), /private address ::1/);
+  assertPublicResolvedIps("mcp.example.com", ["93.184.216.34", "2606:2800:220:1:248:1893:25c8:1946"]);
+});
+
+test("validateServerDraft catches transport mismatches", () => {
+  assert.deepEqual(validateServerDraft({ name: "x", description: "", transport: "stdio", source: "form" }), [
+    "A stdio server needs a command.",
+  ]);
+  assert.deepEqual(
+    validateServerDraft({ name: "x", description: "", transport: "streamable-http", url: "http://localhost/mcp", source: "url" }),
+    ["Remote MCP servers must use https (plain http would send headers in the clear)."],
+  );
+  assert.deepEqual(
+    validateServerDraft({ name: "x", description: "", transport: "stdio", command: "npx", source: "form" }),
+    [],
+  );
+});
+
+test("toClaudeMcpConfigEntry maps stdio and remote servers", () => {
+  const stdio: UserMcpServer = {
+    id: "fs",
+    name: "FS",
+    description: "",
+    transport: "stdio",
+    command: "npx",
+    args: ["-y", "x"],
+    env: { KEY: { value: "v", secret: true } },
+    enabled: true,
+    source: "form",
+    createdAt: new Date().toISOString(),
+    updatedAt: new Date().toISOString(),
+  };
+  assert.deepEqual(toClaudeMcpConfigEntry(stdio), {
+    type: "stdio",
+    command: "npx",
+    args: ["-y", "x"],
+    env: { KEY: "v" },
+  });
+  const remote: UserMcpServer = {
+    ...stdio,
+    id: "remote",
+    transport: "streamable-http",
+    command: undefined,
+    args: undefined,
+    env: undefined,
+    url: "https://mcp.example.com/mcp",
+    headers: { Authorization: { value: "Bearer t", secret: true } },
+  };
+  assert.deepEqual(toClaudeMcpConfigEntry(remote), {
+    type: "http",
+    url: "https://mcp.example.com/mcp",
+    headers: { Authorization: "Bearer t" },
+  });
+  const sse: UserMcpServer = { ...remote, transport: "sse", url: "https://mcp.example.com/sse" };
+  assert.equal((toClaudeMcpConfigEntry(sse) as { type: string }).type, "sse");
+});
+
+test("maskServerForClient never returns a secret value", () => {
+  const server: UserMcpServer = {
+    id: "fs",
+    name: "FS",
+    description: "",
+    transport: "stdio",
+    command: "npx",
+    env: {
+      API_KEY: { value: "sk-secret-value", secret: true },
+      ALLOWED_DIR: { value: "/workspace", secret: false },
+    },
+    enabled: true,
+    source: "paste",
+    createdAt: new Date().toISOString(),
+    updatedAt: new Date().toISOString(),
+  };
+  const row = maskServerForClient(server);
+  assert.equal(row.env.API_KEY, "••••••••");
+  assert.equal(row.env.ALLOWED_DIR, "/workspace");
+  assert.deepEqual(row.secretKeys, ["env:API_KEY"]);
+  assert.ok(!JSON.stringify(row).includes("sk-secret-value"));
+});
+
+test("normalizeUserMcpServer rejects junk, slugifyMcpServerId is stable", () => {
+  assert.equal(normalizeUserMcpServer(null), null);
+  assert.equal(normalizeUserMcpServer({ id: "x" }), null);
+  assert.equal(normalizeUserMcpServer({ id: "x", name: "X", transport: "weird" }), null);
+  assert.equal(slugifyMcpServerId("My Cool Server!"), "my-cool-server");
+  assert.equal(slugifyMcpServerId(""), "mcp-server");
+});
