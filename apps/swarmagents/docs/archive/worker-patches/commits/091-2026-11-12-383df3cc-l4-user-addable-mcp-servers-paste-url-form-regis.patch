diff --git a/apps/swarmagents/minimalist-ui/src/components/McpServers.tsx b/apps/swarmagents/minimalist-ui/src/components/McpServers.tsx
new file mode 100644
index 000000000..2c0f08fd0
--- /dev/null
+++ b/apps/swarmagents/minimalist-ui/src/components/McpServers.tsx
@@ -0,0 +1,706 @@
+import { useEffect, useState } from 'react';
+import {
+  Check, ChevronDown, Eye, Globe, Loader2, PlugZap, Plus, Search, Server, Terminal, Trash2, Zap,
+} from 'lucide-react';
+
+/**
+ * MCP tab (Settings → MCP): the user's own MCP servers.
+ *
+ * Servers run inside the user's VM, never on the host, and secrets are
+ * encrypted at rest and never returned to the client — the API only ever
+ * sends masked values ("••••••••"). Add via pasted config / remote URL /
+ * form, browse the official registry, and test the connection (the probe
+ * runs in the VM and reports the tools/resources/prompts it finds).
+ */
+
+interface McpServerRow {
+  id: string;
+  name: string;
+  description: string;
+  transport: 'stdio' | 'streamable-http' | 'sse';
+  command?: string;
+  args?: string[];
+  env: Record<string, string>;
+  url?: string;
+  headers: Record<string, string>;
+  secretKeys: string[];
+  enabled: boolean;
+  source: string;
+  registryId?: string;
+}
+
+interface McpPreview {
+  name: string;
+  description: string;
+  transport: 'stdio' | 'streamable-http' | 'sse';
+  command?: string;
+  args?: string[];
+  url?: string;
+  env: Record<string, string>;
+  headers: Record<string, string>;
+  secretKeys: string[];
+  source: string;
+  registryId?: string;
+}
+
+interface RegistryEnvVar {
+  name: string;
+  description: string;
+  required: boolean;
+  secret: boolean;
+  defaultValue: string;
+}
+
+interface RegistryEntry {
+  id: string;
+  name: string;
+  title: string;
+  description: string;
+  version: string;
+  homepage: string;
+  transport: 'stdio' | 'streamable-http' | 'sse';
+  command?: string;
+  args?: string[];
+  url?: string;
+  envVars: RegistryEnvVar[];
+}
+
+interface ProbeResult {
+  ok: boolean;
+  tools: { name: string; description: string }[];
+  resources: { name: string; description: string }[];
+  prompts: { name: string; description: string }[];
+  ms: number;
+  error?: string;
+  stderrTail?: string;
+}
+
+type AddMode = 'paste' | 'url' | 'form';
+
+async function api(path: string, init?: RequestInit): Promise<{ ok: boolean; body: Record<string, unknown> }> {
+  const res = await fetch(path, { headers: { Accept: 'application/json', ...(init?.headers ?? {}) }, ...init });
+  let body: Record<string, unknown> = {};
+  try {
+    body = (await res.json()) as Record<string, unknown>;
+  } catch {
+    // Non-JSON error page: keep the status text.
+  }
+  return { ok: res.ok, body };
+}
+
+/** Parse "KEY=value" lines into a map (blank lines and #-comments skipped). */
+function parseKeyValueLines(text: string): Record<string, string> {
+  const out: Record<string, string> = {};
+  for (const line of text.split('\n')) {
+    const trimmed = line.trim();
+    if (!trimmed || trimmed.startsWith('#')) continue;
+    const eq = trimmed.indexOf('=');
+    if (eq <= 0) continue;
+    out[trimmed.slice(0, eq).trim()] = trimmed.slice(eq + 1).trim();
+  }
+  return out;
+}
+
+export function McpServers() {
+  const [servers, setServers] = useState<McpServerRow[] | null>(null);
+  const [loadError, setLoadError] = useState<string | null>(null);
+  const [mode, setMode] = useState<AddMode>('paste');
+  const [paste, setPaste] = useState('');
+  const [url, setUrl] = useState('');
+  const [urlName, setUrlName] = useState('');
+  const [urlHeaders, setUrlHeaders] = useState('');
+  const [formName, setFormName] = useState('');
+  const [formCommand, setFormCommand] = useState('');
+  const [formArgs, setFormArgs] = useState('');
+  const [formEnv, setFormEnv] = useState('');
+  const [preview, setPreview] = useState<McpPreview[] | null>(null);
+  const [previewErrors, setPreviewErrors] = useState<string[]>([]);
+  const [previewPayload, setPreviewPayload] = useState<Record<string, unknown> | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [notice, setNotice] = useState<string | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [expanded, setExpanded] = useState<string | null>(null);
+  const [tests, setTests] = useState<Record<string, ProbeResult | { busy: true }>>({});
+  const [confirmDelete, setConfirmDelete] = useState<string | null>(null);
+
+  // Registry browse.
+  const [query, setQuery] = useState('');
+  const [registry, setRegistry] = useState<RegistryEntry[] | null>(null);
+  const [registryBusy, setRegistryBusy] = useState(false);
+  const [registryError, setRegistryError] = useState<string | null>(null);
+  const [installing, setInstalling] = useState<RegistryEntry | null>(null);
+  const [installEnv, setInstallEnv] = useState<Record<string, string>>({});
+
+  const load = async () => {
+    const { ok, body } = await api('/api/mcp-servers');
+    if (ok && Array.isArray(body.servers)) {
+      setServers(body.servers as McpServerRow[]);
+      setLoadError(null);
+    } else {
+      setLoadError(typeof body.error === 'string' ? body.error : 'Could not load your MCP servers.');
+    }
+  };
+
+  useEffect(() => {
+    void load();
+  }, []);
+
+  const resetAdd = () => {
+    setPreview(null);
+    setPreviewErrors([]);
+    setPreviewPayload(null);
+  };
+
+  const runPreview = async () => {
+    setError(null);
+    setNotice(null);
+    let payload: Record<string, unknown>;
+    if (mode === 'paste') {
+      if (!paste.trim()) return setError('Paste a config block first.');
+      payload = { paste, preview: true };
+    } else if (mode === 'url') {
+      if (!url.trim()) return setError('Enter a remote server URL first.');
+      payload = { url: url.trim(), name: urlName.trim() || undefined, headers: parseKeyValueLines(urlHeaders), preview: true };
+    } else {
+      if (!formName.trim() || !formCommand.trim()) return setError('The form needs a name and a command.');
+      payload = {
+        form: {
+          name: formName.trim(),
+          command: formCommand.trim(),
+          args: formArgs.split(/\s+/).filter(Boolean),
+          env: parseKeyValueLines(formEnv),
+        },
+        preview: true,
+      };
+    }
+    setBusy(true);
+    const { ok, body } = await api('/api/mcp-servers', {
+      method: 'POST',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify(payload),
+    });
+    setBusy(false);
+    if (!ok) {
+      setError(typeof body.error === 'string' ? body.error : 'Could not parse that config.');
+      setPreview(null);
+      setPreviewPayload(null);
+      return;
+    }
+    setPreview(Array.isArray(body.preview) ? (body.preview as McpPreview[]) : []);
+    setPreviewErrors(Array.isArray(body.errors) ? (body.errors as string[]) : []);
+    setPreviewPayload(payload);
+  };
+
+  const confirmAdd = async () => {
+    if (!previewPayload) return;
+    setBusy(true);
+    const { ok, body } = await api('/api/mcp-servers', {
+      method: 'POST',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ ...previewPayload, preview: false }),
+    });
+    setBusy(false);
+    if (!ok) {
+      setError(typeof body.error === 'string' ? body.error : 'Could not save the server.');
+      return;
+    }
+    const created = Array.isArray(body.created) ? body.created.length : 0;
+    setNotice(created === 1 ? 'Server added.' : `${created} servers added.`);
+    resetAdd();
+    setPaste('');
+    setUrl('');
+    setUrlName('');
+    setUrlHeaders('');
+    setFormName('');
+    setFormCommand('');
+    setFormArgs('');
+    setFormEnv('');
+    void load();
+  };
+
+  const toggleEnabled = async (server: McpServerRow) => {
+    const { ok, body } = await api(`/api/mcp-servers/${encodeURIComponent(server.id)}`, {
+      method: 'PATCH',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ enabled: !server.enabled }),
+    });
+    if (!ok) {
+      setError(typeof body.error === 'string' ? body.error : 'Could not update the server.');
+      return;
+    }
+    setServers((list) => (list ?? []).map((s) => (s.id === server.id ? { ...s, enabled: !server.enabled } : s)));
+  };
+
+  const removeServer = async (server: McpServerRow) => {
+    const { ok, body } = await api(`/api/mcp-servers/${encodeURIComponent(server.id)}`, { method: 'DELETE' });
+    if (!ok) {
+      setError(typeof body.error === 'string' ? body.error : 'Could not delete the server.');
+      return;
+    }
+    setConfirmDelete(null);
+    setServers((list) => (list ?? []).filter((s) => s.id !== server.id));
+  };
+
+  const testServer = async (server: McpServerRow) => {
+    setTests((t) => ({ ...t, [server.id]: { busy: true } }));
+    const { ok, body } = await api(`/api/mcp-servers/${encodeURIComponent(server.id)}/test`, { method: 'POST' });
+    if (!ok && typeof body.error === 'string' && !('tools' in body)) {
+      setTests((t) => ({
+        ...t,
+        [server.id]: { ok: false, tools: [], resources: [], prompts: [], ms: 0, error: body.error as string },
+      }));
+      return;
+    }
+    setTests((t) => ({ ...t, [server.id]: body as unknown as ProbeResult }));
+  };
+
+  const searchRegistry = async () => {
+    setRegistryBusy(true);
+    setRegistryError(null);
+    const { ok, body } = await api(`/api/mcp-servers/registry?q=${encodeURIComponent(query.trim())}&limit=20`);
+    setRegistryBusy(false);
+    if (!ok) {
+      setRegistryError(typeof body.error === 'string' ? body.error : 'Registry search failed.');
+      setRegistry(null);
+      return;
+    }
+    setRegistry(Array.isArray(body.servers) ? (body.servers as RegistryEntry[]) : []);
+  };
+
+  const startInstall = (entry: RegistryEntry) => {
+    setInstalling(entry);
+    setInstallEnv(Object.fromEntries(entry.envVars.map((v) => [v.name, v.defaultValue])));
+  };
+
+  const confirmInstall = async () => {
+    if (!installing) return;
+    const missing = installing.envVars.filter((v) => v.required && !(installEnv[v.name] ?? '').trim());
+    if (missing.length > 0) {
+      setError(`Fill in the required value${missing.length === 1 ? '' : 's'}: ${missing.map((v) => v.name).join(', ')}.`);
+      return;
+    }
+    setBusy(true);
+    const { ok, body } = await api('/api/mcp-servers', {
+      method: 'POST',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ registry: installing, env: installEnv }),
+    });
+    setBusy(false);
+    if (!ok) {
+      setError(typeof body.error === 'string' ? body.error : 'Could not install that server.');
+      return;
+    }
+    setInstalling(null);
+    setNotice(`Installed ${installing.name}.`);
+    void load();
+  };
+
+  const transportLabel = (t: McpServerRow['transport']) =>
+    t === 'stdio' ? 'stdio' : t === 'sse' ? 'SSE' : 'streamable HTTP';
+
+  return (
+    <div className="space-y-6">
+      <p className="text-[11px] leading-relaxed text-white/40">
+        MCP servers run inside your VM, never on the host. Secrets in env or headers are encrypted at rest and never
+        shown back — values that look like keys are stored encrypted automatically. Roles can only use servers you
+        allow them to: add a server id to a role&apos;s MCP list to wire it into runs.
+      </p>
+
+      {notice && <div className="rounded-xl bg-emerald-500/10 px-3 py-2 text-xs text-emerald-300 ring-1 ring-emerald-500/30">{notice}</div>}
+      {error && <div className="rounded-xl bg-red-500/10 px-3 py-2 text-xs text-red-300 ring-1 ring-red-500/30">{error}</div>}
+
+      {/* Your servers */}
+      <section>
+        <Label>Your MCP servers</Label>
+        {loadError && <div className="rounded-2xl border border-dashed border-white/10 p-4 text-xs text-white/40">{loadError}</div>}
+        {servers !== null && servers.length === 0 && (
+          <div className="rounded-2xl border border-dashed border-white/10 p-6 text-center text-xs text-white/40">
+            No MCP servers yet — paste a config below or browse the registry.
+          </div>
+        )}
+        <div className="space-y-2">
+          {(servers ?? []).map((server) => {
+            const test = tests[server.id];
+            const open = expanded === server.id;
+            return (
+              <div key={server.id} className="overflow-hidden rounded-2xl bg-white/[0.04] ring-1 ring-white/10">
