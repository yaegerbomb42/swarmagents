   const phase = rolePhase(bare);
   assert.ok(phase.appendSystemPrompt?.includes("Long-running work stays visible"));
 });
+
+test("roleAllowedTools grants a user MCP server only when it exists in the user's store", () => {
+  const role: RoleDefinition = { ...mainRole(), mcpServers: ["github-mcp", "my-filesystem"] };
+  const without = roleAllowedTools(role);
+  assert.ok(without.includes("mcp__github-mcp__*"));
+  assert.ok(!without.includes("mcp__my-filesystem__*"), "unknown user server grants nothing");
+  const withStore = roleAllowedTools(role, { userMcpServerIds: new Set(["my-filesystem"]) });
+  assert.ok(withStore.includes("mcp__my-filesystem__*"));
+});
+
+test("roleMcpConfigJson wires a user MCP server only when the role lists it", () => {
+  const role: RoleDefinition = { ...mainRole(), mcpServers: ["github-mcp", "my-filesystem"] };
+  const phase = rolePhase(role, { userMcpServerIds: new Set(["my-filesystem", "other-server"]) });
+  const config = JSON.parse(
+    roleMcpConfigJson(phase, {
+      allowedRoleIds: new Set([role.id]),
+      roleDef: role,
+      userMcpServers: [
+        { id: "my-filesystem", entry: { type: "stdio", command: "npx", args: ["-y", "fs"] } },
+        { id: "other-server", entry: { type: "http", url: "https://mcp.example.com/mcp" } },
+      ],
+    }),
+  ) as { mcpServers: Record<string, unknown> };
+  assert.deepEqual(config.mcpServers["my-filesystem"], { type: "stdio", command: "npx", args: ["-y", "fs"] });
+  assert.equal(config.mcpServers["other-server"], undefined, "a server the role does not list is never wired");
+  assert.ok(config.mcpServers[ROLE_MCP_SERVER_NAME], "role-switch server stays wired");
+});
+
+test("roleSeedFiles carries user MCP servers into the run config", () => {
+  const role: RoleDefinition = { ...mainRole(), mcpServers: ["my-filesystem"] };
+  const files = roleSeedFiles([role], new Set([role.id]), rolePhase(role, { userMcpServerIds: new Set(["my-filesystem"]) }), {
+    userMcpServers: [{ id: "my-filesystem", entry: { type: "stdio", command: "npx" } }],
+  });
+  const configFile = files.find((file) => file.path === ROLE_MCP_CONFIG_PATH)!;
+  const config = JSON.parse(configFile.content) as { mcpServers: Record<string, unknown> };
+  assert.deepEqual(config.mcpServers["my-filesystem"], { type: "stdio", command: "npx" });
+});
