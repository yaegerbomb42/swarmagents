+/**
+ * Per-user MCP server store: per-account files, secrets sealed at rest.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { parseMcpConfigJson } from "./mcp-servers";
+import {
+  addUserMcpServers,
+  deleteUserMcpServer,
+  readUserMcpServers,
+  readUserMcpServersDecrypted,
+  updateUserMcpServer,
+  userMcpRunEntries,
+  userMcpServersFilePath,
+} from "./mcp-servers-store";
+import { isSealed } from "./providers/secret-box";
+
+const ALICE = "local_alice@example.com";
+const BOB = "local_bob@example.com";
+
+let tempDir: string;
+const opts = () => ({ env: { SWARM_HOME: tempDir } });
+
+test.beforeEach(() => {
+  tempDir = fs.mkdtempSync(path.join(os.tmpdir(), "swarm-mcp-store-"));
+});
+
+test.afterEach(() => {
+  fs.rmSync(tempDir, { recursive: true, force: true });
+});
+
+test("add + read: a multi-server paste stores multiple servers, masked on read", () => {
+  const { servers } = parseMcpConfigJson(
+    JSON.stringify({
+      mcpServers: {
+        filesystem: { command: "npx", args: ["-y", "fs"], env: { DIR: "/tmp" } },
+        remote: { url: "https://mcp.example.com/mcp", headers: { Authorization: "Bearer sk-abcdefghijklmnopqrst" } },
+      },
+    }),
+  );
+  const created = addUserMcpServers(ALICE, servers, opts());
+  assert.equal(created.length, 2);
+  assert.deepEqual(
+    created.map((c) => c.id).sort(),
+    ["filesystem", "remote"],
+  );
+
+  const rows = readUserMcpServers(ALICE, opts());
+  assert.equal(rows.length, 2);
+  const remote = rows.find((r) => r.id === "remote")!;
+  assert.equal(remote.headers.Authorization, "••••••••");
+  assert.deepEqual(remote.secretKeys, ["header:Authorization"]);
+  assert.ok(!JSON.stringify(rows).includes("sk-abcdefghijklmnopqrst"));
+
+  // The other user's store is empty and separate.
+  assert.deepEqual(readUserMcpServers(BOB, opts()), []);
+});
+
+test("secrets are sealed on disk, never plaintext", () => {
+  const { servers } = parseMcpConfigJson(
+    JSON.stringify({
+      mcpServers: {
+        fs: { command: "npx", env: { API_KEY: "sk-abcdefghijklmnopqrstuvwx" } },
+      },
+    }),
+  );
+  addUserMcpServers(ALICE, servers, opts());
+  const raw = fs.readFileSync(userMcpServersFilePath(ALICE, opts()), "utf-8");
+  assert.ok(!raw.includes("sk-abcdefghijklmnopqrstuvwx"), "no plaintext secret on disk");
+  const parsed = JSON.parse(raw) as { servers: Array<{ env: Record<string, { value: string }> }> };
+  assert.ok(isSealed(parsed.servers[0].env.API_KEY.value), "secret is sealed");
+
+  // Server-side decrypted read recovers the value (probe / run wiring).
+  const decrypted = readUserMcpServersDecrypted(ALICE, opts());
+  assert.equal(decrypted[0].env?.API_KEY.value, "sk-abcdefghijklmnopqrstuvwx");
+
+  // File modes: user dir 700, file 600.
+  assert.equal(fs.statSync(path.dirname(userMcpServersFilePath(ALICE, opts()))).mode & 0o777, 0o700);
+  assert.equal(fs.statSync(userMcpServersFilePath(ALICE, opts())).mode & 0o777, 0o600);
+});
+
+test("update + delete + run entries (enabled only, claude config form)", () => {
+  const { servers } = parseMcpConfigJson(
+    JSON.stringify({
+      mcpServers: {
+        a: { command: "npx", args: ["-y", "a"] },
+        b: { url: "https://mcp.example.com/mcp" },
+      },
+    }),
+  );
+  addUserMcpServers(ALICE, servers, opts());
+
+  const disabled = updateUserMcpServer(ALICE, "b", { enabled: false }, opts());
+  assert.equal(disabled?.enabled, false);
+  assert.equal(updateUserMcpServer(ALICE, "missing", { enabled: true }, opts()), null);
+
+  const entries = userMcpRunEntries(ALICE, opts());
+  assert.equal(entries.length, 1);
+  assert.equal(entries[0].id, "a");
+  assert.deepEqual(entries[0].entry, { type: "stdio", command: "npx", args: ["-y", "a"] });
+
+  assert.equal(deleteUserMcpServer(ALICE, "a", opts()), true);
+  assert.equal(deleteUserMcpServer(ALICE, "a", opts()), false);
+  assert.equal(readUserMcpServers(ALICE, opts()).length, 1);
+});
+
+test("a file owned by another user is ignored", () => {
+  addUserMcpServers(ALICE, parseMcpConfigJson(JSON.stringify({ mcpServers: { a: { command: "npx" } } })).servers, opts());
+  const file = userMcpServersFilePath(ALICE, opts());
+  const body = JSON.parse(fs.readFileSync(file, "utf-8")) as Record<string, unknown>;
+  fs.writeFileSync(file, JSON.stringify({ ...body, userId: BOB }));
+  assert.deepEqual(readUserMcpServers(ALICE, opts()), []);
+});
+
+test("duplicate names get unique ids", () => {
+  const { servers } = parseMcpConfigJson(
+    JSON.stringify({ mcpServers: { fs: { command: "npx" } } }),
+  );
+  const first = addUserMcpServers(ALICE, servers, opts());
+  const second = addUserMcpServers(ALICE, servers, opts());
+  assert.equal(first[0].id, "fs");
+  assert.equal(second[0].id, "fs-2");
+});
diff --git a/apps/swarmagents/lib/mcp-servers-store.ts b/apps/swarmagents/lib/mcp-servers-store.ts
new file mode 100644
index 000000000..8540bd3b6
--- /dev/null
+++ b/apps/swarmagents/lib/mcp-servers-store.ts
@@ -0,0 +1,306 @@
+/**
+ * Per-user MCP server store.
+ *
+ * A user's servers live on the server in
+ * `<data dir>/users/<hash(userId)>/mcp-servers.json` (dir mode 700, file mode
+ * 600) — the same layout the per-user provider and role stores use, so one
+ * data dir serves all three. There is intentionally no server-wide file: an
+ * account's servers are its own.
+ *
+ * Env/header values flagged secret (see lib/mcp-servers.ts looksLikeSecret)
+ * are sealed with AES-256-GCM (lib/providers/secret-box.ts), bound to the
+ * owner and the server id, exactly like provider keys. Non-secret values are
+ * stored in plain text. Read paths return masked rows for the client; the
+ * decrypted read is server-side only (test-connection probe, run wiring).
+ *
+ * l1 note: the Library foundation (per-user extension store) is not on main
+ * yet. This is the minimal per-user store l4 needs, following the existing
+ * provider-key patterns; it can move under l1's store later without changing
+ * callers (same read/add/update/delete surface).
+ */
+
+import fs from "node:fs";
+import path from "node:path";
+import {
+  MCP_SERVERS_SCHEMA,
+  MCP_SERVERS_VERSION,
+  maskServerForClient,
+  normalizeUserMcpServer,
+  toClaudeMcpConfigEntry,
+  uniqueMcpServerId,
+  type McpEnvEntry,
+  type McpServerDraft,
+  type McpServerRow,
+  type UserMcpServer,
+} from "./mcp-servers";
+import { isSealed, open, seal, type SecretBoxOptions } from "./providers/secret-box";
+import { providerDataDir, resolveDataDir, userDirName, type DataDirOptions } from "./providers/store";
+
+/** Per-user MCP servers file name inside the user's directory. */
+export const USER_MCP_SERVERS_FILE = "mcp-servers.json";
+const MAX_USER_ID_LEN = 256;
+const MAX_SERVERS_PER_USER = 100;
+
+/** The --mcp-config entry for one enabled user server, for run wiring. */
+export interface UserMcpRunEntry {
+  id: string;
+  entry: Record<string, unknown>;
+}
+
+function requireUserId(userId: string): string {
+  if (typeof userId !== "string" || userId.length === 0 || userId.length > MAX_USER_ID_LEN) {
+    throw new Error("A signed-in user is required.");
+  }
+  return userId;
+}
+
+/** One user's MCP servers file. */
+export function userMcpServersFilePath(userId: string, options: DataDirOptions = {}): string {
+  return path.join(resolveDataDir(options), "users", userDirName(userId), USER_MCP_SERVERS_FILE);
+}
+
+function secretOptions(options: DataDirOptions): SecretBoxOptions {
+  return { env: options.env ?? process.env, dataDir: providerDataDir(options) };
+}
+
+interface StoredFile {
+  schema: string;
+  version: number;
+  userId: string;
+  servers: unknown[];
+}
+
+function readStored(userId: string, options: DataDirOptions): UserMcpServer[] {
+  const file = userMcpServersFilePath(userId, options);
+  if (!fs.existsSync(file)) return [];
+  let raw: string;
+  try {
+    raw = fs.readFileSync(file, "utf-8");
+  } catch (err) {
+    console.error(`[swarm-mcp] ignoring unreadable MCP servers file ${file}: ${String(err)}`);
+    return [];
+  }
+  let data: unknown;
+  try {
+    data = JSON.parse(raw);
+  } catch (err) {
+    console.error(`[swarm-mcp] ignoring malformed MCP servers file ${file}: ${String(err)}`);
+    return [];
+  }
+  if (data && typeof data === "object" && !Array.isArray(data)) {
+    const record = data as Record<string, unknown>;
+    if (typeof record.userId === "string" && record.userId !== userId) {
+      console.error(`[swarm-mcp] ignoring MCP servers file ${file}: owner mismatch.`);
+      return [];
+    }
+    if (!Array.isArray(record.servers)) return [];
+    data = record.servers;
+  }
+  if (!Array.isArray(data)) return [];
+  const out: UserMcpServer[] = [];
+  for (const item of data) {
+    const server = normalizeUserMcpServer(item);
+    if (server) out.push(server);
+  }
+  return out;
+}
+
+function sealEnv(
+  env: Record<string, McpEnvEntry> | undefined,
+  userId: string,
+  serverId: string,
+  options: DataDirOptions,
+): Record<string, McpEnvEntry> | undefined {
+  if (!env) return undefined;
+  const out: Record<string, McpEnvEntry> = {};
+  for (const [key, entry] of Object.entries(env)) {
+    if (entry.secret && !isSealed(entry.value)) {
+      try {
+        out[key] = { value: seal(entry.value, userId, `mcp-server:${serverId}`, secretOptions(options)), secret: true };
+      } catch (err) {
+        // Sealing must never lose the user's server: keep the value sealed
+        // under a marker the read path reports as undecryptable.
+        console.error(`[swarm-mcp] could not seal env "${key}" for server ${serverId}: ${String(err)}`);
+        out[key] = { value: entry.value, secret: true };
+      }
+    } else {
+      out[key] = { ...entry };
+    }
+  }
+  return out;
+}
+
+function openEnv(
+  env: Record<string, McpEnvEntry> | undefined,
+  userId: string,
+  serverId: string,
+  options: DataDirOptions,
+): Record<string, McpEnvEntry> | undefined {
+  if (!env) return undefined;
+  const out: Record<string, McpEnvEntry> = {};
+  for (const [key, entry] of Object.entries(env)) {
+    if (entry.secret && isSealed(entry.value)) {
+      try {
+        out[key] = { value: open(entry.value, userId, `mcp-server:${serverId}`, secretOptions(options)), secret: true };
+      } catch (err) {
+        // A secret sealed under a rotated/removed key is dropped, not fatal:
+        // the server stays usable, minus that one value.
+        console.error(`[swarm-mcp] could not open sealed env "${key}" for server ${serverId}: ${String(err)}`);
+      }
+    } else {
+      out[key] = { ...entry };
+    }
+  }
+  return out;
+}
+
+/**
+ * Atomically replace a user's MCP servers file. Secrets are sealed on write;
+ * already-sealed values pass through untouched. Returns the written path.
+ */
+export function writeUserMcpServers(
+  userId: string,
+  servers: readonly UserMcpServer[],
+  options: DataDirOptions = {},
+): string {
+  requireUserId(userId);
+  const file = userMcpServersFilePath(userId, options);
+  const dir = path.dirname(file);
+  fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
+  try {
+    fs.chmodSync(dir, 0o700);
+  } catch {
+    // Best effort: a read-only or foreign-owned mount keeps its mode.
+  }
+  const cleaned: UserMcpServer[] = [];
+  const seen = new Set<string>();
+  for (const raw of servers.slice(0, MAX_SERVERS_PER_USER)) {
+    const server = normalizeUserMcpServer(raw);
+    if (!server || seen.has(server.id)) continue;
+    seen.add(server.id);
+    cleaned.push({
+      ...server,
+      env: sealEnv(server.env, userId, server.id, options),
+      headers: sealEnv(server.headers, userId, server.id, options),
+    });
+  }
+  const body: StoredFile = {
+    schema: MCP_SERVERS_SCHEMA,
+    version: MCP_SERVERS_VERSION,
+    userId,
+    servers: cleaned,
+  };
+  const tmp = `${file}.tmp.${process.pid}.${Date.now()}`;
+  fs.writeFileSync(tmp, JSON.stringify(body, null, 2) + "\n", { encoding: "utf-8", mode: 0o600 });
+  fs.renameSync(tmp, file);
+  try {
+    fs.chmodSync(file, 0o600);
+  } catch {
+    // Best effort.
+  }
+  return file;
+}
+
+/**
+ * The user's servers as client-safe rows (secret values masked, never
+ * returned). A missing file returns [].
+ */
+export function readUserMcpServers(userId: string, options: DataDirOptions = {}): McpServerRow[] {
+  return readStored(userId, options).map((server) => maskServerForClient(server));
+}
+
+/**
+ * The user's servers with plaintext env (server-side only: test-connection
+ * probe and run wiring). Callers must never echo env values to a client.
+ */
+export function readUserMcpServersDecrypted(userId: string, options: DataDirOptions = {}): UserMcpServer[] {
+  return readStored(userId, options).map((server) => ({
+    ...server,
+    env: openEnv(server.env, userId, server.id, options),
+    headers: openEnv(server.headers, userId, server.id, options),
+  }));
+}
+
+/**
+ * Append drafts as new servers with unique ids. Returns the created rows.
+ * Throws when the user already has MAX_SERVERS_PER_USER servers.
+ */
+export function addUserMcpServers(
+  userId: string,
+  drafts: readonly McpServerDraft[],
+  options: DataDirOptions = {},
+): McpServerRow[] {
+  const existing = readStored(userId, options);
+  if (existing.length + drafts.length > MAX_SERVERS_PER_USER) {
+    throw new Error(`You can add up to ${MAX_SERVERS_PER_USER} MCP servers.`);
+  }
+  const taken = new Set(existing.map((server) => server.id));
+  const now = new Date().toISOString();
+  const created: UserMcpServer[] = [];
+  for (const draft of drafts) {
+    const id = uniqueMcpServerId(draft.name, taken);
+    taken.add(id);
+    created.push({
+      id,
+      name: draft.name,
+      description: draft.description,
+      transport: draft.transport,
+      ...(draft.command ? { command: draft.command } : {}),
+      ...(draft.args?.length ? { args: [...draft.args] } : {}),
+      ...(draft.env && Object.keys(draft.env).length > 0 ? { env: { ...draft.env } } : {}),
+      ...(draft.url ? { url: draft.url } : {}),
+      ...(draft.headers && Object.keys(draft.headers).length > 0 ? { headers: { ...draft.headers } } : {}),
+      enabled: true,
+      source: draft.source,
+      ...(draft.registryId ? { registryId: draft.registryId } : {}),
+      createdAt: now,
+      updatedAt: now,
+    });
+  }
+  writeUserMcpServers(userId, [...existing, ...created], options);
+  return created.map((server) => maskServerForClient(server));
+}
+
+/** Patch one server (enabled flag / display name). Returns the row or null. */
+export function updateUserMcpServer(
+  userId: string,
+  serverId: string,
+  patch: { enabled?: boolean; name?: string },
+  options: DataDirOptions = {},
+): McpServerRow | null {
+  const servers = readStored(userId, options);
+  const index = servers.findIndex((server) => server.id === serverId);
+  if (index < 0) return null;
+  const updated: UserMcpServer = {
+    ...servers[index],
+    ...(typeof patch.enabled === "boolean" ? { enabled: patch.enabled } : {}),
+    ...(typeof patch.name === "string" && patch.name.trim()
+      ? { name: patch.name.trim().slice(0, 80) }
+      : {}),
+    updatedAt: new Date().toISOString(),
+  };
+  servers[index] = updated;
+  writeUserMcpServers(userId, servers, options);
+  return maskServerForClient(updated);
+}
+
+/** Delete one server. Returns true when a server was removed. */
+export function deleteUserMcpServer(userId: string, serverId: string, options: DataDirOptions = {}): boolean {
+  const servers = readStored(userId, options);
+  const kept = servers.filter((server) => server.id !== serverId);
+  if (kept.length === servers.length) return false;
+  writeUserMcpServers(userId, kept, options);
+  return true;
+}
+
+/**
+ * --mcp-config entries for the user's ENABLED servers, with decrypted env.
+ * Used to wire the user's servers into a run (lib/harness/role-mcp). A
+ * corrupt store or undecryptable secret degrades to fewer entries, never a
+ * failed run — the caller wraps this in try/catch as well.
+ */
+export function userMcpRunEntries(userId: string, options: DataDirOptions = {}): UserMcpRunEntry[] {
+  return readUserMcpServersDecrypted(userId, options)
+    .filter((server) => server.enabled)
+    .map((server) => ({ id: server.id, entry: toClaudeMcpConfigEntry(server) }));
+}
diff --git a/apps/swarmagents/lib/mcp-servers.test.ts b/apps/swarmagents/lib/mcp-servers.test.ts
