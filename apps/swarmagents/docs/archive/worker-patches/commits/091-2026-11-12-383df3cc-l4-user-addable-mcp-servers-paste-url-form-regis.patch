diff --git a/apps/swarmagents/app/api/mcp-servers/[id]/route.ts b/apps/swarmagents/app/api/mcp-servers/[id]/route.ts
new file mode 100644
index 000000000..f4ccf8ed8
--- /dev/null
+++ b/apps/swarmagents/app/api/mcp-servers/[id]/route.ts
@@ -0,0 +1,61 @@
+import { NextResponse } from "next/server";
+import { recordAudit } from "@/lib/audit";
+import { deleteUserMcpServer, updateUserMcpServer } from "@/lib/mcp-servers-store";
+import { providerOwner } from "@/lib/providers/owner";
+
+export const dynamic = "force-dynamic";
+
+const NO_STORE = { "cache-control": "no-store" } as const;
+
+function unauthorized() {
+  return NextResponse.json({ error: "Sign in required." }, { status: 401, headers: NO_STORE });
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/**
+ * PATCH /api/mcp-servers/[id] {enabled?, name?} — toggle a server or rename
+ * it. Env values are never edited through this route (secrets are write-only:
+ * delete the server and re-add it to change them).
+ */
+export async function PATCH(request: Request, { params }: { params: Promise<{ id: string }> }) {
+  const owner = providerOwner(request);
+  if (!owner) return unauthorized();
+  const { id } = await params;
+
+  let body: unknown;
+  try {
+    body = await request.json();
+  } catch {
+    return NextResponse.json({ error: "Invalid JSON body." }, { status: 400, headers: NO_STORE });
+  }
+  if (!isRecord(body)) {
+    return NextResponse.json({ error: "Body must be a JSON object." }, { status: 400, headers: NO_STORE });
+  }
+  const patch: { enabled?: boolean; name?: string } = {};
+  if (typeof body.enabled === "boolean") patch.enabled = body.enabled;
+  if (typeof body.name === "string") patch.name = body.name;
+  if (Object.keys(patch).length === 0) {
+    return NextResponse.json({ error: "Nothing to update (send enabled or name)." }, { status: 400, headers: NO_STORE });
+  }
+  const row = updateUserMcpServer(owner, id, patch);
+  if (!row) {
+    return NextResponse.json({ error: "No MCP server with that id." }, { status: 404, headers: NO_STORE });
+  }
+  return NextResponse.json({ server: row }, { headers: NO_STORE });
+}
+
+/** DELETE /api/mcp-servers/[id] — remove a server (and its sealed secrets). */
+export async function DELETE(request: Request, { params }: { params: Promise<{ id: string }> }) {
+  const owner = providerOwner(request);
+  if (!owner) return unauthorized();
+  const { id } = await params;
+  const removed = deleteUserMcpServer(owner, id);
+  if (!removed) {
+    return NextResponse.json({ error: "No MCP server with that id." }, { status: 404, headers: NO_STORE });
+  }
+  recordAudit({ user: owner, action: "mcp-server.delete", target: id, result: "success" });
+  return NextResponse.json({ deleted: id }, { headers: NO_STORE });
+}
diff --git a/apps/swarmagents/app/api/mcp-servers/[id]/test/route.ts b/apps/swarmagents/app/api/mcp-servers/[id]/test/route.ts
new file mode 100644
index 000000000..f20475596
--- /dev/null
+++ b/apps/swarmagents/app/api/mcp-servers/[id]/test/route.ts
@@ -0,0 +1,76 @@
+import { lookup } from "node:dns/promises";
+import { NextResponse } from "next/server";
+import { recordAudit } from "@/lib/audit";
+import { MCP_PROBE_TIMEOUT_MS, probeMcpServerInVm } from "@/lib/mcp-probe";
+import { assertPublicResolvedIps, assertSafeRemoteUrl } from "@/lib/mcp-servers";
+import { readUserMcpServersDecrypted } from "@/lib/mcp-servers-store";
+import { providerOwner } from "@/lib/providers/owner";
+import { getVmManager } from "@/lib/vm/manager";
+
+export const dynamic = "force-dynamic";
+
+const NO_STORE = { "cache-control": "no-store" } as const;
+
+/**
+ * POST /api/mcp-servers/[id]/test — test the connection to one stored server.
+ *
+ * The probe runs INSIDE the user's VM (seeded script + vm.exec): a stdio
+ * server spawns only in the VM, and a remote server is reached only from the
+ * VM's network. Remote URLs are SSRF-checked here first (literal private /
+ * link-local / metadata hosts, then the DNS-resolved addresses) before the
+ * config is handed to the VM.
+ *
+ * Returns {ok, tools, resources, prompts, ms} or {ok: false, error,
+ * stderrTail?, ms}. A VM that cannot be started is a 503, not a silent
+ * host-side fallback.
+ */
+export async function POST(request: Request, { params }: { params: Promise<{ id: string }> }) {
+  const owner = providerOwner(request);
+  if (!owner) {
+    return NextResponse.json({ error: "Sign in required." }, { status: 401, headers: NO_STORE });
+  }
+  const { id } = await params;
+  const server = readUserMcpServersDecrypted(owner).find((candidate) => candidate.id === id);
+  if (!server) {
+    return NextResponse.json({ error: "No MCP server with that id." }, { status: 404, headers: NO_STORE });
+  }
+
+  if (server.transport !== "stdio" && server.url) {
+    try {
+      const url = assertSafeRemoteUrl(server.url);
+      let addresses: string[] = [];
+      try {
+        const resolved = await lookup(url.hostname, { all: true });
+        addresses = resolved.map((entry) => entry.address);
+      } catch {
+        // Unresolvable host: the probe will report the DNS failure; do not
+        // block on it here.
+      }
+      assertPublicResolvedIps(url.hostname, addresses);
+    } catch (err) {
+      const message = err instanceof Error ? err.message : String(err);
+      return NextResponse.json({ ok: false, tools: [], resources: [], prompts: [], ms: 0, error: message }, { headers: NO_STORE });
+    }
+  }
+
+  try {
+    const result = await probeMcpServerInVm(getVmManager(), owner, server, {
+      timeoutMs: MCP_PROBE_TIMEOUT_MS,
+    });
+    recordAudit({ user: owner, action: "mcp-server.test", target: id, result: result.ok ? "success" : "failure" });
+    return NextResponse.json(result, { headers: NO_STORE });
+  } catch (err) {
+    const message = err instanceof Error ? err.message : String(err);
+    return NextResponse.json(
+      {
+        ok: false,
+        tools: [],
+        resources: [],
+        prompts: [],
+        ms: 0,
+        error: `The test needs your VM, which could not be started: ${message}`,
+      },
+      { status: 503, headers: NO_STORE },
+    );
+  }
+}
