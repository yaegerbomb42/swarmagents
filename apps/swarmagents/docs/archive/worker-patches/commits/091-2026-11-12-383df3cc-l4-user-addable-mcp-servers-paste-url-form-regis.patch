@@ -0,0 +1,189 @@
+/**
+ * Test-connection probe: fake stdio + fake streamable-HTTP MCP servers.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createServer, type Server } from "node:http";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import {
+  MCP_PROBE_TIMEOUT_MS,
+  parseProbeResult,
+  probeConfigForServer,
+  runMcpProbeLocally,
+} from "./mcp-probe";
+import type { UserMcpServer } from "./mcp-servers";
+
+const FAKE_STDIO_SERVER = [
+  "import readline from 'node:readline';",
+  "const rl = readline.createInterface({ input: process.stdin });",
+  "for await (const line of rl) {",
+  "  let msg;",
+  "  try { msg = JSON.parse(line); } catch { continue; }",
+  "  if (!msg || (typeof msg.method === 'string' && msg.method.startsWith('notifications/'))) continue;",
+  "  let result = null;",
+  "  if (msg.method === 'initialize') result = { protocolVersion: '2024-11-05', capabilities: { tools: {} }, serverInfo: { name: 'fake-mcp', version: '0.0.1' } };",
+  "  else if (msg.method === 'tools/list') result = { tools: [{ name: 'echo', description: 'Echoes input' }, { name: 'read_file', description: 'Reads a file' }] };",
+  "  else if (msg.method === 'resources/list') result = { resources: [{ name: 'config', uri: 'file:///config' }] };",
+  "  else if (msg.method === 'prompts/list') result = { prompts: [{ name: 'greet', description: 'Say hello' }] };",
+  "  if (result) process.stdout.write(JSON.stringify({ jsonrpc: '2.0', id: msg.id, result }) + '\\n');",
+  "  else process.stdout.write(JSON.stringify({ jsonrpc: '2.0', id: msg.id, error: { code: -32601, message: 'Method not found' } }) + '\\n');",
+  "}",
+  "",
+].join("\n");
+
+const FAILING_SERVER = "console.error('boom: missing dependency');\nprocess.exit(1);\n";
+
+let tempDir: string;
+
+test.beforeEach(() => {
+  tempDir = fs.mkdtempSync(path.join(os.tmpdir(), "swarm-mcp-probe-"));
+});
+
+test.afterEach(() => {
+  fs.rmSync(tempDir, { recursive: true, force: true });
+});
+
+function writeFake(name: string, source: string): string {
+  const file = path.join(tempDir, name);
+  fs.writeFileSync(file, source, "utf-8");
+  return file;
+}
+
+test("probe: fake stdio server lists tools, resources and prompts", async () => {
+  const serverPath = writeFake("fake-server.mjs", FAKE_STDIO_SERVER);
+  const result = await runMcpProbeLocally({
+    transport: "stdio",
+    command: process.execPath,
+    args: [serverPath],
+    timeoutMs: 10000,
+  });
+  assert.equal(result.ok, true);
+  assert.deepEqual(
+    result.tools.map((t) => t.name),
+    ["echo", "read_file"],
+  );
+  assert.deepEqual(
+    result.resources.map((t) => t.name),
+    ["config"],
+  );
+  assert.deepEqual(
+    result.prompts.map((t) => t.name),
+    ["greet"],
+  );
+  assert.ok(result.ms >= 0 && result.ms < 10000);
+});
+
+test("probe: failing stdio server reports ok:false with the stderr tail", async () => {
+  const serverPath = writeFake("failing-server.mjs", FAILING_SERVER);
+  const result = await runMcpProbeLocally({
+    transport: "stdio",
+    command: process.execPath,
+    args: [serverPath],
+    timeoutMs: 10000,
+  });
+  assert.equal(result.ok, false);
+  assert.ok(result.error);
+  assert.ok(result.stderrTail?.includes("boom: missing dependency"));
+});
+
+test("probe: a command that does not exist reports ok:false", async () => {
+  const result = await runMcpProbeLocally({
+    transport: "stdio",
+    command: "definitely-not-a-real-command-xyz",
+    args: [],
+    timeoutMs: 5000,
+  });
+  assert.equal(result.ok, false);
+  assert.ok(result.error);
+});
+
+test("probe: fake streamable-HTTP server (JSON + SSE responses)", async () => {
+  const handle = async (req: import("node:http").IncomingMessage, res: import("node:http").ServerResponse) => {
+    const chunks: Buffer[] = [];
+    for await (const chunk of req) chunks.push(chunk as Buffer);
+    let msg: { id?: number; method?: string } = {};
+    try {
+      msg = JSON.parse(Buffer.concat(chunks).toString("utf-8"));
+    } catch {
+      res.writeHead(400).end();
+      return;
+    }
+    if (typeof msg.method === "string" && msg.method.startsWith("notifications/")) {
+      res.writeHead(202).end();
+      return;
+    }
+    let result: unknown = null;
+    if (msg.method === "initialize") result = { protocolVersion: "2024-11-05", capabilities: {}, serverInfo: { name: "fake-http", version: "0.0.1" } };
+    else if (msg.method === "tools/list") result = { tools: [{ name: "search", description: "Searches" }] };
+    else if (msg.method === "resources/list") result = { resources: [] };
+    else if (msg.method === "prompts/list") result = { prompts: [] };
+    const payload = JSON.stringify({ jsonrpc: "2.0", id: msg.id, result });
+    if (req.url === "/mcp-sse") {
+      res.writeHead(200, { "content-type": "text/event-stream", "mcp-session-id": "sess-1" });
+      res.end(`event: message\ndata: ${payload}\n\n`);
+      return;
+    }
+    res.writeHead(200, { "content-type": "application/json", "mcp-session-id": "sess-1" });
+    res.end(payload);
+  };
+  const server: Server = createServer((req, res) => void handle(req, res));
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const address = server.address();
+  const port = typeof address === "object" && address ? address.port : 0;
+  try {
+    const json = await runMcpProbeLocally({
+      transport: "streamable-http",
+      url: `http://127.0.0.1:${port}/mcp`,
+      timeoutMs: 10000,
+    });
+    assert.equal(json.ok, true);
+    assert.deepEqual(
+      json.tools.map((t) => t.name),
+      ["search"],
+    );
+    const sse = await runMcpProbeLocally({
+      transport: "streamable-http",
+      url: `http://127.0.0.1:${port}/mcp-sse`,
+      timeoutMs: 10000,
+    });
+    assert.equal(sse.ok, true);
+    assert.deepEqual(
+      sse.tools.map((t) => t.name),
+      ["search"],
+    );
+  } finally {
+    server.close();
+  }
+});
+
+test("probeConfigForServer builds stdio and remote configs; parseProbeResult rejects garbage", () => {
+  const base: UserMcpServer = {
+    id: "x",
+    name: "X",
+    description: "",
+    transport: "stdio",
+    command: "npx",
+    args: ["-y", "x"],
+    env: { KEY: { value: "v", secret: false } },
+    enabled: true,
+    source: "form",
+    createdAt: new Date().toISOString(),
+    updatedAt: new Date().toISOString(),
+  };
+  const stdio = probeConfigForServer(base, { timeoutMs: 1234 });
+  assert.equal(stdio.command, "npx");
+  assert.deepEqual(stdio.env, { KEY: "v" });
+  assert.equal(stdio.timeoutMs, 1234);
+
+  const remote = probeConfigForServer({ ...base, transport: "sse", url: "https://mcp.example.com/sse" });
+  assert.equal(remote.transport, "sse");
+  assert.equal(remote.timeoutMs, MCP_PROBE_TIMEOUT_MS);
+
+  const parsed = parseProbeResult('noise\n{"ok":true,"tools":[{"name":"a","description":""}],"resources":[],"prompts":[],"ms":5}\n');
+  assert.equal(parsed.ok, true);
+  assert.equal(parsed.tools[0].name, "a");
+  assert.throws(() => parseProbeResult("no json here"), /no result/);
+});
