From 24d66e2dc6331663b76fb9a62452f2e76ae737ba Mon Sep 17 00:00:00 2001
From: yaegerbomb42 <yaeger.james42@gmail.com>
Date: Thu, 12 Nov 2026 20:07:37 -0600
Subject: [PATCH] test(b4): await async signupLocalUser in b3 tests after
 rebase

---
 apps/swarmagents/app/api/me/revoke-sessions/route.test.ts | 2 +-
 apps/swarmagents/lib/auth.test.ts                         | 6 +++---
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/apps/swarmagents/app/api/me/revoke-sessions/route.test.ts b/apps/swarmagents/app/api/me/revoke-sessions/route.test.ts
index 2be66d89c..c7c954f8f 100644
--- a/apps/swarmagents/app/api/me/revoke-sessions/route.test.ts
+++ b/apps/swarmagents/app/api/me/revoke-sessions/route.test.ts
@@ -35,7 +35,7 @@ test("POST rejects non-local identities", async () => {
 });
 
 test("POST bumps the epoch and clears this device's cookie", async () => {
-  assert.equal(signupLocalUser("alice@example.com", "correct horse battery").ok, true);
+  assert.equal((await signupLocalUser("alice@example.com", "correct horse battery")).ok, true);
   const before = getSessionEpoch("alice@example.com");
   assert.equal(before, 0);
 
diff --git a/apps/swarmagents/lib/auth.test.ts b/apps/swarmagents/lib/auth.test.ts
index 4d715fad4..38bed8f67 100644
--- a/apps/swarmagents/lib/auth.test.ts
+++ b/apps/swarmagents/lib/auth.test.ts
@@ -179,13 +179,13 @@ test("requestUser: v2 sessions work for dotted user ids", () => {
   assert.equal(requestUser(req({}, signSession("alice.smith", now - 8 * 24 * 60 * 60))), null);
 });
 
-test("requestUser: bumping the session epoch revokes that user's v2 sessions only", () => {
+test("requestUser: bumping the session epoch revokes that user's v2 sessions only", async () => {
   serverEnv();
   setupUsersStore();
   try {
     delete process.env.SWARM_SESSION_MAX_AGE_SEC;
-    assert.equal(signupLocalUser("alice@example.com", "correct horse battery").ok, true);
-    assert.equal(signupLocalUser("bob@example.com", "another strong secret").ok, true);
+    assert.equal((await signupLocalUser("alice@example.com", "correct horse battery")).ok, true);
+    assert.equal((await signupLocalUser("bob@example.com", "another strong secret")).ok, true);
 
     const now = Math.floor(Date.now() / 1000);
     // Both sessions issued a while ago (still within the 7-day TTL).
-- 
2.55.0

