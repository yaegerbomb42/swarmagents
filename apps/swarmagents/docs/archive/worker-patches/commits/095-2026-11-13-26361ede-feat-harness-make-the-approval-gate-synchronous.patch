+
+test("a deny-classified call is blocked before it runs and the run continues", async () => {
+  const { server, url } = await startBridge();
+  const { dir, plan } = workspace();
+  try {
+    const { gateway, requests } = makeGateway();
+    const planFile = plan([
+      { name: "Bash", input: { command: "cat /etc/passwd" } },
+      { name: "Bash", input: { command: "echo done" } },
+    ]);
+
+    const { events, outcome } = await runScenario({ bridgeUrl: url, planFile, cwd: dir, gateway });
+    assert.equal(outcome.exitCode, 0);
+    assert.equal(requests.length, 0, "a policy deny must not open a card");
+
+    const blocked = events.find((e) => e.type === "tool.blocked") as Extract<TelemetryEvent, { type: "tool.blocked" }>;
+    assert.ok(blocked, "the blocked call must be reported");
+    assert.equal(blocked.name, "Bash");
+
+    // The secret file's contents never reached the transcript.
+    const results = events.filter((e) => e.type === "tool.result") as Array<Extract<TelemetryEvent, { type: "tool.result" }>>;
+    assert.equal(results.some((r) => /root:x?:0:0/.test(r.output)), false, "a denied read must not leak the file");
+    // The next, benign call still ran: a denial blocks the call, not the run.
+    assert.ok(results.some((r) => r.ok && r.output.includes("done")));
+  } finally {
+    server.close();
+    rmSync(dir, { recursive: true, force: true });
