+/**
+ * Unit tests for the synchronous tool gate (lib/harness/tool-gate.ts).
+ *
+ * The gate is the app side of the VM's PreToolUse hook: it classifies a tool
+ * call, asks the user when needed, and answers allow/deny. The hook blocks the
+ * CLI on that answer, so "the verdict arrives before the tool runs" is a
+ * property of this module: nothing is allowed until decide() resolves.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  closeAllToolGates,
+  getToolGateSession,
+  openToolGate,
+  toolCallKey,
+  toolGateCount,
+  ToolGateSession,
+  TOOL_HOOK_COMMAND,
+  toolHookSettings,
+} from "./tool-gate";
+import { classifyToolCall, isIrreversibleExternal } from "./risk";
+import type { ApprovalGateway, ApprovalRequest, TelemetryEvent } from "./types";
+
+
+const HOOK_URL = "http://app.test/api/runtime/hooks/pretooluse";
+
+function deferredVerdict() {
+  let resolve!: (v: "approved" | "denied" | "expired") => void;
+  const promise = new Promise<"approved" | "denied" | "expired">((r) => {
+    resolve = r;
+  });
+  return { promise, resolve };
+}
+
+function makeGateway() {
+  const requests: ApprovalRequest[] = [];
+  const resolvers: Array<(v: "approved" | "denied" | "expired") => void> = [];
+  const gateway: ApprovalGateway = async (req) => {
+    requests.push(req);
+    const { promise, resolve } = deferredVerdict();
+    resolvers.push(resolve);
+    return { id: `appr_test_${requests.length}`, verdict: promise };
+  };
+  return { gateway, requests, resolvers };
+}
+
+function makeSession(config: Partial<Parameters<typeof openToolGate>[0]> = {}) {
+  const events: TelemetryEvent[] = [];
+  const session = openToolGate(
+    { runId: "run_1", userId: "alice", hookUrl: HOOK_URL, ...config },
+    (event) => events.push(event),
+  );
+  assert.ok(session, "gate session should open when a hook URL is configured");
+  return { session: session as ToolGateSession, events };
+}
+
+test.afterEach(() => closeAllToolGates());
+
+test("no hook URL means no session: the legacy gate stays in charge", () => {
+  assert.equal(openToolGate({ runId: "run_1", hookUrl: "" }, () => {}), null);
+  assert.equal(toolGateCount(), 0);
+});
+
+test("a benign call is allowed with no approval card", async () => {
+  const { gateway, requests } = makeGateway();
+  const { session, events } = makeSession({ approvalGateway: gateway });
+
+  const verdict = await session.decide({ tool_name: "Bash", tool_input: { command: "ls -la" }, tool_use_id: "toolu_1" });
+
+  assert.equal(verdict.decision, "allow");
+  assert.equal(requests.length, 0);
+  assert.deepEqual(events.map((e) => e.type), ["tool.started"]);
