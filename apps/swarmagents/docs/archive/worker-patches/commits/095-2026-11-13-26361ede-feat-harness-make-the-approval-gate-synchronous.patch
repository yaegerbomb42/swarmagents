diff --git a/apps/swarmagents/app/api/runtime/hooks/pretooluse/route.test.ts b/apps/swarmagents/app/api/runtime/hooks/pretooluse/route.test.ts
new file mode 100644
index 000000000..f48906f74
--- /dev/null
+++ b/apps/swarmagents/app/api/runtime/hooks/pretooluse/route.test.ts
@@ -0,0 +1,146 @@
+/**
+ * Tests for the PreToolUse hook endpoint.
+ *
+ * The endpoint is what the VM's hook client calls before every tool: its answer
+ * is the Claude Code permission decision, so "deny" here means the tool never
+ * executes. Auth is the per-run bearer token; anything unrecognised must fail
+ * closed (the client turns a non-200 into a denial).
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import { NextRequest } from "next/server";
+import { POST } from "./route";
+import { closeAllToolGates, openToolGate, type ToolGateSession } from "../../../../../lib/harness/tool-gate";
+import type { ApprovalGateway, TelemetryEvent } from "../../../../../lib/harness/types";
+
+const HOOK_URL = "http://app.test/api/runtime/hooks/pretooluse";
+
+function deferredVerdict() {
+  let resolve!: (v: "approved" | "denied" | "expired") => void;
+  const promise = new Promise<"approved" | "denied" | "expired">((r) => {
+    resolve = r;
+  });
+  return { promise, resolve };
+}
+
+function makeSession(gateway?: ApprovalGateway) {
+  const events: TelemetryEvent[] = [];
+  const session = openToolGate(
+    { runId: "run_route", userId: "alice", hookUrl: HOOK_URL, ...(gateway ? { approvalGateway: gateway } : {}) },
+    (event) => events.push(event),
+  ) as ToolGateSession;
+  return { session, events };
+}
+
+function hookRequest(token: string | null, body: unknown, raw?: string): NextRequest {
+  const headers = new Headers({ "content-type": "application/json" });
+  if (token) headers.set("authorization", `Bearer ${token}`);
+  return new NextRequest(HOOK_URL, {
+    method: "POST",
+    headers,
+    body: raw ?? JSON.stringify(body),
+  });
+}
+
+test.afterEach(() => closeAllToolGates());
+
+test("an unknown token is refused, so the hook fails closed", async () => {
+  makeSession();
+  const res = await POST(hookRequest("hk1_unknownunknownunknownunknown12", { tool_name: "Bash", tool_input: { command: "ls" } }));
+  assert.equal(res.status, 404);
+});
+
+test("a missing token is refused", async () => {
+  const res = await POST(hookRequest(null, { tool_name: "Bash", tool_input: { command: "ls" } }));
+  assert.equal(res.status, 404);
+});
+
+test("a benign call comes back as a Claude Code allow decision", async () => {
+  const { session } = makeSession();
+  const res = await POST(
+    hookRequest(session.token, { tool_name: "Bash", tool_input: { command: "ls -la" }, tool_use_id: "toolu_ok" }),
+  );
+  assert.equal(res.status, 200);
+  const body = (await res.json()) as { hookSpecificOutput: Record<string, unknown> };
+  assert.equal(body.hookSpecificOutput.hookEventName, "PreToolUse");
+  assert.equal(body.hookSpecificOutput.permissionDecision, "allow");
+  assert.equal(typeof body.hookSpecificOutput.permissionDecisionReason, "string");
+});
+
+test("an ask-classified call returns allow only after the user approves", async () => {
+  const { promise, resolve } = deferredVerdict();
+  const { session } = makeSession(async () => ({ id: "appr_route_1", verdict: promise }));
+
+  const pending = POST(
+    hookRequest(session.token, {
+      tool_name: "Bash",
+      tool_input: { command: "rm -rf /tmp/route-test" },
+      tool_use_id: "toolu_ask",
+    }),
+  );
+
+  await new Promise((r) => setTimeout(r, 20));
+  resolve("approved");
+  const res = await pending;
+  const body = (await res.json()) as { hookSpecificOutput: { permissionDecision: string } };
+  assert.equal(body.hookSpecificOutput.permissionDecision, "allow");
+});
+
+test("a denied approval returns a deny decision with the reason the model sees", async () => {
+  const { promise, resolve } = deferredVerdict();
+  const { session } = makeSession(async () => ({ id: "appr_route_2", verdict: promise }));
+
+  const pending = POST(
+    hookRequest(session.token, {
+      tool_name: "Bash",
+      tool_input: { command: "rm -rf /tmp/route-test" },
+      tool_use_id: "toolu_deny",
+    }),
+  );
+  await new Promise((r) => setTimeout(r, 20));
+  resolve("denied");
+
+  const res = await pending;
+  const body = (await res.json()) as { hookSpecificOutput: { permissionDecision: string; permissionDecisionReason: string } };
+  assert.equal(body.hookSpecificOutput.permissionDecision, "deny");
+  assert.match(body.hookSpecificOutput.permissionDecisionReason, /denied/i);
+});
+
+test("a deny-classified call is denied without opening a card", async () => {
+  let asked = 0;
+  const { session } = makeSession(async () => {
+    asked += 1;
+    return { id: "appr_unused", verdict: deferredVerdict().promise };
+  });
+  const res = await POST(
+    hookRequest(session.token, { tool_name: "Bash", tool_input: { command: "cat /etc/shadow" } }),
+  );
+  const body = (await res.json()) as { hookSpecificOutput: { permissionDecision: string } };
+  assert.equal(body.hookSpecificOutput.permissionDecision, "deny");
+  assert.equal(asked, 0);
+});
+
+test("malformed bodies are denied rather than allowed", async () => {
+  const { session } = makeSession();
+  const cases: Array<{ body: unknown; raw?: string }> = [
+    { body: null, raw: "{not json" },
+    { body: [] },
+    { body: { tool_input: { command: "ls" } } },
+    { body: { tool_name: "" } },
+  ];
+  for (const item of cases) {
+    const res = await POST(hookRequest(session.token, item.body, item.raw));
+    assert.equal(res.status, 200);
+    const body = (await res.json()) as { hookSpecificOutput: { permissionDecision: string } };
+    assert.equal(body.hookSpecificOutput.permissionDecision, "deny");
+  }
+});
+
+test("an oversized body is denied", async () => {
+  const { session } = makeSession();
+  const huge = JSON.stringify({ tool_name: "Bash", tool_input: { command: "x".repeat(200 * 1024) } });
+  const res = await POST(hookRequest(session.token, null, huge));
+  const body = (await res.json()) as { hookSpecificOutput: { permissionDecision: string } };
+  assert.equal(body.hookSpecificOutput.permissionDecision, "deny");
+});
diff --git a/apps/swarmagents/app/api/runtime/hooks/pretooluse/route.ts b/apps/swarmagents/app/api/runtime/hooks/pretooluse/route.ts
new file mode 100644
index 000000000..28586097a
--- /dev/null
+++ b/apps/swarmagents/app/api/runtime/hooks/pretooluse/route.ts
@@ -0,0 +1,100 @@
+/**
+ * PreToolUse hook endpoint: the app side of the VM's synchronous risk gate.
+ *
+ * The VM's managed settings register a PreToolUse hook
+ * (vm-image/managed-settings.json -> vm-image/pretooluse-hook.mjs). Before the
+ * CLI executes any tool it spawns that hook, which POSTs the tool call here and
+ * blocks until this route answers. The response is a Claude Code hook decision:
+ * "allow" lets the CLI run the tool, "deny" blocks it and hands the reason to
+ * the model, so a denied or timed-out approval never executes anything.
+ *
+ * Auth: `Authorization: Bearer <per-run token>`. The token is minted per run by
+ * the harness (lib/harness/tool-gate.ts), lives only in memory, is revoked when
+ * the run ends, and can only *ask* — it cannot approve anything, so a leaked
+ * token cannot lift the gate.
+ *
+ * This route is called from inside the user's VM, not from a browser: it does
+ * not use the x-swarm-user header (the hook has no session), and it never reads
+ * another user's data — the token resolves to exactly one run's gate session.
+ */
+
+import { NextResponse, type NextRequest } from "next/server";
+import { getToolGateSession } from "../../../../../lib/harness/tool-gate";
+import { recordAudit } from "../../../../../lib/audit";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+/** Tool inputs are small (a command, a path, a URL); cap the body hard. */
+const MAX_BODY_SIZE = 128 * 1024;
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/** Extract the bearer token from the Authorization header. */
+function bearerToken(req: NextRequest): string | null {
+  const header = req.headers.get("authorization");
+  if (!header) return null;
+  const match = /^Bearer\s+(\S+)$/i.exec(header.trim());
+  return match ? match[1] : null;
+}
+
+/** The Claude Code PreToolUse decision envelope. */
+function hookDecision(decision: "allow" | "deny", reason: string) {
+  return {
+    hookSpecificOutput: {
+      hookEventName: "PreToolUse" as const,
+      permissionDecision: decision,
+      permissionDecisionReason: reason.slice(0, 500),
+    },
+  };
+}
+
+export async function POST(req: NextRequest) {
+  const session = getToolGateSession(bearerToken(req));
+  if (!session) {
+    // Unknown/expired token: the hook turns this into a denial (fail closed).
+    return NextResponse.json({ error: "Unknown or expired approval session." }, { status: 404 });
+  }
+
+  let text: string;
+  try {
+    text = await req.text();
+  } catch {
+    return NextResponse.json(hookDecision("deny", "could not read the hook payload"), { status: 200 });
+  }
+  if (text.length > MAX_BODY_SIZE) {
+    return NextResponse.json(hookDecision("deny", "hook payload too large"), { status: 200 });
+  }
+
+  let body: unknown;
+  try {
+    body = JSON.parse(text);
+  } catch {
+    return NextResponse.json(hookDecision("deny", "hook payload was not valid JSON"), { status: 200 });
+  }
+  if (!isRecord(body)) {
+    return NextResponse.json(hookDecision("deny", "hook payload must be a JSON object"), { status: 200 });
+  }
+  if (typeof body.tool_name !== "string" || body.tool_name === "") {
+    return NextResponse.json(hookDecision("deny", "hook payload did not name a tool"), { status: 200 });
+  }
+
+  const verdict = await session.decide({
+    hook_event_name: body.hook_event_name,
+    session_id: body.session_id,
+    tool_name: body.tool_name,
+    tool_input: body.tool_input,
+    tool_use_id: body.tool_use_id,
+  });
+
+  recordAudit({
+    user: session.userId || session.runId,
+    action: verdict.decision === "allow" ? "tool.allow" : "tool.deny",
+    target: body.tool_name,
+    result: "success",
+  });
+
+  return NextResponse.json(hookDecision(verdict.decision, verdict.reason), { status: 200 });
+}
