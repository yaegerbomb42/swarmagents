+/** Commands whose effect leaves the VM and cannot be undone from inside it. */
+const IRREVERSIBLE_EXTERNAL_PATTERNS: readonly RegExp[] = [
+  // Force / mirror / delete pushes rewrite or destroy a remote branch.
+  /\bgit\b[^\n|&;]*\bpush\b[^\n|&;]*\s(--force(-with-lease)?|-f|--mirror|--delete)\b/,
+  // Publishing artifacts, releases, images or deployments to a remote service.
+  /\bnpm\b[^\n|&;]*\bpublish\b/,
+  /\b(pnpm|yarn)\b[^\n|&;]*\bpublish\b/,
+  /\b(twine|cargo)\b[^\n|&;]*\b(upload|publish)\b/,
+  /\bdocker\b[^\n|&;]*\bpush\b/,
+  /\bgh\b[^\n|&;]*\b(release|repo|workflow|secret)\b/,
+  /\b(vercel|netlify|fly|flyctl|heroku|railway|surge)\b[^\n|&;]*\b(deploy|release|publish|destroy)\b/,
+  /\b(kubectl|helm|terraform|pulumi)\b[^\n|&;]*\b(apply|delete|destroy|upgrade|install)\b/,
+  /\baws\b[^\n|&;]*\b(s3|ec2|iam|cloudformation|lambda)\b/,
+];
+
+/**
+ * True when a tool call mutates state outside the VM irreversibly (force push,
+ * publish, deploy, cloud API mutation). Full-auto runs (g9) may auto-allow the
+ * asks that stay inside the VM, but these still need a human: the agent cannot
+ * roll them back and the blast radius is not the user's own sandbox.
+ */
+export function isIrreversibleExternal(name: string, input: unknown): boolean {
+  if (name !== "Bash" && name !== "Terminal" && name !== "Shell" && name !== "cmd") return false;
+  const command =
+    input && typeof input === "object" && typeof (input as { command?: unknown }).command === "string"
+      ? (input as { command: string }).command
+      : "";
+  if (!command) return false;
+  const bare = command.replace(/\s+/g, " ");
+  return IRREVERSIBLE_EXTERNAL_PATTERNS.some((pattern) => pattern.test(bare));
+}
