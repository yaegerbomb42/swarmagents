+
+test("two hooks for the same call (image + --settings) open only one card", async () => {
+  const { server, url } = await startBridge();
+  const { dir, scenario, plan } = workspace();
+  try {
+    const { gateway, requests, resolvers } = makeGateway();
+    const planFile = plan([{ name: "Bash", input: { command: `rm -rf ${scenario.target}` } }]);
+
+    const runPromise = runScenario({ bridgeUrl: url, planFile, cwd: dir, gateway, doubleHook: true });
+    await until(() => requests.length >= 1);
+    await sleep(100);
+    assert.equal(requests.length, 1, "a duplicate hook call must reuse the first decision");
+    resolvers[0]("approved");
+    const { events } = await runPromise;
+    assert.equal(existsSync(scenario.marker), false);
+    assert.equal(events.filter((e) => e.type === "approval.required").length, 1);
+  } finally {
+    server.close();
+    rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+test("the gate token never appears in telemetry", async () => {
+  const { server, url } = await startBridge();
+  const { dir, plan } = workspace();
+  try {
+    // Auto-approve everything, so the command really runs and its output —
+    // which contains the hook token — flows back through the runner.
+    const gateway: ApprovalGateway = async () => ({ id: "appr_auto", verdict: Promise.resolve("approved") });
+    const planFile = plan([{ name: "Bash", input: { command: "env | grep SWARM_HOOK" } }]);
