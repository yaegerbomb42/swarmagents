diff --git a/apps/swarmagents/lib/harness/approval-gate.e2e.test.ts b/apps/swarmagents/lib/harness/approval-gate.e2e.test.ts
new file mode 100644
index 000000000..6e050bccf
--- /dev/null
+++ b/apps/swarmagents/lib/harness/approval-gate.e2e.test.ts
@@ -0,0 +1,343 @@
+/**
+ * End-to-end test for the synchronous approval gate (bug b5).
+ *
+ * Before the fix the gate was advisory: `claude` ran the tool itself and the
+ * harness only classified the call from stdout afterwards, so `rm -rf` of a
+ * directory (or a `sudo` command) completed before the approval card rendered
+ * and a denial merely relabelled the finished run.
+ *
+ * This test wires the real pieces together:
+ *   - the real PreToolUse hook client (vm-image/pretooluse-hook.mjs),
+ *   - the real hook endpoint (app/api/runtime/hooks/pretooluse/route.ts),
+ *   - the real gate + runner (lib/harness/tool-gate.ts, runner.ts),
+ *   - and a faithful fake CLI (fixtures/fake-claude-gated.mjs) that executes a
+ *     tool only after the hook allowed it, exactly like the real CLI.
+ *
+ * The assertion is on the filesystem: the directory a risky command targets is
+ * still there while the card is pending, after a denial, and after a timeout —
+ * and gone only once the user approved.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createServer, type Server } from "node:http";
+import { spawn } from "node:child_process";
+import { existsSync, mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { NextRequest } from "next/server";
+import { POST as hookRoute } from "../../app/api/runtime/hooks/pretooluse/route";
+import { ClaudeCodeRunner } from "./runner";
+import { closeAllToolGates, TOOL_HOOK_COMMAND } from "./tool-gate";
+import type { ApprovalGateway, TelemetryEvent, VmExec, VmExecOpts } from "./types";
+
+const APP_ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../..");
+const HOOK_SCRIPT = path.join(APP_ROOT, "vm-image/pretooluse-hook.mjs");
+const FAKE_CLI = path.join(APP_ROOT, "lib/harness/fixtures/fake-claude-gated.mjs");
+
+const sleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));
+
+async function until(cond: () => boolean, timeoutMs = 5000): Promise<void> {
+  const start = Date.now();
+  while (!cond()) {
+    if (Date.now() - start > timeoutMs) throw new Error("timed out waiting for condition");
+    await sleep(10);
+  }
+}
+
+/** The hook endpoint, served over real HTTP so the real hook client can call it. */
+async function startBridge(): Promise<{ server: Server; url: string }> {
+  const server = createServer((req, res) => {
+    const chunks: Buffer[] = [];
+    req.on("data", (chunk: Buffer) => chunks.push(chunk));
+    req.on("end", () => {
+      const body = Buffer.concat(chunks).toString("utf8");
+      const headers = new Headers();
+      for (const [key, value] of Object.entries(req.headers)) {
+        if (typeof value === "string") headers.set(key, value);
+      }
+      const nextReq = new NextRequest("http://app.test/api/runtime/hooks/pretooluse", {
+        method: "POST",
+        headers,
+        body,
+      });
+      hookRoute(nextReq)
+        .then(async (out) => {
+          const text = await out.text();
+          res.writeHead(out.status, { "content-type": "application/json" });
+          res.end(text);
+        })
+        .catch((error: unknown) => {
+          res.writeHead(500, { "content-type": "application/json" });
+          res.end(JSON.stringify({ error: String(error) }));
+        });
+    });
+  });
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const address = server.address();
+  assert.ok(address && typeof address === "object");
+  return { server, url: `http://127.0.0.1:${address.port}/api/runtime/hooks/pretooluse` };
+}
+
+/** VmExec that spawns the fake CLI in a real temp workspace. */
+class SpawnVm implements VmExec {
+  readonly calls: string[][] = [];
+  constructor(private readonly cwd: string) {}
+  exec(cmd: string[], opts?: VmExecOpts): Promise<{ exitCode: number }> {
+    this.calls.push(cmd);
+    const argv = cmd[0] === "claude" ? [process.execPath, FAKE_CLI, ...cmd.slice(1)] : cmd;
+    return new Promise((resolve, reject) => {
+      const child = spawn(argv[0], argv.slice(1), {
+        cwd: opts?.cwd ?? this.cwd,
+        env: { ...process.env, ...(opts?.env ?? {}) },
+        stdio: ["ignore", "pipe", "pipe"],
+      });
+      child.stdout.on("data", (chunk) => opts?.onStdout?.(String(chunk)));
+      child.stderr.on("data", (chunk) => opts?.onStderr?.(String(chunk)));
+      opts?.signal?.addEventListener("abort", () => child.kill("SIGKILL"));
+      child.on("error", reject);
+      child.on("close", (code) => resolve({ exitCode: code ?? 0 }));
+    });
+  }
+}
+
+function deferredVerdict() {
+  let resolve!: (v: "approved" | "denied" | "expired") => void;
+  const promise = new Promise<"approved" | "denied" | "expired">((r) => {
+    resolve = r;
+  });
+  return { promise, resolve };
+}
+
+function makeGateway() {
+  const requests: Array<{ toolName: string; action: string; reason: string }> = [];
+  const resolvers: Array<(v: "approved" | "denied" | "expired") => void> = [];
+  const gateway: ApprovalGateway = async (req) => {
+    requests.push({ toolName: req.toolName, action: req.action, reason: req.reason });
+    const { promise, resolve } = deferredVerdict();
+    resolvers.push(resolve);
+    return { id: `appr_e2e_${requests.length}`, verdict: promise };
+  };
+  return { gateway, requests, resolvers };
+}
+
+interface Scenario {
+  /** Absolute path the risky command deletes. */
+  target: string;
+  /** Absolute path of the file inside it (the "marker"). */
+  marker: string;
+}
+
+function workspace(): { dir: string; scenario: Scenario; plan: (steps: Array<{ name: string; input: unknown }>) => string } {
+  const dir = mkdtempSync(path.join(tmpdir(), "gate-e2e-"));
+  const target = path.join(dir, "doomed");
+  mkdirSync(target, { recursive: true });
+  const marker = path.join(target, "keep.txt");
+  writeFileSync(marker, "still here\n");
+  const plan = (steps: Array<{ name: string; input: unknown }>) => {
+    const file = path.join(dir, `plan-${Math.random().toString(16).slice(2)}.json`);
+    writeFileSync(file, JSON.stringify({ text: "Working on it.", steps }));
+    return file;
+  };
+  return { dir, scenario: { target, marker }, plan };
+}
+
+async function runScenario(opts: {
+  bridgeUrl: string;
+  planFile: string;
+  cwd: string;
+  gateway: ApprovalGateway;
+  env?: Record<string, string>;
+  doubleHook?: boolean;
+}): Promise<{ events: TelemetryEvent[]; outcome: { exitCode: number } }> {
+  const events: TelemetryEvent[] = [];
+  const runner = new ClaudeCodeRunner({ bin: "claude" });
+  const vm = new SpawnVm(opts.cwd);
+  const outcome = await runner.run(
+    {
+      prompt: "do the thing",
+      env: {
+        FAKE_CLAUDE_PLAN: opts.planFile,
+        FAKE_CLAUDE_HOOK_COMMAND: TOOL_HOOK_COMMAND,
+        SWARM_HOOK_SCRIPT: HOOK_SCRIPT,
+        ...(opts.doubleHook ? { FAKE_CLAUDE_DOUBLE_HOOK: "1" } : {}),
+        ...(opts.env ?? {}),
+      },
+      vm,
+      cwd: opts.cwd,
+      toolGate: { runId: "run_e2e", userId: "alice", hookUrl: opts.bridgeUrl, approvalGateway: opts.gateway },
+    },
+    (event) => events.push(event),
+  );
+  return { events, outcome };
+}
+
+test.afterEach(() => closeAllToolGates());
+
+test("an ask command does not run until approved, then it runs", async () => {
+  const { server, url } = await startBridge();
+  const { dir, scenario, plan } = workspace();
+  try {
+    const { gateway, requests, resolvers } = makeGateway();
+    const planFile = plan([{ name: "Bash", input: { command: `rm -rf ${scenario.target}` } }]);
+
+    const runPromise = runScenario({ bridgeUrl: url, planFile, cwd: dir, gateway });
+
+    await until(() => requests.length === 1);
+    // The card is pending: the tool has NOT executed.
+    assert.equal(existsSync(scenario.marker), true, "the risky command ran before the approval card was answered");
+    assert.equal(requests[0].toolName, "Bash");
+    assert.match(requests[0].action, /rm -rf/);
+
+    resolvers[0]("approved");
+    const { events, outcome } = await runPromise;
+
+    assert.equal(outcome.exitCode, 0);
+    assert.equal(existsSync(scenario.marker), false, "the approved command should have run");
+
+    const types = events.map((e) => e.type);
+    const required = types.indexOf("approval.required");
+    const started = types.indexOf("tool.started");
+    assert.ok(required >= 0, "approval.required must be emitted");
+    assert.ok(started > required, "tool.started must come after approval.required");
+    assert.equal(types.filter((t) => t === "run.error").length, 0, "an approved call must not fail the run");
+  } finally {
+    server.close();
