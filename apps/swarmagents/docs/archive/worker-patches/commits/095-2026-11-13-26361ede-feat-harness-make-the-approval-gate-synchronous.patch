--- /dev/null
+++ b/apps/swarmagents/lib/harness/hook-script.test.ts
@@ -0,0 +1,224 @@
+/**
+ * Tests for the in-VM hook client (vm-image/pretooluse-hook.mjs).
+ *
+ * These run the real script as a child process, exactly like Claude Code does,
+ * against a real HTTP endpoint. The contract that matters: the script prints a
+ * Claude Code PreToolUse decision and exits 0, and *every* failure path denies.
+ * A hook that failed open (or exited non-zero, which the CLI treats as "carry
+ * on") would silently restore the advisory-gate bug.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import { spawn } from "node:child_process";
+import { createServer, type Server } from "node:http";
+import { readFileSync } from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { PRETOOLUSE_HOOK_SCRIPT } from "./hook-script";
+import { TOOL_HOOK_COMMAND } from "./tool-gate";
+
+const APP_ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../..");
+const HOOK_PATH = path.join(APP_ROOT, "vm-image/pretooluse-hook.mjs");
+const SETTINGS_PATH = path.join(APP_ROOT, "vm-image/managed-settings.json");
+
+interface RunResult {
+  code: number | null;
+  stdout: string;
+  stderr: string;
+}
+
+/** Run the hook the way the CLI does: payload on stdin, decision on stdout. */
+function runHook(
+  env: Record<string, string | undefined>,
+  payload: unknown,
+  scriptPath = HOOK_PATH,
+): Promise<RunResult> {
+  return new Promise((resolve, reject) => {
+    const childEnv: NodeJS.ProcessEnv = { ...process.env };
+    for (const [name, value] of Object.entries(env)) {
+      if (value === undefined) delete childEnv[name];
+      else childEnv[name] = value;
+    }
+    const child = spawn(process.execPath, [scriptPath], {
+      env: childEnv,
+    });
+    let stdout = "";
+    let stderr = "";
+    child.stdout.on("data", (chunk: Buffer) => (stdout += String(chunk)));
+    child.stderr.on("data", (chunk: Buffer) => (stderr += String(chunk)));
+    child.on("error", reject);
+    child.on("close", (code) => resolve({ code, stdout, stderr }));
+    child.stdin.end(typeof payload === "string" ? payload : JSON.stringify(payload));
+  });
+}
+
+/** Parse the decision envelope the script prints. */
+function decision(stdout: string): { decision: string; reason: string } {
+  const parsed = JSON.parse(stdout) as {
+    hookSpecificOutput: { hookEventName: string; permissionDecision: string; permissionDecisionReason: string };
+  };
+  assert.equal(parsed.hookSpecificOutput.hookEventName, "PreToolUse");
+  return {
+    decision: parsed.hookSpecificOutput.permissionDecision,
+    reason: parsed.hookSpecificOutput.permissionDecisionReason,
+  };
+}
+
+/** A bridge that answers each request according to the mode it was built with. */
+async function startBridge(mode: "allow" | "deny" | "garbage" | "500" | "slow"): Promise<{ server: Server; url: string }> {
+  const server = createServer((req, res) => {
+    if (mode === "500") {
+      res.writeHead(500, { "content-type": "application/json" });
+      res.end(JSON.stringify({ error: "boom" }));
+      return;
+    }
+    if (mode === "garbage") {
+      res.writeHead(200, { "content-type": "text/plain" });
+      res.end("not json");
+      return;
+    }
+    if (mode === "slow") {
+      // Never answer: the client's own timeout must deny.
+      setTimeout(() => {
+        res.writeHead(200, { "content-type": "application/json" });
+        res.end(JSON.stringify({ hookSpecificOutput: { hookEventName: "PreToolUse", permissionDecision: "allow" } }));
+      }, 5_000).unref();
+      return;
+    }
+    res.writeHead(200, { "content-type": "application/json" });
+    res.end(
+      JSON.stringify({
+        hookSpecificOutput: {
+          hookEventName: "PreToolUse",
+          permissionDecision: mode,
+          permissionDecisionReason: mode === "allow" ? "approved by the user" : "the user denied this call",
+        },
+      }),
+    );
+  });
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const address = server.address();
+  assert.ok(address && typeof address === "object");
+  return { server, url: `http://127.0.0.1:${address.port}/api/runtime/hooks/pretooluse` };
+}
+
+const PAYLOAD = { hook_event_name: "PreToolUse", tool_name: "Bash", tool_input: { command: "rm -rf /tmp/x" }, tool_use_id: "toolu_1" };
+
+test("an allow verdict is passed through to the CLI", async () => {
+  const { server, url } = await startBridge("allow");
+  try {
+    const result = await runHook({ SWARM_HOOK_URL: url, SWARM_HOOK_TOKEN: "hk1_test" }, PAYLOAD);
+    assert.equal(result.code, 0);
+    const verdict = decision(result.stdout);
+    assert.equal(verdict.decision, "allow");
+    assert.equal(verdict.reason, "approved by the user");
+  } finally {
+    server.close();
+  }
+});
+
+test("a deny verdict is passed through with its reason", async () => {
+  const { server, url } = await startBridge("deny");
+  try {
+    const result = await runHook({ SWARM_HOOK_URL: url, SWARM_HOOK_TOKEN: "hk1_test" }, PAYLOAD);
+    assert.equal(result.code, 0);
+    const verdict = decision(result.stdout);
+    assert.equal(verdict.decision, "deny");
+    assert.match(verdict.reason, /denied/);
+  } finally {
+    server.close();
+  }
+});
+
+test("an unreachable bridge denies (the gate fails closed)", async () => {
+  // Port 9 (discard) is closed here: connection refused, not a hang.
+  const result = await runHook({ SWARM_HOOK_URL: "http://127.0.0.1:9/hook", SWARM_HOOK_TOKEN: "hk1_test" }, PAYLOAD);
+  assert.equal(result.code, 0);
+  const verdict = decision(result.stdout);
+  assert.equal(verdict.decision, "deny");
+  assert.match(verdict.reason, /unreachable/i);
+});
+
+test("a bridge that never answers times out into a denial", async () => {
+  const { server, url } = await startBridge("slow");
+  try {
+    const result = await runHook({ SWARM_HOOK_URL: url, SWARM_HOOK_TOKEN: "hk1_test", SWARM_HOOK_TIMEOUT_MS: "100" }, PAYLOAD);
+    assert.equal(result.code, 0);
+    const verdict = decision(result.stdout);
+    assert.equal(verdict.decision, "deny");
+    assert.match(verdict.reason, /timed out|unreachable/i);
+  } finally {
+    server.close();
+  }
+});
+
+test("a broken bridge response denies", async () => {
+  for (const mode of ["garbage", "500"] as const) {
+    const { server, url } = await startBridge(mode);
+    try {
+      const result = await runHook({ SWARM_HOOK_URL: url, SWARM_HOOK_TOKEN: "hk1_test" }, PAYLOAD);
+      assert.equal(result.code, 0);
+      assert.equal(decision(result.stdout).decision, "deny", `mode ${mode} must deny`);
+    } finally {
+      server.close();
+    }
+  }
+});
+
+test("a run without hook configuration denies instead of running the tool", async () => {
+  const result = await runHook({}, PAYLOAD);
+  assert.equal(result.code, 0);
+  const verdict = decision(result.stdout);
+  assert.equal(verdict.decision, "deny");
+  assert.match(verdict.reason, /not configured/i);
+});
+
+test("a malformed payload denies", async () => {
+  const { server, url } = await startBridge("allow");
+  try {
+    for (const payload of ["{not json", JSON.stringify({ tool_input: {} })]) {
+      const result = await runHook({ SWARM_HOOK_URL: url, SWARM_HOOK_TOKEN: "hk1_test" }, payload);
+      assert.equal(result.code, 0);
+      assert.equal(decision(result.stdout).decision, "deny");
+    }
+  } finally {
+    server.close();
+  }
+});
+
+test("the seeded copy is byte-identical to the image's hook script", () => {
+  const onDisk = readFileSync(HOOK_PATH, "utf8");
+  assert.equal(
+    PRETOOLUSE_HOOK_SCRIPT,
+    onDisk,
+    "lib/harness/hook-script.ts drifted from vm-image/pretooluse-hook.mjs — regenerate it",
+  );
+});
+
+test("the image's managed settings install the hook and stop blanket-allowing risky tools", () => {
+  const settings = JSON.parse(readFileSync(SETTINGS_PATH, "utf8")) as {
+    permissions: { allow: string[] };
+    hooks: { PreToolUse: Array<{ matcher: string; hooks: Array<{ type: string; command: string; timeout: number }> }> };
+  };
+  const entry = settings.hooks.PreToolUse[0];
+  assert.ok(entry, "managed settings must register a PreToolUse hook");
+  assert.equal(entry.matcher, "*");
