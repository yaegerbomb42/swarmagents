+/**
+ * Hook wiring for the VM's Claude Code settings.
+ *
+ * The synchronous risk gate needs a PreToolUse hook registered in the VM. New
+ * images carry it in `/etc/claude-code/managed-settings.json` (read-only, see
+ * vm-image/). A VM built from an older image does not, so the runtime writes a
+ * per-run settings file and passes it with `--settings` — the CLI merges it on
+ * top of the managed settings, which installs the same hook.
+ *
+ * Both lanes (runtime runs and team lanes) go through here so the decision is
+ * made once, cached per user, and never duplicated: passing the hook twice
+ * would spawn two hook processes per tool call (the gate dedupes that anyway,
+ * but one hook is what we want).
+ */
+
+import type { VmManager } from "../vm/manager";
+import { toolHookSettings } from "../harness/tool-gate";
+
+/** The image's managed Claude Code settings — where the PreToolUse hook lives. */
+export const MANAGED_SETTINGS_PATH = "/etc/claude-code/managed-settings.json";
+/** Per-run settings file used when the VM's image predates the managed hook. */
+export const RUN_SETTINGS_PATH = "/workspace/.swarm/run-settings.json";
+
+/** How long a probe result is trusted before re-reading the VM (ms). */
+const PROBE_TTL_MS = 10 * 60_000;
+
+const probeCache = new Map<string, { at: number; hasHook: boolean }>();
+
+/** True when the VM's managed settings already register a PreToolUse hook. */
+export async function vmHasManagedHook(vm: VmManager, userId: string): Promise<boolean> {
+  const cached = probeCache.get(userId);
+  if (cached && Date.now() - cached.at < PROBE_TTL_MS) return cached.hasHook;
+  let hasHook = false;
+  try {
+    const text = await vm.readFile(userId, MANAGED_SETTINGS_PATH);
+    const parsed: unknown = JSON.parse(text);
+    const hooks = parsed && typeof parsed === "object" ? (parsed as Record<string, unknown>).hooks : undefined;
+    const pre = hooks && typeof hooks === "object" ? (hooks as Record<string, unknown>).PreToolUse : undefined;
+    hasHook = Array.isArray(pre) && pre.length > 0;
+  } catch {
+    // Unreadable settings (old image, or a driver without readFile): fall back
+    // to the per-run settings file, which the runner passes with --settings.
+    hasHook = false;
+  }
+  probeCache.set(userId, { at: Date.now(), hasHook });
+  return hasHook;
+}
+
+/**
+ * Ensure this run's claude process gets the PreToolUse hook. Returns the
+ * `--settings` path to pass, or undefined when the image already has it.
+ */
+export async function ensureHookSettings(vm: VmManager, userId: string): Promise<string | undefined> {
+  if (await vmHasManagedHook(vm, userId)) return undefined;
+  try {
+    await vm.writeFile(userId, RUN_SETTINGS_PATH, `${JSON.stringify(toolHookSettings(), null, 2)}\n`);
+    return RUN_SETTINGS_PATH;
+  } catch {
+    // A write failure must not break the run; the runner's stdout gate still
+    // applies (advisory) until the image is rebuilt.
+    return undefined;
+  }
+}
+
+/** Test hook: drop cached probe results. */
+export function resetHookSettingsCache(): void {
+  probeCache.clear();
+}
