+
+test("a benign call runs immediately with no approval card", async () => {
+  const { server, url } = await startBridge();
+  const { dir, plan } = workspace();
+  try {
+    const { gateway, requests } = makeGateway();
+    const planFile = plan([{ name: "Bash", input: { command: "echo hello-gate" } }]);
+
+    const { events } = await runScenario({ bridgeUrl: url, planFile, cwd: dir, gateway });
+    assert.equal(requests.length, 0);
+    assert.equal(events.some((e) => e.type === "approval.required"), false);
+    const result = events.find((e) => e.type === "tool.result") as Extract<TelemetryEvent, { type: "tool.result" }>;
+    assert.match(result.output, /hello-gate/);
