+/**
+ * Tests for the hook-settings wiring (lib/runtime/hook-settings.ts).
+ *
+ * A VM image that already carries the PreToolUse hook in its managed settings
+ * needs nothing; an older image gets a per-run `--settings` file with the same
+ * hook. Either way the run ends up with exactly one hook, never zero.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import { VmManager } from "../vm/manager";
+import { FakeVmDriver } from "../vm/fake-driver";
+import {
+  MANAGED_SETTINGS_PATH,
+  RUN_SETTINGS_PATH,
+  ensureHookSettings,
+  resetHookSettingsCache,
+  vmHasManagedHook,
+} from "./hook-settings";
+import { TOOL_HOOK_COMMAND } from "../harness/tool-gate";
+import { fullAutoEnabled, resolveHookUrl } from "./manager";
+
+function vm() {
+  const driver = new FakeVmDriver();
+  return { driver, manager: new VmManager({ customDriver: driver }) };
+}
+
+const USER = "alice";
+
+function managedSettings(withHook: boolean): string {
+  return JSON.stringify({
+    permissions: { allow: ["Read"] },
+    ...(withHook
+      ? { hooks: { PreToolUse: [{ matcher: "*", hooks: [{ type: "command", command: TOOL_HOOK_COMMAND }] }] } }
+      : {}),
+  });
+}
+
+test.afterEach(() => resetHookSettingsCache());
+
+test("an image that already ships the hook needs no --settings file", async () => {
+  const { manager } = vm();
+  await manager.writeFile(USER, MANAGED_SETTINGS_PATH, managedSettings(true));
+
+  assert.equal(await vmHasManagedHook(manager, USER), true);
+  assert.equal(await ensureHookSettings(manager, USER), undefined);
+  await assert.rejects(() => manager.readFile(USER, RUN_SETTINGS_PATH));
+});
+
+test("an older image gets a per-run settings file with the hook", async () => {
+  const { manager } = vm();
+  await manager.writeFile(USER, MANAGED_SETTINGS_PATH, managedSettings(false));
+
+  assert.equal(await vmHasManagedHook(manager, USER), false);
+  const path = await ensureHookSettings(manager, USER);
+  assert.equal(path, RUN_SETTINGS_PATH);
+
+  const written = JSON.parse(await manager.readFile(USER, RUN_SETTINGS_PATH)) as {
+    hooks: { PreToolUse: Array<{ matcher: string; hooks: Array<{ command: string; timeout: number }> }> };
+  };
+  assert.equal(written.hooks.PreToolUse[0].matcher, "*");
+  assert.equal(written.hooks.PreToolUse[0].hooks[0].command, TOOL_HOOK_COMMAND);
+  assert.equal(written.hooks.PreToolUse[0].hooks[0].timeout, 330);
+});
+
+test("an unreadable settings file also falls back to --settings", async () => {
+  const { manager } = vm();
+  // No managed settings at all (a VM that never had them installed).
+  assert.equal(await vmHasManagedHook(manager, USER), false);
+  assert.equal(await ensureHookSettings(manager, USER), RUN_SETTINGS_PATH);
+});
+
+test("the managed-hook probe is cached per user", async () => {
+  const { manager } = vm();
+  await manager.writeFile(USER, MANAGED_SETTINGS_PATH, managedSettings(false));
+  assert.equal(await vmHasManagedHook(manager, USER), false);
+  // Installing the hook afterwards is not seen until the cache expires — the
+  // per-run settings file already covers the run either way.
+  await manager.writeFile(USER, MANAGED_SETTINGS_PATH, managedSettings(true));
+  assert.equal(await vmHasManagedHook(manager, USER), false);
+  resetHookSettingsCache();
+  assert.equal(await vmHasManagedHook(manager, USER), true);
+});
+
+test("the hook URL prefers its own setting and otherwise follows the LLM origin", () => {
+  const saved = {
+    hook: process.env.SWARM_VM_HOOK_BASE_URL,
+    llm: process.env.SWARM_VM_LLM_BASE_URL,
+    origin: process.env.SWARM_PUBLIC_ORIGIN,
+    mode: process.env.SWARM_SERVER_MODE,
+  };
+  try {
+    delete process.env.SWARM_VM_HOOK_BASE_URL;
+    delete process.env.SWARM_VM_LLM_BASE_URL;
+    delete process.env.SWARM_PUBLIC_ORIGIN;
+    delete process.env.SWARM_SERVER_MODE;
+    assert.equal(resolveHookUrl(), null, "no reachable origin means no synchronous gate");
+
+    process.env.SWARM_SERVER_MODE = "1";
+    process.env.SWARM_PUBLIC_ORIGIN = "https://swarm.example/";
+    assert.equal(resolveHookUrl(), "https://swarm.example/api/runtime/hooks/pretooluse");
+
+    process.env.SWARM_VM_HOOK_BASE_URL = "http://172.17.0.1:3777";
+    assert.equal(resolveHookUrl(), "http://172.17.0.1:3777/api/runtime/hooks/pretooluse");
+  } finally {
+    for (const [key, value] of [
+      ["SWARM_VM_HOOK_BASE_URL", saved.hook],
+      ["SWARM_VM_LLM_BASE_URL", saved.llm],
+      ["SWARM_PUBLIC_ORIGIN", saved.origin],
+      ["SWARM_SERVER_MODE", saved.mode],
+    ] as const) {
+      if (value === undefined) delete process.env[key];
+      else process.env[key] = value;
+    }
+  }
+});
+
+test("full-auto is opt-in", () => {
+  assert.equal(fullAutoEnabled({}), false);
+  assert.equal(fullAutoEnabled({ SWARM_FULL_AUTO: "0" }), false);
+  assert.equal(fullAutoEnabled({ SWARM_FULL_AUTO: "1" }), true);
+  assert.equal(fullAutoEnabled({ SWARM_FULL_AUTO: "true" }), true);
+});
