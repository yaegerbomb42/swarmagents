+  }
+});
+
+test("a denied command never executes", async () => {
+  const { server, url } = await startBridge();
+  const { dir, scenario, plan } = workspace();
+  try {
+    const { gateway, requests, resolvers } = makeGateway();
+    const planFile = plan([{ name: "Bash", input: { command: `rm -rf ${scenario.target}` } }]);
+
+    const runPromise = runScenario({ bridgeUrl: url, planFile, cwd: dir, gateway });
+    await until(() => requests.length === 1);
+    resolvers[0]("denied");
+    const { events, outcome } = await runPromise;
+
+    assert.equal(outcome.exitCode, 0);
+    assert.equal(existsSync(scenario.marker), true, "a denied command must never execute");
+    assert.equal(events.some((e) => e.type === "tool.started"), false);
+    const resolved = events.find((e) => e.type === "approval.resolved") as Extract<TelemetryEvent, { type: "approval.resolved" }>;
+    assert.equal(resolved.verdict, "denied");
+    // The model was told why: the tool result is an error carrying the reason.
+    const result = events.find((e) => e.type === "tool.result") as Extract<TelemetryEvent, { type: "tool.result" }>;
+    assert.equal(result.ok, false);
+    assert.match(result.output, /denied/i);
+  } finally {
+    server.close();
+    rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+test("a timed-out approval never executes the command", async () => {
+  const { server, url } = await startBridge();
+  const { dir, scenario, plan } = workspace();
+  try {
+    const { gateway, requests, resolvers } = makeGateway();
