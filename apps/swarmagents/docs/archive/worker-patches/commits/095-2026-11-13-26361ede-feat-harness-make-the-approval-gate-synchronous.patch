+
+test("an ask-classified call blocks on the card and allows only after approval", async () => {
+  const { gateway, requests, resolvers } = makeGateway();
+  const { session, events } = makeSession({ approvalGateway: gateway });
+
+  const pending = session.decide({
+    tool_name: "Bash",
