+++ b/apps/swarmagents/lib/harness/tool-gate.ts
@@ -0,0 +1,414 @@
+/**
+ * Synchronous tool gate: the harness side of the VM's PreToolUse hook.
+ *
+ * Before this module existed the risk gate was advisory. `claude -p` was
+ * launched with a blanket `permissions.allow` in the VM's managed settings and
+ * no PreToolUse hook, so the CLI executed every tool itself; the harness
+ * classified the tool_use block from stdout *after* the fact and, on an "ask",
+ * opened an approval card while the command was already running. A denial only
+ * relabelled a finished run.
+ *
+ * Now the VM's managed settings register a PreToolUse hook
+ * (vm-image/managed-settings.json -> vm-image/pretooluse-hook.mjs). The CLI
+ * spawns that hook *before* executing any tool and blocks until it exits; the
+ * hook forwards the tool call to the app and prints whatever verdict comes
+ * back. This module is the app side of that conversation:
+ *
+ *   hook POST /api/runtime/hooks/pretooluse (Bearer <per-run token>)
+ *     -> classifyToolCall(name, input)
+ *        allow  -> { decision: "allow" }            (no human needed)
+ *        ask    -> approval.required, wait for the user, then allow/deny
+ *        deny   -> { decision: "deny", reason }     (never executed)
+ *     <- { hookSpecificOutput: { permissionDecision, permissionDecisionReason } }
+ *
+ * The verdict is therefore synchronous with execution: the tool only runs after
+ * the hook returned "allow". A denied or timed-out approval (300 s default)
+ * returns "deny", so the command never executes and the model sees the reason.
+ *
+ * Sessions are per run and per process. The token is random, scoped to one run,
+ * revoked when the run ends, and only ever able to *ask* — holding it does not
+ * let the holder approve anything, so a leaked token cannot bypass the gate.
+ */
+
+import { createHash, randomBytes, timingSafeEqual } from "node:crypto";
+import type { ApprovalGateway, TelemetryEvent } from "./types";
+import { classifyToolCall, isIrreversibleExternal, type RiskDecision } from "./risk";
+
+/** Path inside the VM of the seeded hook client (see lib/harness/hook-script.ts). */
+export const TOOL_HOOK_PATH = "/workspace/.swarm/pretooluse-hook.mjs";
+
+/** Path of the hook client baked into the VM image (root-owned, read-only). */
+export const TOOL_HOOK_IMAGE_PATH = "/opt/swarm/hooks/pretooluse-hook.mjs";
+
+/**
+ * The PreToolUse hook command, shared by the image's managed settings and the
+ * per-run settings file the runtime writes for VMs built from an older image.
+ * `$SWARM_HOOK_SCRIPT` lets a test point at the repo copy; otherwise the
+ * image's read-only copy wins, with the seeded /workspace copy as a fallback.
+ * A constant shell line: nothing from the run is interpolated into it.
+ */
+export const TOOL_HOOK_COMMAND =
+  "sh -c 'f=${SWARM_HOOK_SCRIPT:-/opt/swarm/hooks/pretooluse-hook.mjs}; " +
+  "[ -f \"$f\" ] || f=/workspace/.swarm/pretooluse-hook.mjs; exec node \"$f\"'";
+
+/** The `hooks` object both settings files carry. */
+export function toolHookSettings(): Record<string, unknown> {
+  return {
+    hooks: {
+      PreToolUse: [
+        {
+          matcher: "*",
+          hooks: [{ type: "command", timeout: 330, command: TOOL_HOOK_COMMAND }],
+        },
+      ],
+    },
+  };
+}
+
+/** Env names the hook client reads (set on the claude exec env, never in argv). */
+export const HOOK_URL_ENV = "SWARM_HOOK_URL";
+export const HOOK_TOKEN_ENV = "SWARM_HOOK_TOKEN";
+export const HOOK_TIMEOUT_ENV = "SWARM_HOOK_TIMEOUT_MS";
+
+/** Default approval TTL: 300 s, matching the approval store's default. */
+export const DEFAULT_GATE_TTL_MS = 300_000;
+
+/** The hook client gives up a little after the app's own TTL so the app wins. */
+export const DEFAULT_HOOK_TIMEOUT_MS = DEFAULT_GATE_TTL_MS + 30_000;
+
+/** Cap on distinct tool calls a single run may gate (guards a runaway loop). */
+const MAX_GATED_CALLS = 500;
+
+export interface ToolGateConfig {
+  /** Run this gate belongs to (approval records and telemetry are scoped to it). */
+  runId: string;
+  /** Account that owns the run (audit attribution only). */
+  userId?: string;
+  /** Absolute URL of the app's hook endpoint, reachable from inside the VM. */
+  hookUrl: string;
+  /** Creates the user-facing approval ticket for an ask-classified call. */
+  approvalGateway?: ApprovalGateway;
+  /**
+   * Full-auto (g9): auto-allow asks that stay inside the VM. Hard denies and
+   * irreversible-external actions (force push, publish, deploy) still ask.
+   */
+  autoApprove?: boolean;
+  /** Approval TTL override in ms. Defaults to DEFAULT_GATE_TTL_MS. */
+  ttlMs?: number;
+  /** Injectable clock for tests. */
+  now?: () => number;
+}
+
+/** The subset of the Claude Code hook payload this gate needs. */
+export interface HookPayload {
+  hook_event_name?: unknown;
+  session_id?: unknown;
+  tool_name?: unknown;
+  tool_input?: unknown;
+  tool_use_id?: unknown;
+}
+
+export interface GateVerdict {
+  decision: "allow" | "deny";
+  /** Shown to the model (and the user) when the call is blocked. */
+  reason: string;
+  /** Approval id when the verdict came from an approval card. */
+  approvalId?: string;
+  /** Risk level the classifier assigned. */
+  level: RiskDecision["level"];
+}
+
+/** Stable key for one tool call: the CLI's id, else a hash of name+input. */
+export function toolCallKey(toolUseId: unknown, name: string, input: unknown): string {
+  if (typeof toolUseId === "string" && toolUseId.trim() !== "") return `id:${toolUseId}`;
+  const hash = createHash("sha256")
+    .update(name)
+    .update("\u0000")
+    .update(stableStringify(input))
+    .digest("hex")
+    .slice(0, 32);
+  return `h:${hash}`;
+}
+
+/** Deterministic JSON for hashing (object keys sorted, bounded depth). */
+function stableStringify(value: unknown, depth = 0): string {
+  if (depth > 6) return '"…"';
+  if (value === null || typeof value !== "object") return JSON.stringify(value) ?? "null";
+  if (Array.isArray(value)) return `[${value.map((v) => stableStringify(v, depth + 1)).join(",")}]`;
+  const obj = value as Record<string, unknown>;
+  const keys = Object.keys(obj).sort();
+  return `{${keys.map((k) => `${JSON.stringify(k)}:${stableStringify(obj[k], depth + 1)}`).join(",")}}`;
+}
+
+/** Human-readable summary of the flagged action (a command, path, or URL). */
+export function describeToolAction(name: string, input: unknown): string {
+  if (input && typeof input === "object") {
+    const obj = input as Record<string, unknown>;
+    if (typeof obj.command === "string") return obj.command;
+    if (typeof obj.file_path === "string") return obj.file_path;
+    if (typeof obj.path === "string") return obj.path;
+    if (typeof obj.url === "string") return obj.url;
+    if (typeof obj.notebook_path === "string") return obj.notebook_path;
+    if (typeof obj.query === "string") return obj.query;
+  }
+  return name;
+}
+
+/** How long a legacy (hook-less) VM may take to prove the hook is wired. */
+const LIVE_WAIT_MS = 500;
+
+export class ToolGateSession {
+  readonly token: string;
+  readonly runId: string;
+  readonly userId: string;
+  readonly config: ToolGateConfig;
+  private readonly emit: (event: TelemetryEvent) => void;
+  private readonly now: () => number;
+  private readonly seen = new Set<string>();
+  /** Verdict cache: a repeated hook call for the same tool call reuses it. */
+  private readonly verdicts = new Map<string, Promise<GateVerdict>>();
+  private readonly liveWaiters = new Set<() => void>();
+  /** Resolves when the run ends, so a waiting hook never outlives its run. */
+  private readonly closedSignal: Promise<void>;
+  private markClosed!: () => void;
+  private requests = 0;
+  private closed = false;
+
+  constructor(token: string, config: ToolGateConfig, emit: (event: TelemetryEvent) => void) {
+    this.token = token;
+    this.runId = config.runId;
+    this.userId = config.userId ?? "";
+    this.config = config;
+    this.emit = emit;
+    this.now = config.now ?? Date.now;
+    this.closedSignal = new Promise<void>((resolve) => {
+      this.markClosed = resolve;
+    });
+  }
+
+  /** Env the claude process (and therefore the hook) needs to reach the app. */
+  env(): Record<string, string> {
+    return {
+      [HOOK_URL_ENV]: this.config.hookUrl,
+      [HOOK_TOKEN_ENV]: this.token,
+      [HOOK_TIMEOUT_ENV]: String(this.config.ttlMs ?? DEFAULT_GATE_TTL_MS),
+    };
+  }
+
+  /** True once the hook has called home at least once for this run. */
+  isLive(): boolean {
+    return this.requests > 0;
+  }
+
+  /**
+   * Wait (bounded) for the hook to prove it is wired. The stdout parser and the
+   * hook run concurrently for the first tool call, so a VM without the hook
+   * needs a moment before the harness falls back to the legacy path.
+   */
+  async waitForLive(timeoutMs = LIVE_WAIT_MS): Promise<boolean> {
+    if (this.isLive() || this.closed) return this.isLive();
+    await new Promise<void>((resolve) => {
+      const done = () => {
+        clearTimeout(timer);
+        this.liveWaiters.delete(done);
+        resolve();
+      };
+      const timer = setTimeout(done, timeoutMs);
+      timer.unref?.();
+      this.liveWaiters.add(done);
+    });
+    return this.isLive();
+  }
+
+  /** Has the hook already decided this exact tool call? */
+  hasSeen(key: string): boolean {
+    return this.seen.has(key);
+  }
+
+  /**
+   * Decide one tool call. Resolves only once the call may (or may not) run, so
+   * the caller — the PreToolUse hook — can block the CLI on the answer.
+   */
+  async decide(payload: HookPayload): Promise<GateVerdict> {
+    const name = typeof payload.tool_name === "string" ? payload.tool_name : "";
+    const input = payload.tool_input;
+    if (!name) return { decision: "deny", reason: "hook payload carried no tool name", level: "deny" };
+    const key = toolCallKey(payload.tool_use_id, name, input);
+
+    const cached = this.verdicts.get(key);
+    if (cached) return cached;
+
+    if (this.closed) {
+      return { decision: "deny", reason: "run is no longer active", level: "deny" };
+    }
+    this.requests += 1;
+    for (const waiter of [...this.liveWaiters]) waiter();
+
+    if (this.requests > MAX_GATED_CALLS) {
+      return { decision: "deny", reason: "too many tool calls in one run", level: "deny" };
+    }
+
+    const toolUseId = typeof payload.tool_use_id === "string" ? payload.tool_use_id : undefined;
+    const pending = this.evaluate(name, input, toolUseId).catch((error: unknown) => {
+      const message = error instanceof Error ? error.message : String(error);
+      return { decision: "deny", reason: `approval failed: ${message}`, level: "ask" } as GateVerdict;
+    });
+    this.verdicts.set(key, pending);
+    this.seen.add(key);
+    this.trimCache();
+    return pending;
+  }
+
+  private trimCache(): void {
+    // Bounded memory: drop the oldest verdicts once the cache grows past the
+    // cap. Only recent calls matter for hook retries and duplicate hooks.
+    if (this.verdicts.size <= MAX_GATED_CALLS) return;
+    const drop = this.verdicts.size - MAX_GATED_CALLS;
+    let dropped = 0;
+    for (const key of this.verdicts.keys()) {
+      this.verdicts.delete(key);
+      if (++dropped >= drop) break;
+    }
+  }
+
+  private async evaluate(name: string, input: unknown, toolUseId?: string): Promise<GateVerdict> {
+    const decision = classifyToolCall(name, input);
+
+    if (decision.level === "deny") {
+      // Policy denial: no card, the model is told why and can adapt.
+      this.emit({ type: "tool.blocked", name, reason: decision.reason });
+      return { decision: "deny", reason: decision.reason, level: "deny" };
+    }
+
+    if (decision.level === "allow") {
+      this.emit({ type: "tool.started", name, id: toolUseId });
+      return { decision: "allow", reason: decision.reason, level: "allow" };
+    }
+
+    // ask
+    const external = isIrreversibleExternal(name, input);
+    if (this.config.autoApprove && !external) {
+      this.emit({ type: "tool.started", name, id: toolUseId });
+      return {
+        decision: "allow",
+        reason: `full-auto: ${decision.reason}`,
+        level: "ask",
+      };
+    }
+
+    const gateway = this.config.approvalGateway;
+    if (!gateway) {
+      // Fail closed: without a way to ask a human, a risky call does not run.
+      return { decision: "deny", reason: "no approval channel is configured for this run", level: "ask" };
+    }
+
+    const action = describeToolAction(name, input);
+    const reason = external
+      ? `${decision.reason} (irreversible outside the VM)`
+      : decision.reason;
+
+    let ticket;
+    try {
+      ticket = await gateway({ runId: this.runId, toolName: name, action, reason });
+    } catch (error) {
+      const message = error instanceof Error ? error.message : String(error);
+      return { decision: "deny", reason: `approval could not be requested: ${message}`, level: "ask" };
+    }
+
+    this.emit({
+      type: "approval.required",
+      approval: {
+        id: ticket.id,
+        tool: name,
+        action,
+        reason,
+        riskLevel: "ask",
+        expiresAt: ticket.expiresAt,
+      },
+    });
+
+    // A run that ends (cancel, finish, crash) must not leave the CLI blocked on
+    // an approval nobody will answer: close() resolves this as a denial.
+    const verdict = await Promise.race([
+      ticket.verdict,
+      this.closedSignal.then(() => "expired" as const),
+    ]);
+    if (this.closed) {
+      return { decision: "deny", reason: "the run ended before the approval was decided", approvalId: ticket.id, level: "ask" };
+    }
+    if (
+      verdict === "expired" &&
+      (ticket.timedOut === undefined || ticket.timedOut())
+    ) {
+      this.emit({ type: "approval.timeout", id: ticket.id, tool: name, action, reason, expiresAt: ticket.expiresAt });
+    }
+    this.emit({ type: "approval.resolved", id: ticket.id, verdict });
+
+    if (verdict === "approved") {
+      this.emit({ type: "tool.started", name, id: toolUseId });
+      return { decision: "allow", reason: "approved by the user", approvalId: ticket.id, level: "ask" };
+    }
+    return {
+      decision: "deny",
+      reason:
+        verdict === "expired"
+          ? "approval timed out — the call was not executed"
+          : "the user denied this call",
+      approvalId: ticket.id,
+      level: "ask",
+    };
+  }
+
+  /** Close the session: later hook calls are refused, pending waits resolve. */
+  close(): void {
+    this.closed = true;
+    this.markClosed();
+    for (const waiter of [...this.liveWaiters]) waiter();
+    this.liveWaiters.clear();
+    for (const [token, session] of registry) {
+      if (session === this) registry.delete(token);
+    }
+  }
+}
+
+const registry = new Map<string, ToolGateSession>();
+
+/** Open a gate session for one run; returns null when no hook URL is known. */
+export function openToolGate(
+  config: ToolGateConfig,
+  emit: (event: TelemetryEvent) => void,
+): ToolGateSession | null {
+  if (!config.hookUrl) return null;
+  const token = `hk1_${randomBytes(24).toString("base64url")}`;
+  const session = new ToolGateSession(token, config, emit);
+  registry.set(token, session);
+  return session;
+}
+
+/** Look a session up by its bearer token (constant-time comparison). */
+export function getToolGateSession(token: string | null | undefined): ToolGateSession | null {
+  if (!token) return null;
+  const candidate = token.trim();
+  if (!/^hk1_[A-Za-z0-9_-]{16,64}$/.test(candidate)) return null;
+  // Compare against every live token in constant time so a wrong token never
+  // short-circuits on a length or prefix difference.
+  let match: ToolGateSession | null = null;
+  const given = Buffer.from(candidate);
+  for (const [key, session] of registry) {
+    const expected = Buffer.from(key);
+    if (expected.length !== given.length) continue;
+    if (timingSafeEqual(expected, given)) match = session;
+  }
+  return match;
+}
+
+/** Close every session (test hook / shutdown). */
+export function closeAllToolGates(): void {
+  for (const session of [...registry.values()]) session.close();
+  registry.clear();
+}
+
+/** Number of live sessions (test hook). */
+export function toolGateCount(): number {
+  return registry.size;
+}
