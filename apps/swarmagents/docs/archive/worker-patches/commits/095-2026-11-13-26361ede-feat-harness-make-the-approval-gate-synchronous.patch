index 000000000..a45c10641
--- /dev/null
+++ b/apps/swarmagents/lib/harness/fixtures/fake-claude-gated.mjs
@@ -0,0 +1,180 @@
+#!/usr/bin/env node
+/**
+ * A faithful fake for `claude -p --output-format stream-json`, used by the
+ * approval-gate integration test.
+ *
+ * What makes it faithful is the part that matters for this bug: before it
+ * executes any tool it runs the PreToolUse hook exactly like the real CLI does
+ * — the command from the managed/run settings, the payload on stdin, the JSON
+ * decision on stdout — and it executes the tool *only* when the hook answers
+ * "allow". A denial is reported back to the model as a tool_result error and
+ * the run continues, which is the CLI's behaviour too.
+ *
+ * Configuration (env):
+ *   FAKE_CLAUDE_PLAN         path to a JSON plan: {steps:[{name,input}], text?}
+ *   FAKE_CLAUDE_HOOK_COMMAND shell command that runs the hook
+ *   FAKE_CLAUDE_DOUBLE_HOOK  "1" runs the hook twice per call (image hook +
+ *                            --settings hook) to prove the gate dedupes it
+ *
+ * Everything else is stream-json on stdout, one JSON object per line.
+ */
+
+import { spawn } from "node:child_process";
+import { readFileSync, writeFileSync, mkdirSync } from "node:fs";
+import path from "node:path";
+
+const SESSION_ID = "sess_fake_gated";
+const MODEL = "claude-sonnet-5-5";
+const MAX_TOOL_OUTPUT = 4000;
+
+function emit(event) {
+  process.stdout.write(`${JSON.stringify(event)}\n`);
+}
+
+function assistantText(text, id) {
+  emit({
+    type: "assistant",
+    message: { id, role: "assistant", model: MODEL, content: [{ type: "text", text }] },
+  });
+}
+
+function assistantToolUse(id, name, input) {
+  emit({
+    type: "assistant",
+    message: { id: `${id}_msg`, role: "assistant", model: MODEL, content: [{ type: "tool_use", id, name, input }] },
+  });
+}
+
+function toolResult(id, output, isError) {
+  emit({
+    type: "user",
+    message: {
+      role: "user",
+      content: [{ type: "tool_result", tool_use_id: id, content: output, is_error: isError }],
+    },
+  });
+}
+
+/** Run the hook command the way the CLI does; resolves to the parsed decision. */
+function runHook(payload) {
+  return new Promise((resolve) => {
+    const command = process.env.FAKE_CLAUDE_HOOK_COMMAND;
+    if (!command) {
+      resolve({ decision: "deny", reason: "no hook command configured" });
+      return;
+    }
+    const child = spawn("sh", ["-c", command], { env: process.env, stdio: ["pipe", "pipe", "pipe"] });
+    let stdout = "";
+    child.stdout.on("data", (chunk) => (stdout += String(chunk)));
+    child.stderr.on("data", () => {});
+    child.on("close", () => {
+      try {
+        const parsed = JSON.parse(stdout);
+        const out = parsed && parsed.hookSpecificOutput;
+        const decision = out && out.permissionDecision;
+        resolve({
+          decision: decision === "allow" ? "allow" : "deny",
+          reason: (out && out.permissionDecisionReason) || "no reason",
+        });
+      } catch {
+        // A hook that prints nothing usable blocks the tool, like the real CLI
+        // treats a failed hook: fail closed.
+        resolve({ decision: "deny", reason: "hook produced no decision" });
+      }
+    });
+    child.stdin.end(JSON.stringify(payload));
+  });
+}
+
+/** Execute one tool for real, returning { output, isError }. */
+function executeTool(name, input) {
+  return new Promise((resolve) => {
+    if (name === "Bash") {
+      const command = typeof input?.command === "string" ? input.command : "";
+      const child = spawn("bash", ["-lc", command], { cwd: process.cwd(), env: process.env });
+      let output = "";
+      child.stdout.on("data", (chunk) => (output += String(chunk)));
+      child.stderr.on("data", (chunk) => (output += String(chunk)));
+      child.on("close", (code) => {
+        resolve({ output: output.slice(0, MAX_TOOL_OUTPUT), isError: code !== 0 });
+      });
+      return;
+    }
+    if (name === "Write") {
+      try {
+        const target = path.resolve(process.cwd(), String(input?.file_path ?? ""));
+        mkdirSync(path.dirname(target), { recursive: true });
+        writeFileSync(target, String(input?.content ?? ""));
+        resolve({ output: `wrote ${target}`, isError: false });
+      } catch (error) {
+        resolve({ output: String(error?.message ?? error), isError: true });
+      }
+      return;
+    }
+    if (name === "Read") {
+      try {
+        const target = path.resolve(process.cwd(), String(input?.file_path ?? ""));
+        resolve({ output: readFileSync(target, "utf8").slice(0, MAX_TOOL_OUTPUT), isError: false });
+      } catch (error) {
+        resolve({ output: String(error?.message ?? error), isError: true });
+      }
+      return;
+    }
+    resolve({ output: `${name} is not implemented by the fake CLI`, isError: true });
+  });
+}
+
+async function main() {
+  const planPath = process.env.FAKE_CLAUDE_PLAN;
+  const plan = planPath ? JSON.parse(readFileSync(planPath, "utf8")) : { steps: [] };
+
+  emit({ type: "system", subtype: "init", cwd: process.cwd(), session_id: SESSION_ID, model: MODEL });
+  if (plan.text) assistantText(plan.text, "msg_intro");
+
+  let index = 0;
+  for (const step of plan.steps ?? []) {
+    index += 1;
+    const toolId = `toolu_fake_${index}`;
+    assistantToolUse(toolId, step.name, step.input ?? {});
+
+    const payload = {
+      hook_event_name: "PreToolUse",
+      session_id: SESSION_ID,
+      tool_use_id: toolId,
+      tool_name: step.name,
+      tool_input: step.input ?? {},
+    };
+    const verdict = await runHook(payload);
+    if (process.env.FAKE_CLAUDE_DOUBLE_HOOK === "1") {
+      // The image's managed hook and the run's --settings hook both fire; the
+      // second must agree and must not open a second card.
+      const again = await runHook(payload);
+      if (again.decision !== verdict.decision) {
+        toolResult(toolId, `hook disagreement: ${verdict.decision} vs ${again.decision}`, true);
+        continue;
+      }
+    }
+
+    if (verdict.decision !== "allow") {
+      toolResult(toolId, `blocked by the approval gate: ${verdict.reason}`, true);
+      continue;
+    }
+    const result = await executeTool(step.name, step.input ?? {});
+    toolResult(toolId, result.output, result.isError);
+  }
+
+  emit({
+    type: "result",
+    subtype: "success",
+    is_error: false,
+    session_id: SESSION_ID,
+    total_cost_usd: 0.001,
+    duration_ms: 10,
+    num_turns: (plan.steps ?? []).length + 1,
+  });
+}
+
+main().catch((error) => {
+  process.stderr.write(`${error?.stack ?? error}\n`);
+  process.exit(1);
+});
diff --git a/apps/swarmagents/lib/harness/hook-script.test.ts b/apps/swarmagents/lib/harness/hook-script.test.ts
