-# Managed (admin-owned) Claude Code settings: pre-allow the standard tools so
-# a headless `claude -p` can actually act. The app's own risk gate
-# (lib/harness/risk.ts) still classifies every tool call the agent makes and
-# can still ask or deny — this only removes the CLI's own interactive prompt.
+# PreToolUse hook client: Claude Code runs it before every tool call and blocks
+# on its answer, which is what makes the harness risk gate synchronous (a tool
+# cannot execute before the user/harness allows it). Root-owned and read-only
+# so the agent cannot rewrite the gate it is running under.
+COPY pretooluse-hook.mjs /opt/swarm/hooks/pretooluse-hook.mjs
+RUN chmod 0555 /opt/swarm/hooks/pretooluse-hook.mjs \
+    && chown root:root /opt/swarm/hooks/pretooluse-hook.mjs
+
+# Managed (admin-owned) Claude Code settings: register the PreToolUse hook and
+# pre-allow only the read-only tools, so a headless `claude -p` can act without
+# the CLI's own interactive prompt while every mutating call (Bash, Edit, Write,
+# NotebookEdit) goes through the hook. Without the hook these tools would either
+# stop at the CLI prompt or — worse, as they used to — run unguarded because the
+# settings blanket-allowed them.
 COPY managed-settings.json /etc/claude-code/managed-settings.json
 RUN chmod 0444 /etc/claude-code/managed-settings.json \
     && chown root:root /etc/claude-code/managed-settings.json
