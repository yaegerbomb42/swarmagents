diff --git a/apps/swarmagents/vm-image/pretooluse-hook.mjs b/apps/swarmagents/vm-image/pretooluse-hook.mjs
new file mode 100644
index 000000000..65e3d8bb9
--- /dev/null
+++ b/apps/swarmagents/vm-image/pretooluse-hook.mjs
@@ -0,0 +1,137 @@
+#!/usr/bin/env node
+/**
+ * PreToolUse hook client for the SwarmAgents harness risk gate.
+ *
+ * Claude Code spawns this script *before* it executes a tool and blocks until
+ * the script exits. The script forwards the tool call to the app, waits for the
+ * verdict (allow/deny), and prints it as a Claude Code hook decision. The tool
+ * therefore only runs after a human — or the classifier — allowed it.
+ *
+ * Contract (Claude Code hooks):
+ *   - stdin: the hook payload JSON ({hook_event_name, tool_name, tool_input, ...})
+ *   - stdout: {"hookSpecificOutput": {"hookEventName": "PreToolUse",
+ *              "permissionDecision": "allow" | "deny",
+ *              "permissionDecisionReason": "..."}}
+ *   - exit 0 always. A non-zero exit that is not 2 makes the CLI treat the hook
+ *     as failed and *continue*, so every failure path here prints an explicit
+ *     "deny" instead: the gate fails closed.
+ *
+ * Configuration comes from the exec environment the harness sets for the run
+ * (never argv, which anything on the box can read from the process table):
+ *   SWARM_HOOK_URL         absolute URL of /api/runtime/hooks/pretooluse
+ *   SWARM_HOOK_TOKEN       per-run bearer token for that endpoint
+ *   SWARM_HOOK_TIMEOUT_MS  how long to wait for a verdict (default 330000)
+ *
+ * No dependencies: the image ships node, and this file must keep working in an
+ * air-gapped VM.
+ */
+
+const MAX_INPUT_BYTES = 1024 * 1024;
+const MAX_REASON = 500;
+const DEFAULT_TIMEOUT_MS = 330000;
+
+/** Print a Claude Code PreToolUse decision. Never throws. */
+function answer(decision, reason) {
+  const text = String(reason ?? "").slice(0, MAX_REASON) || (decision === "allow" ? "allowed" : "blocked");
+  const payload = {
+    hookSpecificOutput: {
+      hookEventName: "PreToolUse",
+      permissionDecision: decision,
+      permissionDecisionReason: text,
+    },
+  };
+  try {
+    process.stdout.write(JSON.stringify(payload));
+  } catch {
+    // A closed stdout means the CLI is gone; there is nobody to answer.
+  }
+}
+
+/** Read the whole hook payload from stdin, bounded. */
+async function readStdin() {
+  const chunks = [];
+  let total = 0;
+  for await (const chunk of process.stdin) {
+    total += chunk.length;
+    if (total > MAX_INPUT_BYTES) break;
+    chunks.push(chunk);
+  }
+  return Buffer.concat(chunks).toString("utf8");
+}
+
+function timeoutMs() {
+  const raw = Number(process.env.SWARM_HOOK_TIMEOUT_MS);
+  return Number.isFinite(raw) && raw > 0 ? raw : DEFAULT_TIMEOUT_MS;
+}
+
+async function main() {
+  const url = process.env.SWARM_HOOK_URL;
+  const token = process.env.SWARM_HOOK_TOKEN;
+  if (!url || !token) {
+    // Fail closed: a run without a bridge must not execute risky tools. The
+    // harness always sets these; an empty value means the gate is broken.
+    answer("deny", "approval bridge is not configured for this run");
+    return;
+  }
+
+  let payload;
+  try {
+    const raw = await readStdin();
+    payload = JSON.parse(raw);
+  } catch (error) {
+    answer("deny", `could not read the hook payload: ${error && error.message ? error.message : "invalid JSON"}`);
+    return;
+  }
+  if (!payload || typeof payload !== "object" || typeof payload.tool_name !== "string" || payload.tool_name === "") {
+    answer("deny", "hook payload did not name a tool");
+    return;
+  }
+
+  let response;
+  try {
+    response = await fetch(url, {
+      method: "POST",
+      headers: {
+        "content-type": "application/json",
+        authorization: `Bearer ${token}`,
+      },
+      body: JSON.stringify({
+        hook_event_name: payload.hook_event_name ?? "PreToolUse",
+        session_id: payload.session_id,
+        tool_name: payload.tool_name,
+        tool_input: payload.tool_input,
+        tool_use_id: payload.tool_use_id,
+      }),
+      signal: AbortSignal.timeout(timeoutMs()),
+    });
+  } catch (error) {
+    const detail = error && error.name === "TimeoutError" ? "timed out" : String((error && error.message) || error);
+    answer("deny", `approval bridge unreachable (${detail})`);
+    return;
+  }
+
+  if (!response.ok) {
+    answer("deny", `approval bridge returned HTTP ${response.status}`);
+    return;
+  }
+
+  let body;
+  try {
+    body = await response.json();
+  } catch {
+    answer("deny", "approval bridge returned an unreadable verdict");
+    return;
+  }
+
+  const out = body && typeof body === "object" ? body.hookSpecificOutput : null;
+  const decision = out && out.permissionDecision;
+  if (decision !== "allow" && decision !== "deny") {
+    answer("deny", "approval bridge returned no usable verdict");
+    return;
+  }
+  answer(decision, out.permissionDecisionReason);
+}
+
+main().catch((error) => {
+  answer("deny", `approval hook failed: ${error && error.message ? error.message : String(error)}`);
+});
