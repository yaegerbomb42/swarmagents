+
+  /**
+   * Pause the upstream socket while the browser falls behind, and close the
+   * bridge if it stays far enough behind for `slowDrainMs`.
+   */
+  private enforceClientBackpressure(): void {
+    const pending = this.client.writableLength ?? 0;
+    if (!this.upstream.destroyed && typeof this.upstream.pause === "function") {
+      if (pending > this.clientHighWaterBytes) this.upstream.pause();
+      else if (typeof this.upstream.resume === "function") this.upstream.resume();
+    }
+    if (pending > this.clientMaxBufferBytes) {
+      if (!this.slowDrainTimer) {
+        this.slowDrainTimer = setTimeout(() => {
+          this.slowDrainTimer = null;
+          const stillOver = !this.closed && !this.client.destroyed &&
+            (this.client.writableLength ?? 0) > this.clientMaxBufferBytes;
+          if (!stillOver) return;
+          // Tell the browser we are going away before tearing the bridge down.
+          if (!this.client.destroyed) {
+            this.client.write(closeFrame(1001, "slow drain"));
+            this.client.end();
+          }
+          this.fail("client-slow-drain");
+        }, this.slowDrainMs);
+        this.slowDrainTimer.unref?.();
+      }
+    } else {
+      this.clearSlowDrainTimer();
+    }
+  }
+
+  private onClientDrain(): void {
+    if (!this.upstream.destroyed && typeof this.upstream.resume === "function") this.upstream.resume();
+    this.enforceClientBackpressure();
+  }
+
+  private clearSlowDrainTimer(): void {
+    if (this.slowDrainTimer) {
+      clearTimeout(this.slowDrainTimer);
+      this.slowDrainTimer = null;
+    }
+  }
+
   private touch(): void {
     this.onActivity();
   }
