   writes: Buffer[] = [];
   destroyed = false;
   ended = false;
+  writableLength = 0;
+  paused = false;
   write(data: Buffer | string): boolean {
     this.writes.push(Buffer.from(data));
     return true;
@@ -44,6 +47,20 @@ class FakeSocket extends EventEmitter {
     this.destroyed = true;
     return this;
   }
+  pause(): this {
+    this.paused = true;
+    return this;
+  }
+  resume(): this {
+    this.paused = false;
+    return this;
+  }
+  isPaused(): boolean {
+    return this.paused;
+  }
+  drain(): void {
+    this.emit("drain");
+  }
   feed(chunk: Buffer): void {
     this.emit("data", chunk);
   }
@@ -392,3 +409,52 @@ test("bridge: bytes arriving with the upgrade (head) go through the decoders", (
   const toBrowser = h.toClient.binary();
   assert.equal(toBrowser.subarray(0, 12).toString(), RFB_VERSION, "client head answered");
 });
+
+test("bridge: an unmasked browser frame is a protocol error closed with 1002", () => {
+  const h = makeBridge("control");
+  handshake(h);
+  h.client.feed(frame(OP_BINARY, Buffer.from("hello"), { masked: false }));
+  assert.deepEqual(h.closes, ["client-unmasked-frame"]);
+  assert.ok(h.client.destroyed && h.upstream.destroyed, "both sockets torn down");
+  const close = h.toClient.read().find((m) => m.opcode === OP_CLOSE);
+  assert.ok(close, "close frame sent to the browser");
+  assert.equal(close!.payload.readUInt16BE(0), 1002);
+});
+
+test("bridge: a masked container frame is a protocol error closed with 1002", () => {
+  const h = makeBridge("view");
+  handshake(h);
+  h.upstream.feed(frame(OP_BINARY, Buffer.from("hello"), { masked: true }));
+  assert.deepEqual(h.closes, ["upstream-masked-frame"]);
+  assert.ok(h.client.destroyed && h.upstream.destroyed, "both sockets torn down");
+  const close = h.toUpstream.read().find((m) => m.opcode === OP_CLOSE);
+  assert.ok(close, "close frame sent to the container");
+  assert.equal(close!.payload.readUInt16BE(0), 1002);
+});
+
+test("bridge: a slow browser pauses the upstream socket until it drains", () => {
+  const h = makeBridge("control", { clientHighWaterBytes: 1024 });
+  handshake(h);
+  h.client.writableLength = 2048;
+  h.upstream.feed(encodeFrame(OP_BINARY, Buffer.from("x")));
+  assert.equal(h.upstream.isPaused(), true, "upstream paused above the high-water mark");
+  h.client.writableLength = 0;
+  h.client.drain();
+  assert.equal(h.upstream.isPaused(), false, "upstream resumed once the browser drained");
+  assert.deepEqual(h.closes, []);
+});
+
+test("bridge: a browser stuck above the hard cap is closed after the grace period", async () => {
+  const h = makeBridge("control", {
+    clientHighWaterBytes: 1024,
+    clientMaxBufferBytes: 2048,
+    slowDrainMs: 20,
+  });
+  handshake(h);
+  h.client.writableLength = 4096;
+  h.upstream.feed(encodeFrame(OP_BINARY, Buffer.from("x")));
+  assert.deepEqual(h.closes, [], "not closed immediately");
+  await new Promise((r) => setTimeout(r, 80));
+  assert.deepEqual(h.closes, ["client-slow-drain"]);
+  assert.ok(h.client.destroyed && h.upstream.destroyed, "both sockets torn down");
+});
