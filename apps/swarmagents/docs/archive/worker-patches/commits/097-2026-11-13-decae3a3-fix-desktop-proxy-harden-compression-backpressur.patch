 apps/swarmagents/lib/desktop-proxy/bridge.ts  | 125 ++++++++++++++++--
 .../lib/desktop-proxy/proxy.test.ts           |  32 ++++-
 apps/swarmagents/lib/desktop-proxy/proxy.ts   |   9 +-
 apps/swarmagents/lib/desktop-proxy/ws.ts      |  45 +++++--
 5 files changed, 250 insertions(+), 27 deletions(-)

