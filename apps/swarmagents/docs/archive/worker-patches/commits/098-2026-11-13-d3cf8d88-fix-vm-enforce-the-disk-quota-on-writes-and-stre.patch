+// ---------------------------------------------------------------------------
+// VM-06 — streaming body cap (chunked uploads have no Content-Length)
+// ---------------------------------------------------------------------------
+
+/** A request whose body is a stream (no Content-Length) that counts pulls. */
+function chunkedRequest(
+  bodyStream: ReadableStream<Uint8Array>,
+  contentType: string,
+): { req: NextRequest; pulls: () => number } {
+  let pulls = 0;
+  const reader = bodyStream.getReader();
+  const counting = new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      pulls += 1;
+      const { done, value } = await reader.read();
+      if (done) controller.close();
+      else controller.enqueue(value);
+    },
+  });
+  const headers = new Headers({ "content-type": contentType, host: "localhost" });
+  // A stream body needs Node's `duplex: "half"`, which Next's RequestInit type
+  // does not declare; the cast keeps the call site honest about that.
+  const init = {
+    method: "POST",
+    headers,
+    body: counting,
+    duplex: "half",
+  } as unknown as ConstructorParameters<typeof NextRequest>[1];
+  const req = new NextRequest("http://localhost/api/runtime/vm/files/upload", init);
+  return { req, pulls: () => pulls };
+}
+
+test("a chunked upload over the cap is aborted with 413 without buffering it all", async () => {
+  process.env.SWARM_UPLOAD_MAX_BODY_BYTES = "1024"; // lowered cap for the test
+  install();
+
+  // 64 KiB of multipart-ish bytes in 1 KiB chunks, far past the 1 KiB cap.
+  let sent = 0;
+  const total = 64 * 1024;
+  const source = new ReadableStream<Uint8Array>({
+    pull(controller) {
+      if (sent >= total) {
+        controller.close();
+        return;
+      }
+      sent += 1024;
+      controller.enqueue(new Uint8Array(1024).fill(65));
+    },
+  });
+  const { req } = chunkedRequest(source, "multipart/form-data; boundary=----swarm");
+  assert.equal(req.headers.get("content-length"), null, "the body must be chunked");
+
+  const res = await POST(req);
+  assert.equal(res.status, 413);
+  const body = await json(res);
+  assert.equal(body.code, "body_too_large");
+  assert.equal(body.limit, 1024);
+  assert.ok(sent < total, `expected the body to be cut short, streamed ${sent} of ${total} bytes`);
+});
+
+test("a chunked multipart upload under the cap still parses and stores the file", async () => {
+  install();
+  const form = new FormData();
+  form.append("files", new File([new TextEncoder().encode("chunked body")], "chunked.txt"), "chunked.txt");
+  const encoded = new Request("http://localhost/api/runtime/vm/files/upload", {
+    method: "POST",
+    body: form,
+  });
+  const contentType = encoded.headers.get("content-type") ?? "";
+  assert.match(contentType, /^multipart\/form-data; boundary=/);
+  assert.ok(encoded.body, "expected an encoded body stream");
+
+  const { req } = chunkedRequest(encoded.body!, contentType);
+  const res = await POST(req);
+  assert.equal(res.status, 200);
+  const body = await json(res);
+  assert.deepEqual(body.uploaded.map((u: any) => u.name), ["chunked.txt"]);
+});
