new file mode 100644
index 000000000..8a85c0a8d
--- /dev/null
+++ b/apps/swarmagents/lib/body-limit.test.ts
@@ -0,0 +1,99 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { BodyTooLargeError, capBodyStream, readCappedBody } from "./body-limit";
+
+/** A body stream of `chunks` byte arrays that counts how many were pulled. */
+function bodyOf(chunks: Uint8Array[]) {
+  const state = { pulled: 0, cancelled: false };
+  const stream = new ReadableStream<Uint8Array>({
+    pull(controller) {
+      if (state.pulled >= chunks.length) {
+        controller.close();
+        return;
+      }
+      controller.enqueue(chunks[state.pulled++]);
+    },
+    cancel() {
+      state.cancelled = true;
+    },
+  });
+  return { stream, state };
+}
+
+function bytes(n: number, value = 120): Uint8Array {
+  return new Uint8Array(n).fill(value);
+}
+
+async function drain(stream: ReadableStream<Uint8Array>): Promise<number> {
+  const reader = stream.getReader();
+  let total = 0;
+  for (;;) {
+    const { done, value } = await reader.read();
+    if (done) return total;
+    total += value.byteLength;
+  }
+}
+
+test("capBodyStream passes a body under the cap through unchanged", async () => {
+  const { stream } = bodyOf([bytes(100), bytes(100)]);
+  const capped = capBodyStream(stream, 300);
+  assert.equal(await drain(capped.stream), 200);
+  assert.equal(capped.exceeded(), false);
+  assert.equal(capped.bytesRead(), 200);
+});
+
+test("capBodyStream accepts a body exactly at the cap", async () => {
+  const { stream } = bodyOf([bytes(100), bytes(100)]);
+  const capped = capBodyStream(stream, 200);
+  assert.equal(await drain(capped.stream), 200);
+  assert.equal(capped.exceeded(), false);
+});
+
+test("capBodyStream aborts as soon as the cap is crossed and cancels the source", async () => {
+  // 10 x 100 bytes behind a 250 byte cap: the third chunk trips it, so at most
+  // 300 bytes are ever pulled — the remaining 700 are never read.
+  const { stream, state } = bodyOf(Array.from({ length: 10 }, () => bytes(100)));
+  const capped = capBodyStream(stream, 250);
+
+  await assert.rejects(drain(capped.stream), (err: unknown) => {
+    assert.ok(err instanceof BodyTooLargeError);
+    assert.equal(err.limit, 250);
+    return true;
+  });
+  assert.equal(capped.exceeded(), true);
+  assert.equal(capped.bytesRead(), 300);
+  // At most one chunk of stream read-ahead beyond the one that crossed the cap.
+  assert.ok(state.pulled <= 4, `expected at most 4 chunks pulled, got ${state.pulled}`);
+  assert.ok(state.pulled < 10, "the rest of the body must never be pulled");
+  assert.equal(state.cancelled, true, "the upstream must be cancelled");
+});
+
+test("capBodyStream treats a missing body as empty", async () => {
+  const capped = capBodyStream(null, 10);
+  assert.equal(await drain(capped.stream), 0);
+  assert.equal(capped.exceeded(), false);
+});
+
+test("capBodyStream with a non-positive limit does not cap", async () => {
+  const { stream } = bodyOf([bytes(1000)]);
+  const capped = capBodyStream(stream, 0);
+  assert.equal(await drain(capped.stream), 1000);
+  assert.equal(capped.exceeded(), false);
+});
+
+test("readCappedBody returns the bytes under the cap", async () => {
+  const { stream } = bodyOf([bytes(4, 1), bytes(4, 2)]);
+  const buf = await readCappedBody(stream, 100);
+  assert.deepEqual([...buf], [1, 1, 1, 1, 2, 2, 2, 2]);
+});
+
+test("readCappedBody throws BodyTooLargeError without buffering the whole body", async () => {
+  const { stream, state } = bodyOf(Array.from({ length: 20 }, () => bytes(64)));
+  await assert.rejects(readCappedBody(stream, 100), BodyTooLargeError);
+  assert.ok(state.pulled <= 2, `expected at most 2 chunks pulled, got ${state.pulled}`);
+  assert.equal(state.cancelled, true);
+});
+
+test("readCappedBody handles an empty body", async () => {
+  assert.equal((await readCappedBody(null, 10)).length, 0);
+});
diff --git a/apps/swarmagents/lib/body-limit.ts b/apps/swarmagents/lib/body-limit.ts
new file mode 100644
index 000000000..9a7434b65
--- /dev/null
+++ b/apps/swarmagents/lib/body-limit.ts
@@ -0,0 +1,118 @@
+// Streaming request-body cap.
+//
+// A route that bypasses middleware (uploads) and reads a body with
+// `formData()` buffers everything the client sends. Content-Length is not a
+// defence: a chunked request has none, and a lying one is not enforced by the
+// runtime. This helper wraps the request body in a stream that counts bytes as
+// they arrive, errors with {@link BodyTooLargeError} the moment the cap is
+// crossed, and cancels the upstream so the rest of the body is never read —
+// a client cannot make the server buffer an unbounded payload just to reject
+// it afterwards.
+
+/** Raised when a request body grows past the configured byte cap. */
+export class BodyTooLargeError extends Error {
+  readonly limit: number;
+
+  constructor(limit: number) {
+    super(`Request body exceeds the ${limit} byte limit.`);
+    this.name = "BodyTooLargeError";
+    this.limit = limit;
+  }
+}
+
+/** A capped body stream plus the counters a route needs to answer 413. */
+export interface CappedBody {
+  /** Body to hand to a parser; rejects with BodyTooLargeError past the cap. */
+  stream: ReadableStream<Uint8Array>;
+  /** True once more than `limit` bytes were pulled from the source. */
+  exceeded: () => boolean;
+  /** Bytes pulled from the source so far (including the chunk that tripped the cap). */
+  bytesRead: () => number;
+}
+
+/**
+ * Wrap a request body in a streaming byte cap.
+ *
+ * The stream pulls one chunk at a time: as soon as the running total passes
+ * `limit` it errors and cancels the source, so the caller's parser sees the
+ * failure before the rest of the body is read. A null body (no payload) reads
+ * as an empty stream. A non-positive limit means "no cap".
+ */
+export function capBodyStream(
+  body: ReadableStream<Uint8Array> | null,
+  limit: number,
+): CappedBody {
+  const reader = body?.getReader();
+  let bytes = 0;
+  let exceeded = false;
+
+  // highWaterMark 0: no read-ahead, so the source is pulled only when the
+  // parser asks for bytes — the cap therefore stops the upload exactly at the
+  // chunk that crosses it instead of buffering a queued chunk first.
+  const stream = new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      if (!reader) {
+        controller.close();
+        return;
+      }
+      let chunk: ReadableStreamReadResult<Uint8Array>;
+      try {
+        chunk = await reader.read();
+      } catch (err) {
+        controller.error(err);
+        return;
+      }
+      if (chunk.done) {
+        controller.close();
+        return;
+      }
+      const value = chunk.value;
+      bytes += value.byteLength;
+      if (limit > 0 && bytes > limit) {
+        exceeded = true;
+        controller.error(new BodyTooLargeError(limit));
+        // Stop the upload: the remaining bytes are never pulled from the socket.
+        await reader.cancel().catch(() => {});
+        return;
+      }
+      controller.enqueue(value);
+    },
+    async cancel(reason) {
+      await reader?.cancel(reason).catch(() => {});
+    },
+  }, { highWaterMark: 0 });
+
+  return { stream, exceeded: () => exceeded, bytesRead: () => bytes };
+}
+
+/**
+ * Read a request body into one buffer, aborting as soon as `limit` is passed.
+ * Used by routes that need the whole payload before parsing (multipart); the
+ * buffer never grows past `limit` and the upstream is cancelled on overflow.
+ *
+ * @throws BodyTooLargeError when the body is over the cap.
+ */
+export async function readCappedBody(
+  body: ReadableStream<Uint8Array> | null,
+  limit: number,
+): Promise<Buffer> {
+  const reader = body?.getReader();
+  if (!reader) return Buffer.alloc(0);
+  const chunks: Uint8Array[] = [];
+  let bytes = 0;
+  try {
+    for (;;) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      bytes += value.byteLength;
+      if (limit > 0 && bytes > limit) {
+        await reader.cancel().catch(() => {});
+        throw new BodyTooLargeError(limit);
+      }
+      chunks.push(value);
+    }
+  } finally {
+    reader.releaseLock();
+  }
+  return Buffer.concat(chunks.map((c) => Buffer.from(c.buffer, c.byteOffset, c.byteLength)));
+}
