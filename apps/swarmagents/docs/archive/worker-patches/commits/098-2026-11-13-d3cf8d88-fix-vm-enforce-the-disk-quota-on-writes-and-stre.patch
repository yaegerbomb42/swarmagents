+
+test("assertDiskQuota refuses a write that would cross the quota (incoming bytes)", async () => {
+  const manager = new VmManager({
+    customDriver: new CountingFake(),
+    quotas: { diskQuotaMb: 2 },
+  });
+
+  await manager.writeFile("alice", "/workspace/a.bin", mib(1)); // 1 MB used of 2 MB
+
+  // A 1 MB write lands exactly on the quota: allowed.
+  const usage = await manager.assertDiskQuota("alice", 1024 * 1024);
+  assert.equal(usage.usedMb, 1);
+  assert.equal(usage.quotaMb, 2);
+
+  // 1.1 MB more would project to 3 MB: refused before anything is written.
+  await assert.rejects(
+    manager.assertDiskQuota("alice", Math.ceil(1.1 * 1024 * 1024)),
+    (err: unknown) =>
+      err instanceof QuotaError &&
+      err.kind === "disk_quota" &&
+      err.limit === 2 &&
+      /plus this write \(2 MB\)/.test(err.message),
+  );
+});
+
+test("assertDiskQuota with incoming bytes is a no-op when the quota is disabled", async () => {
+  const manager = new VmManager({
+    customDriver: new CountingFake(),
+    quotas: { diskQuotaMb: 0 },
+  });
+  await manager.writeFile("alice", "/workspace/a.bin", mib(5));
+  const usage = await manager.assertDiskQuota("alice", 10 * 1024 * 1024);
+  assert.equal(usage.quotaMb, 0);
+  assert.equal(usage.overQuota, false);
+});
