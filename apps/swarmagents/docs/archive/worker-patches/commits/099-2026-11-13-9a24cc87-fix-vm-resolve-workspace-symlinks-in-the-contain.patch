-# else an operator-set SWARM_VNC_PASSWORD, else a random one generated here.
+SECRET_FILE=/home/node/.vnc/.swarm-vnc-incoming
+PASSWORD_FILE=/home/node/.vnc/.swarm-vnc-password
+
+# Resolve the VNC password: the driver's 0600 handoff file (the normal case),
+# else the copy from a previous boot, else a random one generated here.
 # A random one that the driver never saw means the web endpoint will refuse to
 # connect until the container is recreated — see the README.
-if [ -n "${SWARM_VNC_PASSWORD:-}" ]; then
-  VNC_PASSWORD="$SWARM_VNC_PASSWORD"
-elif [ -f /home/node/.vnc/.swarm-vnc-password ]; then
-  VNC_PASSWORD="$(cat /home/node/.vnc/.swarm-vnc-password)"
+if [ -f "$SECRET_FILE" ] && [ -r "$SECRET_FILE" ]; then
+  VNC_PASSWORD="$(cat "$SECRET_FILE")"
+  rm -f "$SECRET_FILE"
+elif [ -f "$PASSWORD_FILE" ] && [ -r "$PASSWORD_FILE" ]; then
+  VNC_PASSWORD="$(cat "$PASSWORD_FILE")"
 else
   VNC_PASSWORD="$(head -c 12 /dev/urandom | base64 | tr -d '=/+' | head -c 12)"
 fi
 
+# A stale SWARM_VNC_PASSWORD in the environment is never used (the driver does
+# not set one); clear it so it cannot reach the supervised children.
+unset SWARM_VNC_PASSWORD
+
 mkdir -p /home/node/.vnc
 umask 077
 
@@ -33,10 +44,7 @@ chmod 0600 /home/node/.vnc/passwd
 
 # The driver's plaintext copy — 0600, node-owned, for desktopEndpoint() to
 # re-read after a server restart.
-printf '%s\n' "$VNC_PASSWORD" > /home/node/.vnc/.swarm-vnc-password
-chmod 0600 /home/node/.vnc/.swarm-vnc-password
-
-# Unset so it cannot leak into the supervised children's environments or logs.
-unset SWARM_VNC_PASSWORD
+printf '%s\n' "$VNC_PASSWORD" > "$PASSWORD_FILE"
+chmod 0600 "$PASSWORD_FILE"
 
 exec supervisord -c /etc/supervisor/conf.d/swarm-desktop.conf
