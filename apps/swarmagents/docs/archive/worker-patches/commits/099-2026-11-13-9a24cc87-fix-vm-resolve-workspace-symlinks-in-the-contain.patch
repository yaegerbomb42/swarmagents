+test("an artifact that is a symlink out of the workspace is refused", async () => {
+  const runsDir = fs.mkdtempSync(path.join(os.tmpdir(), "swarm-report-route-"));
+  configureRunsDir(runsDir);
+  const driver = new FakeVmDriver();
+  const vmHandle = { userId: "alice", containerName: "c", createdAt: 0 };
+  await driver.writeFile(vmHandle, "/workspace/real.txt", "inside the workspace");
+  driver.link("alice", "/workspace/leak.txt", "/proc/1/environ");
+  driver.link("alice", "/workspace/passwd.txt", "/etc/passwd");
+  driver.link("alice", "/workspace/alias.txt", "/workspace/real.txt");
+  setVmManagerForTesting(new VmManager({ customDriver: driver }));
+  try {
+    const artifacts = ["leak.txt", "passwd.txt", "alias.txt"].map((rel) => ({
+      path: `/workspace/${rel}`,
+      rel,
+      size: 16,
+      mtimeMs: 6_000,
+      change: "created" as const,
+    }));
+    const report = assembleReport({
+      runId: "run_1",
+      userId: "alice",
+      events: seedEvents("alice"),
+      createdAt: 1_000,
+      finishedAt: 6_000,
+      artifacts,
+      shots: [],
+    });
+    writeRunReport("run_1", report, runsDir);
+
+    for (const rel of ["leak.txt", "passwd.txt"]) {
+      const res = await GET_ARTIFACT(
+        request(`/api/runtime/runs/run_1/report/artifacts?path=${rel}`),
+        ctx("run_1"),
+      );
+      assert.equal(res.status, 403, `expected ${rel} to be refused`);
+      const body = await res.json();
+      assert.equal(body.code, "outside_workspace");
+      // No byte of the target file is ever returned.
+      assert.equal(JSON.stringify(body).includes("PATH="), false);
+    }
+
+    // A symlink that stays inside the workspace is still downloadable.
+    const ok = await GET_ARTIFACT(
+      request("/api/runtime/runs/run_1/report/artifacts?path=alias.txt"),
+      ctx("run_1"),
+    );
+    assert.equal(ok.status, 200);
+    assert.equal(await ok.text(), "inside the workspace");
+  } finally {
+    fs.rmSync(runsDir, { recursive: true, force: true });
+  }
+});
+
 test("a report with no recorded owner is not public", async () => {
