+test("a run artifact that is a symlink out of /workspace never reaches the model", async () => {
+  // A fresh user keeps this test out of the rate-limit bucket the previous
+  // test deliberately exhausts.
+  const runUser = "lens-symlink-user@example.com";
+  const runsDir = join(tempDir, "runs");
+  mkdirSync(runsDir, { recursive: true });
+  const prevRunsDir = getRunsDir();
+  configureRunsDir(runsDir);
+
+  const driver = new FakeVmDriver();
+  const vmHandle = { userId: runUser, containerName: "c", createdAt: 0 };
+  await driver.writeFile(vmHandle, "/workspace/notes.txt", "VISIBLE-NOTES");
+  // A container file outside the workspace, reachable only through a symlink.
+  driver.seedFile(runUser, "/proc/1/environ", "SWARM_VNC_PASSWORD=supersecret");
+  driver.link(runUser, "/workspace/leak.txt", "/proc/1/environ");
+  setVmManagerForTesting(new VmManager({ customDriver: driver }));
+
+  try {
+    const runId = "lens_symlink_run";
+    writeFileSync(
+      join(runsDir, `${runId}.jsonl`),
+      `${JSON.stringify({
+        seq: 1,
+        runId,
+        ts: 1,
+        type: "run.created",
+        data: { userId: runUser, prompt: "hi" },
+      })}\n`,
+      "utf-8",
+    );
+    const events = [
+      { type: "run.created", data: { prompt: "hi", userId: runUser }, seq: 1, runId, ts: 1_000 },
+    ] as unknown as SequencedEvent[];
+    writeRunReport(
+      runId,
+      assembleReport({
+        runId,
+        userId: runUser,
+        events,
+        createdAt: 1_000,
+        finishedAt: 2_000,
+        artifacts: [
+          { path: "/workspace/leak.txt", rel: "leak.txt", size: 32, mtimeMs: 2_000, change: "created" },
+          { path: "/workspace/notes.txt", rel: "notes.txt", size: 13, mtimeMs: 2_000, change: "created" },
+        ],
+        shots: [],
+      }),
+      runsDir,
+    );
+
+    const bodies: string[] = [];
+    globalThis.fetch = (async (_input: unknown, init?: { body?: string }) => {
+      bodies.push(String(init?.body ?? ""));
+      return jsonResponse(openaiOk("explained"));
+    }) as unknown as typeof globalThis.fetch;
+
+    const res = await post({ lens: "security", message: "review the run", runId }, runUser);
+    assert.equal(res.status, 200);
+    assert.equal(bodies.length, 1);
+    // The workspace file is context; the symlinked /proc/1/environ is not.
+    assert.ok(bodies[0].includes("VISIBLE-NOTES"), "expected the workspace file in the prompt");
+    assert.equal(bodies[0].includes("supersecret"), false, "the symlink target must never reach the model");
+    assert.equal(bodies[0].includes("SWARM_VNC_PASSWORD"), false);
+  } finally {
+    configureRunsDir(prevRunsDir ?? null);
+  }
+});
