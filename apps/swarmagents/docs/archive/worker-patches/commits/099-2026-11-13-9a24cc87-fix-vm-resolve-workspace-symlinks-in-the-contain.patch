+// ---------------------------------------------------------------------------
+// VM-10 — workspace confinement follows symlinks
+// ---------------------------------------------------------------------------
+
+test("a workspace symlink that points outside /workspace is refused", async () => {
+  const vm = install();
+  const driver = vm.driver as FakeVmDriver;
+  driver.link("alice", "/workspace/passwd", "/etc/passwd");
+  driver.link("alice", "/workspace/environ", "/proc/1/environ");
+  driver.link("alice", "/workspace/secret-dir", "/root");
+
+  for (const name of ["passwd", "environ"]) {
+    const read = await GET(request(`/api/runtime/vm/files?path=/workspace/${name}&read=1`));
+    assert.equal(read.status, 403, `expected a read of ${name} to be refused`);
+    assert.equal((await json(read)).code, "outside_workspace");
+
+    const download = await GET(request(`/api/runtime/vm/files?path=/workspace/${name}&download=1`));
+    assert.equal(download.status, 403, `expected a download of ${name} to be refused`);
+    assert.equal((await json(download)).code, "outside_workspace");
+  }
+
+  // Listing through a symlinked directory is refused too.
+  const listing = await GET(request("/api/runtime/vm/files?path=/workspace/secret-dir"));
+  assert.equal(listing.status, 403);
+  assert.equal((await json(listing)).code, "outside_workspace");
+});
+
+test("a symlink that stays inside the workspace still works", async () => {
+  const vm = install();
+  await vm.writeFile("alice", "/workspace/real.txt", "real content");
+  (vm.driver as FakeVmDriver).link("alice", "/workspace/alias.txt", "/workspace/real.txt");
+
+  const res = await GET(request("/api/runtime/vm/files?path=/workspace/alias.txt&read=1"));
+  assert.equal(res.status, 200);
+  const body = await json(res);
+  assert.equal(body.content, "real content");
+});
