 import { spawn, type ChildProcess, type SpawnOptions } from "node:child_process";
 import { randomBytes } from "node:crypto";
+import { Readable, pipeline } from "node:stream";
 import type {
   VmDriver,
   VmHandle,
@@ -221,6 +222,98 @@ export class VmUnavailableError extends Error {
   }
 }
 
+/**
+ * Error codes meaning "the child process stopped reading our stdin". They are
+ * the async failure mode of a pipe whose reader is gone: the write lands on a
+ * closed socket and Node emits EPIPE (or destroys the stream) on the handle
+ * instead of returning an error from write().
+ */
+export const STDIN_CLOSED_CODES = [
+  "EPIPE",
+  "ECONNRESET",
+  "EPROTO",
+  "ERR_STREAM_DESTROYED",
+  "ERR_STREAM_PREMATURE_CLOSE",
+  "ERR_STREAM_WRITE_AFTER_END",
+] as const;
+
+const STDIN_CLOSED_SET: ReadonlySet<string> = new Set(STDIN_CLOSED_CODES);
+
+/** True when `err` is a "stdin closed early" stream error (EPIPE class). */
+export function isStdinClosedError(err: unknown): boolean {
+  if (!err || typeof err !== "object") return false;
+  const code = (err as NodeJS.ErrnoException).code;
+  return typeof code === "string" && STDIN_CLOSED_SET.has(code);
+}
+
+/**
+ * Raised when writing the exec() payload to the child's stdin fails because
+ * the child closed the pipe (EPIPE and friends). Without this, the failure
+ * arrives as an unhandled 'error' event on the stdin socket and takes the
+ * whole Next.js process down (VM-02).
+ *
+ * `code` is always "EPIPE" so callers can treat it as an EPIPE-class failure
+ * regardless of which underlying code fired; `streamCode` keeps the original.
+ */
+export class VmStdinError extends Error {
+  readonly code = "EPIPE";
+  readonly streamCode: string;
+  readonly cause?: Error;
+  constructor(message: string, streamCode: string, cause?: Error) {
+    super(message);
+    this.name = "VmStdinError";
+    this.streamCode = streamCode;
+    this.cause = cause;
+  }
+}
+
+/** Wrap any stdin failure in a {@link VmStdinError} with a readable message. */
+export function toStdinError(err: unknown): VmStdinError {
+  const raw =
+    err && typeof err === "object" ? (err as NodeJS.ErrnoException).code : undefined;
+  const code = typeof raw === "string" && raw.length > 0 ? raw : "EPIPE";
+  const cause = err instanceof Error ? err : undefined;
+  return new VmStdinError(
+    `The command stopped reading stdin before the payload was written (${code}). ` +
+      `The destination may be a directory, the workspace may be full, or the VM may have stopped.`,
+    code,
+    cause,
+  );
+}
+
+/**
+ * Attach a no-op 'error' listener so a stream error can never surface as an
+ * unhandled 'error' event (which crashes the process). An optional callback
+ * lets the caller record the failure.
+ */
+function guardStream(
+  stream: NodeJS.ReadableStream | NodeJS.WritableStream | null | undefined,
+  onError?: (err: Error) => void,
+): void {
+  if (!stream || typeof stream.on !== "function") return;
+  stream.on("error", (err: Error) => {
+    onError?.(err);
+  });
+}
+
+/**
+ * Size of one stdin chunk. Large payloads are fed to the pipe in pieces so the
+ * write path honours the socket's backpressure instead of handing a 13 MB
+ * buffer to one `write()` whose `false` return value nobody looks at.
+ */
+export const STDIN_CHUNK_BYTES = 64 * 1024;
+
