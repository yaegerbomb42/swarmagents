+
+// ---------------------------------------------------------------------------
+// VM-02: a destination that cannot take the bytes must be a 4xx and must never
+// take the server down (EPIPE on stdin used to crash the process).
+// ---------------------------------------------------------------------------
+
+test("upload onto an existing directory path is refused with 409, not 500", async () => {
+  const vm = install();
+  const driver = vm.driver as FakeVmDriver;
+  // A directory at the destination: the fake driver reports a directory when
+  // files exist underneath the path.
+  const handle = await driver.ensure("local");
+  await driver.writeFile(handle, `${UPLOAD_DIR}/taken/inner.txt`, "x");
+
+  const res = await POST(request([file("taken", "payload")]));
+  assert.equal(res.status, 409);
+  const body = await json(res);
+  assert.equal(body.code, "destination_not_a_file");
+  assert.match(body.error, /already exists as a directory/);
+  assert.equal(uploadAudits("local").at(-1)?.result, "failure");
+});
+
+test("a binary upload whose stdin closes (EPIPE) returns 409 and the server keeps serving", async () => {
+  class EpipedDriver extends FakeVmDriver {
+    override async exec(h: VmHandle, cmd: string[], opts?: ExecOptions): Promise<ExecResult> {
+      if (cmd[0] === "sh" && cmd[2]?.includes("base64 -d")) {
+        throw new VmStdinError(
+          "The command stopped reading stdin before the payload was written (EPIPE).",
+          "EPIPE",
+        );
+      }
+      return super.exec(h, cmd, opts);
+    }
+  }
+  install(new EpipedDriver());
+
+  const res = await POST(request([file("img.png", PNG_BYTES, "image/png")]));
+  assert.equal(res.status, 409);
+  const body = await json(res);
+  assert.equal(body.code, "destination_rejected");
+  assert.equal(uploadAudits("local").at(-1)?.result, "failure");
+
+  // The process (and the route) is still healthy: the next upload succeeds.
+  const ok = await POST(request([file("after.txt", "still here")]));
+  assert.equal(ok.status, 200);
+});
+
+test("a text upload whose writeFile hits EPIPE returns 409", async () => {
+  class EpipedWriteDriver extends FakeVmDriver {
+    override async writeFile(): Promise<void> {
+      throw new VmStdinError("The command stopped reading stdin (EPIPE).", "EPIPE");
+    }
+  }
+  install(new EpipedWriteDriver());
+
+  const res = await POST(request([file("notes.txt", "hello")]));
+  assert.equal(res.status, 409);
+  const body = await json(res);
+  assert.equal(body.code, "destination_rejected");
+});
