diff --git a/apps/swarmagents/lib/runtime/process-guard.test.ts b/apps/swarmagents/lib/runtime/process-guard.test.ts
new file mode 100644
index 000000000..664aa352b
--- /dev/null
+++ b/apps/swarmagents/lib/runtime/process-guard.test.ts
@@ -0,0 +1,139 @@
+/**
+ * Unit tests for the last-resort process guards (VM-02).
+ *
+ * The real `process` is never touched: each test drives a fake target that
+ * records listeners and emits the events Node would emit, so an EPIPE can be
+ * proven non-fatal without risking the test runner.
+ */
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  KNOWN_STREAM_CODES,
+  describeError,
+  isKnownStreamError,
+  processGuardsRegistered,
+  registerProcessGuards,
+  type ProcessGuardTarget,
+} from "./process-guard.js";
+
+type Listener = (arg: unknown) => void;
+
+class FakeProcess implements ProcessGuardTarget {
+  readonly handlers = new Map<string, Listener[]>();
+
+  on(event: string, listener: Listener): this {
+    const list = this.handlers.get(event) ?? [];
+    list.push(listener);
+    this.handlers.set(event, list);
+    return this;
+  }
+
+  removeListener(event: string, listener: Listener): this {
+    const list = this.handlers.get(event) ?? [];
+    this.handlers.set(
+      event,
+      list.filter((fn) => fn !== listener),
+    );
+    return this;
+  }
+
+  listenerCount(event: string): number {
+    return (this.handlers.get(event) ?? []).length;
+  }
+
+  emit(event: string, arg: unknown): void {
+    for (const fn of [...(this.handlers.get(event) ?? [])]) fn(arg);
+  }
+}
+
+function streamError(code: string, message = `socket hang up (${code})`): Error {
+  return Object.assign(new Error(message), { code });
+}
+
+function harness() {
+  const proc = new FakeProcess();
+  const logs: string[] = [];
+  const exits: number[] = [];
+  const dispose = registerProcessGuards({
+    target: proc,
+    exit: (code) => exits.push(code),
+    log: (message) => logs.push(message),
+  });
+  return { proc, logs, exits, dispose };
+}
+
+test("isKnownStreamError recognises the EPIPE family and nothing else", () => {
+  for (const code of KNOWN_STREAM_CODES) {
+    assert.equal(isKnownStreamError(streamError(code)), true, code);
+  }
+  assert.equal(isKnownStreamError(new Error("plain")), false);
+  assert.equal(isKnownStreamError(Object.assign(new Error("x"), { code: "ENOENT" })), false);
+  assert.equal(isKnownStreamError("EPIPE"), false);
+  assert.equal(isKnownStreamError(null), false);
+  assert.equal(isKnownStreamError(undefined), false);
+});
+
+test("describeError renders a code and never throws on odd values", () => {
+  assert.match(describeError(streamError("EPIPE")), /Error \[EPIPE\]: socket hang up/);
+  assert.equal(describeError("boom"), "boom");
+  assert.equal(describeError(42), "42");
+  const circular: Record<string, unknown> = {};
+  circular.self = circular;
+  assert.doesNotThrow(() => describeError(circular));
+});
+
+test("an EPIPE uncaughtException is logged and the process keeps serving", () => {
+  const { proc, logs, exits, dispose } = harness();
+  proc.emit("uncaughtException", streamError("EPIPE"));
+  assert.deepEqual(exits, []);
+  assert.equal(logs.length, 1);
+  assert.match(logs[0], /ignored stream error/);
+  assert.match(logs[0], /EPIPE/);
+  dispose();
+});
+
+test("an unknown uncaughtException keeps Node's fatal behaviour", () => {
+  const { proc, logs, exits, dispose } = harness();
+  proc.emit("uncaughtException", new TypeError("cannot read properties of undefined"));
+  assert.deepEqual(exits, [1]);
+  assert.match(logs[0], /fatal uncaught exception/);
+  dispose();
+});
+
+test("an EPIPE unhandledRejection is logged and does not exit", () => {
+  const { proc, logs, exits, dispose } = harness();
+  proc.emit("unhandledRejection", streamError("ERR_STREAM_DESTROYED"));
+  assert.deepEqual(exits, []);
+  assert.match(logs[0], /ignored stream rejection/);
+  dispose();
+});
+
+test("an unknown unhandledRejection exits non-zero", () => {
+  const { proc, exits, dispose } = harness();
+  proc.emit("unhandledRejection", new Error("database is on fire"));
+  assert.deepEqual(exits, [1]);
+  dispose();
+});
+
+test("registering twice for the same target installs one listener pair", () => {
+  const proc = new FakeProcess();
+  const first = registerProcessGuards({ target: proc, exit: () => {}, log: () => {} });
+  const second = registerProcessGuards({ target: proc, exit: () => {}, log: () => {} });
+  assert.equal(proc.listenerCount("uncaughtException"), 1);
+  assert.equal(proc.listenerCount("unhandledRejection"), 1);
+  assert.equal(first, second, "the existing disposer is reused");
+  assert.equal(processGuardsRegistered(), true);
+  first();
+  assert.equal(proc.listenerCount("uncaughtException"), 0);
+  assert.equal(proc.listenerCount("unhandledRejection"), 0);
+  assert.equal(processGuardsRegistered(), false);
+  first(); // disposing twice is safe
+});
+
+test("dispose stops the guards from reacting", () => {
+  const { proc, logs, exits, dispose } = harness();
+  dispose();
+  proc.emit("uncaughtException", new Error("after dispose"));
+  assert.deepEqual(exits, []);
+  assert.deepEqual(logs, []);
+});
diff --git a/apps/swarmagents/lib/runtime/process-guard.ts b/apps/swarmagents/lib/runtime/process-guard.ts
new file mode 100644
index 000000000..dcdb9784e
--- /dev/null
+++ b/apps/swarmagents/lib/runtime/process-guard.ts
@@ -0,0 +1,153 @@
+/**
+ * Last-resort process guards (VM-02).
+ *
+ * Stream errors are the one failure mode that cannot always be caught where it
+ * happens: a `socket.write()` whose reader is gone reports EPIPE asynchronously
+ * on the socket, and an 'error' event with no listener terminates the process.
+ * A single broken VM pipe must therefore never take the whole Next.js server
+ * down — every signed-in user would lose their session.
+ *
+ * `registerProcessGuards()` installs one `uncaughtException` and one
+ * `unhandledRejection` listener that:
+ *
+ * - log the error with its code and message, and keep serving, when the error
+ *   is a known stream error (EPIPE, ECONNRESET, destroyed / premature-close
+ *   streams). The failing request has already been rejected by the caller; the
+ *   process itself is healthy.
+ * - log the error and exit(1) for anything else, which preserves Node's
+ *   default behaviour: an unknown uncaught exception is a programming error and
+ *   must not be swallowed.
+ *
+ * Registration is idempotent (a module-level flag plus the globalThis guard,
+ * because Next.js can load this file into several bundles) and the returned
+ * disposer removes both listeners so tests can run cleanly.
+ */
+
+/** Error codes that mean "a stream peer went away", not "the server is broken". */
+export const KNOWN_STREAM_CODES = [
+  "EPIPE",
+  "ECONNRESET",
+  "EPROTO",
+  "ERR_STREAM_DESTROYED",
+  "ERR_STREAM_PREMATURE_CLOSE",
+  "ERR_STREAM_WRITE_AFTER_END",
+  "ERR_STREAM_ALREADY_FINISHED",
+  "ECANCELED",
+] as const;
+
+const KNOWN_STREAM_SET: ReadonlySet<string> = new Set(KNOWN_STREAM_CODES);
+
+/** True when `err` is a known stream error that must not crash the server. */
+export function isKnownStreamError(err: unknown): boolean {
+  if (!err || typeof err !== "object") return false;
+  const code = (err as NodeJS.ErrnoException).code;
+  return typeof code === "string" && KNOWN_STREAM_SET.has(code);
+}
+
+/** One line describing an unknown thrown value, safe for logs. */
+export function describeError(err: unknown): string {
+  if (err instanceof Error) {
+    const code = (err as NodeJS.ErrnoException).code;
+    return code ? `${err.name} [${code}]: ${err.message}` : `${err.name}: ${err.message}`;
+  }
+  if (typeof err === "string") return err;
+  try {
+    return JSON.stringify(err) ?? String(err);
+  } catch {
+    return String(err);
+  }
+}
+
+/** Injectable surface so tests never touch the real process. */
+export interface ProcessGuardTarget {
+  on(event: "uncaughtException" | "unhandledRejection", listener: (arg: unknown) => void): unknown;
+  removeListener(
+    event: "uncaughtException" | "unhandledRejection",
+    listener: (arg: unknown) => void,
+  ): unknown;
+}
+
+export interface ProcessGuardOptions {
+  /** Process to guard; defaults to the real one. */
+  target?: ProcessGuardTarget;
+  /** Exit function; defaults to `process.exit`. */
+  exit?: (code: number) => void;
+  /** Logger; defaults to console.error. */
+  log?: (message: string) => void;
+}
+
+const GLOBAL_FLAG = "__swarmProcessGuards";
+
+interface GuardFlag {
+  registered: boolean;
+  dispose: (() => void) | null;
+  target: ProcessGuardTarget | null;
+}
+
+function flag(): GuardFlag {
+  const holder = globalThis as unknown as Record<string, GuardFlag | undefined>;
+  if (!holder[GLOBAL_FLAG]) {
+    holder[GLOBAL_FLAG] = { registered: false, dispose: null, target: null };
+  }
+  return holder[GLOBAL_FLAG] as GuardFlag;
+}
+
+/**
+ * Install the guards once per process. Returns a disposer (also stored on the
+ * global flag) that removes them; calling it twice is safe.
+ */
+export function registerProcessGuards(options: ProcessGuardOptions = {}): () => void {
+  const target = options.target ?? (process as unknown as ProcessGuardTarget);
+  const exit = options.exit ?? ((code: number) => process.exit(code));
+  const log = options.log ?? ((message: string) => console.error(message));
+
+  // Next.js loads instrumentation once, but several bundles can import this
+  // module: the same target is only ever guarded once.
+  const existing = flag();
+  if (existing.registered && existing.dispose && existing.target === target) {
+    return existing.dispose;
+  }
+
+  const onUncaught = (err: unknown): void => {
+    if (isKnownStreamError(err)) {
+      log(`[process] ignored stream error (server keeps serving): ${describeError(err)}`);
+      return;
+    }
+    log(`[process] fatal uncaught exception: ${describeError(err)}`);
+    exit(1);
+  };
+
+  const onRejection = (reason: unknown): void => {
+    if (isKnownStreamError(reason)) {
+      log(`[process] ignored stream rejection (server keeps serving): ${describeError(reason)}`);
+      return;
+    }
+    log(`[process] fatal unhandled rejection: ${describeError(reason)}`);
+    exit(1);
+  };
+
+  target.on("uncaughtException", onUncaught);
+  target.on("unhandledRejection", onRejection);
+
+  const dispose = (): void => {
+    target.removeListener("uncaughtException", onUncaught);
+    target.removeListener("unhandledRejection", onRejection);
+    const state = flag();
+    if (state.dispose === dispose) {
+      state.registered = false;
+      state.dispose = null;
+      state.target = null;
+    }
+  };
+
+  const state = flag();
+  state.registered = true;
+  state.dispose = dispose;
+  state.target = target;
+  return dispose;
+}
+
+/** True when the guards are installed in this process. */
+export function processGuardsRegistered(): boolean {
+  return flag().registered;
+}
