+});
+
+test("POST verify checks an exported bundle supplied in the body", async () => {
+  await withSecret(SECRET, async () => {
+    const runsDir = tmpDir();
+    configureRunsDir(runsDir);
+    try {
+      seedReportWithReceipt(runsDir);
+      const stored = readRunReport("run_1", runsDir)!.receipt!;
+      const tampered = JSON.parse(JSON.stringify(stored)) as typeof stored;
+      tampered.signature = "0".repeat(64);
+      const verify = await POST_VERIFY(
+        request("/api/runtime/runs/run_1/report/receipt/verify", "alice", {
+          method: "POST",
+          headers: { "content-type": "application/json" },
+          body: JSON.stringify({ receipt: tampered }),
+        }),
+        { params: Promise.resolve({ id: "run_1" }) },
+      );
+      assert.equal(verify.status, 200);
+      assert.deepEqual(await verify.json(), { ok: false, reason: "signature" });
+    } finally {
+      configureRunsDir(null);
+      fs.rmSync(runsDir, { recursive: true, force: true });
+    }
+  });
+});
+
+test("receipt routes are owner-only: 401 without a user, 404 for another owner", async () => {
+  await withSecret(SECRET, async () => {
+    const runsDir = tmpDir();
+    configureRunsDir(runsDir);
+    try {
+      seedReportWithReceipt(runsDir);
+      const ctx = { params: Promise.resolve({ id: "run_1" }) };
+
+      const anon = await GET_RECEIPT(request("/api/runtime/runs/run_1/report/receipt", null), ctx);
+      assert.equal(anon.status, 401);
+      const anonVerify = await POST_VERIFY(
+        request("/api/runtime/runs/run_1/report/receipt/verify", null, { method: "POST" }),
+        ctx,
+      );
+      assert.equal(anonVerify.status, 401);
+
+      const other = await GET_RECEIPT(request("/api/runtime/runs/run_1/report/receipt", "mallory"), ctx);
+      assert.equal(other.status, 404);
+      const otherVerify = await POST_VERIFY(
+        request("/api/runtime/runs/run_1/report/receipt/verify", "mallory", { method: "POST" }),
+        ctx,
+      );
+      assert.equal(otherVerify.status, 404);
+
+      const missing = await GET_RECEIPT(request("/api/runtime/runs/run_nope/report/receipt"), {
+        params: Promise.resolve({ id: "run_nope" }),
+      });
+      assert.equal(missing.status, 404);
+    } finally {
+      configureRunsDir(null);
+      fs.rmSync(runsDir, { recursive: true, force: true });
+    }
+  });
+});
+
+test("GET receipt 404s when the report has no receipt", async () => {
+  const runsDir = tmpDir();
+  configureRunsDir(runsDir);
+  try {
+    const report = assembleReport({
+      runId: "run_1",
+      userId: "alice",
+      events: seedEvents("alice"),
+      createdAt: 1_000,
+      finishedAt: 6_000,
+      artifacts: [],
+      shots: [],
+    });
+    writeRunReport("run_1", report, runsDir);
+    const res = await GET_RECEIPT(request("/api/runtime/runs/run_1/report/receipt"), {
+      params: Promise.resolve({ id: "run_1" }),
+    });
+    assert.equal(res.status, 404);
+  } finally {
+    configureRunsDir(null);
+    fs.rmSync(runsDir, { recursive: true, force: true });
+  }
+});
diff --git a/apps/swarmagents/lib/runtime/report-route-auth.ts b/apps/swarmagents/lib/runtime/report-route-auth.ts
new file mode 100644
index 000000000..fac7de8ae
--- /dev/null
+++ b/apps/swarmagents/lib/runtime/report-route-auth.ts
@@ -0,0 +1,41 @@
+/**
+ * Shared owner-only auth for the per-run report routes
+ * (`app/api/runtime/runs/[id]/report/...`).
+ *
+ * The report route inlines this today; the receipt routes reuse it so the
+ * caller check and the owner check live in exactly one place. Returns the
+ * stored report when the caller owns the run, or null (the caller gets a
+ * 404 either way — a wrong-owner run is indistinguishable from a missing
+ * one, exactly as the report route does it).
+ */
+
+import type { NextRequest } from "next/server";
+import { USER_HEADER } from "../auth";
+import { RUN_ID_RE } from "../telemetry/paths";
+import { getRun } from "./run-store";
+import { readRunReport } from "./run-report";
+import type { RunReport } from "./run-report-types";
+
+/** The `x-swarm-user` caller, or null when unsigned/invalid. */
+export function reportCaller(req: NextRequest): string | null {
+  const user = req.headers.get(USER_HEADER);
+  return user && user.length > 0 && user.length <= 128 ? user : null;
+}
+
+/** True when `id` is a syntactically valid run id. */
+export function isValidRunId(id: string): boolean {
+  return RUN_ID_RE.test(id);
+}
+
+/**
+ * Load a run's stored report for its owner, or null when the report does
+ * not exist, the id is invalid, or the caller is not the run's owner.
+ */
+export function loadOwnedReport(id: string, user: string): RunReport | null {
+  if (!RUN_ID_RE.test(id)) return null;
+  const report = readRunReport(id);
+  if (!report) return null;
+  const owner = report.userId || getRun(id)?.summary.userId;
+  if (!owner || owner !== user) return null;
+  return report;
+}
diff --git a/apps/swarmagents/lib/runtime/run-receipt.test.ts b/apps/swarmagents/lib/runtime/run-receipt.test.ts
new file mode 100644
index 000000000..814acae72
--- /dev/null
+++ b/apps/swarmagents/lib/runtime/run-receipt.test.ts
@@ -0,0 +1,187 @@
+/**
+ * F16 — signed audit receipts: chain construction, sign/verify, tamper
+ * resistance (naming the exact failing link), and secret handling.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  GENESIS_PREV,
+  RECEIPT_DOMAIN,
+  RECEIPT_FORMAT,
+  buildReceiptChain,
+  receiptSigningInput,
+  signReceipt,
+  verifyReceipt,
+  verifyReceiptChain,
+  type ReceiptChainEntry,
+  type RunReceipt,
+} from "./run-receipt";
+
+let savedEnv: NodeJS.ProcessEnv;
+
+test.beforeEach(() => {
+  savedEnv = { ...process.env };
+  process.env.SWARM_SESSION_SECRET = "test-receipt-secret-do-not-use";
+});
+
+test.afterEach(() => {
+  for (const key of Object.keys(process.env)) if (!(key in savedEnv)) delete process.env[key];
+  Object.assign(process.env, savedEnv);
+});
+
+/** A realistic entry set: prompt, approval, attestation, command, artifact. */
+function sampleEntries(): ReceiptChainEntry[] {
+  return [
+    { kind: "prompt", hash: "a".repeat(64) },
+    { kind: "approval", decision: "allow", tool: "Bash", ts: 1_700_000_000_000 },
+    { kind: "attestation", provider: "test-provider", model: "test-model", ts: 1_700_000_000_001 },
+    { kind: "command", command: "npm test", exitCode: 0, ts: 1_700_000_000_002 },
+    { kind: "artifact", rel: "out.txt", hash: "b".repeat(64), size: 12 },
+  ];
+}
+
+function signedReceipt(entries: ReceiptChainEntry[] = sampleEntries()): RunReceipt {
+  const { links, head } = buildReceiptChain(entries);
+  return signReceipt({
+    format: RECEIPT_FORMAT,
+    runId: "run_receipt_1",
+    createdAt: 1_700_000_000_000,
+    head,
+    links,
+  });
+}
+
+test("a signed receipt verifies, and the chain is deterministic", () => {
+  const receipt = signedReceipt();
+  assert.equal(receipt.format, RECEIPT_FORMAT);
+  assert.equal(receipt.links.length, 5);
+  assert.equal(receipt.links[0]?.prev, GENESIS_PREV);
+  assert.equal(receipt.head, receipt.links[receipt.links.length - 1]?.hash);
+  assert.deepEqual(verifyReceipt(receipt), { ok: true });
+  assert.deepEqual(verifyReceiptChain(receipt.links), { ok: true });
+  // Genesis determinism: the same entries always produce the same head.
+  const again = signedReceipt();
+  assert.equal(again.head, receipt.head);
+  assert.deepEqual(
+    again.links.map((link) => link.hash),
+    receipt.links.map((link) => link.hash),
+  );
+  // The signing input is domain-separated from F4's proof domain.
+  const { signature: _sig, ...unsigned } = receipt;
+  assert.ok(receiptSigningInput(unsigned).startsWith(`${RECEIPT_DOMAIN}:`));
+});
+
+test("tampering any link's entry fails verification and names that link", () => {
+  const entries = sampleEntries();
+  for (let i = 0; i < entries.length; i += 1) {
+    const receipt = signedReceipt(entries);
+    const tampered = structuredClone(receipt);
+    const link = tampered.links[i]!;
+    // Change a field inside the entry (kind-specific, so it is a real tamper).
+    if (link.kind === "approval") link.entry.decision = "deny";
+    else if (link.kind === "prompt") link.entry.hash = "c".repeat(64);
+    else if (link.kind === "attestation") link.entry.model = "other-model";
+    else if (link.kind === "command") link.entry.exitCode = 1;
+    else link.entry.size = 13;
+    const result = verifyReceipt(tampered);
+    assert.equal(result.ok, false, `link ${i} tamper must fail`);
+    assert.equal(result.failedLink, i, `link ${i} tamper must name index ${i}`);
+    assert.equal(result.reason, "chain");
+    // The pure chain check agrees, without needing the signature.
+    assert.deepEqual(verifyReceiptChain(tampered.links), {
+      ok: false,
+      failedLink: i,
+      reason: "chain",
+    });
+  }
+});
+
+test("tampering an artifact entry's hash fails and names its link", () => {
+  const receipt = signedReceipt();
+  const tampered = structuredClone(receipt);
+  const artifactLink = tampered.links[4]!;
+  assert.equal(artifactLink.kind, "artifact");
+  artifactLink.entry.hash = "d".repeat(64);
+  assert.deepEqual(verifyReceipt(tampered), { ok: false, failedLink: 4, reason: "chain" });
+});
+
+test("tampering the head fails verification", () => {
+  const receipt = signedReceipt();
+  // Head is covered by the signature, so a tampered head is a signature failure.
+  const tampered = { ...receipt, head: "e".repeat(64) };
+  assert.deepEqual(verifyReceipt(tampered), { ok: false, reason: "signature" });
+  // A malformed head is a format failure.
+  assert.deepEqual(
+    verifyReceipt({ ...receipt, head: "not-a-hash" }),
+    { ok: false, reason: "format" },
+  );
+});
+
+test("signing refuses an unset secret and verification fails without it", () => {
+  delete process.env.SWARM_SESSION_SECRET;
+  const { links, head } = buildReceiptChain(sampleEntries());
+  assert.throws(
+    () =>
+      signReceipt({ format: RECEIPT_FORMAT, runId: "run_receipt_1", createdAt: 0, head, links }),
+    /SWARM_SESSION_SECRET/,
+  );
+  process.env.SWARM_SESSION_SECRET = "test-receipt-secret-do-not-use";
+  const receipt = signedReceipt();
+  // Wrong secret -> signature failure.
+  assert.deepEqual(verifyReceipt(receipt, "a-different-secret"), {
+    ok: false,
+    reason: "signature",
+  });
+  // No secret at verify time -> never verified.
+  delete process.env.SWARM_SESSION_SECRET;
+  assert.deepEqual(verifyReceipt(receipt), { ok: false, reason: "signature" });
+});
+
+test("verification fails for the wrong format and for malformed receipts", () => {
+  const receipt = signedReceipt();
+  assert.deepEqual(verifyReceipt({ ...receipt, format: "swarmagents.proof/v1" }), {
+    ok: false,
+    reason: "format",
+  });
+  assert.deepEqual(verifyReceipt({ ...receipt, format: "swarmagents.receipt/v2" }), {
+    ok: false,
+    reason: "format",
+  });
+  // Garbage -> never verified, never throws.
+  assert.deepEqual(verifyReceipt(null), { ok: false, reason: "format" });
+  assert.deepEqual(verifyReceipt("signed"), { ok: false, reason: "format" });
+  assert.deepEqual(verifyReceipt({ ...receipt, links: "nope" }), {
+    ok: false,
+    reason: "format",
+  });
+  // Missing signature -> never verified.
+  const { signature: _sig, ...unsigned } = receipt;
+  assert.deepEqual(verifyReceipt(unsigned), { ok: false, reason: "signature" });
+});
+
+test("an empty chain has zero links, a genesis head, and verifies", () => {
+  const { links, head } = buildReceiptChain([]);
+  assert.equal(links.length, 0);
+  assert.equal(head, GENESIS_PREV);
+  assert.deepEqual(verifyReceiptChain(links), { ok: true });
+  const receipt = signReceipt({
+    format: RECEIPT_FORMAT,
+    runId: "run_receipt_empty",
+    createdAt: 1_700_000_000_000,
+    head,
+    links,
+  });
+  assert.deepEqual(verifyReceipt(receipt), { ok: true });
+});
+
+test("reordering links or breaking the prev pointer fails at the first bad link", () => {
+  const receipt = signedReceipt();
+  const swapped = structuredClone(receipt);
+  [swapped.links[1], swapped.links[2]] = [swapped.links[2]!, swapped.links[1]!];
+  assert.deepEqual(verifyReceipt(swapped), { ok: false, failedLink: 1, reason: "chain" });
+
+  const brokenPrev = structuredClone(receipt);
+  brokenPrev.links[3]!.prev = "f".repeat(64);
+  assert.deepEqual(verifyReceipt(brokenPrev), { ok: false, failedLink: 3, reason: "chain" });
+});
diff --git a/apps/swarmagents/lib/runtime/run-receipt.ts b/apps/swarmagents/lib/runtime/run-receipt.ts
new file mode 100644
index 000000000..5b5b96415
--- /dev/null
+++ b/apps/swarmagents/lib/runtime/run-receipt.ts
@@ -0,0 +1,242 @@
+/**
+ * F16 — Signed audit receipts for run reports.
+ *
+ * A run report (`report.json`) gains a tamper-evident hash chain plus an
+ * HMAC signature — the "receipt" — so anyone holding the report can check
+ * that the prompt, approval decisions, provider/model attestations, redacted
+ * command logs and artifact hashes it records are exactly what the server
+ * saw at finalize time. Tampering with any link breaks that link and every
+ * link after it, and verification reports exactly which link failed.
+ *
+ * Signing reuses F4's scheme (`lib/library/proof.ts`): HMAC-SHA256 keyed by
+ * `SWARM_SESSION_SECRET`, domain-separated, with its own format marker.
+ * The receipt has its own domain (`swarmagents:receipt:v1`) and its own
+ * shape — it is NOT a `ProofBundle`. The helpers `canonicalJson`,
+ * `sha256Hex` and `proofSecret` are imported from proof.ts rather than
+ * re-implemented, so the two schemes can never drift apart.
+ *
+ * Trust model, stated plainly (same as F4): the signature proves *this
+ * server* produced the receipt from a run it executed — it is not the
+ * publisher's signature, and a receipt signed on one instance will not
+ * verify on another instance with a different secret. If
+ * `SWARM_SESSION_SECRET` is unset, signing refuses outright (an empty key
+ * would be worse than no receipt).
+ *
+ * Chain construction: each link covers the canonical JSON of its entry
+ * plus the previous link's hash —
+ * `hash = sha256Hex(prev + canonicalJson(entry))`. The genesis link's
+ * `prev` is 64 zero characters (`GENESIS_PREV`); there is no "previous
+ * hash" before the first entry, so a fixed, documented constant stands
+ * in. An empty chain (no entries) has zero links and its head is
+ * `GENESIS_PREV`. The head is the hash of the last link and is covered
+ * by the signature, so tampering with the head breaks verification too.
+ *
+ * The receipt is built at finalize time (see `lib/runtime/run-reporter.ts`)
+ * and stored IN `report.json` — unlike `verification`/`audit`, which are
+ * merged at serve time and are not stored.
+ */
+
+import { createHmac, timingSafeEqual } from "node:crypto";
+import { canonicalJson, proofSecret, sha256Hex } from "../library/proof";
+
+/** Receipt format marker; bump if the signed payload shape ever changes. */
+export const RECEIPT_FORMAT = "swarmagents.receipt/v1";
+/** Domain separator for the HMAC input (see module doc). */
+export const RECEIPT_DOMAIN = "swarmagents:receipt:v1";
+/**
+ * `prev` of the genesis (first) link: 64 zero characters. A fixed constant
+ * is used because there is no previous link hash before the first entry;
+ * any verifier re-deriving the chain starts from this same value.
+ */
+export const GENESIS_PREV = "0".repeat(64);
+
+/** Kinds of evidence a receipt chain link can carry. */
+export type ReceiptChainEntryKind =
+  | "prompt"
+  | "approval"
+  | "attestation"
+  | "command"
+  | "artifact"
+  | "note";
+
+/**
+ * One entry in the chain. Kept permissive on purpose: the entry
+ * extractors (prompt hash, approval decisions, attestations, redacted
+ * command logs, artifact hashes) supply the fields; every field must be
+ * JSON-serializable so `canonicalJson` is deterministic. `kind`
+ * discriminates the entry; the free-form fields carry the evidence.
+ */
+export type ReceiptChainEntry =
+  | { kind: "prompt"; [key: string]: unknown }
+  | { kind: "approval"; [key: string]: unknown }
+  | { kind: "attestation"; [key: string]: unknown }
+  | { kind: "command"; [key: string]: unknown }
+  | { kind: "artifact"; [key: string]: unknown }
+  | { kind: "note"; [key: string]: unknown };
+
+/** One link in the hash chain. */
+export interface ReceiptChainLink {
+  /** Position in the chain (0-based); links must be sequential. */
+  seq: number;
+  /** Mirrors `entry.kind` so the chain is readable without parsing entries. */
+  kind: ReceiptChainEntryKind;
+  /** `sha256Hex(prev + canonicalJson(entry))`. */
+  hash: string;
+  /** Previous link's hash, or `GENESIS_PREV` for the first link. */
+  prev: string;
+  /** The canonical entry object this link commits to. */
+  entry: ReceiptChainEntry;
+}
+
+/** The signed receipt stored in `report.json`. */
+export interface RunReceipt {
+  /** Must equal `RECEIPT_FORMAT`. */
+  format: string;
+  runId: string;
+  /** Epoch ms the receipt was built (finalize time). */
+  createdAt: number;
+  /** Hash of the last chain link (`GENESIS_PREV` when the chain is empty). */
+  head: string;
+  links: ReceiptChainLink[];
+  /**
+   * Hex HMAC-SHA256 over the canonical receipt (minus this field).
+   * `null` when signing was unavailable at build time (server secret
+   * unset) — the receipt is stored unsigned rather than failing the run,
+   * and `signingError` records why. A null signature never verifies.
+   */
+  signature: string | null;
+  /** Why the receipt is unsigned, when `signature` is null. */
+  signingError?: string;
+}
+
+/** Outcome of a receipt/chain verification. Never throws. */
+export interface ReceiptVerification {
+  ok: boolean;
+  /** Index of the first chain link that failed re-derivation, when known. */
+  failedLink?: number;
+  /**
+   * Why verification failed: `"format"` (wrong/malformed receipt shape),
+   * `"chain"` (a link hash does not re-derive), or `"signature"` (the
+   * HMAC does not check out — includes a tampered head, which the
+   * signature covers — or the secret is unset/wrong).
+   */
+  reason?: "format" | "chain" | "signature";
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function isHex64(value: unknown): value is string {
+  return typeof value === "string" && /^[0-9a-f]{64}$/.test(value);
+}
+
+/**
+ * Build the hash chain over the entries, in order. Pure and deterministic:
+ * the same entries always produce the same links and head. An empty entry
+ * list yields zero links and a head of `GENESIS_PREV`.
+ */
+export function buildReceiptChain(entries: ReceiptChainEntry[]): {
+  links: ReceiptChainLink[];
+  head: string;
+} {
+  const links: ReceiptChainLink[] = [];
+  let prev = GENESIS_PREV;
+  for (let seq = 0; seq < entries.length; seq += 1) {
+    const entry = entries[seq]!;
+    const hash = sha256Hex(prev + canonicalJson(entry));
+    links.push({ seq, kind: entry.kind, hash, prev, entry });
+    prev = hash;
+  }
+  return { links, head: prev };
+}
+
+/** The exact bytes the HMAC covers: domain + canonical receipt, no signature. */
+export function receiptSigningInput(receipt: Omit<RunReceipt, "signature">): string {
+  return `${RECEIPT_DOMAIN}:${canonicalJson(receipt)}`;
+}
+
+/**
+ * Sign an unsigned receipt. Throws when the server secret is unset — a
+ * receipt signed with an empty key would be worse than no receipt at all.
+ * An explicit `secret` overrides `SWARM_SESSION_SECRET` (used by tests);
+ * callers in production omit it.
+ */
+export function signReceipt(
+  receipt: Omit<RunReceipt, "signature">,
+  secret?: string,
+): RunReceipt {
+  const key = secret ?? proofSecret();
+  if (!key) {
+    throw new Error(
+      "Receipt signing is not configured on this server (SWARM_SESSION_SECRET is unset).",
+    );
+  }
+  const signature = createHmac("sha256", key).update(receiptSigningInput(receipt)).digest("hex");
+  return { ...receipt, signature };
+}
+
+/**
+ * Pure chain check, no signature involved: re-derive every link hash in
+ * order from `GENESIS_PREV` and confirm each link's `seq`, `kind` and
+ * `prev` line up. Returns the index of the first failing link, or `ok`
+ * when the whole chain re-derives. Never throws.
+ */
+export function verifyReceiptChain(links: unknown): ReceiptVerification {
+  if (!Array.isArray(links)) return { ok: false, reason: "format" };
+  let prev = GENESIS_PREV;
+  for (let seq = 0; seq < links.length; seq += 1) {
+    const link = links[seq] as unknown;
+    if (!isRecord(link)) return { ok: false, failedLink: seq, reason: "chain" };
+    if (link.seq !== seq) return { ok: false, failedLink: seq, reason: "chain" };
+    if (!isRecord(link.entry) || typeof link.entry.kind !== "string") {
+      return { ok: false, failedLink: seq, reason: "chain" };
+    }
+    if (link.kind !== link.entry.kind) return { ok: false, failedLink: seq, reason: "chain" };
+    if (link.prev !== prev) return { ok: false, failedLink: seq, reason: "chain" };
+    if (!isHex64(link.hash)) return { ok: false, failedLink: seq, reason: "chain" };
+    const expected = sha256Hex(prev + canonicalJson(link.entry));
+    if (link.hash !== expected) return { ok: false, failedLink: seq, reason: "chain" };
+    prev = link.hash;
+  }
+  return { ok: true };
+}
+
+/**
+ * Verify a stored receipt: format first, then the whole chain (naming the
+ * first failing link), then the HMAC with a timing-safe comparison. Any
+ * failure — wrong format, tampered link, tampered head (covered by the
+ * signature), missing/malformed signature, unset or wrong secret — is
+ * simply "not verified"; the caller never shows it as verified. Never
+ * throws. An explicit `secret` overrides `SWARM_SESSION_SECRET` (tests).
+ */
+export function verifyReceipt(receipt: unknown, secret?: string): ReceiptVerification {
+  if (!isRecord(receipt)) return { ok: false, reason: "format" };
+  if (receipt.format !== RECEIPT_FORMAT) return { ok: false, reason: "format" };
+  if (typeof receipt.runId !== "string" || !receipt.runId) {
+    return { ok: false, reason: "format" };
+  }
+  if (typeof receipt.createdAt !== "number" || !Number.isFinite(receipt.createdAt)) {
+    return { ok: false, reason: "format" };
+  }
+  if (!isHex64(receipt.head)) return { ok: false, reason: "format" };
+  if (!Array.isArray(receipt.links)) return { ok: false, reason: "format" };
+  const chain = verifyReceiptChain(receipt.links);
+  if (!chain.ok) return chain;
+  // The head is covered by the signature (it is part of the signed
+  // payload), so a tampered head fails the HMAC check below as
+  // "signature" — it is not a link failure.
+  const { signature, ...unsigned } = receipt as unknown as RunReceipt;
+  if (!isHex64(signature)) return { ok: false, reason: "signature" };
+  const key = secret ?? proofSecret();
+  if (!key) return { ok: false, reason: "signature" };
+  const expectedMac = createHmac("sha256", key)
+    .update(receiptSigningInput(unsigned as Omit<RunReceipt, "signature">))
+    .digest("hex");
+  const a = Buffer.from(signature, "utf8");
+  const b = Buffer.from(expectedMac, "utf8");
