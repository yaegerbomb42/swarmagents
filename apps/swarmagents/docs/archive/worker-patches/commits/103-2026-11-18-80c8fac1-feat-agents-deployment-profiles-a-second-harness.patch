@@ -0,0 +1,179 @@
+/**
+ * Phase 7 routes: deployment profiles, the template gallery and deploy-with-profile.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { NextRequest } from "next/server";
+import { USER_HEADER } from "@/lib/auth";
+import { AGENT_MANIFEST_VERSION, catalogModelIds } from "@/lib/agents/manifest";
+import { configureAgentsDir } from "@/lib/agents/store";
+import { configureAgentProfilesDir } from "@/lib/agents/profiles";
+import { setRuntimeManagerForTesting, type RuntimeManager } from "@/lib/runtime/manager";
+import { GET as PROFILES, POST as SAVE_PROFILE } from "./profiles/route";
+import { DELETE as DELETE_PROFILE } from "./profiles/[id]/route";
+import { GET as TEMPLATES } from "./templates/route";
+import { POST as IMPORT_TEMPLATE } from "./templates/[id]/import/route";
+import { POST as CREATE } from "./route";
+import { GET as HARNESSES } from "./harnesses/route";
+import { POST as DEPLOY } from "./[id]/deploy/route";
+
+const MODELS = [...catalogModelIds()];
+const PREFERRED = MODELS[0];
+const OVERRIDE = MODELS[1];
+let dir = "";
+
+function req(method: string, url: string, body?: unknown, user: string | null = "alice"): NextRequest {
+  return new NextRequest(`http://localhost${url}`, {
+    method,
+    headers: { "content-type": "application/json", ...(user ? { [USER_HEADER]: user } : {}) },
+    ...(body === undefined ? {} : { body: typeof body === "string" ? body : JSON.stringify(body) }),
+  });
+}
+
+const ctx = (id: string) => ({ params: Promise.resolve({ id }) });
+
+function manifest() {
+  return {
+    version: AGENT_MANIFEST_VERSION,
+    id: "deployable",
+    name: "Deployable",
+    identity: { systemPrompt: "Do the work." },
+    models: { preferred: PREFERRED, fallbacks: [] },
+    tools: ["Read"],
+    mcp: [],
+    connectors: [],
+    context: [],
+    memory: { policy: "none" },
+    skills: [],
+    workflows: [],
+    policies: {},
+    permissions: { allowTools: [], denyTools: [], approvalRequired: false },
+    subagents: [],
+  };
+}
+
+test.beforeEach(() => {
+  dir = fs.mkdtempSync(path.join(os.tmpdir(), "swarm-agent-p7-routes-"));
+  configureAgentsDir(dir);
+  configureAgentProfilesDir(dir);
+});
+
+test.afterEach(() => {
+  setRuntimeManagerForTesting(null);
+  configureAgentsDir(undefined);
+  configureAgentProfilesDir(undefined);
+  fs.rmSync(dir, { recursive: true, force: true });
+});
+
+test("profile and template routes refuse an unauthenticated caller", async () => {
+  const calls = [
+    PROFILES(req("GET", "/api/agents/profiles", undefined, null)),
+    SAVE_PROFILE(req("POST", "/api/agents/profiles", { id: "dev", name: "Dev", harness: "swarm" }, null)),
+    DELETE_PROFILE(req("DELETE", "/api/agents/profiles/dev", undefined, null), ctx("dev")),
+    TEMPLATES(req("GET", "/api/agents/templates", undefined, null)),
+    IMPORT_TEMPLATE(req("POST", "/api/agents/templates/triage-bot/import", {}, null), ctx("triage-bot")),
+  ];
+  for (const res of await Promise.all(calls)) {
+    assert.equal(res.status, 401);
+    assert.equal(res.headers.get("cache-control"), "no-store");
+  }
+});
+
+test("profiles: create, list, reject an invalid one, delete", async () => {
+  const created = await SAVE_PROFILE(req("POST", "/api/agents/profiles", { id: "dev", name: "Dev", harness: "swarm" }));
+  assert.equal(created.status, 201);
+
+  const listed = await PROFILES(req("GET", "/api/agents/profiles"));
+  const body = (await listed.json()) as { profiles: Array<{ id: string; harness: string }> };
+  assert.deepEqual(body.profiles.map((row) => row.id), ["dev"]);
+  assert.equal(body.profiles[0].harness, "swarm");
+
+  const invalid = await SAVE_PROFILE(req("POST", "/api/agents/profiles", { id: "No Spaces", name: "x", harness: "swarm" }));
+  assert.equal(invalid.status, 400);
+
+  assert.equal((await DELETE_PROFILE(req("DELETE", "/api/agents/profiles/dev"), ctx("dev"))).status, 200);
+  assert.equal((await DELETE_PROFILE(req("DELETE", "/api/agents/profiles/dev"), ctx("dev"))).status, 404);
+});
+
+test("templates list the shipped gallery and import into the account", async () => {
+  const listed = await TEMPLATES(req("GET", "/api/agents/templates"));
+  assert.equal(listed.status, 200);
+  const body = (await listed.json()) as {
+    templates: Array<{ id: string; name: string; description: string }>;
+    issues: unknown[];
+  };
+  assert.deepEqual(body.issues, []);
+  assert.ok(body.templates.length >= 3);
+  assert.ok(body.templates.every((row) => row.name && row.description));
+
+  const first = body.templates[0];
+  const imported = await IMPORT_TEMPLATE(req("POST", `/api/agents/templates/${first.id}/import`, {}), ctx(first.id));
+  assert.equal(imported.status, 201);
+  const importedBody = (await imported.json()) as { agent: { id: string; name: string } };
+  assert.equal(importedBody.agent.name, first.name);
+
+  // Importing the same template twice de-dupes the id instead of overwriting.
+  const again = await IMPORT_TEMPLATE(req("POST", `/api/agents/templates/${first.id}/import`, {}), ctx(first.id));
+  assert.equal(again.status, 201);
+  const againBody = (await again.json()) as { agent: { id: string } };
+  assert.notEqual(againBody.agent.id, importedBody.agent.id);
+
+  assert.equal(
+    (await IMPORT_TEMPLATE(req("POST", "/api/agents/templates/nope/import", {}), ctx("nope"))).status,
+    404,
+  );
+});
+
+test("harnesses now lists both adapters with their capabilities", async () => {
+  const res = await HARNESSES(req("GET", "/api/agents/harnesses"));
+  const body = (await res.json()) as { harnesses: Array<{ id: string; name: string; capabilities: { tools: string[] } }> };
+  assert.deepEqual(body.harnesses.map((row) => row.id), ["swarm", "local-claude-cli"]);
+  assert.ok(body.harnesses[0].capabilities.tools.includes("Bash"));
+  assert.deepEqual(body.harnesses[1].capabilities.tools, [], "the stub grants no tools");
+});
+
+test("deploy with a profile applies its model override before the run starts", async () => {
+  assert.equal((await CREATE(req("POST", "/api/agents", manifest()))).status, 201);
+  assert.equal(
+    (await SAVE_PROFILE(req("POST", "/api/agents/profiles", {
+      id: "dev",
+      name: "Dev",
+      harness: "swarm",
+      modelOverrides: { preferred: OVERRIDE },
+    }))).status,
+    201,
+  );
+
+  const calls: Array<Record<string, unknown>> = [];
+  const fake = {
+    start: (_userId: string, input: Record<string, unknown>) => {
+      calls.push(input);
+      return { accepted: true, runId: "run_profile", queued: false };
+    },
+  };
+  setRuntimeManagerForTesting(fake as unknown as RuntimeManager);
+
+  const deployed = await DEPLOY(req("POST", "/api/agents/deployable/deploy", { profile: "dev" }), ctx("deployable"));
+  assert.equal(deployed.status, 200);
+  const body = (await deployed.json()) as { runId: string; profile: string; applied: string[] };
+  assert.equal(body.runId, "run_profile");
+  assert.equal(body.profile, "dev");
+  assert.ok(body.applied.some((entry) => entry.includes(OVERRIDE)));
+  assert.equal(calls[0].model, OVERRIDE, "the profile's model must reach the runtime");
+
+  const unknown = await DEPLOY(req("POST", "/api/agents/deployable/deploy", { profile: "ghost" }), ctx("deployable"));
+  assert.equal(unknown.status, 400);
+});
+
+test("deploying to the stub harness is refused with 'not implemented'", async () => {
+  assert.equal((await CREATE(req("POST", "/api/agents", manifest()))).status, 201);
+  const res = await DEPLOY(req("POST", "/api/agents/deployable/deploy", { harness: "local-claude-cli" }), ctx("deployable"));
+  assert.equal(res.status, 400);
+  const body = (await res.json()) as { error: string; missing: string[] };
+  assert.match(body.error, /not implemented/i);
+  assert.ok(body.missing.length > 0);
+});
