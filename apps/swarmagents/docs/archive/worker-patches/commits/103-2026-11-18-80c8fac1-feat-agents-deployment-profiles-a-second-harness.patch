index 000000000..00453c04b
--- /dev/null
+++ b/apps/swarmagents/lib/agents/adapters/local-claude.ts
@@ -0,0 +1,62 @@
+/**
+ * Local Claude Code CLI adapter (Agent Studio, phase 7) — DELIBERATELY A STUB.
+ *
+ * The manifest claims to be harness-agnostic; this adapter exists to prove the
+ * interface can carry a second harness, and to report honestly what that
+ * harness is. It does NOT run anything: `deploy` refuses with "not
+ * implemented". Faking a deploy here would be worse than refusing — a user
+ * would believe an agent was running when nothing was.
+ *
+ * What is real: capability detection. `claude` is looked up on PATH (and
+ * `CLAUDE_CLI_PATH` overrides it), so the UI can say truthfully whether this
+ * machine has the CLI at all.
+ */
+
+import fs from "node:fs";
+import path from "node:path";
+import { catalogModelIds } from "../manifest";
+import type { AdapterCapabilities, DeployFailure, HarnessAdapter } from "./types";
+
+export const LOCAL_CLAUDE_ADAPTER_ID = "local-claude-cli";
+export const NOT_IMPLEMENTED =
+  "The local Claude Code CLI adapter is not implemented in this build: it reports its capabilities but cannot deploy an agent yet.";
+
+/** Where the CLI would be, without executing it. */
+export function detectLocalClaudeCli(env: NodeJS.ProcessEnv = process.env): string | null {
+  const explicit = env.CLAUDE_CLI_PATH?.trim();
+  if (explicit && fs.existsSync(explicit)) return explicit;
+  const dirs = (env.PATH ?? "").split(path.delimiter).filter(Boolean);
+  for (const dir of dirs) {
+    const candidate = path.join(dir, "claude");
+    try {
+      const stat = fs.statSync(candidate);
+      if (stat.isFile()) return candidate;
+    } catch {
+      // not in this directory
+    }
+  }
+  return null;
+}
+
+export const localClaudeAdapter: HarnessAdapter = {
+  id: LOCAL_CLAUDE_ADAPTER_ID,
+  name: "Local Claude Code CLI (not implemented)",
+  capabilities(): AdapterCapabilities {
+    const cli = detectLocalClaudeCli();
+    return {
+      // The CLI has no per-run tool allowlist API in this build, so it can grant
+      // nothing: claiming otherwise would let a manifest deploy that cannot be
+      // enforced.
+      tools: [],
+      models: [...catalogModelIds()],
+      supportsMcp: cli !== null,
+      mcpTransports: cli ? ["stdio"] : [],
+      memoryPolicies: ["none", "session"],
+      supportsSubagents: false,
+      connectors: [],
+    };
+  },
+  async deploy(): Promise<DeployFailure> {
+    return { ok: false, error: NOT_IMPLEMENTED, missing: [NOT_IMPLEMENTED] };
+  },
+};
diff --git a/apps/swarmagents/lib/agents/adapters/registry.ts b/apps/swarmagents/lib/agents/adapters/registry.ts
