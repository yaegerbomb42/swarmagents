@@ -0,0 +1,30 @@
+/**
+ * GET  /api/agents/profiles -> the caller's deployment profiles
+ * POST /api/agents/profiles -> create or replace one profile
+ *
+ * A profile binds an agent to an environment (harness, model overrides, MCP
+ * endpoint bindings). It never carries a credential.
+ */
+
+import type { NextRequest } from "next/server";
+import { readProfiles, saveProfile } from "@/lib/agents/profiles";
+import { agentCaller, badRequest, ok, readAgentBody, unauthorized } from "@/lib/agents/http";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+export async function GET(req: NextRequest) {
+  const user = agentCaller(req);
+  if (!user) return unauthorized();
+  return ok({ profiles: readProfiles(user) });
+}
+
+export async function POST(req: NextRequest) {
+  const user = agentCaller(req);
+  if (!user) return unauthorized();
+  const body = await readAgentBody(req);
+  if (!body.ok) return body.response;
+  const result = saveProfile(user, body.value);
+  if (!result.ok) return badRequest("Profile is invalid.", { errors: result.errors });
+  return ok({ profile: result.profile }, 201);
+}
diff --git a/apps/swarmagents/app/api/agents/templates/[id]/import/route.ts b/apps/swarmagents/app/api/agents/templates/[id]/import/route.ts
new file mode 100644
