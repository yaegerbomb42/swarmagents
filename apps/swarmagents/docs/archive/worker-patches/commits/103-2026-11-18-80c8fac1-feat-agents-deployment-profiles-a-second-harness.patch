--- /dev/null
+++ b/apps/swarmagents/app/api/agents/templates/[id]/import/route.ts
@@ -0,0 +1,26 @@
+/**
+ * POST /api/agents/templates/{id}/import -> clone a template into this account.
+ *
+ * The template goes through the normal import path, so it gets a fresh id when
+ * the id is taken, secrets are stripped, and unknown skills come back as
+ * warnings.
+ */
+
+import type { NextRequest } from "next/server";
+import { getTemplate } from "@/lib/agents/templates";
+import { importAgent } from "@/lib/agents/store";
+import { agentCaller, notFound, ok, routeId, unauthorized } from "@/lib/agents/http";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+export async function POST(req: NextRequest, ctx: { params: Promise<{ id: string }> }) {
+  const user = agentCaller(req);
+  if (!user) return unauthorized();
+  const id = await routeId(ctx);
+  const template = getTemplate(id);
+  if (!template) return notFound("Template not found.");
+  const result = importAgent(user, template.manifest);
+  if (!result.ok) return notFound("Template could not be imported.");
+  return ok({ agent: result.manifest, warnings: result.warnings }, 201);
+}
