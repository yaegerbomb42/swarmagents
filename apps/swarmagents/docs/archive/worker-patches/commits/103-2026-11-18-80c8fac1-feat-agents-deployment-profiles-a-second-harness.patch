@@ -0,0 +1,16 @@
+/** DELETE /api/agents/profiles/{id} -> remove one profile. */
+
+import type { NextRequest } from "next/server";
+import { deleteProfile } from "@/lib/agents/profiles";
+import { agentCaller, notFound, ok, routeId, unauthorized } from "@/lib/agents/http";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+export async function DELETE(req: NextRequest, ctx: { params: Promise<{ id: string }> }) {
+  const user = agentCaller(req);
+  if (!user) return unauthorized();
+  const id = await routeId(ctx);
+  if (!deleteProfile(user, id)) return notFound("Profile not found.");
+  return ok({ ok: true, id });
+}
diff --git a/apps/swarmagents/app/api/agents/profiles/route.ts b/apps/swarmagents/app/api/agents/profiles/route.ts
