+/**
+ * The harness adapters this build ships (Agent Studio, phase 7).
+ *
+ * Keeping the registry separate from any one adapter means adding a harness is
+ * a change here plus its adapter file — the routes and the UI never enumerate
+ * harnesses by hand.
+ */
+
+import { localClaudeAdapter } from "./local-claude";
+import { swarmAdapter } from "./swarm";
+import type { HarnessAdapter } from "./types";
+
+export function harnessAdapters(): HarnessAdapter[] {
+  return [swarmAdapter, localClaudeAdapter];
+}
+
+export function adapterById(id: string): HarnessAdapter | undefined {
+  return harnessAdapters().find((adapter) => adapter.id === id);
+}
diff --git a/apps/swarmagents/lib/agents/phase7.test.ts b/apps/swarmagents/lib/agents/phase7.test.ts
new file mode 100644
index 000000000..922f56cd7
--- /dev/null
+++ b/apps/swarmagents/lib/agents/phase7.test.ts
@@ -0,0 +1,208 @@
+/**
+ * Phase 7: deployment profiles, the second harness adapter and community
+ * templates.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import {
+  configureAgentProfilesDir,
+  deleteProfile,
+  getProfile,
+  MAX_PROFILES,
+  parseProfile,
+  readProfiles,
+  resolveProfile,
+  saveProfile,
+} from "./profiles";
+import { loadTemplates, getTemplate, TEMPLATES_DIR } from "./templates";
+import { adapterById, harnessAdapters } from "./adapters/registry";
+import { detectLocalClaudeCli, localClaudeAdapter, NOT_IMPLEMENTED } from "./adapters/local-claude";
+import { catalogModelIds, validateManifest, type AgentManifest } from "./manifest";
+import { globalAgentCatalog } from "./catalog";
+import { configureAgentsDir, saveAgent } from "./store";
+
+const MODELS = [...catalogModelIds()];
+const A = MODELS[0];
+const B = MODELS[1];
+let dir = "";
+
+test.beforeEach(() => {
+  dir = fs.mkdtempSync(path.join(os.tmpdir(), "swarm-agent-profiles-"));
+  configureAgentProfilesDir(dir);
+  configureAgentsDir(dir);
+});
+
+test.afterEach(() => {
+  configureAgentProfilesDir(undefined);
+  configureAgentsDir(undefined);
+  fs.rmSync(dir, { recursive: true, force: true });
+});
+
+function manifest(overrides: Record<string, unknown> = {}): AgentManifest {
+  const validated = validateManifest({
+    version: 1,
+    id: "profiled",
+    name: "Profiled agent",
+    identity: { systemPrompt: "Do the work." },
+    models: { preferred: A, fallbacks: [] },
+    tools: ["Read"],
+    mcp: [
+      { name: "library-tools", transport: "http", url: "https://placeholder.invalid/mcp" },
+      { name: "local-tools", transport: "stdio", command: "node tools.mjs" },
+    ],
+    connectors: [],
+    context: [],
+    memory: { policy: "none" },
+    skills: [],
+    workflows: [],
+    policies: {},
+    permissions: { allowTools: [], denyTools: [], approvalRequired: false },
+    subagents: [],
+    ...overrides,
+  }, globalAgentCatalog(), { requireCatalogIds: false });
+  assert.equal(validated.ok, true, JSON.stringify(validated));
+  return (validated as { ok: true; manifest: AgentManifest }).manifest;
+}
+
+test("a profile needs a slug id, a name and a harness", () => {
+  assert.equal(parseProfile({ id: "Bad Id", name: "x", harness: "swarm" }), null);
+  assert.equal(parseProfile({ id: "dev", name: "", harness: "swarm" }), null);
+  assert.equal(parseProfile({ id: "dev", name: "Dev", harness: "" }), null);
+  const ok = parseProfile({ id: "dev", name: " Dev ", harness: "swarm", modelOverrides: { preferred: B, fallbacks: ["", A] } });
+  assert.deepEqual(ok, { id: "dev", name: "Dev", harness: "swarm", modelOverrides: { preferred: B, fallbacks: [A] } });
+});
+
+test("profiles round-trip per account and delete", () => {
+  assert.equal(saveProfile("alice", { id: "dev", name: "Dev", harness: "swarm" }).ok, true);
+  assert.equal(saveProfile("alice", { id: "prod", name: "Prod", harness: "swarm" }).ok, true);
+  assert.deepEqual(readProfiles("alice").map((row) => row.id).sort(), ["dev", "prod"]);
+  assert.equal(getProfile("alice", "dev")?.name, "Dev");
+  assert.deepEqual(readProfiles("bob"), [], "profiles are per account");
+
+  assert.equal(deleteProfile("alice", "dev"), true);
+  assert.equal(deleteProfile("alice", "dev"), false);
+  assert.deepEqual(readProfiles("alice").map((row) => row.id), ["prod"]);
+});
+
+test("saving an existing profile replaces it, and the cap only blocks new ids", () => {
+  for (let i = 0; i < MAX_PROFILES; i += 1) {
+    assert.equal(saveProfile("alice", { id: `p-${i}`, name: `P ${i}`, harness: "swarm" }).ok, true);
+  }
+  const over = saveProfile("alice", { id: "one-too-many", name: "No", harness: "swarm" });
+  assert.equal(over.ok, false);
+  // Replacing an existing profile still works at the cap.
+  const replaced = saveProfile("alice", { id: "p-0", name: "Renamed", harness: "swarm" });
+  assert.equal(replaced.ok, true);
+  assert.equal(getProfile("alice", "p-0")?.name, "Renamed");
+});
+
+test("resolveProfile applies model overrides and MCP endpoint bindings", () => {
+  const base = manifest();
+  const profile = {
+    id: "dev",
+    name: "Dev",
+    harness: "swarm",
+    modelOverrides: { preferred: B, fallbacks: [A] },
+    bindings: { mcp: { "library-tools": "http://127.0.0.1:9000/mcp" } },
+  };
+  const resolved = resolveProfile(base, profile);
+  assert.equal(resolved.manifest.models.preferred, B);
+  assert.deepEqual(resolved.manifest.models.fallbacks, [A]);
+  assert.equal(resolved.manifest.mcp[0].url, "http://127.0.0.1:9000/mcp");
+  assert.equal(resolved.manifest.mcp[1].command, "node tools.mjs", "stdio servers are never rewritten");
+  assert.ok(resolved.changed.some((entry) => /model/.test(entry)));
+  assert.ok(resolved.changed.some((entry) => /mcp library-tools/.test(entry)));
+});
+
+test("resolveProfile warns instead of inventing bindings", () => {
+  const resolved = resolveProfile(manifest(), {
+    id: "prod",
+    name: "Prod",
+    harness: "swarm",
+    bindings: { mcp: { "not-declared": "https://x.invalid/mcp" } },
+  });
+  assert.ok(resolved.warnings.some((warning) => /not-declared.*ignored/.test(warning)));
+  // A declared http server with no binding is a warning, not a silent default.
+  assert.ok(resolved.warnings.some((warning) => /library-tools has no binding/.test(warning)));
+});
+
+test("resolveProfile with no profile is the identity", () => {
+  const base = manifest();
+  const resolved = resolveProfile(base, null);
+  assert.equal(resolved.manifest, base);
+  assert.deepEqual(resolved.warnings, []);
+  assert.deepEqual(resolved.changed, []);
+});
+
+test("every shipped template validates and loads without issues", () => {
+  const { templates, issues } = loadTemplates();
+  assert.deepEqual(issues, [], "a template that does not validate must be fixed, not shipped");
+  assert.ok(templates.length >= 3, `expected at least 3 templates, got ${templates.length}`);
+  for (const template of templates) {
+    assert.equal(template.manifest.version, 1);
+    assert.ok(template.manifest.identity.systemPrompt.length > 0);
+    assert.ok(template.description.length > 0, `${template.id} needs a description for the gallery`);
+  }
+  const files = fs.readdirSync(path.resolve(process.cwd(), TEMPLATES_DIR)).filter((name) => name.endsWith(".json"));
+  assert.equal(files.length, templates.length + issues.length);
+});
+
+test("getTemplate finds one template and misses cleanly", () => {
+  const first = loadTemplates().templates[0];
+  assert.equal(getTemplate(first.id)?.manifest.id, first.id);
+  assert.equal(getTemplate("does-not-exist"), null);
+});
+
+test("a template imports into an account through the normal path", async () => {
+  // Saving the template manifest under a different id is exactly what the
+  // import route does; assert the store accepts a shipped manifest as-is.
+  const template = loadTemplates().templates[0];
+  const saved = saveAgent("alice", { ...template.manifest, id: "from-template" }, globalAgentCatalog());
+  assert.equal(saved.ok, true);
+  assert.equal(fs.existsSync(path.join(dir, "agents")), true);
+});
+
+test("the adapter registry ships two harnesses and the stub refuses honestly", async () => {
+  const adapters = harnessAdapters();
+  assert.deepEqual(adapters.map((adapter) => adapter.id), ["swarm", "local-claude-cli"]);
+  assert.equal(adapterById("nope"), undefined);
+
+  const stub = adapterById("local-claude-cli");
+  assert.ok(stub);
+  const caps = stub!.capabilities();
+  // It grants no tools, because the CLI has no per-run allowlist in this build.
+  assert.deepEqual(caps.tools, []);
+  assert.equal(caps.supportsSubagents, false);
+
+  const result = await stub!.deploy("alice", manifest());
+  assert.equal(result.ok, false);
+  if (result.ok) return;
+  assert.equal(result.error, NOT_IMPLEMENTED);
+  assert.ok(result.missing?.includes(NOT_IMPLEMENTED));
+  assert.ok(!/swarm/i.test(localClaudeAdapter.name.replace("Claude", "")), "the stub must be labelled as not implemented");
+});
+
+test("local CLI detection looks on PATH without executing anything", () => {
+  const empty = detectLocalClaudeCli({ PATH: "/definitely/not/here" } as unknown as NodeJS.ProcessEnv);
+  assert.equal(empty, null);
+  // Whatever this machine has, the answer is either a real path or null — never a guess.
+  const detected = detectLocalClaudeCli();
+  if (detected !== null) assert.equal(fs.existsSync(detected), true);
+});
+
+test("every shipped template is deployable on the harness it ships for", async () => {
+  const { compatibilityReport } = await import("./compatibility");
+  const { templates } = loadTemplates();
+  for (const template of templates) {
+    const report = compatibilityReport(template.manifest);
+    assert.deepEqual(
+      report.missing,
+      [],
+      `template ${template.id} cannot deploy on the swarm harness: ${report.missing.join("; ")}`,
+    );
+  }
+});
diff --git a/apps/swarmagents/lib/agents/profiles.ts b/apps/swarmagents/lib/agents/profiles.ts
new file mode 100644
index 000000000..7f0699250
--- /dev/null
+++ b/apps/swarmagents/lib/agents/profiles.ts
@@ -0,0 +1,195 @@
+/**
+ * Deployment profiles (Agent Studio, phase 7).
+ *
+ * A profile is a named, per-account binding of one agent to an environment:
+ * which harness to deploy to, optional model overrides, and the endpoint
+ * bindings for that environment (MCP urls, provider ids).
+ *
+ * Profiles are deliberately separate from the manifest: the manifest is the
+ * portable asset, a profile is what makes it run *here*. That is why a profile
+ * is never exported with an agent and never carries a credential — a binding is
+ * an endpoint or an id, and the destination still authenticates it itself.
+ */
+
+import fs from "node:fs";
+import path from "node:path";
+import { atomicWriteFile } from "../atomic-write";
+import { resolveDataDir, userDirName } from "../providers/store";
+import type { AgentManifest } from "./manifest";
+
+export const PROFILES_FILE = "profiles.json";
+export const MAX_PROFILES = 20;
+const PROFILE_ID_RE = /^[a-z0-9][a-z0-9-]{0,31}$/;
+
+export interface AgentProfileBindings {
+  /** MCP server name -> endpoint for this environment. */
+  mcp?: Record<string, string>;
+  /** Logical provider slot -> provider id in this account. */
+  providers?: Record<string, string>;
+}
+
+export interface AgentDeploymentProfile {
+  id: string;
+  name: string;
+  harness: string;
+  modelOverrides?: {
+    preferred?: string;
+    fallbacks?: string[];
+  };
+  bindings?: AgentProfileBindings;
+}
+
+interface ProfilesFile {
+  version: 1;
+  profiles: AgentDeploymentProfile[];
+}
+
+let DATA_DIR_OVERRIDE: string | undefined;
+
+/** Point profile storage at a fixed directory (tests). */
+export function configureAgentProfilesDir(dir: string | undefined): void {
+  DATA_DIR_OVERRIDE = dir || undefined;
+}
+
+function profilesFile(userId: string): string {
+  const root = DATA_DIR_OVERRIDE ?? resolveDataDir();
+  return path.join(root, "agents", userDirName(userId), PROFILES_FILE);
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function stringMap(value: unknown): Record<string, string> | undefined {
+  if (!isRecord(value)) return undefined;
+  const out: Record<string, string> = {};
+  for (const [key, raw] of Object.entries(value)) {
+    if (typeof raw === "string" && raw.trim()) out[key] = raw.trim();
+  }
+  return Object.keys(out).length > 0 ? out : undefined;
+}
+
+/** Normalize one untrusted profile. Returns null when it cannot be used. */
+export function parseProfile(value: unknown): AgentDeploymentProfile | null {
+  if (!isRecord(value)) return null;
+  const id = typeof value.id === "string" ? value.id.trim() : "";
+  const name = typeof value.name === "string" ? value.name.trim() : "";
+  const harness = typeof value.harness === "string" ? value.harness.trim() : "";
+  if (!PROFILE_ID_RE.test(id) || !name || !harness) return null;
+
+  const overridesRaw = isRecord(value.modelOverrides) ? value.modelOverrides : {};
+  const preferred = typeof overridesRaw.preferred === "string" ? overridesRaw.preferred.trim() : "";
+  const fallbacks = Array.isArray(overridesRaw.fallbacks)
+    ? overridesRaw.fallbacks.filter((entry): entry is string => typeof entry === "string" && entry.trim().length > 0)
+    : [];
+  const bindingsRaw = isRecord(value.bindings) ? value.bindings : {};
+  const mcp = stringMap(bindingsRaw.mcp);
+  const providers = stringMap(bindingsRaw.providers);
+
+  return {
+    id,
+    name: name.slice(0, 100),
+    harness,
+    ...(preferred || fallbacks.length > 0
+      ? { modelOverrides: { ...(preferred ? { preferred } : {}), ...(fallbacks.length > 0 ? { fallbacks } : {}) } }
+      : {}),
+    ...(mcp || providers ? { bindings: { ...(mcp ? { mcp } : {}), ...(providers ? { providers } : {}) } } : {}),
+  };
+}
+
+export function readProfiles(userId: string): AgentDeploymentProfile[] {
+  let raw: string;
+  try {
+    raw = fs.readFileSync(profilesFile(userId), "utf-8");
+  } catch {
+    return [];
+  }
+  try {
+    const parsed = JSON.parse(raw) as unknown;
+    if (!isRecord(parsed) || !Array.isArray(parsed.profiles)) return [];
+    return parsed.profiles.map((entry) => parseProfile(entry)).filter((entry): entry is AgentDeploymentProfile => entry !== null);
+  } catch {
+    return [];
+  }
+}
+
+export function getProfile(userId: string, id: string): AgentDeploymentProfile | null {
+  return readProfiles(userId).find((profile) => profile.id === id) ?? null;
+}
+
+export type SaveProfileResult =
+  | { ok: true; profile: AgentDeploymentProfile }
+  | { ok: false; errors: string[] };
+
+/** Create or replace one profile. Rejects an id above the per-account cap. */
+export function saveProfile(userId: string, input: unknown): SaveProfileResult {
+  const profile = parseProfile(input);
+  if (!profile) return { ok: false, errors: ["a profile needs a slug id, a name and a harness"] };
+  const existing = readProfiles(userId);
+  const without = existing.filter((row) => row.id !== profile.id);
+  if (!existing.some((row) => row.id === profile.id) && existing.length >= MAX_PROFILES) {
+    return { ok: false, errors: [`at most ${MAX_PROFILES} profiles per account`] };
+  }
+  const next: ProfilesFile = { version: 1, profiles: [...without, profile] };
+  const file = profilesFile(userId);
+  fs.mkdirSync(path.dirname(file), { recursive: true, mode: 0o700 });
+  atomicWriteFile(file, JSON.stringify(next, null, 2), { mode: 0o600 });
+  return { ok: true, profile };
+}
+
+export function deleteProfile(userId: string, id: string): boolean {
+  const existing = readProfiles(userId);
+  const next = existing.filter((row) => row.id !== id);
+  if (next.length === existing.length) return false;
+  const file = profilesFile(userId);
+  fs.mkdirSync(path.dirname(file), { recursive: true, mode: 0o700 });
+  atomicWriteFile(file, JSON.stringify({ version: 1, profiles: next } satisfies ProfilesFile, null, 2), { mode: 0o600 });
+  return true;
+}
+
+export interface ResolvedProfile {
+  manifest: AgentManifest;
+  warnings: string[];
+  changed: string[];
+}
+
+/**
+ * Apply one profile to a manifest: model overrides and environment bindings.
+ *
+ * Bindings only rewrite the *endpoint* of an MCP server the manifest already
+ * declares. A binding for a server that is not in the manifest is reported as a
+ * warning instead of silently adding a server the agent never asked for.
+ */
+export function resolveProfile(manifest: AgentManifest, profile: AgentDeploymentProfile | null): ResolvedProfile {
+  if (!profile) return { manifest, warnings: [], changed: [] };
+  const warnings: string[] = [];
+  const changed: string[] = [];
+
+  const preferred = profile.modelOverrides?.preferred;
+  const fallbacks = profile.modelOverrides?.fallbacks;
+  const models = {
+    preferred: preferred ?? manifest.models.preferred,
+    fallbacks: fallbacks ?? manifest.models.fallbacks,
+  };
+  if (preferred && preferred !== manifest.models.preferred) changed.push(`model ${manifest.models.preferred} -> ${preferred}`);
+  if (fallbacks) changed.push("fallbacks overridden by the profile");
+
+  const bindings = profile.bindings?.mcp ?? {};
+  const declared = new Set(manifest.mcp.map((server) => server.name));
+  for (const name of Object.keys(bindings)) {
+    if (!declared.has(name)) warnings.push(`binding for MCP server "${name}" was ignored: the agent does not declare it`);
+  }
+  const mcp = manifest.mcp.map((server) => {
+    const bound = bindings[server.name];
+    if (!bound || server.transport === "stdio") return server;
+    changed.push(`mcp ${server.name} -> ${bound}`);
+    return { ...server, url: bound };
+  });
+  for (const server of manifest.mcp) {
+    if (server.transport !== "stdio" && !bindings[server.name]) {
+      warnings.push(`MCP server ${server.name} has no binding in profile "${profile.id}"`);
+    }
+  }
+
+  return { manifest: { ...manifest, models, mcp }, warnings, changed };
+}
diff --git a/apps/swarmagents/lib/agents/templates.ts b/apps/swarmagents/lib/agents/templates.ts
new file mode 100644
index 000000000..a2545b3e3
--- /dev/null
+++ b/apps/swarmagents/lib/agents/templates.ts
@@ -0,0 +1,74 @@
+/**
+ * Community agent templates (Agent Studio, phase 7).
+ *
+ * A read-only list seeded from `templates/agents/*.json` in the repo. Templates
+ * are ordinary manifests, so importing one is the normal import path (fresh id,
+ * secrets stripped, unknown skills reported) — there is no second format and no
+ * privileged path.
+ *
+ * Every shipped template is validated at load time against the global catalog;
+ * a template that does not validate is reported as unavailable rather than
+ * offered to a user and failing at import.
+ */
+
+import fs from "node:fs";
+import path from "node:path";
+import { globalAgentCatalog } from "./catalog";
+import { validateManifest, type AgentManifest } from "./manifest";
+
+export const TEMPLATES_DIR = path.join("templates", "agents");
+
+export interface AgentTemplate {
+  id: string;
+  name: string;
+  description: string;
+  manifest: AgentManifest;
+}
+
+export interface TemplateIssue {
+  id: string;
+  error: string;
+}
+
+function templatesDir(override?: string): string {
+  return override ?? path.resolve(process.cwd(), TEMPLATES_DIR);
+}
+
+/** Load and validate every template. Invalid ones are surfaced, never hidden. */
+export function loadTemplates(dir?: string): { templates: AgentTemplate[]; issues: TemplateIssue[] } {
+  let names: string[];
+  try {
+    names = fs.readdirSync(templatesDir(dir)).filter((name) => name.endsWith(".json")).sort();
+  } catch {
+    return { templates: [], issues: [] };
+  }
+  const templates: AgentTemplate[] = [];
+  const issues: TemplateIssue[] = [];
+  const catalog = globalAgentCatalog();
+  for (const name of names) {
+    const file = path.join(templatesDir(dir), name);
+    let raw: unknown;
+    try {
+      raw = JSON.parse(fs.readFileSync(file, "utf-8"));
+    } catch (err) {
+      issues.push({ id: name, error: `unreadable JSON: ${err instanceof Error ? err.message : "unknown error"}` });
+      continue;
+    }
+    const validated = validateManifest(raw, catalog, { requireCatalogIds: false });
+    if (!validated.ok) {
+      issues.push({ id: name, error: validated.errors.join("; ") });
+      continue;
+    }
+    templates.push({
+      id: validated.manifest.id,
+      name: validated.manifest.name,
+      description: validated.manifest.description ?? "",
+      manifest: validated.manifest,
+    });
+  }
+  return { templates, issues };
+}
+
+export function getTemplate(id: string, dir?: string): AgentTemplate | null {
+  return loadTemplates(dir).templates.find((template) => template.id === id) ?? null;
+}
