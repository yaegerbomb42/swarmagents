+/**
+ * GET /api/agents/templates -> the read-only community template list.
+ *
+ * Templates ship with the repo and are validated on load, so a broken template
+ * is reported in `issues` instead of being offered and failing at import.
+ */
+
+import type { NextRequest } from "next/server";
+import { loadTemplates } from "@/lib/agents/templates";
+import { agentCaller, ok, unauthorized } from "@/lib/agents/http";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+export async function GET(req: NextRequest) {
+  const user = agentCaller(req);
+  if (!user) return unauthorized();
+  const { templates, issues } = loadTemplates();
+  return ok({
+    templates: templates.map((template) => ({
+      id: template.id,
+      name: template.name,
+      description: template.description,
+    })),
+    issues,
+  });
+}
diff --git a/apps/swarmagents/lib/agents/adapters/local-claude.ts b/apps/swarmagents/lib/agents/adapters/local-claude.ts
