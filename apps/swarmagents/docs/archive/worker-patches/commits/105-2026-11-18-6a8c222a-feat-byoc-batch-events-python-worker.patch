+class EventBatcher:
+    """Batch claude stream-json events off the stdout thread.
+
+    A synchronous HTTP POST per stream-json line stalls stdout draining on
+    slow networks and can fill the pipe buffer, blocking claude
+    mid-execution. Events are queued (bounded) and flushed by a background
+    thread every ~150ms or up to 50 events per batch. If the queue is
+    severely congested the oldest event is dropped so stdout never stalls.
+    """
+
+    def __init__(self, run_id):
+        self.run_id = run_id
+        self.q = queue.Queue(maxsize=2000)
+        self.closed = threading.Event()
+        self.thread = threading.Thread(target=self._flush_loop, daemon=True)
+        self.thread.start()
+
+    def push(self, event):
+        try:
+            self.q.put_nowait(event)
+        except queue.Full:
+            # Drop oldest if severely congested so claude stdout never stalls
+            try:
+                self.q.get_nowait()
+                self.q.put_nowait(event)
+            except Exception:
+                pass
+
+    def _drain_batch(self):
+        batch = []
+        while len(batch) < 50:
+            try:
+                batch.append(self.q.get_nowait())
+            except queue.Empty:
+                break
+        if not batch:
+            return
+        try:
+            post({"action": "events", "runId": self.run_id, "events": batch}, timeout=15)
+        except RevokedError:
+            os._exit(0)
+        except Exception:
+            # Fallback to single-event endpoint if talking to an older server
+            for ev in batch:
+                try:
+                    post({"action": "event", "runId": self.run_id, "event": ev}, timeout=10)
+                except Exception:
+                    pass
+
+    def _flush_loop(self):
+        while not self.closed.is_set() or not self.q.empty():
+            self._drain_batch()
+            if self.q.empty() and not self.closed.is_set():
+                self.closed.wait(0.15)
+
+    def close(self):
+        self.closed.set()
+        self.thread.join(timeout=10)
 
