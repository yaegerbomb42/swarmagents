+    await finishRun(id, token, runId);
+    resetRemoteRunManagerForTesting();
+    configureComputersStoreDir("");
+    configureComputersClock(undefined);
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+test("node events: rejects a missing runId and empty or oversized batches", async () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "swarm-node-events-"));
+  configureComputersStoreDir(dir);
+  configureComputersClock(() => 1_000_000);
+  resetRemoteRunManagerForTesting();
+  let id = "";
+  let token = "";
+  let runId = "";
+  try {
+    ({ id, token, runId } = await runningJob());
+    const valid = { type: "assistant.text", text: "hi" };
+
+    const noRunId = await nodeRequest(id, token, { action: "events", events: [valid] });
+    assert.equal(noRunId.status, 400);
+
+    const empty = await nodeRequest(id, token, { action: "events", runId, events: [] });
+    assert.equal(empty.status, 400);
+
+    const notArray = await nodeRequest(id, token, { action: "events", runId, events: { type: "assistant.text" } });
+    assert.equal(notArray.status, 400);
+
+    const oversized = await nodeRequest(id, token, {
+      action: "events",
+      runId,
+      events: Array.from({ length: 101 }, () => valid),
+    });
+    assert.equal(oversized.status, 400);
+
+    const boundary = await nodeRequest(id, token, {
+      action: "events",
+      runId,
+      events: Array.from({ length: 100 }, () => valid),
+    });
+    assert.equal(boundary.status, 200);
+    assert.deepEqual(await boundary.json(), { ok: true, accepted: 100 });
+  } finally {
+    await finishRun(id, token, runId);
+    resetRemoteRunManagerForTesting();
+    configureComputersStoreDir("");
+    configureComputersClock(undefined);
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+test("node events: stops at the first failing event and reports accepted so far", async () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "swarm-node-events-"));
+  configureComputersStoreDir(dir);
+  configureComputersClock(() => 1_000_000);
+  resetRemoteRunManagerForTesting();
+  let id = "";
+  let token = "";
+  let runId = "";
+  try {
+    ({ id, token, runId } = await runningJob());
+    // "run.finished" is a reserved event type, so safeEvent rejects it and
+    // publishEvent returns false mid-batch.
+    const res = await nodeRequest(id, token, {
+      action: "events",
+      runId,
+      events: [
+        { type: "assistant.text", text: "first" },
+        { type: "run.finished" },
+        { type: "assistant.text", text: "never reached" },
+      ],
+    });
+    assert.equal(res.status, 409);
+    const body = (await res.json()) as { error: string; accepted: number };
+    assert.equal(body.accepted, 1);
+    assert.match(body.error, /invalid event/);
+  } finally {
+    await finishRun(id, token, runId);
+    resetRemoteRunManagerForTesting();
+    configureComputersStoreDir("");
+    configureComputersClock(undefined);
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+test("node events: rejects a batch for an unknown or finished run", async () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "swarm-node-events-"));
+  configureComputersStoreDir(dir);
+  configureComputersClock(() => 1_000_000);
+  resetRemoteRunManagerForTesting();
+  let id = "";
+  let token = "";
+  let runId = "";
+  try {
+    ({ id, token, runId } = await runningJob());
+    const unknown = await nodeRequest(id, token, {
+      action: "events",
+      runId: "run_does_not_exist",
+      events: [{ type: "assistant.text", text: "hi" }],
+    });
+    assert.equal(unknown.status, 409);
+    assert.deepEqual(await unknown.json(), {
+      error: "Run is not running, not yours, or contains an invalid event.",
+      accepted: 0,
+    });
+
+    // After the run completes, further batches are rejected the same way.
+    const done = await nodeRequest(id, token, {
+      action: "complete",
+      runId,
+      result: { status: "finished", text: "done" },
+    });
+    assert.equal(done.status, 200);
+    const after = await nodeRequest(id, token, {
+      action: "events",
+      runId,
+      events: [{ type: "assistant.text", text: "late" }],
+    });
+    assert.equal(after.status, 409);
+    assert.equal(((await after.json()) as { accepted: number }).accepted, 0);
+  } finally {
+    await finishRun(id, token, runId);
+    resetRemoteRunManagerForTesting();
+    configureComputersStoreDir("");
+    configureComputersClock(undefined);
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+});
