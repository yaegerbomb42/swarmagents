+function nodeRequest(computerId: string, token: string, body: unknown) {
+  return POST(
+    request(
+      "/api/computers/node",
+      {
+        method: "POST",
+        body: JSON.stringify(body),
+        headers: { authorization: `Bearer ${token}`, "x-computer-id": computerId },
+      },
+      null,
+    ),
+  );
+}
+
+async function pair(): Promise<{ id: string; token: string }> {
+  const created = await pairingRoute(request("/api/computers", { method: "POST", body: "{}" }));
+  assert.equal(created.status, 200);
+  const pairing = (await created.json()) as { code: string };
+  const redeemed = await redeemRoute(
+    request(
+      "/api/computers/pair",
+      {
+        method: "POST",
+        body: JSON.stringify({
+          code: pairing.code,
+          machine: { name: "Test PC", os: "linux", arch: "x86_64", cpuCores: 4, memoryMb: 8192, mode: "host" },
+        }),
+      },
+      null,
+    ),
+  );
+  assert.equal(redeemed.status, 200);
+  const body = (await redeemed.json()) as { computer: { id: string }; nodeToken: string };
+  return { id: body.computer.id, token: body.nodeToken };
+}
+
+/** Best-effort: mark the run finished so no active run lingers in the
+ * shared SWARM_HOME state for later test files. A 409 (already finished)
+ * is fine. Must run BEFORE resetRemoteRunManagerForTesting(). */
+async function finishRun(id: string, token: string, runId: string): Promise<void> {
+  try {
+    await nodeRequest(id, token, { action: "complete", runId, result: { status: "finished", text: "done" } });
+  } catch {
+    // Run already gone — nothing to clean up.
+  }
+}
+
+/** Pair a computer, queue a BYOC run for it, and claim it so the job is running. */
+async function runningJob(): Promise<{ id: string; token: string; runId: string }> {
+  const paired = await pair();
+  const started = await startTaskRoute(
+    request("/api/runtime/tasks", {
+      method: "POST",
+      body: JSON.stringify({ prompt: "Run the suite", computeTarget: `computer:${paired.id}` }),
+    }),
+  );
+  assert.equal(started.status, 202);
+  const { runId } = (await started.json()) as { runId: string };
+  const claim = await nodeRequest(paired.id, paired.token, { action: "claim" });
+  assert.equal(claim.status, 200);
+  const claimed = (await claim.json()) as { job: { runId: string } | null };
+  assert.equal(claimed.job?.runId, runId);
+  return { ...paired, runId };
+}
