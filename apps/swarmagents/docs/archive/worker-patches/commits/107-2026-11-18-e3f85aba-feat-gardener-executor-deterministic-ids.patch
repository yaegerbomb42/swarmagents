diff --git a/apps/swarmagents/lib/gardener/runtime.ts b/apps/swarmagents/lib/gardener/runtime.ts
new file mode 100644
index 000000000..83bd35b23
--- /dev/null
+++ b/apps/swarmagents/lib/gardener/runtime.ts
@@ -0,0 +1,31 @@
+import { getRuntimeManager } from "../runtime/manager";
+import { telemetryBus } from "../telemetry/bus";
+import { GardenerExecutor, type GardenerExecutorDeps } from "./executor";
+
+const TERMINAL = new Set(["run.finished", "run.error", "run.cancelled"]);
+
+function productionDeps(): GardenerExecutorDeps {
+  const runtime = getRuntimeManager();
+  return {
+    ensureVm: async (userId) => {
+      await runtime.vmManager.ensure(userId);
+    },
+    startRun: (userId, input) => runtime.start(userId, input),
+    onTerminal: (runId, listener) =>
+      telemetryBus.subscribe(runId, 0, (event) => {
+        if (!TERMINAL.has(event.type)) return;
+        listener(event.type);
+      }),
+  };
+}
+
+let executor: GardenerExecutor | null = null;
+
+export function getGardenerExecutor(): GardenerExecutor {
+  if (!executor) executor = new GardenerExecutor(productionDeps());
+  return executor;
+}
+
+export function setGardenerExecutorForTesting(next: GardenerExecutor | null): void {
+  executor = next;
+}
