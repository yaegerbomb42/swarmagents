index 000000000..948db8329
--- /dev/null
+++ b/apps/swarmagents/lib/gardener/executor.ts
@@ -0,0 +1,135 @@
+import { readUserGardener, updateUserGardener } from "./store";
+import type { GardenerProposal } from "./types";
+
+export interface GardenerDispatchInput {
+  prompt: string;
+  roleId: string;
+  fullAuto: true;
+  toolAllowlist: readonly string[];
+  proposalId: string;
+}
+
+export interface GardenerExecutorDeps {
+  ensureVm: (userId: string) => Promise<void>;
+  startRun: (
+    userId: string,
+    input: GardenerDispatchInput,
+  ) => { accepted: boolean; runId: string; error?: string };
+  onTerminal?: (runId: string, listener: (status: string) => void) => () => void;
+  now?: () => number;
+}
+
+const KIND_ALLOWLISTS: Record<GardenerProposal["kind"], readonly string[]> = {
+  "unit-test": ["Read", "Write", "Edit", "Glob", "Grep", "Bash"],
+  pr: ["Read", "Write", "Edit", "Glob", "Grep", "Bash"],
+  "board-task": ["Read", "Write", "Edit", "Glob", "Grep", "Bash"],
+};
+
+function buildProposalPrompt(proposal: GardenerProposal): string {
+  switch (proposal.kind) {
+    case "unit-test":
+      return [
+        `Write comprehensive unit tests for \`${proposal.path}\` in \`${proposal.repoRoot}\`.`,
+        "Follow existing test framework conventions, run the test suite to verify everything passes, and summarize coverage improvements.",
+      ].join("\n");
+    case "pr":
+      return [
+        `Inspect hotspot \`${proposal.path}\` in \`${proposal.repoRoot}\` for bugs, edge cases, and maintainability issues.`,
+        "Apply focused, well-tested improvements and prepare a clean branch/PR summary.",
+      ].join("\n");
+    case "board-task":
+      return [
+        `Claim and complete Swarm Board task \`${proposal.taskId}\`: ${proposal.title}.`,
+        proposal.summary,
+      ].join("\n\n");
+  }
+}
+
+export class GardenerExecutor {
+  constructor(private readonly deps: GardenerExecutorDeps) {}
+
+  /** Idempotently approve and dispatch a proposal onto the user's VM. */
+  async approveAndRun(
+    userId: string,
+    proposalId: string,
+  ): Promise<{ ok: boolean; proposal?: GardenerProposal; error?: string }> {
+    const now = this.deps.now?.() ?? Date.now();
+    const existing = readUserGardener(userId).proposals.find((p) => p.id === proposalId);
+    if (!existing) return { ok: false, error: "Proposal not found." };
+    if (existing.status === "running" || existing.status === "completed") {
+      return { ok: true, proposal: existing };
+    }
+
+    let claimed: GardenerProposal | undefined;
+    updateUserGardener(userId, (state) => {
+      const row = state.proposals.find((p) => p.id === proposalId);
+      if (!row || row.status === "running" || row.status === "completed") return;
+      row.status = "running";
+      row.approvedAt = now;
+      row.error = undefined;
+      claimed = { ...row };
+    });
+
+    if (!claimed) {
+      const current = readUserGardener(userId).proposals.find((p) => p.id === proposalId);
+      return { ok: Boolean(current), proposal: current };
+    }
+
+    try {
+      await this.deps.ensureVm(userId);
+    } catch (err) {
+      const message = err instanceof Error ? err.message : String(err);
+      const updated = updateUserGardener(userId, (state) => {
+        const row = state.proposals.find((p) => p.id === proposalId);
+        if (row) {
+          row.status = "failed";
+          row.error = message;
+        }
+      });
+      return { ok: false, proposal: updated.proposals.find((p) => p.id === proposalId), error: message };
+    }
+
+    const started = this.deps.startRun(userId, {
+      prompt: buildProposalPrompt(claimed),
+      roleId: "main",
+      fullAuto: true,
+      toolAllowlist: KIND_ALLOWLISTS[claimed.kind],
+      proposalId: claimed.id,
+    });
+
+    if (!started.accepted) {
+      const errMsg = started.error ?? "Run rejected by runtime.";
+      const updated = updateUserGardener(userId, (state) => {
+        const row = state.proposals.find((p) => p.id === proposalId);
+        if (row) {
+          row.status = "failed";
+          row.error = errMsg;
+        }
+      });
+      return { ok: false, proposal: updated.proposals.find((p) => p.id === proposalId), error: errMsg };
+    }
+
+    const updated = updateUserGardener(userId, (state) => {
+      const row = state.proposals.find((p) => p.id === proposalId);
+      if (row) row.executedRunId = started.runId;
+    });
+
+    if (this.deps.onTerminal) {
+      const unsub = this.deps.onTerminal(started.runId, (status) => {
+        unsub();
+        updateUserGardener(userId, (state) => {
+          const row = state.proposals.find((p) => p.id === proposalId);
+          if (!row || row.executedRunId !== started.runId) return;
+          if (status === "run.finished") {
+            row.status = "completed";
+          } else {
+            row.status = "failed";
+            row.error = `Run ended with ${status}`;
+          }
+        });
+      });
+    }
+
+    return { ok: true, proposal: updated.proposals.find((p) => p.id === proposalId) };
+  }
+}
