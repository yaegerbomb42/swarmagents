@@ -0,0 +1,319 @@
+/**
+ * Tests for the shared JSON-RPC 2.0 / MCP (2024-11-05) transport
+ * (lib/mcp/transport): single requests, batch arrays, notifications,
+ * initialize/ping/tools/resources, error codes, and HTTP mapping.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import { NextRequest } from "next/server";
+import { handleMcpPost, type McpServerAdapter } from "./transport";
+
+function post(body: unknown, rawBody?: string): NextRequest {
+  return new NextRequest("http://localhost/api/mcp/test", {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: rawBody ?? JSON.stringify(body),
+  });
+}
+
+const echoAdapter: McpServerAdapter = {
+  name: "test-server",
+  version: "1.0.0",
+  tools: [{ name: "echo", description: "Echo the arguments.", inputSchema: { type: "object" } }],
+  async callTool(name, args) {
+    if (name === "echo") {
+      return { result: { content: [{ type: "text", text: JSON.stringify(args) }] } };
+    }
+    if (name === "boom") {
+      return { error: { code: -32000, message: "boom" } };
+    }
+    if (name === "unavailable") {
+      return {
+        error: { code: -32001, message: "Board storage is temporarily unavailable. Retry shortly.", data: { retryable: true } },
+        httpStatus: 503,
+      };
+    }
+    return { error: { code: -32601, message: `Unknown tool: ${name}` } };
+  },
+};
+
+const resourceAdapter: McpServerAdapter = {
+  ...echoAdapter,
+  async listResources() {
+    return [{ uri: "test://hello", name: "hello", mimeType: "text/plain" }];
+  },
+  async readResource(uri) {
+    if (uri === "test://hello") {
+      return { uri, mimeType: "text/plain", text: "hello" };
+    }
+    return null;
+  },
+};
+
+test("initialize answers with protocol 2024-11-05 and serverInfo", async () => {
+  const res = await handleMcpPost(
+    post({ jsonrpc: "2.0", id: 1, method: "initialize" }),
+    echoAdapter,
+  );
+  assert.equal(res.status, 200);
+  assert.equal(res.headers.get("cache-control"), "no-store");
+  const body = (await res.json()) as {
+    result: { protocolVersion: string; capabilities: { tools: unknown }; serverInfo: { name: string; version: string } };
+  };
+  assert.equal(body.result.protocolVersion, "2024-11-05");
+  assert.equal(body.result.serverInfo.name, "test-server");
+  assert.equal(body.result.serverInfo.version, "1.0.0");
+  assert.deepEqual(body.result.capabilities.tools, {});
+});
+
+test("initialize advertises resources capability only when the adapter has them", async () => {
+  const without = await handleMcpPost(post({ jsonrpc: "2.0", id: 1, method: "initialize" }), echoAdapter);
+  const withoutBody = (await without.json()) as { result: { capabilities: Record<string, unknown> } };
+  assert.equal("resources" in withoutBody.result.capabilities, false);
+
+  const withRes = await handleMcpPost(post({ jsonrpc: "2.0", id: 1, method: "initialize" }), resourceAdapter);
+  const withBody = (await withRes.json()) as { result: { capabilities: Record<string, unknown> } };
+  assert.deepEqual(withBody.result.capabilities.resources, {});
+});
+
+test("ping answers with an empty result", async () => {
+  const res = await handleMcpPost(post({ jsonrpc: "2.0", id: 2, method: "ping" }), echoAdapter);
+  assert.equal(res.status, 200);
+  assert.deepEqual(await res.json(), { jsonrpc: "2.0", id: 2, result: {} });
+});
+
+test("tools/list returns the adapter tools", async () => {
+  const res = await handleMcpPost(post({ jsonrpc: "2.0", id: 3, method: "tools/list" }), echoAdapter);
+  const body = (await res.json()) as { result: { tools: Array<{ name: string }> } };
+  assert.deepEqual(body.result.tools.map((t) => t.name), ["echo"]);
+});
+
+test("tools/call dispatches and returns the tool result", async () => {
+  const res = await handleMcpPost(
+    post({ jsonrpc: "2.0", id: 4, method: "tools/call", params: { name: "echo", arguments: { a: 1 } } }),
+    echoAdapter,
+  );
+  assert.equal(res.status, 200);
+  const body = (await res.json()) as { result: { content: Array<{ text: string }> } };
+  assert.deepEqual(JSON.parse(body.result.content[0].text), { a: 1 });
+});
+
+test("tools/call surfaces a tool error with its code", async () => {
+  const res = await handleMcpPost(
+    post({ jsonrpc: "2.0", id: 5, method: "tools/call", params: { name: "boom", arguments: {} } }),
+    echoAdapter,
+  );
+  const body = (await res.json()) as { error: { code: number; message: string } };
+  assert.equal(body.error.code, -32000);
+  assert.equal(body.error.message, "boom");
+});
+
+test("tools/call with an unknown tool returns -32601", async () => {
+  const res = await handleMcpPost(
+    post({ jsonrpc: "2.0", id: 6, method: "tools/call", params: { name: "nope", arguments: {} } }),
+    echoAdapter,
+  );
+  const body = (await res.json()) as { error: { code: number } };
+  assert.equal(body.error.code, -32601);
+});
+
+test("tools/call with a missing name returns -32602", async () => {
+  const res = await handleMcpPost(
+    post({ jsonrpc: "2.0", id: 7, method: "tools/call", params: { arguments: {} } }),
+    echoAdapter,
+  );
+  const body = (await res.json()) as { error: { code: number } };
+  assert.equal(body.error.code, -32602);
+});
+
+test("tools/call with non-object arguments returns -32602", async () => {
+  const res = await handleMcpPost(
+    post({ jsonrpc: "2.0", id: 8, method: "tools/call", params: { name: "echo", arguments: [1, 2] } }),
+    echoAdapter,
+  );
+  const body = (await res.json()) as { error: { code: number; message: string } };
+  assert.equal(body.error.code, -32602);
+  assert.match(body.error.message, /arguments must be an object/);
+});
+
+test("non-object params returns -32602", async () => {
+  const res = await handleMcpPost(
+    post({ jsonrpc: "2.0", id: 9, method: "tools/call", params: [1, 2] }),
+    echoAdapter,
+  );
+  const body = (await res.json()) as { error: { code: number } };
+  assert.equal(body.error.code, -32602);
+});
+
+test("notifications/initialized without id returns 202 with no body", async () => {
+  const res = await handleMcpPost(
+    post({ jsonrpc: "2.0", method: "notifications/initialized" }),
+    echoAdapter,
+  );
+  assert.equal(res.status, 202);
+  assert.equal(await res.text(), "");
+});
+
+test("notifications/cancelled without id returns 202 with no body", async () => {
+  const res = await handleMcpPost(
+    post({ jsonrpc: "2.0", method: "notifications/cancelled" }),
+    echoAdapter,
+  );
+  assert.equal(res.status, 202);
+});
+
+test("an unknown method without id is also a notification (202, no body)", async () => {
+  const res = await handleMcpPost(
+    post({ jsonrpc: "2.0", method: "notifications/unknown" }),
+    echoAdapter,
+  );
+  assert.equal(res.status, 202);
+});
+
+test("an unknown method with id returns -32601", async () => {
+  const res = await handleMcpPost(
+    post({ jsonrpc: "2.0", id: 10, method: "resources/subscribe" }),
+    echoAdapter,
+  );
+  const body = (await res.json()) as { error: { code: number; message: string } };
+  assert.equal(body.error.code, -32601);
+  assert.match(body.error.message, /Method not found/);
+});
+
+test("a wrong jsonrpc version returns -32600", async () => {
+  const res = await handleMcpPost(
+    post({ jsonrpc: "1.0", id: 11, method: "tools/list" }),
+    echoAdapter,
+  );
+  const body = (await res.json()) as { error: { code: number } };
+  assert.equal(body.error.code, -32600);
+});
+
+test("a JSON null body returns -32600", async () => {
+  const res = await handleMcpPost(post(null, "null"), echoAdapter);
+  assert.equal(res.status, 200);
+  const body = (await res.json()) as { error: { code: number; message: string } };
+  assert.equal(body.error.code, -32600);
+  assert.match(body.error.message, /Invalid Request/);
+});
+
+test("an invalid id type returns -32600", async () => {
+  const res = await handleMcpPost(
+    post({ jsonrpc: "2.0", id: { bad: true }, method: "ping" }),
+    echoAdapter,
+  );
+  const body = (await res.json()) as { error: { code: number } };
+  assert.equal(body.error.code, -32600);
+});
+
+test("unparseable JSON returns -32700 with HTTP 400", async () => {
+  const res = await handleMcpPost(post(null, "{not json"), echoAdapter);
+  assert.equal(res.status, 400);
+  const body = (await res.json()) as { error: { code: number } };
+  assert.equal(body.error.code, -32700);
+});
+
+test("an oversized body returns -32602 with HTTP 413", async () => {
+  const big = JSON.stringify({ jsonrpc: "2.0", id: 1, method: "ping", pad: "x".repeat(300 * 1024) });
+  const res = await handleMcpPost(post(null, big), echoAdapter);
+  assert.equal(res.status, 413);
+  const body = (await res.json()) as { error: { code: number } };
+  assert.equal(body.error.code, -32602);
+});
+
+test("a batch of two calls returns an array of two packets", async () => {
+  const res = await handleMcpPost(
+    post([
+      { jsonrpc: "2.0", id: 1, method: "ping" },
+      { jsonrpc: "2.0", id: 2, method: "tools/list" },
+    ]),
+    echoAdapter,
+  );
+  assert.equal(res.status, 200);
+  const body = (await res.json()) as Array<{ id: number; result?: unknown; error?: unknown }>;
+  assert.equal(body.length, 2);
+  assert.deepEqual(body.map((p) => p.id), [1, 2]);
+});
+
+test("a batch of only notifications returns 202 with no body", async () => {
+  const res = await handleMcpPost(
+    post([{ jsonrpc: "2.0", method: "notifications/initialized" }]),
+    echoAdapter,
+  );
+  assert.equal(res.status, 202);
+  assert.equal(await res.text(), "");
+});
+
+test("an empty batch returns -32600 with HTTP 400", async () => {
+  const res = await handleMcpPost(post([]), echoAdapter);
+  assert.equal(res.status, 400);
+  const body = (await res.json()) as { error: { code: number } };
+  assert.equal(body.error.code, -32600);
+});
+
+test("a batch larger than 20 returns -32600 with HTTP 400", async () => {
+  const batch = Array.from({ length: 21 }, (_, i) => ({ jsonrpc: "2.0", id: i, method: "ping" }));
+  const res = await handleMcpPost(post(batch), echoAdapter);
+  assert.equal(res.status, 400);
+  const body = (await res.json()) as { error: { code: number } };
+  assert.equal(body.error.code, -32600);
+});
+
+test("resources/list returns the adapter resources", async () => {
+  const res = await handleMcpPost(
+    post({ jsonrpc: "2.0", id: 20, method: "resources/list" }),
+    resourceAdapter,
+  );
+  const body = (await res.json()) as { result: { resources: Array<{ uri: string }> } };
+  assert.deepEqual(body.result.resources.map((r) => r.uri), ["test://hello"]);
+});
+
+test("resources/list without a resources adapter returns -32601", async () => {
+  const res = await handleMcpPost(
+    post({ jsonrpc: "2.0", id: 21, method: "resources/list" }),
+    echoAdapter,
+  );
+  const body = (await res.json()) as { error: { code: number } };
+  assert.equal(body.error.code, -32601);
+});
+
+test("resources/read returns the resource contents", async () => {
+  const res = await handleMcpPost(
+    post({ jsonrpc: "2.0", id: 22, method: "resources/read", params: { uri: "test://hello" } }),
+    resourceAdapter,
+  );
+  const body = (await res.json()) as { result: { contents: Array<{ text: string }> } };
+  assert.equal(body.result.contents[0].text, "hello");
+});
+
+test("resources/read of an unknown uri returns -32002", async () => {
+  const res = await handleMcpPost(
+    post({ jsonrpc: "2.0", id: 23, method: "resources/read", params: { uri: "test://missing" } }),
+    resourceAdapter,
+  );
+  const body = (await res.json()) as { error: { code: number } };
+  assert.equal(body.error.code, -32002);
+});
+
+test("resources/read without a uri returns -32602", async () => {
+  const res = await handleMcpPost(
+    post({ jsonrpc: "2.0", id: 24, method: "resources/read", params: {} }),
+    resourceAdapter,
+  );
+  const body = (await res.json()) as { error: { code: number } };
+  assert.equal(body.error.code, -32602);
+});
+
+test("a tool error with httpStatus 503 maps to HTTP 503 + Retry-After", async () => {
+  const res = await handleMcpPost(
+    post({ jsonrpc: "2.0", id: 25, method: "tools/call", params: { name: "unavailable", arguments: {} } }),
+    echoAdapter,
+  );
+  assert.equal(res.status, 503);
+  assert.equal(res.headers.get("retry-after"), "2");
+  const body = (await res.json()) as { error: { code: number; data?: { retryable?: boolean } }; id: number };
+  assert.equal(body.error.code, -32001);
+  assert.equal(body.error.data?.retryable, true);
+  assert.equal(body.id, 25);
+});
diff --git a/apps/swarmagents/lib/mcp/transport.ts b/apps/swarmagents/lib/mcp/transport.ts
new file mode 100644
index 000000000..0bee9b6fb
--- /dev/null
+++ b/apps/swarmagents/lib/mcp/transport.ts
@@ -0,0 +1,211 @@
+/**
+ * Shared JSON-RPC 2.0 / MCP (2024-11-05) transport layer.
+ *
+ * Supports:
+ *   - Single requests and JSON-RPC batch arrays (bounded to 20 calls)
+ *   - JSON-RPC notifications (requests without `id`, e.g. `notifications/initialized`) -> 202 Accepted
+ *   - `initialize`, `ping`, `tools/list`, `tools/call`, `resources/list`, `resources/read`
+ */
+
+import { NextResponse, type NextRequest } from "next/server";
+
+const MAX_BODY_BYTES = 256 * 1024;
+const MAX_BATCH_SIZE = 20;
+const NO_STORE = { "cache-control": "no-store" } as const;
+
+export interface McpResourceDescriptor {
+  uri: string;
+  name: string;
+  description?: string;
+  mimeType?: string;
+}
+
+export interface McpResourceContent {
+  uri: string;
+  mimeType?: string;
+  text: string;
+}
+
+export interface McpServerAdapter {
+  name: string;
+  version: string;
+  tools: readonly unknown[];
+  callTool(name: string, args: Record<string, unknown>): Promise<
+    | { result: { content: Array<{ type: "text"; text: string }>; isError?: boolean } }
+    | { error: { code: number; message: string; data?: unknown }; httpStatus?: number }
+  >;
+  listResources?(): Promise<McpResourceDescriptor[]>;
+  readResource?(uri: string): Promise<McpResourceContent | null>;
+}
+
+interface JsonRpcPacket {
+  jsonrpc: "2.0";
+  id?: string | number | null;
+  result?: unknown;
+  error?: { code: number; message: string; data?: unknown };
+}
+
+function isPlainObject(v: unknown): v is Record<string, unknown> {
+  return typeof v === "object" && v !== null && !Array.isArray(v);
+}
+
+function isValidId(id: unknown): id is string | number | null {
+  return id === null || typeof id === "string" || (typeof id === "number" && Number.isFinite(id));
+}
+
+async function dispatchSingle(
+  raw: unknown,
+  adapter: McpServerAdapter,
+): Promise<{ packet: JsonRpcPacket | null; httpStatus?: number }> {
+  if (!isPlainObject(raw)) {
+    return { packet: { jsonrpc: "2.0", id: null, error: { code: -32600, message: "Invalid Request" } } };
+  }
+
+  const hasId = "id" in raw && raw.id !== undefined;
+  let id: string | number | null = null;
+  if (hasId) {
+    if (!isValidId(raw.id)) {
+      return { packet: { jsonrpc: "2.0", id: null, error: { code: -32600, message: "Invalid Request id" } } };
+    }
+    id = raw.id;
+  }
+
+  if (raw.jsonrpc !== "2.0" || typeof raw.method !== "string" || !raw.method) {
+    return { packet: { jsonrpc: "2.0", id: isValidId(id) ? id : null, error: { code: -32600, message: "Invalid Request" } } };
+  }
+
+  const method = raw.method;
+  const params = raw.params;
+  if (params !== undefined && !isPlainObject(params)) {
+    return { packet: { jsonrpc: "2.0", id, error: { code: -32602, message: "Invalid params: must be an object" } } };
+  }
+
+  // JSON-RPC notifications carry no `id` and expect no JSON-RPC response body.
+  if (!hasId) {
+    if (method === "notifications/initialized" || method === "notifications/cancelled") {
+      return { packet: null };
+    }
+    return { packet: null };
+  }
+
+  if (method === "initialize") {
+    return {
+      packet: {
+        jsonrpc: "2.0",
+        id,
+        result: {
+          protocolVersion: "2024-11-05",
+          capabilities: {
+            tools: {},
+            ...(adapter.listResources ? { resources: {} } : {}),
+          },
+          serverInfo: { name: adapter.name, version: adapter.version },
+        },
+      },
+    };
+  }
+
+  if (method === "ping") {
+    return { packet: { jsonrpc: "2.0", id, result: {} } };
+  }
+
+  if (method === "tools/list") {
+    return { packet: { jsonrpc: "2.0", id, result: { tools: adapter.tools } } };
+  }
+
+  if (method === "tools/call") {
+    const name = typeof params?.name === "string" ? params.name : "";
+    if (!name) {
+      return { packet: { jsonrpc: "2.0", id, error: { code: -32602, message: "Tool name is required" } } };
+    }
+    const args = params?.arguments;
+    if (args !== undefined && !isPlainObject(args)) {
+      return { packet: { jsonrpc: "2.0", id, error: { code: -32602, message: "Tool arguments must be an object" } } };
+    }
+    const outcome = await adapter.callTool(name, args ?? {});
+    if ("error" in outcome) {
+      return {
+        packet: { jsonrpc: "2.0", id, error: outcome.error },
+        ...(outcome.httpStatus ? { httpStatus: outcome.httpStatus } : {}),
+      };
+    }
+    return { packet: { jsonrpc: "2.0", id, result: outcome.result } };
+  }
+
+  if (method === "resources/list" && adapter.listResources) {
+    const resources = await adapter.listResources();
+    return { packet: { jsonrpc: "2.0", id, result: { resources } } };
+  }
+
+  if (method === "resources/read" && adapter.readResource) {
+    const uri = typeof params?.uri === "string" ? params.uri : "";
+    if (!uri) {
+      return { packet: { jsonrpc: "2.0", id, error: { code: -32602, message: "Resource uri is required" } } };
+    }
+    const content = await adapter.readResource(uri);
+    if (!content) {
+      return { packet: { jsonrpc: "2.0", id, error: { code: -32002, message: `Resource not found: ${uri}` } } };
+    }
+    return { packet: { jsonrpc: "2.0", id, result: { contents: [content] } } };
+  }
+
+  return { packet: { jsonrpc: "2.0", id, error: { code: -32601, message: `Method not found: ${method}` } } };
+}
+
+export async function handleMcpPost(req: NextRequest, adapter: McpServerAdapter): Promise<NextResponse> {
+  let text: string;
+  try {
+    text = await req.text();
+  } catch {
+    return NextResponse.json(
+      { jsonrpc: "2.0", id: null, error: { code: -32700, message: "Parse error" } },
+      { status: 400, headers: NO_STORE },
+    );
+  }
+  if (text.length > MAX_BODY_BYTES) {
+    return NextResponse.json(
+      { jsonrpc: "2.0", id: null, error: { code: -32602, message: "Request body too large" } },
+      { status: 413, headers: NO_STORE },
+    );
+  }
+
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(text);
+  } catch {
+    return NextResponse.json(
+      { jsonrpc: "2.0", id: null, error: { code: -32700, message: "Parse error" } },
+      { status: 400, headers: NO_STORE },
+    );
+  }
+
+  if (Array.isArray(parsed)) {
+    if (parsed.length === 0 || parsed.length > MAX_BATCH_SIZE) {
+      return NextResponse.json(
+        { jsonrpc: "2.0", id: null, error: { code: -32600, message: "Invalid batch size" } },
+        { status: 400, headers: NO_STORE },
+      );
+    }
+    const responses: JsonRpcPacket[] = [];
+    for (const item of parsed) {
+      const { packet } = await dispatchSingle(item, adapter);
+      if (packet) responses.push(packet);
+    }
+    if (responses.length === 0) {
+      return new NextResponse(null, { status: 202, headers: NO_STORE });
+    }
+    return NextResponse.json(responses, { status: 200, headers: NO_STORE });
+  }
+
+  const { packet, httpStatus } = await dispatchSingle(parsed, adapter);
+  if (!packet) {
+    return new NextResponse(null, { status: 202, headers: NO_STORE });
+  }
+  return NextResponse.json(packet, {
+    status: httpStatus ?? 200,
+    headers: {
+      ...NO_STORE,
+      ...(httpStatus === 503 ? { "Retry-After": "2" } : {}),
+    },
+  });
+}
