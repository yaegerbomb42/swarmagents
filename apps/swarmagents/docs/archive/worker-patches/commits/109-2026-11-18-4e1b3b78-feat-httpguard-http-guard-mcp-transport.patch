diff --git a/apps/swarmagents/lib/http-guard.test.ts b/apps/swarmagents/lib/http-guard.test.ts
new file mode 100644
index 000000000..24bf022d8
--- /dev/null
+++ b/apps/swarmagents/lib/http-guard.test.ts
@@ -0,0 +1,230 @@
+/**
+ * Tests for the composable route guard (lib/http-guard): caller extraction,
+ * auth, per-user rate limiting before body parsing, bounded JSON bodies,
+ * and automatic Cache-Control: no-store.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import { NextRequest, NextResponse } from "next/server";
+import { USER_HEADER } from "./auth";
+import { TokenBucket } from "./rate-limit";
+import {
+  extractCaller,
+  jsonNoStore,
+  RouteValidationError,
+  withRouteGuard,
+} from "./http-guard";
+
+function request(
+  body?: string,
+  headers: Record<string, string> = {},
+): NextRequest {
+  return new NextRequest("http://localhost/api/test", {
+    method: "POST",
+    headers: { "content-type": "application/json", ...headers },
+    body,
+  });
+}
+
+function authed(body?: string): NextRequest {
+  return request(body, { [USER_HEADER]: "local_alice@example.com" });
+}
+
+test("extractCaller returns the x-swarm-user header value", () => {
+  assert.equal(extractCaller(authed()), "local_alice@example.com");
+  assert.equal(extractCaller(request()), null);
+  assert.equal(extractCaller(request(undefined, { [USER_HEADER]: "" })), null);
+  assert.equal(extractCaller(request(undefined, { [USER_HEADER]: "x".repeat(129) })), null);
+  assert.equal(extractCaller(request(undefined, { [USER_HEADER]: "x".repeat(128) })), "x".repeat(128));
+});
+
+test("jsonNoStore sets Cache-Control: no-store and the given status", async () => {
+  const res = jsonNoStore({ ok: true }, 201);
+  assert.equal(res.status, 201);
+  assert.equal(res.headers.get("cache-control"), "no-store");
+  assert.deepEqual(await res.json(), { ok: true });
+});
+
+test("guard rejects an unauthenticated caller with 401 + no-store", async () => {
+  const handler = withRouteGuard({}, async () => NextResponse.json({ ok: true }));
+  const res = await handler(request(JSON.stringify({})), {});
+  assert.equal(res.status, 401);
+  assert.equal(res.headers.get("cache-control"), "no-store");
+  assert.deepEqual(await res.json(), { error: "Sign in required." });
+});
+
+test("guard passes an authenticated caller through with user + parsed body", async () => {
+  const seen: Array<{ user: string; body: unknown }> = [];
+  const handler = withRouteGuard<{ n: number }>(
+    { json: {} },
+    async ({ user, body }) => {
+      seen.push({ user, body });
+      return NextResponse.json({ ok: true });
+    },
+  );
+  const res = await handler(authed(JSON.stringify({ n: 3 })), {});
+  assert.equal(res.status, 200);
+  assert.equal(res.headers.get("cache-control"), "no-store");
+  assert.deepEqual(seen, [{ user: "local_alice@example.com", body: { n: 3 } }]);
+});
+
+test("guard with auth: false does not require a caller", async () => {
+  const handler = withRouteGuard({ auth: false }, async ({ user }) => NextResponse.json({ user }));
+  const res = await handler(request(JSON.stringify({})), {});
+  assert.equal(res.status, 200);
+  assert.deepEqual(await res.json(), { user: "" });
+});
+
+test("guard rate-limits before body parsing (second request is 429 even with a bad body)", async () => {
+  const bucket = new TokenBucket(1, 60_000);
+  const handler = withRouteGuard(
+    { rateLimit: { bucket, keyPrefix: "test" }, json: {} },
+    async () => NextResponse.json({ ok: true }),
+  );
+  const first = await handler(authed(JSON.stringify({})), {});
+  assert.equal(first.status, 200);
+
+  // The bucket is exhausted; even a malformed body must hit the rate limit
+  // first (429), not the body parser (400).
+  const second = await handler(authed("{not json"), {});
+  assert.equal(second.status, 429);
+  assert.equal(second.headers.get("retry-after"), "60");
+  assert.equal(second.headers.get("cache-control"), "no-store");
+  assert.deepEqual(await second.json(), { error: "Too many requests - try again shortly." });
+});
+
+test("guard rate-limits per user (different users get separate budgets)", async () => {
+  const bucket = new TokenBucket(1, 60_000);
+  const handler = withRouteGuard(
+    { rateLimit: { bucket, keyPrefix: "test" } },
+    async () => NextResponse.json({ ok: true }),
+  );
+  assert.equal((await handler(authed(), {})).status, 200);
+  const other = request(undefined, { [USER_HEADER]: "local_bob@example.com" });
+  assert.equal((await handler(other, {})).status, 200);
+});
+
+test("guard rejects an oversized body with 413", async () => {
+  const handler = withRouteGuard(
+    { json: { maxBytes: 10 } },
+    async () => NextResponse.json({ ok: true }),
+  );
+  const res = await handler(authed(JSON.stringify({ pad: "x".repeat(100) })), {});
+  assert.equal(res.status, 413);
+  assert.deepEqual(await res.json(), { error: "Request body too large." });
+});
+
+test("guard rejects invalid JSON with 400", async () => {
+  const handler = withRouteGuard({ json: {} }, async () => NextResponse.json({ ok: true }));
+  const res = await handler(authed("{not json"), {});
+  assert.equal(res.status, 400);
+  assert.deepEqual(await res.json(), { error: "Invalid JSON body." });
+});
+
+test("guard rejects an empty body when json is not optional", async () => {
+  const handler = withRouteGuard({ json: {} }, async () => NextResponse.json({ ok: true }));
+  const res = await handler(authed(""), {});
+  assert.equal(res.status, 400);
+  assert.deepEqual(await res.json(), { error: "Request body is required." });
+});
+
+test("guard accepts an empty body when json is optional (body becomes {})", async () => {
+  const seen: unknown[] = [];
+  const handler = withRouteGuard(
+    { json: { optional: true } },
+    async ({ body }) => {
+      seen.push(body);
+      return NextResponse.json({ ok: true });
+    },
+  );
+  const res = await handler(authed(""), {});
+  assert.equal(res.status, 200);
+  assert.deepEqual(seen, [{}]);
+});
+
+test("guard validate callback transforms the body and rejects bad payloads", async () => {
+  const handler = withRouteGuard<{ id: string }>(
+    {
+      json: {
+        validate: (raw) => {
+          if (typeof raw !== "object" || raw === null || Array.isArray(raw)) {
+            throw new RouteValidationError("Body must be a JSON object.");
+          }
+          const id = (raw as { id?: unknown }).id;
+          if (typeof id !== "string" || !id) {
+            throw new RouteValidationError("id is required.", 422);
+          }
+          return { id };
+        },
+      },
+    },
+    async ({ body }) => NextResponse.json({ id: body.id }),
+  );
+
+  const ok = await handler(authed(JSON.stringify({ id: "abc", extra: 1 })), {});
+  assert.equal(ok.status, 200);
+  assert.deepEqual(await ok.json(), { id: "abc" });
+
+  const bad = await handler(authed(JSON.stringify({})), {});
+  assert.equal(bad.status, 422);
+  assert.deepEqual(await bad.json(), { error: "id is required." });
+
+  const notObject = await handler(authed(JSON.stringify([1, 2])), {});
+  assert.equal(notObject.status, 400);
+  assert.deepEqual(await notObject.json(), { error: "Body must be a JSON object." });
+});
+
+test("guard maps a non-RouteValidationError from validate to 400", async () => {
+  const handler = withRouteGuard(
+    {
+      json: {
+        validate: () => {
+          throw new Error("boom");
+        },
+      },
+    },
+    async () => NextResponse.json({ ok: true }),
+  );
+  const res = await handler(authed(JSON.stringify({})), {});
+  assert.equal(res.status, 400);
+  assert.deepEqual(await res.json(), { error: "Invalid request payload." });
+});
+
+test("guard adds no-store to a handler response that lacks cache-control", async () => {
+  const handler = withRouteGuard({}, async () => new Response("hello", { status: 200 }));
+  const res = await handler(authed(), {});
+  assert.equal(res.headers.get("cache-control"), "no-store");
+  assert.equal(await res.text(), "hello");
+});
+
+test("guard keeps a handler response's own cache-control header", async () => {
+  const handler = withRouteGuard(
+    {},
+    async () => new Response("hello", { headers: { "cache-control": "public, max-age=60" } }),
+  );
+  const res = await handler(authed(), {});
+  assert.equal(res.headers.get("cache-control"), "public, max-age=60");
+});
+
+test("guard maps a RouteValidationError thrown by the handler to its status", async () => {
+  const handler = withRouteGuard({}, async () => {
+    throw new RouteValidationError("Nope.", 403);
+  });
+  const res = await handler(authed(), {});
+  assert.equal(res.status, 403);
+  assert.deepEqual(await res.json(), { error: "Nope." });
+});
+
+test("guard rethrows a non-validation error from the handler", async () => {
+  const handler = withRouteGuard({}, async () => {
+    throw new Error("boom");
+  });
+  await assert.rejects(handler(authed(), {}), /boom/);
+});
+
+test("RouteValidationError defaults to status 400", () => {
+  const err = new RouteValidationError("bad");
+  assert.equal(err.status, 400);
+  assert.equal(err.name, "RouteValidationError");
+});
diff --git a/apps/swarmagents/lib/http-guard.ts b/apps/swarmagents/lib/http-guard.ts
new file mode 100644
index 000000000..9d9219b01
--- /dev/null
+++ b/apps/swarmagents/lib/http-guard.ts
@@ -0,0 +1,135 @@
+/**
+ * Composable Next.js App Router guard enforcing:
+ *   1. Verified caller extraction (`x-swarm-user`)
+ *   2. Per-user TokenBucket rate limiting (before any I/O or VM calls)
+ *   3. Bounded JSON body parsing with structured 400/413 responses
+ *   4. Automatic `Cache-Control: no-store` on all responses
+ */
+
+import { NextResponse, type NextRequest } from "next/server";
+import { USER_HEADER } from "./auth";
+import { TokenBucket } from "./rate-limit";
+
+export const NO_STORE_HEADERS = { "cache-control": "no-store" } as const;
+
+export interface GuardContext<TBody = unknown> {
+  req: NextRequest;
+  user: string;
+  body: TBody;
+}
+
+export interface RouteGuardOptions<TBody = unknown> {
+  /** Require a verified `x-swarm-user` header (default: true). */
+  auth?: boolean;
+  /** Optional dedicated per-user TokenBucket checked prior to body parsing or I/O. */
+  rateLimit?: {
+    bucket: TokenBucket;
+    keyPrefix: string;
+    message?: string;
+  };
+  /** Parse and bound JSON request body when present. */
+  json?: {
+    maxBytes?: number;
+    optional?: boolean;
+    validate?: (raw: unknown) => TBody;
+  };
+}
+
+export class RouteValidationError extends Error {
+  readonly status: number;
+  constructor(message: string, status = 400) {
+    super(message);
+    this.name = "RouteValidationError";
+    this.status = status;
+  }
+}
+
+export function extractCaller(req: NextRequest): string | null {
+  const user = req.headers.get(USER_HEADER);
+  return user && user.length > 0 && user.length <= 128 ? user : null;
+}
+
+export function jsonNoStore(payload: unknown, status = 200, extraHeaders?: Record<string, string>): NextResponse {
+  return NextResponse.json(payload, {
+    status,
+    headers: { ...NO_STORE_HEADERS, ...extraHeaders },
+  });
+}
+
+export function withRouteGuard<TBody = unknown, TRouteCtx = unknown>(
+  options: RouteGuardOptions<TBody>,
+  handler: (ctx: GuardContext<TBody>, routeCtx: TRouteCtx) => Promise<Response> | Response,
+) {
+  const requireAuth = options.auth !== false;
+  const maxBytes = options.json?.maxBytes ?? 64 * 1024;
+
+  return async (req: NextRequest, routeCtx: TRouteCtx): Promise<Response> => {
+    const user = extractCaller(req);
+    if (requireAuth && !user) {
+      return jsonNoStore({ error: "Sign in required." }, 401);
+    }
+
+    if (options.rateLimit) {
+      const identity = user ?? req.headers.get("x-real-ip") ?? "anonymous";
+      const result = options.rateLimit.bucket.consume(`${options.rateLimit.keyPrefix}:${identity}`);
+      if (!result.allowed) {
+        return jsonNoStore(
+          { error: options.rateLimit.message ?? "Too many requests - try again shortly." },
+          429,
+          { "Retry-After": String(result.retryAfter) },
+        );
+      }
+    }
+
+    let parsedBody = undefined as TBody;
+    if (options.json) {
+      let text: string;
+      try {
+        text = await req.text();
+      } catch {
+        return jsonNoStore({ error: "Could not read request body." }, 400);
+      }
+      if (text.length > maxBytes) {
+        return jsonNoStore({ error: "Request body too large." }, 413);
+      }
+      if (!text.trim()) {
+        if (!options.json.optional) {
+          return jsonNoStore({ error: "Request body is required." }, 400);
+        }
+        parsedBody = {} as TBody;
+      } else {
+        let raw: unknown;
+        try {
+          raw = JSON.parse(text);
+        } catch {
+          return jsonNoStore({ error: "Invalid JSON body." }, 400);
+        }
+        if (options.json.validate) {
+          try {
+            parsedBody = options.json.validate(raw);
+          } catch (err) {
+            if (err instanceof RouteValidationError) {
+              return jsonNoStore({ error: err.message }, err.status);
+            }
+            return jsonNoStore({ error: "Invalid request payload." }, 400);
+          }
+        } else {
+          parsedBody = raw as TBody;
+        }
+      }
+    }
+
+    try {
+      const res = await handler({ req, user: user ?? "", body: parsedBody }, routeCtx);
+      if (!res.headers.has("cache-control")) {
+        res.headers.set("cache-control", "no-store");
+      }
+      return res;
+    } catch (err) {
+      if (err instanceof RouteValidationError) {
+        return jsonNoStore({ error: err.message }, err.status);
+      }
+      throw err;
+    }
+  };
+}
diff --git a/apps/swarmagents/lib/mcp/transport.test.ts b/apps/swarmagents/lib/mcp/transport.test.ts
