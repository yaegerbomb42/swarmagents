+export async function handleUpdateTask(
+  store: BoardStore,
+  args: Record<string, unknown>
+): Promise<{ result: JsonRpcResult } | { error: JsonRpcError }> {
+  const ve = validateUpdateTask(args);
+  if (ve.length) {
+    return { error: invalidParams(ve.map((v) => `${v.field}: ${v.message}`).join("; ")) };
+  }
+
+  const taskId = String(args.taskId);
+  const agentName = String(args.agentName);
+  const task = store.tasks.find((t) => t.id === taskId);
+  if (!task) return { error: notFound("Task not found") };
+
+  // Only the claiming agent or orchestrator can update an assigned task
+  if (task.claimedBy && task.claimedBy !== agentName && agentName !== "orchestrator") {
+    return {
+      error: invalidParams(
+        `Task is claimed by ${task.claimedBy}; agent ${agentName} cannot update it`
+      ),
+    };
+  }
+
+  const prevStatus = task.status;
+  if (args.status && typeof args.status === "string") {
+    const nextStatus = args.status as TaskStatus;
+    if (nextStatus !== prevStatus) {
+      const blocked = assertTransition("task", prevStatus, nextStatus);
+      if (blocked) return { error: invalidParams(blocked) };
+      transitionTask(task, nextStatus, agentName, prevStatus);
+    }
+  }
+
+  if (typeof args.summary === "string") {
+    task.resultSummary = args.summary;
+  }
+  if (typeof args.progress === "string") {
+    // If progress is provided without summary, record it into resultSummary or note
+    task.resultSummary = task.resultSummary ? `${task.resultSummary}\n[Progress]: ${args.progress}` : args.progress;
+  }
+
+  task.updatedAt = Date.now();
+  const persistErr = await persistOrError(store);
+  if (persistErr) return { error: persistErr };
+  return { result: ok(JSON.stringify({ message: "Task updated", task }, null, 2)) };
+}
+
+const MAX_MESSAGES = 500;
+
+export async function handlePostMessage(
+  store: BoardStore,
+  args: Record<string, unknown>
+): Promise<{ result: JsonRpcResult } | { error: JsonRpcError }> {
+  const ve = validatePostMessage(args);
+  if (ve.length) {
+    return { error: invalidParams(ve.map((v) => `${v.field}: ${v.message}`).join("; ")) };
+  }
+
+  const message: SwarmMessage = {
+    id: `msg_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 6)}`,
+    fromAgent: String(args.fromAgent),
+    channel: args.channel as SwarmMessage["channel"],
+    content: String(args.content),
+    timestamp: Date.now(),
+  };
+
+  if (!Array.isArray(store.messages)) {
+    store.messages = [];
+  }
+  store.messages.push(message);
+  if (store.messages.length > MAX_MESSAGES) {
+    store.messages = store.messages.slice(-MAX_MESSAGES);
+  }
+
+  const persistErr = await persistOrError(store);
+  if (persistErr) return { error: persistErr };
+  return { result: ok(JSON.stringify({ message: "Message posted", swarmMessage: message }, null, 2)) };
+}
diff --git a/apps/swarmagents/lib/board/validation.ts b/apps/swarmagents/lib/board/validation.ts
index 99870c205..6af5baebe 100644
--- a/apps/swarmagents/lib/board/validation.ts
