+        {
+          id: "task_hard_claimed",
+          title: "Hard claimed",
+          description: "D",
+          difficulty: "hard",
+          minElo: 1600,
+          constraints: [],
+          status: "claimed",
+          claimedBy: "worker-http-infra",
