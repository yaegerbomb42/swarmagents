@@ -234,3 +234,31 @@ export function validateReviewAndMergeTask(args: Record<string, unknown>): Valid
   if (e5) errs.push(e5);
   return errs;
 }
+
+export function validateUpdateTask(args: Record<string, unknown>): ValidationError[] {
+  const errs: ValidationError[] = [];
+  const e1 = requiredString(args.taskId, "taskId");
+  if (e1) errs.push(e1);
+  const e2 = requiredString(args.agentName, "agentName", 200);
+  if (e2) errs.push(e2);
+  const e3 = optionalString(args.status, "status");
+  if (e3) errs.push(e3);
+  const e4 = optionalString(args.summary, "summary", 8000);
+  if (e4) errs.push(e4);
+  const e5 = optionalString(args.progress, "progress", 8000);
+  if (e5) errs.push(e5);
+  return errs;
+}
+
+const MESSAGE_CHANNELS = ["general", "blockers", "announcements", "idle_scouts"] as const;
+
+export function validatePostMessage(args: Record<string, unknown>): ValidationError[] {
+  const errs: ValidationError[] = [];
+  const e1 = requiredString(args.fromAgent, "fromAgent", 200);
+  if (e1) errs.push(e1);
+  const e2 = requiredEnum(args.channel, "channel", MESSAGE_CHANNELS);
+  if (e2) errs.push(e2);
+  const e3 = requiredString(args.content, "content", 8000);
+  if (e3) errs.push(e3);
+  return errs;
+}
