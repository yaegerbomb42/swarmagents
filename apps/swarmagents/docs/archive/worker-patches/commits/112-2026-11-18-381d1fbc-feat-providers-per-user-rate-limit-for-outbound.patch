     ctx(id)
   );
 }
@@ -106,3 +108,28 @@ test("POST surfaces a failing probe with an error kind and no key material", asy
     globalThis.fetch = originalFetch;
   }
 });
+
+test("POST /api/providers/[id]/test is rate limited per user", async () => {
+  saveProvider("rl-user-a@example.com", { id: "openai", apiKey: KEY });
+  saveProvider("rl-user-b@example.com", { id: "openai", apiKey: KEY });
+
+  const originalFetch = globalThis.fetch;
+  globalThis.fetch = (async () => okResponse()) as typeof fetch;
+  try {
+    let limited = 0;
+    let served = 0;
+    for (let i = 0; i < 30; i += 1) {
+      const res = await post("openai", "rl-user-a@example.com");
+      if (res.status === 429) limited += 1;
+      else served += 1;
+    }
+    assert.ok(limited > 0, "the provider probe rate limit must kick in");
+    assert.ok(served > 0, "some requests are served before the limit");
+
+    // A different user is unaffected.
+    const other = await post("openai", "rl-user-b@example.com");
+    assert.equal(other.status, 200);
+  } finally {
+    globalThis.fetch = originalFetch;
+  }
+});
