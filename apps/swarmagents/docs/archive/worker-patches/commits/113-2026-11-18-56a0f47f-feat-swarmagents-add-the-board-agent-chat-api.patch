+import test from "node:test";
+import assert from "node:assert/strict";
+import { dispatchTaskToVm, taskRunPrompt } from "./dispatch";
+import type { SwarmTask } from "../mcp-types";
+
+const task: SwarmTask = {
+  id: "task_1",
+  title: "Fix login",
+  description: "null check",
+  difficulty: "medium",
+  minElo: 1000,
+  constraints: ["no merge"],
+  status: "open",
+  createdAt: 1,
+  updatedAt: 1,
+};
+
+test("prompt names the l1 tip and the task", () => {
+  const prompt = taskRunPrompt(task);
+  assert.match(prompt, /0e9a26b46/);
+  assert.match(prompt, /Fix login/);
+  assert.match(prompt, /no merge/);
+});
+
+test("dispatch returns the stubbed run id", () => {
+  const result = dispatchTaskToVm("u", task, () => ({ accepted: true, runId: "run_abc", queued: false }));
+  assert.deepEqual(result, { runId: "run_abc" });
+});
+
+test("dispatch returns a refusal without throwing", () => {
+  const refused = dispatchTaskToVm("u", task, () => ({ accepted: false, runId: "", queued: false, error: "no VM" }));
+  assert.deepEqual(refused, { error: "no VM" });
+  const thrown = dispatchTaskToVm("u", task, () => {
+    throw new Error("no provider");
+  });
+  assert.deepEqual(thrown, { error: "no provider" });
+});
diff --git a/apps/swarmagents/lib/board-agent/dispatch.ts b/apps/swarmagents/lib/board-agent/dispatch.ts
new file mode 100644
index 000000000..2a0bddd6f
--- /dev/null
+++ b/apps/swarmagents/lib/board-agent/dispatch.ts
@@ -0,0 +1,37 @@
+import type { SwarmTask } from "../mcp-types";
+import { getRuntimeManager, type StartResult } from "../runtime/manager";
+
+const L1_TIP = "0e9a26b46";
+
+export function taskRunPrompt(task: SwarmTask): string {
+  const constraints = task.constraints.length > 0 ? task.constraints.map((item) => `- ${item}`).join("\n") : "- none";
+  return [
+    `Task ${task.id}: ${task.title}`,
+    task.description,
+    "Constraints:",
+    constraints,
+    `Work on a branch off l1 tip ${L1_TIP}, PR to l1, no merge.`,
+  ].join("\n");
+}
+
+type StartFn = (
+  userId: string,
+  input: { prompt: string },
+) => StartResult;
+
+export function dispatchTaskToVm(
+  userId: string,
+  task: SwarmTask,
+  start?: StartFn,
+): { runId: string } | { error: string } {
+  const startRun = start ?? ((id, input) => getRuntimeManager().start(id, input));
+  try {
+    const result = startRun(userId, { prompt: taskRunPrompt(task) });
+    if (!result.accepted || !result.runId) {
+      return { error: result.error ?? "The VM did not accept the run." };
+    }
+    return { runId: result.runId };
+  } catch (err) {
+    return { error: err instanceof Error ? err.message : "The VM could not start the run." };
+  }
+}
