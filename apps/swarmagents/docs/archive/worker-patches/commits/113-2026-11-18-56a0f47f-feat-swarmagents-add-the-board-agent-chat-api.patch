diff --git a/apps/swarmagents/app/api/board-agent/chat/route.test.ts b/apps/swarmagents/app/api/board-agent/chat/route.test.ts
new file mode 100644
index 000000000..e702ea470
--- /dev/null
+++ b/apps/swarmagents/app/api/board-agent/chat/route.test.ts
@@ -0,0 +1,71 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { NextRequest } from "next/server";
+import { USER_HEADER } from "@/lib/auth";
+import { __setBoardAgentCompleterForTests } from "@/lib/board-agent/agent";
+import { configureStorePaths } from "@/lib/board/store";
+import { GET, POST } from "./route";
+
+const dir = fs.mkdtempSync(path.join(os.tmpdir(), "board-agent-route-"));
+process.env.SWARM_HOME = dir;
+configureStorePaths(dir, path.join(dir, "swarm_board.json"));
+
+function post(body: unknown, user = "alice"): NextRequest {
+  return new NextRequest("http://localhost/api/board-agent/chat", {
+    method: "POST",
+    headers: { "content-type": "application/json", [USER_HEADER]: user },
+    body: typeof body === "string" ? body : JSON.stringify(body),
+  });
+}
+
+test.beforeEach(() => {
+  __setBoardAgentCompleterForTests(async () => "Ready.");
+});
+
+test.after(() => {
+  __setBoardAgentCompleterForTests(null);
+});
+
+test("401 without user", async () => {
+  const res = await POST(new NextRequest("http://localhost/api/board-agent/chat", {
+    method: "POST",
+    body: JSON.stringify({ message: "hi" }),
+  }));
+  assert.equal(res.status, 401);
+});
+
+test("400 for an empty message and 413 over the body cap", async () => {
+  const empty = await POST(post({ message: "" }));
+  assert.equal(empty.status, 400);
+  const huge = await POST(post({ message: "x".repeat(20_000) }));
+  assert.equal(huge.status, 413);
+  const long = await POST(post({ message: "x".repeat(4001) }));
+  assert.equal(long.status, 400);
+});
+
+test("creates a conversation and continues it", async () => {
+  const created = await POST(post({ message: "hello board" }));
+  assert.equal(created.status, 200);
+  const first = await created.json() as { reply: string; conversationId: string };
+  assert.equal(first.reply, "Ready.");
+  const again = await POST(post({ message: "status?", conversationId: first.conversationId }));
+  assert.equal(again.status, 200);
+  const listed = await GET(new NextRequest("http://localhost/api/board-agent/chat", {
+    headers: { [USER_HEADER]: "alice" },
+  }));
+  const listBody = await listed.json() as { conversations: Array<{ id: string; messageCount: number }> };
+  assert.equal(listBody.conversations[0]?.id, first.conversationId);
+  assert.equal(listBody.conversations[0]?.messageCount, 4);
+  const one = await GET(new NextRequest(`http://localhost/api/board-agent/chat?conversationId=${first.conversationId}`, {
+    headers: { [USER_HEADER]: "alice" },
+  }));
+  const conv = await one.json() as { conversation: { messages: unknown[] } };
+  assert.equal(conv.conversation.messages.length, 4);
+  const other = await GET(new NextRequest(`http://localhost/api/board-agent/chat?conversationId=${first.conversationId}`, {
+    headers: { [USER_HEADER]: "bob" },
+  }));
+  assert.equal(other.status, 404);
+});
diff --git a/apps/swarmagents/app/api/board-agent/chat/route.ts b/apps/swarmagents/app/api/board-agent/chat/route.ts
new file mode 100644
index 000000000..7b4b2dd9f
--- /dev/null
+++ b/apps/swarmagents/app/api/board-agent/chat/route.ts
@@ -0,0 +1,87 @@
+import { NextResponse, type NextRequest } from "next/server";
+import { randomUUID } from "node:crypto";
+import { USER_HEADER } from "@/lib/auth";
+import { BoardAgentProviderError, runBoardAgent } from "@/lib/board-agent/agent";
+import { getConversation, listConversations, saveConversation } from "@/lib/board-agent/store";
+import type { BoardAgentConversation } from "@/lib/board-agent/types";
+import { JsonBodyError, readJsonBody } from "@/lib/http";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+const NO_STORE = { "cache-control": "no-store" } as const;
+const MAX_BODY = 16 * 1024;
+
+function userIdFrom(request: NextRequest): string | null {
+  const user = request.headers.get(USER_HEADER);
+  if (!user || user.trim().length === 0 || user.length > 128) return null;
+  return user;
+}
+
+export async function POST(request: NextRequest) {
+  const userId = userIdFrom(request);
+  if (!userId) {
+    return NextResponse.json({ error: "Sign in required." }, { status: 401, headers: NO_STORE });
+  }
+  let body: unknown;
+  try {
+    body = await readJsonBody(request, MAX_BODY);
+  } catch (err) {
+    if (err instanceof JsonBodyError) {
+      return NextResponse.json({ error: err.message }, { status: err.status, headers: NO_STORE });
+    }
+    return NextResponse.json({ error: "Invalid JSON body." }, { status: 400, headers: NO_STORE });
+  }
+  if (!body || typeof body !== "object" || Array.isArray(body)) {
+    return NextResponse.json({ error: "Body must be a JSON object." }, { status: 400, headers: NO_STORE });
+  }
+  const input = body as { message?: unknown; conversationId?: unknown };
+  if (typeof input.message !== "string" || input.message.length < 1 || input.message.length > 4000) {
+    return NextResponse.json({ error: "message must be 1..4000 characters." }, { status: 400, headers: NO_STORE });
+  }
+  if (input.conversationId !== undefined && typeof input.conversationId !== "string") {
+    return NextResponse.json({ error: "conversationId must be a string." }, { status: 400, headers: NO_STORE });
+  }
+  const existing = typeof input.conversationId === "string" ? getConversation(userId, input.conversationId) : null;
+  if (typeof input.conversationId === "string" && !existing) {
+    return NextResponse.json({ error: "Conversation not found." }, { status: 404, headers: NO_STORE });
+  }
+  const conversation: BoardAgentConversation = existing ?? {
+    id: `conv_${randomUUID()}`,
+    userId,
+    title: input.message.slice(0, 80),
+    messages: [],
+    createdAt: Date.now(),
+    updatedAt: Date.now(),
+  };
+  try {
+    const result = await runBoardAgent(userId, conversation, input.message);
+    await saveConversation(userId, conversation);
+    return NextResponse.json(
+      { reply: result.reply, conversationId: conversation.id, taskIds: result.taskIds, runIds: result.runIds },
+      { headers: NO_STORE },
+    );
+  } catch (err) {
+    if (err instanceof BoardAgentProviderError) {
+      return NextResponse.json({ error: err.message }, { status: err.status, headers: NO_STORE });
+    }
+    const message = err instanceof Error ? err.message : "Board agent failed.";
+    return NextResponse.json({ error: message }, { status: 502, headers: NO_STORE });
+  }
+}
+
+export async function GET(request: NextRequest) {
+  const userId = userIdFrom(request);
+  if (!userId) {
+    return NextResponse.json({ error: "Sign in required." }, { status: 401, headers: NO_STORE });
+  }
+  const conversationId = request.nextUrl.searchParams.get("conversationId");
+  if (!conversationId) {
+    return NextResponse.json({ conversations: listConversations(userId) }, { headers: NO_STORE });
+  }
+  const conversation = getConversation(userId, conversationId);
+  if (!conversation) {
+    return NextResponse.json({ error: "Conversation not found." }, { status: 404, headers: NO_STORE });
+  }
+  return NextResponse.json({ conversation }, { headers: NO_STORE });
+}
