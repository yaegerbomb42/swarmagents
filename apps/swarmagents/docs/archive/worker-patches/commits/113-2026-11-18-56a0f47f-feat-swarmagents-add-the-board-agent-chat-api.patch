+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { configureStorePaths } from "../board/store";
+import {
+  __setBoardAgentCompleterForTests,
+  __setBoardAgentDispatchForTests,
+  parseToolCall,
+  runBoardAgent,
+} from "./agent";
+import type { BoardAgentConversation } from "./types";
+
+const dir = fs.mkdtempSync(path.join(os.tmpdir(), "board-agent-loop-"));
+configureStorePaths(dir, path.join(dir, "swarm_board.json"));
+
+function conversation(): BoardAgentConversation {
+  return { id: "c", userId: "u", title: "", messages: [], createdAt: 1, updatedAt: 1 };
+}
+
+test("parse failure is a plain reply", () => {
+  assert.equal(parseToolCall("hello there"), null);
+  assert.equal(parseToolCall("```json\n{not\n```"), null);
+});
+
+test("agent loop creates a task and stops", async () => {
+  const replies = [
+    '```json\n{"tool":"create_board_task","args":{"title":"Note","description":"write it down"}}\n```',
+    "Created the note.",
+  ];
+  __setBoardAgentCompleterForTests(async () => replies.shift() ?? "done");
+  __setBoardAgentDispatchForTests(() => ({ runId: "run_should_not" }));
+  const result = await runBoardAgent("u", conversation(), "Create a task titled Note");
+  assert.equal(result.reply, "Created the note.");
+  assert.equal(result.taskIds.length, 1);
+  assert.deepEqual(result.runIds, []);
+  __setBoardAgentCompleterForTests(null);
+  __setBoardAgentDispatchForTests(null);
+});
+
+test("work request dispatches and records the run id", async () => {
+  const replies = [
+    '```json\n{"tool":"create_board_task","args":{"title":"Fix login","description":"null check"}}\n```',
+    "Started the VM.",
+  ];
+  __setBoardAgentCompleterForTests(async () => replies.shift() ?? "done");
+  __setBoardAgentDispatchForTests(() => ({ runId: "run_stub" }));
+  const result = await runBoardAgent("u", conversation(), "fix the login bug");
+  assert.deepEqual(result.runIds, ["run_stub"]);
+  assert.equal(result.taskIds.length, 1);
+  __setBoardAgentCompleterForTests(null);
+  __setBoardAgentDispatchForTests(null);
+});
+
+test("dispatch error is returned as tool text", async () => {
+  const replies = [
+    '```json\n{"tool":"create_board_task","args":{"title":"Build","description":"ship"}}\n```',
+    "Could not start.",
+  ];
+  __setBoardAgentCompleterForTests(async () => replies.shift() ?? "done");
+  __setBoardAgentDispatchForTests(() => {
+    throw new Error("no VM");
+  });
+  const conv = conversation();
+  const result = await runBoardAgent("u", conv, "build the widget");
+  assert.equal(result.runIds.length, 0);
+  assert.match(conv.messages.find((m) => m.role === "tool")?.content ?? "", /no VM/);
+  assert.equal(result.reply, "Could not start.");
+  __setBoardAgentCompleterForTests(null);
+  __setBoardAgentDispatchForTests(null);
+});
diff --git a/apps/swarmagents/lib/board-agent/agent.ts b/apps/swarmagents/lib/board-agent/agent.ts
new file mode 100644
index 000000000..6c1d3cc68
--- /dev/null
+++ b/apps/swarmagents/lib/board-agent/agent.ts
@@ -0,0 +1,183 @@
+import { countUserProviders } from "../providers/store";
+import { forwardLlmNonStreaming } from "../runtime/llm-gateway";
+import { dispatchTaskToVm } from "./dispatch";
+import { createBoardTask, getBoardTask, getRunStatus, listBoardTasks } from "./tools";
+import type { BoardAgentConversation, BoardAgentMessage, BoardAgentToolCall, BoardAgentToolName, BoardAgentToolResult } from "./types";
+import type { SwarmTask } from "../mcp-types";
+
+const SYSTEM = "You are the SwarmBoard agent. You help the user by creating and tracking tasks on the SwarmBoard and running them in the SwarmAgents VM. You can call tools by emitting a single ```json block with { tool, args }. If no tool is needed, reply in plain text. Keep replies short. Never invent a task id, run id, or PR url — only report ids returned by tools.";
+
+const TOOLS: ReadonlySet<string> = new Set([
+  "create_board_task",
+  "list_board_tasks",
+  "get_board_task",
+  "get_run_status",
+]);
+
+const WORK_INTENT = /\b(fix|build|implement|run|dispatch|work on|make|do)\b/i;
+
+export class BoardAgentProviderError extends Error {
+  readonly status: 502 | 503;
+  constructor(message: string, status: 502 | 503) {
+    super(message);
+    this.name = "BoardAgentProviderError";
+    this.status = status;
+  }
+}
+
+type Completer = (userId: string, transcript: string) => Promise<string>;
+type Dispatcher = typeof dispatchTaskToVm;
+
+let testCompleter: Completer | null = null;
+let testDispatcher: Dispatcher | null = null;
+
+export function __setBoardAgentCompleterForTests(fn: Completer | null): void {
+  testCompleter = fn;
+}
+
+export function __setBoardAgentDispatchForTests(fn: Dispatcher | null): void {
+  testDispatcher = fn;
+}
+
+export function wantsVmRun(userMessage: string): boolean {
+  return WORK_INTENT.test(userMessage);
+}
+
+function transcript(conversation: BoardAgentConversation): string {
+  const prior = conversation.messages.slice(-20).map((message) => `${message.role}: ${message.content}`);
+  return [SYSTEM, ...prior].join("\n");
+}
+
+function textFromBody(body: unknown): string {
+  if (!body || typeof body !== "object") return typeof body === "string" ? body : "";
+  const record = body as Record<string, unknown>;
+  if (typeof record.content === "string") return record.content;
+  if (Array.isArray(record.content)) {
+    return record.content
+      .map((part) => (part && typeof part === "object" && typeof (part as { text?: unknown }).text === "string"
+        ? (part as { text: string }).text
+        : ""))
+      .join("");
+  }
+  const choices = record.choices;
+  if (Array.isArray(choices) && choices[0] && typeof choices[0] === "object") {
+    const message = (choices[0] as { message?: { content?: unknown } }).message;
+    if (typeof message?.content === "string") return message.content;
+  }
+  return JSON.stringify(body);
+}
+
+async function defaultComplete(userId: string, transcriptText: string): Promise<string> {
+  if (countUserProviders(userId) === 0) {
+    throw new BoardAgentProviderError(
+      "No provider is configured. Add your key in Settings (BYOK) before I can run.",
+      503,
+    );
+  }
+  try {
+    const completion = await forwardLlmNonStreaming({
+      owner: userId,
+      body: {
+        max_tokens: 1024,
+        messages: [{ role: "user", content: transcriptText }],
+      },
+    });
+    return textFromBody(completion.body);
+  } catch (err) {
+    if (err instanceof BoardAgentProviderError) throw err;
+    const message = err instanceof Error ? err.message : "The model provider failed.";
+    const status = /no provider|not configured|503/i.test(message) ? 503 : 502;
+    throw new BoardAgentProviderError(message, status);
+  }
+}
+
+export function parseToolCall(text: string): BoardAgentToolCall | null {
+  const match = text.match(/```json\s*([\s\S]*?)```/i);
+  if (!match) return null;
+  try {
+    const parsed = JSON.parse(match[1]) as { tool?: unknown; args?: unknown };
+    if (typeof parsed.tool !== "string" || !TOOLS.has(parsed.tool)) return null;
+    const args = parsed.args && typeof parsed.args === "object" && !Array.isArray(parsed.args)
+      ? parsed.args as Record<string, unknown>
+      : {};
+    return { tool: parsed.tool as BoardAgentToolName, args };
+  } catch {
+    return null;
+  }
+}
+
+async function executeTool(
+  userId: string,
+  call: BoardAgentToolCall,
+  userMessage: string,
+): Promise<{ result: BoardAgentToolResult; taskId?: string; runId?: string }> {
+  const dispatch = testDispatcher ?? dispatchTaskToVm;
+  if (call.tool === "create_board_task") {
+    const created = await createBoardTask(userId, {
+      title: String(call.args.title ?? ""),
+      description: String(call.args.description ?? ""),
+      difficulty: typeof call.args.difficulty === "string" ? call.args.difficulty : undefined,
+      constraints: Array.isArray(call.args.constraints) ? call.args.constraints.filter((item): item is string => typeof item === "string") : undefined,
+    });
+    const createdData = created.data as { taskId?: string; task?: SwarmTask } | undefined;
+    if (!created.ok || !createdData?.taskId || !createdData.task) return { result: created };
+    let summary = created.summary;
+    let runId: string | undefined;
+    if (wantsVmRun(userMessage)) {
+      let dispatched: { runId: string } | { error: string };
+      try {
+        dispatched = dispatch(userId, createdData.task);
+      } catch (err) {
+        dispatched = { error: err instanceof Error ? err.message : "The VM could not start the run." };
+      }
+      if ("runId" in dispatched) {
+        runId = dispatched.runId;
+        summary = `${summary} VM run ${runId} started.`;
+      } else {
+        summary = `${summary} VM did not start: ${dispatched.error}`;
+      }
+    }
+    return { result: { ...created, summary }, taskId: createdData.taskId, runId };
+  }
+  if (call.tool === "list_board_tasks") {
+    const status = typeof call.args.status === "string" ? call.args.status : undefined;
+    return { result: listBoardTasks(userId, status ? { status } : {}) };
+  }
+  if (call.tool === "get_board_task") {
+    return { result: getBoardTask(userId, String(call.args.taskId ?? "")) };
+  }
+  return { result: getRunStatus(userId, String(call.args.runId ?? "")) };
+}
+
+export async function runBoardAgent(
+  userId: string,
+  conversation: BoardAgentConversation,
+  userMessage: string,
+): Promise<{ reply: string; taskIds: string[]; runIds: string[] }> {
+  const complete = testCompleter ?? defaultComplete;
+  const now = Date.now();
+  conversation.messages.push({ role: "user", content: userMessage, createdAt: now });
+  const taskIds: string[] = [];
+  const runIds: string[] = [];
+  let reply = "";
+  for (let turn = 0; turn < 4; turn += 1) {
+    reply = await complete(userId, transcript(conversation));
+    const call = turn < 3 ? parseToolCall(reply) : null;
+    if (!call) break;
+    const executed = await executeTool(userId, call, userMessage);
+    if (executed.taskId) taskIds.push(executed.taskId);
+    if (executed.runId) runIds.push(executed.runId);
+    const toolMessage: BoardAgentMessage = {
+      role: "tool",
+      content: executed.result.summary,
+      createdAt: Date.now(),
+      ...(executed.taskId ? { taskId: executed.taskId } : {}),
+      ...(executed.runId ? { runId: executed.runId } : {}),
+    };
+    conversation.messages.push(toolMessage);
+  }
+  conversation.messages.push({ role: "agent", content: reply, createdAt: Date.now() });
+  conversation.updatedAt = Date.now();
+  if (!conversation.title) conversation.title = userMessage.slice(0, 80);
+  return { reply, taskIds, runIds };
+}
