+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { configureStorePaths } from "../board/store";
+import { createBoardTask, getBoardTask, listBoardTasks } from "./tools";
+
+const dir = fs.mkdtempSync(path.join(os.tmpdir(), "board-agent-tools-"));
+configureStorePaths(dir, path.join(dir, "swarm_board.json"));
+
+test("createBoardTask validates and defaults difficulty", async () => {
+  const bad = await createBoardTask("u1", { title: "", description: "x" });
+  assert.equal(bad.ok, false);
+  const tooLong = await createBoardTask("u1", { title: "t".repeat(201), description: "d", difficulty: "medium" });
+  assert.match(tooLong.summary, /title/);
+  const created = await createBoardTask("u1", { title: "Fix login", description: "details" });
+  assert.equal(created.ok, true);
+  const taskId = (created.data as { taskId: string }).taskId;
+  assert.ok(taskId.startsWith("task_"));
+  const fetched = getBoardTask("u1", taskId);
+  assert.match(fetched.summary, /medium/);
+  const listed = listBoardTasks("u1", { status: "open" });
+  assert.match(listed.summary, /Fix login/);
+});
+
+test("constraint length is rejected", async () => {
+  const result = await createBoardTask("u1", {
+    title: "T",
+    description: "D",
+    constraints: ["c".repeat(501)],
+  });
+  assert.equal(result.ok, false);
+  assert.match(result.summary, /500/);
+});
+
+test("missing task", () => {
+  const result = getBoardTask("u1", "task_missing");
+  assert.match(result.summary, /not found/);
+});
diff --git a/apps/swarmagents/lib/board-agent/tools.ts b/apps/swarmagents/lib/board-agent/tools.ts
new file mode 100644
index 000000000..12e65bc15
--- /dev/null
+++ b/apps/swarmagents/lib/board-agent/tools.ts
@@ -0,0 +1,96 @@
+import { handleCreateTask, handlePollTasks } from "../board/handlers";
+import { loadStore } from "../board/store";
+import { validateCreateTask } from "../board/validation";
+import type { SwarmTask } from "../mcp-types";
+import { getRuntimeManager } from "../runtime/manager";
+import type { BoardAgentToolResult } from "./types";
+
+const DIFFICULTIES = new Set(["trivial", "easy", "medium", "hard", "expert"]);
+
+export interface CreateBoardTaskInput {
+  title: string;
+  description: string;
+  difficulty?: string;
+  constraints?: string[];
+}
+
+function fail(summary: string): BoardAgentToolResult {
+  return { ok: false, summary };
+}
+
+export async function createBoardTask(
+  userId: string,
+  input: CreateBoardTaskInput,
+): Promise<BoardAgentToolResult> {
+  void userId;
+  const difficulty = input.difficulty && DIFFICULTIES.has(input.difficulty) ? input.difficulty : input.difficulty ?? "medium";
+  const args: Record<string, unknown> = {
+    title: input.title,
+    description: input.description,
+    difficulty,
+    ...(input.constraints ? { constraints: input.constraints } : {}),
+  };
+  const errors = validateCreateTask(args);
+  if (errors.length > 0) {
+    return fail(errors.map((err) => `${err.field}: ${err.message}`).join("; "));
+  }
+  const store = loadStore();
+  const created = await handleCreateTask(store, args);
+  if ("error" in created) return fail(created.error.message);
+  const payload = JSON.parse(created.result.content[0]?.text ?? "{}") as { task?: SwarmTask };
+  const task = payload.task;
+  if (!task) return fail("Task was not created.");
+  return {
+    ok: true,
+    summary: `Created task ${task.id} "${task.title}" (${task.status}, ${task.difficulty}).`,
+    data: { taskId: task.id, title: task.title, task },
+  };
+}
+
+export function listBoardTasks(userId: string, input: { status?: string } = {}): BoardAgentToolResult {
+  void userId;
+  const store = loadStore();
+  if (input.status) {
+    const polled = handlePollTasks(store, { status: input.status });
+    if ("error" in polled) return fail(polled.error.message);
+  }
+  const tasks = store.tasks
+    .filter((task) => (input.status ? task.status === input.status : true))
+    .slice(0, 20);
+  if (tasks.length === 0) return { ok: true, summary: "No tasks.", data: [] };
+  const lines = tasks.map(
+    (task) =>
+      `${task.id} | ${task.title} | ${task.status} | claimedBy=${task.claimedBy ?? "-"} | pr=${task.prUrl ?? "-"}`,
+  );
+  return { ok: true, summary: lines.join("\n"), data: tasks.map((task) => ({
+    id: task.id,
+    title: task.title,
+    status: task.status,
+    claimedBy: task.claimedBy,
+    prUrl: task.prUrl,
+  })) };
+}
+
+export function getBoardTask(userId: string, taskId: string): BoardAgentToolResult {
+  void userId;
+  const task = loadStore().tasks.find((row) => row.id === taskId);
+  if (!task) return fail(`Task ${taskId} not found.`);
+  return {
+    ok: true,
+    summary: `${task.id} "${task.title}" status=${task.status} difficulty=${task.difficulty} claimedBy=${task.claimedBy ?? "-"} pr=${task.prUrl ?? "-"}\n${task.description}`,
+    data: task,
+  };
+}
+
+export function getRunStatus(userId: string, runId: string): BoardAgentToolResult {
+  let runs;
+  try {
+    runs = getRuntimeManager().list(userId);
+  } catch (err) {
+    return fail(err instanceof Error ? err.message : "Could not read run status.");
+  }
+  const run = runs.find((row) => row.runId === runId);
+  if (!run) return fail(`Run ${runId} not found.`);
+  const summary = `Run ${run.runId} status=${run.status}${run.error ? ` error=${run.error}` : ""}.`;
+  return { ok: true, summary, data: { runId: run.runId, status: run.status, error: run.error } };
+}
