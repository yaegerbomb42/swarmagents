+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { conversationFile, getConversation, listConversations, loadConversations, saveConversation } from "./store";
+import type { BoardAgentConversation } from "./types";
+
+const dir = fs.mkdtempSync(path.join(os.tmpdir(), "board-agent-store-"));
+process.env.SWARM_HOME = dir;
+
+function conv(id: string): BoardAgentConversation {
+  return {
+    id,
+    userId: "user-a",
+    title: "Hello",
+    messages: [{ role: "user", content: "hi", createdAt: 1 }],
+    createdAt: 1,
+    updatedAt: 2,
+  };
+}
+
+test("conversation round-trip and list", async () => {
+  await saveConversation("user-a", conv("c1"));
+  const loaded = loadConversations("user-a");
+  assert.equal(loaded.length, 1);
+  assert.equal(getConversation("user-a", "c1")?.title, "Hello");
+  assert.equal(listConversations("user-a")[0]?.messageCount, 1);
+  const stat = fs.statSync(conversationFile("user-a"));
+  assert.equal(stat.mode & 0o777, 0o600);
+});
+
+test("corrupt conversation file reads as empty", () => {
+  fs.writeFileSync(conversationFile("user-a"), "{not json", { mode: 0o600 });
+  assert.deepEqual(loadConversations("user-a"), []);
+});
+
+test("other users do not see conversations", async () => {
+  await saveConversation("user-b", { ...conv("c2"), userId: "user-b" });
+  assert.equal(getConversation("user-a", "c2"), null);
+});
