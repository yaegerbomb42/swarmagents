@@ -0,0 +1,66 @@
+import fs from "node:fs";
+import path from "node:path";
+import { atomicWriteFileAsync } from "../atomic-write";
+import { resolveStorageDir } from "../board/store";
+import type { BoardAgentConversation } from "./types";
+
+function safeUserId(userId: string): string {
+  const cleaned = userId.replace(/[^a-zA-Z0-9_-]/g, "_").slice(0, 128);
+  return cleaned.length > 0 ? cleaned : "user";
+}
+
+export function conversationFile(userId: string): string {
+  return path.join(resolveStorageDir(), "board-agent", `conversations-${safeUserId(userId)}.json`);
+}
+
+function empty(): BoardAgentConversation[] {
+  return [];
+}
+
+export function loadConversations(userId: string): BoardAgentConversation[] {
+  const file = conversationFile(userId);
+  let text: string;
+  try {
+    text = fs.readFileSync(file, "utf-8");
+  } catch (err) {
+    const code = (err as { code?: string }).code;
+    if (code === "ENOENT") return empty();
+    return empty();
+  }
+  try {
+    const parsed = JSON.parse(text) as unknown;
+    if (!Array.isArray(parsed)) return empty();
+    return parsed.filter((row): row is BoardAgentConversation => {
+      if (!row || typeof row !== "object") return false;
+      const conv = row as BoardAgentConversation;
+      return typeof conv.id === "string" && conv.userId === userId && Array.isArray(conv.messages);
+    });
+  } catch {
+    return empty();
+  }
+}
+
+export async function saveConversation(userId: string, conv: BoardAgentConversation): Promise<void> {
+  const all = loadConversations(userId).filter((row) => row.id !== conv.id);
+  all.push({ ...conv, userId });
+  const file = conversationFile(userId);
+  fs.mkdirSync(path.dirname(file), { recursive: true, mode: 0o700 });
+  await atomicWriteFileAsync(file, JSON.stringify(all), { mode: 0o600 });
+}
+
+export function getConversation(userId: string, id: string): BoardAgentConversation | null {
+  return loadConversations(userId).find((row) => row.id === id) ?? null;
+}
+
+export function listConversations(
+  userId: string,
+): Array<Pick<BoardAgentConversation, "id" | "title" | "updatedAt"> & { messageCount: number }> {
+  return loadConversations(userId)
+    .map((row) => ({
+      id: row.id,
+      title: row.title,
+      updatedAt: row.updatedAt,
+      messageCount: row.messages.length,
+    }))
+    .sort((a, b) => b.updatedAt - a.updatedAt);
+}
