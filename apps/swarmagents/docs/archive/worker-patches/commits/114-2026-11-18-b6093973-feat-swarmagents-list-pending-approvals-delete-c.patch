@@ -20,6 +24,7 @@ export const dynamic = "force-dynamic";
 
 const MAX_BODY_SIZE = 1024;
 
+/** Per-user state; never cache it anywhere in front of the origin. */
 const NO_STORE = { "cache-control": "no-store" } as const;
 
 function caller(req: NextRequest): string | null {
@@ -89,3 +94,33 @@ export async function POST(req: NextRequest, ctx: { params: Promise<{ id: string
   });
   return NextResponse.json({ ok: true, status: resolved!.status }, { headers: NO_STORE });
 }
+
+/**
+ * Cancel a pending approval. Recorded as a denial ("approval.deny") because the
+ * paused run must be released with a verdict it already understands; the
+ * alternative — leaving it pending — keeps the run parked until the TTL.
+ *
+ * Same ownership and auth rules as POST. A second cancel is a 409, mirroring
+ * the "decide twice" contract.
+ */
+export async function DELETE(req: NextRequest, ctx: { params: Promise<{ id: string }> }) {
+  const user = caller(req);
+  if (!user) return unauthorized();
+  const { id } = await ctx.params;
+
+  const store = getApprovalStore();
+  const approval = store.get(id);
+  if (!approval || approval.userId !== user) {
+    return NextResponse.json({ error: "Approval not found." }, { status: 404, headers: NO_STORE });
+  }
+  if (approval.status !== "pending") {
+    return NextResponse.json(
+      { error: `Approval already ${approval.status}.`, status: approval.status },
+      { status: 409, headers: NO_STORE },
+    );
+  }
+
+  const resolved = store.resolve(id, "denied");
+  recordAudit({ user, action: "approval.deny", target: id, result: "success" });
+  return NextResponse.json({ ok: true, status: resolved!.status }, { headers: NO_STORE });
+}
diff --git a/apps/swarmagents/app/api/runtime/approvals/list-delete.test.ts b/apps/swarmagents/app/api/runtime/approvals/list-delete.test.ts
new file mode 100644
index 000000000..cbdb47bee
--- /dev/null
+++ b/apps/swarmagents/app/api/runtime/approvals/list-delete.test.ts
@@ -0,0 +1,136 @@
+/**
+ * Tests for the approvals rehydration list and the cancel verb:
+ *
+ *   GET    /api/runtime/approvals       -> the caller's pending approvals
+ *   DELETE /api/runtime/approvals/{id}  -> cancel (recorded as a denial)
+ *
+ * These are store-level route tests: no VM, no run, just the approval store the
+ * runtime would have written into.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import { NextRequest } from "next/server";
+import { USER_HEADER } from "../../../../lib/auth";
+import { ApprovalStore, setApprovalStoreForTesting } from "../../../../lib/harness/approvals";
+import { GET } from "./route";
+import { DELETE } from "./[id]/route";
+
+const ALICE = "alice";
+
+function listRequest(user: string | null): NextRequest {
+  return new NextRequest("http://localhost/api/runtime/approvals", {
+    headers: user ? { [USER_HEADER]: user } : {},
+  });
+}
+
+function deleteApproval(id: string, user: string | null): Promise<Response> {
+  return DELETE(
+    new NextRequest(`http://localhost/api/runtime/approvals/${id}`, {
+      method: "DELETE",
+      headers: user ? { [USER_HEADER]: user } : {},
+    }),
+    { params: Promise.resolve({ id }) },
+  );
+}
+
+function install(): ApprovalStore {
+  const store = new ApprovalStore({ ttlMs: 60_000 });
+  setApprovalStoreForTesting(store);
+  return store;
+}
+
+function pending(store: ApprovalStore, overrides: { userId?: string; runId?: string } = {}) {
+  return store.create({
+    runId: overrides.runId ?? "run_alice",
+    userId: overrides.userId ?? ALICE,
+    toolName: "Bash",
+    action: "rm -rf /workspace/build",
+    reason: "destructive shell command",
+  });
+}
+
+test.after(() => {
+  setApprovalStoreForTesting(null);
+});
+
+test("GET requires a signed-in caller", async () => {
+  install();
+  const res = await GET(listRequest(null));
+  assert.equal(res.status, 401);
+});
+
+test("GET lists only the caller's pending approvals", async () => {
+  const store = install();
+  const mine = pending(store);
+  pending(store, { userId: "mallory", runId: "run_mallory" });
+
+  const res = await GET(listRequest(ALICE));
+  assert.equal(res.status, 200);
+  // Per-user state must never be cached in front of the origin.
+  assert.equal(res.headers.get("cache-control"), "no-store");
+
+  const body = (await res.json()) as { approvals: Array<{ id: string }> };
+  assert.equal(body.approvals.length, 1);
+  assert.equal(body.approvals[0]!.id, mine.id);
+
+  const theirs = await GET(listRequest("mallory"));
+  const theirsBody = (await theirs.json()) as { approvals: Array<{ id: string }> };
+  // Each caller sees only their own pending approvals.
+  assert.equal(theirsBody.approvals.length, 1);
+  assert.notEqual(theirsBody.approvals[0]!.id, mine.id);
+});
+
+test("GET is empty when nothing is pending", async () => {
+  install();
+  const res = await GET(listRequest(ALICE));
+  assert.equal(res.status, 200);
+  assert.deepEqual((await res.json()) as { approvals: unknown[] }, { approvals: [] });
+});
+
+test("GET drops decided and expired approvals", async () => {
+  const store = install();
+  const approved = pending(store, { runId: "run_a" });
+  const expired = pending(store, { runId: "run_b" });
+  const live = pending(store, { runId: "run_c" });
+  store.resolve(approved.id, "approved");
+  store.expirePendingForRun(expired.runId, "run_cancelled");
+
+  const res = await GET(listRequest(ALICE));
+  const body = (await res.json()) as { approvals: Array<{ id: string }> };
+  assert.deepEqual(body.approvals.map((a) => a.id), [live.id]);
+});
+
+test("DELETE requires auth, ownership, and a live approval", async () => {
+  const store = install();
+  const approval = pending(store);
+
+  assert.equal((await deleteApproval(approval.id, null)).status, 401);
+  assert.equal((await deleteApproval("appr_ghost", ALICE)).status, 404);
+  // Another user cannot cancel someone else's approval.
+  assert.equal((await deleteApproval(approval.id, "mallory")).status, 404);
+
+  const ok = await deleteApproval(approval.id, ALICE);
+  assert.equal(ok.status, 200);
+  assert.equal(ok.headers.get("cache-control"), "no-store");
+  assert.deepEqual((await ok.json()) as unknown, { ok: true, status: "denied" });
+
+  // Already decided -> 409, not a second resolution.
+  const again = await deleteApproval(approval.id, ALICE);
+  assert.equal(again.status, 409);
+  assert.equal(((await again.json()) as { status: string }).status, "denied");
+});
+
+test("DELETE releases the paused run with a denial and clears the list", async () => {
+  const store = install();
+  const approval = pending(store);
+  const verdict = store.waitFor(approval.id);
+
+  const res = await deleteApproval(approval.id, ALICE);
+  assert.equal(res.status, 200);
+  // The runner awaiting this approval must wake up, not sit out the TTL.
+  assert.equal(await verdict, "denied");
+
+  const listed = (await (await GET(listRequest(ALICE))).json()) as { approvals: unknown[] };
+  assert.deepEqual(listed.approvals, []);
+});
