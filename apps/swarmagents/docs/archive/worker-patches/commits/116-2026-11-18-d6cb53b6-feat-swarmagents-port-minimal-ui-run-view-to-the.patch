@@ -0,0 +1,308 @@
+/**
+ * MinimalHome — the minimal 3-part main view.
+ *
+ * A faithful port of the new prototype's page
+ * (_prototype-zip2/src/app/page.tsx): header (wordmark + effective-
+ * provider pill + gear), main area (VmScreen when a run is focused,
+ * conversation list when idle, calm empty state with
+ * ComputerIllustration + suggestion chips), input bar pinned bottom
+ * (textarea + attach + model/provider picker dropdown + send/stop),
+ * Conversation inline in this same file.
+ *
+ * The App shell (App.tsx) renders this as the workspace. It passes the
+ * mascot props through so Jimmy stays mounted in a small row above the
+ * input bar — the main-page mascot test renders App and requires him
+ * there. The row is hidden on small screens, so the zip2 look is
+ * untouched on mobile.
+ *
+ * API shapes are zip2's: GET /api/runs returns {runs, suggestions};
+ * POST /api/runs {prompt, attachments, providerId, model}; the focused
+ * run is polled via GET /api/runs/[id] every ~1.1s for {run, events,
+ * allSteps, frame}; POST /api/runs/[id]/stop stops it. No backend code
+ * lives here — the runtime worker implements those endpoints.
+ */
+
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import { Settings, Send, Square, Paperclip, ChevronDown, X, Monitor, CheckCircle2, Plus, MessageSquare, Eye } from "lucide-react";
+import MinimalVmScreen, { type RunEvent, type Frame } from "./MinimalVmScreen";
+import MinimalSettingsPanel from "./MinimalSettingsPanel";
+
+type Run = { id: string; prompt: string; status: string; providerName?: string | null; model?: string | null; currentStep?: string | null; result?: string | null; createdAt: string; durationSec: number; attachments?: string[] };
+/** Real GET /api/providers → {catalog, providers}; providers rows are ProviderRow-shaped. */
+type ProviderRow = {
+  id: string;
+  label: string;
+  model: string;
+  enabled: boolean;
+  models: string[];
+  keyCount: number;
+  rank: number;
+  saved: boolean;
+  isFree: boolean;
+};
+type CatalogEntry = { id: string; name: string; apiStyle: string; authHeader: string; isLocal?: boolean; models?: { default?: string; popular: string[] } };
+type ProvidersData = { catalog: CatalogEntry[]; providers: ProviderRow[] };
+
+export default function MinimalHome() {
+  const [runs, setRuns] = useState<Run[]>([]);
+  const [suggestions, setSuggestions] = useState<{ label: string; prompt: string }[]>([]);
+  const [activeId, setActiveId] = useState<string | null>(null);
+  const [viewId, setViewId] = useState<string | null>(null);
+  const [events, setEvents] = useState<RunEvent[]>([]);
+  const [frame, setFrame] = useState<Frame>({ app: "desktop", browserUrl: "", fileName: "", terminalLines: [], elapsed: 0 });
+  const [input, setInput] = useState("");
+  const [attachments, setAttachments] = useState<string[]>([]);
+  const [settingsOpen, setSettingsOpen] = useState(false);
+  const [settingsTab, setSettingsTab] = useState("providers");
+  const [provData, setProvData] = useState<ProvidersData | null>(null);
+  const [pickerOpen, setPickerOpen] = useState(false);
+  const [chosen, setChosen] = useState<{ providerId: string; model: string; name: string } | null>(null);
+  const [showChat, setShowChat] = useState(false);
+  const [sending, setSending] = useState(false);
+  const [err, setErr] = useState("");
+  const fileRef = useRef<HTMLInputElement>(null);
+  const pollRef = useRef<ReturnType<typeof setInterval> | null>(null);
+
+  const loadProviders = useCallback(async () => { try { setProvData(await (await fetch("/api/providers")).json()); } catch {} }, []);
+  const loadRuns = useCallback(async () => {
+    try {
+      const d = await (await fetch("/api/runs")).json();
+      setRuns(d.runs || []); setSuggestions(d.suggestions || []);
+      const running = (d.runs || []).find((r: Run) => r.status === "running");
+      if (running) setActiveId((prev) => prev || running.id);
+      return d.runs as Run[];
+    } catch { return []; }
+  }, []);
+
+  useEffect(() => { loadProviders(); loadRuns(); }, [loadProviders, loadRuns]);
+
+  const focusId = activeId || viewId;
+  const focusRun = runs.find((r) => r.id === focusId) || null;
+  const isRunning = !!activeId && focusRun?.status === "running";
+
+  // The effective provider is the router's pick today: the lowest-ranked
+  // usable saved provider. Usable mirrors the backend's isUsableProvider /
+  // countUserProviders rule: enabled AND (has a key OR is free OR is a local
+  // catalog provider). Local catalog providers work without keys server-side.
+  const localCatalogIds = useMemo(
+    () => new Set((provData?.catalog ?? []).filter((c) => c.isLocal).map((c) => c.id)),
+    [provData],
+  );
+  const isUsable = (p: ProviderRow) =>
+    p.enabled !== false && (p.keyCount > 0 || p.isFree || localCatalogIds.has(p.id));
+  const effectiveProvider = useMemo(() => {
+    if (!provData || provData.providers.length === 0) return null;
+    const usable = provData.providers.filter(isUsable);
+    if (usable.length === 0) return null;
+    return [...usable].sort((a, b) => a.rank - b.rank)[0];
+  }, [provData, localCatalogIds]);
+
+  // Poll the focused run for live events / frame
+  useEffect(() => {
+    if (!focusId) return;
+    const tick = async () => {
+      try {
+        const d = await (await fetch(`/api/runs/${focusId}`)).json();
+        if (d.events) setEvents(d.events);
+        if (d.frame) setFrame(d.frame);
+        if (d.run) {
+          setRuns((xs) => xs.map((x) => x.id === d.run.id ? { ...x, ...d.run } : x));
+          if (d.run.status !== "running" && activeId === focusId) { setActiveId(null); loadRuns(); loadProviders(); }
+        }
+      } catch {}
+    };
+    tick();
+    if (pollRef.current) clearInterval(pollRef.current);
+    pollRef.current = setInterval(tick, 1100);
+    return () => { if (pollRef.current) clearInterval(pollRef.current); };
+  }, [focusId, activeId, loadRuns, loadProviders]);
+
+  async function send(promptOverride?: string) {
+    const prompt = (promptOverride ?? input).trim();
+    if (!prompt || sending) return;
+    setSending(true); setErr(""); setShowChat(false);
+    try {
+      const r = await fetch("/api/runs", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ prompt, attachments, providerId: chosen?.providerId, model: chosen?.model }) });
+      const d = await r.json();
+      if (!r.ok) throw new Error(d.error || "Could not start the run");
+      setInput(""); setAttachments([]);
+      setEvents([]); setViewId(null); setActiveId(d.id);
+      await loadRuns();
+    } catch (e: any) { setErr(e.message || "Could not start the run. Try again."); }
+    setSending(false);
+  }
+
+  async function stop() {
+    if (!activeId) return;
+    await fetch(`/api/runs/${activeId}/stop`, { method: "POST" });
+    setActiveId(null); loadRuns();
+  }
+
+  const pickerLabel = chosen ? `${chosen.name} / ${chosen.model}` : effectiveProvider ? `${effectiveProvider.label} / ${effectiveProvider.model}` : provData && provData.providers.length === 0 ? "No provider — add one" : "Swarm Router";
+  const completedRuns = runs.filter((r) => r.status !== "running");
+
+  return (
+    <div className="flex h-[100dvh] flex-col bg-[#f5f5f7]">
+      {/* Header — just the wordmark + the gear. Nothing else. */}
+      <header className="flex h-[52px] shrink-0 items-center gap-3 px-4 sm:px-5">
+        <div className="flex items-center gap-2.5">
+          <span className="flex h-7 w-7 items-center justify-center rounded-[8px] bg-zinc-900 text-[13px] font-bold text-white">S</span>
+          <span className="text-[15px] font-semibold tracking-tight text-zinc-900">SwarmAgents</span>
+        </div>
+        {effectiveProvider && !isRunning && <button onClick={() => { setSettingsTab("providers"); setSettingsOpen(true); }} className="ml-1 hidden items-center gap-1.5 rounded-full border border-black/[0.07] bg-white py-1 pl-2.5 pr-2 text-[12px] font-medium text-zinc-600 transition hover:border-zinc-300 md:flex"><span className="h-1.5 w-1.5 rounded-full bg-emerald-500" />{effectiveProvider.label} / {effectiveProvider.model}<ChevronDown size={12} className="text-zinc-400" /></button>}
+        <button onClick={() => { setSettingsTab("providers"); setSettingsOpen(true); }} aria-label="Settings" className="ml-auto flex h-9 w-9 items-center justify-center rounded-full border border-black/[0.06] bg-white text-zinc-600 shadow-[0_1px_4px_rgba(0,0,0,0.05)] transition hover:text-zinc-900"><Settings size={17} /></button>
+      </header>
+
+      {/* Main area — the screen is the star */}
+      <main className="mx-auto flex min-h-0 w-full max-w-[1180px] flex-1 flex-col px-3 pb-2 sm:px-5">
+        {focusRun ? (
+          <div className="flex min-h-0 flex-1 flex-col gap-2">
+            {/* Slim conversation strip while a run owns the screen */}
+            <div className="flex shrink-0 items-center gap-2">
+              <button onClick={() => setShowChat((v) => !v)} className="flex min-w-0 flex-1 items-center gap-2 rounded-full border border-black/[0.06] bg-white py-[7px] pl-3 pr-2.5 text-left shadow-[0_1px_4px_rgba(0,0,0,0.04)]">
+                <MessageSquare size={13} className="shrink-0 text-zinc-400" />
+                <span className="min-w-0 flex-1 truncate text-[13px] text-zinc-600"><span className="font-medium text-zinc-800">You:</span> {focusRun.prompt}</span>
+                <ChevronDown size={14} className={`shrink-0 text-zinc-400 transition ${showChat ? "rotate-180" : ""}`} />
+              </button>
+              {focusRun.status !== "running" && <button onClick={() => { setViewId(null); setActiveId(null); setEvents([]); }} className="flex shrink-0 items-center gap-1.5 rounded-full bg-zinc-900 px-3 py-[7px] text-[12.5px] font-medium text-white"><Plus size={13} /> New run</button>}
+            </div>
+            {showChat && (
+              <div className="max-h-[220px] shrink-0 overflow-y-auto rounded-2xl border border-black/[0.06] bg-white p-4 shadow-[0_8px_30px_rgba(0,0,0,0.07)]">
+                <Conversation runs={completedRuns} onReplay={(id) => { setViewId(id); setShowChat(false); }} compact />
+                {focusRun.result && <div className="mt-3 rounded-xl bg-zinc-50 px-3.5 py-3 text-[13px] leading-relaxed text-zinc-700">{focusRun.result}</div>}
+              </div>
+            )}
+            <div className="min-h-0 flex-1">
+              <MinimalVmScreen prompt={focusRun.prompt} events={events} frame={frame} status={focusRun.status} providerName={focusRun.providerName} model={focusRun.model} />
+            </div>
+          </div>
+        ) : runs.length > 0 ? (
+          /* No run active — the conversation owns the main area */
+          <div className="mx-auto flex min-h-0 w-full max-w-[760px] flex-1 flex-col overflow-y-auto py-4">
+            <Conversation runs={completedRuns} onReplay={(id) => setViewId(id)} />
+          </div>
+        ) : (
+          /* Calm empty state */
+          <div className="flex flex-1 flex-col items-center justify-center px-4 py-10 text-center">
+            <ComputerIllustration />
+            <h1 className="mt-6 text-[22px] font-semibold tracking-tight text-zinc-900">Start a run to watch the agent work</h1>
+            <p className="mt-1.5 max-w-[420px] text-[14px] leading-relaxed text-zinc-500">Give it a task below. You'll watch it click, type and run commands on a live computer — every action, as it happens.</p>
+            <div className="mt-6 flex max-w-[640px] flex-wrap justify-center gap-2">
+              {suggestions.map((s) => <button key={s.label} onClick={() => send(s.prompt)} className="rounded-full border border-black/[0.08] bg-white px-3.5 py-2 text-[13px] font-medium text-zinc-700 shadow-[0_1px_3px_rgba(0,0,0,0.04)] transition hover:border-[#0071e3] hover:text-[#0071e3]">{s.label}</button>)}
+            </div>
+            {!effectiveProvider && provData && <button onClick={() => { setSettingsTab("providers"); setSettingsOpen(true); }} className="mt-5 text-[13px] font-medium text-[#0071e3] hover:underline">Add a provider key to choose the model →</button>}
+          </div>
+        )}
+      </main>
+
+      {/* Input bar — pinned to the bottom */}
+      <div className="shrink-0 px-3 pb-3 sm:px-5 sm:pb-4">
+        <div className="mx-auto w-full max-w-[760px]">
+          {isRunning && focusRun && (
+            <div className="mb-2 flex items-center gap-2 px-1 text-[13px] text-zinc-600">
+              <span className="h-2 w-2 shrink-0 rounded-full bg-[#0071e3] pulse-dot" />
+              <span className="min-w-0 flex-1 truncate">Agent is {liveStatus(events, focusRun.currentStep)}</span>
+              <span className="shrink-0 tabular-nums text-zinc-400">{frame.elapsed}s</span>
+            </div>
+          )}
+          {err && <p className="mb-2 px-1 text-[13px] text-red-600">{err}</p>}
+          {attachments.length > 0 && (
+            <div className="mb-2 flex flex-wrap gap-1.5 px-1">
+              {attachments.map((a) => <span key={a} className="flex items-center gap-1.5 rounded-full bg-zinc-900 py-1 pl-2.5 pr-1.5 text-[12px] font-medium text-white">{a}<button onClick={() => setAttachments((xs) => xs.filter((x) => x !== a))} className="rounded-full p-0.5 hover:bg-white/20"><X size={11} /></button></span>)}
+            </div>
+          )}
+          <div className="rounded-[22px] border border-black/[0.08] bg-white shadow-[0_8px_32px_rgba(0,0,0,0.09)]">
+            <textarea value={input} onChange={(e) => setInput(e.target.value)} rows={2}
+              onKeyDown={(e) => { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); send(); } }}
+              placeholder={isRunning ? "Message the agent… (it will queue for the next run)" : "Give the agent a task…"}
+              className="max-h-[140px] w-full resize-none bg-transparent px-4 pb-1 pt-3.5 text-[15px] leading-relaxed text-zinc-900 placeholder:text-zinc-400 focus:outline-none" />
+            <div className="flex items-center gap-1 px-2 pb-2">
+              <input ref={fileRef} type="file" multiple className="hidden" onChange={(e) => { const names = Array.from(e.target.files || []).map((f) => f.name); setAttachments((xs) => [...xs, ...names].slice(0, 8)); e.target.value = ""; }} />
+              <button onClick={() => fileRef.current?.click()} aria-label="Attach files" title="Attach files for the agent" className="flex h-8 w-8 items-center justify-center rounded-full text-zinc-400 transition hover:bg-zinc-100 hover:text-zinc-700"><Paperclip size={17} /></button>
+
+              {/* Model / provider picker */}
+              <div className="relative">
