diff --git a/apps/swarmagents/lib/http.ts b/apps/swarmagents/lib/http.ts
new file mode 100644
index 000000000..eb012e3bd
--- /dev/null
+++ b/apps/swarmagents/lib/http.ts
@@ -0,0 +1,26 @@
+/**
+ * Minimal UI: small HTTP helpers shared by API routes.
+ *
+ * `readJsonBody` safely parses a request body. `JsonBodyError` carries the
+ * HTTP status + message the route should answer with — the caller maps it to a
+ * response (see app/api/runs/route.ts).
+ */
+
+export class JsonBodyError extends Error {
+  readonly status: number;
+
+  constructor(message: string, status = 400) {
+    super(message);
+    this.name = "JsonBodyError";
+    this.status = status;
+  }
+}
+
+/** Parse a request body as JSON, or throw `JsonBodyError(400)` on malformed input. */
+export async function readJsonBody(req: Request): Promise<unknown> {
+  try {
+    return await req.json();
+  } catch {
+    throw new JsonBodyError("Request body must be valid JSON.", 400);
+  }
+}
