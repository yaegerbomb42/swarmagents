+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { NextRequest } from "next/server";
+import { GET, POST } from "./route";
+import { TelemetryBus, type TelemetryEvent } from "../../../lib/telemetry/bus";
+import { configureRunsDir } from "../../../lib/telemetry/paths";
+import { saveProvider } from "../../../lib/providers/store";
+
+function request(url: string, user: string | null = "alice", init?: RequestInit): NextRequest {
+  const headers = new Headers(init?.headers);
+  if (user !== null) headers.set("x-swarm-user", user);
+  const { headers: _ignored, signal, ...rest } = init ?? {};
+  void _ignored;
+  return new NextRequest(`http://localhost${url}`, { ...rest, signal: signal ?? undefined, headers });
+}
+
+function seed(dir: string): void {
+  const bus = new TelemetryBus({ persist: true, runsDir: () => dir });
+  // Finished run (older): full lifecycle + final text.
+  bus.publish("run_1", { type: "run.created", data: { prompt: "build the thing", userId: "alice" } });
+  bus.publish("run_1", { type: "run.started", model: "mercury-3", provider: "inception" } as TelemetryEvent);
+  bus.publish("run_1", { type: "tool.call", name: "Bash", input: { command: "npm test" } } as TelemetryEvent);
+  bus.publish("run_1", { type: "assistant.text", text: "All done." } as TelemetryEvent);
+  bus.publish("run_1", {
+    type: "run.finished",
+    exitCode: 0,
+    sessionId: "sess_1",
+    costUsd: 0.03,
+    durationMs: 65_000,
+  } as TelemetryEvent);
+  // Live run (newer): started, no finish, with attachments.
+  bus.publish("run_2", { type: "run.created", data: { prompt: "second run", userId: "alice" } });
+  bus.publish("run_2", { type: "run.attachments", data: { attachments: ["notes.txt"] } });
+  bus.publish("run_2", { type: "run.started", model: "mercury-3", provider: "inception" } as TelemetryEvent);
+  bus.publish("run_2", { type: "tool.call", name: "Read", input: { file_path: "/src/app.ts" } } as TelemetryEvent);
+  // Another user's run: must never leak into alice's list.
+  bus.publish("run_3", { type: "run.created", data: { prompt: "bob run", userId: "bob" } });
+}
+
+function withRunsDir<T>(fn: (dir: string) => T | Promise<T>): Promise<T> {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "swarm-minimal-runs-"));
+  configureRunsDir(dir);
+  return Promise.resolve()
+    .then(() => fn(dir))
+    .finally(() => {
+      configureRunsDir(null);
+      fs.rmSync(dir, { recursive: true, force: true });
+    });
+}
+
+function withHome<T>(fn: (dir: string) => T | Promise<T>): Promise<T> {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "swarm-minimal-home-"));
+  const prevHome = process.env.SWARM_HOME;
+  process.env.SWARM_HOME = dir;
+  return Promise.resolve()
+    .then(() => fn(dir))
+    .finally(() => {
+      if (prevHome === undefined) delete process.env.SWARM_HOME;
+      else process.env.SWARM_HOME = prevHome;
+      fs.rmSync(dir, { recursive: true, force: true });
+    });
+}
+
+test("GET /api/runs returns an empty list and suggestions for a fresh user", async () => {
+  await withRunsDir(async () => {
+    const res = await GET(request("/api/runs"));
+    assert.equal(res.status, 200);
+    const body = (await res.json()) as Record<string, unknown>;
+    assert.deepEqual(body.runs, []);
+    const suggestions = body.suggestions as Array<{ label: string; prompt: string }>;
+    assert.equal(suggestions.length, 4);
+    assert.equal(suggestions[0].label, "Run the tests");
+  });
+});
+
+test("GET /api/runs returns runs newest-first with real telemetry shapes", async () => {
+  await withRunsDir(async (dir) => {
+    seed(dir);
+    const res = await GET(request("/api/runs"));
+    assert.equal(res.status, 200);
+    const body = (await res.json()) as {
+      runs: Array<Record<string, unknown>>;
+      suggestions: Array<{ label: string; prompt: string }>;
+    };
+    assert.equal(body.runs.length, 2);
+    // Newest first: the live run_2, then the finished run_1. Bob's run_3 is absent.
+    const [live, finished] = body.runs;
+    assert.equal(live.id, "run_2");
+    assert.equal(live.status, "running");
+    assert.equal(live.currentStep, "Read /src/app.ts");
+    assert.equal(live.result, null);
+    assert.deepEqual(live.attachments, ["notes.txt"]);
+    assert.equal(live.providerName, "Inception (Mercury)");
+    assert.equal(live.model, "mercury-3");
+    assert.equal(finished.id, "run_1");
+    assert.equal(finished.status, "completed");
+    assert.equal(finished.currentStep, "Run completed in 1m 5s · $0.03");
+    assert.equal(finished.result, "All done.");
+    assert.deepEqual(finished.attachments, []);
+    assert.equal(finished.durationSec, 65);
+  });
+});
+
+test("GET /api/runs requires a signed-in user", async () => {
+  const res = await GET(request("/api/runs", null));
+  assert.equal(res.status, 401);
+});
+
+test("POST /api/runs requires a signed-in user", async () => {
+  const res = await POST(request("/api/runs", null, { method: "POST", body: JSON.stringify({ prompt: "hi" }) }));
+  assert.equal(res.status, 401);
+});
+
+test("POST /api/runs rejects a missing or empty prompt and bad JSON", async () => {
+  for (const body of ["{}", JSON.stringify({ prompt: "   " }), "not json"]) {
+    const res = await POST(request("/api/runs", "alice", { method: "POST", body }));
+    assert.equal(res.status, 400);
+  }
+});
+
+test("POST /api/runs rejects oversized attachments", async () => {
+  const res = await POST(
+    request("/api/runs", "alice", {
+      method: "POST",
+      body: JSON.stringify({ prompt: "hi", attachments: Array.from({ length: 21 }, (_, i) => `f${i}.txt`) }),
+    }),
+  );
+  assert.equal(res.status, 400);
+});
+
+test("POST /api/runs returns 503 when the user has no provider configured", async () => {
+  await withHome(async () => {
+    const res = await POST(
+      request("/api/runs", "alice", { method: "POST", body: JSON.stringify({ prompt: "do it" }) }),
+    );
+    assert.equal(res.status, 503);
+    const body = (await res.json()) as Record<string, unknown>;
+    assert.equal(body.error, "No LLM providers are configured for this account.");
+  });
+});
+
+test("POST /api/runs rejects an unknown providerId and a model no provider serves", async () => {
+  await withHome(async () => {
+    saveProvider("alice", { id: "inception", apiKey: "test-key-123" });
+    const unknown = await POST(
+      request("/api/runs", "alice", {
+        method: "POST",
+        body: JSON.stringify({ prompt: "do it", providerId: "no-such-provider" }),
+      }),
+    );
+    assert.equal(unknown.status, 400);
+    const wrongModel = await POST(
+      request("/api/runs", "alice", {
+        method: "POST",
+        body: JSON.stringify({ prompt: "do it", providerId: "inception", model: "gpt-4.1" }),
+      }),
+    );
+    assert.equal(wrongModel.status, 400);
+    const unserved = await POST(
+      request("/api/runs", "alice", { method: "POST", body: JSON.stringify({ prompt: "do it", model: "gpt-4.1" }) }),
+    );
+    assert.equal(unserved.status, 400);
+  });
+});
+
+test("POST /api/runs returns 503 when the chosen provider is disabled", async () => {
+  await withHome(async () => {
+    saveProvider("alice", { id: "inception", apiKey: "test-key-123", enabled: false });
+    const res = await POST(
+      request("/api/runs", "alice", {
+        method: "POST",
+        body: JSON.stringify({ prompt: "do it", providerId: "inception" }),
+      }),
+    );
+    assert.equal(res.status, 503);
+    const body = (await res.json()) as Record<string, unknown>;
+    assert.match(String(body.error), /no usable key/);
+  });
+});
+
+// NOTE: the 201 path (a real run via RuntimeManager.start) is deliberately not
+// unit-tested here: starting a run provisions a Docker VM and calls a live
+// provider, which this environment cannot do. It is covered by the live-test
+// brief (deploy + run a real agent on the deployed site), not by unit tests.
diff --git a/apps/swarmagents/app/api/runs/route.ts b/apps/swarmagents/app/api/runs/route.ts
new file mode 100644
index 000000000..96cca0e44
--- /dev/null
+++ b/apps/swarmagents/app/api/runs/route.ts
@@ -0,0 +1,202 @@
+/**
+ * Minimal UI runs: GET /api/runs (run history) and POST /api/runs (start a
+ * real agent run).
+ *
+ * GET returns the user's runs newest-first (limit 20) in the prototype's
+ * shape plus a static list of starter-prompt suggestions. Each run's
+ * currentStep/result/attachments come from its REAL durable telemetry log
+ * (lib/telemetry/run-log.ts) via `getRun` — nothing is fabricated. A run
+ * with no telemetry yet reports currentStep null and an empty result.
+ *
+ * POST starts a REAL run through RuntimeManager.start() — Docker VM,
+ * Claude Code CLI, the provider router — against the user's own saved
+ * providers (BYOK). The provider is the caller's explicit providerId when
+ * given (must be one of the user's saved providers), otherwise the user's
+ * highest-ranked usable saved provider. The model is the caller's explicit
+ * model when given (it must be served by one of the user's saved providers
+ * — the router resolves the provider from the model), otherwise the
+ * provider's default. durationSec is the run's real elapsed seconds at
+ * creation (0) — never a fixed estimate. When the user has no usable
+ * provider the route answers 503 with the gateway's own "No LLM providers
+ * are configured for this account" message and starts nothing.
+ *
+ * One run at a time per user: an active run (and queued prompts) are
+ * stopped first (the prototype's cancel-first behaviour), via the
+ * manager's safe-abort path.
+ *
+ * Responses are no-store.
+ */
+
+import { NextResponse, type NextRequest } from "next/server";
+import { USER_HEADER } from "@/lib/auth";
+import { JsonBodyError, readJsonBody } from "@/lib/http";
+import { getRun, listRuns } from "@/lib/runtime/run-store";
+import { getRuntimeManager } from "@/lib/runtime/manager";
+import { telemetryBus } from "@/lib/telemetry/bus";
+import { SUGGESTIONS } from "@/lib/minimal-ui/suggestions";
+import {
+  deriveCurrentStep,
+  runAttachments,
+  runResult,
+  terminalCurrentStep,
+  toMinimalRunShape,
+} from "@/lib/minimal-ui/feed";
+import {
+  configuredProviderFor,
+  defaultModelFor,
+  displayProviderName,
+  effectiveProviderFor,
+  isUsableProvider,
+  providerServingModel,
+} from "@/lib/minimal-ui/providers";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+const NO_STORE = { "Cache-Control": "no-store" } as const;
+const MAX_PROMPT_CHARS = 10_000;
+const MAX_ATTACHMENT_CHARS = 1_024;
+const MAX_ATTACHMENTS = 20;
+
+function caller(req: NextRequest): string | null {
+  const user = req.headers.get(USER_HEADER);
+  return user && user.length > 0 && user.length <= 128 ? user : null;
+}
+
+export function GET(req: NextRequest): NextResponse {
+  const user = caller(req);
+  if (!user) return NextResponse.json({ error: "Sign in required." }, { status: 401, headers: NO_STORE });
+
+  const summaries = listRuns({ userId: user, limit: 20 });
+  const runs = [];
+  for (const summary of summaries) {
+    // Each run's current step + attachments come from its real telemetry
+    // log. The list is fetched on page load (the [id] route is the hot
+    // poll path), so a full log read per listed run is the right trade for
+    // correct steps/attachments. A run with no log yet falls back to the
+    // summary synthesis (terminal step, no attachments).
+    const detail = getRun(summary.runId);
+    const events = detail?.events ?? [];
+    const currentStep =
+      events.length > 0
+        ? deriveCurrentStep(events, summary.createdAt)
+        : terminalCurrentStep(summary);
+    runs.push(toMinimalRunShape(summary, currentStep, runResult(summary), runAttachments(events)));
+  }
+  return NextResponse.json({ runs, suggestions: SUGGESTIONS }, { headers: NO_STORE });
+}
+
+export async function POST(req: NextRequest): Promise<NextResponse> {
+  const user = caller(req);
+  if (!user) return NextResponse.json({ error: "Sign in required." }, { status: 401, headers: NO_STORE });
+
+  let body: unknown;
+  try {
+    body = await readJsonBody(req);
+  } catch (error) {
+    if (error instanceof JsonBodyError) {
+      return NextResponse.json({ error: error.message }, { status: error.status, headers: NO_STORE });
+    }
+    throw error;
+  }
+  const input = (body ?? {}) as Record<string, unknown>;
+  const prompt = typeof input.prompt === "string" ? input.prompt.trim() : "";
+  if (!prompt) return NextResponse.json({ error: "prompt is required" }, { status: 400, headers: NO_STORE });
+  if (prompt.length > MAX_PROMPT_CHARS) {
+    return NextResponse.json(
+      { error: `prompt must be at most ${MAX_PROMPT_CHARS} characters` },
+      { status: 400, headers: NO_STORE },
+    );
+  }
+  const rawAttachments = Array.isArray(input.attachments) ? input.attachments : [];
+  if (rawAttachments.length > MAX_ATTACHMENTS) {
+    return NextResponse.json({ error: `too many attachments (max ${MAX_ATTACHMENTS})` }, { status: 400, headers: NO_STORE });
+  }
+  const attachments = rawAttachments.filter(
+    (a): a is string => typeof a === "string" && a.length > 0 && a.length <= MAX_ATTACHMENT_CHARS,
+  );
+  if (attachments.length !== rawAttachments.length) {
+    return NextResponse.json({ error: "attachments must be non-empty strings" }, { status: 400, headers: NO_STORE });
+  }
+  const providerId =
+    typeof input.providerId === "string" && input.providerId.length > 0 ? input.providerId : undefined;
+  const model = typeof input.model === "string" && input.model.length > 0 ? input.model : undefined;
+  if (model !== undefined && model.length > 200) {
+    return NextResponse.json({ error: "model is too long (max 200 characters)" }, { status: 400, headers: NO_STORE });
+  }
+
+  // Resolve the provider + model. The harness takes only a model — the
+  // router resolves the provider from it at call time — so a providerId
+  // override is expressed as that provider's default model. When the user
+  // has no usable provider at all the answer is the gateway's exact 503
+  // ("No LLM providers are configured for this account.") and nothing
+  // starts — the same gate as the LLM gateway, via the same usability test
+  // as `countUserProviders` (see `isUsableProvider`).
+  let providerName: string | null = null;
+  let effectiveModel: string | null = model ?? null;
+  if (providerId) {
+    const config = configuredProviderFor(user, providerId);
+    if (!config) return NextResponse.json({ error: `Unknown provider: ${providerId}` }, { status: 400, headers: NO_STORE });
+    if (!isUsableProvider(config)) {
+      return NextResponse.json(
+        { error: `Provider ${providerId} has no usable key configured` },
+        { status: 503, headers: NO_STORE },
+      );
+    }
+    providerName = displayProviderName(providerId);
+    if (!effectiveModel) {
+      effectiveModel = defaultModelFor(config);
+    } else {
+      // An explicit model with an explicit provider must be served by that
+      // provider; otherwise the router would silently pick another one.
+      const serves = providerServingModel(user, effectiveModel);
+      if (!serves || serves.providerId !== providerId) {
+        return NextResponse.json(
+          { error: `Provider ${providerId} does not serve model ${effectiveModel}` },
+          { status: 400, headers: NO_STORE },
+        );
+      }
+    }
+  } else if (effectiveModel) {
+    const serves = providerServingModel(user, effectiveModel);
+    if (!serves) {
+      return NextResponse.json(
+        { error: `No configured provider serves model ${effectiveModel}` },
+        { status: 400, headers: NO_STORE },
+      );
+    }
+    providerName = serves.providerName;
+  } else {
+    const effective = effectiveProviderFor(user);
+    if (!effective) {
+      return NextResponse.json(
+        { error: "No LLM providers are configured for this account." },
+        { status: 503, headers: NO_STORE },
+      );
+    }
+    providerName = effective.providerName;
+    effectiveModel = effective.model;
+  }
+
+  const manager = getRuntimeManager();
+  // One run at a time: stop whatever is active (and drop queued prompts) so
+  // the new run starts immediately instead of queueing behind the old one.
+  manager.cancel(user, undefined, "superseded");
+
+  // Start the run. The harness's default auto-approval behaviour applies
+  // (hard-deny and irreversible-external actions stay blocked by policy).
+  const result = manager.start(user, { prompt, model: effectiveModel ?? undefined });
+  if (!result.accepted) {
+    if (result.limit !== undefined) {
+      return NextResponse.json({ error: "Run queue is full." }, { status: 409, headers: NO_STORE });
+    }
+    return NextResponse.json({ error: result.error ?? "Could not start the run." }, { status: 503, headers: NO_STORE });
+  }
+  if (attachments.length > 0) {
+    telemetryBus.publish(result.runId, { type: "run.attachments", data: { attachments } });
+  }
+  return NextResponse.json(
+    { ok: true, id: result.runId, providerName, model: effectiveModel, durationSec: 0 },
+    { status: 201, headers: NO_STORE },
+  );
+}
