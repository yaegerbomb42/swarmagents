+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { NextRequest } from "next/server";
+import { POST } from "./route";
+import { TelemetryBus } from "../../../../../lib/telemetry/bus";
+import { configureRunsDir } from "../../../../../lib/telemetry/paths";
+
+function request(url: string, user: string | null = "alice"): NextRequest {
+  const headers = new Headers();
+  if (user !== null) headers.set("x-swarm-user", user);
+  return new NextRequest(`http://localhost${url}`, { method: "POST", headers });
+}
+
+function params(id: string) {
+  return { params: Promise.resolve({ id }) };
+}
+
+test("POST /api/runs/[id]/stop requires a signed-in user", async () => {
+  const res = await POST(request("/api/runs/run_1", null), params("run_1"));
+  assert.equal(res.status, 401);
+});
+
+test("POST /api/runs/[id]/stop is idempotent for unknown ids and other users' runs", async () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "swarm-minimal-stop-"));
+  configureRunsDir(dir);
+  try {
+    const bus = new TelemetryBus({ persist: true, runsDir: () => dir });
+    bus.publish("run_1", { type: "run.created", data: { prompt: "bob run", userId: "bob" } });
+    const unknown = await POST(request("/api/runs/nope"), params("nope"));
+    assert.equal(unknown.status, 200);
+    assert.deepEqual(await unknown.json(), { ok: true });
+    const bobs = await POST(request("/api/runs/run_1"), params("run_1"));
+    assert.equal(bobs.status, 200);
+    assert.deepEqual(await bobs.json(), { ok: true });
+  } finally {
+    configureRunsDir(null);
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+// NOTE: stopping a live run (the manager's safe-abort path) is deliberately
+// not unit-tested here: it requires a real active run with a Docker VM, which
+// this environment cannot provision. It is covered by the live-test brief.
