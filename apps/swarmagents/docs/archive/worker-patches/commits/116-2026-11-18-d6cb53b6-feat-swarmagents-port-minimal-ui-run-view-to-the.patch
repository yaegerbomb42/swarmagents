index 000000000..bf1c387f2
--- /dev/null
+++ b/apps/swarmagents/app/api/runs/[id]/route.ts
@@ -0,0 +1,67 @@
+/**
+ * Minimal UI run detail: GET /api/runs/[id].
+ *
+ * Returns the run, its REAL telemetry mapped to the prototype's step list,
+ * the full step-label list, and the live screen frame — built from the
+ * latest steps exactly like the prototype's [id] route (app = current
+ * step's app, browserUrl/fileName = latest seen, terminalLines = every
+ * terminal line, elapsed = seconds since the run started). When a real VM
+ * desktop frame is available the frame also carries a `screenshot` data
+ * URL; when no VM is attached the field is omitted and the UI renders the
+ * telemetry lines instead. Nothing is faked: a run with no telemetry yet
+ * returns empty events, an empty allSteps list, and a desktop frame with
+ * null browserUrl/fileName and no terminal lines.
+ *
+ * A run owned by another user (or an unknown id) answers 404 — the run
+ * id alone is not a capability.
+ *
+ * Poll-friendly and no-store; the screenshot fetch is only attempted for
+ * a live run (a finished run has no VM to capture).
+ */
+
+import { NextResponse, type NextRequest } from "next/server";
+import { USER_HEADER } from "@/lib/auth";
+import { getRun } from "@/lib/runtime/run-store";
+import { buildFrame, deriveCurrentStep, eventsToSteps, runAttachments, runResult, toMinimalRunShape } from "@/lib/minimal-ui/feed";
+import { captureDesktopFrame } from "@/lib/minimal-ui/screenshot";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+const NO_STORE = { "Cache-Control": "no-store" } as const;
+
+function caller(req: NextRequest): string | null {
+  const user = req.headers.get(USER_HEADER);
+  return user && user.length > 0 && user.length <= 128 ? user : null;
+}
+
+export async function GET(
+  req: NextRequest,
+  { params }: { params: Promise<{ id: string }> },
+): Promise<NextResponse> {
+  const user = caller(req);
+  if (!user) return NextResponse.json({ error: "Sign in required." }, { status: 401, headers: NO_STORE });
+
+  const { id } = await params;
+  const detail = getRun(id);
+  if (!detail || detail.summary.userId !== user) {
+    return NextResponse.json({ error: "Run not found." }, { status: 404, headers: NO_STORE });
+  }
+  const { summary, events } = detail;
+  const steps = eventsToSteps(events, summary.createdAt);
+  const frame = buildFrame(steps, summary.createdAt, summary.finishedAt ?? null, Date.now(), summary.durationMs);
+  const isLive = summary.status === "running";
+  if (isLive) {
+    const screenshot = await captureDesktopFrame(user).catch(() => null);
+    if (screenshot) frame.screenshot = screenshot;
+  }
+  return NextResponse.json(
+    {
+      run: toMinimalRunShape(summary, deriveCurrentStep(events, summary.createdAt), runResult(summary), runAttachments(events)),
+      events: steps,
+      allSteps: steps.map((s) => s.label),
+      frame,
+    },
+    { headers: NO_STORE },
+  );
+}
