@@ -0,0 +1,43 @@
+/**
+ * Minimal UI: POST /api/runs/[id]/stop — stop the real run.
+ *
+ * Uses the manager's safe-abort path (the same cancel() the run lifecycle
+ * uses): the active run is finalized as cancelled with reason "user" and
+ * its controller aborted. Idempotent: stopping an already-finished run
+ * (or a run the caller does not own) still answers {ok:true} — the UI
+ * only needs to know the run is no longer running.
+ *
+ * No-store.
+ */
+
+import { NextResponse, type NextRequest } from "next/server";
+import { USER_HEADER } from "@/lib/auth";
+import { getRun } from "@/lib/runtime/run-store";
+import { getRuntimeManager } from "@/lib/runtime/manager";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+const NO_STORE = { "Cache-Control": "no-store" } as const;
+
+function caller(req: NextRequest): string | null {
+  const user = req.headers.get(USER_HEADER);
+  return user && user.length > 0 && user.length <= 128 ? user : null;
+}
+
+export async function POST(
+  req: NextRequest,
+  { params }: { params: Promise<{ id: string }> },
+): Promise<NextResponse> {
+  const user = caller(req);
+  if (!user) return NextResponse.json({ error: "Sign in required." }, { status: 401, headers: NO_STORE });
+
+  const { id } = await params;
+  const detail = getRun(id);
+  if (!detail || detail.summary.userId !== user) {
+    // Unknown id or another user's run: still {ok:true} — idempotent.
+    return NextResponse.json({ ok: true }, { headers: NO_STORE });
+  }
+  getRuntimeManager().cancel(user, id, "user");
+  return NextResponse.json({ ok: true }, { headers: NO_STORE });
+}
