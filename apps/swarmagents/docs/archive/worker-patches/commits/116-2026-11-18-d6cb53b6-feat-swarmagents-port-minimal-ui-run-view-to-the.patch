+import test from "node:test";
+import assert from "node:assert/strict";
+import type { SequencedEvent } from "../telemetry/bus";
+import type { StoredRunSummary } from "../runtime/run-store";
+import {
+  buildFrame,
+  deriveCurrentStep,
+  eventsToSteps,
+  mapEventToStep,
+  mapRunStatus,
+  runAttachments,
+  runDurationSec,
+  runResult,
+  terminalCurrentStep,
+  toMinimalRunShape,
+} from "./feed";
+
+const T0 = 1_700_000_000_000;
+
+function ev(
+  seq: number,
+  type: string,
+  extra: Record<string, unknown> = {},
+  ts = T0 + seq * 1000,
+): SequencedEvent {
+  return { type, seq, runId: "run_1", ts, ...extra } as SequencedEvent;
+}
+
+function summary(over: Partial<StoredRunSummary> = {}): StoredRunSummary {
+  return {
+    runId: "run_1",
+    userId: "alice",
+    status: "running",
+    prompt: "do it",
+    createdAt: T0,
+    tokensIn: 0,
+    tokensOut: 0,
+    tokensCached: 0,
+    lastSeq: 0,
+    ...over,
+  };
+}
+
+test("steps map run lifecycle events to honest labels", () => {
+  assert.equal(mapEventToStep(ev(1, "run.created", { data: { prompt: "hi" } }), T0)?.label, "Run started");
+  assert.equal(
+    mapEventToStep(ev(2, "run.started", { model: "mercury-3", provider: "inception" }), T0)?.label,
+    "Agent started · inception / mercury-3",
+  );
+  assert.equal(
+    mapEventToStep(ev(3, "run.finished", { data: { durationMs: 65_000, costUsd: 0.03 } }), T0)?.label,
+    "Run completed in 1m 5s · $0.03",
+  );
+  assert.equal(mapEventToStep(ev(4, "run.error", { data: { message: "boom" } }), T0)?.label, "Run failed: boom");
+  assert.equal(mapEventToStep(ev(5, "run.cancelled"), T0)?.label, "Run stopped");
+  assert.equal(mapEventToStep(ev(6, "vm.ready", { data: { ms: 2400 } }), T0)?.label, "VM ready in 2.4s");
+  assert.equal(mapEventToStep(ev(7, "vm.starting"), T0)?.label, "Starting VM…");
+  assert.equal(mapEventToStep(ev(8, "run.queued", { data: { position: 2 } }), T0)?.label, "Queued at position 2");
+});
+
+test("steps carry the app + terminalLine/browserUrl/fileName fields", () => {
+  const bash = mapEventToStep(ev(1, "tool.call", { name: "Bash", input: { command: "npm run test:unit\nsecond line" } }), T0);
+  assert.equal(bash?.kind, "run");
+  assert.equal(bash?.app, "terminal");
+  assert.equal(bash?.label, "$ npm run test:unit");
+  assert.equal(bash?.terminalLine, "$ npm run test:unit");
+  const read = mapEventToStep(ev(2, "tool.call", { name: "Read", input: { file_path: "/src/app.ts" } }), T0);
+  assert.equal(read?.kind, "read");
+  assert.equal(read?.app, "editor");
+  assert.equal(read?.label, "Read /src/app.ts");
+  assert.equal(read?.fileName, "/src/app.ts");
+  const action = mapEventToStep(
+    ev(3, "computer.action", { action: "Clicked Publish", url: "https://example.com" }),
+    T0,
+  );
+  assert.equal(action?.kind, "click");
+  assert.equal(action?.app, "browser");
+  assert.equal(action?.browserUrl, "https://example.com");
+  const type = mapEventToStep(ev(4, "computer.action", { action: "Typed hello" }), T0);
+  assert.equal(type?.kind, "type");
+  assert.equal(type?.app, "desktop");
+});
+
+test("steps show llm routing, skip text and usage, keep failures", () => {
+  const llm = mapEventToStep(
+    ev(1, "llm.call", { data: { provider: "inception", model: "mercury-3", outcome: "ok", latencyMs: 1200, attempt: 1 } }),
+    T0,
+  );
+  assert.equal(llm?.label, "LLM inception / mercury-3 · ok");
+  assert.equal(llm?.detail, "attempt 1 · 1.2s");
+  const routed = mapEventToStep(ev(2, "route.decision", { data: { chosen: { provider: "groq", model: "gpt-oss-120b" } } }), T0);
+  assert.equal(routed?.label, "Routed to groq / gpt-oss-120b");
+  const failover = mapEventToStep(
+    ev(3, "route.failover", { data: { from: { provider: "a" }, to: { provider: "b" }, reason: "429" } }),
+    T0,
+  );
+  assert.equal(failover?.label, "Failover a → b (429)");
+  assert.equal(mapEventToStep(ev(4, "assistant.text", { text: "hello" }), T0), null);
+  assert.equal(mapEventToStep(ev(5, "usage", { inputTokens: 10 }), T0), null);
+  assert.equal(mapEventToStep(ev(6, "tool.result", { ok: true }), T0), null);
+  assert.equal(mapEventToStep(ev(7, "tool.result", { ok: false }), T0)?.label, "Tool call failed");
+  assert.equal(mapEventToStep(ev(8, "run.attachments", { data: { attachments: ["a.txt"] } }), T0), null);
+});
+
+test("steps render unknown event types as their real type, never drop them", () => {
+  const step = mapEventToStep(ev(1, "something.new", { data: { x: 1 } }), T0);
+  assert.equal(step?.label, "something.new");
+  assert.equal(step?.kind, "run");
+});
+
+test("steps truncate shell output to its first line", () => {
+  const step = mapEventToStep(ev(1, "shell.output", { data: { stream: "stdout", text: "\n\n  hello world\nsecond line\n" } }), T0);
+  assert.equal(step?.label, "hello world");
+  assert.equal(step?.terminalLine, "hello world");
+  assert.equal(mapEventToStep(ev(2, "shell.output", { data: { text: "   \n" } }), T0), null);
+});
+
+test("eventsToSteps keeps steps in order and drops non-steps", () => {
+  const steps = eventsToSteps(
+    [
+      ev(1, "run.created", { data: { prompt: "x" } }),
+      ev(2, "assistant.text", { text: "nope" }),
+      ev(3, "tool.call", { name: "Bash", input: { command: "ls" } }),
+    ],
+    T0,
+  );
+  assert.equal(steps.length, 2);
+  assert.equal(steps[0].label, "Run started");
+  assert.equal(steps[1].label, "$ ls");
+  assert.equal(steps[0].atOffsetSec, 1);
+  assert.equal(steps[1].atOffsetSec, 3);
+});
+
+test("buildFrame follows the latest steps", () => {
+  const steps = eventsToSteps(
+    [
+      ev(1, "run.created", { data: { prompt: "x" } }),
+      ev(2, "tool.call", { name: "Bash", input: { command: "npm test" } }),
+      ev(3, "computer.action", { action: "Clicked Publish", url: "https://example.com" }),
+      ev(4, "tool.call", { name: "Read", input: { file_path: "/src/app.ts" } }),
+    ],
+    T0,
+  );
+  const frame = buildFrame(steps, T0, null, T0 + 45_000);
+  assert.equal(frame.app, "editor");
+  assert.equal(frame.browserUrl, "https://example.com");
+  assert.equal(frame.fileName, "/src/app.ts");
+  assert.deepEqual(frame.terminalLines, ["$ npm test"]);
+  assert.equal(frame.elapsed, 45);
+});
+
+test("buildFrame with no steps is an honest empty desktop frame", () => {
+  const frame = buildFrame([], T0, null, T0 + 5_000);
+  assert.equal(frame.app, "desktop");
+  assert.equal(frame.browserUrl, null);
+  assert.equal(frame.fileName, null);
+  assert.deepEqual(frame.terminalLines, []);
+  assert.equal(frame.elapsed, 5);
+  assert.equal(frame.screenshot, undefined);
+});
+
+test("deriveCurrentStep is the latest step label, null with no steps", () => {
+  assert.equal(deriveCurrentStep([], T0), null);
+  assert.equal(deriveCurrentStep([ev(1, "assistant.text", { text: "x" })], T0), null);
+  assert.equal(
+    deriveCurrentStep(
+      [
+        ev(1, "run.created", { data: { prompt: "x" } }),
+        ev(2, "tool.call", { name: "Bash", input: { command: "npm test" } }),
+      ],
+      T0,
+    ),
+    "$ npm test",
+  );
+});
+
+test("mapRunStatus uses the prototype vocabulary", () => {
+  assert.equal(mapRunStatus("finished"), "completed");
+  assert.equal(mapRunStatus("cancelled"), "stopped");
+  assert.equal(mapRunStatus("error"), "stopped");
+  assert.equal(mapRunStatus("running"), "running");
+});
+
+test("runResult is the final text, an error, or a stop note", () => {
+  assert.equal(runResult(summary({ status: "finished", finalText: "All done." })), "All done.");
+  assert.equal(runResult(summary({ status: "finished" })), null);
+  assert.equal(runResult(summary({ status: "error", error: "boom" })), "boom");
+  assert.equal(runResult(summary({ status: "cancelled", cancelledReason: "user" })), "Run stopped by you.");
+  assert.equal(
+    runResult(summary({ status: "cancelled", cancelledReason: "superseded" })),
+    "Run stopped — replaced by a newer run.",
+  );
+  assert.equal(runResult(summary({ status: "running" })), null);
+});
+
+test("runDurationSec is real elapsed seconds", () => {
+  assert.equal(runDurationSec(summary({ createdAt: T0, finishedAt: T0 + 65_000 }), T0 + 70_000), 65);
+  assert.equal(runDurationSec(summary({ createdAt: T0 }), T0 + 5_000), 5);
+  // The harness's measured duration wins over the wall-clock span.
+  assert.equal(runDurationSec(summary({ createdAt: T0, finishedAt: T0 + 1_000, durationMs: 65_000 }), T0 + 70_000), 65);
+});
+
+test("runAttachments reads the run.attachments event", () => {
+  assert.deepEqual(
+    runAttachments([ev(1, "run.attachments", { data: { attachments: ["a.txt", "b.png"] } })]),
+    ["a.txt", "b.png"],
+  );
+  assert.deepEqual(runAttachments([ev(1, "run.created", { data: { prompt: "x" } })]), []);
+});
+
+test("terminalCurrentStep comes from the summary alone", () => {
+  assert.equal(
+    terminalCurrentStep(summary({ status: "finished", durationMs: 65_000, costUsd: 0.03 })),
+    "Run completed in 1m 5s · $0.03",
+  );
+  assert.equal(terminalCurrentStep(summary({ status: "error", error: "boom" })), "Run failed: boom");
+  assert.equal(terminalCurrentStep(summary({ status: "cancelled" })), "Run stopped");
+  assert.equal(terminalCurrentStep(summary({ status: "running" })), null);
+});
+
+test("toMinimalRunShape builds the list/detail run shape", () => {
+  const shape = toMinimalRunShape(
+    summary({ status: "finished", provider: "inception", model: "mercury-3", finalText: "done", durationMs: 65_000 }),
+    "Run completed in 1m 5s",
+    "done",
+    ["a.txt"],
+  );
+  assert.equal(shape.id, "run_1");
+  assert.equal(shape.status, "completed");
+  assert.equal(shape.providerName, "Inception (Mercury)");
+  assert.equal(shape.model, "mercury-3");
+  assert.equal(shape.currentStep, "Run completed in 1m 5s");
+  assert.equal(shape.result, "done");
+  assert.equal(shape.durationSec, 65);
+  assert.deepEqual(shape.attachments, ["a.txt"]);
+});
diff --git a/apps/swarmagents/lib/minimal-ui/feed.ts b/apps/swarmagents/lib/minimal-ui/feed.ts
new file mode 100644
index 000000000..52d880c79
--- /dev/null
+++ b/apps/swarmagents/lib/minimal-ui/feed.ts
@@ -0,0 +1,497 @@
+/**
+ * Minimal UI: map a run's REAL durable telemetry events to the step list,
+ * activity frame, and run summary the minimal main view renders.
+ *
+ * Source of truth is the persisted per-run JSONL telemetry log
+ * (`lib/telemetry/run-log.ts`, written by `TelemetryBus` with `persist: true`).
+ * Nothing here invents events: an event type this mapper does not recognise
+ * renders with its real type name as the label, and an event with no
+ * human-readable content is dropped from the step list (its data stays in
+ * the log). `assistant.text` events never become steps — they become the
+ * run's `result` (final text) instead.
+ *
+ * Two event shapes exist in the log and both are handled:
+ * - bus-style `{ type, data: {...} }` (run.created, llm.call, route.*,
+ *   vm.*, run.mode, …)
+ * - harness-style flat fields (tool.call `{name, input}`, assistant.text
+ *   `{text}`, computer.action `{action, …}`, run.started `{model, provider}`,
+ *   …)
+ *
+ * Status vocabulary follows the prototype: "running" | "completed" |
+ * "stopped" (real "finished" -> "completed", "cancelled"/"error" ->
+ * "stopped"; "queued"/"paused" read as "running" — neither is terminal).
+ */
+
+import type { SequencedEvent } from "../telemetry/bus";
+import type { StoredRunSummary } from "../runtime/run-store";
+import { displayProviderName } from "./providers";
+
+export type FrameApp = "desktop" | "terminal" | "browser" | "editor";
+
+export type RunEventKind =
+  | "start"
+  | "screen"
+  | "click"
+  | "type"
+  | "scroll"
+  | "read"
+  | "run"
+  | "done";
+
+export interface MinimalRunEvent {
+  id: string;
+  seq: number;
+  kind: RunEventKind;
+  label: string;
+  detail: string | null;
+  app: FrameApp;
+  atOffsetSec: number;
+  browserUrl: string | null;
+  fileName: string | null;
+  terminalLine: string | null;
+}
+
+export interface RunFrame {
+  app: FrameApp;
+  browserUrl: string | null;
+  fileName: string | null;
+  terminalLines: string[];
+  elapsed: number;
+  screenshot?: string;
+}
+
+/** Prototype status vocabulary. */
+export type MinimalRunStatus = "running" | "completed" | "stopped";
+
+export function mapRunStatus(status: StoredRunSummary["status"]): MinimalRunStatus {
+  if (status === "finished") return "completed";
+  if (status === "cancelled" || status === "error") return "stopped";
+  return "running";
+}
+
+const MAX_LABEL_CHARS = 200;
+const MAX_DETAIL_CHARS = 500;
+const MAX_RESULT_CHARS = 4000;
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/** Read a field from either the bus-style `data` object or flat top-level fields. */
+function field(event: SequencedEvent, name: string): unknown {
+  const data = (event as { data?: unknown }).data;
+  if (isRecord(data) && data[name] !== undefined) return data[name];
+  return (event as unknown as Record<string, unknown>)[name];
+}
+
+function str(value: unknown): string | undefined {
+  return typeof value === "string" && value.length > 0 ? value : undefined;
+}
+
+function num(value: unknown): number | undefined {
+  return typeof value === "number" && Number.isFinite(value) ? value : undefined;
+}
+
+function truncate(text: string, max = MAX_LABEL_CHARS): string {
+  return text.length > max ? `${text.slice(0, max - 1)}…` : text;
+}
+
+function firstLine(text: string, max = 160): string | undefined {
+  const line = text
+    .split("\n")
+    .map((l) => l.trim())
+    .find((l) => l.length > 0);
+  return line ? truncate(line, max) : undefined;
+}
+
+function formatDuration(ms: number): string {
+  const s = Math.max(0, Math.round(ms / 1000));
+  if (s < 60) return `${s}s`;
+  const m = Math.floor(s / 60);
+  if (m < 60) return `${m}m ${s % 60}s`;
+  return `${Math.floor(m / 60)}h ${m % 60}m`;
+}
+
+function describeToolCall(name: string, input: unknown): { label: string; detail: string | null } {
+  if (!isRecord(input)) return { label: name || "Tool call", detail: null };
+  const command = str(input.command);
+  if (command) {
+    return { label: `$ ${truncate(firstLine(command, 120) ?? command, 120)}`, detail: truncate(command, MAX_DETAIL_CHARS) };
+  }
+  const filePath = str(input.file_path) ?? str(input.path) ?? str(input.filePath);
+  if (filePath) return { label: `${name} ${truncate(filePath, 120)}`, detail: null };
+  const url = str(input.url);
+  if (url) return { label: `${name} ${truncate(url, 120)}`, detail: null };
+  return { label: name || "Tool call", detail: null };
+}
+
+function fileNameOf(input: unknown): string | null {
+  if (!isRecord(input)) return null;
+  return str(input.file_path) ?? str(input.path) ?? str(input.filePath) ?? str(input.pattern) ?? null;
+}
+
+/**
+ * Map one persisted telemetry event to a step, or null when the event carries
+ * nothing the step list should show (assistant text, usage counters,
+ * successful tool results, run metadata — all still in the log).
+ */
+export function mapEventToStep(event: SequencedEvent, runCreatedAtMs: number): MinimalRunEvent | null {
+  const atOffsetSec = Math.max(0, Math.floor((event.ts - runCreatedAtMs) / 1000));
+  const base = {
+    id: `ev-${event.seq}`,
+    seq: event.seq,
+    atOffsetSec,
+    browserUrl: null as string | null,
+    fileName: null as string | null,
+    terminalLine: null as string | null,
+  };
+  const step = (
+    kind: RunEventKind,
+    label: string,
+    app: FrameApp,
+    detail: string | null = null,
+    extra: Partial<MinimalRunEvent> = {},
+  ): MinimalRunEvent => ({ ...base, kind, label, detail, app, ...extra });
+
+  switch (event.type) {
+    case "run.created": {
+      const prompt = str(field(event, "prompt")) ?? "";
+      return step("start", "Run started", "desktop", prompt ? truncate(prompt, 90) : null);
+    }
+    case "run.queued": {
+      const position = num(field(event, "position"));
+      return step("start", position ? `Queued at position ${position}` : "Run queued", "desktop");
+    }
+    case "run.mode": {
+      const label = str(field(event, "label"));
+      return step("run", label ? `Mode: ${label}` : "Run mode set", "desktop");
+    }
+    case "run.started": {
+      const provider = str(field(event, "provider"));
+      const model = str(field(event, "model"));
+      const where = [provider, model].filter(Boolean).join(" / ");
+      return step("start", where ? `Agent started · ${where}` : "Agent started", "desktop");
+    }
+    case "run.finished": {
+      const ms = num(field(event, "durationMs"));
+      const cost = num(field(event, "costUsd"));
+      let label = "Run completed";
+      if (ms !== undefined) label += ` in ${formatDuration(ms)}`;
+      if (cost !== undefined && cost > 0) label += ` · $${cost.toFixed(2)}`;
+      return step("done", label, "desktop");
+    }
+    case "run.error": {
+      const message = str(field(event, "message")) ?? "unknown error";
+      return step("done", `Run failed: ${truncate(message)}`, "desktop");
+    }
+    case "run.cancelled":
+      return step("done", "Run stopped", "desktop");
+    case "run.paused":
+      return step("run", "Run paused", "desktop");
+    case "run.attachments":
+      return null;
+    case "vm.starting":
+      return step("screen", "Starting VM…", "desktop");
+    case "vm.ready": {
+      const ms = num(field(event, "ms")) ?? num(field(event, "durationMs"));
+      return step("screen", ms !== undefined ? `VM ready in ${(ms / 1000).toFixed(1)}s` : "VM ready", "desktop");
+    }
+    case "vm.error": {
+      const message = str(field(event, "message")) ?? "unknown VM error";
+      return step("screen", `VM error: ${truncate(message)}`, "desktop");
+    }
+    case "shell.output": {
+      const text = str(field(event, "text"));
+      if (!text) return null;
+      const line = firstLine(text);
+      if (!line) return null;
+      return step("run", line, "terminal", null, { terminalLine: line });
+    }
+    case "tool.call": {
+      const name = str(field(event, "name")) ?? "";
+      const input = field(event, "input");
+      if (name === "Bash") {
+        const { label, detail } = describeToolCall(name, input);
+        return step("run", label, "terminal", detail, { terminalLine: label });
+      }
+      if (name === "Read" || name === "Glob" || name === "Grep") {
+        const file = fileNameOf(input);
+        const label =
+          name === "Grep"
+            ? `Searched ${truncate(file ?? "", 120)}`
+            : name === "Glob"
+              ? `Listed ${truncate(file ?? "", 120)}`
+              : `Read ${truncate(file ?? "", 120)}`;
+        return step("read", label, "editor", null, { fileName: file });
+      }
+      if (name === "Write" || name === "Edit") {
+        const file = fileNameOf(input);
+        const label = name === "Edit" ? `Edited ${truncate(file ?? "", 120)}` : `Wrote ${truncate(file ?? "", 120)}`;
+        return step("run", label, "editor", null, { fileName: file });
+      }
+      const { label, detail } = describeToolCall(name, input);
+      return step("run", label, "desktop", detail);
+    }
+    case "tool.result": {
+      if (field(event, "ok") === false) return step("run", "Tool call failed", "desktop");
+      return null;
+    }
+    case "tool.blocked": {
+      const name = str(field(event, "name")) ?? "tool call";
+      const reason = str(field(event, "reason"));
+      return step("run", reason ? `Blocked ${name}: ${truncate(reason, 120)}` : `Blocked ${name}`, "desktop");
+    }
+    case "tool.backgrounded": {
+      const command = str(field(event, "command")) ?? "";
+      const line = firstLine(command, 120) ?? command;
+      return step("run", `Backgrounded: ${truncate(line, 120)}`, "terminal", null, {
+        terminalLine: `$ ${truncate(line, 120)}`,
+      });
+    }
+    case "computer.action": {
+      const action = str(field(event, "action")) ?? "Screen action";
+      const url = str(field(event, "url")) ?? null;
+      const target = str(field(event, "target")) ?? null;
+      const kind: RunEventKind = /^type/i.test(action) || /^press/i.test(action)
+        ? "type"
+        : /^scroll/i.test(action)
+          ? "scroll"
+          : "click";
+      return step(kind, action, url ? "browser" : "desktop", target, { browserUrl: url });
+    }
+    case "assistant.text":
+    case "usage":
+      return null;
+    case "llm.call": {
+      const provider = str(field(event, "provider")) ?? "?";
+      const model = str(field(event, "model")) ?? "?";
+      const outcome = str(field(event, "outcome")) ?? "";
+      const latency = num(field(event, "latencyMs"));
+      const attempt = num(field(event, "attempt"));
+      let label = `LLM ${provider} / ${model}`;
+      if (outcome) label += ` · ${outcome}`;
+      const detail =
+        attempt !== undefined || latency !== undefined
+          ? [`attempt ${attempt ?? "?"}`, latency !== undefined ? `${(latency / 1000).toFixed(1)}s` : null]
+              .filter(Boolean)
+              .join(" · ")
+          : null;
+      return step("run", label, "desktop", detail);
+    }
+    case "route.decision": {
+      const chosen = field(event, "chosen");
+      if (isRecord(chosen)) {
+        const provider = str(chosen.provider) ?? "?";
+        const model = str(chosen.model) ?? "?";
+        return step("run", `Routed to ${provider} / ${model}`, "desktop");
+      }
+      return step("run", "Routing…", "desktop");
+    }
+    case "route.failover": {
+      const from = field(event, "from");
+      const to = field(event, "to");
+      const reason = str(field(event, "reason")) ?? "";
+      const fromName = isRecord(from) ? (str(from.provider) ?? "?") : "?";
+      const toName = isRecord(to) ? (str(to.provider) ?? "?") : "?";
+      return step("run", reason ? `Failover ${fromName} → ${toName} (${reason})` : `Failover ${fromName} → ${toName}`, "desktop");
+    }
+    case "route.demoted": {
+      const provider = str(field(event, "provider")) ?? "?";
+      const reason = str(field(event, "reason")) ?? "";
+      return step("run", reason ? `Demoted ${provider} (${reason})` : `Demoted ${provider}`, "desktop");
+    }
+    case "capability.changed": {
+      const label = str(field(event, "label")) ?? str(field(event, "summary")) ?? "Capability changed";
+      return step("run", label, "desktop");
+    }
+    case "role.changed": {
+      const from = field(event, "from");
+      const to = field(event, "to");
+      const fromName = isRecord(from) ? (str(from.name) ?? str(from.id) ?? "?") : "?";
+      const toName = isRecord(to) ? (str(to.name) ?? str(to.id) ?? "?") : "?";
+      return step("run", `Role: ${fromName} → ${toName}`, "desktop");
+    }
+    case "approval.required":
+    case "approval.requested": {
+      const name = str(field(event, "name")) ?? str(field(event, "tool")) ?? "tool call";
+      return step("run", `Approval needed: ${name}`, "desktop");
+    }
+    case "approval.resolved": {
+      const verdict = str(field(event, "verdict")) ?? "";
+      return step("run", verdict ? `Approval ${verdict}` : "Approval resolved", "desktop");
+    }
+    case "approval.timeout":
+      return step("run", "Approval timed out", "desktop");
+    case "question.required":
+      return step("run", "Agent asked a question", "desktop");
+    case "question.resolved": {
+      const status = str(field(event, "status")) ?? "";
+      return step("run", status ? `Question ${status}` : "Question resolved", "desktop");
+    }
+    case "handoff.required":
+      return step("run", "Handoff requested", "desktop");
+    case "handoff.resolved": {
+      const status = str(field(event, "status")) ?? "";
+      return step("run", status ? `Handoff ${status}` : "Handoff resolved", "desktop");
+    }
+    case "checkpoint.created": {
+      const label = str(field(event, "label")) ?? "";
+      return step("run", label ? `Checkpoint ${label}` : "Checkpoint created", "desktop");
+    }
+    case "checkpoint.failed": {
+      const message = str(field(event, "message")) ?? "";
+      return step("run", message ? `Checkpoint failed: ${truncate(message)}` : "Checkpoint failed", "desktop");
+    }
+    default:
+      // Never silently drop a real event: unknown types render as their type.
+      return step("run", event.type, "desktop");
+  }
+}
+
+/** Map a run's events to steps, oldest first. */
+export function eventsToSteps(
+  events: readonly SequencedEvent[],
+  runCreatedAtMs: number,
+): MinimalRunEvent[] {
+  const steps: MinimalRunEvent[] = [];
+  for (const event of events) {
+    const step = mapEventToStep(event, runCreatedAtMs);
+    if (step) steps.push(step);
+  }
+  return steps;
+}
+
+/** What the agent is doing right now, from the most recent step. Null when nothing has happened yet. */
+export function deriveCurrentStep(events: readonly SequencedEvent[], runCreatedAtMs: number): string | null {
+  const steps = eventsToSteps(events, runCreatedAtMs);
+  return steps.length > 0 ? steps[steps.length - 1].label : null;
+}
+
+/** Current step for a terminal run, from the summary alone (no log read needed). */
+export function terminalCurrentStep(summary: StoredRunSummary): string | null {
+  if (summary.status === "finished") {
+    const ms = summary.durationMs;
+    const cost = summary.costUsd;
+    let label = "Run completed";
+    if (ms !== undefined) label += ` in ${formatDuration(ms)}`;
+    if (cost !== undefined && cost > 0) label += ` · $${cost.toFixed(2)}`;
+    return label;
+  }
+  if (summary.status === "error") return `Run failed: ${truncate(summary.error ?? "unknown error")}`;
+  if (summary.status === "cancelled") return "Run stopped";
+  return null;
+}
+
+/** The run shape the minimal UI's list + detail routes return. */
+export interface MinimalRunShape {
+  id: string;
+  prompt: string;
+  status: MinimalRunStatus;
+  providerName: string | null;
+  model: string | null;
+  currentStep: string | null;
+  result: string | null;
+  createdAt: number;
+  durationSec: number;
+  attachments: string[];
+}
+
+/** Build a run shape from its stored summary + derived step/result/attachments. */
+export function toMinimalRunShape(
+  summary: StoredRunSummary,
+  currentStep: string | null,
+  result: string | null,
+  attachments: string[],
+): MinimalRunShape {
+  return {
+    id: summary.runId,
+    prompt: summary.prompt,
+    status: mapRunStatus(summary.status),
+    providerName: summary.provider ? displayProviderName(summary.provider) : null,
+    model: summary.model ?? null,
+    currentStep,
+    result,
+    createdAt: summary.createdAt,
+    durationSec: runDurationSec(summary, Date.now()),
+    attachments,
+  };
+}
+
+/** The run's result text: the assistant's final text, an error, or a stop note. Null while running. */
+export function runResult(summary: StoredRunSummary): string | null {
+  if (summary.status === "finished") {
+    return summary.finalText ? truncate(summary.finalText, MAX_RESULT_CHARS) : null;
+  }
+  if (summary.status === "error") return summary.error ?? "Run failed.";
+  if (summary.status === "cancelled") {
+    if (summary.cancelledReason === "superseded") return "Run stopped — replaced by a newer run.";
+    if (summary.cancelledReason === "shutdown") return "Run stopped (server shutdown).";
+    return "Run stopped by you.";
+  }
+  return null;
+}
+
+/**
+ * Real elapsed seconds: the harness's own measured duration when present,
+ * otherwise finishedAt (or now for a live run) minus createdAt.
+ */
+export function runDurationSec(summary: StoredRunSummary, nowMs: number): number {
+  if (summary.durationMs !== undefined) return Math.max(0, Math.floor(summary.durationMs / 1000));
+  const end = summary.finishedAt ?? nowMs;
+  return Math.max(0, Math.floor((end - summary.createdAt) / 1000));
+}
+
+/**
+ * Attachments recorded for the run (a `run.attachments` event published at
+ * start time — see POST /api/runs). Empty when the run has none.
+ */
+export function runAttachments(events: readonly SequencedEvent[]): string[] {
+  for (const event of events) {
+    if (event.type !== "run.attachments") continue;
+    const data = (event as { data?: unknown }).data;
+    if (isRecord(data) && Array.isArray(data.attachments)) {
+      return data.attachments.filter((a): a is string => typeof a === "string");
+    }
+  }
+  return [];
+}
+
+/**
+ * Build the live screen frame from a run's steps — same construction as the
+ * prototype's [id] route: app = current step's app, browserUrl/fileName =
+ * latest seen, terminalLines = every terminal line, elapsed = seconds since
+ * the run started. When nothing has been seen yet the fields are null/empty
+ * (never placeholder text — the UI renders an honest empty state).
+ */
+export function buildFrame(
+  steps: readonly MinimalRunEvent[],
+  runCreatedAtMs: number,
+  finishedAtMs: number | null,
+  nowMs: number,
+  durationMs?: number,
+): RunFrame {
+  const current = steps[steps.length - 1];
+  let browserUrl: string | null = null;
+  let fileName: string | null = null;
+  for (let i = steps.length - 1; i >= 0; i--) {
+    if (browserUrl === null && steps[i].browserUrl) browserUrl = steps[i].browserUrl;
+    if (fileName === null && steps[i].fileName) fileName = steps[i].fileName;
+    if (browserUrl !== null && fileName !== null) break;
+  }
+  const terminalLines = steps
+    .map((s) => s.terminalLine)
+    .filter((l): l is string => l !== null);
+  // The harness's measured duration is the real elapsed for a finished run;
+  // otherwise it is the wall-clock span from creation.
+  const elapsed =
+    durationMs !== undefined
+      ? Math.max(0, Math.floor(durationMs / 1000))
+      : Math.max(0, Math.floor(((finishedAtMs ?? nowMs) - runCreatedAtMs) / 1000));
+  return {
+    app: current?.app ?? "desktop",
+    browserUrl,
+    fileName,
+    terminalLines,
+    elapsed,
+  };
+}
diff --git a/apps/swarmagents/lib/minimal-ui/providers.ts b/apps/swarmagents/lib/minimal-ui/providers.ts
new file mode 100644
index 000000000..dcd4cc1f4
--- /dev/null
+++ b/apps/swarmagents/lib/minimal-ui/providers.ts
@@ -0,0 +1,106 @@
+/**
+ * Minimal UI: resolve which provider (and model) a run should use, from the
+ * user's own saved BYOK providers — never from host env.
+ *
+ * The effective provider is the user's highest-ranked usable saved provider
+ * (rank ascends = tried first; that is the router's own user-rank tiebreaker
+ * — see `orderLlmCandidates` in lib/providers/router.ts). A saved provider
+ * is usable when it is enabled and either holds a key or is a keyless local
+ * provider — the same test as `countUserProviders` in lib/providers/store.ts,
+ * which is the authority for the "no providers" 503.
+ *
+ * Model choice: the caller's explicit model wins; otherwise the provider's
+ * catalog default (the BYOK fix points Inception at mercury-3), then a saved
+ * tier model.
+ */
+
+import { catalogEntry } from "../providers/catalog";
+import type { ProviderConfig } from "../providers/types";
+import { readConfiguredProviders } from "../providers/store";
+
+export interface EffectiveProvider {
+  providerId: string;
+  providerName: string;
+  model: string | null;
+}
+
+/** Display name for a provider id (catalog name, else the id itself). */
+export function displayProviderName(providerId: string): string {
+  return catalogEntry(providerId)?.name ?? providerId;
+}
+
+/** Same usability test as `countUserProviders` (lib/providers/store.ts). */
+export function isUsableProvider(config: ProviderConfig): boolean {
+  return (
+    config.enabled !== false &&
+    ((config.keys?.length ?? 0) > 0 || catalogEntry(config.id)?.isLocal === true)
+  );
+}
+
+export function defaultModelFor(config: ProviderConfig): string | null {
+  const entry = catalogEntry(config.id);
+  if (entry?.models?.default) return entry.models.default;
+  const models = config.models;
+  if (models) {
+    if (models.balanced) return models.balanced;
+    if (models.fast) return models.fast;
+    if (models.deep) return models.deep;
+  }
+  return null;
+}
+
+/**
+ * The provider a run should use when the caller does not pick one: the
+ * user's highest-ranked usable saved provider. Null when the user has no
+ * usable provider (the caller must answer 503 — see `countUserProviders`).
+ */
+export function effectiveProviderFor(userId: string): EffectiveProvider | null {
+  const usable = readConfiguredProviders(userId).filter(isUsableProvider);
+  if (usable.length === 0) return null;
+  const ordered = [...usable].sort((a, b) => (a.rank ?? Infinity) - (b.rank ?? Infinity));
+  const first = ordered[0];
+  return {
+    providerId: first.id,
+    providerName: displayProviderName(first.id),
+    model: defaultModelFor(first),
+  };
+}
+
+/** Look a saved provider up by id (for a caller's explicit providerId override). */
+export function configuredProviderFor(userId: string, providerId: string): ProviderConfig | null {
+  const found = readConfiguredProviders(userId).find((c) => c.id === providerId);
+  return found ?? null;
+}
+
+/** Models a saved provider is known to serve: catalog default/popular + saved tier models. */
+export function modelsServedBy(config: ProviderConfig): string[] {
+  const served = new Set<string>();
+  const entry = catalogEntry(config.id);
+  if (entry?.models?.default) served.add(entry.models.default);
+  if (entry?.models?.popular) {
+    for (const m of entry.models.popular) served.add(m);
+  }
+  const models = config.models;
+  if (models) {
+    for (const tier of Object.values(models)) {
+      if (tier) served.add(tier);
+    }
+  }
+  return [...served];
+}
+
+/**
+ * The user's highest-ranked usable saved provider that serves a model
+ * (the router resolves the provider from the model at call time, so this
+ * is how an explicit model override is validated + named). Null when no
+ * usable saved provider serves it.
+ */
+export function providerServingModel(userId: string, model: string): EffectiveProvider | null {
+  const usable = readConfiguredProviders(userId)
+    .filter(isUsableProvider)
+    .filter((c) => modelsServedBy(c).includes(model));
+  if (usable.length === 0) return null;
+  const ordered = [...usable].sort((a, b) => (a.rank ?? Infinity) - (b.rank ?? Infinity));
+  const first = ordered[0];
+  return { providerId: first.id, providerName: displayProviderName(first.id), model };
+}
