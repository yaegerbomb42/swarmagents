@@ -0,0 +1,54 @@
+/**
+ * Minimal UI: capture the live VM desktop frame, when one is attached.
+ *
+ * Uses the SAME mechanism as the pre-existing
+ * GET /api/runtime/vm/screenshot route: `scrot` grabs the current X
+ * display (:1) inside the user's own VM and the driver reads the file
+ * back. A frame is only produced when the VM is running; otherwise this
+ * returns null and the caller omits the screenshot (the UI renders the
+ * telemetry lines instead). A null here is an honest "no VM attached",
+ * never a placeholder image.
+ *
+ * The frame is returned as a data URL so the UI can render it without a
+ * second fetch. Frames can be large, so callers must not poll this path
+ * at high frequency; the [id] route is the only caller and it only
+ * attempts a capture for a live run.
+ */
+
+import { randomUUID } from "node:crypto";
+import { getVmManager } from "../vm/manager";
+import { DESKTOP_DISPLAY } from "../vm/docker-driver";
+
+/** Per-request frame path inside the VM: never a shared /tmp file. The 1600x900 desktop frame as PNG is well under 2 MB. */
+const SCREENSHOT_PREFIX = "/tmp/swarm-desktop-frame-";
+const MAX_SCREENSHOT_BYTES = 4 * 1024 * 1024;
+
+/** Return a data URL for the VM's current desktop frame, or null when no VM is attached. */
+export async function captureDesktopFrame(userId: string): Promise<string | null> {
+  const vm = getVmManager();
+  try {
+    const state = await vm.status(userId);
+    // Only a running VM has a live desktop to capture.
+    if (state.status !== "running") return null;
+    const screenshotPath = `${SCREENSHOT_PREFIX}${randomUUID()}.png`;
+    const exec = await vm.exec(userId, ["scrot", "-o", screenshotPath], {
+      env: { DISPLAY: DESKTOP_DISPLAY },
+    });
+    if (exec.exitCode !== 0) return null;
+    let file;
+    try {
+      file = await vm.readFileBytes(userId, screenshotPath, MAX_SCREENSHOT_BYTES);
+    } finally {
+      // Delete the frame inside the VM immediately after the read, even if
+      // the read failed. Best effort: a VM that just died has nothing to
+      // clean up.
+      await vm.exec(userId, ["rm", "-f", "--", screenshotPath]).catch(() => undefined);
+    }
+    if (file.content.byteLength === 0) return null;
+    return `data:image/png;base64,${Buffer.from(file.content).toString("base64")}`;
+  } catch {
+    // Any failure (VM missing, unsupported driver, quota, …) degrades to
+    // the "no frame" case rather than surfacing an error.
+    return null;
+  }
+}
