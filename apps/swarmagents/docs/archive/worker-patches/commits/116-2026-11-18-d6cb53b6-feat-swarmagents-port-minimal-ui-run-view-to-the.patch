+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { NextRequest } from "next/server";
+import { GET } from "./route";
+import { TelemetryBus, type TelemetryEvent } from "../../../../lib/telemetry/bus";
+import { configureRunsDir } from "../../../../lib/telemetry/paths";
+
+function request(url: string, user: string | null = "alice"): NextRequest {
+  const headers = new Headers();
+  if (user !== null) headers.set("x-swarm-user", user);
+  return new NextRequest(`http://localhost${url}`, { headers });
+}
+
+function params(id: string) {
+  return { params: Promise.resolve({ id }) };
+}
+
+function seed(dir: string): void {
+  const bus = new TelemetryBus({ persist: true, runsDir: () => dir });
+  bus.publish("run_1", { type: "run.created", data: { prompt: "build the thing", userId: "alice" } });
+  bus.publish("run_1", { type: "run.started", model: "mercury-3", provider: "inception" } as TelemetryEvent);
+  bus.publish("run_1", { type: "tool.call", name: "Bash", input: { command: "npm test" } } as TelemetryEvent);
+  bus.publish("run_1", { type: "shell.output", data: { stream: "stdout", text: "12 passing\n" } });
+  bus.publish("run_1", { type: "computer.action", action: "Clicked Publish", url: "https://example.com" } as TelemetryEvent);
+  bus.publish("run_1", { type: "tool.call", name: "Read", input: { file_path: "/src/app.ts" } } as TelemetryEvent);
+  bus.publish("run_1", { type: "assistant.text", text: "All done." } as TelemetryEvent);
+  bus.publish("run_1", {
+    type: "run.finished",
+    exitCode: 0,
+    sessionId: "sess_1",
+    costUsd: 0.03,
+    durationMs: 65_000,
+  } as TelemetryEvent);
+  bus.publish("run_2", { type: "run.created", data: { prompt: "live run", userId: "alice" } });
+  bus.publish("run_2", { type: "tool.call", name: "Bash", input: { command: "ls" } } as TelemetryEvent);
+  bus.publish("run_3", { type: "run.created", data: { prompt: "bob run", userId: "bob" } });
+}
+
+function withRunsDir<T>(fn: (dir: string) => T | Promise<T>): Promise<T> {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "swarm-minimal-runid-"));
+  configureRunsDir(dir);
+  return Promise.resolve()
+    .then(() => fn(dir))
+    .finally(() => {
+      configureRunsDir(null);
+      fs.rmSync(dir, { recursive: true, force: true });
+    });
+}
+
+test("GET /api/runs/[id] returns the run, real steps, and the frame", async () => {
+  await withRunsDir(async (dir) => {
+    seed(dir);
+    const res = await GET(request("/api/runs/run_1"), params("run_1"));
+    assert.equal(res.status, 200);
+    const body = (await res.json()) as {
+      run: Record<string, unknown>;
+      events: Array<Record<string, unknown>>;
+      allSteps: string[];
+      frame: Record<string, unknown>;
+    };
+    assert.equal(body.run.id, "run_1");
+    assert.equal(body.run.status, "completed");
+    assert.equal(body.run.result, "All done.");
+    assert.deepEqual(
+      body.events.map((e) => e.label),
+      [
+        "Run started",
+        "Agent started · inception / mercury-3",
+        "$ npm test",
+        "12 passing",
+        "Clicked Publish",
+        "Read /src/app.ts",
+        "Run completed in 1m 5s · $0.03",
+      ],
+    );
+    assert.deepEqual(body.allSteps, body.events.map((e) => e.label));
+    // The frame's app is the LAST step's app — the run.finished step is a
+    // desktop step, so a finished run frames as desktop even though the
+    // last content step was the editor. browserUrl/fileName still come from
+    // the latest steps that carried them.
+    assert.equal(body.frame.app, "desktop");
+    assert.equal(body.frame.browserUrl, "https://example.com");
+    assert.equal(body.frame.fileName, "/src/app.ts");
+    assert.deepEqual(body.frame.terminalLines, ["$ npm test", "12 passing"]);
+    assert.equal(body.frame.elapsed, 65);
+    // No VM is attached in this environment, so no screenshot — and no fake one.
+    assert.equal(body.frame.screenshot, undefined);
+  });
+});
+
+test("GET /api/runs/[id] for a live run reports its live step and no screenshot without a VM", async () => {
+  await withRunsDir(async (dir) => {
+    seed(dir);
+    const res = await GET(request("/api/runs/run_2"), params("run_2"));
+    assert.equal(res.status, 200);
+    const body = (await res.json()) as {
+      run: Record<string, unknown>;
+      events: Array<Record<string, unknown>>;
+      frame: Record<string, unknown>;
+    };
+    assert.equal(body.run.status, "running");
+    assert.equal(body.run.currentStep, "$ ls");
+    assert.equal(body.frame.app, "terminal");
+    assert.equal(body.frame.screenshot, undefined);
+  });
+});
+
+test("GET /api/runs/[id] 404s for unknown ids and other users' runs", async () => {
+  await withRunsDir(async (dir) => {
+    seed(dir);
+    const missing = await GET(request("/api/runs/nope"), params("nope"));
+    assert.equal(missing.status, 404);
+    const bobs = await GET(request("/api/runs/run_3"), params("run_3"));
+    assert.equal(bobs.status, 404);
+  });
+});
+
+test("GET /api/runs/[id] requires a signed-in user", async () => {
+  const res = await GET(request("/api/runs/run_1", null), params("run_1"));
+  assert.equal(res.status, 401);
+});
