+function parseHostHeader(hostHeader: string | undefined): { hostname: string; port: string | null } {
+  const raw = (hostHeader ?? "").trim();
+  if (!raw) return { hostname: "", port: null };
+  if (raw.startsWith("[")) {
+    const end = raw.indexOf("]");
+    if (end >= 0) {
+      const hostname = raw.slice(0, end + 1).toLowerCase();
+      const rest = raw.slice(end + 1);
+      const port = rest.startsWith(":") ? rest.slice(1) : null;
+      return { hostname, port };
     }
   }
+  const parts = raw.split(":");
+  return { hostname: parts[0].toLowerCase(), port: parts[1] ?? null };
+}
+
+function parseAllowedEntry(
+  entry: string,
+  fallbackProto: string,
+): { hasScheme: boolean; protocol: string; hostname: string; port: string | null } | null {
+  const trimmed = entry.trim();
+  if (!trimmed) return null;
+  const hasScheme = /^https?:\/\//i.test(trimmed);
+  try {
+    const u = new URL(hasScheme ? trimmed : `${fallbackProto}//${trimmed}`);
+    const defaultPort = u.protocol === "https:" ? "443" : "80";
+    return {
+      hasScheme,
+      protocol: hasScheme ? u.protocol : fallbackProto,
+      hostname: u.hostname.toLowerCase(),
+      port: u.port || (hasScheme ? defaultPort : null),
+    };
+  } catch {
+    return null;
+  }
+}
+
+function originAllowed(req: IncomingMessage): boolean {
+  const origin = req.headers.origin;
+  if (!origin) return true; // non-browser client; cookie auth still required
+  try {
+    const originUrl = new URL(origin);
+    const originProto = originUrl.protocol.toLowerCase();
+    const originHostname = originUrl.hostname.toLowerCase();
+    const originPort = originUrl.port || (originProto === "https:" ? "443" : "80");
+
+    const hostHeader = Array.isArray(req.headers.host) ? req.headers.host[0] : req.headers.host;
+    const reqProto = "http:";
+    const hostInfo = parseHostHeader(hostHeader);
+    if (!hostInfo.hostname) return false;
+    const hostPort = hostInfo.port || "80";
+
+    if (
+      originProto === reqProto &&
+      originHostname === hostInfo.hostname &&
+      originPort === hostPort
+    ) {
+      return true;
+    }
+
+    const allowed = (process.env.SWARM_ALLOWED_HOSTS ?? "")
+      .split(",")
+      .map((h) => h.trim())
+      .filter(Boolean);
+
+    for (const entry of allowed) {
+      const target = parseAllowedEntry(entry, reqProto);
+      if (!target) continue;
+      if (originHostname !== target.hostname) continue;
+      if (target.hasScheme) {
+        if (originProto !== target.protocol) continue;
+      } else {
+        if (originProto !== reqProto) continue;
+      }
+      const expectedPort = target.port ?? hostPort;
+      if (originPort === expectedPort) return true;
+    }
+    return false;
+  } catch {
+    return false; // malformed Origin cannot be trusted
+  }
+}
 
