+test("desktop proxy: IPv6 Host header passes same-origin", async () => {
+  const prevAllowed = process.env.SWARM_ALLOWED_HOSTS;
+  process.env.SWARM_ALLOWED_HOSTS = "127.0.0.1,[::1]";
+  const { proxy, port, aliceVm } = await makeProxy();
+  aliceVm.assets.set("/vnc.html", "<html>ipv6 vnc</html>");
+  try {
+    const res = await new Promise<{ status: number; body: string }>((resolve, reject) => {
+      const req = http.request(
+        {
+          host: "127.0.0.1",
+          port,
+          path: "/desktop/vnc.html",
+          method: "GET",
+          headers: {
+            host: `[::1]:${port}`,
+            origin: `http://[::1]:${port}`,
+            cookie: sessionFor("alice"),
+          },
+        },
+        (r) => {
+          let body = "";
+          r.on("data", (chunk) => (body += chunk));
+          r.on("end", () => resolve({ status: r.statusCode ?? 0, body }));
+        },
+      );
+      req.on("error", reject);
+      req.end();
+    });
+    assert.equal(res.status, 200);
+    assert.equal(res.body, "<html>ipv6 vnc</html>");
+  } finally {
+    if (prevAllowed === undefined) delete process.env.SWARM_ALLOWED_HOSTS;
+    else process.env.SWARM_ALLOWED_HOSTS = prevAllowed;
+    await proxy.close();
+  }
+});
