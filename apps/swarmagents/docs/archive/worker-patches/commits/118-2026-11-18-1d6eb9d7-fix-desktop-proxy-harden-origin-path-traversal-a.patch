+test("desktop proxy: origin check enforces scheme and port", async () => {
+  const { proxy, port, aliceVm } = await makeProxy();
+  aliceVm.assets.set("/vnc.html", "<html>vnc</html>");
+  try {
+    // 1. https origin when Host is http must be rejected with 403
+    const httpsOrigin = await new Promise<{ status: number; body: string }>((resolve, reject) => {
+      const req = http.request(
+        {
+          host: "127.0.0.1",
+          port,
+          path: "/desktop/vnc.html",
+          method: "GET",
+          headers: {
+            host: `127.0.0.1:${port}`,
+            origin: `https://127.0.0.1:${port}`,
+            cookie: sessionFor("alice"),
+          },
+        },
+        (r) => {
+          let body = "";
+          r.on("data", (chunk) => (body += chunk));
+          r.on("end", () => resolve({ status: r.statusCode ?? 0, body }));
+        },
+      );
+      req.on("error", reject);
+      req.end();
+    });
+    assert.equal(httpsOrigin.status, 403);
+    assert.equal(httpsOrigin.body, "Cross-site request blocked.");
+
+    // 2. wrong port must be rejected with 403
+    const wrongPort = await new Promise<{ status: number; body: string }>((resolve, reject) => {
+      const req = http.request(
+        {
+          host: "127.0.0.1",
+          port,
+          path: "/desktop/vnc.html",
+          method: "GET",
+          headers: {
+            host: `127.0.0.1:${port}`,
+            origin: `http://127.0.0.1:9999`,
+            cookie: sessionFor("alice"),
+          },
+        },
+        (r) => {
+          let body = "";
+          r.on("data", (chunk) => (body += chunk));
+          r.on("end", () => resolve({ status: r.statusCode ?? 0, body }));
+        },
+      );
+      req.on("error", reject);
+      req.end();
+    });
+    assert.equal(wrongPort.status, 403);
+    assert.equal(wrongPort.body, "Cross-site request blocked.");
+
+    // 3. SWARM_ALLOWED_HOSTS wrong port or wrong scheme must be rejected
+    const prevAllowed = process.env.SWARM_ALLOWED_HOSTS;
+    process.env.SWARM_ALLOWED_HOSTS = "127.0.0.1,swarm.example.com";
+    try {
+      const allowedWrongPort = await new Promise<{ status: number; body: string }>((resolve, reject) => {
+        const req = http.request(
+          {
+            host: "127.0.0.1",
+            port,
+            path: "/desktop/vnc.html",
+            method: "GET",
+            headers: {
+              host: `127.0.0.1:${port}`,
+              origin: `http://swarm.example.com:9999`,
+              cookie: sessionFor("alice"),
+            },
+          },
+          (r) => {
+            let body = "";
+            r.on("data", (chunk) => (body += chunk));
+            r.on("end", () => resolve({ status: r.statusCode ?? 0, body }));
+          },
+        );
+        req.on("error", reject);
+        req.end();
+      });
+      assert.equal(allowedWrongPort.status, 403);
+
+      const allowedWrongScheme = await new Promise<{ status: number; body: string }>((resolve, reject) => {
+        const req = http.request(
+          {
+            host: "127.0.0.1",
+            port,
+            path: "/desktop/vnc.html",
+            method: "GET",
+            headers: {
+              host: `127.0.0.1:${port}`,
+              origin: `https://swarm.example.com:${port}`,
+              cookie: sessionFor("alice"),
+            },
+          },
+          (r) => {
+            let body = "";
+            r.on("data", (chunk) => (body += chunk));
+            r.on("end", () => resolve({ status: r.statusCode ?? 0, body }));
+          },
+        );
+        req.on("error", reject);
+        req.end();
+      });
+      assert.equal(allowedWrongScheme.status, 403);
+
+      // And matching allowed host works
+      const allowedMatch = await new Promise<{ status: number; body: string }>((resolve, reject) => {
+        const req = http.request(
+          {
+            host: "127.0.0.1",
+            port,
+            path: "/desktop/vnc.html",
+            method: "GET",
+            headers: {
+              host: `127.0.0.1:${port}`,
+              origin: `http://swarm.example.com:${port}`,
+              cookie: sessionFor("alice"),
+            },
+          },
+          (r) => {
+            let body = "";
+            r.on("data", (chunk) => (body += chunk));
+            r.on("end", () => resolve({ status: r.statusCode ?? 0, body }));
+          },
+        );
+        req.on("error", reject);
+        req.end();
+      });
+      assert.equal(allowedMatch.status, 200);
+    } finally {
+      if (prevAllowed === undefined) delete process.env.SWARM_ALLOWED_HOSTS;
+      else process.env.SWARM_ALLOWED_HOSTS = prevAllowed;
+    }
+  } finally {
+    await proxy.close();
+  }
+});
