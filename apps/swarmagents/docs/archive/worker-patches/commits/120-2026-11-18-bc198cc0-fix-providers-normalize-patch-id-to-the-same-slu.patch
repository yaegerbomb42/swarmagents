   }
-  const id = (body as Record<string, unknown>).id;
-  if (typeof id !== "string" || id.trim() === "") {
+  const rawId = (body as Record<string, unknown>).id;
+  if (typeof rawId !== "string") {
     return NextResponse.json({ error: "id is required." }, { status: 400 });
   }
+  // Normalize the id the same way POST does, so PATCH resolves a mixed-case
+  // id ("OpenAI") to the same saved provider ("openai") and never mints a
+  // second one. The store re-normalizes, so this is idempotent; it also keeps
+  // the audit target and error messages on the canonical slug.
+  const id = rawId.trim().toLowerCase().replace(/[^a-z0-9-]+/g, "-").replace(/^-+|-+$/g, "");
+  if (!id || id.length > 64) {
+    return NextResponse.json({ error: "id must be a slug (a-z, 0-9, dashes)." }, { status: 400 });
+  }
   const input = body as Record<string, unknown>;
 
   // Endpoint/model/capability edits share this route with key mutations so the
@@ -341,6 +349,8 @@ export async function PATCH(request: Request) {
     if (modelCapabilities === null) {
       return NextResponse.json({ error: "Invalid capability overrides." }, { status: 400 });
     }
+    // An explicit baseUrl: "" clears the stored base URL (the store treats an
