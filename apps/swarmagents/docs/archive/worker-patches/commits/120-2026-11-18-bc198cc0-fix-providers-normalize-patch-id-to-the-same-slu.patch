From: yaegerbomb42 <yaeger.james42@gmail.com>
Date: Wed, 18 Nov 2026 11:33:05 -0600
Subject: [PATCH] fix(providers): normalize PATCH id to the same slug POST uses

PATCH /api/providers resolved the raw body id, relying on store-level
normalization to match a saved provider. Mirror POST's slug handling at the
route boundary so a mixed-case id ("OpenAI") resolves to the same provider
("openai") and the audit target / error messages carry the canonical slug.
An explicit baseUrl: "" continues to clear the stored base URL.

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 .../app/api/providers/route.test.ts           | 38 +++++++++++++++++++
 apps/swarmagents/app/api/providers/route.ts   | 14 ++++++-
 2 files changed, 50 insertions(+), 2 deletions(-)

diff --git a/apps/swarmagents/app/api/providers/route.test.ts b/apps/swarmagents/app/api/providers/route.test.ts
index 97838a3dc..235d44132 100644
--- a/apps/swarmagents/app/api/providers/route.test.ts
+++ b/apps/swarmagents/app/api/providers/route.test.ts
@@ -317,6 +317,44 @@ test("POST and PATCH normalize legacy apiStyle aliases to openai-chat", async ()
   assert.equal(updated?.baseUrl, "https://gw.example.com/v1");
 });
 
+test("PATCH resolves a mixed-case id to the same provider POST saved", async () => {
+  await post({ id: "openai", apiKey: "sk-openai-mixed" });
+
+  // set-endpoint with a differently-cased id must hit the saved "openai".
+  const endpoint = await patch({
+    id: "OpenAI",
+    action: "set-endpoint",
+    baseUrl: "https://gw.example.com/v1",
+  });
+  assert.equal(endpoint.status, 200);
+
+  // Key mutations must hit the same provider too.
+  const key = await patch({ id: "OpenAI", action: "add-key", apiKey: "sk-mixed-second" });
+  assert.equal(key.status, 200);
+  const body = (await key.json()) as { keyCount?: number };
+  assert.equal(body.keyCount, 2);
+
+  const providers = routerProviders(OWNER).filter((p) => p.id.toLowerCase() === "openai");
+  assert.equal(providers.length, 1, "mixed-case PATCH must not mint a second provider");
+  assert.equal(providers[0].baseUrl, "https://gw.example.com/v1");
+  assert.deepEqual(providers[0].keys, ["sk-openai-mixed", "sk-mixed-second"]);
+});
+
+test("PATCH baseUrl:'' clears the provider base URL", async () => {
+  await post({
+    id: "openai",
+    apiKey: "sk-openai-clear",
+    baseUrl: "https://api.openai.com/v1",
+  });
+
+  const res = await patch({ id: "openai", action: "set-endpoint", baseUrl: "" });
+  assert.equal(res.status, 200);
+
+  const openai = routerProviders(OWNER).find((p) => p.id === "openai");
+  assert.ok(openai);
+  assert.equal(openai.baseUrl, undefined, "base URL must be cleared by an empty string");
+});
+
