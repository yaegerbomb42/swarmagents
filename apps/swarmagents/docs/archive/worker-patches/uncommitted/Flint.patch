+/**
+ * Dependency-free 5-field cron parser (minute hour day-of-month month day-of-week).
+ *
+ * Supports *, ? , lists, ranges, steps (a-b/n, */n), month/day names, and the
+ * standard OR rule when both day-of-month and day-of-week are restricted.
+ * Times are evaluated in the process-local timezone, matching the in-process
+ * scheduler's simple wall-clock model.
+ */
+
+export const CRON_MIN_INTERVAL_MS = 5 * 60 * 1000;
+const MAX_LOOKAHEAD_MINUTES = 366 * 24 * 60;
+
+interface CronFieldSpec {
+  name: string;
+  min: number;
+  max: number;
+  names?: Record<string, number>;
+}
+
+const FIELDS: readonly CronFieldSpec[] = [
+  { name: "minute", min: 0, max: 59 },
+  { name: "hour", min: 0, max: 23 },
+  { name: "day-of-month", min: 1, max: 31 },
+  {
+    name: "month",
+    min: 1,
+    max: 12,
+    names: { jan: 1, feb: 2, mar: 3, apr: 4, may: 5, jun: 6, jul: 7, aug: 8, sep: 9, oct: 10, nov: 11, dec: 12 },
+  },
+  {
+    name: "day-of-week",
+    min: 0,
+    max: 6,
+    names: { sun: 0, mon: 1, tue: 2, wed: 3, thu: 4, fri: 5, sat: 6 },
+  },
+];
+
+export interface CronExpression {
+  source: string;
+  minutes: Set<number>;
+  hours: Set<number>;
+  daysOfMonth: Set<number>;
+  months: Set<number>;
+  daysOfWeek: Set<number>;
+  /** True when the field was `*` (or `?`), which changes the dom/dow rule. */
+  anyDayOfMonth: boolean;
+  anyDayOfWeek: boolean;
+}
+
+function parseValue(raw: string, spec: CronFieldSpec): number {
+  const token = raw.trim().toLowerCase();
+  if (spec.names && token in spec.names) return spec.names[token];
+  if (!/^\d+$/.test(token)) throw new Error(`Invalid ${spec.name} value "${raw}".`);
+  const value = Number(token);
+  if (value < spec.min || value > spec.max) {
+    throw new Error(`${spec.name} value ${value} is out of range ${spec.min}-${spec.max}.`);
+  }
+  return value;
+}
+
+function parseField(raw: string, spec: CronFieldSpec): { values: Set<number>; any: boolean } {
+  const field = raw.trim();
+  if (field === "" || field === "*" || field === "?") {
+    const values = new Set<number>();
+    for (let i = spec.min; i <= spec.max; i++) values.add(i);
+    return { values, any: true };
+  }
+
+  const values = new Set<number>();
+  for (const part of field.split(",")) {
+    const [rangePart, stepPart] = part.split("/");
+    const step = stepPart === undefined ? 1 : Number(stepPart);
+    if (!Number.isInteger(step) || step <= 0) {
+      throw new Error(`Invalid step "${part}" in ${spec.name} field.`);
+    }
+    let lo: number;
+    let hi: number;
+    if (rangePart === "*" || rangePart === "?") {
+      lo = spec.min;
+      hi = spec.max;
+    } else if (rangePart.includes("-")) {
+      const [a, b] = rangePart.split("-");
+      lo = parseValue(a, spec);
+      hi = parseValue(b, spec);
+    } else {
+      lo = parseValue(rangePart, spec);
+      hi = stepPart === undefined ? lo : spec.max;
+    }
+    if (lo > hi) throw new Error(`Invalid range "${rangePart}" in ${spec.name} field.`);
+    for (let i = lo; i <= hi; i += step) values.add(i);
+  }
+  return { values, any: false };
+}
+
+/** Parse a 5-field expression. Throws a human-readable Error when invalid. */
+export function parseCron(expression: string): CronExpression {
+  const source = expression.trim().replace(/\s+/g, " ");
+  const parts = source.split(" ");
+  if (parts.length !== 5) {
+    throw new Error("Cron expression must have exactly 5 fields (minute hour day month weekday).");
+  }
+  const parsed = parts.map((part, i) => parseField(part, FIELDS[i]));
+  return {
+    source,
+    minutes: parsed[0].values,
+    hours: parsed[1].values,
+    daysOfMonth: parsed[2].values,
+    months: parsed[3].values,
+    daysOfWeek: parsed[4].values,
+    anyDayOfMonth: parsed[2].any,
+    anyDayOfWeek: parsed[4].any,
+  };
+}
+
+function dayMatches(expr: CronExpression, date: Date): boolean {
+  const dom = date.getDate();
+  const dow = date.getDay();
+  const domOk = expr.daysOfMonth.has(dom);
+  const dowOk = expr.daysOfWeek.has(dow);
+  if (expr.anyDayOfMonth) return dowOk;
+  if (expr.anyDayOfWeek) return domOk;
+  return domOk || dowOk;
+}
+
+/** True when the expression fires during `date`'s minute (seconds ignored). */
+export function cronMatches(expr: CronExpression, date: Date): boolean {
+  return (
+    expr.minutes.has(date.getMinutes()) &&
+    expr.hours.has(date.getHours()) &&
+    expr.months.has(date.getMonth() + 1) &&
+    dayMatches(expr, date)
+  );
+}
+
+/** The first firing strictly after `from` (minute precision), or null. */
+export function nextCronDate(expr: CronExpression, from: Date): Date | null {
+  const cursor = new Date(from.getTime());
+  cursor.setSeconds(0, 0);
+  cursor.setMinutes(cursor.getMinutes() + 1);
+  for (let i = 0; i < MAX_LOOKAHEAD_MINUTES; i++) {
+    if (cronMatches(expr, cursor)) return new Date(cursor.getTime());
+    cursor.setMinutes(cursor.getMinutes() + 1);
+  }
+  return null;
+}
+
+/** Parse + validate an expression, returning a readable error instead of throwing. */
+export function validateCron(expression: unknown): string | null {
+  if (typeof expression !== "string" || !expression.trim()) return "A cron expression is required.";
+  try {
+    parseCron(expression);
+    return null;
+  } catch (error) {
+    return error instanceof Error ? error.message : String(error);
+  }
+}
+
+/**
+ * Enforce the per-user minimum interval (5 minutes). Two consecutive firings
+ * less than that apart mean the schedule is too hot, whatever the fields look
+ * like (*/2, 0,2, ranges, names).
+ */
+export function validateCronInterval(expression: string): string | null {
+  let expr: CronExpression;
+  try {
+    expr = parseCron(expression);
+  } catch (error) {
+    return error instanceof Error ? error.message : String(error);
+  }
+  const first = nextCronDate(expr, new Date());
+  const second = first ? nextCronDate(expr, first) : null;
+  if (!first || !second) return "Cron expression never fires.";
+  if (second.getTime() - first.getTime() < CRON_MIN_INTERVAL_MS) {
+    return "Cron interval must be at least 5 minutes.";
+  }
+  return null;
+}
+
+/** Full save-time validation for a workflow's cron trigger. */
+export function validateWorkflowCron(expression: unknown): string | null {
+  const basic = validateCron(expression);
+  if (basic) return basic;
+  return validateCronInterval(expression as string);
+}
