+/**
+ * Shared types for saved workflows: a small node graph the server executes
+ * step by step as normal agent runs on the owner's own VM.
+ *
+ * The graph is intentionally a linear pipeline with one conditional branch:
+ * Trigger -> (Agent | Condition | Loop | Approval | Notify | Output)*.
+ * A Loop owns its own ordered body, so the top-level graph stays a DAG.
+ */
+
+export const WORKFLOW_NODE_KINDS = [
+  "trigger",
+  "agent",
+  "condition",
+  "loop",
+  "approval",
+  "notify",
+  "output",
+] as const;
+
+export type WorkflowNodeKind = (typeof WORKFLOW_NODE_KINDS)[number];
+
+export type TriggerType = "manual" | "cron" | "webhook" | "file";
+
+export interface WorkflowPoint {
+  x: number;
+  y: number;
+}
+
+export interface TriggerConfig {
+  type: TriggerType;
+  /** Cron expression (5 fields) when type === "cron". */
+  cron?: string;
+  /** Directory watched for new files when type === "file". */
+  inboxDir?: string;
+}
+
+export interface AgentConfig {
+  prompt: string;
+  /** Built-in or custom role id. Empty = default role. */
+  roleId?: string;
+  /** Pinned provider id (from the user's own providers). Empty = router default. */
+  providerId?: string;
+  /** Explicit model id or tier (fast|balanced|deep). Empty = router default. */
+  model?: string;
+}
+
+export type ConditionOperator =
+  | "contains"
+  | "not_contains"
+  | "equals"
+  | "not_equals"
+  | "matches"
+  | "gt"
+  | "lt"
+  | "exists";
+
+export interface ConditionConfig {
+  /** Node id whose output is inspected. Empty = previous node output. */
+  source?: string;
+  /** How the source is interpreted. */
+  input: "text" | "json";
+  /** Dot path into the JSON value (e.g. "items.0.status"). Empty = root. */
+  path?: string;
+  operator: ConditionOperator;
+  value?: string;
+  caseSensitive?: boolean;
+}
+
+export interface LoopConfig {
+  /** Node id whose output supplies the list. Empty = trigger payload. */
+  source?: string;
+  /** Dot path to the array inside the source JSON. Empty = root (or raw text). */
+  path?: string;
+  /** Hard cap so one bad list cannot loop forever. */
+  maxItems?: number;
+  /** Ordered body executed once per item. Supports {{item}} / {{item.field}}. */
+  body: WorkflowNode[];
+}
+
+export interface ApprovalConfig {
+  /** Human-readable question shown on the approval card. */
+  message?: string;
+}
+
+export interface NotifyConfig {
+  kind: "ntfy" | "webhook";
+  /** Full URL (webhook) or ntfy topic URL (https://ntfy.sh/<topic>). */
+  url: string;
+  /** Optional JSON headers (webhook only). */
+  headers?: Record<string, string>;
+}
+
+export interface OutputConfig {
+  /** Path inside the VM workspace; relative paths resolve under /workspace. */
+  path?: string;
+  /** Template for the file body. Empty = the previous output. */
+  content?: string;
+  /** Append to an existing file instead of replacing it. */
+  append?: boolean;
+}
+
+interface NodeBase extends WorkflowPoint {
+  id: string;
+  name: string;
+}
+
+export type WorkflowNode =
+  | (NodeBase & { kind: "trigger"; config: TriggerConfig })
+  | (NodeBase & { kind: "agent"; config: AgentConfig })
+  | (NodeBase & { kind: "condition"; config: ConditionConfig })
+  | (NodeBase & { kind: "loop"; config: LoopConfig })
+  | (NodeBase & { kind: "approval"; config: ApprovalConfig })
+  | (NodeBase & { kind: "notify"; config: NotifyConfig })
+  | (NodeBase & { kind: "output"; config: OutputConfig });
+
+export interface WorkflowEdge {
+  id: string;
+  source: string;
+  target: string;
+  /** Condition branch: "true" or "false". */
+  sourceHandle?: "true" | "false";
+}
+
+export interface Workflow {
+  id: string;
+  userId: string;
+  name: string;
+  description?: string;
+  nodes: WorkflowNode[];
+  edges: WorkflowEdge[];
+  /** Only enabled workflows are picked up by cron/file triggers. */
+  enabled: boolean;
+  /** Present on webhook-triggered workflows: hash of the URL token. */
+  webhookTokenHash?: string;
+  createdAt: number;
+  updatedAt: number;
+}
+
+export type WorkflowRunTrigger = "manual" | "cron" | "webhook" | "file" | "resume";
+
+export type WorkflowRunStatus =
+  | "queued"
+  | "running"
+  | "waiting_approval"
+  | "succeeded"
+  | "failed"
+  | "cancelled";
+
+export type WorkflowNodeStatus =
+  | "pending"
+  | "running"
+  | "succeeded"
+  | "failed"
+  | "skipped"
+  | "waiting_approval";
+
+export interface WorkflowNodeState {
+  nodeId: string;
+  status: WorkflowNodeStatus;
+  startedAt?: number;
+  finishedAt?: number;
+  /** Output text/JSON of the node (capped by the store). */
+  output?: string;
+  error?: string;
+}
+
+export interface PendingApproval {
+  nodeId: string;
+  message: string;
+  createdAt: number;
+}
+
+export interface WorkflowRunInput {
+  /** Free-form payload supplied by the trigger (webhook body, file name, ...). */
+  payload?: unknown;
+  /** Optional prompt seed for manual runs. */
+  prompt?: string;
+}
+
+export interface WorkflowRun {
+  id: string;
+  workflowId: string;
+  workflowName: string;
+  userId: string;
+  trigger: WorkflowRunTrigger;
+  status: WorkflowRunStatus;
+  nodeStates: WorkflowNodeState[];
+  /** NodeId of the step in progress / paused for approval. */
+  currentNodeId?: string;
+  /** Outputs keyed by node id; persisted so approval resumes keep context. */
+  context: Record<string, unknown>;
+  input: WorkflowRunInput;
+  /** The agent run id(s) started by this workflow run. */
+  agentRunIds: string[];
+  pendingApproval?: PendingApproval;
+  error?: string;
+  costUsd?: number;
+  createdAt: number;
+  startedAt?: number;
+  finishedAt?: number;
+}
+
+export interface WorkflowSummary {
+  id: string;
+  name: string;
+  description?: string;
+  enabled: boolean;
+  trigger: TriggerType;
+  nodeCount: number;
+  updatedAt: number;
+}
+
+export type WorkflowCreateInput = Pick<Workflow, "name" | "nodes" | "edges"> &
+  Partial<Pick<Workflow, "description" | "enabled">>;
+
+/** One template a user can install as their own editable workflow. */
+export interface WorkflowTemplate {
+  id: string;
+  name: string;
+  description: string;
+  icon: string;
+  nodes: WorkflowNode[];
+  edges: WorkflowEdge[];
+}
+
+export function isWorkflowNodeKind(value: unknown): value is WorkflowNodeKind {
+  return typeof value === "string" && (WORKFLOW_NODE_KINDS as readonly string[]).includes(value);
+}
+
+export function nodeOutput(run: WorkflowRun, nodeId: string): string {
+  const state = run.nodeStates.find((s) => s.nodeId === nodeId);
+  return state?.output ?? "";
+}
