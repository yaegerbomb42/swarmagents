@@ -0,0 +1,100 @@
+#!/usr/bin/env bash
+#
+# swarm-pretooluse.sh — Claude Code PreToolUse hook (h1 permission gate).
+#
+# Installed in the swarm-vm image at /opt/swarm-hooks/. On every tool call
+# claude runs this script with the hook JSON payload on stdin. The script
+# classifies the call with the same rules as the app's lib/harness/risk.ts by
+# delegating to a standalone classifier bundle the runtime writes into the VM
+# at $SWARM_HOOK_CLASSIFIER. Decisions:
+#
+#   allow -> {"decision":"allow"} exit 0 (tool proceeds)
+#   deny  -> {"decision":"block","reason":...,"exitCode":2} exit 2 (tool blocked)
+#   ask   -> writes <id>.req, blocks until <id>.ok / <id>.no appears, then
+#            allow or block accordingly; expiry (TTL) counts as a denial.
+#
+# The approval id is deterministic: sha1(tool::canonical_input)[0:24]
+# prefixed with "appr_", where canonical_input is `jq -S -c` of .tool_input.
+# The runtime computes the identical id (lib/harness/permission-hook.ts) and
+# writes the decision file when the user approves/denies on
+# POST /api/runtime/approvals/{id}.
+
+set -u
+
+HOOK_LOG="${SWARM_HOOK_LOG:-/tmp/swarm-hook.log}"
+log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$HOOK_LOG" 2>/dev/null || true; }
+
+PAYLOAD="$(cat)"
+TOOL="$(printf '%s' "$PAYLOAD" | jq -r '.tool_name // empty')"
+INPUT_CANON="$(printf '%s' "$PAYLOAD" | jq -S -c '.tool_input // {}')"
+LEVEL=""
+REASON=""
+
+CLASSIFIER="${SWARM_HOOK_CLASSIFIER:-/tmp/swarm-classify.cjs}"
+APPROVAL_DIR="${SWARM_APPROVAL_DIR:-/tmp/swarm-approvals}"
+TTL_MS="${SWARM_APPROVAL_TIMEOUT_MS:-300000}"
+
+if [ -z "$TOOL" ]; then
+  # No tool name: safety-default to allow (hook miswiring must not deadlock).
+  printf '{"decision":"allow","reason":"no tool name"}\n'
+  exit 0
+fi
+
+if [ ! -s "$CLASSIFIER" ]; then
+  log "classifier missing at $CLASSIFIER; blocking $TOOL"
+  printf '{"decision":"block","reason":"permission classifier unavailable","exitCode":2}\n'
+  exit 2
+fi
+
+DECISION="$(printf '%s' "$INPUT_CANON" | node "$CLASSIFIER" "$TOOL" 2>>"$HOOK_LOG")"
+if [ -z "$DECISION" ]; then
+  log "classifier produced no output for $TOOL; blocking"
+  printf '{"decision":"block","reason":"permission classifier error","exitCode":2}\n'
+  exit 2
+fi
+
+LEVEL="$(printf '%s' "$DECISION" | jq -r '.level // empty')"
+REASON="$(printf '%s' "$DECISION" | jq -r '.reason // ""')"
+
+case "$LEVEL" in
+  deny)
+    printf '{"decision":"block","reason":"%s","exitCode":2}\n' "$REASON"
+    exit 2
+    ;;
+  ask)
+    if [ -z "$REASON" ]; then REASON="action requires approval"; fi
+    mkdir -p "$APPROVAL_DIR"
+    ID="appr_$(printf '%s' "$TOOL::$INPUT_CANON" | sha1sum | awk '{print $1}' | head -c 24)"
+    printf '{"id":"%s","tool":"%s","at":"%s"}\n' "$ID" "$TOOL" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$APPROVAL_DIR/$ID.req"
+    log "ask blocked $TOOL id=$ID reason=$REASON"
+    # Poll until a decision file appears, or the TTL elapses (counts as denial).
+    # GNU date supports %3N; the VM image ships coreutils.
+    DEADLINE=$(( $(date +%s%3N) + TTL_MS ))
+    while :; do
+      if [ -f "$APPROVAL_DIR/$ID.ok" ]; then
+        rm -f "$APPROVAL_DIR/$ID.req"
+        log "allowed $TOOL id=$ID"
+        printf '{"decision":"allow","reason":"approved by user"}\n'
+        exit 0
+      fi
+      if [ -f "$APPROVAL_DIR/$ID.no" ]; then
+        rm -f "$APPROVAL_DIR/$ID.req"
+        log "denied $TOOL id=$ID"
+        printf '{"decision":"block","reason":"denied by user","exitCode":2}\n'
+        exit 2
+      fi
+      if [ "$(date +%s%3N)" -ge "$DEADLINE" ]; then
+        rm -f "$APPROVAL_DIR/$ID.req"
+        log "timed out $TOOL id=$ID"
+        printf '{"decision":"block","reason":"approval timed out","exitCode":2}\n'
+        exit 2
+      fi
+      sleep 0.2
+    done
+    ;;
+  *)
+    # allow (and any unrecognized level default to allow — never block benign work).
+    printf '{"decision":"allow","reason":"%s"}\n' "$REASON"
+    exit 0
+    ;;
+esac
