+/**
+ * q1 definition of done, end to end: a medium-risk tool call is held at the
+ * point of execution inside the VM and only runs if the user allows it.
+ *
+ *   POST /api/runtime/tasks ("fetch https://example.com")
+ *     -> the fake claude replay publishes the Bash call to the real
+ *        POST /api/runtime/approvals/hook over HTTP (exactly what
+ *        vm-image/hooks/pre-tool-use.mjs does) and blocks
+ *     -> approval.required reaches the UI while no tool.result exists
+ *     -> Allow  -> the recorded output appears, the run finishes
+ *        Deny   -> the call never runs, Claude is told it was denied
+ *        TTL    -> same as Deny (auto-deny), the run still finishes
+ *
+ * A low-risk call must be unaffected: no card, output straight through.
+ *
+ * The hook server is a thin forwarder to the real route handler, so the test
+ * exercises the run token, the classifier, the approval store and the
+ * decision endpoint together instead of stubbing any of them.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import http from "node:http";
+import { once } from "node:events";
+import type { AddressInfo } from "node:net";
+import { NextRequest } from "next/server";
+import { POST as POST_TASK, GET as GET_TASKS } from "../tasks/route";
+import { POST as POST_HOOK } from "./hook/route";
+import { POST as POST_APPROVAL } from "./[id]/route";
+import { RuntimeManager, setRuntimeManagerForTesting } from "../../../../lib/runtime/manager";
+import { VmManager } from "../../../../lib/vm/manager";
+import { FakeVmDriver } from "../../../../lib/vm/fake-driver";
+import {
+  FAKE_CLAUDE_FETCH_COMMAND,
+  FAKE_CLAUDE_FETCH_RESULT,
+  FAKE_CLAUDE_FETCH_TRIGGER,
+} from "../../../../lib/vm/fake-claude";
+import { telemetryBus } from "../../../../lib/telemetry/index";
+import { ApprovalStore, setApprovalStoreForTesting } from "../../../../lib/harness/approvals";
+import type { RunSummary } from "../../../../lib/runtime/manager";
+
+const sleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));
+
+/** The q1 repro: a plain fetch, which classifies as "ask" (medium risk). */
+const RISKY_PROMPT = `Please ${FAKE_CLAUDE_FETCH_TRIGGER} and tell me what it says.`;
+
+interface HookServer {
+  origin: string;
+  /** Bodies the fake VM posted, in order. */
+  bodies: Array<{ tool_name?: string; tool_input?: { command?: string } }>;
+  close: () => Promise<void>;
+}
+
+/** Forward HTTP requests to the real hook route handler (what the VM calls). */
+async function startHookServer(): Promise<HookServer> {
+  const bodies: HookServer["bodies"] = [];
+  const server = http.createServer(async (req, res) => {
+    const chunks: Buffer[] = [];
+    for await (const chunk of req) chunks.push(chunk as Buffer);
+    const body = Buffer.concat(chunks);
+    try {
+      bodies.push(JSON.parse(body.toString("utf8")) as HookServer["bodies"][number]);
+    } catch {
+      bodies.push({});
+    }
+    const headers = new Headers();
+    for (const [name, value] of Object.entries(req.headers)) {
+      if (typeof value === "string") headers.set(name, value);
+      else if (Array.isArray(value)) headers.set(name, value.join(","));
+    }
+    const request = new NextRequest(new URL(req.url ?? "/", "http://127.0.0.1"), {
+      method: req.method,
+      headers,
+      body,
+    });
+    const response = await POST_HOOK(request);
+    res.writeHead(response.status, { "content-type": "application/json" });
+    res.end(await response.text());
+  });
+  server.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  const { port } = server.address() as AddressInfo;
+  return {
+    origin: `http://127.0.0.1:${port}`,
+    bodies,
+    close: async () => {
+      server.close();
+      await once(server, "close");
+    },
+  };
+}
+
+function request(path: string, init: RequestInit = {}, user: string | null = "alice"): NextRequest {
+  const headers = new Headers(init.headers);
+  if (user !== null) headers.set("x-swarm-user", user);
+  return new NextRequest(`http://localhost${path}`, { ...init, headers, signal: init.signal ?? undefined });
+}
+
+async function json(res: Response): Promise<any> {
+  return res.json();
+}
+
+function postTask(body: unknown): Promise<Response> {
+  return POST_TASK(request("/api/runtime/tasks", { method: "POST", body: JSON.stringify(body) }));
+}
+
+function postApproval(id: string, body: unknown): Promise<Response> {
+  return POST_APPROVAL(
+    request(`/api/runtime/approvals/${id}`, { method: "POST", body: JSON.stringify(body) }),
+    { params: Promise.resolve({ id }) },
+  );
+}
+
+async function listRuns(): Promise<RunSummary[]> {
+  return (await json(await GET_TASKS(request("/api/runtime/tasks", {})))).runs;
+}
+
+/** Every event of a run from seq 0, collected until the predicate holds. */
+async function collectUntil(
+  runId: string,
+  predicate: (events: any[]) => boolean,
+  timeoutMs = 15_000,
+): Promise<any[]> {
+  const events: any[] = [];
+  const start = Date.now();
+  const unsubscribe = telemetryBus.subscribe(runId, 0, (event) => events.push(event));
+  try {
+    while (!predicate(events)) {
+      if (Date.now() - start > timeoutMs) {
+        throw new Error(`timed out waiting; saw: ${events.map((event) => event.type).join(",")}`);
+      }
+      await sleep(5);
+    }
+    return events;
+  } finally {
+    unsubscribe();
+  }
+}
+
+async function waitForEvent(runId: string, type: string, timeoutMs = 15_000): Promise<any> {
+  const events = await collectUntil(runId, (list) => list.some((event) => event.type === type), timeoutMs);
+  return events.find((event) => event.type === type)!;
+}
+
+const previousEnv = {
+  base: process.env.SWARM_VM_APPROVAL_BASE_URL,
+  secret: process.env.SWARM_SESSION_SECRET,
+  ttl: process.env.SWARM_APPROVAL_TIMEOUT_SEC,
+};
+
+function restoreEnv(): void {
+  for (const [key, value] of [
+    ["SWARM_VM_APPROVAL_BASE_URL", previousEnv.base],
+    ["SWARM_SESSION_SECRET", previousEnv.secret],
+    ["SWARM_APPROVAL_TIMEOUT_SEC", previousEnv.ttl],
+  ] as const) {
+    if (value === undefined) delete process.env[key];
+    else process.env[key] = value;
+  }
+}
+
+/** Point the runtime at the hook server and install a fresh approval store. */
+function install(origin: string, ttlMs = 60_000): RuntimeManager {
+  process.env.SWARM_VM_APPROVAL_BASE_URL = origin;
+  process.env.SWARM_SESSION_SECRET = "test-session-secret-for-approval-gate";
+  setApprovalStoreForTesting(new ApprovalStore({ ttlMs }));
+  const manager = new RuntimeManager({ vm: new VmManager({ customDriver: new FakeVmDriver() }) });
+  setRuntimeManagerForTesting(manager);
+  return manager;
+}
+
+test.afterEach(() => {
+  setRuntimeManagerForTesting(null);
+  setApprovalStoreForTesting(null);
+  restoreEnv();
+});
+
+test("q1: the fetch does not run before Allow; it runs after Allow", async () => {
+  const hook = await startHookServer();
+  try {
+    install(hook.origin);
+    const { runId } = await json(await postTask({ prompt: RISKY_PROMPT }));
+
+    const required = await waitForEvent(runId, "approval.required");
+    assert.ok(required.approval.id.startsWith("appr_"));
+    assert.equal(required.approval.tool, "Bash");
+    assert.equal(required.approval.action, FAKE_CLAUDE_FETCH_COMMAND);
+    assert.equal(required.approval.riskLevel, "ask");
+
+    // The hook really reached the endpoint with this call.
+    assert.equal(hook.bodies.length, 1);
+    assert.equal(hook.bodies[0].tool_name, "Bash");
+    assert.equal(hook.bodies[0].tool_input?.command, FAKE_CLAUDE_FETCH_COMMAND);
+
+    // Nothing ran: no result, no fetched HTML, the run is still live.
+    const paused = await collectUntil(runId, (list) => list.some((event) => event.type === "approval.required"));
+    assert.equal(paused.some((event) => event.type === "tool.result"), false);
+    assert.equal(
+      paused.some((event) => JSON.stringify(event).includes("Example Domain")),
+      false,
+      "the fetched page must not be in the stream while the call is pending",
+    );
+    const running = await listRuns();
+    assert.equal(running[0].runId, runId);
+    assert.equal(running[0].status, "running");
+
+    const approve = await postApproval(required.approval.id, { decision: "approve" });
+    assert.equal(approve.status, 200);
+
+    await waitForEvent(runId, "run.finished");
+    const events = await collectUntil(runId, (list) => list.some((event) => event.type === "run.finished"));
+
+    const resolved = events.find((event) => event.type === "approval.resolved");
+    assert.equal(resolved.verdict, "approved");
+    const results = events.filter((event) => event.type === "tool.result");
+    assert.equal(results.length, 1, "the approved call ran exactly once");
+    assert.equal(results[0].ok, true);
+    assert.match(String(results[0].output), /Example Domain/);
+
+    const finished = await listRuns();
+    assert.equal(finished[0].status, "finished");
+  } finally {
+    await hook.close();
+  }
+});
+
+test("q1: Deny means the fetch never runs and the agent is told", async () => {
+  const hook = await startHookServer();
+  try {
+    install(hook.origin);
+    const { runId } = await json(await postTask({ prompt: RISKY_PROMPT }));
+
+    const required = await waitForEvent(runId, "approval.required");
+    const deny = await postApproval(required.approval.id, { decision: "deny" });
+    assert.equal(deny.status, 200);
+
+    // The blocked call is an error result, and the run still finishes so the
+    // user sees the agent's reaction instead of a dead run.
+    await waitForEvent(runId, "run.finished");
+    const events = await collectUntil(runId, (list) => list.some((event) => event.type === "run.finished"));
+
+    const resolved = events.find((event) => event.type === "approval.resolved");
+    assert.equal(resolved.verdict, "denied");
+    const results = events.filter((event) => event.type === "tool.result");
+    assert.equal(results.length, 1);
+    assert.equal(results[0].ok, false, "a denied call reports an error result");
+    assert.match(String(results[0].output), /denied/i);
+    assert.equal(
+      events.some((event) => JSON.stringify(event).includes("Example Domain")),
+      false,
+      "the denied command must never have executed",
+    );
+
+    const finished = await listRuns();
+    assert.equal(finished[0].status, "finished");
+  } finally {
+    await hook.close();
+  }
+});
+
+test("q1: an unanswered approval auto-denies and the fetch never runs", async () => {
