+    await waitForEvent(runId, "run.finished");
+    const events = await collectUntil(runId, (list) => list.some((event) => event.type === "run.finished"));
+    const resolved = events.find((event) => event.type === "approval.resolved");
+    assert.equal(resolved.verdict, "expired");
+    const results = events.filter((event) => event.type === "tool.result");
+    assert.equal(results.length, 1);
+    assert.equal(results[0].ok, false);
+    assert.equal(
+      events.some((event) => JSON.stringify(event).includes("Example Domain")),
+      false,
+    );
+  } finally {
+    await hook.close();
+  }
+});
+
+test("q1: a low-risk call is unaffected (no card, output straight through)", async () => {
+  const hook = await startHookServer();
+  try {
+    install(hook.origin);
+    const { runId } = await json(await postTask({ prompt: "Run the smoke check." }));
+
+    await waitForEvent(runId, "run.finished");
+    const events = await collectUntil(runId, (list) => list.some((event) => event.type === "run.finished"));
+    assert.equal(events.some((event) => event.type === "approval.required"), false);
+    assert.ok(events.some((event) => event.type === "tool.result" && event.ok === true));
+    // The hook still sees the call (allow verdict), so the VM never bypasses it.
+    assert.equal(hook.bodies[0].tool_name, "Bash");
+  } finally {
+    await hook.close();
+  }
+});
