diff --git a/apps/swarmagents/lib/templates/_check.ts b/apps/swarmagents/lib/templates/_check.ts
new file mode 100644
index 0000000..2753e50
--- /dev/null
+++ b/apps/swarmagents/lib/templates/_check.ts
@@ -0,0 +1,23 @@
+import { TASK_TEMPLATES } from "./data";
+import { TASK_TEMPLATE_SCHEMA, extractPlaceholders } from "./schema";
+
+let bad = 0;
+for (const t of TASK_TEMPLATES) {
+  const parsed = TASK_TEMPLATE_SCHEMA.safeParse(t);
+  if (!parsed.success) {
+    bad++;
+    console.log(`PARSE FAIL ${t.id}:`, parsed.error.issues.map((i) => `${i.path.join(".")}: ${i.message}`).join("; "));
+    continue;
+  }
+  const refs = extractPlaceholders(t.prompt);
+  const names = t.variables.map((v) => v.name);
+  const missing = refs.filter((r) => !names.includes(r));
+  const extra = names.filter((n) => !refs.includes(n));
+  const dup = names.length !== new Set(names).size;
+  const badId = !/^[a-z0-9][a-z0-9-_]*$/.test(t.id);
+  if (missing.length || extra.length || dup || badId) {
+    bad++;
+    console.log(`${t.id}: missing=${JSON.stringify(missing)} extra=${JSON.stringify(extra)} dup=${dup} badId=${badId} refs=${JSON.stringify(refs)}`);
+  }
+}
+console.log(`checked ${TASK_TEMPLATES.length} templates, ${bad} problems`);
