index 0000000..5c7cc16
--- /dev/null
+++ b/apps/swarmagents/lib/templates/schema.ts
@@ -0,0 +1,95 @@
+/**
+ * Zod schema + validator for the task template catalog (x4).
+ *
+ * The catalog is static data, but it still gets a schema: the gallery renders
+ * from validated templates and the run-start path relies on the prompt/variable
+ * contract holding (unique ids, every `{{variable}}` mapped to a form field, …).
+ */
+
+import { z } from "zod";
+import type { TaskTemplate, TaskTemplateVariable, TemplateVariableType } from "./types";
+
+export const TASK_TEMPLATE_VARIABLE_TYPES = ["text", "textarea", "number", "boolean", "select"] as const satisfies readonly TemplateVariableType[];
+export const TASK_TEMPLATE_VARIABLE_ENUM = z.enum(["text", "textarea", "number", "boolean", "select"]);
+
+export const TASK_TEMPLATE_VARIABLE_SCHEMA = z.object({
+  name: z
+    .string()
+    .regex(/^[a-z][a-z0-9_]*$/, "variable names must be snake_case identifiers")
+    .max(48),
+  label: z.string().min(1).max(80),
+  type: TASK_TEMPLATE_VARIABLE_ENUM,
+  help: z.string().max(300).optional(),
+  placeholder: z.string().max(300).optional(),
+  options: z.array(z.string()).max(8).optional(),
+  default: z.string().optional(),
+});
+
+export const TASK_TEMPLATE_SCHEMA = z.object({
+  id: z
+    .string()
+    .regex(/^[a-z0-9][a-z0-9-_]*$/, "template id must be slug-shaped")
+    .max(64),
+  title: z.string().min(1).max(120),
+  pitch: z.string().min(1).max(280),
+  category: z.string().min(1).max(40),
+  prompt: z.string().min(1).max(8000),
+  variables: z.array(TASK_TEMPLATE_VARIABLE_SCHEMA).max(12),
+  recommendedRole: z.string().min(1).max(64),
+  estMinutes: z.number().int().min(5).max(480),
+  neededTools: z.array(z.string()).max(16),
+  exampleOutput: z.string().max(2000),
+});
+
+export const TASK_TEMPLATES_SCHEMA = z.array(TASK_TEMPLATE_SCHEMA).min(1).max(200);
+
+export type TaskTemplateInput = z.infer<typeof TASK_TEMPLATE_SCHEMA>;
+export type TaskTemplateVariableInput = z.infer<typeof TASK_TEMPLATE_VARIABLE_SCHEMA>;
+export type TaskTemplatesFile = z.infer<typeof TASK_TEMPLATES_SCHEMA>;
+
+/** Validate a parsed template record; returns the typed shape or null when invalid. */
+export function parseTaskTemplate(value: unknown): TaskTemplate | null {
+  const parsed = TASK_TEMPLATE_SCHEMA.safeParse(value);
+  if (!parsed.success) return null;
+  const data = parsed.data;
+  // A template without variables is allowed, but the prompt must not carry
+  // placeholders that have no field (the gallery always writes them a field for).
+  const referenced = new Set(extractPlaceholders(data.prompt));
+  const named = new Set(data.variables.map((v) => v.name));
+  for (const ref of referenced) {
+    if (!named.has(ref)) return null;
+  }
+  return data;
+}
+
+/** Extract `{{name}}` placeholder keys from a prompt, in order of first use. */
+export function extractPlaceholders(prompt: string): string[] {
+  const found: string[] = [];
+  const seen = new Set<string>();
+  const re = /\{\{\s*([a-z][a-z0-9_]*)\s*\}\}/g;
+  let m: RegExpExecArray | null;
+  while ((m = re.exec(prompt)) !== null) {
+    const key = m[1];
+    if (!seen.has(key)) {
+      seen.add(key);
+      found.push(key);
+    }
+  }
+  return found;
+}
+
+/** Render a template prompt by substituting `{{name}}` values. */
+export function renderTemplatePrompt(template: TaskTemplate, values: Record<string, string | undefined>): string {
+  let out = template.prompt;
+  for (const key of extractPlaceholders(template.prompt)) {
+    const raw = values[key];
+    const value = (raw ?? template.variables.find((v) => v.name === key)?.default ?? "").trim();
+    out = out.split(`{{${key}}}`).join(value);
+  }
+  return out;
+}
+
+/** The ordered variable keys a template's form collects, in first-use order. */
+export function templateVariableNames(template: TaskTemplate): string[] {
+  return extractPlaceholders(template.prompt);
+}
