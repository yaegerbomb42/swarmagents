+/**
+ * Task template types for the SwarmAgents template gallery (x4).
+ *
+ * A task template is a fully-written agent prompt that carries `{{variable}}`
+ * placeholders plus the typed form fields a user fills in before starting a
+ * real run. The data lives in lib/templates/data.ts behind a zod schema in
+ * lib/templates/schema.ts; this module holds the shapes both sides share.
+ *
+ * Everything here is static catalog data: no per-account state, no secrets,
+ * no network. Rendering happens in lib/templates (prompt + values) and the
+ * result is handed to the runtime as a normal run prompt.
+ */
+
+/** Schema marker for the template catalog (kept next to the zod schema). */
+export const TEMPLATE_SCHEMA = "swarmagents.templates";
+/** Schema version; v1 templates parse forward-compatible. */
+export const TEMPLATE_SCHEMA_VERSION = 1;
+
+/** Categories the gallery groups by (the catalog is static, not user data). */
+export const TEMPLATE_CATEGORIES = [
+  "build-app",
+  "fix-refactor",
+  "research-reports",
+  "data-spreadsheets",
+  "web-automation",
+  "devops-servers",
+  "content-docs",
+  "personal-productivity",
+] as const;
+
+export type TemplateCategory = (typeof TEMPLATE_CATEGORIES)[number];
+
+export const TEMPLATE_CATEGORY_LABELS: Readonly<Record<string, string>> = {
+  "build-app": "Build an app",
+  "fix-refactor": "Fix / refactor code",
+  "research-reports": "Research and reports",
+  "data-spreadsheets": "Data and spreadsheets",
+  "web-automation": "Web automation in the VM browser",
+  "devops-servers": "DevOps and servers",
+  "content-docs": "Content and docs",
+  "personal-productivity": "Personal productivity",
+};
+
+export const TEMPLATE_VARIABLE_TYPES = ["text", "textarea", "number", "boolean", "select"] as const;
+export type TemplateVariableType = (typeof TEMPLATE_VARIABLE_TYPES)[number];
+
+/**
+ * One `{{name}}` placeholder in a template prompt, with the form field that
+ * collects it. `name` is the placeholder key (snake_case) and the field label is
+ * what the user sees.
+ */
+export interface TaskTemplateVariable {
+  /** Placeholder key as it appears in the prompt ({{name}}). */
+  name: string;
+  /** Human label for the form field. */
+  label: string;
+  /** Field kind rendered by the variable form. */
+  type: TemplateVariableType;
+  /** Optional helper text shown under the field. */
+  help?: string;
+  /** Placeholder for text-ish inputs. */
+  placeholder?: string;
+  /** Allowed values for `select` fields. */
+  options?: string[];
+  /** Field default used when the user leaves it blank. */
+  default?: string;
+}
+
+/** A fully-written agent task that can be started as a real run. */
+export interface TaskTemplate {
+  /** Stable slug: unique across the catalog, URL-safe. */
+  id: string;
+  /** Short human title. */
+  title: string;
+  /** One-line pitch shown in the gallery card. */
+  pitch: string;
+  /** Category id (see TEMPLATE_CATEGORIES). */
+  category: string;
+  /** The agent prompt, with `{{variable}}` placeholders resolved by the form. */
+  prompt: string;
+  /** Typed form fields for the prompt's `{{variables}}`. */
+  variables: TaskTemplateVariable[];
+  /** Role id the run should use (a built-in role id). */
+  recommendedRole: string;
+  /** Estimated effort in minutes. */
+  estMinutes: number;
+  /** Built-in tool ids the run is expected to need. */
+  neededTools: string[];
+  /** What a finished run should look like (for the preview drawer). */
+  exampleOutput: string;
+}
