@@ -0,0 +1,135 @@
+/**
+ * A recorded run transcript used by the Run Replay tests and the local
+ * Playwright spec (x1). It is deliberately generated from a small, readable
+ * recording script rather than checked in as a 100 KB blob: the shape matches
+ * exactly what lib/telemetry/run-log.ts persists (seq/type/ts/data), and the
+ * recording is long enough (500+ events) to exercise the virtualized views
+ * and the scrubber at scale.
+ */
+
+import type { PersistedRunEvent } from "./replay";
+
+export const RECORDED_RUN_ID = "run_replay_fixture";
+export const RECORDED_PROMPT = "Audit the workspace and write a report";
+
+const BASE_TS = 1_790_000_000_000;
+const STEPS = 110;
+
+export const RECORDED_EVENTS: PersistedRunEvent[] = (() => {
+  const events: PersistedRunEvent[] = [];
+  let seq = 0;
+  const push = (type: string, data?: unknown) => {
+    seq += 1;
+    events.push({ seq, type, ts: BASE_TS + seq * 137, data, runId: RECORDED_RUN_ID });
+  };
+
+  push("run.created", { prompt: RECORDED_PROMPT, userId: "alice@example.com" });
+  push("run.started", { model: "fake-claude", provider: "mock", sessionId: "sess_replay" });
+
+  for (let step = 1; step <= STEPS; step += 1) {
+    push("assistant.text", { text: `Step ${step}: checking the workspace, then writing what changed.` });
+    push("llm.call", {
+      provider: "mock",
+      model: "fake-claude",
+      outcome: "ok",
+      attempt: 1,
+      latencyMs: 120 + (step % 40),
+      costUsd: 0.0003,
+    });
+    push("tool.call", {
+      name: "Bash",
+      id: `call_bash_${step}`,
+      input: { command: `echo step ${step}`, description: `Step ${step}` },
+    });
+    push("tool.result", {
+      id: `call_bash_${step}`,
+      ok: true,
+      truncated: false,
+      output: `step ${step}\nok\nwrote ${step} rows`,
+    });
+    push("usage", { inputTokens: 40, outputTokens: 12 });
+
+    if (step % 10 === 0) {
+      const frameId = step / 10;
+      push("browser.navigated", { url: `https://example.com/page/${frameId}`, title: `Page ${frameId}` });
+      push("browser.frame", {
+        frameId,
+        width: 1280,
+        height: 800,
+        url: `https://example.com/page/${frameId}`,
+        title: `Page ${frameId}`,
+      });
+    }
+
+    if (step === 5) {
+      push("tool.call", {
+        name: "Write",
+        id: "call_write_report",
+        input: {
+          file_path: "/workspace/report.md",
+          content: "# Report\n\nfirst pass\noutdated line\n",
+        },
+      });
+      push("tool.result", { id: "call_write_report", ok: true, truncated: false, output: "Wrote /workspace/report.md" });
+    }
+
+    if (step === 40) {
+      push("tool.call", {
+        name: "Edit",
+        id: "call_edit_report",
+        input: { file_path: "/workspace/report.md", old_string: "outdated line", new_string: "reviewed line" },
+      });
+      push("tool.result", { id: "call_edit_report", ok: true, truncated: false, output: "Edited /workspace/report.md" });
+    }
+
+    if (step === 41) {
+      push("tool.call", {
+        name: "Edit",
+        id: "call_edit_summary",
+        input: {
+          file_path: "/workspace/summary.md",
+          old_string: "TODO",
+          new_string: "Done",
+        },
+      });
+      push("tool.result", { id: "call_edit_summary", ok: true, truncated: false, output: "Edited /workspace/summary.md" });
+    }
+
+    if (step === 70) {
+      push("tool.call", {
+        name: "Bash",
+        id: "call_bash_fail",
+        input: { command: "false", description: "probe failure" },
+      });
+      push("tool.result", {
+        id: "call_bash_fail",
+        ok: false,
+        truncated: false,
+        output: "command exited with status 1",
+      });
+    }
+
+    if (step === 50) {
+      push("approval.required", {
+        approval: {
+          id: "appr_1",
+          tool: "Bash",
+          action: "rm -rf /workspace/tmp",
+          reason: "destructive command",
+          riskLevel: "ask",
+          expiresAt: BASE_TS + seq * 137 + 300_000,
+        },
+      });
+      push("approval.resolved", { id: "appr_1", verdict: "approved" });
+    }
+  }
+
+  push("run.finished", {
+    exitCode: 0,
+    sessionId: "sess_replay",
+    costUsd: 0.0331,
+    durationMs: 42_000,
+    numTurns: STEPS,
+  });
+  return events;
+})();
diff --git a/apps/swarmagents/lib/client/replay.test.ts b/apps/swarmagents/lib/client/replay.test.ts
new file mode 100644
index 000000000..bb8f26511
--- /dev/null
+++ b/apps/swarmagents/lib/client/replay.test.ts
@@ -0,0 +1,238 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  adjacentMarkerIndex,
+  advanceReplay,
+  buildMarkers,
+  buildReplayAt,
+  buildReplayItems,
+  classifyTool,
+  diffLines,
+  markerAtFraction,
+  markerCounts,
+  nearestFrame,
+  nextErrorIndex,
+  prevErrorIndex,
+  replayDiffs,
+  replayFiles,
+  windowRange,
+} from "./replay";
+import { RECORDED_EVENTS } from "./replay.fixture";
+
+const items = buildReplayItems(RECORDED_EVENTS);
+const markers = buildMarkers(items);
+
+function indexOfToolCall(id: string): number {
+  const index = items.findIndex(
+    (item) => item.kind === "tool.call" && (item.data as { id?: string } | undefined)?.id === id,
+  );
+  assert.ok(index >= 0, `fixture is missing tool call ${id}`);
+  return index;
+}
+
+test("recorded fixture is long enough to exercise the virtualized replay", () => {
+  assert.ok(items.length >= 500, `expected 500+ events, got ${items.length}`);
+  assert.equal(items[0]?.kind, "run.created");
+  assert.equal(items[items.length - 1]?.kind, "run.finished");
+  // seq is strictly increasing so cursor indexes map cleanly onto the log.
+  for (let i = 1; i < items.length; i += 1) {
+    assert.ok(items[i].seq > items[i - 1].seq);
+  }
+});
+
+test("buildReplayItems strips ownership identifiers from the payload", () => {
+  const created = items[0].data as Record<string, unknown>;
+  assert.equal(created.prompt, "Audit the workspace and write a report");
+  assert.equal(created.userId, undefined);
+});
+
+test("classifyTool maps bash, edit, browser and unknown tools", () => {
+  assert.equal(classifyTool("Bash"), "bash");
+  assert.equal(classifyTool("Write"), "edit");
+  assert.equal(classifyTool("MultiEdit"), "edit");
+  assert.equal(classifyTool("mcp__files__write"), "edit");
+  assert.equal(classifyTool("mcp__playwright__browser_navigate"), "browser");
+  assert.equal(classifyTool("computer_screenshot"), "browser");
+  assert.equal(classifyTool("TodoWrite"), "other");
+});
+
+test("buildMarkers color-codes every tool call and keeps markers ordered", () => {
+  const counts = markerCounts(markers);
+  assert.equal(counts.bash, 111);
+  assert.equal(counts.edit, 3);
+  assert.equal(counts.browser, 22);
+  assert.equal(counts.llm, 110);
+  assert.equal(counts.error, 1);
+  assert.equal(counts.approval, 1);
+
+  for (let i = 1; i < markers.length; i += 1) {
+    assert.ok(markers[i].index > markers[i - 1].index, "markers must be ascending");
+  }
+  for (const marker of markers) {
+    assert.ok(marker.index >= 0 && marker.index < items.length);
+    assert.ok(marker.label.length > 0);
+  }
+});
+
+test("buildReplayAt is a pure prefix reducer — any cursor is valid", () => {
+  for (const cursor of [0, 1, 42, Math.floor(items.length / 2), items.length - 1]) {
+    const view = buildReplayAt(items, cursor, { markers });
+    assert.equal(view.included, cursor + 1);
+    assert.ok(view.terminal.length >= 0);
+    assert.ok(view.files.length >= 0);
+  }
+  // Out-of-range cursors clamp to the log instead of throwing.
+  assert.equal(buildReplayAt(items, -10).included, 1);
+  assert.equal(buildReplayAt(items, items.length + 10).included, items.length);
+  assert.equal(buildReplayAt([], 0).included, 0);
+});
+
+test("terminal transcript grows with the cursor and carries bash output", () => {
+  const early = buildReplayAt(items, indexOfToolCall("call_bash_1") + 1, { markers });
+  assert.ok(early.terminal.some((line) => line.tone === "cmd" && line.text === "echo step 1"));
+  assert.ok(early.terminal.some((line) => line.tone === "out" && line.text === "wrote 1 rows"));
+
+  const later = buildReplayAt(items, indexOfToolCall("call_bash_50"), { markers });
+  assert.ok(later.terminal.length > early.terminal.length);
+
+  const failure = buildReplayAt(items, indexOfToolCall("call_bash_fail") + 1, { markers });
+  assert.ok(failure.terminal.some((line) => line.tone === "err" && line.text.includes("exited with status 1")));
+});
+
+test("files are reconstructed from Write then Edit events", () => {
+  const beforeWrite = buildReplayAt(items, indexOfToolCall("call_write_report") - 1, { markers });
+  assert.equal(beforeWrite.files.length, 0);
+
+  const afterWrite = buildReplayAt(items, indexOfToolCall("call_write_report"), { markers });
+  assert.equal(afterWrite.files.length, 1);
+  assert.equal(afterWrite.files[0].path, "/workspace/report.md");
+  assert.match(afterWrite.files[0].content ?? "", /outdated line/);
+  assert.equal(afterWrite.files[0].writes, 1);
+  assert.deepEqual(afterWrite.diffs[0].rows.filter((row) => row.type === "add").map((row) => row.text), [
+    "# Report",
+    "",
+    "first pass",
+    "outdated line",
+  ]);
+
+  const afterEdit = buildReplayAt(items, indexOfToolCall("call_edit_report"), { markers });
+  assert.match(afterEdit.files[0].content ?? "", /reviewed line/);
+  assert.ok(!(afterEdit.files[0].content ?? "").includes("outdated line"));
+  // The diff still shows the replaced line against the original write.
+  assert.ok(afterEdit.diffs[0].rows.some((row) => row.type === "del" && row.text === "outdated line"));
+  assert.ok(afterEdit.diffs[0].rows.some((row) => row.type === "add" && row.text === "reviewed line"));
+});
+
+test("an edit of an unknown file shows the recorded hunk instead of guessing", () => {
+  const view = buildReplayAt(items, indexOfToolCall("call_edit_summary"), { markers });
+  const summary = view.files.find((file) => file.path === "/workspace/summary.md");
+  assert.ok(summary, "summary.md should be reconstructed");
+  assert.equal(summary?.unknownBase, true);
+  assert.equal(summary?.content, undefined);
+  assert.deepEqual(summary?.hunks, [{ seq: items[indexOfToolCall("call_edit_summary")].seq, before: "TODO", after: "Done" }]);
+  const diff = view.diffs.find((file) => file.path === "/workspace/summary.md");
+  assert.ok(diff?.rows.some((row) => row.type === "del" && row.text === "TODO"));
+  assert.ok(diff?.rows.some((row) => row.type === "add" && row.text === "Done"));
+});
+
+test("replayFiles and replayDiffs agree with buildReplayAt", () => {
+  const cursor = indexOfToolCall("call_edit_report");
+  assert.deepEqual(replayFiles(items, cursor), buildReplayAt(items, cursor).files);
+  assert.deepEqual(replayDiffs(replayFiles(items, cursor)), buildReplayAt(items, cursor).diffs);
+});
+
+test("reasoning collects assistant text up to the cursor", () => {
+  const first = buildReplayAt(items, indexOfToolCall("call_bash_1"), { markers });
+  assert.equal(first.reasoning.length, 1);
+  assert.match(first.reasoning[0].text, /Step 1/);
+
+  const later = buildReplayAt(items, indexOfToolCall("call_bash_20"), { markers });
+  assert.ok(later.reasoning.length > 1);
+});
+
+test("nearestFrame picks the last archived browser frame at or before the cursor", () => {
+  const frameIndexes = items
+    .map((item, index) => (item.kind === "browser.frame" ? index : -1))
+    .filter((index) => index >= 0);
+  assert.ok(frameIndexes.length >= 10);
+
+  const second = frameIndexes[1];
+  assert.equal(nearestFrame(markers, second + 5, [1, 2, 3])?.frameId, 2);
+  assert.equal(nearestFrame(markers, frameIndexes[0] - 1, [1, 2, 3]), undefined);
+  // Frames that were never archived are skipped.
+  assert.equal(nearestFrame(markers, frameIndexes[4], [3, 4])?.frameId, 4);
+  assert.equal(nearestFrame(markers, frameIndexes[frameIndexes.length - 1], [1, 2])?.frameId, 2);
+  // Without an archive filter the event alone decides.
+  assert.equal(nearestFrame(markers, frameIndexes[0])?.frameId, 1);
+});
+
+test("playback advances by the chosen speed and stops at the end", () => {
+  assert.equal(advanceReplay(0, 100, 1), 1);
+  assert.equal(advanceReplay(10, 100, 4), 14);
+  assert.equal(advanceReplay(90, 100, 16), 99);
+  assert.equal(advanceReplay(99, 100, 16), 99);
+  assert.equal(advanceReplay(5, 100, 0), 6, "a speed below 1 still advances by one");
+  assert.equal(advanceReplay(0, 0, 4), 0);
+});
+
+test("error jumps wrap around the run", () => {
+  const error = markers.find((marker) => marker.kind === "error");
+  assert.ok(error);
+  assert.equal(nextErrorIndex(markers, 0), error.index);
+  assert.equal(nextErrorIndex(markers, error.index), error.index, "wraps to the same only error");
+  assert.equal(nextErrorIndex(markers, items.length - 1), error.index);
+  assert.equal(prevErrorIndex(markers, error.index), error.index);
+  assert.equal(nextErrorIndex([], 0), undefined);
+});
+
+test("adjacentMarkerIndex steps between tool calls", () => {
+  const first = markers[0].index;
+  const second = markers[1].index;
+  assert.equal(adjacentMarkerIndex(markers, first, 1), second);
+  assert.equal(adjacentMarkerIndex(markers, second, -1), first);
+  assert.equal(adjacentMarkerIndex(markers, items.length - 1, 1), first, "wraps forward");
+  assert.equal(adjacentMarkerIndex([], 3, 1), undefined);
+});
+
+test("markerAtFraction snaps a scrub position to the nearest previous marker", () => {
+  const second = markers[1].index;
+  assert.equal(markerAtFraction(markers, items.length, 0), 0);
+  assert.equal(markerAtFraction(markers, items.length, second / (items.length - 1)), second);
+  assert.equal(markerAtFraction(markers, 0, 0.5), 0);
+});
+
+test("windowRange keeps a 5,000-row list to a small slice", () => {
+  const range = windowRange(5000, 34 * 2500, 34, 340, 8);
+  assert.ok(range.start > 2480 && range.start < 2500);
+  assert.ok(range.end - range.start < 30);
+  assert.equal(range.padTop, range.start * 34);
+  assert.equal(range.padBottom, (5000 - range.end) * 34);
+
+  const top = windowRange(5000, 0, 34, 340, 8);
+  assert.equal(top.start, 0);
+  assert.equal(top.padTop, 0);
+
+  const empty = windowRange(0, 500, 34, 340);
+  assert.deepEqual(empty, { start: 0, end: 0, padTop: 0, padBottom: 0 });
+});
+
+test("diffLines trims context and marks removed/added lines", () => {
+  const same = diffLines("a\nb\nc", "a\nb\nc");
+  assert.deepEqual(same.rows, []);
+  assert.equal(same.truncated, false);
+
+  const changed = diffLines("a\nb\nc", "a\nB\nc");
+  assert.deepEqual(changed.rows.map((row) => `${row.type}:${row.text}`), [
+    "ctx:a",
+    "del:b",
+    "add:B",
+    "ctx:c",
+  ]);
+
+  const added = diffLines("", "one\ntwo");
+  assert.deepEqual(added.rows.map((row) => `${row.type}:${row.text}`), ["del:", "add:one", "add:two"]);
+
+  const big = diffLines("old", Array.from({ length: 500 }, (_, i) => `line ${i}`).join("\n"));
+  assert.equal(big.truncated, true);
+  assert.equal(big.rows.length, 400);
+});
diff --git a/apps/swarmagents/lib/client/replay.ts b/apps/swarmagents/lib/client/replay.ts
new file mode 100644
index 000000000..a2558065b
--- /dev/null
+++ b/apps/swarmagents/lib/client/replay.ts
@@ -0,0 +1,750 @@
+/**
+ * replay.ts — pure model for the Run Replay time-travel viewer (x1).
+ *
+ * A finished run's durable event log (see lib/telemetry/run-log.ts and
+ * GET /api/runtime/runs/<id>) is the source of truth. This module turns that
+ * log into a scrubbable timeline:
+ *
+ *   - `buildMarkers` classifies every tool-ish event into one color-coded
+ *     marker kind (bash, edit, browser, llm, error, approval);
+ *   - `buildReplayAt` reduces the log *up to a cursor index* into the view
+ *     state the UI renders: tool timeline, terminal transcript, reconstructed
+ *     files + diffs, reasoning text, and the nearest browser frame;
+ *   - playback/seek helpers (`advanceReplay`, `nextErrorIndex`) and a
+ *     row-window helper for virtualizing 5,000+ event lists.
+ *
+ * Everything here is DOM-free and deterministic so it unit-tests under
+ * plain node:test and can be replayed on any prefix of the log.
+ */
+
+import { reduceRunTimeline, redactEventData, type RunTimeline } from "./runTimeline";
+import type { RunStreamItem } from "./useRunStream";
+
+/** A persisted telemetry event as returned by GET /api/runtime/runs/<id>. */
+export interface PersistedRunEvent {
+  seq: number;
+  type: string;
+  ts: number;
+  data?: unknown;
+  runId?: string;
+}
+
+/** Marker kinds rendered on the scrubber rail, in legend order. */
+export type ReplayMarkerKind = "bash" | "edit" | "browser" | "llm" | "error" | "approval" | "other";
+
+export const MARKER_KINDS: readonly ReplayMarkerKind[] = ["bash", "edit", "browser", "llm", "error", "approval", "other"];
+
+/** Tailwind-ish swatches used by both the rail and the legend. */
+export const MARKER_COLOR: Record<ReplayMarkerKind, string> = {
+  bash: "#fbbf24",
+  edit: "#38bdf8",
+  browser: "#34d399",
+  llm: "#a78bfa",
+  error: "#fb7185",
+  approval: "#f59e0b",
+  other: "#94a3b8",
+};
+
+export const MARKER_LABEL: Record<ReplayMarkerKind, string> = {
+  bash: "bash",
+  edit: "edit",
+  browser: "browser",
+  llm: "llm",
+  error: "error",
+  approval: "approval",
+  other: "tool",
+};
+
+export interface ReplayMarker {
+  /** Cursor index (event array position) this marker sits on. */
+  index: number;
+  seq: number;
+  ts: number;
+  kind: ReplayMarkerKind;
+  label: string;
+  /** Present on browser.frame markers so the screenshot pane can load it. */
+  frameId?: number;
+  url?: string;
+  title?: string;
+}
+
+export type ReplayTone = "cmd" | "out" | "err" | "note";
+
+export interface ReplayTerminalLine {
+  seq: number;
+  ts: number;
+  tone: ReplayTone;
+  text: string;
+}
+
+export interface ReplayReasoningEntry {
+  seq: number;
+  ts: number;
+  text: string;
+}
+
+export interface ReplayHunk {
+  seq: number;
+  before: string;
+  after: string;
+}
+
+export interface ReplayFile {
+  path: string;
+  /** Reconstructed content, when the log contained a full Write for it. */
+  content?: string;
+  /** Content before the first recorded touch ("" for a fresh Write). */
+  base?: string;
+  /** True when the file was only ever edited, so its base is unknown. */
+  unknownBase: boolean;
+  writes: number;
+  edits: number;
+  lastSeq: number;
+  hunks: ReplayHunk[];
+}
+
+export type ReplayDiffRowType = "ctx" | "add" | "del";
+
+export interface ReplayDiffRow {
+  type: ReplayDiffRowType;
+  text: string;
+}
+
+export interface ReplayFileDiff {
+  path: string;
+  status: "added" | "modified";
+  added: number;
+  removed: number;
+  rows: ReplayDiffRow[];
+  truncated: boolean;
+}
+
+export interface ReplayFrameRef {
+  seq: number;
+  index: number;
+  frameId: number;
+  url?: string;
+  title?: string;
+}
+
+export interface ReplayViewState {
+  /** Number of events included (cursor index + 1). */
+  included: number;
+  timeline: RunTimeline;
+  terminal: ReplayTerminalLine[];
+  reasoning: ReplayReasoningEntry[];
+  files: ReplayFile[];
+  diffs: ReplayFileDiff[];
+  /** Nearest archived browser frame at or before the cursor. */
+  frame?: ReplayFrameRef;
+}
+
+const BASH_TOOLS = new Set(["bash", "shell", "terminal", "exec", "execute", "run_command"]);
+const EDIT_TOOLS = new Set([
+  "write",
+  "edit",
+  "multiedit",
+  "multi_edit",
+  "notebookedit",
+  "notebook_edit",
+  "str_replace_editor",
+  "str_replace_based_edit_tool",
+  "create_file",
+  "apply_patch",
+]);
+const BROWSER_HINTS = ["playwright", "browser", "computer", "desktop", "screenshot", "chrome"];
+
+const MAX_TERMINAL_LINES = 800;
+const MAX_OUTPUT_LINES_PER_RESULT = 80;
+const MAX_REASONING_CHARS = 20_000;
+const MAX_REASONING_ENTRIES = 200;
+const MAX_FILE_CHARS = 400_000;
+const MAX_DIFF_ROWS = 400;
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function asString(value: unknown): string | undefined {
+  return typeof value === "string" ? value : undefined;
+}
+
+function asNumber(value: unknown): number | undefined {
+  return typeof value === "number" && Number.isFinite(value) ? value : undefined;
+}
+
+/** Normalize a tool name for classification: `mcp__browser__open` -> `browser`. */
+function toolKey(name: string): string {
+  return name.trim().toLowerCase().replace(/^mcp__/, "");
+}
+
+function isBrowserTool(name: string): boolean {
+  const key = toolKey(name);
+  return BROWSER_HINTS.some((hint) => key.includes(hint));
+}
+
+/** Classify a tool call into the marker kind that best describes it. */
+export function classifyTool(name: string): ReplayMarkerKind {
+  const key = toolKey(name);
+  if (BASH_TOOLS.has(key) || key.includes("bash")) return "bash";
+  if (EDIT_TOOLS.has(key)) return "edit";
+  if (isBrowserTool(name)) return "browser";
+  const leaf = key.includes("__") ? key.slice(key.lastIndexOf("__") + 2) : key;
+  if (EDIT_TOOLS.has(leaf)) return "edit";
+  if (BASH_TOOLS.has(leaf)) return "bash";
+  if (isBrowserTool(leaf)) return "browser";
+  return "other";
+}
+
+/** Truncate one display line; replay panes never render unbounded strings. */
+export function clip(value: unknown, max = 220): string {
+  const text = typeof value === "string" ? value : value == null ? "" : JSON.stringify(value);
+  const clean = text.replace(/\u0000/g, "");
+  return clean.length > max ? `${clean.slice(0, max)}…` : clean;
+}
+
+/** Convert persisted events into the RunStreamItem shape the reducers consume. */
+export function buildReplayItems(events: readonly PersistedRunEvent[]): RunStreamItem[] {
+  return events.map((event) => ({
+    seq: event.seq,
+    kind: event.type,
+    data: redactEventData(event.data),
+    ts: event.ts,
+    parsed: { id: String(event.seq), event: event.type, data: "" },
+  }));
+}
+
+function toolCallLabel(name: string, input: unknown): string {
+  const data = isRecord(input) ? input : {};
+  const command = asString(data.command);
+  const file = asString(data.file_path) ?? asString(data.path);
+  const url = asString(data.url) ?? asString(data.goto);
+  if (command) return clip(command, 140);
+  if (file) return clip(file, 140);
+  if (url) return clip(url, 140);
+  if (asString(data.description)) return clip(data.description, 140);
+  return clip(name, 140);
+}
+
+/**
+ * Build the marker rail for a whole run. Markers are indexed by their position
+ * in the events array (not seq) so seeking is a single array index.
+ */
+export function buildMarkers(items: readonly RunStreamItem[]): ReplayMarker[] {
+  const markers: ReplayMarker[] = [];
+  const callNames = new Map<string, string>();
+  items.forEach((item, index) => {
+    const data = isRecord(item.data) ? item.data : {};
+    if (item.kind === "tool.call") {
+      const name = asString(data.name) ?? "tool";
+      const id = asString(data.id);
+      if (id) callNames.set(id, name);
+      markers.push({
+        index,
+        seq: item.seq,
+        ts: item.ts,
+        kind: classifyTool(name),
+        label: toolCallLabel(name, data.input),
+      });
+      return;
+    }
+    if (item.kind === "tool.result" && data.ok === false) {
+      const id = asString(data.id);
+      markers.push({
+        index,
+        seq: item.seq,
+        ts: item.ts,
+        kind: "error",
+        label: `${id ? callNames.get(id) ?? "tool" : "tool"} failed`,
+      });
+      return;
+    }
+    if (item.kind === "tool.blocked") {
+      markers.push({
+        index,
+        seq: item.seq,
+        ts: item.ts,
+        kind: "error",
+        label: `${asString(data.name) ?? "tool"} blocked`,
+      });
+      return;
+    }
+    if (item.kind === "browser.frame") {
+      const frameId = asNumber(data.frameId);
+      markers.push({
+        index,
+        seq: item.seq,
+        ts: item.ts,
+        kind: "browser",
+        label: `frame ${frameId ?? "?"}${asString(data.url) ? ` · ${clip(data.url, 80)}` : ""}`,
+        ...(frameId !== undefined ? { frameId } : {}),
+        ...(asString(data.url) ? { url: asString(data.url) } : {}),
+        ...(asString(data.title) ? { title: asString(data.title) } : {}),
+      });
+      return;
+    }
+    if (item.kind === "browser.navigated") {
+      markers.push({
+        index,
+        seq: item.seq,
+        ts: item.ts,
+        kind: "browser",
+        label: `navigated · ${clip(data.url, 80)}`,
+        ...(asString(data.url) ? { url: asString(data.url) } : {}),
+        ...(asString(data.title) ? { title: asString(data.title) } : {}),
+      });
+      return;
+    }
+    if (item.kind === "computer.action") {
+      markers.push({
+        index,
+        seq: item.seq,
+        ts: item.ts,
+        kind: "browser",
+        label: clip(asString(data.action) ?? "desktop action", 100),
+      });
+      return;
+    }
+    if (item.kind === "llm.call") {
+      const provider = asString(data.provider) ?? "llm";
+      const model = asString(data.model) ?? "";
+      markers.push({
+        index,
+        seq: item.seq,
+        ts: item.ts,
+        kind: data.outcome === "ok" ? "llm" : "error",
+        label: `${provider} ${model}`.trim(),
+      });
+      return;
+    }
+    if (item.kind === "approval.required") {
+      const raw = isRecord(data.approval) ? data.approval : data;
+      markers.push({
+        index,
+        seq: item.seq,
+        ts: item.ts,
+        kind: "approval",
+        label: clip(asString(raw.action) ?? asString(raw.tool) ?? "approval", 120),
+      });
+      return;
+    }
+    if (item.kind === "run.error" || item.kind === "vm.error") {
+      markers.push({
+        index,
+        seq: item.seq,
+        ts: item.ts,
+        kind: "error",
+        label: clip(asString(data.message) ?? "run error", 120),
+      });
+    }
+  });
+  return markers;
+}
+
+/** The nearest browser frame at or before the cursor, when one was archived. */
+export function nearestFrame(
+  markers: readonly ReplayMarker[],
+  index: number,
+  archivedFrames?: ReadonlySet<number> | readonly number[],
+): ReplayFrameRef | undefined {
+  const allowed =
+    archivedFrames === undefined
+      ? undefined
+      : new Set<number>(Array.isArray(archivedFrames) ? archivedFrames : Array.from(archivedFrames as ReadonlySet<number>));
+  let found: ReplayFrameRef | undefined;
+  for (const marker of markers) {
+    if (marker.index > index) break;
+    if (marker.kind !== "browser" || marker.frameId === undefined) continue;
+    if (allowed && !allowed.has(marker.frameId)) continue;
+    found = {
+      seq: marker.seq,
+      index: marker.index,
+      frameId: marker.frameId,
+      ...(marker.url ? { url: marker.url } : {}),
+      ...(marker.title ? { title: marker.title } : {}),
+    };
+  }
+  return found;
+}
+
+// --- file reconstruction --------------------------------------------------
+
+interface FileBuilder {
+  path: string;
+  content?: string;
+  base?: string;
+  unknownBase: boolean;
+  writes: number;
+  edits: number;
+  lastSeq: number;
+  hunks: ReplayHunk[];
+}
+
+function applyEdit(content: string, before: string, after: string, replaceAll: boolean): string {
+  if (!before) return content;
+  if (replaceAll) return content.split(before).join(after);
+  const at = content.indexOf(before);
+  if (at < 0) return content;
+  return content.slice(0, at) + after + content.slice(at + before.length);
+}
+
+function noteHunk(file: FileBuilder, before: string, after: string, seq: number): void {
+  file.hunks.push({ seq, before, after });
+  if (file.hunks.length > 40) file.hunks.shift();
+  const size = file.hunks.reduce((sum, hunk) => sum + hunk.before.length + hunk.after.length, 0);
+  if (size > MAX_FILE_CHARS) file.hunks.shift();
+}
+
+function noteEdit(file: FileBuilder, before: string, after: string, seq: number): void {
+  file.edits += 1;
+  file.lastSeq = seq;
+  noteHunk(file, before, after, seq);
+  if (file.content !== undefined) file.content = applyEdit(file.content, before, after, false);
+}
+
+/** Reconstruct the files the agent wrote/edited, up to the cursor. */
+export function replayFiles(items: readonly RunStreamItem[], endIndex = items.length - 1): ReplayFile[] {
+  const files = new Map<string, FileBuilder>();
+  const last = Math.min(endIndex, items.length - 1);
+  for (let i = 0; i <= last; i += 1) {
+    const item = items[i];
+    if (!item || item.kind !== "tool.call") continue;
+    const data = isRecord(item.data) ? item.data : {};
+    const name = asString(data.name) ?? "";
+    if (classifyTool(name) !== "edit") continue;
+    const input = isRecord(data.input) ? data.input : {};
+    const path = asString(input.file_path) ?? asString(input.path);
+    if (!path) continue;
+    const file = files.get(path) ?? {
+      path,
+      unknownBase: true,
+      writes: 0,
+      edits: 0,
+      lastSeq: item.seq,
+      hunks: [],
+    };
+    files.set(path, file);
+
+    const writeContent = asString(input.content);
+    if (writeContent !== undefined && /(^|__)write$|create_file$|^write$/.test(toolKey(name))) {
+      if (file.content === undefined) file.base = ""; // fresh file written from scratch
+      if (file.writes === 0 && file.base === undefined) file.base = "";
+      file.content = writeContent.slice(0, MAX_FILE_CHARS);
+      file.writes += 1;
+      file.unknownBase = false;
+      file.lastSeq = item.seq;
+      continue;
+    }
+
+    const edits: Array<{ old: string; next: string; all: boolean }> = [];
+    const oldString = asString(input.old_string) ?? asString(input.old_str);
+    const newString = asString(input.new_string) ?? asString(input.new_str);
+    if (oldString !== undefined && newString !== undefined) {
+      edits.push({ old: oldString, next: newString, all: input.replace_all === true });
+    }
+    if (Array.isArray(input.edits)) {
+      for (const raw of input.edits) {
+        if (!isRecord(raw)) continue;
+        const old = asString(raw.old_string) ?? asString(raw.old_str);
+        const next = asString(raw.new_string) ?? asString(raw.new_str);
+        if (old !== undefined && next !== undefined) edits.push({ old, next, all: raw.replace_all === true });
+      }
+    }
+    for (const edit of edits) {
+      if (file.content !== undefined) {
+        file.edits += 1;
+        file.lastSeq = item.seq;
+        noteHunk(file, edit.old, edit.next, item.seq);
+        file.content = applyEdit(file.content, edit.old, edit.next, edit.all).slice(0, MAX_FILE_CHARS);
+      } else {
+        noteEdit(file, edit.old, edit.next, item.seq);
+      }
+    }
+  }
+  return [...files.values()]
+    .map((file) => ({
+      path: file.path,
+      ...(file.content !== undefined ? { content: file.content } : {}),
+      ...(file.base !== undefined ? { base: file.base } : {}),
+      unknownBase: file.unknownBase,
+      writes: file.writes,
+      edits: file.edits,
+      lastSeq: file.lastSeq,
+      hunks: file.hunks,
+    }))
+    .sort((a, b) => a.path.localeCompare(b.path));
+}
+
+/**
+ * Line diff: trim the common prefix/suffix, then mark the remaining middle as
+ * removed-then-added. Deterministic, bounded, and honest about what it does
+ * not compute (a word-level diff) — replays only need a readable change view.
+ */
+export function diffLines(before: string, after: string, maxRows = MAX_DIFF_ROWS): { rows: ReplayDiffRow[]; truncated: boolean } {
+  const a = before.split("\n");
+  const b = after.split("\n");
+  let start = 0;
+  while (start < a.length && start < b.length && a[start] === b[start]) start += 1;
+  let endA = a.length - 1;
+  let endB = b.length - 1;
+  while (endA >= start && endB >= start && a[endA] === b[endB]) {
+    endA -= 1;
+    endB -= 1;
+  }
+
+  const rows: ReplayDiffRow[] = [];
+  const hasChange = start <= endA || start <= endB;
+  if (!hasChange) return { rows, truncated: false };
+  const push = (type: ReplayDiffRowType, text: string) => {
+    if (rows.length < maxRows) rows.push({ type, text });
+  };
+  // A little context before the change keeps the hunk readable.
+  for (let i = Math.max(0, start - 3); i < start; i += 1) push("ctx", a[i]);
+  for (let i = start; i <= endA; i += 1) push("del", a[i]);
+  for (let i = start; i <= endB; i += 1) push("add", b[i]);
+  for (let i = endB + 1; i < Math.min(b.length, endB + 4); i += 1) push("ctx", b[i]);
+
+  const total = endA - start + 1 + (endB - start + 1);
+  return { rows, truncated: total > maxRows };
+}
+
+/** Diff view for the reconstructed files at the cursor. */
+export function replayDiffs(files: readonly ReplayFile[]): ReplayFileDiff[] {
+  return files.map((file) => {
+    let before: string;
+    let after: string;
+    let status: "added" | "modified";
+    if (file.hunks.length > 0) {
+      // Edits carry the exact strings that changed; show those rather than
+      // flattening the whole file into one added block.
+      before = file.hunks.map((hunk) => hunk.before).join("\n");
+      after = file.hunks.map((hunk) => hunk.after).join("\n");
+      status = "modified";
+    } else if (file.unknownBase) {
+      before = "";
+      after = "";
+      status = "modified";
+    } else {
+      before = file.base ?? "";
+      after = file.content ?? "";
+      status = file.writes > 0 ? "added" : "modified";
+    }
+    const { rows, truncated } = diffLines(before, after);
+    return {
+      path: file.path,
+      status,
+      added: rows.filter((row) => row.type === "add").length,
+      removed: rows.filter((row) => row.type === "del").length,
+      rows,
+      truncated,
+    };
+  });
+}
+
+// --- terminal + reasoning -------------------------------------------------
+
+function pushOutputLines(out: ReplayTerminalLine[], item: RunStreamItem, output: string, tone: ReplayTone): void {
+  const lines = output.split("\n");
+  const start = Math.max(0, lines.length - MAX_OUTPUT_LINES_PER_RESULT);
+  for (let i = start; i < lines.length; i += 1) {
+    const text = lines[i].replace(/\s+$/, "");
+    if (!text) continue;
+    out.push({ seq: item.seq, ts: item.ts, tone, text: clip(text, 400) });
+  }
+}
+
+/** Bash/terminal transcript, plus run lifecycle notes, up to the cursor. */
+export function replayTerminal(items: readonly RunStreamItem[], endIndex = items.length - 1): ReplayTerminalLine[] {
+  const out: ReplayTerminalLine[] = [];
+  const commands = new Map<string, string>();
+  const last = Math.min(endIndex, items.length - 1);
+  for (let i = 0; i <= last; i += 1) {
+    const item = items[i];
+    if (!item) continue;
+    const data = isRecord(item.data) ? item.data : {};
+    if (item.kind === "shell.cmd") {
+      const command = asString(data.command);
+      if (command) out.push({ seq: item.seq, ts: item.ts, tone: "cmd", text: clip(command, 400) });
+      continue;
+    }
+    if (item.kind === "tool.call") {
+      const name = asString(data.name) ?? "";
+      if (classifyTool(name) !== "bash") continue;
+      const input = isRecord(data.input) ? data.input : {};
+      const command = asString(input.command);
+      const id = asString(data.id);
+      if (id && command) commands.set(id, command);
+      if (command) out.push({ seq: item.seq, ts: item.ts, tone: "cmd", text: clip(command, 400) });
+      continue;
+    }
+    if (item.kind === "tool.result") {
+      const id = asString(data.id);
+      const output = asString(data.output) ?? "";
+      const ok = data.ok !== false;
+      if (id && commands.has(id) && !output) {
+        out.push({ seq: item.seq, ts: item.ts, tone: ok ? "note" : "err", text: ok ? "(no output)" : "command failed" });
+        continue;
+      }
+      pushOutputLines(out, item, output, ok ? "out" : "err");
+      continue;
+    }
+    if (item.kind === "run.started") {
+      const model = asString(data.model);
+      out.push({ seq: item.seq, ts: item.ts, tone: "note", text: model ? `run started · ${model}` : "run started" });
+      continue;
+    }
+    if (item.kind === "run.finished") {
+      const exitCode = asNumber(data.exitCode);
+      out.push({ seq: item.seq, ts: item.ts, tone: exitCode && exitCode !== 0 ? "err" : "note", text: `run finished · exit ${exitCode ?? 0}` });
+      continue;
+    }
+    if (item.kind === "run.error") {
+      out.push({ seq: item.seq, ts: item.ts, tone: "err", text: `error · ${clip(asString(data.message) ?? "unknown", 300)}` });
+      continue;
+    }
+    if (item.kind === "run.cancelled") {
+      out.push({ seq: item.seq, ts: item.ts, tone: "err", text: `stopped${asString(data.reason) ? ` · ${clip(asString(data.reason), 80)}` : ""}` });
+      continue;
+    }
+    if (item.kind === "tool.blocked") {
+      out.push({ seq: item.seq, ts: item.ts, tone: "err", text: `blocked · ${clip(asString(data.name) ?? "tool", 120)} — ${clip(asString(data.reason) ?? "", 200)}` });
+    }
+  }
+  return out.length > MAX_TERMINAL_LINES ? out.slice(-MAX_TERMINAL_LINES) : out;
+}
+
+/** The agent's own words (assistant text), in order, up to the cursor. */
+export function replayReasoning(items: readonly RunStreamItem[], endIndex = items.length - 1): ReplayReasoningEntry[] {
+  const out: ReplayReasoningEntry[] = [];
+  const last = Math.min(endIndex, items.length - 1);
+  for (let i = 0; i <= last; i += 1) {
+    const item = items[i];
+    if (!item || item.kind !== "assistant.text") continue;
+    const text = typeof item.data === "string" ? item.data : asString(isRecord(item.data) ? item.data.text : undefined);
+    if (!text) continue;
+    out.push({ seq: item.seq, ts: item.ts, text: clip(text, MAX_REASONING_CHARS) });
+  }
+  return out.slice(-MAX_REASONING_ENTRIES);
+}
+
+// --- the reducer ----------------------------------------------------------
+
+/**
+ * Reduce the log up to `index` (inclusive) into the replay view state.
+ * Called on every scrub tick; each pane is rebuilt from the same prefix so the
+ * panes can never disagree about "where we are".
+ */
+export function buildReplayAt(
+  items: readonly RunStreamItem[],
+  index: number,
+  options: { markers?: readonly ReplayMarker[]; archivedFrames?: ReadonlySet<number> | readonly number[] } = {},
+): ReplayViewState {
+  const last = items.length === 0 ? -1 : Math.min(Math.max(0, index), items.length - 1);
+  const slice = last >= 0 ? items.slice(0, last + 1) : [];
+  const files = replayFiles(items, last);
+  const markers = options.markers ?? buildMarkers(items);
+  return {
+    included: last + 1,
+    timeline: reduceRunTimeline(slice),
+    terminal: replayTerminal(items, last),
+    reasoning: replayReasoning(items, last),
+    files,
+    diffs: replayDiffs(files),
+    frame: nearestFrame(markers, last, options.archivedFrames),
+  };
+}
+
+// --- playback + seeking ---------------------------------------------------
+
+/** One playback tick at the given speed (1x/4x/16x events per 250ms). */
+export function advanceReplay(index: number, total: number, speed: number): number {
+  if (total <= 0) return 0;
+  const step = Math.max(1, Math.floor(speed));
+  return Math.min(total - 1, Math.max(0, index) + step);
+}
+
+/** The next error marker after the cursor, wrapping to the first error. */
+export function nextErrorIndex(markers: readonly ReplayMarker[], index: number): number | undefined {
+  const errors = markers.filter((marker) => marker.kind === "error");
+  if (errors.length === 0) return undefined;
+  return (errors.find((marker) => marker.index > index) ?? errors[0]).index;
+}
+
+/** The previous error marker before the cursor, wrapping to the last error. */
+export function prevErrorIndex(markers: readonly ReplayMarker[], index: number): number | undefined {
+  const errors = markers.filter((marker) => marker.kind === "error");
+  if (errors.length === 0) return undefined;
+  return ([...errors].reverse().find((marker) => marker.index < index) ?? errors[errors.length - 1]).index;
+}
+
+/** Step the cursor to the previous/next marker of any kind. */
+export function adjacentMarkerIndex(markers: readonly ReplayMarker[], index: number, direction: 1 | -1): number | undefined {
+  if (markers.length === 0) return undefined;
+  if (direction === 1) {
+    return (markers.find((marker) => marker.index > index) ?? markers[0]).index;
+  }
+  return ([...markers].reverse().find((marker) => marker.index < index) ?? markers[markers.length - 1]).index;
+}
+
+/** Index of the marker nearest (but not after) a 0..1 scrubber position. */
+export function markerAtFraction(markers: readonly ReplayMarker[], total: number, fraction: number): number {
+  if (total <= 0) return 0;
+  const target = Math.round(Math.min(1, Math.max(0, fraction)) * (total - 1));
+  let best: ReplayMarker | undefined;
+  for (const marker of markers) {
+    if (marker.index > target) break;
+    best = marker;
+  }
+  return best ? best.index : target;
+}
+
+// --- virtualization -------------------------------------------------------
+
+export interface WindowRange {
+  start: number;
+  end: number;
+  padTop: number;
+  padBottom: number;
+}
+
+/**
+ * Fixed-row virtual window: given the scroll offset, returns the rows worth
+ * rendering plus the spacer heights above and below. Keeps a 5,000-event list
+ * to a few dozen DOM nodes.
+ */
+export function windowRange(
+  total: number,
+  scrollTop: number,
+  rowHeight: number,
+  viewportHeight: number,
+  overscan = 8,
+): WindowRange {
+  const height = Math.max(1, rowHeight);
+  const viewport = Math.max(0, viewportHeight);
+  const visible = Math.ceil(viewport / height) + 1;
+  const safeTotal = Math.max(0, total);
+  if (safeTotal === 0) return { start: 0, end: 0, padTop: 0, padBottom: 0 };
+  const start = Math.min(safeTotal, Math.max(0, Math.floor(Math.max(0, scrollTop) / height) - overscan));
+  const end = Math.min(safeTotal, start + visible + overscan * 2);
+  return {
+    start,
+    end,
+    padTop: start * height,
+    padBottom: Math.max(0, (safeTotal - end) * height),
+  };
+}
+
+/** Marker counts for the legend. */
+export function markerCounts(markers: readonly ReplayMarker[]): Record<ReplayMarkerKind, number> {
+  const counts: Record<ReplayMarkerKind, number> = {
+    bash: 0,
+    edit: 0,
+    browser: 0,
+    llm: 0,
+    error: 0,
+    approval: 0,
+    other: 0,
+  };
+  for (const marker of markers) counts[marker.kind] += 1;
+  return counts;
+}
diff --git a/apps/swarmagents/lib/telemetry/frames.test.ts b/apps/swarmagents/lib/telemetry/frames.test.ts
new file mode 100644
index 000000000..9a453e006
--- /dev/null
+++ b/apps/swarmagents/lib/telemetry/frames.test.ts
@@ -0,0 +1,106 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import {
+  MAX_FRAMES_PER_RUN,
+  MAX_FRAME_BYTES,
+  listRunFrames,
+  readRunFrame,
+  runFramesDir,
+  saveRunFrame,
+} from "./frames";
+
+function tempDir(): string {
+  return fs.mkdtempSync(path.join(os.tmpdir(), "swarm-frames-"));
+}
+
+const jpeg = (size = 32, marker = 1): Uint8Array => {
+  const bytes = new Uint8Array(size);
+  bytes.fill(marker);
+  return bytes;
+};
+
+test("saveRunFrame archives and readRunFrame returns the exact bytes", () => {
+  const dir = tempDir();
+  try {
+    const frame = jpeg(64, 7);
+    const file = saveRunFrame("run_a", 1, frame, dir);
+    assert.ok(file);
+    assert.equal(fs.existsSync(runFramesDir("run_a", dir)), true);
+    const read = readRunFrame("run_a", 1, dir);
+    assert.ok(read);
+    assert.deepEqual([...read], [...frame]);
+    assert.equal(read?.byteLength, 64);
+    assert.deepEqual(listRunFrames("run_a", dir), [1]);
+  } finally {
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+test("frames are per run and per id", () => {
+  const dir = tempDir();
+  try {
+    saveRunFrame("run_a", 1, jpeg(8, 1), dir);
+    saveRunFrame("run_a", 2, jpeg(8, 2), dir);
+    saveRunFrame("run_b", 1, jpeg(8, 3), dir);
+    assert.deepEqual(listRunFrames("run_a", dir), [1, 2]);
+    assert.deepEqual(listRunFrames("run_b", dir), [1]);
+    assert.equal(readRunFrame("run_a", 2, dir)?.[0], 2);
+    assert.equal(readRunFrame("run_a", 3, dir), null);
+    assert.equal(readRunFrame("run_missing", 1, dir), null);
+  } finally {
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+test("saveRunFrame rejects invalid ids, empty bytes and oversized frames", () => {
+  const dir = tempDir();
+  try {
+    assert.equal(saveRunFrame("bad$id", 1, jpeg(), dir), null);
+    assert.equal(saveRunFrame("run_a", 0, jpeg(), dir), null);
+    assert.equal(saveRunFrame("run_a", -1, jpeg(), dir), null);
+    assert.equal(saveRunFrame("run_a", 1.5, jpeg(), dir), null);
+    assert.equal(saveRunFrame("run_a", 1, new Uint8Array(0), dir), null);
+    assert.equal(saveRunFrame("run_a", 1, jpeg(MAX_FRAME_BYTES + 1), dir), null);
+    assert.deepEqual(listRunFrames("run_a", dir), []);
+  } finally {
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+test("saveRunFrame is a no-op without storage", () => {
+  assert.equal(saveRunFrame("run_a", 1, jpeg(), null), null);
+  assert.deepEqual(listRunFrames("run_a", null), []);
+  assert.equal(readRunFrame("run_a", 1, null), null);
+});
+
+test("archival keeps only the newest MAX_FRAMES_PER_RUN frames", () => {
+  const dir = tempDir();
+  try {
+    for (let frameId = 1; frameId <= MAX_FRAMES_PER_RUN + 6; frameId += 1) {
+      saveRunFrame("run_a", frameId, jpeg(16, frameId % 200), dir);
+    }
+    const kept = listRunFrames("run_a", dir);
+    assert.equal(kept.length, MAX_FRAMES_PER_RUN);
+    assert.equal(kept[0], 7);
+    assert.equal(kept[kept.length - 1], MAX_FRAMES_PER_RUN + 6);
+    assert.equal(readRunFrame("run_a", 1, dir), null);
+    assert.ok(readRunFrame("run_a", MAX_FRAMES_PER_RUN + 6, dir));
+  } finally {
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+test("a re-saved frame id replaces its bytes without duplicating", () => {
+  const dir = tempDir();
+  try {
+    saveRunFrame("run_a", 4, jpeg(16, 1), dir);
+    saveRunFrame("run_a", 4, jpeg(16, 9), dir);
+    assert.deepEqual(listRunFrames("run_a", dir), [4]);
+    assert.equal(readRunFrame("run_a", 4, dir)?.[0], 9);
+  } finally {
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+});
diff --git a/apps/swarmagents/lib/telemetry/frames.ts b/apps/swarmagents/lib/telemetry/frames.ts
new file mode 100644
index 000000000..cdaee2787
--- /dev/null
+++ b/apps/swarmagents/lib/telemetry/frames.ts
@@ -0,0 +1,124 @@
+/**
+ * frames.ts — durable browser frames for Run Replay.
+ *
+ * The live browser manager publishes `browser.frame` events (frameId, URL,
+ * title) but the JPEG bytes themselves only lived in memory, so a finished
+ * run could never show what the page looked like mid-run. This module archives
+ * the most recent frames of each run on disk next to its telemetry log, with
+ * strict caps so a long run cannot fill the volume:
+ *
+ *   - at most MAX_FRAMES_PER_RUN frames (oldest dropped first),
+ *   - at most MAX_FRAME_BYTES for any single JPEG (larger frames skipped),
+ *   - at most MAX_FRAME_TOTAL_BYTES per run.
+ *
+ * Everything here is best-effort: archival must never break a live run, so
+ * write errors are swallowed and reads return null.
+ */
+
+import fs from "node:fs";
+import path from "node:path";
+import { getRunsDir, RUN_ID_RE } from "./paths";
+
+export const MAX_FRAMES_PER_RUN = 24;
+export const MAX_FRAME_BYTES = 512 * 1024;
+export const MAX_FRAME_TOTAL_BYTES = 8 * 1024 * 1024;
+
+const FRAME_FILE_RE = /^(\d{1,9})\.jpg$/;
+
+/** Directory holding one run's archived frames. */
+export function runFramesDir(runId: string, runsDir: string = getRunsDir() ?? ""): string {
+  return path.join(runsDir, "frames", runId);
+}
+
+function frameFile(runId: string, frameId: number, runsDir: string): string {
+  return path.join(runFramesDir(runId, runsDir), `${frameId}.jpg`);
+}
+
+function validFrameId(frameId: unknown): frameId is number {
+  return typeof frameId === "number" && Number.isInteger(frameId) && frameId > 0 && frameId < 1_000_000_000;
+}
+
+function listFrameFiles(dir: string): Array<{ frameId: number; file: string; size: number }> {
+  let names: string[];
+  try {
+    names = fs.readdirSync(dir);
+  } catch {
+    return [];
+  }
+  const out: Array<{ frameId: number; file: string; size: number }> = [];
+  for (const name of names) {
+    const match = FRAME_FILE_RE.exec(name);
+    if (!match) continue;
+    const file = path.join(dir, name);
+    try {
+      out.push({ frameId: Number(match[1]), file, size: fs.statSync(file).size });
+    } catch {
+      // A frame removed mid-prune: skip it.
+    }
+  }
+  return out.sort((a, b) => a.frameId - b.frameId);
+}
+
+/** Drop the oldest frames until the run is inside the count and byte caps. */
+function prune(dir: string, frames: Array<{ frameId: number; file: string; size: number }>): void {
+  let total = frames.reduce((sum, frame) => sum + frame.size, 0);
+  let count = frames.length;
+  for (const frame of frames) {
+    if (count <= MAX_FRAMES_PER_RUN && total <= MAX_FRAME_TOTAL_BYTES) break;
+    try {
+      fs.unlinkSync(frame.file);
+      count -= 1;
+      total -= frame.size;
+    } catch {
+      // Ignore: a concurrent reader/pruner already removed it.
+    }
+  }
+}
+
+/**
+ * Archive one JPEG frame for a run. Returns the stored path, or null when the
+ * frame/run id is invalid, the frame is too large, or storage is unavailable.
+ */
+export function saveRunFrame(
+  runId: string,
+  frameId: number,
+  jpeg: Uint8Array,
+  runsDir: string | null = getRunsDir(),
+): string | null {
+  if (!runsDir || !RUN_ID_RE.test(runId) || !validFrameId(frameId)) return null;
+  if (!(jpeg instanceof Uint8Array) || jpeg.byteLength === 0 || jpeg.byteLength > MAX_FRAME_BYTES) return null;
+  const dir = runFramesDir(runId, runsDir);
+  const file = frameFile(runId, frameId, runsDir);
+  try {
+    fs.mkdirSync(dir, { recursive: true });
+    fs.writeFileSync(file, jpeg);
+  } catch (err) {
+    console.error(`[telemetry] could not archive browser frame for ${runId}:`, err);
+    return null;
+  }
+  prune(dir, listFrameFiles(dir));
+  return file;
+}
+
+/** Archived frame ids for one run, oldest first. */
+export function listRunFrames(runId: string, runsDir: string | null = getRunsDir()): number[] {
+  if (!runsDir || !RUN_ID_RE.test(runId)) return [];
+  return listFrameFiles(runFramesDir(runId, runsDir)).map((frame) => frame.frameId);
+}
+
+/** Read one archived frame's bytes, or null when it is missing/unreadable. */
+export function readRunFrame(
+  runId: string,
+  frameId: number,
+  runsDir: string | null = getRunsDir(),
+): Buffer | null {
+  if (!runsDir || !RUN_ID_RE.test(runId) || !validFrameId(frameId)) return null;
+  const file = frameFile(runId, frameId, runsDir);
+  try {
+    const stat = fs.statSync(file);
+    if (!stat.isFile() || stat.size === 0 || stat.size > MAX_FRAME_BYTES) return null;
+    return fs.readFileSync(file);
+  } catch {
+    return null;
+  }
+}
diff --git a/apps/swarmagents/minimalist-ui/src/components/RunReplay.tsx b/apps/swarmagents/minimalist-ui/src/components/RunReplay.tsx
