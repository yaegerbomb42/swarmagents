@@ -0,0 +1,76 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { NextRequest } from "next/server";
+import { GET } from "./route";
+import { TelemetryBus } from "../../../../../../lib/telemetry/bus";
+import { configureRunsDir } from "../../../../../../lib/telemetry/paths";
+import { saveRunFrame } from "../../../../../../lib/telemetry/frames";
+
+function request(url: string, user: string | null = "alice"): NextRequest {
+  const headers = new Headers();
+  if (user !== null) headers.set("x-swarm-user", user);
+  return new NextRequest(`http://localhost${url}`, { headers });
+}
+
+function ctx(id: string): { params: Promise<{ id: string }> } {
+  return { params: Promise.resolve({ id }) };
+}
+
+function seed(dir: string): void {
+  const bus = new TelemetryBus({ persist: true, runsDir: () => dir });
+  bus.publish("run_1", { type: "run.created", data: { prompt: "frame run", userId: "alice" } });
+  bus.publish("run_1", { type: "run.finished", data: { exitCode: 0 } });
+  bus.publish("run_bob", { type: "run.created", data: { prompt: "bob run", userId: "bob" } });
+}
+
+test("GET run frame streams the archived JPEG to its owner", async () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "swarm-frame-route-"));
+  configureRunsDir(dir);
+  try {
+    seed(dir);
+    const jpeg = Uint8Array.from([0xff, 0xd8, 0xff, 0xe0, 1, 2, 3, 0xff, 0xd9]);
+    assert.ok(saveRunFrame("run_1", 2, jpeg));
+
+    const res = await GET(request("/api/runtime/runs/run_1/frame?frameId=2"), ctx("run_1"));
+    assert.equal(res.status, 200);
+    assert.equal(res.headers.get("content-type"), "image/jpeg");
+    assert.equal(res.headers.get("cache-control"), "no-store");
+    assert.equal(res.headers.get("content-length"), String(jpeg.byteLength));
+    assert.deepEqual([...new Uint8Array(await res.arrayBuffer())], [...jpeg]);
+
+    // The run detail response advertises the archived frame ids.
+    const { GET: replayGET } = await import("../route");
+    const detail = await replayGET(request("/api/runtime/runs/run_1"), ctx("run_1"));
+    const body = (await detail.json()) as { frames: number[] };
+    assert.deepEqual(body.frames, [2]);
+  } finally {
+    configureRunsDir(null);
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+test("GET run frame guards auth, ids, ownership and missing frames", async () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "swarm-frame-route-"));
+  configureRunsDir(dir);
+  try {
+    seed(dir);
+    saveRunFrame("run_1", 1, Uint8Array.from([1, 2, 3]));
+
+    assert.equal((await GET(request("/api/runtime/runs/run_1/frame?frameId=1", null), ctx("run_1"))).status, 401);
+    assert.equal((await GET(request("/api/runtime/runs/bad$id/frame?frameId=1"), ctx("bad$id"))).status, 400);
+    assert.equal((await GET(request("/api/runtime/runs/run_missing/frame?frameId=1"), ctx("run_missing"))).status, 404);
+    // Another user's run is a 404, exactly like the run itself.
+    assert.equal((await GET(request("/api/runtime/runs/run_bob/frame?frameId=1"), ctx("run_bob"))).status, 404);
+    // Missing/invalid frameId.
+    assert.equal((await GET(request("/api/runtime/runs/run_1/frame"), ctx("run_1"))).status, 400);
+    assert.equal((await GET(request("/api/runtime/runs/run_1/frame?frameId=zero"), ctx("run_1"))).status, 400);
+    assert.equal((await GET(request("/api/runtime/runs/run_1/frame?frameId=-2"), ctx("run_1"))).status, 400);
+    assert.equal((await GET(request("/api/runtime/runs/run_1/frame?frameId=9"), ctx("run_1"))).status, 404);
+  } finally {
+    configureRunsDir(null);
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+});
diff --git a/apps/swarmagents/app/api/runtime/runs/[id]/frame/route.ts b/apps/swarmagents/app/api/runtime/runs/[id]/frame/route.ts
new file mode 100644
index 000000000..61975b2c5
--- /dev/null
+++ b/apps/swarmagents/app/api/runtime/runs/[id]/frame/route.ts
@@ -0,0 +1,55 @@
+/**
+ * Archived browser frame for Run Replay.
+ *
+ * GET /api/runtime/runs/<id>/frame?frameId=<n> -> image/jpeg
+ *
+ * Frames are archived by the browser manager while a run is live (see
+ * lib/telemetry/frames.ts) so a finished run can show what the page looked
+ * like at the replay cursor. Same ownership rule as the run itself: you can
+ * only read frames of runs whose event log belongs to you.
+ */
+
+import { NextResponse, type NextRequest } from "next/server";
+import { USER_HEADER } from "../../../../../../lib/auth";
+import { RUN_ID_RE } from "../../../../../../lib/telemetry/paths";
+import { readRunFrame } from "../../../../../../lib/telemetry/frames";
+import { getRun } from "../../../../../../lib/runtime/run-store";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+function caller(req: NextRequest): string | null {
+  const user = req.headers.get(USER_HEADER);
+  return user && user.length > 0 && user.length <= 128 ? user : null;
+}
+
+export async function GET(req: NextRequest, ctx: { params: Promise<{ id: string }> }) {
+  const user = caller(req);
+  if (!user) return NextResponse.json({ error: "Sign in required." }, { status: 401 });
+
+  const { id } = await ctx.params;
+  if (!RUN_ID_RE.test(id)) return NextResponse.json({ error: "invalid runId" }, { status: 400 });
+
+  const run = getRun(id);
+  if (!run || (run.summary.userId && run.summary.userId !== user)) {
+    return NextResponse.json({ error: "Run not found." }, { status: 404 });
+  }
+
+  const raw = req.nextUrl.searchParams.get("frameId") ?? "";
+  const frameId = Number(raw);
+  if (!/^\d{1,9}$/.test(raw) || !Number.isInteger(frameId) || frameId <= 0) {
+    return NextResponse.json({ error: "frameId must be a positive integer." }, { status: 400 });
+  }
+
+  const jpeg = readRunFrame(id, frameId);
+  if (!jpeg) return NextResponse.json({ error: "Frame not found." }, { status: 404 });
+
+  const bytes = Uint8Array.from(jpeg);
+  return new Response(bytes, {
+    headers: {
+      "Content-Type": "image/jpeg",
+      "Cache-Control": "no-store",
+      "Content-Length": String(bytes.byteLength),
+    },
+  });
+}
