index 000000000..750243cdc
--- /dev/null
+++ b/apps/swarmagents/minimalist-ui/src/components/RunReplay.tsx
@@ -0,0 +1,801 @@
+"use client";
+
+/**
+ * RunReplay — time-travel viewer for a finished run (x1).
+ *
+ * Opened from the thread panel (or `#view=computer&replay=<runId>`). Loads the
+ * run's durable event log once, then scrubs it entirely client-side:
+ *
+ *   - a color-coded marker rail + range scrubber (drag, click, keyboard);
+ *   - play/pause at 1x/4x/16x and jump-to-next-error;
+ *   - panes for the terminal transcript, reconstructed files + diffs, the
+ *     nearest archived browser frame, the agent's reasoning, and a virtualized
+ *     raw event list;
+ *   - "fork from here": continue the same session as a new live run.
+ *
+ * See lib/client/replay.ts for the pure reducers (unit-tested separately).
+ */
+
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import { AlertTriangle, ChevronLeft, ChevronRight, FileCode2, GitFork, History, Image as ImageIcon, Loader2, Pause, Play, TerminalSquare, X } from 'lucide-react';
+import {
+  MARKER_COLOR,
+  MARKER_KINDS,
+  MARKER_LABEL,
+  adjacentMarkerIndex,
+  advanceReplay,
+  buildMarkers,
+  buildReplayAt,
+  buildReplayItems,
+  markerCounts,
+  nextErrorIndex,
+  prevErrorIndex,
+  windowRange,
+  type PersistedRunEvent,
+  type ReplayMarker,
+} from '../../../lib/client/replay';
+
+interface RunDetailSummary {
+  status?: string;
+  prompt?: string;
+  sessionId?: string;
+  model?: string;
+  createdAt?: number;
+  durationMs?: number;
+  exitCode?: number;
+  error?: string;
+  costUsd?: number;
+  tokensIn?: number;
+  tokensOut?: number;
+}
+
+interface RunDetail {
+  runId: string;
+  summary: RunDetailSummary;
+  events: PersistedRunEvent[];
+  frames?: number[];
+}
+
+type Pane = "terminal" | "files" | "screen" | "reasoning" | "events";
+
+const SPEEDS = [1, 4, 16] as const;
+const EVENT_ROW_HEIGHT = 34;
+const PLAY_TICK_MS = 250;
+
+const fmtDuration = (ms?: number) => {
+  if (ms == null) return '—';
+  if (ms < 1000) return `${Math.round(ms)}ms`;
+  if (ms < 60_000) return `${(ms / 1000).toFixed(1)}s`;
+  return `${Math.floor(ms / 60_000)}m${String(Math.round((ms % 60_000) / 1000)).padStart(2, '0')}s`;
+};
+
+const relTime = (ts: number, base: number) => {
+  const ms = Math.max(0, ts - base);
+  if (ms < 1000) return `+${Math.round(ms)}ms`;
+  if (ms < 60_000) return `+${(ms / 1000).toFixed(1)}s`;
+  return `+${Math.floor(ms / 60_000)}m${String(Math.round((ms % 60_000) / 1000)).padStart(2, '0')}s`;
+};
+
+const markerTitle = (marker: ReplayMarker) => `${MARKER_LABEL[marker.kind]} · event ${marker.seq} · ${marker.label}`;
+
+export function RunReplay({
+  runId,
+  onClose,
+  onFork,
+}: {
+  runId: string;
+  onClose: () => void;
+  /** Hand a freshly dispatched fork run back to the workspace. */
+  onFork: (newRunId: string, prompt: string) => void;
+}) {
+  const [detail, setDetail] = useState<RunDetail | null>(null);
+  const [loadError, setLoadError] = useState<string>();
+  const [index, setIndex] = useState(0);
+  const [pane, setPane] = useState<Pane>("terminal");
+  const [speed, setSpeed] = useState<number>(1);
+  const [playing, setPlaying] = useState(false);
+  const [selectedFile, setSelectedFile] = useState<string>();
+  const [forkPrompt, setForkPrompt] = useState('');
+  const [forking, setForking] = useState(false);
+  const [forkError, setForkError] = useState<string>();
+  const [frameBroken, setFrameBroken] = useState(false);
+  const eventScrollRef = useRef<HTMLDivElement>(null);
+  const terminalScrollRef = useRef<HTMLDivElement>(null);
+  const rootRef = useRef<HTMLDivElement>(null);
+
+  // Load the durable log once per run.
+  useEffect(() => {
+    let cancelled = false;
+    setDetail(null);
+    setLoadError(undefined);
+    setIndex(0);
+    setPlaying(false);
+    setFrameBroken(false);
+    fetch(`/api/runtime/runs/${encodeURIComponent(runId)}`, { cache: 'no-store', headers: { Accept: 'application/json' } })
+      .then(async (res) => {
+        if (!res.ok) {
+          const body = (await res.json().catch(() => null)) as { error?: string } | null;
+          throw new Error(body?.error ?? `Could not load the run (HTTP ${res.status}).`);
+        }
+        return (await res.json()) as RunDetail;
+      })
+      .then((body) => {
+        if (cancelled) return;
+        if (!Array.isArray(body.events) || body.events.length === 0) {
+          setLoadError('This run has no recorded events yet.');
+          return;
+        }
+        setDetail(body);
+        setIndex(body.events.length - 1);
+        setSelectedFile(undefined);
+      })
+      .catch((err) => {
+        if (!cancelled) setLoadError((err as Error).message);
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, [runId]);
+
+  const items = useMemo(() => (detail ? buildReplayItems(detail.events) : []), [detail]);
+  const markers = useMemo(() => buildMarkers(items), [items]);
+  const counts = useMemo(() => markerCounts(markers), [markers]);
+  const total = items.length;
+  const archived = useMemo(() => new Set<number>(detail?.frames ?? []), [detail]);
+  const view = useMemo(
+    () => (total > 0 ? buildReplayAt(items, index, { markers, archivedFrames: archived }) : null),
+    [items, index, markers, archived, total],
+  );
+
+  const baseTs = items[0]?.ts ?? 0;
+  const summary = view?.timeline.summary;
+  const activeFile = view?.diffs.find((file) => file.path === selectedFile) ?? view?.diffs[0];
+  const frame = view?.frame;
+
+  const seek = useCallback(
+    (next: number) => {
+      if (total === 0) return;
+      setPlaying(false);
+      setIndex(Math.min(total - 1, Math.max(0, next)));
+    },
+    [total],
+  );
+
+  const nextError = useCallback(() => {
+    const target = nextErrorIndex(markers, index);
+    if (target !== undefined) {
+      setPlaying(false);
+      setIndex(target);
+    }
+  }, [markers, index]);
+
+  // Playback: one tick advances 1/4/16 events; stops at the end.
+  useEffect(() => {
+    if (!playing || total === 0) return;
+    const timer = setInterval(() => {
+      setIndex((current) => {
+        const next = advanceReplay(current, total, speed);
+        if (next >= total - 1) setPlaying(false);
+        return next;
+      });
+    }, PLAY_TICK_MS);
+    return () => clearInterval(timer);
+  }, [playing, total, speed]);
+
+  // Keyboard shortcuts (ignored while typing in the fork prompt).
+  useEffect(() => {
+    const onKeyDown = (event: KeyboardEvent) => {
+      const el = event.target as HTMLElement | null;
+      const typing = !!el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.isContentEditable);
+      if (typing) return;
+      const step = event.shiftKey ? 5 : 1;
+      switch (event.key) {
+        case 'Escape':
+          event.preventDefault();
+          onClose();
+          break;
+        case ' ':
+          event.preventDefault();
+          setPlaying((value) => !value);
+          break;
+        case 'ArrowLeft':
+          event.preventDefault();
+          if (event.altKey) {
+            const target = adjacentMarkerIndex(markers, index, -1);
+            if (target !== undefined) seek(target);
+          } else {
+            seek(index - step);
+          }
+          break;
+        case 'ArrowRight':
+          event.preventDefault();
+          if (event.altKey) {
+            const target = adjacentMarkerIndex(markers, index, 1);
+            if (target !== undefined) seek(target);
+          } else {
+            seek(index + step);
+          }
+          break;
+        case 'Home':
+          event.preventDefault();
+          seek(0);
+          break;
+        case 'End':
+          event.preventDefault();
+          seek(total - 1);
+          break;
+        case 'e':
+        case 'E':
+          event.preventDefault();
+          nextError();
+          break;
+        default:
+          break;
+      }
+    };
+    window.addEventListener('keydown', onKeyDown);
+    return () => window.removeEventListener('keydown', onKeyDown);
+  }, [index, markers, onClose, seek, nextError, total]);
+
+  // Keep the event list pinned to the cursor.
+  useEffect(() => {
+    if (pane !== 'events') return;
+    const el = eventScrollRef.current;
+    if (!el) return;
+    el.scrollTop = Math.max(0, view ? (view.included - 1) * EVENT_ROW_HEIGHT - el.clientHeight / 2 : 0);
+  }, [index, pane, view]);
+
+  // Keep the terminal pinned to its newest line.
+  useEffect(() => {
+    if (pane !== 'terminal') return;
+    const el = terminalScrollRef.current;
+    if (el) el.scrollTop = el.scrollHeight;
+  }, [index, pane]);
+
+  const fork = async () => {
+    const prompt = forkPrompt.trim();
+    if (!prompt || forking) return;
+    setForking(true);
+    setForkError(undefined);
+    try {
+      const res = await fetch('/api/runtime/tasks', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          prompt,
+          ...(detail?.summary.sessionId ? { sessionId: detail.summary.sessionId } : {}),
+        }),
+      });
+      const body = (await res.json().catch(() => null)) as { runId?: string; error?: string } | null;
+      if (!res.ok || !body?.runId) {
+        setForkError(body?.error ?? `Could not start the fork (HTTP ${res.status}).`);
+        return;
+      }
+      onFork(body.runId, prompt);
+    } catch (err) {
+      setForkError((err as Error).message);
+    } finally {
+      setForking(false);
+    }
+  };
+
+  const position = total > 0 ? ((index + 1) / total) * 100 : 0;
+
+  return (
+    <div
+      ref={rootRef}
+      data-testid="replay-root"
+      role="dialog"
+      aria-modal="true"
+      aria-label="Run replay"
+      className="fixed inset-0 z-50 flex flex-col bg-[#08080c]/97 backdrop-blur-xl"
+    >
+      {/* header */}
+      <header className="flex flex-wrap items-center gap-2 border-b border-white/10 px-3 py-2.5 sm:px-5">
+        <span className="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-violet-400/10 text-violet-300">
+          <History className="h-4 w-4" />
+        </span>
+        <div className="min-w-0 flex-1">
+          <div className="truncate text-sm font-medium text-white/90">Run replay</div>
+          <div className="truncate font-mono text-[10px] text-white/40">
+            {runId}
+            {detail?.summary.prompt ? ` · ${detail.summary.prompt}` : ''}
+          </div>
+        </div>
+        <div className="flex items-center gap-3 font-mono text-[10px] text-white/45">
+          <span>event <span data-testid="replay-position" className="text-white/80">{total ? index + 1 : 0}/{total}</span></span>
+          {summary?.durationMs != null && <span>run <span className="text-white/80">{fmtDuration(summary.durationMs)}</span></span>}
+          {summary?.model && <span className="hidden sm:inline">{summary.model}</span>}
+        </div>
+        <button
+          type="button"
+          onClick={onClose}
+          aria-label="Close replay"
+          className="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-white/10 text-white/60 transition hover:bg-white/15 hover:text-white"
+        >
+          <X className="h-4 w-4" />
+        </button>
+      </header>
+
+      {loadError ? (
+        <div className="flex flex-1 items-center justify-center p-6">
+          <div className="max-w-md rounded-2xl border border-rose-400/20 bg-rose-400/5 px-5 py-6 text-center">
+            <AlertTriangle className="mx-auto mb-2 h-5 w-5 text-rose-300" />
+            <p className="text-sm text-rose-200">{loadError}</p>
