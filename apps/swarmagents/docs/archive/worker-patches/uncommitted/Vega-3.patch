diff --git a/apps/swarmagents/lib/client/viewHash.ts b/apps/swarmagents/lib/client/viewHash.ts
index becb147d3..bf9d665f5 100644
--- a/apps/swarmagents/lib/client/viewHash.ts
+++ b/apps/swarmagents/lib/client/viewHash.ts
@@ -36,3 +36,28 @@ export function buildViewHash(state: ViewHashState): string {
   if (state.landing) return "#view=overview";
   return `#view=computer&tab=${state.view}`;
 }
+
+/**
+ * Run Replay is an overlay on top of the workspace, so it rides in the same
+ * hash as an extra `replay=<runId>` parameter (e.g.
+ * `#view=computer&tab=terminal&replay=run_abc`). parseViewHash ignores unknown
+ * parameters, so the tab behaviour is unchanged when the overlay is closed.
+ */
+const REPLAY_ID_RE = /^[A-Za-z0-9_-]{1,64}$/;
+
+export function parseReplayId(hash: string): string | undefined {
+  const raw = hash.startsWith("#") ? hash.slice(1) : hash;
+  if (!raw) return undefined;
+  const id = new URLSearchParams(raw).get("replay");
+  return id !== null && REPLAY_ID_RE.test(id) ? id : undefined;
+}
+
+/** Add (or remove) the replay parameter on an existing view hash. */
+export function withReplayParam(hash: string, replayId?: string): string {
+  const base = hash.startsWith("#") ? hash.slice(1) : hash;
+  const params = new URLSearchParams(base);
+  if (replayId) params.set("replay", replayId);
+  else params.delete("replay");
+  const next = params.toString();
+  return next ? `#${next}` : "#view=overview";
+}
