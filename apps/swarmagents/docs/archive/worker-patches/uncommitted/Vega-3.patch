+}
+
+function JumpChip({ label, onClick, disabled }: { label: string; onClick: () => void; disabled?: boolean }) {
+  return (
+    <button
+      type="button"
+      onClick={onClick}
+      disabled={disabled}
+      className="rounded-full bg-white/5 px-2 py-0.5 text-white/55 transition hover:bg-white/10 hover:text-white disabled:opacity-30"
+    >
+      {label}
+    </button>
+  );
+}
+
+function PaneTab({
+  pane,
+  active,
+  onSelect,
+  icon,
+  label,
+  badge,
+}: {
+  pane: Pane;
+  active: Pane;
+  onSelect: (pane: Pane) => void;
+  icon: React.ReactNode;
+  label: string;
+  badge: number;
+}) {
+  const isActive = active === pane;
+  return (
+    <button
+      type="button"
+      data-testid={`replay-tab-${pane}`}
+      aria-pressed={isActive}
+      onClick={() => onSelect(pane)}
+      className={`flex shrink-0 items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] transition ${
+        isActive ? 'bg-white/10 text-white' : 'text-white/45 hover:bg-white/5 hover:text-white/80'
+      }`}
+    >
+      {icon}
+      {label}
+      {badge > 0 && <span className="font-mono text-[9.5px] text-white/30">{badge}</span>}
+    </button>
+  );
+}
+
+/**
+ * Virtualized raw event list: only the rows in view are rendered, so a run
+ * with 5,000+ events stays responsive while the cursor moves.
+ */
+function VirtualEventList({
+  items,
+  included,
+  index,
+  onSeek,
+  scrollRef,
+}: {
+  items: ReturnType<typeof buildReplayItems>;
+  included: number;
+  index: number;
+  onSeek: (index: number) => void;
+  scrollRef: React.RefObject<HTMLDivElement | null>;
+}) {
+  const [scrollTop, setScrollTop] = useState(0);
+  const [viewport, setViewport] = useState(320);
+  const rows = items.slice(0, included);
+  const range = windowRange(rows.length, scrollTop, EVENT_ROW_HEIGHT, viewport);
+
+  useEffect(() => {
+    const el = scrollRef.current;
+    if (!el) return;
+    const measure = () => setViewport(el.clientHeight || 320);
+    measure();
+    const observer = typeof ResizeObserver === 'undefined' ? null : new ResizeObserver(measure);
+    observer?.observe(el);
+    return () => observer?.disconnect();
+  }, [scrollRef]);
+
+  return (
+    <div
+      ref={(node) => {
+        scrollRef.current = node;
+      }}
+      data-testid="replay-events"
+      onScroll={(event) => setScrollTop(event.currentTarget.scrollTop)}
+      className="h-full overflow-y-auto rounded-xl border border-white/10 bg-black/40"
+    >
+      <div style={{ paddingTop: range.padTop, paddingBottom: range.padBottom }}>
+        {rows.slice(range.start, range.end).map((item, offset) => {
+          const rowIndex = range.start + offset;
+          const isCursor = rowIndex === index;
+          const data = item.data;
+          const summary = typeof data === 'string' ? data : data && typeof data === 'object' ? JSON.stringify(data) : '';
+          return (
+            <button
+              key={item.seq}
+              type="button"
+              data-testid="replay-event-row"
+              onClick={() => onSeek(rowIndex)}
+              style={{ height: EVENT_ROW_HEIGHT }}
+              className={`flex w-full items-center gap-2 border-b border-white/5 px-2 text-left font-mono text-[10px] transition ${
+                isCursor ? 'bg-violet-400/15 text-white' : 'text-white/55 hover:bg-white/5'
+              }`}
+            >
+              <span className="w-10 shrink-0 text-white/25">{item.seq}</span>
+              <span className="w-32 shrink-0 truncate text-white/70">{item.kind}</span>
+              <span className="min-w-0 flex-1 truncate text-white/35">{summary.slice(0, 160)}</span>
+            </button>
+          );
+        })}
+      </div>
+    </div>
+  );
+}
