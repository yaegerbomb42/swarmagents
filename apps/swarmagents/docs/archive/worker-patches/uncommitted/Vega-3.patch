+import assert from "node:assert/strict";
+import { after, test } from "node:test";
+import { captureView, closeBrowser, openWorkspace, runPageTest } from "./lib";
+import { RECORDED_EVENTS, RECORDED_PROMPT, RECORDED_RUN_ID } from "../lib/client/replay.fixture";
+
+after(async () => {
+  await closeBrowser();
+});
+
+const TOTAL = RECORDED_EVENTS.length;
+
+const SUMMARY = {
+  status: "finished",
+  prompt: RECORDED_PROMPT,
+  sessionId: "sess_replay",
+  model: "fake-claude",
+  createdAt: RECORDED_EVENTS[0].ts,
+  durationMs: 42_000,
+  exitCode: 0,
+  costUsd: 0.0331,
+  tokensIn: 4400,
+  tokensOut: 1320,
+};
+
+test("replay: scrub, play, panes and fork from a recorded run", async (t) => {
+  const testName = "replay: scrub, play, panes and fork from a recorded run";
+  let forkBody: Record<string, unknown> | undefined;
+
+  const result = await runPageTest(testName, async ({ page, context }) => {
+    await openWorkspace(page, context);
+
+    // Serve the recorded fixture and accept the fork, without touching a VM.
+    await page.route(`**/api/runtime/runs/${RECORDED_RUN_ID}`, async (route) => {
+      await route.fulfill({
+        status: 200,
+        contentType: "application/json",
+        body: JSON.stringify({
+          runId: RECORDED_RUN_ID,
+          summary: SUMMARY,
+          events: RECORDED_EVENTS,
+          frames: [],
+        }),
+      });
+    });
+    await page.route("**/api/runtime/tasks", async (route) => {
+      if (route.request().method() !== "POST") return route.continue();
+      forkBody = JSON.parse(route.request().postData() ?? "{}") as Record<string, unknown>;
+      await route.fulfill({
+        status: 201,
+        contentType: "application/json",
+        body: JSON.stringify({ runId: "run_fork_1" }),
+      });
+    });
+
+    // Deep link: the replay overlay rides in the workspace hash.
+    await page.evaluate((runId) => {
+      window.location.hash = `#view=computer&tab=terminal&replay=${runId}`;
+    }, RECORDED_RUN_ID);
+
+    const root = page.locator("[data-testid='replay-root']");
+    await root.waitFor({ state: "visible", timeout: 15_000 });
+    await page.getByText(`event ${TOTAL}/${TOTAL}`).first().waitFor({ state: "visible", timeout: 10_000 });
+    await captureView(page, testName, "replay-open");
+
+    // Scrub to the beginning-ish: terminal shows the early steps, files are empty.
+    const scrubber = page.locator("[data-testid='replay-scrubber']");
+    await scrubber.evaluate((el, value) => {
+      const input = el as HTMLInputElement;
+      input.value = String(value);
+      input.dispatchEvent(new Event("input", { bubbles: true }));
+      input.dispatchEvent(new Event("change", { bubbles: true }));
+    }, 4);
+    await page.getByText("event 5/").first().waitFor({ state: "visible", timeout: 10_000 });
+    const terminal = page.locator("[data-testid='replay-terminal']");
+    await terminal.getByText(/step 1/).first().waitFor({ state: "visible", timeout: 10_000 });
+
+    await page.locator("[data-testid='replay-tab-files']").click();
+    await page.getByText("No files written or edited up to this point.").waitFor({ state: "visible", timeout: 10_000 });
+
+    // Playback advances the cursor; 16x advances faster than 1x.
+    await page.locator("[data-testid='replay-tab-terminal']").click();
+    await page.locator("[data-testid='replay-speed-16']").click();
+    assert.equal(await page.locator("[data-testid='replay-speed-16']").getAttribute("aria-pressed"), "true");
+    const before = await page.locator("[data-testid='replay-position']").innerText();
+    await page.locator("[data-testid='replay-play']").click();
+    await page.waitForTimeout(700);
+    const afterPlay = await page.locator("[data-testid='replay-position']").innerText();
+    assert.notEqual(afterPlay, before, `playback should advance the cursor (was ${before})`);
+    const indexAfterPlay = Number(afterPlay.split("/")[0]);
+    assert.ok(indexAfterPlay >= 20, `16x playback should jump several events (at ${afterPlay})`);
+    await page.locator("[data-testid='replay-play']").click();
+    await captureView(page, testName, "replay-playing");
+
+    // Jump to the end: the reconstructed file and its diff are visible.
+    await scrubber.evaluate((el, value) => {
+      const input = el as HTMLInputElement;
+      input.value = String(value);
+      input.dispatchEvent(new Event("input", { bubbles: true }));
+      input.dispatchEvent(new Event("change", { bubbles: true }));
+    }, TOTAL - 1);
+    await page.getByText(`event ${TOTAL}/${TOTAL}`).first().waitFor({ state: "visible", timeout: 10_000 });
+    await page.locator("[data-testid='replay-tab-files']").click();
+    await page.getByText("report.md").first().waitFor({ state: "visible", timeout: 10_000 });
+    await page.getByText("reviewed line").first().waitFor({ state: "visible", timeout: 10_000 });
+    await captureView(page, testName, "replay-files");
+
+    // Screen: the fixture has no archived frames, so the honest empty state shows.
+    await page.locator("[data-testid='replay-tab-screen']").click();
+    await page.getByText("No browser frame at or before this point.").waitFor({ state: "visible", timeout: 10_000 });
+
+    // Events: virtualized rows render.
+    await page.locator("[data-testid='replay-tab-events']").click();
+    assert.ok((await page.locator("[data-testid='replay-event-row']").count()) > 5, "virtualized event rows should render");
+    await page.getByText("run.finished").first().waitFor({ state: "visible", timeout: 10_000 });
+
+    // Keyboard: jump to the next error with "e".
+    await page.locator("[data-testid='replay-tab-terminal']").click();
+    await page.keyboard.press("e");
+    await page.getByText(/command exited with status 1/).first().waitFor({ state: "visible", timeout: 10_000 });
+
+    // Fork from here: resumes the recorded session, then hands the page to the new run.
+    await page.locator("[data-testid='replay-fork-input']").fill("Continue from the failing step and fix it");
+    await page.locator("[data-testid='replay-fork-submit']").click();
+    await page.waitForFunction(() => !document.querySelector("[data-testid='replay-root']"), undefined, { timeout: 10_000 });
+    assert.equal(forkBody?.prompt, "Continue from the failing step and fix it");
+    assert.equal(forkBody?.sessionId, "sess_replay");
+    await captureView(page, testName, "replay-forked");
+  });
+
+  if (result.skipped) t.skip(result.skipped);
+});
