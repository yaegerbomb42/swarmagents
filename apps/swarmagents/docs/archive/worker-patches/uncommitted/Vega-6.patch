diff --git a/apps/swarmagents/minimalist-ui/src/components/spending.test.ts b/apps/swarmagents/minimalist-ui/src/components/spending.test.ts
new file mode 100644
index 000000000..4fc0e01a6
--- /dev/null
+++ b/apps/swarmagents/minimalist-ui/src/components/spending.test.ts
@@ -0,0 +1,72 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  MAX_BUDGET_USD,
+  describeDailySpend,
+  formatBudgetInput,
+  formatUsd,
+  parseBudgetInput,
+} from './spending';
+
+test("a blank budget means no cap, not zero", () => {
+  // 0 would block every paid request; blank means "no limit".
+  assert.deepEqual(parseBudgetInput(""), { value: null, error: "" });
+  assert.deepEqual(parseBudgetInput("   "), { value: null, error: "" });
+});
+
+test("a plain number is accepted", () => {
+  assert.deepEqual(parseBudgetInput("5"), { value: 5, error: "" });
+  assert.deepEqual(parseBudgetInput("2.50"), { value: 2.5, error: "" });
+  assert.deepEqual(parseBudgetInput("0"), { value: 0, error: "" });
+  assert.deepEqual(parseBudgetInput(" 12 "), { value: 12, error: "" });
+});
+
+test("a negative budget is rejected", () => {
+  const result = parseBudgetInput("-1");
+  assert.equal(result.value, null);
+  assert.match(result.error, /negative/i);
+});
+
+test("text that is not a number is rejected", () => {
+  for (const input of ["abc", "12abc", "1e3", "1,5", "$5", "5$", "--5", "1.2.3"]) {
+    const result = parseBudgetInput(input);
+    assert.equal(result.value, null, `"${input}" should be rejected`);
+    assert.notEqual(result.error, "", `"${input}" should explain the problem`);
+  }
+});
+
+test("a budget above the limit is rejected", () => {
+  const result = parseBudgetInput(String(MAX_BUDGET_USD + 1));
+  assert.equal(result.value, null);
+  assert.match(result.error, /limit/i);
+});
+
+test("formatBudgetInput renders a cap with at most two decimals", () => {
+  assert.equal(formatBudgetInput(null), "");
+  assert.equal(formatBudgetInput(undefined), "");
+  assert.equal(formatBudgetInput(0), "0");
+  assert.equal(formatBudgetInput(2.5), "2.5");
+  assert.equal(formatBudgetInput(2.567), "2.57");
+});
+
+test("the daily spend line compares spend with the cap", () => {
+  const under = describeDailySpend(1.5, 10);
+  assert.equal(under.capped, true);
+  assert.equal(under.over, false);
+  assert.match(under.text, /\$1\.50 of \$10\.00 today/);
+
+  const over = describeDailySpend(12, 10);
+  assert.equal(over.over, true);
+  assert.match(over.text, /over the cap/);
+
+  const uncapped = describeDailySpend(3, null);
+  assert.equal(uncapped.capped, false);
+  assert.match(uncapped.text, /no daily cap/);
+});
+
+test("formatUsd renders cents", () => {
+  assert.equal(formatUsd(0), "$0.00");
+  assert.equal(formatUsd(1.5), "$1.50");
+  assert.equal(formatUsd(-2), "-$2.00");
+  assert.equal(formatUsd(Number.NaN), "$0.00");
+});
diff --git a/apps/swarmagents/minimalist-ui/src/components/spending.ts b/apps/swarmagents/minimalist-ui/src/components/spending.ts
