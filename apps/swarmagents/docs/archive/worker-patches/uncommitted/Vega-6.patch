--- /dev/null
+++ b/apps/swarmagents/minimalist-ui/src/components/spending.ts
@@ -0,0 +1,96 @@
+/**
+ * Validation for the Spending controls in Settings (k4).
+ *
+ * The router's routing policy carries two USD caps (`perRunBudgetUsd`,
+ * `perDayBudgetUsd`) and one switch (`allowPaidProviders`). The server
+ * accepts a number >= 0 or null ("no cap"); this module is the client-side
+ * mirror of that contract, kept pure so it can be unit-tested without a DOM.
+ *
+ * The rules:
+ *   - a blank field means "no cap" (null), not 0 — 0 would block every paid
+ *     request, which is a different thing entirely;
+ *   - a negative number is rejected before it is ever sent;
+ *   - a value that is not a number is rejected;
+ *   - "Allow paid providers" is a boolean and is always valid.
+ */
+
+/** A budget the user typed, already validated. */
+export interface ParsedBudget {
+  /** The USD cap, or null for "no cap". */
+  value: number | null;
+  /** Why the input was rejected (empty string when it is fine). */
+  error: string;
+}
+
+/** The largest cap we accept, in USD. Anything bigger is a typo. */
+export const MAX_BUDGET_USD = 100_000;
+
+/**
+ * Parse a budget input. Returns the cap to send (null = no cap) or an error
+ * the field can show. Never throws.
+ */
+export function parseBudgetInput(raw: string): ParsedBudget {
+  const trimmed = raw.trim();
+  // Blank means "no cap": the user has not set a limit.
+  if (trimmed === "") return { value: null, error: "" };
+
+  // Reject anything that is not a plain number before Number() can be
+  // fooled by things like "12abc" (Number would give NaN) or "1e3" (which
+  // is a valid number but not what a budget field means).
+  if (!/^\d*\.?\d+$/.test(trimmed)) {
+    return { value: null, error: "Enter a dollar amount, or leave blank for no limit." };
+  }
+
+  const value = Number(trimmed);
+  if (!Number.isFinite(value)) {
+    return { value: null, error: "Enter a dollar amount, or leave blank for no limit." };
+  }
+  if (value < 0) {
+    return { value: null, error: "A budget cannot be negative." };
+  }
+  if (value > MAX_BUDGET_USD) {
+    return { value: null, error: `That is above the ${MAX_BUDGET_USD} USD limit.` };
+  }
+  return { value, error: "" };
+}
+
+/**
+ * Format a cap for a field: blank when there is no cap, otherwise the
+ * number with at most two decimals (a cap is a limit, not a price).
+ */
+export function formatBudgetInput(value: number | null | undefined): string {
+  if (value === null || value === undefined) return "";
+  if (!Number.isFinite(value)) return "";
+  return String(Math.round(value * 100) / 100);
+}
+
+/**
+ * The spend line under the daily cap: what has been spent today against the
+ * cap. With no cap there is nothing to compare, so the caller shows the
+ * spend on its own.
+ */
+export function describeDailySpend(
+  spendTodayUsd: number,
+  capUsd: number | null | undefined,
+): { text: string; over: boolean; capped: boolean } {
+  const spend = Number.isFinite(spendTodayUsd) ? spendTodayUsd : 0;
+  const capped = typeof capUsd === "number" && Number.isFinite(capUsd);
+  if (!capped) {
+    return { text: `${formatUsd(spend)} today · no daily cap`, over: false, capped: false };
+  }
+  const cap = capUsd as number;
+  const over = spend > cap;
+  return {
+    text: `${formatUsd(spend)} of ${formatUsd(cap)} today${over ? " — over the cap" : ""}`,
+    over,
+    capped: true,
+  };
+}
+
+/** A USD amount with cents, for display. */
+export function formatUsd(value: number): string {
+  if (!Number.isFinite(value)) return "$0.00";
+  const sign = value < 0 ? "-" : "";
+  const abs = Math.abs(value);
+  return `${sign}$${abs.toFixed(2)}`;
+}
