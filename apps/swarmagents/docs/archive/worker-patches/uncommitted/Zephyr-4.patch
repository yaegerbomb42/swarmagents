+/**
+ * The tool ids a role may actually call.
+ *
+ * A role's tool list is the ceiling, but the role's permission flags are the
+ * harder ceiling: a role can never grant more than its own permissions allow.
+ * A read-only role that still lists `write_file` does not get Write, a role
+ * without `allowBash` never gets Bash, and so on. Unknown (imported/MCP) tool
+ * ids pass through untouched — the harness cannot classify them.
+ */
+export function roleEffectiveTools(role: RoleDefinition): string[] {
+  const p = role.permissions;
+  return role.tools.filter((tool) => {
+    switch (tool) {
+      case "write_file":
+      case "edit_file":
+      case "restore_checkpoint":
+        return p.allowWrite && !p.readOnly;
+      case "bash":
+        return p.allowBash;
+      case "web_search":
+      case "web_fetch":
+      case "api_request":
+        return p.allowNetwork;
+      case "browser":
+        return p.allowBrowser;
+      case "subagent":
+        return p.allowSubagents;
+      default:
+        return true;
+    }
+  });
+}
+
+/**
+ * Claude Code permission strings that a role must NOT get.
+ *
+ * --allowedTools alone only pre-approves the listed tools; it does not stop
+ * the model from asking for others. The disallowed list is what actually
+ * enforces the role server-side: a researcher role cannot Write, Edit or run
+ * Bash even if it decides to try.
+ *
+ * The list is derived from the role's own tool vocabulary: every built-in tool
+ * the role does not grant is denied. Only real Claude Code tool names appear
+ * here (the role's own ids map onto them below); a role-only capability such
+ * as the API request tool has no Claude Code counterpart to deny.
+ */
+export function roleDisallowedTools(
+  role: RoleDefinition,
+  opts: { desktopMode?: boolean } = {},
+): string[] {
+  const granted = new Set(roleAllowedTools(role, opts));
+  const effective = new Set(roleEffectiveTools(role));
+  const out: string[] = [];
+  for (const [toolId, permission] of Object.entries(ROLE_TOOL_DENY_NAME)) {
+    if (effective.has(toolId)) continue;
+    if (granted.has(permission)) continue;
+    out.push(permission);
+  }
+  // The multi-edit spellings of Write/Edit follow Write/Edit.
+  if (!effective.has("write_file") && !effective.has("edit_file")) {
+    out.push("MultiEdit", "NotebookEdit");
+  }
+  return [...new Set(out)];
+}
+
+/**
+ * Role tool id -> the real Claude Code tool name that grants the same
+ * capability. Used to build the --disallowedTools list.
+ */
+const ROLE_TOOL_DENY_NAME: Record<string, string> = {
+  bash: "Bash",
+  write_file: "Write",
+  edit_file: "Edit",
+  web_search: "WebSearch",
+  web_fetch: "WebFetch",
+  subagent: "Task",
+};
+
