+import { describe, it } from "node:test";
+import { expect } from "./expect-shim.test-helper";
+import { classifyStep, type ClassificationInput } from "./classifier";
+
+function step(overrides: ClassificationInput = {}): ClassificationInput {
+  return { prompt: "fix the typo in the heading", ...overrides };
+}
+
+describe("classifyStep", () => {
+  it("classifies a short simple request as trivial/fast", () => {
+    const c = classifyStep(step());
+    expect(c.category).toBe("trivial");
+    expect(c.tier).toBe("fast");
+    expect(c.reason).toContain("short simple request");
+  });
+
+  it("classifies an ordinary coding request as normal/balanced", () => {
+    const c = classifyStep(step({ prompt: "Refactor the pricing module so it uses the new currency table and updates the summary endpoint accordingly." }));
+    expect(c.category).toBe("normal");
+    expect(c.tier).toBe("balanced");
+  });
+
+  it("classifies many files as complex/deep", () => {
+    const c = classifyStep(step({ prompt: "Implement the feature across the whole service.", filesTouched: 6 }));
+    expect(c.category).toBe("complex");
+    expect(c.tier).toBe("deep");
+  });
+
+  it("classifies a planner 'architecture' tag as deep", () => {
+    const c = classifyStep(step({ prompt: "Lay out the system", plannerTag: "architecture" }));
+    expect(c.category).toBe("deep");
+    expect(c.tier).toBe("deep");
+    expect(c.reason).toContain("architecture");
+  });
+
+  it("classifies a planner 'refactor' tag as complex", () => {
+    const c = classifyStep(step({ prompt: "Change the schema", plannerTag: "refactor" }));
+    expect(c.category).toBe("complex");
+    expect(c.tier).toBe("deep");
+    expect(c.reason).toContain("refactor");
+  });
+
+  it("large token volume is deep", () => {
+    const c = classifyStep(step({ prompt: "R", estimatedTokens: 8000 }));
+    expect(c.category).toBe("deep");
+    expect(c.tier).toBe("deep");
+    expect(c.reason).toContain("large step");
+  });
+
+  it("deep keywords push to deep", () => {
+    const c = classifyStep(step({ prompt: "Think about the architecture and the tradeoffs.", keywords: ["architecture", "tradeoff"] }));
+    expect(c.category).toBe("deep");
+    expect(c.tier).toBe("deep");
+  });
+
+  it("empty prompt never crashes and stays balanced", () => {
+    const c = classifyStep({});
+    expect(c.category).toBe("normal");
+    expect(c.tier).toBe("balanced");
+  });
+});
diff --git a/apps/swarmagents/lib/router/classifier.ts b/apps/swarmagents/lib/router/classifier.ts
new file mode 100644
index 000000000..bb398cdf9
--- /dev/null
+++ b/apps/swarmagents/lib/router/classifier.ts
@@ -0,0 +1,167 @@
+/**
+ * Step classifier (lib/router/classifier.ts).
+ *
+ * g4 "Automatic per-step model routing": turns cheap signals about one step of
+ * a task (prompt length, estimated tokens, number of files/tools touched,
+ * narrator keywords, planner-provided tags) into a classification the routing
+ * layer can act on:
+ *
+ *   category  tier     meaning
+ *   trivial -> fast     one-line edits, summaries, simple lookups
+ *   normal  -> balanced ordinary coding / authoring steps
+ *   complex -> deep     refactors, debugging, multi-file changes
+ *   deep    -> deep     planning, architecture, research, very large steps
+ *
+ * The classification is pure and synchronous so it is trivially unit-testable
+ * and safe to call in request handlers and the LLM gateway.
+ */
+
+export type StepTier = "fast" | "balanced" | "deep";
+
+export type StepCategory = "trivial" | "normal" | "complex" | "deep";
+
+export interface ClassificationInput {
+  /** Trimmed prompt text for this step. */
+  prompt?: string;
+  /** Estimated prompt tokens when known; falls back to len/4. */
+  estimatedTokens?: number;
+  /** How many files/tools the step touches (0 defaults to 0). */
+  filesTouched?: number;
+  /** Offer keywords extracted from the prompt. */
+  keywords?: readonly string[];
+  /** Planner-provided tag, e.g. "plan", "implement", "refactor". */
+  plannerTag?: string;
+}
+
+export interface StepClassification {
+  category: StepCategory;
+  tier: StepTier;
+  /** Human-readable signal that produced this classification. */
+  reason: string;
+}
+
+/** Planner tags that signal deep reasoning regardless of raw size. */
+const DEEP_TAGS = new Set([
+  "architecture",
+  "design",
+  "plan",
+  "research",
+  "strategy",
+  "synthesize",
+]);
+
+/** Planner tags that signal a complex, logic-heavy step. */
+const COMPLEX_TAGS = new Set([
+  "build",
+  "debug",
+  "fix",
+  "integrate",
+  "implement",
+  "migrate",
+  "optimize",
+  "performance",
+  "refactor",
+  "scale",
+  "security",
+  "test",
+]);
+
+const DEEP_KEYWORDS = new Set([
+  "architecture",
+  "design",
+  "hard",
+  "research",
+  "tradeoff",
+  "trade-off",
+]);
+
+const COMPLEX_KEYWORDS = new Set([
+  "async",
+  "bug",
+  "complex",
+  "concurrency",
+  "debug",
+  "migrate",
+  "multi",
+  "pipeline",
+  "refactor",
+  "schema",
+  "thread",
+]);
+
+/** Size thresholds (tokens) beyond which a step is complex / deep. */
+const COMPLEX_TOKEN_THRESHOLD = 1_500;
+const DEEP_TOKEN_THRESHOLD = 6_000;
+const TRIVIAL_CHARS = 200;
+const COMPLEX_FILES = 3;
+const DEEP_FILES = 8;
+
+/** Common words that carry no routing signal. */
+const STOPWORDS = new Set(
+  "the and for with this that from into your you are all its them they then was were has have been will would could should about which their there when where what because after before just only also than very not but use using make made take get set put can may might each every some any new old two one our out over under within without until while during".split(" "),
+);
+
+function derivedKeywords(prompt: string): string[] {
+  const words = prompt.toLowerCase().match(/[a-z][a-z0-9-]{2,}/g) ?? [];
+  return [...new Set(words.filter((w) => !STOPWORDS.has(w)))].slice(0, 12);
+}
+
+export function classifyStep(input: ClassificationInput): StepClassification {
+  const prompt = (input.prompt ?? "").trim();
+  const len = prompt.length;
+  const tokens = input.estimatedTokens ?? Math.max(1, Math.round(len / 4));
+  const files = input.filesTouched ?? 0;
+  const tag = (input.plannerTag ?? "").trim().toLowerCase();
+
+  // Explicit keywords come from the caller (planner/tool hints) and are strong
+  // signals. Keywords we derive from the prompt text are weak: they keep a step
+  // from being "trivial" but only escalate to complex/deep when reinforced by
+  // size evidence, so a short request that merely mentions "refactor" stays an
+  // ordinary coding step instead of being over-classified.
+  const explicitKw = new Set((input.keywords ?? []).map((k) => k.toLowerCase()));
+  const derivedKw = new Set(derivedKeywords(prompt));
+
+  const reasons: string[] = [];
+
+  const isDeepTag = DEEP_TAGS.has(tag);
+  const isComplexTag = COMPLEX_TAGS.has(tag);
+  const hasDeepKeywordExplicit = [...explicitKw].some((w) => DEEP_KEYWORDS.has(w));
+  const hasComplexKeywordExplicit = [...explicitKw].some((w) => COMPLEX_KEYWORDS.has(w));
+  const hasDeepKeywordDerived = [...derivedKw].some((w) => DEEP_KEYWORDS.has(w));
+  const hasComplexKeywordDerived = [...derivedKw].some((w) => COMPLEX_KEYWORDS.has(w));
+
+  const heavyDeep = files >= DEEP_FILES || tokens >= DEEP_TOKEN_THRESHOLD || len >= DEEP_TOKEN_THRESHOLD * 4;
+  const heavyComplex = files >= COMPLEX_FILES || tokens >= COMPLEX_TOKEN_THRESHOLD || len >= COMPLEX_TOKEN_THRESHOLD * 4;
+
+  // Weak derived keywords only escalate when the step is large enough to back them.
+  const deepDerived = hasDeepKeywordDerived && (len >= 600 || files >= 4 || tokens >= 3_000);
+  const complexDerived = hasComplexKeywordDerived && (len >= 300 || files >= 2 || tokens >= 1_200);
+
+  const anyHeavyWord = hasDeepKeywordExplicit || hasComplexKeywordExplicit || hasDeepKeywordDerived || hasComplexKeywordDerived;
+
+  let category: StepCategory;
+
+  if (heavyDeep || isDeepTag || hasDeepKeywordExplicit || deepDerived) {
+    category = "deep";
+    if (isDeepTag) reasons.push(`planner tag "${tag}"`);
+    if (hasDeepKeywordExplicit) reasons.push("deep-reasoning keywords");
+    if (deepDerived) reasons.push("deep-reasoning keywords + size");
+    if (heavyDeep) reasons.push(`large step (${tokens} tok, ${files} files)`);
+  } else if (heavyComplex || isComplexTag || hasComplexKeywordExplicit || complexDerived) {
+    category = "complex";
+    if (isComplexTag) reasons.push(`planner tag "${tag}"`);
+    if (hasComplexKeywordExplicit) reasons.push("logic-heavy keywords");
+    if (complexDerived) reasons.push("logic-heavy keywords + size");
+    if (heavyComplex) reasons.push(`nontrivial size (${tokens} tok, ${files} files)`);
+  } else if (len > 0 && len < TRIVIAL_CHARS && files <= 1 && tokens < 800 && !tag && !anyHeavyWord) {
+    category = "trivial";
+    reasons.push(`short simple request (${tokens} tok)`);
+  } else {
+    category = "normal";
+    reasons.push(`ordinary step (${tokens} tok${files > 0 ? `, ${files} files` : ""})`);
+  }
+
+  const tier: StepTier = category === "trivial" ? "fast" : category === "normal" ? "balanced" : "deep";
+
+  return { category, tier, reason: reasons.join(", ") };
+}
