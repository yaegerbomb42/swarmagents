@@ -0,0 +1,114 @@
+import { describe, it } from "node:test";
+import { expect } from "./expect-shim.test-helper";
+import { InMemoryRouterStore, SwarmRouter, type Clock, type RouteRequest } from "./index";
+
+class FakeClock implements Clock {
+  private currentMs = Date.parse("2026-11-12T10:00:00.000Z");
+  now(): number {
+    return this.currentMs;
+  }
+  random(): number {
+    return 0.42;
+  }
+}
+
+/** Two paid providers: "cheap" is far cheaper, "pricey" is higher priority. */
+function makeRouter() {
+  const router = new SwarmRouter({ clock: new FakeClock(), store: new InMemoryRouterStore() });
+  router.registerProvider({
+    id: "pricey",
+    name: "Pricey Paid",
+    resetsDailyUtc: false,
+    models: [
+      {
+        id: "pricey-model",
+        providerId: "pricey",
+        displayName: "Pricey",
+        contextWindow: 200_000,
+        maxOutputTokens: 16_384,
+        supportsTools: true,
+        goodAtLongAgentLoops: true,
+        inputCostPer1kUsd: 0.004,
+        outputCostPer1kUsd: 0.02,
+      },
+    ],
+  });
+  router.registerProvider({
+    id: "cheap",
+    name: "Cheap Paid",
+    resetsDailyUtc: false,
+    models: [
+      {
+        id: "cheap-model",
+        providerId: "cheap",
+        displayName: "Cheap",
+        contextWindow: 200_000,
+        maxOutputTokens: 16_384,
+        supportsTools: true,
+        goodAtLongAgentLoops: false,
+        inputCostPer1kUsd: 0.0001,
+        outputCostPer1kUsd: 0.0003,
+      },
+    ],
+  });
+  router.registerUserKey({ keyId: "pk-1", userId: "u-1", providerId: "pricey", label: "pricey", maxConcurrent: 2 });
+  router.registerUserKey({ keyId: "ck-1", userId: "u-1", providerId: "cheap", label: "cheap", maxConcurrent: 2 });
+  router.setUserPolicy({
+    userId: "u-1",
+    priorityOrder: ["pricey", "cheap"],
+    allowPaidFallback: true,
+    perRunBudgetUsd: null,
+    perDayBudgetUsd: null,
+    freeFirst: false,
+    maxConcurrentRequests: 4,
+  });
+  return router;
+}
+
+function makeReq(overrides: Partial<RouteRequest> = {}): RouteRequest {
+  return {
+    requestId: "req-1",
+    userId: "u-1",
+    runId: "run-1",
+    turnIndex: 0,
+    estimatedPromptTokens: 24_000,
+    maxOutputTokens: 4_096,
+    requiresTools: true,
+    isAgentLoop: true,
+    promptSample: "Refactor the auth middleware and run the full test suite.",
+    ...overrides,
+  };
+}
+
+describe("g4 routing mode", () => {
+  it("balanced (default) follows priority order → pricey", () => {
+    const router = makeRouter();
+    const decision = router.selectRoute(makeReq());
+    expect(decision.chosen?.modelId).toBe("pricey-model");
+    expect(decision.chosen?.isPaid).toBe(true);
+  });
+
+  it("cheapest flips to the cheaper paid model despite lower priority", () => {
+    const router = makeRouter();
+    const decision = router.selectRoute(makeReq({ mode: "cheapest" }));
+    expect(decision.chosen?.modelId).toBe("cheap-model");
+    const cheap = decision.candidatesConsidered.find((c) => c.modelId === "cheap-model");
+    expect(cheap?.breakdown?.modeBias).toBeLessThan(0);
+  });
+
+  it("best keeps the high-priority model and records a non-negative quality bias", () => {
+    const router = makeRouter();
+    const decision = router.selectRoute(makeReq({ mode: "best" }));
+    expect(decision.chosen?.modelId).toBe("pricey-model");
+  });
+
+  it("records mode + classification (tier/reason) on the decision", () => {
+    const router = makeRouter();
+    const decision = router.selectRoute(
+      makeReq({ mode: "cheapest", classification: { category: "complex", tier: "deep", reason: "nontrivial size (24000 tok, 1 files)" } }),
+    );
+    expect(decision.mode).toBe("cheapest");
+    expect(decision.tier).toBe("deep");
+    expect(decision.reason).toContain("size");
+  });
+});
