+import assert from "node:assert/strict";
+import { after, test } from "node:test";
+import { closeBrowser, openWorkspace, runPageTest } from "./lib";
+
+after(async () => {
+  await closeBrowser();
+});
+
+test("g4: composer routing-mode chip renders and cycles the three modes", async (t) => {
+  const result = await runPageTest("g4: composer routing-mode chip", async ({ page, context, consoleErrors }) => {
+    await openWorkspace(page, context);
+
+    const cheapest = page.getByTestId("routing-mode-cheapest");
+    const balanced = page.getByTestId("routing-mode-balanced");
+    const best = page.getByTestId("routing-mode-best");
+
+    await balanced.waitFor({ state: "visible", timeout: 15_000 });
+    assert.equal(await cheapest.isVisible(), true, "expected Cheapest chip to be visible");
+    assert.equal(await best.isVisible(), true, "expected Best chip to be visible");
+
+    // Default is Balanced (aria-pressed).
+    assert.equal(await balanced.getAttribute("aria-pressed"), "true", "expected Balanced to be the default mode");
+    assert.equal(await cheapest.getAttribute("aria-pressed"), "false", "expected Cheapest off by default");
+    assert.equal(await best.getAttribute("aria-pressed"), "false", "expected Best off by default");
+
+    // Cycle: Cheapest → Best → balanced.
+    await cheapest.click();
+    assert.equal(await cheapest.getAttribute("aria-pressed"), "true", "expected Cheapest selected after click");
+    assert.equal(await balanced.getAttribute("aria-pressed"), "false", "expected Balanced deselected");
+
+    await best.click();
+    assert.equal(await best.getAttribute("aria-pressed"), "true", "expected Best selected after click");
+    assert.equal(await cheapest.getAttribute("aria-pressed"), "false", "expected Cheapest deselected");
+
+    await balanced.click();
+    assert.equal(await balanced.getAttribute("aria-pressed"), "true", "expected Balanced re-selected");
+
+    assert.deepEqual(consoleErrors, [], `unexpected page errors: ${consoleErrors.join(" | ")}`);
+  });
+  if (result.skipped) t.skip(result.skipped);
+});
