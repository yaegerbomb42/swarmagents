{
  "name": "swarmagents",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@10.9.4",
  "description": "One chat bar. One agent. Every tool. Nothing hidden.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3777",
    "desktop-proxy:dev": "tsx lib/desktop-proxy/server.ts",
    "generate:atlas-server": "tsx lib/capability-atlas/generate-server-source.ts",
    "build": "next build && tsc -p tsconfig.desktop-proxy.json",
    "start": "next start -H 127.0.0.1 -p 3777",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "vm-image:build": "docker build -t swarm-vm:claude vm-image",
    "vm-image-desktop:build": "docker build -t swarm-vm:desktop vm-image-desktop",
    "test": "npm run test:unit",
    "test:unit": "SWARM_HOME=$(mktemp -d) tsx --test --test-concurrency=1 \"lib/**/*.test.ts\" \"app/**/*.test.ts\" \"components/**/*.test.ts\" \"minimalist-ui/src/**/*.test.ts\" \"packages/swarm-node/src/**/*.test.ts\"",
    "test:e2e": "tsx --test --test-concurrency=1 e2e/*.spec.ts",
    "test:all": "bash scripts/test-all.sh",
    "playtest:login": "node scripts/playtest.mjs login",
    "playtest:seed": "node scripts/playtest.mjs seed",
    "playtest:check": "node scripts/playtest.mjs check"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.130.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@novnc/novnc": "1.5.0",
    "@shikijs/rehype": "^4.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "next": "^15.5.29",
    "openai": "^7.25.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  }
}
