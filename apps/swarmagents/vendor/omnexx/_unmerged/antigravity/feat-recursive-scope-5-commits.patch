new file mode 100644
index 00000000..57d0acdc
--- /dev/null
+++ b/src/agent/recursive/types.ts
@@ -0,0 +1,169 @@
+import { z } from 'zod';
+
+/**
+ * A verified fact bound to a specific file hash.
+ * If the file hash on disk changes, the fact automatically expires.
+ */
+export const factSchema = z.object({
+  id: z.string(),
+  file: z.string(),
+  fileHash: z.string(),
+  statement: z.string(),
+  symbol: z.string().optional(),
+  timestamp: z.number(),
+});
+export type Fact = z.infer<typeof factSchema>;
+
+/**
+ * An anti-pattern or failed approach recorded to avoid looping.
+ */
+export const failedAttemptSchema = z.object({
+  id: z.string(),
+  target: z.string(),
+  approach: z.string(),
+  error: z.string(),
+  timestamp: z.number(),
+});
+export type FailedAttempt = z.infer<typeof failedAttemptSchema>;
+
+/**
+ * Test evidence cryptographically bound to a diff hash.
+ */
+export const testEvidenceSchema = z.object({
+  command: z.string(),
+  passed: z.boolean(),
+  exitCode: z.number(),
+  diffHash: z.string(),
+  outputSnippet: z.string(),
+  timestamp: z.number(),
+});
+export type TestEvidence = z.infer<typeof testEvidenceSchema>;
+
+/**
+ * A completed milestone or sub-problem with bound evidence.
+ */
+export const doneItemSchema = z.object({
+  id: z.string(),
+  description: z.string(),
+  evidence: testEvidenceSchema,
+});
+export type DoneItem = z.infer<typeof doneItemSchema>;
+
+/**
+ * Typed memory state file representation:
+ * Built fresh each call, replaces unbounded transcript history.
+ */
+export const scopeStateSchema = z.object({
+  goal: z.string(),
+  acceptanceCriteria: z.array(z.string()).default([]),
+  plan: z.array(z.string()).default([]),
+  doneItems: z.array(doneItemSchema).default([]),
+  nextAction: z.string().default(''),
+  depth: z.number().int().min(0).default(0),
+});
+export type ScopeState = z.infer<typeof scopeStateSchema>;
+
+/**
+ * Budget curve calculation:
+ * Depth 0 (root): 32,000 tokens
+ * Depth 1 (child): 12,000 tokens
+ * Depth 2 (leaf): 6,000 tokens
+ * Depth 3+: 4,000 tokens
+ */
+export function defaultBudgetCurve(depth: number, baseBudget = 32_000): number {
+  if (depth <= 0) return baseBudget;
+  if (depth === 1) return Math.min(baseBudget, 12_000);
+  if (depth === 2) return Math.min(baseBudget, 6_000);
+  return Math.min(baseBudget, 4_000);
+}
+
+/**
+ * Compact Return Contract for child scopes.
+ * Context is discarded when the child completes; parent only receives this contract.
+ */
+export const returnContractSchema = z.object({
+  scopeId: z.string(),
+  status: z.enum(['solved', 'failed', 'partial']),
+  diff: z.string(),
+  diffHash: z.string(),
+  facts: z.array(factSchema).default([]),
+  evidence: testEvidenceSchema.optional(),
+  error: z.string().optional(),
+});
+export type ReturnContract = z.infer<typeof returnContractSchema>;
+
+/**
+ * Input for independent verifier scope.
+ * Sees ONLY the diff, acceptance criteria, and test output.
+ */
+export interface VerifierInput {
+  diff: string;
+  diffHash: string;
+  acceptanceCriteria: string[];
+  testOutput: string;
+  exitCode: number;
+}
+
+export interface VerifierResult {
+  verified: boolean;
+  diffHash: string;
+  reason: string;
+  timestamp: number;
+}
+
+/**
+ * Request to instantiate a child scope.
+ */
+export interface ChildScopeRequest {
+  id: string;
+  subGoal: string;
+  budget: number;
+  inheritedRules: string[];
+  relevantFacts: Fact[];
+  targetFiles: string[];
+  targetSymbols?: string[] | undefined;
+  acceptanceCriteria: string[];
+  depth: number;
+}
+
+/**
+ * Node in the scope tree.
+ */
+export interface ScopeNode {
+  id: string;
+  parentId?: string | undefined;
+  goal: string;
+  budget: number;
+  depth: number;
+  plan: string[];
+  children: ScopeNode[];
+  state: ScopeState;
+  result?: ReturnContract | undefined;
+}
+
+/**
+ * Telemetry log entry for performance comparison.
+ */
+export interface ScopeTelemetryTurn {
+  scopeId: string;
+  depth: number;
+  turn: number;
+  inputTokens: number;
+  outputTokens: number;
+  totalTokens: number;
+  filesRead: string[];
+  isReRead: boolean;
+  timestamp: number;
+}
+
+export interface ScopeTelemetryReport {
+  mode: 'recursive' | 'baseline';
+  taskId: string;
+  solved: boolean;
+  totalTokens: number;
+  totalTurns: number;
+  tokensPerTurn: number[];
+  wallTimeMs: number;
+  reReadRatio: number;
+  turns: ScopeTelemetryTurn[];
+}
diff --git a/src/agent/recursive/verifier-scope.ts b/src/agent/recursive/verifier-scope.ts
new file mode 100644
index 00000000..dd7fc102
--- /dev/null
+++ b/src/agent/recursive/verifier-scope.ts
@@ -0,0 +1,120 @@
+import { computeDiffHash } from './return-contract.js';
+import { type VerifierInput, type VerifierResult } from './types.js';
+
+/**
+ * Format the isolated prompt that the verifier model or engine evaluates.
+ */
+export function formatVerifierPrompt(input: VerifierInput): string {
+  return [
+    '# Independent Verification Scope',
+    'You are the independent verifier. You evaluate whether the provided git diff and test output satisfy all acceptance criteria.',
+    'You have NO access to intermediate chat or reasoning.',
+    '',
+    '## Acceptance Criteria',
+    input.acceptanceCriteria.map((c, i) => `${i + 1}. ${c}`).join('\n') || '(None specified)',
+    '',
+    `## Git Diff (Cryptographic Hash: ${input.diffHash.slice(0, 10)})`,
+    '```diff',
+    input.diff || '(empty diff)',
+    '```',
+    '',
+    `## Test Output (Exit Code: ${input.exitCode})`,
+    '```',
+    input.testOutput.slice(-3000),
+    '```',
+    '',
+    '## Verification Invariants',
+    '1. Exit code must be 0 (green tests).',
+    '2. Diff must not revert or disable tests or delete verification gates.',
+    '3. Diff must contain concrete code changes addressing the criteria.',
+  ].join('\n');
+}
+
+/**
+ * Verify the input deterministically against core invariants:
+ * 1. Test exit code must be 0.
+ * 2. Test output must indicate successful test completion (no unhandled failures).
+ * 3. Diff hash must match.
+ * 4. Diff must not contain anti-cheat patterns (e.g. deleting tests or commenting assertions).
+ */
+export function verifyScopeDiff(input: VerifierInput): VerifierResult {
+  const timestamp = Date.now();
+
+  // Invariant 1: diff hash must match
+  const computedHash = computeDiffHash(input.diff);
+  if (input.diffHash && input.diffHash !== computedHash) {
+    return {
+      verified: false,
+      diffHash: input.diffHash,
+      reason: `Cryptographic diffHash mismatch: expected ${computedHash.slice(0, 8)}, got ${input.diffHash.slice(0, 8)}`,
+      timestamp,
+    };
+  }
+
+  // Invariant 2: Green tests
+  if (input.exitCode !== 0) {
+    return {
+      verified: false,
+      diffHash: input.diffHash,
+      reason: `Verification failed: test suite exited with code ${input.exitCode}`,
+      timestamp,
+    };
+  }
+
+  // Invariant 3: Diff must not be completely empty when criteria exist
+  if (!input.diff.trim() && input.acceptanceCriteria.length > 0) {
+    return {
+      verified: false,
+      diffHash: input.diffHash,
+      reason: 'Verification failed: diff is empty while acceptance criteria remain',
+      timestamp,
+    };
+  }
+
+  // Invariant 4: Anti-cheat check: look for skipped tests or deleted assertions
+  const lines = input.diff.split('\n');
+  const suspiciousDeletions = lines.filter(
+    (l) =>
+      l.startsWith('-') &&
+      !l.startsWith('---') &&
+      (l.includes('.skip(') || l.includes('test.todo(')),
+  );
+  const suspiciousAdditions = lines.filter(
+    (l) =>
+      l.startsWith('+') &&
+      !l.startsWith('+++') &&
+      (l.includes('.skip(') || l.includes('// expect(')),
+  );
+
+  if (suspiciousAdditions.length > 0 && suspiciousDeletions.length === 0) {
+    return {
+      verified: false,
+      diffHash: input.diffHash,
+      reason:
+        'Verification failed: diff appears to bypass assertions (e.g. added .skip or commented expect)',
+      timestamp,
+    };
+  }
+
+  // Invariant 5: Test output must not report 0 tests run when criteria require tests
+  if (input.testOutput.includes('0 passed') && input.testOutput.includes('(0)')) {
+    return {
+      verified: false,
+      diffHash: input.diffHash,
+      reason: 'Verification failed: 0 tests were executed',
+      timestamp,
+    };
+  }
+
+  return {
+    verified: true,
+    diffHash: input.diffHash,
+    reason: 'All acceptance criteria satisfied with green test evidence bound to diff hash.',
+    timestamp,
+  };
+}
+
+export const VerifierScope = {
+  formatVerifierPrompt,
+  verify: verifyScopeDiff,
+};
