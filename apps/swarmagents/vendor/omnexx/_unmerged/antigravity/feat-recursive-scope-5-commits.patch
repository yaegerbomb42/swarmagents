+import { createHash } from 'node:crypto';
+import { git } from '../../git/git.js';
+import {
+  type ReturnContract,
+  type TestEvidence,
+  type Fact,
+  returnContractSchema,
+} from './types.js';
+import type { TypedMemory } from './typed-memory.js';
+
+export function computeDiffHash(diff: string): string {
+  // Normalize line endings and whitespace differences
+  const normalized = diff.replace(/\r\n/g, '\n').trim();
+  return createHash('sha256').update(normalized, 'utf8').digest('hex');
+}
+
+/**
+ * Validate that the return contract adheres to invariants:
+ * 1. Has valid status.
+ * 2. If diff is non-empty, diffHash must match the hash of diff.
+ * 3. If solved, evidence must be present, passed must be true, and evidence.diffHash must equal diffHash.
+ */
+export function validateReturnContract(contract: ReturnContract): {
+  valid: boolean;
+  reason?: string;
+} {
+  const parse = returnContractSchema.safeParse(contract);
+  if (!parse.success) {
+    return { valid: false, reason: `Schema validation failed: ${parse.error.message}` };
+  }
+
+  const expectedHash = computeDiffHash(contract.diff);
+  if (contract.diff && contract.diffHash !== expectedHash) {
+    return {
+      valid: false,
+      reason: `diffHash mismatch: expected ${expectedHash.slice(0, 8)}, got ${contract.diffHash.slice(0, 8)}`,
+    };
+  }
+
+  if (contract.status === 'solved') {
+    if (!contract.evidence) {
+      return { valid: false, reason: 'Status is "solved" but no test evidence was provided' };
+    }
+    if (!contract.evidence.passed || contract.evidence.exitCode !== 0) {
+      return {
+        valid: false,
+        reason: `Status is "solved" but test evidence failed with exit code ${contract.evidence.exitCode}`,
+      };
+    }
+    if (contract.evidence.diffHash !== contract.diffHash) {
+      return {
+        valid: false,
+        reason: `Evidence diffHash (${contract.evidence.diffHash.slice(0, 8)}) does not match contract diffHash (${contract.diffHash.slice(0, 8)})`,
+      };
+    }
+  }
+
+  return { valid: true };
+}
+
+/**
+ * Binds a test run to the current diff.
+ */
+export function bindTestEvidence(
+  command: string,
+  exitCode: number,
+  outputSnippet: string,
+  diff: string,
+): TestEvidence {
+  const diffHash = computeDiffHash(diff);
+  return {
+    command,
+    passed: exitCode === 0,
+    exitCode,
+    diffHash,
+    outputSnippet: outputSnippet.slice(0, 2000),
+    timestamp: Date.now(),
+  };
+}
+
+/**
+ * Applies a child diff to the repository using git apply.
+ */
+export async function applyChildDiff(repoRoot: string, diff: string): Promise<boolean> {
+  if (!diff.trim()) return true;
+  try {
+    const res = await git(repoRoot, ['apply', '--whitespace=nowarn'], {
+      allowFailure: true,
+      input: diff,
+    });
+    return res.exitCode === 0;
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * Process and merge a child scope's return contract into the parent scope.
+ */
+export async function mergeChildResult(
+  parentMemory: TypedMemory,
+  result: ReturnContract,
+  repoRoot: string,
+): Promise<{
+  merged: boolean;
+  shouldRespawn: boolean;
+  failureFact?: Fact | undefined;
+  error?: string | undefined;
+}> {
+  const validation = validateReturnContract(result);
+  if (!validation.valid) {
+    // Record failed attempt in parent memory
+    await parentMemory.recordFailedAttempt(
+      result.scopeId,
+      'child scope execution',
+      validation.reason ?? 'invalid return contract',
+    );
+    return {
+      merged: false,
+      shouldRespawn: true,
+      ...(validation.reason !== undefined ? { error: validation.reason } : {}),
+    };
+  }
+
+  if (result.status === 'failed') {
+    // Record failure in parent memory so respawned child knows what failed
+    await parentMemory.recordFailedAttempt(
+      result.scopeId,
+      'child scope sub-problem',
+      result.error ?? 'unknown child failure',
+    );
+    return {
+      merged: false,
+      shouldRespawn: true,
+      ...(result.error !== undefined ? { error: result.error } : {}),
+    };
+  }
+
+  // If there's a diff to apply
+  if (result.diff.trim()) {
+    const applied = await applyChildDiff(repoRoot, result.diff);
+    if (!applied) {
+      const err = 'Failed to apply child diff (conflict or unmergeable)';
+      await parentMemory.recordFailedAttempt(result.scopeId, 'git apply child diff', err);
+      return {
+        merged: false,
+        shouldRespawn: true,
+        error: err,
+      };
+    }
+  }
+
+  // Merge child's verified facts into parent memory
+  if (result.facts.length > 0) {
+    await parentMemory.mergeFacts(result.facts);
+  }
+
+  // If solved and evidence exists, record as done in parent state
+  if (result.status === 'solved' && result.evidence) {
+    await parentMemory.addDoneItem(`Completed sub-problem: ${result.scopeId}`, result.evidence);
+  }
+
+  return {
+    merged: true,
+    shouldRespawn: false,
+  };
+}
diff --git a/src/agent/recursive/runner.ts b/src/agent/recursive/runner.ts
new file mode 100644
index 00000000..85567d86
--- /dev/null
+++ b/src/agent/recursive/runner.ts
@@ -0,0 +1,255 @@
+import { readFile } from 'node:fs/promises';
+import { join } from 'node:path';
+import { git } from '../../git/git.js';
+import { ScopeTree } from './scope-tree.js';
+import {
+  type ReturnContract,
+  type ScopeTelemetryReport,
+  type ScopeTelemetryTurn,
+  type TestEvidence,
+  type Fact,
+} from './types.js';
+import { computeDiffHash, mergeChildResult, bindTestEvidence } from './return-contract.js';
+import { VerifierScope } from './verifier-scope.js';
+
+export interface RecursiveRunnerOptions {
+  repoRoot: string;
+  storageDir: string;
+  baseBudget?: number;
+  runCommand?:
+    ((cmd: string) => Promise<{ code: number; stdout: string; stderr: string }>) | undefined;
+}
+
+export class RecursiveScopeRunner {
+  readonly repoRoot: string;
+  readonly storageDir: string;
+  readonly baseBudget: number;
+  private customRunCommand?:
+    ((cmd: string) => Promise<{ code: number; stdout: string; stderr: string }>) | undefined;
+
+  constructor(options: RecursiveRunnerOptions) {
+    this.repoRoot = options.repoRoot;
+    this.storageDir = options.storageDir;
+    this.baseBudget = options.baseBudget ?? 32_000;
+    this.customRunCommand = options.runCommand;
+  }
+
+  private async executeCommand(
+    command: string,
+  ): Promise<{ code: number; stdout: string; stderr: string }> {
+    if (this.customRunCommand) {
+      return this.customRunCommand(command);
+    }
+    const [bin, ...args] = command.split(' ');
+    if (!bin) return { code: 0, stdout: '', stderr: '' };
+    try {
+      const res = await git(this.repoRoot, [bin, ...args], { allowFailure: true });
+      return { code: res.exitCode, stdout: res.stdout, stderr: res.stderr };
+    } catch (err: unknown) {
+      return { code: 1, stdout: '', stderr: String(err) };
+    }
+  }
+
+  /**
+   * Run a recursive scope execution cycle.
+   */
+  async runTask(params: {
+    taskId: string;
+    goal: string;
+    acceptanceCriteria: string[];
+    subProblems: {
+      subGoal: string;
+      targetFiles: string[];
+      targetSymbols?: string[];
+      solve: (
+        contextPrompt: string,
+        budget: number,
+      ) => Promise<{
+        diff: string;
+        facts: { file: string; statement: string; symbol?: string }[];
+        tokensUsed: { input: number; output: number };
+      }>;
+    }[];
+    verifyCommand: string;
+  }): Promise<{
+    solved: boolean;
+    report: ScopeTelemetryReport;
+    finalDiff: string;
+  }> {
+    const startTime = Date.now();
+    const tree = new ScopeTree(params.goal, params.acceptanceCriteria, {
+      storageDir: this.storageDir,
+      repoRoot: this.repoRoot,
+      baseBudget: this.baseBudget,
+    });
+    await tree.initRoot();
+
+    const turns: ScopeTelemetryTurn[] = [];
+    const readFilesTracker = new Set<string>();
+    let reReadCount = 0;
+    let totalReads = 0;
+
+    const rootMem = tree.getMemory(tree.root.id);
+
+    // Initial root state build (repo map + goal)
+    const rootContext = await rootMem.buildFreshContext({
+      inheritedRules: tree.inheritedRules,
+      tokenBudget: tree.root.budget,
+    });
+
+    turns.push({
+      scopeId: tree.root.id,
+      depth: 0,
+      turn: 1,
+      inputTokens: rootContext.estimatedTokens,
+      outputTokens: 250,
+      totalTokens: rootContext.estimatedTokens + 250,
+      filesRead: [],
+      isReRead: false,
+      timestamp: Date.now(),
+    });
+
+    // Execute each sub-problem in a spawned child scope
+    for (const sub of params.subProblems) {
+      const { node: childNode, request } = await tree.spawnChild(tree.root.id, {
+        subGoal: sub.subGoal,
+        targetFiles: sub.targetFiles,
+        ...(sub.targetSymbols !== undefined ? { targetSymbols: sub.targetSymbols } : {}),
+      });
+
+      const childMem = tree.getMemory(childNode.id);
+
+      // Read target files for the child context
+      const fileContents: { path: string; content: string; symbols?: string[] }[] = [];
+      for (const target of sub.targetFiles) {
+        totalReads++;
+        if (readFilesTracker.has(target)) {
+          reReadCount++;
+        } else {
+          readFilesTracker.add(target);
+        }
+
+        try {
+          const content = await readFile(join(this.repoRoot, target), 'utf8');
+          fileContents.push({
+            path: target,
+            content,
+            ...(sub.targetSymbols !== undefined ? { symbols: sub.targetSymbols } : {}),
+          });
+        } catch {
+          // File might be newly created by child
+        }
+      }
+
+      // Build child's FRESH context - NO transcript history!
+      const childContext = await childMem.buildFreshContext({
+        inheritedRules: request.inheritedRules,
+        subGoal: request.subGoal,
+        targetFiles: fileContents,
+        tokenBudget: request.budget,
+      });
+
+      // Child solves sub-problem within its budget
+      const solution = await sub.solve(childContext.prompt, request.budget);
+
+      turns.push({
+        scopeId: childNode.id,
+        depth: childNode.depth,
+        turn: turns.length + 1,
+        inputTokens: solution.tokensUsed.input,
+        outputTokens: solution.tokensUsed.output,
+        totalTokens: solution.tokensUsed.input + solution.tokensUsed.output,
+        filesRead: sub.targetFiles,
+        isReRead: sub.targetFiles.some((f) => readFilesTracker.has(f)),
+        timestamp: Date.now(),
+      });
+
+      // Record any newly discovered facts
+      const recordedFacts: Fact[] = [];
+      for (const f of solution.facts) {
+        const fact = await childMem.recordFact(f.file, f.statement, f.symbol);
+        if (fact) recordedFacts.push(fact);
+      }
+
+      // Check test evidence for child
+      const childDiffHash = computeDiffHash(solution.diff);
+      const testResult = await this.executeCommand(params.verifyCommand);
+      const evidence: TestEvidence = bindTestEvidence(
+        params.verifyCommand,
+        testResult.code,
+        testResult.stdout + '\n' + testResult.stderr,
+        solution.diff,
+      );
+
+      const contract: ReturnContract = {
+        scopeId: childNode.id,
+        status: testResult.code === 0 ? 'solved' : 'partial',
+        diff: solution.diff,
+        diffHash: childDiffHash,
+        facts: recordedFacts,
+        evidence,
+      };
+
+      // Discard child context, record compact result
+      tree.recordResult(childNode.id, contract);
+
+      // Merge into parent
+      await mergeChildResult(rootMem, contract, this.repoRoot);
+    }
+
+    // Final Independent Verification Scope
+    // Sees ONLY the final diff, the acceptance criteria, and the test output
+    const gitDiffRes = await git(this.repoRoot, ['diff'], { allowFailure: true });
+    const finalDiff = gitDiffRes.stdout;
+    const finalDiffHash = computeDiffHash(finalDiff);
+
+    const finalTestRun = await this.executeCommand(params.verifyCommand);
+    const verifierInput = {
+      diff: finalDiff,
+      diffHash: finalDiffHash,
+      acceptanceCriteria: params.acceptanceCriteria,
+      testOutput: finalTestRun.stdout + '\n' + finalTestRun.stderr,
+      exitCode: finalTestRun.code,
+    };
+
+    const verifierVerdict = VerifierScope.verify(verifierInput);
+
+    // Verifier turn telemetry
+    const verifierPrompt = VerifierScope.formatVerifierPrompt(verifierInput);
+    const verifierTokens = Math.floor(verifierPrompt.length / 4);
+    turns.push({
+      scopeId: 'verifier',
+      depth: 0,
+      turn: turns.length + 1,
+      inputTokens: verifierTokens,
+      outputTokens: 50,
+      totalTokens: verifierTokens + 50,
+      filesRead: [],
+      isReRead: false,
+      timestamp: Date.now(),
+    });
+
+    const totalTokens = turns.reduce((acc, t) => acc + t.totalTokens, 0);
+    const tokensPerTurn = turns.map((t) => t.inputTokens);
+    const wallTimeMs = Date.now() - startTime;
+    const reReadRatio = totalReads > 0 ? reReadCount / totalReads : 0;
+
+    const report: ScopeTelemetryReport = {
+      mode: 'recursive',
+      taskId: params.taskId,
+      solved: verifierVerdict.verified,
+      totalTokens,
+      totalTurns: turns.length,
+      tokensPerTurn,
+      wallTimeMs,
+      reReadRatio,
+      turns,
+    };
+
+    return {
+      solved: verifierVerdict.verified,
+      report,
+      finalDiff,
+    };
+  }
+}
