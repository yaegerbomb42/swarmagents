+
+/** RFC 9562 UUIDv7: 48-bit unix-ms timestamp + version/variant + random. */
+export function uuidv7(): string {
+  const bytes = randomBytes(16);
+  const now = Date.now();
+  bytes[0] = Math.floor(now / 2 ** 40) & 0xff;
+  bytes[1] = Math.floor(now / 2 ** 32) & 0xff;
+  bytes[2] = Math.floor(now / 2 ** 24) & 0xff;
+  bytes[3] = Math.floor(now / 2 ** 16) & 0xff;
+  bytes[4] = Math.floor(now / 2 ** 8) & 0xff;
+  bytes[5] = now & 0xff;
+  bytes[6] = ((bytes[6] ?? 0) & 0x0f) | 0x70; // version 7
+  bytes[8] = ((bytes[8] ?? 0) & 0x3f) | 0x80; // variant 10
+  const hex = [...bytes].map((b) => b.toString(16).padStart(2, '0')).join('');
+  return (
+    `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-` +
+    `${hex.slice(16, 20)}-${hex.slice(20)}`
+  );
+}
+
+/** Cooldown (epoch ms, or -1 for permanent) for a given strike count. */
+export function cooldownUntilForStrike(strikeCount: number, nowMs: number): number {
+  if (strikeCount >= MAX_STRIKES_BEFORE_PERMANENT) return -1;
+  const last = TOMBSTONE_COOLDOWNS_MS[TOMBSTONE_COOLDOWNS_MS.length - 1] ?? 60 * 60 * 1000;
+  const duration =
+    TOMBSTONE_COOLDOWNS_MS[Math.min(strikeCount, TOMBSTONE_COOLDOWNS_MS.length) - 1] ?? last;
+  return nowMs + duration;
+}
+
+type Row = Record<string, unknown>;
+
+function str(row: Row, key: string): string {
+  const v = row[key];
+  if (typeof v !== 'string') throw new Error(`state store: expected string for ${key}`);
+  return v;
+}
+
+function nullableStr(row: Row, key: string): string | null {
+  const v = row[key];
+  if (v === null || v === undefined) return null;
+  if (typeof v === 'string') return v;
+  if (typeof v === 'number' || typeof v === 'bigint') return String(v);
+  throw new Error(`state store: expected string for ${key}`);
+}
+
+function num(row: Row, key: string): number {
+  const v = row[key];
+  if (typeof v !== 'number') throw new Error(`state store: expected number for ${key}`);
+  return v;
+}
+
+function json(row: Row, key: string): unknown {
+  return JSON.parse(str(row, key)) as unknown;
+}
+
+/**
+ * Minimal glob matcher: a star spans within one path segment, a question
+ * mark matches one character within a segment, and a double star followed
+ * by a slash spans zero or more directories.
+ */
+export function globMatches(glob: string, path: string): boolean {
+  let re = '^';
+  for (let i = 0; i < glob.length; i++) {
+    const ch = glob.charAt(i);
+    if (ch === '*') {
+      if (glob[i + 1] === '*') {
+        // A double star followed by a slash matches zero or more directories;
+        // a trailing double star matches anything.
+        if (glob[i + 2] === '/') {
+          re += '(?:.*/)?';
+          i += 2;
+        } else {
+          re += '.*';
+          i += 1;
+        }
+      } else {
+        re += '[^/]*';
+      }
+    } else if (ch === '?') {
+      re += '[^/]';
+    } else {
+      re += ch.replace(/[.+?^${}()|[\]\\]/g, '\\$&');
+    }
+  }
+  re += '$';
+  return new RegExp(re).test(path);
+}
+
+/** ~150-token cap for rule summaries: ~4 chars per token, truncate at 600. */
+const RULE_SUMMARY_MAX_CHARS = 600;
+
+export interface AutonomousStateStoreOptions {
+  repoRoot: string;
+  /** Defaults to `<repoRoot>/.omnexx/autonomous.db`. Use ':memory:' for tests. */
+  dbPath?: string;
+}
+
+export class AutonomousStateStore {
+  private readonly repoRoot: string;
+  private readonly dbPath: string;
+  private db: DatabaseSync | null = null;
+
+  constructor(opts: AutonomousStateStoreOptions) {
+    this.repoRoot = opts.repoRoot;
+    this.dbPath = opts.dbPath ?? join(opts.repoRoot, AUTONOMOUS_DB_REL_PATH);
+  }
+
+  get path(): string {
+    return this.dbPath;
+  }
+
+  get isOpen(): boolean {
+    return this.db !== null;
+  }
+
+  async open(): Promise<void> {
+    if (this.db !== null) return;
+    if (this.dbPath !== ':memory:') await mkdir(dirname(this.dbPath), { recursive: true });
+    // Dynamic import so tsup does not rewrite the built-in module specifier.
+    const { DatabaseSync } = await import('node:sqlite');
+    const db = new DatabaseSync(this.dbPath, { open: true });
+    if (this.dbPath !== ':memory:') {
+      db.exec('PRAGMA journal_mode=WAL;');
+    }
+    db.exec('PRAGMA busy_timeout = 5000;');
+    db.exec('PRAGMA foreign_keys = ON;');
+    db.exec(SCHEMA);
+    this.db = db;
+  }
+
+  close(): void {
+    this.db?.close();
+    this.db = null;
+  }
+
+  private requireDb(): DatabaseSync {
+    if (this.db === null) throw new Error('AutonomousStateStore is not open; call open() first');
+    return this.db;
+  }
+
+  /** Run fn inside a single IMMEDIATE transaction; rolls back on throw. */
+  private transaction<T>(fn: () => T): T {
+    const db = this.requireDb();
+    db.exec('BEGIN IMMEDIATE');
+    try {
+      const result = fn();
+      db.exec('COMMIT');
+      return result;
+    } catch (err) {
+      try {
+        db.exec('ROLLBACK');
+      } catch {
+        // Already rolled back / no transaction; surface the original error.
+      }
+      throw err;
+    }
+  }
+
+  // -- work queue -----------------------------------------------------------
+
+  enqueueTask(input: EnqueueTaskInput): QueuedTask {
+    const now = Date.now();
+    return this.transaction(() => {
+      const db = this.requireDb();
+      const taskId = uuidv7();
+      db.prepare(
+        `INSERT OR IGNORE INTO work_queue
+          (task_id, fingerprint, source_collector, priority_score, status,
+           target_files_json, finding_payload_json, base_commit_sha,
+           created_at_ms, updated_at_ms)
+         VALUES (?, ?, ?, ?, 'QUEUED', ?, ?, ?, ?, ?)`,
+      ).run(
+        taskId,
+        input.fingerprint,
+        input.sourceCollector,
+        input.priorityScore,
+        JSON.stringify([...input.targetFiles]),
+        JSON.stringify(input.findingPayload),
+        input.baseCommitSha ?? null,
+        now,
+        now,
+      );
+      const row = db
+        .prepare('SELECT * FROM work_queue WHERE fingerprint = ?')
+        .get(input.fingerprint) as Row | undefined;
+      if (row === undefined) throw new Error('enqueueTask: failed to read back task');
+      return rowToTask(row);
+    });
+  }
+
+  /** Claim the highest-priority QUEUED task, moving it to PLANNING. */
+  popNextTask(): QueuedTask | null {
+    return this.transaction(() => {
+      const db = this.requireDb();
+      const row = db
+        .prepare(
+          `SELECT * FROM work_queue WHERE status = 'QUEUED'
+            ORDER BY priority_score DESC, created_at_ms ASC LIMIT 1`,
+        )
+        .get() as Row | undefined;
+      if (row === undefined) return null;
+      const now = Date.now();
+      db.prepare(
+        "UPDATE work_queue SET status = 'PLANNING', updated_at_ms = ? WHERE task_id = ?",
+      ).run(now, str(row, 'task_id'));
+      const updated = db
+        .prepare('SELECT * FROM work_queue WHERE task_id = ?')
+        .get(str(row, 'task_id')) as Row | undefined;
+      if (updated === undefined) throw new Error('popNextTask: lost claimed task');
+      return rowToTask(updated);
+    });
+  }
+
+  getTask(taskId: string): QueuedTask | null {
+    const row = this.requireDb()
+      .prepare('SELECT * FROM work_queue WHERE task_id = ?')
+      .get(taskId) as Row | undefined;
+    return row === undefined ? null : rowToTask(row);
+  }
+
+  getTaskByFingerprint(fingerprint: string): QueuedTask | null {
+    const row = this.requireDb()
+      .prepare('SELECT * FROM work_queue WHERE fingerprint = ?')
+      .get(fingerprint) as Row | undefined;
+    return row === undefined ? null : rowToTask(row);
+  }
+
+  listTasks(status?: TaskStatus): QueuedTask[] {
+    const db = this.requireDb();
+    const rows =
+      status === undefined
+        ? (db.prepare('SELECT * FROM work_queue ORDER BY priority_score DESC').all() as Row[])
+        : (db
+            .prepare('SELECT * FROM work_queue WHERE status = ? ORDER BY priority_score DESC')
+            .all(status) as Row[]);
+    return rows.map(rowToTask);
+  }
+
+  updateTaskStatus(taskId: string, status: TaskStatus, patch: TaskPatch = {}): QueuedTask | null {
+    return this.transaction(() => {
+      const db = this.requireDb();
+      const sets: string[] = ['status = ?', 'updated_at_ms = ?'];
+      const params: SQLInputValue[] = [status, Date.now()];
+      if (patch.plan !== undefined) {
+        sets.push('plan_json = ?');
+        params.push(JSON.stringify(patch.plan));
+      }
+      if (patch.worktreePath !== undefined) {
+        sets.push('worktree_path = ?');
+        params.push(patch.worktreePath);
+      }
+      if (patch.baseCommitSha !== undefined) {
+        sets.push('base_commit_sha = ?');
+        params.push(patch.baseCommitSha);
+      }
+      if (patch.attemptCount !== undefined) {
+        sets.push('attempt_count = ?');
+        params.push(patch.attemptCount);
+      }
+      if (patch.tokensSpent !== undefined) {
+        sets.push('tokens_spent = ?');
+        params.push(patch.tokensSpent);
+      }
+      if (patch.turnsSpent !== undefined) {
+        sets.push('turns_spent = ?');
+        params.push(patch.turnsSpent);
+      }
+      params.push(taskId);
+      const info = db
+        .prepare(`UPDATE work_queue SET ${sets.join(', ')} WHERE task_id = ?`)
+        .run(...params);
+      if (info.changes === 0) return null;
+      const row = db.prepare('SELECT * FROM work_queue WHERE task_id = ?').get(taskId) as
+        Row | undefined;
+      return row === undefined ? null : rowToTask(row);
+    });
+  }
+
+  /** Increment attempt/tokens/turns counters atomically. */
+  addTaskUsage(
+    taskId: string,
+    delta: { tokens?: number; turns?: number; attempts?: number },
+  ): void {
+    this.requireDb()
+      .prepare(
+        `UPDATE work_queue SET
+           tokens_spent = tokens_spent + ?,
+           turns_spent = turns_spent + ?,
+           attempt_count = attempt_count + ?,
+           updated_at_ms = ?
+         WHERE task_id = ?`,
+      )
+      .run(delta.tokens ?? 0, delta.turns ?? 0, delta.attempts ?? 0, Date.now(), taskId);
+  }
+
+  /** Delete a queued task by id (used by `queue drop`). Returns true if one was deleted. */
+  deleteTask(taskId: string): boolean {
+    const info = this.requireDb().prepare('DELETE FROM work_queue WHERE task_id = ?').run(taskId);
+    return info.changes > 0;
+  }
+
+  // -- step journal ---------------------------------------------------------
+
+  recordStep(
+    taskId: string,
+    step: {
+      phase: string;
+      toolName?: string;
+      toolArgsHash?: string;
+      gitTreeHash?: string;
+      errorSignature?: string;
+      tokensDelta?: number;
+    },
+  ): StepRecord {
+    return this.transaction(() => {
+      const db = this.requireDb();
+      const maxRow = db
+        .prepare('SELECT COALESCE(MAX(step_index), -1) AS m FROM step_journal WHERE task_id = ?')
+        .get(taskId) as Row | undefined;
+      const stepIndex = num(maxRow ?? { m: -1 }, 'm') + 1;
+      const now = Date.now();
+      db.prepare(
+        `INSERT INTO step_journal
+           (task_id, step_index, phase, tool_name, tool_args_hash,
+            git_tree_hash, error_signature, tokens_delta, created_at_ms)
+         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`,
+      ).run(
+        taskId,
+        stepIndex,
+        step.phase,
+        step.toolName ?? null,
+        step.toolArgsHash ?? null,
+        step.gitTreeHash ?? null,
+        step.errorSignature ?? null,
+        step.tokensDelta ?? 0,
+        now,
+      );
+      return {
+        taskId,
+        stepIndex,
+        phase: step.phase,
+        toolName: step.toolName ?? null,
+        toolArgsHash: step.toolArgsHash ?? null,
+        gitTreeHash: step.gitTreeHash ?? null,
+        errorSignature: step.errorSignature ?? null,
+        tokensDelta: step.tokensDelta ?? 0,
+        createdAtMs: now,
+      };
+    });
+  }
+
+  getSteps(taskId: string): StepRecord[] {
+    const rows = this.requireDb()
+      .prepare('SELECT * FROM step_journal WHERE task_id = ? ORDER BY step_index ASC')
+      .all(taskId) as Row[];
+    return rows.map((row) => ({
+      taskId: str(row, 'task_id'),
+      stepIndex: num(row, 'step_index'),
+      phase: str(row, 'phase'),
+      toolName: nullableStr(row, 'tool_name'),
+      toolArgsHash: nullableStr(row, 'tool_args_hash'),
+      gitTreeHash: nullableStr(row, 'git_tree_hash'),
+      errorSignature: nullableStr(row, 'error_signature'),
+      tokensDelta: num(row, 'tokens_delta'),
+      createdAtMs: num(row, 'created_at_ms'),
+    }));
+  }
+
+  // -- done set / tombstones ------------------------------------------------
+
+  markDone(
+    taskId: string,
+    opts: {
+      shippedCommitSha?: string;
+      deliveryMode: string;
+      targetBlobHashes: Record<string, string>;
+    },
+  ): DoneEntry | null {
+    return this.transaction(() => {
+      const db = this.requireDb();
+      const task = this.getTask(taskId);
+      if (task === null) return null;
+      const now = Date.now();
+      db.prepare(
+        `INSERT OR REPLACE INTO done_set
+           (fingerprint, task_id, source_collector, base_commit_sha,
+            shipped_commit_sha, target_blob_hashes_json, delivery_mode, completed_at_ms)
+         VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
+      ).run(
+        task.fingerprint,
+        taskId,
+        task.sourceCollector,
+        task.baseCommitSha,
+        opts.shippedCommitSha ?? null,
+        JSON.stringify(opts.targetBlobHashes),
+        opts.deliveryMode,
+        now,
+      );
+      db.prepare('DELETE FROM work_queue WHERE task_id = ?').run(taskId);
+      return {
+        fingerprint: task.fingerprint,
+        taskId,
+        sourceCollector: task.sourceCollector,
+        baseCommitSha: task.baseCommitSha,
+        shippedCommitSha: opts.shippedCommitSha ?? null,
+        targetBlobHashes: opts.targetBlobHashes,
+        deliveryMode: opts.deliveryMode,
+        completedAtMs: now,
+      };
+    });
+  }
+
+  /**
+   * Tombstone a task, escalating strikes on repeat failure. Each strike
+   * lengthens the cooldown (1h, 6h, 24h, 7d); the 5th strike is permanent
+   * (cooldown_until_ms = -1). The task is removed from the work queue when
+   * its taskId is known. The same diff hash failing again does not reset
+   * the strike count — it increments it.
+   */
+  tombstone(input: {
+    taskId?: string;
+    fingerprint: string;
+    failure: TombstoneFailure;
+  }): TombstoneEntry {
+    const now = Date.now();
+    return this.transaction(() => {
+      const db = this.requireDb();
+      const existing = db
+        .prepare('SELECT * FROM tombstone_registry WHERE fingerprint = ?')
+        .get(input.fingerprint) as Row | undefined;
+      const strikeCount = existing === undefined ? 1 : num(existing, 'strike_count') + 1;
+      const cooldownUntilMs = cooldownUntilForStrike(strikeCount, now);
+      db.prepare(
+        `INSERT INTO tombstone_registry
+           (fingerprint, failure_stage, failure_reason, last_diff_hash,
+            target_blob_hashes_json, strike_count, cooldown_until_ms,
+            quarantine_git_ref, updated_at_ms)
+         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
+         ON CONFLICT(fingerprint) DO UPDATE SET
+           failure_stage = excluded.failure_stage,
+           failure_reason = excluded.failure_reason,
+           last_diff_hash = excluded.last_diff_hash,
+           target_blob_hashes_json = excluded.target_blob_hashes_json,
+           strike_count = excluded.strike_count,
+           cooldown_until_ms = excluded.cooldown_until_ms,
+           quarantine_git_ref = excluded.quarantine_git_ref,
+           updated_at_ms = excluded.updated_at_ms`,
+      ).run(
+        input.fingerprint,
+        input.failure.failureStage,
+        input.failure.failureReason,
+        input.failure.lastDiffHash ?? null,
+        JSON.stringify(input.failure.targetBlobHashes),
+        strikeCount,
+        cooldownUntilMs,
+        input.failure.quarantineGitRef ?? null,
+        now,
+      );
+      if (input.taskId !== undefined) {
+        db.prepare('DELETE FROM work_queue WHERE task_id = ?').run(input.taskId);
+      }
+      return {
+        fingerprint: input.fingerprint,
+        failureStage: input.failure.failureStage,
+        failureReason: input.failure.failureReason,
+        lastDiffHash: input.failure.lastDiffHash ?? null,
+        targetBlobHashes: input.failure.targetBlobHashes,
+        strikeCount,
+        cooldownUntilMs,
+        quarantineGitRef: input.failure.quarantineGitRef ?? null,
+        updatedAtMs: now,
+      };
+    });
+  }
+
+  isDone(fingerprint: string): boolean {
+    const row = this.requireDb()
+      .prepare('SELECT 1 AS one FROM done_set WHERE fingerprint = ?')
+      .get(fingerprint) as Row | undefined;
+    return row !== undefined;
+  }
+
+  getDoneEntry(fingerprint: string): DoneEntry | null {
+    const row = this.requireDb()
+      .prepare('SELECT * FROM done_set WHERE fingerprint = ?')
+      .get(fingerprint) as Row | undefined;
+    if (row === undefined) return null;
+    return {
+      fingerprint: str(row, 'fingerprint'),
+      taskId: str(row, 'task_id'),
+      sourceCollector: str(row, 'source_collector'),
+      baseCommitSha: nullableStr(row, 'base_commit_sha'),
+      shippedCommitSha: nullableStr(row, 'shipped_commit_sha'),
+      targetBlobHashes: json(row, 'target_blob_hashes_json') as Record<string, string>,
+      deliveryMode: str(row, 'delivery_mode'),
+      completedAtMs: num(row, 'completed_at_ms'),
+    };
+  }
+
+  /** All done_set entries, oldest first (used by boot step 4 pruning). */
+  listDone(): DoneEntry[] {
+    const rows = this.requireDb()
+      .prepare('SELECT * FROM done_set ORDER BY completed_at_ms ASC')
+      .all() as Row[];
+    return rows.map((row) => ({
+      fingerprint: str(row, 'fingerprint'),
+      taskId: str(row, 'task_id'),
+      sourceCollector: str(row, 'source_collector'),
+      baseCommitSha: nullableStr(row, 'base_commit_sha'),
+      shippedCommitSha: nullableStr(row, 'shipped_commit_sha'),
+      targetBlobHashes: json(row, 'target_blob_hashes_json') as Record<string, string>,
+      deliveryMode: str(row, 'delivery_mode'),
+      completedAtMs: num(row, 'completed_at_ms'),
+    }));
+  }
+
+  /** Delete a done_set entry by fingerprint. Returns true if one was deleted. */
+  deleteDone(fingerprint: string): boolean {
+    const info = this.requireDb()
+      .prepare('DELETE FROM done_set WHERE fingerprint = ?')
+      .run(fingerprint);
+    return info.changes > 0;
+  }
+
+  getTombstone(fingerprint: string): TombstoneEntry | null {
+    const row = this.requireDb()
+      .prepare('SELECT * FROM tombstone_registry WHERE fingerprint = ?')
+      .get(fingerprint) as Row | undefined;
+    if (row === undefined) return null;
+    return rowToTombstone(row);
+  }
+
+  /** Active tombstone: present and either permanent or still cooling down. */
+  isTombstoned(fingerprint: string, nowMs: number = Date.now()): boolean {
+    const entry = this.getTombstone(fingerprint);
+    if (entry === null) return false;
+    return entry.cooldownUntilMs === -1 || entry.cooldownUntilMs > nowMs;
+  }
+
+  clearTombstone(fingerprint: string): void {
+    this.requireDb()
+      .prepare('DELETE FROM tombstone_registry WHERE fingerprint = ?')
+      .run(fingerprint);
+  }
+
+  /**
+   * Stamp a tombstone permanent (cooldown -1): used when a human rejects a
+   * task in review — the verdict stands until the target blobs change.
+   * Returns true if a tombstone row was updated.
+   */
+  makeTombstonePermanent(fingerprint: string): boolean {
+    const info = this.requireDb()
+      .prepare('UPDATE tombstone_registry SET cooldown_until_ms = -1 WHERE fingerprint = ?')
+      .run(fingerprint);
+    return info.changes > 0;
+  }
+
+  /**
+   * True when a tombstoned fingerprint may be retried: no tombstone, an
+   * expired cooldown, or the target blobs changed since the failure was
+   * recorded (external invalidation — a human or another agent edited the
+   * files, so the old failure may no longer apply).
+   */
+  isTombstoneUnlocked(fingerprint: string, repoRoot: string, nowMs: number = Date.now()): boolean {
+    const entry = this.getTombstone(fingerprint);
+    if (entry === null) return true;
+    if (entry.cooldownUntilMs !== -1 && entry.cooldownUntilMs <= nowMs) return true;
+    return blobsChanged(repoRoot, fingerprint, entry.targetBlobHashes).changed;
+  }
+
+  /** True when any of the files was touched by an autonomous task since `sinceMs`. */
+  filesTouchedSince(files: readonly string[], sinceMs: number): boolean {
+    if (files.length === 0) return false;
+    const wanted = new Set(files);
+    const db = this.requireDb();
+    const doneRows = db
+      .prepare('SELECT target_blob_hashes_json FROM done_set WHERE completed_at_ms >= ?')
+      .all(sinceMs) as Row[];
+    for (const row of doneRows) {
+      const hashes = json(row, 'target_blob_hashes_json') as Record<string, string>;
+      if (Object.keys(hashes).some((f) => wanted.has(f))) return true;
+    }
+    const queueRows = db
+      .prepare(
+        `SELECT target_files_json FROM work_queue
+          WHERE status IN ('PLANNING','IMPLEMENTING','VERIFYING') AND updated_at_ms >= ?`,
+      )
+      .all(sinceMs) as Row[];
+    for (const row of queueRows) {
+      const targets = json(row, 'target_files_json') as string[];
+      if (targets.some((f) => wanted.has(f))) return true;
+    }
+    return false;
+  }
+
+  // -- learned patterns -----------------------------------------------------
+
+  recordPattern(input: {
+    scopeGlob: string;
+    patternType: PatternType;
+    ruleSummary: string;
+    confidence: number;
+    createdFromTaskId?: string;
+  }): LearnedPattern {
+    const summary =
+      input.ruleSummary.length > RULE_SUMMARY_MAX_CHARS
+        ? `${input.ruleSummary.slice(0, RULE_SUMMARY_MAX_CHARS - 3)}...`
+        : input.ruleSummary;
+    const pattern: LearnedPattern = {
+      patternId: uuidv7(),
+      scopeGlob: input.scopeGlob,
+      patternType: input.patternType,
+      ruleSummary: summary,
+      confidence: Math.min(1, Math.max(0, input.confidence)),
+      createdFromTaskId: input.createdFromTaskId ?? null,
+      createdAtMs: Date.now(),
+    };
+    this.requireDb()
+      .prepare(
+        `INSERT INTO learned_patterns
+           (pattern_id, scope_glob, pattern_type, rule_summary,
+            confidence, created_from_task_id, created_at_ms)
+         VALUES (?, ?, ?, ?, ?, ?, ?)`,
+      )
+      .run(
+        pattern.patternId,
+        pattern.scopeGlob,
+        pattern.patternType,
+        pattern.ruleSummary,
+        pattern.confidence,
+        pattern.createdFromTaskId,
+        pattern.createdAtMs,
+      );
+    return pattern;
+  }
+
+  /** Patterns whose scope glob applies to `scope` (usually a file path). */
+  getLearnedPatterns(scope: string): LearnedPattern[] {
+    const rows = this.requireDb()
+      .prepare('SELECT * FROM learned_patterns ORDER BY confidence DESC')
+      .all() as Row[];
+    return rows
+      .map((row) => ({
+        patternId: str(row, 'pattern_id'),
+        scopeGlob: str(row, 'scope_glob'),
+        patternType: str(row, 'pattern_type') as PatternType,
+        ruleSummary: str(row, 'rule_summary'),
+        confidence: num(row, 'confidence'),
+        createdFromTaskId: nullableStr(row, 'created_from_task_id'),
+        createdAtMs: num(row, 'created_at_ms'),
+      }))
+      .filter((p) => p.scopeGlob === scope || globMatches(p.scopeGlob, scope));
+  }
+
+  // -- flaky tests ----------------------------------------------------------
+
+  recordFlakyTest(
+    testId: string,
+    flakeRate: number,
+    opts: { remediationTaskId?: string; quarantine?: boolean } = {},
+  ): FlakyTest {
+    const now = Date.now();
+    // Default: quarantine once the flake rate reaches 30%.
+    const quarantine = opts.quarantine ?? flakeRate >= 0.3;
+    return this.transaction(() => {
+      const db = this.requireDb();
+      const existing = db.prepare('SELECT * FROM flaky_tests WHERE test_id = ?').get(testId) as
+        Row | undefined;
+      const existingQuarantinedAtMs =
+        typeof existing?.quarantined_at_ms === 'number' ? existing.quarantined_at_ms : null;
+      const next: FlakyTest = {
+        testId,
+        flakeRate: Math.min(1, Math.max(0, flakeRate)),
+        quarantinedAtMs: quarantine ? (existingQuarantinedAtMs ?? now) : existingQuarantinedAtMs,
+        remediationTaskId:
+          opts.remediationTaskId ??
+          (existing === undefined ? null : nullableStr(existing, 'remediation_task_id')),
+      };
+      db.prepare(
+        `INSERT INTO flaky_tests (test_id, flake_rate, quarantined_at_ms, remediation_task_id)
+         VALUES (?, ?, ?, ?)
+         ON CONFLICT(test_id) DO UPDATE SET
+           flake_rate = excluded.flake_rate,
+           quarantined_at_ms = excluded.quarantined_at_ms,
+           remediation_task_id = excluded.remediation_task_id`,
+      ).run(next.testId, next.flakeRate, next.quarantinedAtMs, next.remediationTaskId);
+      return next;
+    });
+  }
+
+  getFlakyTests(): FlakyTest[] {
+    const rows = this.requireDb()
+      .prepare('SELECT * FROM flaky_tests ORDER BY flake_rate DESC')
+      .all() as Row[];
+    return rows.map((row) => ({
+      testId: str(row, 'test_id'),
+      flakeRate: num(row, 'flake_rate'),
+      quarantinedAtMs:
+        row.quarantined_at_ms === null || row.quarantined_at_ms === undefined
+          ? null
+          : Number(row.quarantined_at_ms),
+      remediationTaskId: nullableStr(row, 'remediation_task_id'),
+    }));
+  }
+
+  // -- discarded findings / budget ledger (budget v2 scaffolding) -----------
+
+  recordDiscardedFinding(input: {
+    fingerprint: string;
+    sourceCollector: string;
+    priorityScore: number;
+    reason: string;
+    findingPayload: unknown;
+  }): void {
+    this.requireDb()
+      .prepare(
+        `INSERT OR REPLACE INTO discarded_findings
+           (fingerprint, source_collector, priority_score, reason,
+            finding_payload_json, discarded_at_ms)
+         VALUES (?, ?, ?, ?, ?, ?)`,
+      )
+      .run(
+        input.fingerprint,
+        input.sourceCollector,
+        input.priorityScore,
+        input.reason,
+        JSON.stringify(input.findingPayload),
+        Date.now(),
+      );
+  }
+
+  getDiscardedFinding(fingerprint: string): DiscardedFinding | null {
+    const row = this.requireDb()
+      .prepare('SELECT * FROM discarded_findings WHERE fingerprint = ?')
+      .get(fingerprint) as Row | undefined;
+    if (row === undefined) return null;
+    return {
+      fingerprint: str(row, 'fingerprint'),
+      sourceCollector: str(row, 'source_collector'),
+      priorityScore: num(row, 'priority_score'),
+      reason: str(row, 'reason'),
+      findingPayload: json(row, 'finding_payload_json'),
+      discardedAtMs: num(row, 'discarded_at_ms'),
+    };
+  }
+
+  recordBudgetSpend(windowKey: string, tokens: number, costUsd: number): BudgetWindow {
+    return this.transaction(() => {
+      const db = this.requireDb();
+      const existing = db
+        .prepare('SELECT * FROM budget_ledger WHERE window_key = ?')
+        .get(windowKey) as Row | undefined;
+      const next: BudgetWindow =
+        existing === undefined
+          ? {
+              windowKey,
+              tokensSpent: tokens,
+              costUsd,
+              windowStartMs: Date.now(),
+            }
+          : {
+              windowKey,
+              tokensSpent: num(existing, 'tokens_spent') + tokens,
+              costUsd: num(existing, 'cost_usd') + costUsd,
+              windowStartMs: num(existing, 'window_start_ms'),
+            };
+      db.prepare(
+        `INSERT INTO budget_ledger (window_key, tokens_spent, cost_usd, window_start_ms)
+         VALUES (?, ?, ?, ?)
+         ON CONFLICT(window_key) DO UPDATE SET
+           tokens_spent = excluded.tokens_spent,
+           cost_usd = excluded.cost_usd`,
+      ).run(next.windowKey, next.tokensSpent, next.costUsd, next.windowStartMs);
+      return next;
+    });
+  }
+
+  getBudgetWindow(windowKey: string): BudgetWindow | null {
+    const row = this.requireDb()
+      .prepare('SELECT * FROM budget_ledger WHERE window_key = ?')
+      .get(windowKey) as Row | undefined;
+    if (row === undefined) return null;
+    return {
+      windowKey: str(row, 'window_key'),
+      tokensSpent: num(row, 'tokens_spent'),
+      costUsd: num(row, 'cost_usd'),
+      windowStartMs: num(row, 'window_start_ms'),
+    };
+  }
+
+  // -- git-notes sync -------------------------------------------------------
+
+  /**
+   * Write a JSON receipt for a fingerprint onto `commitSha` in
+   * `refs/notes/omnexx-auto`. The note makes completion visible to any
+   * clone even if `.omnexx/autonomous.db` is lost. Returns false when git
+   * cannot attach the note (e.g. no such commit).
+   */
+  async syncReceiptToGitNotes(
+    fingerprint: string,
+    status: ReceiptStatus,
+    commitSha: string,
+    extra: ReceiptExtra = {},
+  ): Promise<boolean> {
+    // git accepts notes on object ids that do not exist in the repo, so
+    // verify the target object first — a receipt for a phantom commit is
+    // worse than no receipt.
+    const exists = await git(this.repoRoot, ['cat-file', '-e', commitSha], {
+      allowFailure: true,
+    });
+    if (exists.exitCode !== 0) return false;
+    const receipt = {
+      fingerprint,
+      status,
+      commitSha,
+      updatedAtMs: Date.now(),
+      ...extra,
+    };
+    const result = await git(
+      this.repoRoot,
+      ['notes', '--ref', GIT_NOTES_REF, 'add', '-f', '-m', JSON.stringify(receipt), commitSha],
+      { allowFailure: true },
+    );
+    return result.exitCode === 0;
+  }
+
+  /**
+   * Read receipts back from `refs/notes/omnexx-auto` and merge them into
+   * the local done-set / tombstone registry (local rows win on conflict).
+   * Returns counts of receipts applied vs skipped.
+   */
+  async hydrateFromGitNotes(): Promise<{ done: number; tombstoned: number; skipped: number }> {
+    const counts = { done: 0, tombstoned: 0, skipped: 0 };
+    const list = await git(this.repoRoot, ['notes', '--ref', GIT_NOTES_REF, 'list'], {
+      allowFailure: true,
+    });
+    if (list.exitCode !== 0 || list.stdout.trim() === '') return counts;
+    const db = this.requireDb();
+    for (const line of list.stdout.split('\n')) {
+      const parts = line.trim().split(/\s+/);
+      const commitSha = parts[1];
+      if (commitSha === undefined) {
+        counts.skipped += 1;
+        continue;
+      }
+      const show = await git(this.repoRoot, ['notes', '--ref', GIT_NOTES_REF, 'show', commitSha], {
+        allowFailure: true,
+      });
+      if (show.exitCode !== 0) {
+        counts.skipped += 1;
+        continue;
+      }
+      let receipt: {
+        fingerprint?: unknown;
+        status?: unknown;
+        sourceCollector?: unknown;
+        baseCommitSha?: unknown;
+        shippedCommitSha?: unknown;
+        targetBlobHashes?: unknown;
+        deliveryMode?: unknown;
+        failureStage?: unknown;
+        failureReason?: unknown;
+        strikeCount?: unknown;
+        cooldownUntilMs?: unknown;
+        completedAtMs?: unknown;
+        updatedAtMs?: unknown;
+      };
+      try {
+        receipt = JSON.parse(show.stdout) as typeof receipt;
+      } catch {
+        counts.skipped += 1;
+        continue;
+      }
+      if (typeof receipt.fingerprint !== 'string' || typeof receipt.status !== 'string') {
+        counts.skipped += 1;
+        continue;
+      }
+      const atMs = typeof receipt.updatedAtMs === 'number' ? receipt.updatedAtMs : Date.now();
+      if (receipt.status === 'done') {
+        const info = db
+          .prepare(
+            `INSERT OR IGNORE INTO done_set
+               (fingerprint, task_id, source_collector, base_commit_sha,
+                shipped_commit_sha, target_blob_hashes_json, delivery_mode, completed_at_ms)
+             VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
+          )
+          .run(
+            receipt.fingerprint,
+            `notes:${commitSha.slice(0, 12)}`,
+            typeof receipt.sourceCollector === 'string' ? receipt.sourceCollector : 'git-notes',
+            typeof receipt.baseCommitSha === 'string' ? receipt.baseCommitSha : null,
+            typeof receipt.shippedCommitSha === 'string' ? receipt.shippedCommitSha : commitSha,
+            JSON.stringify((receipt.targetBlobHashes as Record<string, string> | undefined) ?? {}),
+            typeof receipt.deliveryMode === 'string' ? receipt.deliveryMode : 'commit',
+            typeof receipt.completedAtMs === 'number' ? receipt.completedAtMs : atMs,
+          );
+        if (info.changes > 0) counts.done += 1;
+        else counts.skipped += 1;
+      } else if (receipt.status === 'tombstoned') {
+        const info = db
+          .prepare(
+            `INSERT OR IGNORE INTO tombstone_registry
+               (fingerprint, failure_stage, failure_reason, last_diff_hash,
+                target_blob_hashes_json, strike_count, cooldown_until_ms,
+                quarantine_git_ref, updated_at_ms)
+             VALUES (?, ?, ?, NULL, ?, ?, ?, NULL, ?)`,
+          )
+          .run(
+            receipt.fingerprint,
+            typeof receipt.failureStage === 'string' ? receipt.failureStage : 'unknown',
+            typeof receipt.failureReason === 'string' ? receipt.failureReason : 'hydrated',
+            JSON.stringify((receipt.targetBlobHashes as Record<string, string> | undefined) ?? {}),
+            typeof receipt.strikeCount === 'number' ? receipt.strikeCount : 1,
+            typeof receipt.cooldownUntilMs === 'number' ? receipt.cooldownUntilMs : -1,
+            atMs,
+          );
+        if (info.changes > 0) counts.tombstoned += 1;
+        else counts.skipped += 1;
+      } else {
+        counts.skipped += 1;
+      }
+    }
+    return counts;
+  }
+}
+
+function rowToTask(row: Row): QueuedTask {
+  return {
+    taskId: str(row, 'task_id'),
+    fingerprint: str(row, 'fingerprint'),
+    sourceCollector: str(row, 'source_collector'),
+    priorityScore: num(row, 'priority_score'),
+    status: str(row, 'status') as TaskStatus,
+    targetFiles: json(row, 'target_files_json') as string[],
+    findingPayload: json(row, 'finding_payload_json'),
+    plan: typeof row.plan_json === 'string' ? (JSON.parse(row.plan_json) as unknown) : null,
+    worktreePath: nullableStr(row, 'worktree_path'),
+    baseCommitSha: nullableStr(row, 'base_commit_sha'),
+    attemptCount: num(row, 'attempt_count'),
+    tokensSpent: num(row, 'tokens_spent'),
+    turnsSpent: num(row, 'turns_spent'),
+    createdAtMs: num(row, 'created_at_ms'),
+    updatedAtMs: num(row, 'updated_at_ms'),
+  };
+}
+
+function rowToTombstone(row: Row): TombstoneEntry {
+  return {
+    fingerprint: str(row, 'fingerprint'),
+    failureStage: str(row, 'failure_stage'),
+    failureReason: str(row, 'failure_reason'),
+    lastDiffHash: nullableStr(row, 'last_diff_hash'),
+    targetBlobHashes: json(row, 'target_blob_hashes_json') as Record<string, string>,
+    strikeCount: num(row, 'strike_count'),
+    cooldownUntilMs: num(row, 'cooldown_until_ms'),
+    quarantineGitRef: nullableStr(row, 'quarantine_git_ref'),
+    updatedAtMs: num(row, 'updated_at_ms'),
+  };
+}
diff --git a/src/autonomous/state.ts b/src/autonomous/state.ts
new file mode 100644
index 00000000..29b9687f
--- /dev/null
+++ b/src/autonomous/state.ts
@@ -0,0 +1,530 @@
+/**
+ * The daemon's state surface, read through the state store that owns the schema
+ * (`src/autonomous/state-store.ts`, `AutonomousStateStore`) and the review queue the
+ * shipping controller owns (`.omnexx/review-queue.json`). The daemon itself
+ * (`src/autonomous/daemon.ts`) is the only writer while it runs; the CLI writes only
+ * the control file, and `queue drop` / `review approve|reject` — the human's explicit
+ * verdicts.
+ *
+ * Every read tolerates a missing DB, a missing table, or a missing review queue (the
+ * daemon may not have created them yet) and reports "nothing there" instead of
+ * crashing. `node:sqlite` is dynamically imported (tsup rewrites a static import of
+ * the built-in). All writes go through the store; the read-only direct connections
+ * below are for views the store has no list API for (tombstones, last activity,
+ * burn windows).
+ */
+import { execFile } from 'node:child_process';
+import { existsSync, readFileSync, writeFileSync } from 'node:fs';
+import { mkdirSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+import type { AutonomousConfig } from '../config/sections/autonomous.js';
+import type {
+  AutonomousStateStore,
+  QueuedTask as StoreTask,
+  TombstoneEntry,
+} from './state-store.js';
+
+export interface AutonomousPaths {
+  repoRoot: string;
+  dbPath: string;
+  lockPath: string;
+  controlPath: string;
+  logPath: string;
+  reviewQueuePath: string;
+  worktreeDir: string;
+}
+
+export function resolveAutonomousPaths(cwd: string, config: AutonomousConfig): AutonomousPaths {
+  const dir = join(cwd, '.omnexx');
+  return {
+    repoRoot: cwd,
+    dbPath: join(cwd, config.state_db_path),
+    lockPath: join(dir, 'daemon.lock'),
+    controlPath: join(dir, 'daemon-control.json'),
+    logPath: join(dir, 'logs', 'daemon.log'),
+    reviewQueuePath: join(dir, 'review-queue.json'),
+    worktreeDir: join(cwd, config.worktree_dir),
+  };
+}
+
+/** One queued task, with a human-readable title pulled out of its finding payload. */
+export interface QueueTaskView {
+  id: string;
+  fingerprint: string;
+  title: string;
+  description: string;
+  collector: string;
+  priorityScore: number;
+  status: string;
+  targetFiles: string[];
+  worktreePath: string | null;
+  baseCommitSha: string | null;
+  attemptCount: number;
+  tokensSpent: number;
+  turnsSpent: number;
+  createdAtMs: number;
+  updatedAtMs: number;
+}
+
+export interface TombstoneView {
+  fingerprint: string;
+  failureStage: string;
+  failureReason: string;
+  strikeCount: number;
+  /** -1 = permanent, otherwise epoch ms when the cooldown expires. */
+  cooldownUntilMs: number;
+  quarantineGitRef: string | null;
+  updatedAtMs: number;
+}
+
+export interface ReviewQueueEntry {
+  taskId: string;
+  tier: 1 | 2 | 3;
+  riskScore: number;
+  branch: string;
+  prUrl?: string | undefined;
+  needsHumanApproval: boolean;
+  createdAt: number;
+}
+
+export interface DaemonLock {
+  pid: number;
+  host: string;
+  bootId: string;
+  startedAt: number;
+}
+
+export interface LastActivity {
+  taskId: string;
+  phase: string;
+  createdAtMs: number;
+}
+
+interface SqliteStatement {
+  all: (...params: unknown[]) => Record<string, unknown>[];
+  get: (...params: unknown[]) => Record<string, unknown> | undefined;
+  run: (...params: unknown[]) => { changes: number };
+}
+
+interface SqliteDb {
+  prepare: (sql: string) => SqliteStatement;
+  exec: (sql: string) => void;
+  close: () => void;
+}
+
+interface SqliteModule {
+  DatabaseSync: new (path: string, options?: { readOnly?: boolean }) => SqliteDb;
+}
+
+const asString = (v: unknown): string => (typeof v === 'string' ? v : '');
+
+async function loadSqlite(): Promise<SqliteModule | null> {
+  try {
+    return (await import('node:sqlite')) as SqliteModule;
+  } catch {
+    return null;
+  }
+}
+
+async function openStore(paths: AutonomousPaths): Promise<AutonomousStateStore | null> {
+  if (!existsSync(paths.dbPath)) return null;
+  try {
+    const { AutonomousStateStore: Store } = await import('./state-store.js');
+    const store = new Store({ repoRoot: paths.repoRoot, dbPath: paths.dbPath });
+    await store.open();
+    return store;
+  } catch {
+    return null;
+  }
+}
+
+function payloadText(payload: unknown, keys: readonly string[]): string {
+  if (payload === null || typeof payload !== 'object') return '';
+  const record = payload as Record<string, unknown>;
+  for (const key of keys) {
+    const value = record[key];
+    if (typeof value === 'string' && value.trim() !== '') return value;
+  }
+  return '';
+}
+
+export function toQueueTaskView(task: StoreTask): QueueTaskView {
+  return {
+    id: task.taskId,
+    fingerprint: task.fingerprint,
+    title:
+      payloadText(task.findingPayload, ['title', 'summary', 'message']) ||
+      `${task.sourceCollector} finding`,
+    description: payloadText(task.findingPayload, ['description', 'detail', 'body']),
+    collector: task.sourceCollector,
+    priorityScore: task.priorityScore,
+    status: task.status,
+    targetFiles: task.targetFiles,
+    worktreePath: task.worktreePath,
+    baseCommitSha: task.baseCommitSha,
+    attemptCount: task.attemptCount,
+    tokensSpent: task.tokensSpent,
+    turnsSpent: task.turnsSpent,
+    createdAtMs: task.createdAtMs,
+    updatedAtMs: task.updatedAtMs,
+  };
+}
+
+export async function readQueue(paths: AutonomousPaths): Promise<QueueTaskView[]> {
+  const store = await openStore(paths);
+  if (!store) return [];
+  try {
+    return store.listTasks().map(toQueueTaskView);
+  } catch {
+    return [];
+  } finally {
+    store.close();
+  }
+}
+
+export async function findTask(
+  paths: AutonomousPaths,
+  taskId: string,
+): Promise<QueueTaskView | null> {
+  const store = await openStore(paths);
+  if (!store) return null;
+  try {
+    const task = store.getTask(taskId);
+    return task ? toQueueTaskView(task) : null;
+  } catch {
+    return null;
+  } finally {
+    store.close();
+  }
+}
+
+/** All tombstones, newest first (read-only; the store has no list-all). */
+export async function readTombstones(paths: AutonomousPaths): Promise<TombstoneView[]> {
+  if (!existsSync(paths.dbPath)) return [];
+  const sqlite = await loadSqlite();
+  if (!sqlite) return [];
+  let db: SqliteDb | null = null;
+  try {
+    db = new sqlite.DatabaseSync(paths.dbPath, { readOnly: true });
+    const rows = db
+      .prepare(
+        `SELECT fingerprint, failure_stage, failure_reason, strike_count,
+                cooldown_until_ms, quarantine_git_ref, updated_at_ms
+         FROM tombstone_registry ORDER BY updated_at_ms DESC`,
+      )
+      .all();
+    return rows.map((r) => ({
+      fingerprint: asString(r.fingerprint),
+      failureStage: asString(r.failure_stage),
+      failureReason: asString(r.failure_reason),
+      strikeCount: typeof r.strike_count === 'number' ? r.strike_count : 0,
+      cooldownUntilMs: typeof r.cooldown_until_ms === 'number' ? r.cooldown_until_ms : 0,
+      quarantineGitRef: typeof r.quarantine_git_ref === 'string' ? r.quarantine_git_ref : null,
+      updatedAtMs: typeof r.updated_at_ms === 'number' ? r.updated_at_ms : 0,
+    }));
+  } catch {
+    return [];
+  } finally {
+    db?.close();
+  }
+}
+
+/** The most recent step-journal entry, if the daemon has done anything yet. */
+export async function readLastActivity(paths: AutonomousPaths): Promise<LastActivity | null> {
+  if (!existsSync(paths.dbPath)) return null;
+  const sqlite = await loadSqlite();
+  if (!sqlite) return null;
+  let db: SqliteDb | null = null;
+  try {
+    db = new sqlite.DatabaseSync(paths.dbPath, { readOnly: true });
+    const row = db
+      .prepare(
+        `SELECT task_id, phase, created_at_ms FROM step_journal
+         ORDER BY created_at_ms DESC LIMIT 1`,
+      )
+      .get();
+    if (!row) return null;
+    return {
+      taskId: asString(row.task_id),
+      phase: asString(row.phase),
+      createdAtMs: typeof row.created_at_ms === 'number' ? row.created_at_ms : 0,
+    };
+  } catch {
+    return null;
+  } finally {
+    db?.close();
+  }
+}
+
+/** Token/cost burn summed from budget_ledger windows that started in the window. */
+export async function readBurn(
+  paths: AutonomousPaths,
+  nowMs: number,
+): Promise<{ tokens1h: number; cost1hUsd: number; tokens24h: number; cost24hUsd: number }> {
+  const empty = { tokens1h: 0, cost1hUsd: 0, tokens24h: 0, cost24hUsd: 0 };
+  if (!existsSync(paths.dbPath)) return empty;
+  const sqlite = await loadSqlite();
+  if (!sqlite) return empty;
+  let db: SqliteDb | null = null;
+  try {
+    db = new sqlite.DatabaseSync(paths.dbPath, { readOnly: true });
+    const rows = db
+      .prepare(`SELECT tokens_spent, cost_usd, window_start_ms FROM budget_ledger`)
+      .all();
+    const burn = { ...empty };
+    for (const r of rows) {
+      const tokens = typeof r.tokens_spent === 'number' ? r.tokens_spent : 0;
+      const cost = typeof r.cost_usd === 'number' ? r.cost_usd : 0;
+      const start = typeof r.window_start_ms === 'number' ? r.window_start_ms : 0;
+      if (start >= nowMs - 24 * 3_600_000) {
+        burn.tokens24h += tokens;
+        burn.cost24hUsd += cost;
+        if (start >= nowMs - 3_600_000) {
+          burn.tokens1h += tokens;
+          burn.cost1hUsd += cost;
+        }
+      }
+    }
+    return burn;
+  } catch {
+    return empty;
+  } finally {
+    db?.close();
+  }
+}
+
+/** The fingerprint for a task id, from the queue or the done set (read-only). */
+export async function findFingerprint(
+  paths: AutonomousPaths,
+  taskId: string,
+): Promise<string | null> {
+  const store = await openStore(paths);
+  if (store) {
+    try {
+      const task = store.getTask(taskId);
+      if (task) return task.fingerprint;
+    } catch {
+      // Fall through to the done-set lookup below.
+    } finally {
+      store.close();
+    }
+  }
+  if (!existsSync(paths.dbPath)) return null;
+  const sqlite = await loadSqlite();
+  if (!sqlite) return null;
+  let db: SqliteDb | null = null;
+  try {
+    db = new sqlite.DatabaseSync(paths.dbPath, { readOnly: true });
+    const row = db.prepare(`SELECT fingerprint FROM done_set WHERE task_id = ?`).get(taskId);
+    return row && typeof row.fingerprint === 'string' ? row.fingerprint : null;
+  } catch {
+    return null;
+  } finally {
+    db?.close();
+  }
+}
+
+/** The daemon's lock (`.omnexx/daemon.lock`), or null when no daemon holds it. */
+export function readDaemonLock(lockPath: string): DaemonLock | null {
+  try {
+    const parsed: unknown = JSON.parse(readFileSync(lockPath, 'utf8'));
+    if (parsed === null || typeof parsed !== 'object') return null;
+    const lock = parsed as Record<string, unknown>;
+    const pid = lock.pid;
+    if (typeof pid !== 'number' || !Number.isInteger(pid) || pid <= 0) return null;
+    try {
+      process.kill(pid, 0);
+    } catch {
+      return null;
+    }
+    return {
+      pid,
+      host: typeof lock.host === 'string' ? lock.host : '',
+      bootId: typeof lock.bootId === 'string' ? lock.bootId : '',
+      startedAt: typeof lock.startedAt === 'number' ? lock.startedAt : 0,
+    };
+  } catch {
+    return null;
+  }
+}
+
+export type DaemonControlAction = 'pause' | 'resume' | 'stop';
+
+/**
+ * Tell a running daemon what to do. The daemon has no control-file polling yet, so
+ * pause/resume/stop also act on the process directly (SIGSTOP/SIGCONT/SIGTERM);
+ * the file is the durable record for the polling the daemon worker adds later.
+ */
+export function writeDaemonControl(
+  controlPath: string,
+  action: DaemonControlAction,
+  taskId?: string,
+): void {
+  mkdirSync(dirname(controlPath), { recursive: true });
+  writeFileSync(
+    controlPath,
+    JSON.stringify(
+      {
+        action,
+        ...(taskId ? { task_id: taskId } : {}),
+        at: new Date().toISOString(),
+      },
+      null,
+      2,
+    ) + '\n',
+  );
+}
+
+/** Last `lines` lines of the daemon log, or null when the daemon has never logged. */
+export function readLogTail(logPath: string, lines: number): string[] | null {
+  if (!existsSync(logPath)) return null;
+  const text = readFileSync(logPath, 'utf8');
+  const all = text.split('\n');
+  if (all.length > 0 && all[all.length - 1] === '') all.pop();
+  return all.slice(-Math.max(1, lines));
+}
+
+export function readReviewQueue(reviewQueuePath: string): ReviewQueueEntry[] {
+  try {
+    const parsed: unknown = JSON.parse(readFileSync(reviewQueuePath, 'utf8'));
+    if (!Array.isArray(parsed)) return [];
+    return (parsed as Record<string, unknown>[])
+      .filter((e) => typeof e.taskId === 'string')
+      .map((e) => ({
+        taskId: e.taskId as string,
+        tier: e.tier === 1 || e.tier === 2 || e.tier === 3 ? e.tier : 2,
+        riskScore: typeof e.riskScore === 'number' ? e.riskScore : 0,
+        branch: typeof e.branch === 'string' ? e.branch : '',
+        ...(typeof e.prUrl === 'string' ? { prUrl: e.prUrl } : {}),
+        needsHumanApproval: e.needsHumanApproval === true,
+        createdAt: typeof e.createdAt === 'number' ? e.createdAt : 0,
+      }));
+  } catch {
+    return [];
+  }
+}
+
+export function writeReviewQueue(reviewQueuePath: string, entries: ReviewQueueEntry[]): void {
+  mkdirSync(dirname(reviewQueuePath), { recursive: true });
+  writeFileSync(reviewQueuePath, JSON.stringify(entries, null, 2) + '\n');
+}
+
+/**
+ * Remove a task from the queue. The store has no delete API, so this is the one
+ * direct write: a short-lived connection, busy_timeout set so a running daemon's
+ * open connection does not make it fail. False when the DB or the task is missing.
+ */
+export async function dropTask(paths: AutonomousPaths, taskId: string): Promise<boolean> {
+  const store = await openStore(paths);
+  if (!store) return false;
+  try {
+    return store.deleteTask(taskId);
+  } catch {
+    return false;
+  } finally {
+    store.close();
+  }
+}
+
+/**
+ * Reject a task: it leaves the review queue (and the work queue, if still there), a
+ * permanent tombstone (cooldown -1) records the verdict, and the reason is written
+ * to learned_patterns as an anti-pattern so discovery stops proposing the same work.
+ * The store's tombstone() computes a strike cooldown, so permanence is stamped with
+ * the one direct write afterwards.
+ */
+export async function rejectTask(
+  paths: AutonomousPaths,
+  taskId: string,
+  reason: string,
+): Promise<boolean> {
+  const fingerprint = await findFingerprint(paths, taskId);
+  const before = readReviewQueue(paths.reviewQueuePath);
+  const inReview = before.some((e) => e.taskId === taskId);
+  if (!inReview && !fingerprint) return false;
+  writeReviewQueue(
+    paths.reviewQueuePath,
+    before.filter((e) => e.taskId !== taskId),
+  );
+  if (!fingerprint) return true;
+  const store = await openStore(paths);
+  if (!store) return inReview;
+  try {
+    const existing: TombstoneEntry | null = store.getTombstone(fingerprint);
+    store.tombstone({
+      taskId,
+      fingerprint,
+      failure: {
+        failureStage: 'REVIEW_REJECTED',
+        failureReason: reason,
+        ...(existing?.lastDiffHash ? { lastDiffHash: existing.lastDiffHash } : {}),
+        targetBlobHashes: existing?.targetBlobHashes ?? {},
+        ...(existing?.quarantineGitRef ? { quarantineGitRef: existing.quarantineGitRef } : {}),
+      },
+    });
+    store.recordPattern({
+      scopeGlob: '**',
+      patternType: 'ANTI_PATTERN',
+      ruleSummary: `rejected in review (${taskId}): ${reason}`,
+      confidence: 0.9,
+      createdFromTaskId: taskId,
+    });
+  } catch {
+    return inReview;
+  } finally {
+    store.close();
+  }
+  // Stamp the tombstone permanent: a human rejection stands until the target
+  // blobs change.
+  const store2 = await openStore(paths);
+  if (store2) {
+    try {
+      store2.makeTombstonePermanent(fingerprint);
+    } catch {
+      // The tombstone and pattern are recorded; only the permanence stamp failed.
+    } finally {
+      store2.close();
+    }
+  }
+  return true;
+}
+
+function runGit(args: string[], cwd: string): Promise<string> {
+  return new Promise((resolve, reject) => {
+    execFile('git', args, { cwd, timeout: 30_000 }, (err, stdout) => {
+      if (err) reject(err instanceof Error ? err : new Error('git failed'));
+      else resolve(stdout);
+    });
+  });
+}
+
+/**
+ * The diff for a task, for review: the shipped branch against its merge-base with
+ * the base branch, or the worktree's committed + uncommitted diff for a queued task.
+ * Null when there is nothing to show yet.
+ */
+export async function getTaskDiff(
+  cwd: string,
+  baseBranch: string,
+  task: QueueTaskView,
+  reviewEntry: ReviewQueueEntry | null,
+): Promise<string | null> {
+  try {
+    if (reviewEntry?.branch) {
+      const mergeBase = (await runGit(['merge-base', baseBranch, reviewEntry.branch], cwd)).trim();
+      if (!mergeBase) return null;
+      return await runGit(['diff', mergeBase, reviewEntry.branch], cwd);
+    }
+    if (task.worktreePath && task.baseCommitSha) {
+      const committed = await runGit(['diff', task.baseCommitSha, 'HEAD'], task.worktreePath).catch(
+        () => '',
+      );
+      const uncommitted = await runGit(['diff'], task.worktreePath).catch(() => '');
+      const diff = [committed.trim(), uncommitted.trim()].filter(Boolean).join('\n');
+      return diff === '' ? null : diff;
+    }
+    return null;
+  } catch {
+    return null;
+  }
+}
diff --git a/src/autonomous/tool-guard.ts b/src/autonomous/tool-guard.ts
new file mode 100644
index 00000000..9ec6473d
--- /dev/null
+++ b/src/autonomous/tool-guard.ts
@@ -0,0 +1,355 @@
+import { execa } from 'execa';
+import { basename, resolve, sep } from 'node:path';
+import { OmnexxError } from '../errors.js';
+import { checkCommand, type PolicyContext } from '../security/command-policy.js';
+import { scrubEnv } from '../security/env-scrub.js';
+import { isInside } from '../security/paths.js';
+
+/**
+ * Safety guard for the 24/7 autonomous daemon: the tool boundary between the agent and the
+ * host. It composes the existing equivalents instead of duplicating them —
+ * `src/security/command-policy.ts` (shell firewall) and `src/security/env-scrub.ts`
+ * (env scrubbing) — and adds the daemon's immutable path denylist, its extra shell rules,
+ * and the dependency supply-chain checks.
+ *
+ * Every violation throws {@link SecurityGuardrailError}; the daemon aborts the task to
+ * QUARANTINE on it. Nothing here is configurable at runtime: the denylist is a module
+ * constant, so a compromised task cannot talk the guard out of its rules.
+ */
+
+export class SecurityGuardrailError extends OmnexxError {
+  constructor(message: string, hint?: string) {
+    super('security-guardrail', message, hint);
+  }
+}
+
+/** Paths the daemon agent may never read or write, matched against repo-relative paths. */
+export const DENYLIST: readonly string[] = [
+  'omnexx.toml',
+  '.omnexx/**',
+  'CLAUDE.md',
+  'AGENTS.md',
+  '.cursorrules',
+  '.github/workflows/**',
+  '.gitlab-ci.yml',
+  'Dockerfile*',
+  'scripts/release*',
+  '.npmrc',
+  '.env*',
+  '*.pem',
+  '*.key',
+  '*.p12',
+  '*credentials*',
+  '.git/config',
+  '.git/hooks/**',
+];
+
+/** Lockfiles: read-only unless the change comes from the dependency updater. */
+export const LOCKFILES: readonly string[] = [
+  'package-lock.json',
+  'pnpm-lock.yaml',
+  'yarn.lock',
+  'Cargo.lock',
+];
+
+function matchGlob(pattern: string, path: string): boolean {
+  // `**` crosses segments; `*` stays inside one segment.
+  const re = new RegExp(
+    `^${pattern
+      .split('**')
+      .map((part) =>
+        part
+          .split('*')
+          .map((seg) => seg.replace(/[.+?^${}()|[\]\\]/g, '\\$&'))
+          .join('[^/]*'),
+      )
+      .join('.*')}$`,
+  );
+  return re.test(path);
+}
+
+function isDeniedPath(relPath: string): string | undefined {
+  const normalized = relPath.split(sep).join('/');
+  const base = basename(normalized);
+  for (const pattern of DENYLIST) {
+    if (pattern.includes('/')) {
+      if (matchGlob(pattern, normalized)) return pattern;
+    } else if (matchGlob(pattern, base) || matchGlob(pattern, normalized)) {
+      return pattern;
+    }
+  }
+  return undefined;
+}
+
+export type PathMode = 'read' | 'write';
+
+export interface GuardPathOptions {
+  /** Which collector produced the change; only `dependency_update` may write lockfiles. */
+  sourceCollector?: string;
+}
+
+/**
+ * Enforce the denylist (and the lockfile rule) for one repo-relative path.
+ * Throws {@link SecurityGuardrailError} on violation.
+ */
+export function assertPathAllowed(
+  relPath: string,
+  mode: PathMode,
+  opts: GuardPathOptions = {},
+): void {
+  const denied = isDeniedPath(relPath);
+  if (denied) {
+    throw new SecurityGuardrailError(
+      `${mode} of ${relPath} is denied (matches denylist rule ${denied})`,
+      'the daemon may never touch config, credentials, CI, or its own state files',
+    );
+  }
+  if (
+    mode === 'write' &&
+    LOCKFILES.includes(basename(relPath)) &&
+    opts.sourceCollector !== 'dependency_update'
+  ) {
+    throw new SecurityGuardrailError(
+      `write of lockfile ${relPath} is denied outside dependency_update`,
+      'only the dependency updater may change lockfiles',
+    );
+  }
+}
+
+/** True when the path passes the denylist (and, for writes, the lockfile rule). */
+export function isPathAllowed(
+  relPath: string,
+  mode: PathMode,
+  opts: GuardPathOptions = {},
+): boolean {
+  try {
+    assertPathAllowed(relPath, mode, opts);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+/** Extra daemon shell rules, on top of the existing command policy. */
+const DAEMON_DENY: readonly { pattern: RegExp; rule: string; reason: string }[] = [
+  {
+    pattern: /\bgit\s+push\b.*--force\b/,
+    rule: 'git-push-force',
+    reason: 'git push --force is never allowed; the shipping controller pushes fast-forward only',
+  },
+  {
+    pattern: /\bgit\s+reset\s+--hard\b/,
+    rule: 'git-reset-hard',
+    reason:
+      'git reset --hard outside a worktree would destroy user state; use the worktree manager',
+  },
+  {
+    pattern: /\bgh\s+(repo\s+delete|release)\b/,
+    rule: 'gh-destructive',
+    reason: 'gh repo delete / gh release are destructive and never part of a task',
+  },
+  {
+    pattern: /\bnpm\s+publish\b/,
+    rule: 'npm-publish',
+    reason: 'npm publish is never part of a task; releases go through scripts/release* (denied)',
+  },
+  {
+    pattern: /\b(curl|wget)\b/,
+    rule: 'network-fetch',
+    reason: 'curl/wget are not allowed; the harness fetches what a task needs',
+  },
+  {
+    pattern: /\bchmod\b[^|;&]*\+s\b/,
+    rule: 'chmod-setuid',
+    reason: 'chmod +s (setuid/setgid) is never allowed',
+  },
+  {
+    pattern: /(^|[\s'"])\.\.([/\\]|$)/,
+    rule: 'path-traversal',
+    reason: '.. traversal outside the worktree is not allowed',
+  },
+];
+
+export interface DaemonCommandVerdict {
+  allowed: boolean;
+  rule?: string | undefined;
+  reason?: string | undefined;
+}
+
+/**
+ * Shell firewall for the daemon's bash tool: the existing command policy first
+ * (it already denies sudo/ssh/nc, `gh`, `npm publish`, git writes, and writes outside the
+ * worktree), then the daemon's extra rules. The `..` rule is scoped to arguments that
+ * resolve outside `ctx.root`; a `..` that stays inside the worktree is fine.
+ */
+export function checkDaemonCommand(command: string, ctx: PolicyContext): DaemonCommandVerdict {
+  const base = checkCommand(command, ctx);
+  if (!base.allowed) return { allowed: false, rule: base.rule, reason: base.reason };
+  for (const { pattern, rule, reason } of DAEMON_DENY) {
+    if (!pattern.test(command)) continue;
+    if (rule === 'path-traversal') {
+      // Only a traversal that actually escapes the worktree is a violation:
+      // resolve every `..`-bearing token against the root and check containment.
+      const outside = command
+        .split(/[\s'";|&]+/)
+        .filter((t) => t.includes('..'))
+        .some((t) => {
+          const cleaned = t.replace(/^['"]|['"]$/g, '');
+          return !isInside(ctx.root, resolve(ctx.root, cleaned));
+        });
+      if (!outside) continue;
+    }
+    return { allowed: false, rule, reason };
+  }
+  return { allowed: true };
+}
+
+/** Like {@link checkDaemonCommand} but throws {@link SecurityGuardrailError} on denial. */
+export function assertDaemonCommand(command: string, ctx: PolicyContext): void {
+  const verdict = checkDaemonCommand(command, ctx);
+  if (!verdict.allowed) {
+    throw new SecurityGuardrailError(
+      `command denied [${verdict.rule}]: ${verdict.reason ?? ''} — ${command.slice(0, 120)}`,
+      'the task is aborted to QUARANTINE on a guardrail violation',
+    );
+  }
+}
+
+/** Env vars stripped from every child process, in addition to what scrubEnv already removes. */
+export const STRIPPED_ENV: readonly string[] = [
+  'OPENAI_API_KEY',
+  'ANTHROPIC_API_KEY',
+  'GEMINI_API_KEY',
+  'GITHUB_TOKEN',
+  'NPM_TOKEN',
+  'AWS_ACCESS_KEY_ID',
+  'AWS_SECRET_ACCESS_KEY',
+  'AWS_SESSION_TOKEN',
+  'GOOGLE_APPLICATION_CREDENTIALS',
+  'GCP_SERVICE_ACCOUNT_KEY',
+];
+
+/**
+ * Sanitized environment for daemon children: the existing scrubEnv allowlist (which already
+ * drops every secret-looking name) plus the daemon markers, with the named provider
+ * credentials deleted explicitly as defense in depth.
+ */
+export function daemonEnv(
+  env: NodeJS.ProcessEnv,
+  opts: { passthrough?: readonly string[]; set?: Record<string, string> } = {},
+): Record<string, string> {
+  const scrubbed = scrubEnv(env, {
+    ...(opts.passthrough !== undefined ? { passthrough: opts.passthrough } : {}),
+    set: { OMNEXX_SANDBOX: '1', CI: 'true', ...opts.set },
+  });
+  const out: Record<string, string> = {};
+  for (const [key, value] of Object.entries(scrubbed)) {
+    if (!STRIPPED_ENV.includes(key)) out[key] = value;
+  }
+  return out;
+}
+
+// ---------------------------------------------------------------------------
+// Dependency supply-chain
+// ---------------------------------------------------------------------------
+
+export interface PackageAgeCheck {
+  pkg: string;
+  version: string;
+  publishedAt?: string | undefined;
+  ageDays?: number | undefined;
+  ok: boolean;
+  reason?: string | undefined;
+}
+
+/**
+ * Minimum publish age (default 7 days): a version published more recently than that is
+ * too fresh to trust for an unattended install.
+ */
+export async function checkPackagePublishAge(
+  pkg: string,
+  version: string,
+  minAgeDays = 7,
+  now: number = Date.now(),
+): Promise<PackageAgeCheck> {
+  const r = await execa('npm', ['view', `${pkg}@${version}`, 'time', '--json'], {
+    reject: false,
+  }).catch((err: unknown) => ({ stdout: '', stderr: (err as Error).message, exitCode: -1 }));
+  if (r.exitCode !== 0 || !r.stdout.trim()) {
+    return {
+      pkg,
+      version,
+      ok: false,
+      reason: `npm view failed: ${r.stderr.slice(0, 200)}`,
+    };
+  }
+  let times: Record<string, string>;
+  try {
+    times = JSON.parse(r.stdout) as Record<string, string>;
+  } catch {
+    return { pkg, version, ok: false, reason: 'npm view returned unparsable JSON' };
+  }
+  const publishedAt = times[version];
+  if (!publishedAt) return { pkg, version, ok: false, reason: `version ${version} not on npm` };
+  const ageDays = (now - Date.parse(publishedAt)) / 86_400_000;
+  return {
+    pkg,
+    version,
+    publishedAt,
+    ageDays,
+    ok: ageDays >= minAgeDays,
+    ...(ageDays < minAgeDays
+      ? { reason: `published ${ageDays.toFixed(1)} days ago (< ${minAgeDays} day minimum)` }
+      : {}),
+  };
+}
+
+/**
+ * Install with scripts disabled throughout: resolve first (`--package-lock-only`), then a
+ * clean `npm ci`, both `--ignore-scripts` so a malicious postinstall cannot run.
+ */
+export async function installDepsLocked(cwd: string): Promise<{ ok: boolean; error?: string }> {
+  for (const args of [
+    ['install', '--ignore-scripts', '--package-lock-only'],
+    ['ci', '--ignore-scripts'],
+  ]) {
+    const r = await execa('npm', args, { cwd, reject: false, env: daemonEnv(process.env) }).catch(
+      (err: unknown) => ({ stdout: '', stderr: (err as Error).message, exitCode: -1 }),
+    );
+    if (r.exitCode !== 0) {
+      return {
+        ok: false,
+        error: `npm ${args.join(' ')} failed: ${r.stderr.slice(0, 300)}`,
+      };
+    }
+  }
+  return { ok: true };
+}
+
+export interface AuditDelta {
+  total: number;
+  baseline: number;
+  delta: number;
+  ok: boolean;
+}
+
+/**
+ * `npm audit` delta must be ≤ baseline: an install that adds vulnerabilities is refused.
+ * Returns `ok: false` with the delta when the audit itself cannot run.
+ */
+export async function auditDelta(cwd: string, baseline: number): Promise<AuditDelta> {
+  const r = await execa('npm', ['audit', '--json'], { cwd, reject: false }).catch(
+    (err: unknown) => ({ stdout: '', stderr: (err as Error).message, exitCode: -1 }),
+  );
+  if (!r.stdout.trim()) {
+    return { total: Number.NaN, baseline, delta: Number.NaN, ok: false };
+  }
+  let parsed: { metadata?: { vulnerabilities?: { total?: number } } };
+  try {
+    parsed = JSON.parse(r.stdout) as typeof parsed;
+  } catch {
+    return { total: Number.NaN, baseline, delta: Number.NaN, ok: false };
+  }
+  const total = parsed.metadata?.vulnerabilities?.total ?? 0;
+  return { total, baseline, delta: total - baseline, ok: total - baseline <= 0 };
+}
