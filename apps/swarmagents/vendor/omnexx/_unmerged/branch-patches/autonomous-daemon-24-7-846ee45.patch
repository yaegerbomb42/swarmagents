+  private booted = false;
+  private running = false;
+  private paused = false;
+  private readonly abortController = new AbortController();
+  private releaseLock: (() => Promise<void>) | undefined;
+  private loopDone: Promise<void> | undefined;
+  private readonly watchdog: WatchdogMonitor;
+  private readonly onSignal: () => void;
+
+  constructor(options: AutonomousDaemonOptions) {
+    this.repoRoot = options.repoRoot;
+    this.daemonDir = options.daemonDir ?? join(options.repoRoot, '.omnexx');
+    this.controlPath = options.controlPath;
+    this.store = options.store;
+    this.clock = options.clock ?? realClock;
+    this.discovery = options.discovery;
+    this.triage = options.triage;
+    this.planner = options.planner;
+    this.executor = options.executor;
+    this.verifier = options.verifier;
+    this.shipper = options.shipper;
+    this.worktrees = options.worktrees;
+    this.budget = options.budget;
+    this.qualityRatchet = options.qualityRatchet;
+    this.logger = options.logger ?? console;
+    this.onStateChange = options.onStateChange;
+    this.maxTurnsPerTask = options.maxTurnsPerTask ?? 25;
+    this.idleSleepBaseMs = options.idleSleepBaseMs ?? 60_000;
+    this.idleSleepMaxMs = options.idleSleepMaxMs ?? 3_600_000;
+    this.headPollMs = options.headPollMs ?? 10_000;
+    this.watchdogStallMs = options.watchdogStallMs ?? 300_000;
+    this.staleLeaseMs = options.staleLeaseMs ?? 1_800_000;
+    this.watchdog = new WatchdogMonitor({
+      stallMs: this.watchdogStallMs,
+      onStall: async (info) => {
+        this.logger.error(
+          `[daemon] watchdog: no progress for ${Math.round(info.stalledForMs / 1000)}s` +
+            (info.taskId ? ` on ${info.taskId}` : '') +
+            ' — aborting task, quarantining, forcing IDLE',
+        );
+        // Abort the current task's breaker, NOT the daemon's main controller:
+        // a stall forces IDLE, it does not stop the daemon.
+        this.currentBreaker?.abort('watchdog stall');
+        if (info.taskId) {
+          const task = this.currentTask?.taskId === info.taskId ? this.currentTask : undefined;
+          if (task) await this.quarantineTask(task, 'watchdog_stall');
+        }
+        this.transition('idle');
+      },
+    });
+    this.onSignal = () => {
+      this.logger.log('[daemon] signal received, stopping gracefully…');
+      void this.stop();
+    };
+  }
+
+  get currentState(): DaemonState {
+    return this.state;
+  }
+
+  get task(): QueuedTask | undefined {
+    return this.currentTask;
+  }
+
+  get isPaused(): boolean {
+    return this.paused;
+  }
+
+  get isRunning(): boolean {
+    return this.running;
+  }
+
+  // -------------------------------------------------------------------------
+  // boot(): 4-step crash-recovery reconciliation
+  // -------------------------------------------------------------------------
+
+  async boot(): Promise<void> {
+    if (this.booted) return;
+    await mkdir(this.daemonDir, { recursive: true });
+    const bootId = await readBootId();
+
+    // 1. Acquire the PID lock on .omnexx/daemon.lock (stale holder = reaped).
+    this.releaseLock = (await acquireDaemonLock(this.daemonDir, bootId, this.clock.now())).release;
+    await this.store.open();
+
+    const now = this.clock.now();
+
+    // 2. Reclaim stale leases (see reclaimStaleLeases for why this runs
+    //    here and at the top of every cycle, not just at boot).
+    this.reclaimStaleLeases(now);
+
+    // 3. Verify each active task's worktree tree-hash against its step journal:
+    //    resume if clean, reset to the last checkpoint if corrupt.
+    for (const status of ACTIVE_STATUSES) {
+      for (const task of this.store.listTasks(status)) {
+        if (!task.worktreePath) continue;
+        const steps = this.store.getSteps(task.taskId);
+        const last = steps[steps.length - 1];
+        const treeHash = await this.worktreeTreeHash(task.worktreePath);
+        if (treeHash === undefined) {
+          // Worktree dir is gone: requeue from scratch.
+          this.store.updateTaskStatus(task.taskId, 'QUEUED', { worktreePath: null });
+          this.logger.warn(`[daemon] worktree for ${task.taskId} is gone; requeued`);
+          continue;
+        }
+        if (last?.gitTreeHash == null || last.gitTreeHash === treeHash) continue; // clean
+        this.logger.warn(
+          `[daemon] worktree for ${task.taskId} diverged from step journal ` +
+            `(journal ${last.gitTreeHash}, actual ${treeHash}); resetting to last checkpoint`,
+        );
+        if (this.worktrees && /^[0-9a-f]{40}$/.test(last.gitTreeHash)) {
+          await this.worktrees.resetToCheckpoint(task.taskId, last.gitTreeHash);
+          this.store.recordStep(task.taskId, {
+            phase: 'idle',
+            gitTreeHash: last.gitTreeHash,
+            errorSignature: 'worktree reset to last checkpoint tree',
+          });
+        } else {
+          // No checkpoint tree to trust: requeue from scratch.
+          this.store.updateTaskStatus(task.taskId, 'QUEUED', { worktreePath: null });
+          this.store.recordStep(task.taskId, {
+            phase: 'idle',
+            errorSignature: 'worktree corrupt with no checkpoint; requeued',
+          });
+        }
+      }
+    }
+
+    // 4. Prune done_set: drop entries whose target blobs have changed since
+    //    the task shipped (the recorded work is stale; a similar finding may
+    //    legitimately recur). Entries with no target files are never pruned.
+    let pruned = 0;
+    for (const entry of this.store.listDone()) {
+      const { changed } = blobsChanged(this.repoRoot, entry.fingerprint, entry.targetBlobHashes);
+      if (changed) {
+        this.store.deleteDone(entry.fingerprint);
+        pruned++;
+      }
+    }
+    this.logger.log(`[daemon] boot step 4: pruned ${pruned} stale done_set entries`);
+
+    this.lastHead = await this.currentHead();
+    this.booted = true;
+    this.logger.log('[daemon] boot reconciliation complete');
+  }
+
+  /**
+   * Stale-lease reclaim: tasks stuck in PLANNING / IMPLEMENTING / VERIFYING
+   * with no update for longer than the lease go back to QUEUED.
+   *
+   * Why this runs at the top of every cycle as well as at boot: reclaim used
+   * to be boot-only, so a task orphaned while the daemon stayed alive — the
+   * ship-failure case, where the daemon moved on to the next task and left
+   * the previous one in VERIFYING — was never reclaimed until the next
+   * restart, however long the daemon ran. At a cycle boundary no task is in
+   * flight (`processTask` is awaited inside `runCycle`), so any ACTIVE task
+   * seen here is necessarily orphaned.
+   *
+   * Staleness is judged by `updatedAtMs`, which the store stamps only on a
+   * status transition — step-journal writes do NOT bump it, so a task goes
+   * stale 30 min after it entered its phase. That also means a phase that
+   * legitimately runs long looks stale by the clock; what protects it is
+   * that reclaim only fires at a cycle boundary, never mid-task, so a live
+   * IMPLEMENT/VERIFY is never interrupted by it.
+   */
+  private reclaimStaleLeases(nowMs: number, context = 'boot'): void {
+    for (const status of ACTIVE_STATUSES) {
+      for (const task of this.store.listTasks(status)) {
+        if (nowMs - task.updatedAtMs > this.staleLeaseMs) {
+          this.store.updateTaskStatus(task.taskId, 'QUEUED');
+          this.store.recordStep(task.taskId, {
+            phase: 'idle',
+            errorSignature: `stale lease reclaimed on ${context}`,
+          });
+          this.logger.log(`[daemon] reclaimed stale lease on ${task.taskId}`);
+        }
+      }
+    }
+  }
+
+  // -------------------------------------------------------------------------
+  // start / stop / pause / resume
+  // -------------------------------------------------------------------------
+
+  /**
+   * Main loop: one task per cycle until stopped. `maxCycles` bounds the loop
+   * (smoke tests / dry runs); omitted means run forever. Resolves when the
+   * loop exits.
+   */
+  async start(options: { maxCycles?: number } = {}): Promise<void> {
+    if (this.running) return this.loopDone ?? Promise.resolve();
+    await this.boot();
+    this.running = true;
+    this.watchdog.start();
+    process.once('SIGINT', this.onSignal);
+    process.once('SIGTERM', this.onSignal);
+    this.loopDone = (async () => {
+      let cycles = 0;
+      try {
+        while (
+          !this.abortController.signal.aborted &&
+          (options.maxCycles === undefined || cycles < options.maxCycles)
+        ) {
+          if (this.paused) {
+            // Control-file polling: a `resume`/`stop` written while paused
+            // takes effect here even if SIGCONT/SIGTERM never arrived.
+            const action = this.readControlAction();
+            if (action === 'resume') {
+              this.resume();
+            } else if (action === 'stop') {
+              this.abortController.abort(new Error('daemon stop requested via control file'));
+            } else {
+              await this.clock.sleep(1000, this.abortController.signal).catch(() => undefined);
+            }
+            continue;
+          }
+          await this.runCycle();
+          cycles++;
+        }
+      } catch (err) {
+        if (!this.abortController.signal.aborted) {
+          this.logger.error(`[daemon] cycle failed: ${(err as Error).message}`);
+        }
+      } finally {
+        this.running = false;
+        await this.shutdown();
+      }
+    })();
+    return this.loopDone;
+  }
+
+  async stop(): Promise<void> {
+    if (!this.abortController.signal.aborted) this.abortController.abort(new Error('daemon stop'));
+    await this.loopDone?.catch(() => undefined);
+    // Release the lock even if start() was never called (boot() alone holds it).
+    if (this.running || this.releaseLock) await this.shutdown();
+  }
+
+  /** Pause at the next cycle boundary, checkpointing the current task. */
+  pause(): void {
+    this.paused = true;
+    if (this.currentTask) {
+      try {
+        this.store.recordStep(this.currentTask.taskId, {
+          phase: this.state,
+          errorSignature: 'paused by operator',
+        });
+      } catch {
+        // Best effort checkpoint.
+      }
+    }
+    this.logger.log('[daemon] paused');
+  }
+
+  resume(): void {
+    this.paused = false;
+    this.logger.log('[daemon] resumed');
+  }
+
+  private async shutdown(): Promise<void> {
+    process.removeListener('SIGINT', this.onSignal);
+    process.removeListener('SIGTERM', this.onSignal);
+    this.watchdog.stop();
+    if (this.currentTask) {
+      try {
+        this.store.recordStep(this.currentTask.taskId, {
+          phase: this.state,
+          errorSignature: 'daemon shutdown',
+        });
+      } catch {
+        // Best effort checkpoint.
+      }
+    }
+    await this.releaseLock?.().catch(() => undefined);
+    this.releaseLock = undefined;
+    try {
+      this.store.close();
+    } catch {
+      // Store already closed.
+    }
+    this.booted = false;
+    this.logger.log('[daemon] stopped');
+  }
+
+  // -------------------------------------------------------------------------
+  // One cycle: IDLE → DISCOVER → TRIAGE → (one task through the pipeline)
+  // -------------------------------------------------------------------------
+
+  async runCycle(): Promise<void> {
+    this.transition('idle');
+
+    // Reclaim orphans left by an earlier cycle (e.g. a crash between cycles
+    // or a task the daemon abandoned) before picking up new work. Skipped
+    // while a task is in flight — runCycle is only re-entered between tasks,
+    // so currentTask is normally undefined here; the guard is belt-and-braces
+    // against a concurrent caller reclaiming the live task.
+    if (!this.currentTask) this.reclaimStaleLeases(this.clock.now(), 'cycle');
+
+    // Budget windows gate everything: outside a window we park in BUDGET_PAUSE.
+    if (this.budget) {
+      const check = await this.budget.check(this.clock.now());
+      if (!check.ok) {
+        this.transition('budget_pause');
+        this.logger.log(`[daemon] budget pause: ${check.reason ?? 'outside budget window'}`);
+        await this.clock
+          .sleep(this.idleSleepBaseMs, this.abortController.signal)
+          .catch(() => undefined);
+        return;
+      }
+    }
+
+    const task = this.store.popNextTask() ?? (await this.discoverAndTriage());
+    if (!task) {
+      // Empty queue: back to IDLE, then adaptive backoff, waking early on HEAD.
+      this.transition('idle');
+      this.emptyStreak++;
+      const sleepMs = Math.min(this.idleSleepMaxMs, this.idleSleepBaseMs * 2 ** this.emptyStreak);
+      this.logger.log(
+        `[daemon] queue empty, sleeping ${Math.round(sleepMs / 1000)}s (streak ${this.emptyStreak})`,
+      );
+      await this.sleepWithHeadWatch(sleepMs);
+      return;
+    }
+    this.emptyStreak = 0;
+    await this.processTask(task);
+  }
+
+  /**
+   * DISCOVER → TRIAGE: zero LLM tokens. Collectors run, each finding is
+   * triaged (triage enqueues admitted tasks itself), and the next queued
+   * task is returned, if any.
+   */
+  private async discoverAndTriage(): Promise<QueuedTask | null> {
+    if (!this.discovery) return null;
+    this.transition('discover');
+    const { findings, errors } = await this.discovery.collect(this.repoRoot);
+    for (const [collector, error] of Object.entries(errors)) {
+      this.logger.warn(`[daemon] discovery collector ${collector} failed: ${error}`);
+    }
+    if (findings.length === 0) return null;
+    this.transition('triage');
+    if (!this.triage) {
+      this.logger.warn('[daemon] no triage engine injected; findings dropped');
+      return null;
+    }
+    let admitted = 0;
+    for (const finding of findings) {
+      const decision = this.triage.triageFinding(adaptFinding(finding));
+      if (decision.decision === 'admitted') admitted++;
+    }
+    this.logger.log(`[daemon] triage: ${admitted}/${findings.length} findings admitted`);
+    return this.store.popNextTask();
+  }
+
+  // -------------------------------------------------------------------------
+  // One task through PLAN → IMPLEMENT → VERIFY → SHIP → LEARN
+  // -------------------------------------------------------------------------
+
+  private async processTask(task: QueuedTask): Promise<void> {
+    this.currentTask = task;
+    this.watchdog.noteProgress(task.taskId);
+    try {
+      const plan = await this.planTask(task);
+      const worktree = await this.prepareWorktree(task);
+      // IMPLEMENT → VERIFY loop: a REPAIR verdict sends the task back to
+      // IMPLEMENT with the verification diagnostics as the opening nudge, up
+      // to MAX_REPAIR_ROUNDS (the pipeline FAILs at that round, which ends
+      // the loop via quarantine). Each repair round gets its own 25-turn
+      // circuit-breaker budget; the 30-min wall-clock lease still bounds the
+      // task as a whole.
+      let repairRound = 0;
+      let repairNudge: string | undefined;
+      let revertProof = false;
+      for (;;) {
+        const implemented = await this.implementTask(task, plan, worktree, repairNudge);
+        if (!implemented) return; // tripped / quarantined inside IMPLEMENT.
+        const verification = await this.verifyTask(task, worktree, repairRound);
+        if (verification.outcome === 'PASS') {
+          revertProof = verification.revertProof;
+          break;
+        }
+        if (verification.outcome === 'FAIL') return; // quarantined inside VERIFY.
+        repairRound++;
+        repairNudge =
+          `Verification failed (repair round ${repairRound} of ${MAX_REPAIR_ROUNDS}): ` +
+          verification.diagnostics.join('; ');
+      }
+      const shipResult = await this.shipTask(task, plan, worktree, revertProof);
+      if (!shipResult) return;
+      await this.learnTask(task, plan, worktree, shipResult);
+    } catch (err) {
+      const message = err instanceof Error ? err.message : String(err);
+      this.logger.error(`[daemon] task ${task.taskId} failed: ${message}`);
+      try {
+        this.store.recordStep(task.taskId, {
+          phase: this.state,
+          errorSignature: message.slice(0, 500),
+        });
+      } catch {
+        // Best effort.
+      }
+      if (message.includes('not configured')) {
+        // Missing collaborator (planner/verifier/shipper): a config problem,
+        // not a task failure. Leave the task in place and fail closed.
+        await this.releaseWorktree(task).catch(() => undefined);
+        this.transition('idle', task.taskId);
+      } else {
+        // Genuine task failure (guardrail throw, infra error, ...): tombstone
+        // it instead of leaving it stuck in PLANNING/IMPLEMENTING forever.
+        await this.quarantineTask(task, 'task_error');
+      }
+    } finally {
+      this.currentTask = undefined;
+      this.quarantinedTaskIds.delete(task.taskId);
+      this.watchdog.clearTask();
+    }
+  }
+
+  /** PLAN: single-turn Architect prompt producing a bounded TaskExecutionPlan. */
+  private async planTask(task: QueuedTask): Promise<TaskExecutionPlan> {
+    this.transition('plan', task.taskId);
+    const planner = this.planner;
+    if (!planner) {
+      throw new Error('autonomous daemon: Architect planner is not configured');
+    }
+    const raw = await planner.plan(task);
+    const plan = boundPlan(raw);
+    if (!plan.verificationCommand.trim()) {
+      throw new Error(`plan for ${task.taskId} has no verification command`);
+    }
+    if (plan.filesToTouch.length < raw.filesToTouch.length) {
+      this.logger.warn(
+        `[daemon] plan for ${task.taskId} clamped from ${raw.filesToTouch.length} to ${MAX_PLAN_FILES} files`,
+      );
+    }
+    this.store.recordStep(task.taskId, {
+      phase: 'plan',
+      errorSignature:
+        `plan: ${plan.summary} (${plan.filesToTouch.length} files, ${plan.subSteps.length} steps)`.slice(
+          0,
+          500,
+        ),
+    });
+    return plan;
+  }
+
+  /**
+   * Create the task worktree and record the baseline QualityRatchet metrics in
+   * it. Falls back to working in place (repoRoot) until a worktree manager is
+   * injected.
+   */
+  private async prepareWorktree(task: QueuedTask): Promise<string> {
+    const baseSha = task.baseCommitSha ?? (await this.currentHead()) ?? 'HEAD';
+    const worktree = this.worktrees
+      ? (await this.worktrees.create(task.taskId, baseSha)).path
+      : this.repoRoot;
+    if (this.worktrees) {
+      this.store.updateTaskStatus(task.taskId, 'IMPLEMENTING', { worktreePath: worktree });
+      // The in-memory task is the snapshot popNextTask() returned: the DB row
+      // now knows the worktree, but this object does not. The executor reads
+      // task.worktreePath to root its tools — without this assignment it
+      // would edit the main repo instead of the worktree.
+      task.worktreePath = worktree;
+    }
+    if (this.qualityRatchet) {
+      const baseline = await this.qualityRatchet.captureBaseline(worktree).catch((err: unknown) => {
+        this.logger.warn(
+          `[daemon] quality baseline failed: ${err instanceof Error ? err.message : String(err)}`,
+        );
+        return undefined;
+      });
+      if (baseline) {
+        this.store.recordStep(task.taskId, {
+          phase: 'plan',
+          errorSignature:
+            `baseline: ${baseline.testSuiteDurationMs}ms suite, ${baseline.lintErrorCount} lint errors`.slice(
+              0,
+              500,
+            ),
+        });
+      }
+    }
+    return worktree;
+  }
+
+  /**
+   * IMPLEMENT: bounded coding loop (max 25 turns) inside the task worktree.
+   * Every tool call is checkpointed to the step journal; the circuit breaker is
+   * evaluated after every turn. Returns true on success, false when the task
+   * tripped and was quarantined.
+   */
+  private async implementTask(
+    task: QueuedTask,
+    plan: TaskExecutionPlan,
+    worktree: string,
+    initialNudge?: string,
+  ): Promise<boolean> {
+    this.transition('implement', task.taskId);
+    const breaker = new TaskCircuitBreaker({
+      maxTurnsPerTask: this.maxTurnsPerTask,
+      onTrip: (trip) => {
+        this.logger.warn(`[daemon] circuit breaker tripped on ${task.taskId}: ${trip.reason}`);
+      },
+    });
+    breaker.beginTask();
+    this.currentBreaker = breaker;
+    const executor = this.executor;
+    if (!executor) {
+      throw new Error('autonomous daemon: task executor is not configured');
+    }
+    let pendingNudge: string | undefined = initialNudge;
+    let done = false;
+    try {
+      for (let turn = 1; turn <= this.maxTurnsPerTask; turn++) {
+        if (breaker.signal.aborted) break;
+        const result = await executor.executeTurn(
+          task,
+          plan,
+          turn,
+          breaker.signal,
+          (call) => {
+            // Checkpoint every tool call to the step journal.
+            const step: {
+              phase: string;
+              toolName: string;
+              errorSignature?: string;
+            } = { phase: 'implement', toolName: call.toolName };
+            if (call.errorContent !== undefined) {
+              step.errorSignature = call.errorContent.slice(0, 500);
+            }
+            this.store.recordStep(task.taskId, step);
+            this.watchdog.noteProgress(task.taskId);
+          },
+          pendingNudge,
+        );
+        if (result.childPgid !== undefined) {
+          this.watchdog.registerChildProcessGroup(result.childPgid, task.taskId);
+        }
+        // Checkpoint the turn's tree state (also the boot-reconciliation anchor).
+        const treeHash =
+          result.treeHash ??
+          (result.mutatedFiles.length > 0 ? await this.worktreeTreeHash(worktree) : undefined);
+        const step: {
+          phase: string;
+          gitTreeHash?: string;
+          errorSignature?: string;
+        } = { phase: 'implement' };
+        if (treeHash !== undefined) step.gitTreeHash = treeHash;
+        step.errorSignature = `turn ${turn} complete${result.done ? ' (done)' : ''}`;
+        this.store.recordStep(task.taskId, step);
+        this.watchdog.noteProgress(task.taskId);
+
+        const evaluation = breaker.evaluateTurn({
+          done: result.done,
+          isReadOnly: result.isReadOnly,
+          toolName: result.error?.toolName,
+          inputSummary: result.error?.inputSummary,
+          errorContent: result.error?.message,
+          treeHash,
+        });
+        pendingNudge = evaluation.nudge;
+        if (evaluation.trip) {
+          await this.quarantineTask(task, evaluation.trip.reason, evaluation.trip);
+          return false;
+        }
+        if (result.done) {
+          done = true;
+          break;
+        }
+      }
+    } finally {
+      breaker.endTask();
+      if (this.currentBreaker === breaker) this.currentBreaker = undefined;
+    }
+    if (!done) {
+      // Daemon stopping: don't quarantine, just hand back to the shutdown path.
+      if (this.abortController.signal.aborted) return false;
+      // Loop exhausted without done and without a trip (e.g. executor stopped
+      // returning): treat as a turn-ceiling trip.
+      await this.quarantineTask(task, 'turn_ceiling');
+      return false;
+    }
+    return true;
+  }
+
+  /**
+   * VERIFY: verification pipeline (fail-closed when not configured). Returns
+   * the pipeline outcome: PASS (with whether Stage 3 proved the fix),
+   * REPAIR (diagnostics for the next IMPLEMENT round), or FAIL (the task was
+   * quarantined here).
+   */
+  private async verifyTask(
+    task: QueuedTask,
+    worktree: string,
+    repairRound = 0,
+  ): Promise<{ outcome: VerificationOutcome; revertProof: boolean; diagnostics: string[] }> {
+    this.transition('verify', task.taskId);
+    if (!this.verifier) {
+      this.store.recordStep(task.taskId, {
+        phase: 'verify',
+        errorSignature: 'verification failed: no verification pipeline configured',
+      });
+      await this.releaseWorktree(task);
+      this.transition('idle', task.taskId);
+      return { outcome: 'FAIL', revertProof: false, diagnostics: ['no verification pipeline'] };
+    }
+    const kind = FINDING_KIND_TO_VERIFICATION_KIND[findingKindOf(task)];
+    const verificationTask: {
+      id: string;
+      title: string;
+      kind: VerificationTaskKind;
+      finding?: string;
+    } = {
+      id: task.taskId,
+      title: `${task.sourceCollector}:${task.fingerprint.slice(0, 12)}`,
+      kind,
+    };
+    if (typeof task.findingPayload === 'string') {
+      verificationTask.finding = task.findingPayload;
+    }
+    const result = await this.verifier.verify(verificationTask, worktree, { repairRound });
+    this.store.recordStep(task.taskId, {
+      phase: 'verify',
+      errorSignature:
+        `verification ${result.outcome} (round ${repairRound})` +
+        (result.diagnostics.length > 0 ? `: ${result.diagnostics[0]}` : ''),
+    });
+    if (result.outcome === 'REPAIR') {
+      // Not a failure yet: the caller sends the task back to IMPLEMENT with
+      // these diagnostics as the repair nudge.
+      return { outcome: 'REPAIR', revertProof: false, diagnostics: result.diagnostics };
+    }
+    if (result.outcome !== 'PASS') {
+      // FAIL (after the pipeline's repair rounds): a genuine task failure.
+      // Tombstone it so it is never silently stuck in VERIFYING and never
+      // retried until the cooldown lapses.
+      await this.quarantineTask(task, 'verify_failed');
+      return { outcome: 'FAIL', revertProof: false, diagnostics: result.diagnostics };
+    }
+    if (result.bloatNeedsHumanReview) {
+      // PASS still holds, but the daemon must not auto-merge a bloated diff.
+      this.store.recordStep(task.taskId, {
+        phase: 'verify',
+        errorSignature: 'bloat cap tripped: needs human review, not auto-shipping',
+      });
+      await this.quarantineTask(task, 'verify_bloat');
+      return { outcome: 'FAIL', revertProof: false, diagnostics: result.diagnostics };
+    }
+    const revertProof = result.stages.some((s) => s.stage === 3 && s.status === 'pass');
+    return { outcome: 'PASS', revertProof, diagnostics: result.diagnostics };
+  }
+
+  /**
+   * SHIP: shipping controller (fail-closed when not configured). Commits the
+   * worktree first (the shipper pushes HEAD, so uncommitted edits would
+   * never leave the machine), then ships. Returns the ship completion, or
+   * undefined when the task did not ship.
+   *
+   * The three ship outcomes are handled explicitly — the old code treated
+   * "no PR URL" as "not shipped" and returned undefined, which left the
+   * task stuck in VERIFYING while the daemon moved on to the next task:
+   * - merged / PR created: normal completion, `deliveryMode: 'auto'`.
+   * - branch pushed but PR creation failed: the work IS shipped (branch on
+   *   the remote, PR body on disk, review-queue entry written by the
+   *   shipper). The task is marked done-with-caveat
+   *   (`deliveryMode: 'auto:branch-only'`, branch + prBodyPath recorded in
+   *   the step journal) so it never sits in VERIFYING and is never
+   *   re-proposed — a human still has to open the PR by hand.
+   * - branch push itself failed: nothing reached the remote. The task is
+   *   quarantined (tombstoned, visible in `queue --include-tombstones`),
+   *   not orphaned.
+   * Every path records the task's terminal state durably (markDone /
+   * tombstone) before this returns, so the daemon never picks up the next
+   * task with the current one still unresolved.
+   */
+  private async shipTask(
+    task: QueuedTask,
+    plan: TaskExecutionPlan,
+    worktree: string,
+    revertProof: boolean,
+  ): Promise<ShipCompletion | undefined> {
+    this.transition('ship', task.taskId);
+    if (!this.shipper) {
+      this.store.recordStep(task.taskId, {
+        phase: 'ship',
+        errorSignature: 'ship failed: no shipping controller configured',
+      });
+      await this.releaseWorktree(task);
+      this.transition('idle', task.taskId);
+      return undefined;
+    }
+    const baseSha = task.baseCommitSha ?? (await this.currentHead()) ?? 'HEAD';
+    const stats = await collectChangeStats(worktree, baseSha);
+    if (this.worktrees) {
+      try {
+        await this.worktrees.commit(
+          task.taskId,
+          `daemon: ${task.sourceCollector}:${task.fingerprint.slice(0, 12)}`,
+        );
+      } catch (err) {
+        // Nothing to commit: verification passed on an empty diff (e.g. the
+        // finding was already fixed). Nothing shippable — quarantine so the
+        // task is visible and tombstoned instead of silently stuck.
+        this.logger.warn(
+          `[daemon] task ${task.taskId} has nothing to ship: ${err instanceof Error ? err.message : String(err)}`,
+        );
+        await this.quarantineTask(task, 'empty_diff');
+        return undefined;
+      }
+    }
+    const result = await this.shipper.ship({
+      ...stats,
+      category: FINDING_KIND_TO_CHANGE_CATEGORY[findingKindOf(task)],
+      revertProof,
+      taskId: task.taskId,
+      worktreePath: worktree,
+      baseSha,
+      title: `${task.sourceCollector}:${task.fingerprint.slice(0, 12)}`,
+      verificationReceipt: `verification: ${plan.verificationCommand}`,
+    });
+    // Shipped commit: the worktree HEAD at ship time (merge commit / PR head).
+    const shippedCommitSha = (await this.currentHead(worktree)) ?? baseSha;
+    this.store.recordStep(task.taskId, {
+      phase: 'ship',
+      errorSignature:
+        `ship ${result.outcome} tier ${result.tier} risk ${result.riskScore} branch ${result.branch}` +
+        (result.prUrl ? ` PR ${result.prUrl}` : '') +
+        (result.prBodyPath ? ` pr-body ${result.prBodyPath}` : '') +
+        (result.note ? ` (${result.note})` : ''),
+    });
+    switch (result.outcome) {
+      case 'merged':
+      case 'pr_created':
+        return { shippedCommitSha, deliveryMode: 'auto', branch: result.branch };
+      case 'branch_pushed_pr_failed':
+        // Branch is on the remote and the review queue already holds the
+        // entry; only the PR is missing. Done-with-caveat, not VERIFYING.
+        this.logger.warn(
+          `[daemon] task ${task.taskId} shipped branch ${result.branch} but no PR was opened` +
+            (result.prBodyPath ? `; PR body at ${result.prBodyPath}` : '') +
+            ' — marking done (branch-only)',
+        );
+        return {
+          shippedCommitSha,
+          deliveryMode: 'auto:branch-only',
+          branch: result.branch,
+          ...(result.prBodyPath ? { prBodyPath: result.prBodyPath } : {}),
+        };
+      case 'push_failed':
+        // Nothing reached the remote; the PR body is on disk for a human.
+        // Quarantine so the failure is visible instead of orphaned.
+        await this.quarantineTask(
+          task,
+          `ship_push_failed: ${result.note ?? 'branch push failed'}`.slice(0, 500),
+        );
+        return undefined;
+    }
+  }
+
+  /**
+   * LEARN: ≤150-token episodic outcome to learned_patterns, then destroy the
+   * task context, release the worktree, and mark the task done. The
+   * delivery mode carries the ship caveat: a branch-only ship is done, but
+   * the outcome text says so and names the branch and PR-body path.
+   */
+  private async learnTask(
+    task: QueuedTask,
+    plan: TaskExecutionPlan,
+    worktree: string,
+    ship: ShipCompletion,
+  ): Promise<void> {
+    this.transition('learn', task.taskId);
+    const shippedCommitSha = ship.shippedCommitSha;
+    const caveat =
+      ship.deliveryMode === 'auto:branch-only'
+        ? ` Shipped branch-only on ${ship.branch} (no PR opened` +
+          (ship.prBodyPath ? `; PR body at ${ship.prBodyPath}` : '') +
+          ').'
+        : '';
+    const outcome = [
+      `Task ${task.sourceCollector}:${task.fingerprint.slice(0, 12)} shipped.`,
+      `Plan touched ${plan.filesToTouch.length} file(s); verification: ${plan.verificationCommand}.`,
+      `Outcome: shipped as ${shippedCommitSha.slice(0, 12)}.${caveat}`,
+    ].join(' ');
+    // ≤150 tokens ≈ ≤600 chars (the store also caps the summary length).
+    const capped = outcome.length > 600 ? `${outcome.slice(0, 597)}…` : outcome;
+    this.store.recordPattern({
+      scopeGlob: '**',
+      patternType: 'INVARIANT',
+      ruleSummary: capped,
+      confidence: 0.7,
+      createdFromTaskId: task.taskId,
+    });
+    await Promise.resolve(this.executor?.disposeTaskContext?.(task.taskId)).catch(() => undefined);
+    await this.releaseWorktree(task);
+    this.store.markDone(task.taskId, {
+      shippedCommitSha,
+      deliveryMode: ship.deliveryMode,
+      targetBlobHashes: await this.blobHashesForFiles(worktree, plan.filesToTouch),
+    });
+    this.store.recordStep(task.taskId, { phase: 'learn', errorSignature: 'learned + done' });
+    this.transition('idle', task.taskId);
+    this.logger.log(
+      `[daemon] task ${task.taskId} done (${worktree})` +
+        (caveat ? ` — branch-only ship on ${ship.branch}` : ''),
+    );
+  }
+
+  // -------------------------------------------------------------------------
+  // Quarantine / helpers
+  // -------------------------------------------------------------------------
+
+  /**
+   * Trip → quarantine: tombstone by fingerprint (the store's strike ladder
+   * governs the cooldown), release the worktree, IDLE.
+   */
+  private async quarantineTask(
+    task: QueuedTask,
+    reason: string,
+    trip?: CircuitTrip,
+  ): Promise<void> {
+    // The watchdog and the IMPLEMENT loop can both observe the same trip.
+    if (this.quarantinedTaskIds.has(task.taskId)) return;
+    this.quarantinedTaskIds.add(task.taskId);
+    const treeHash = task.worktreePath ? await this.worktreeTreeHash(task.worktreePath) : undefined;
+    try {
+      const failure: {
+        failureStage: DaemonState;
+        failureReason: string;
+        lastDiffHash?: string;
+        targetBlobHashes: Record<string, string>;
+      } = {
+        failureStage: this.state,
+        failureReason: trip ? `${reason}: ${trip.detail}` : reason,
+        targetBlobHashes: task.worktreePath
+          ? await this.blobHashesForFiles(task.worktreePath, task.targetFiles)
+          : {},
+      };
+      if (treeHash !== undefined) failure.lastDiffHash = treeHash;
+      this.store.tombstone({
+        taskId: task.taskId,
+        fingerprint: task.fingerprint,
+        failure,
+      });
+    } catch (err) {
+      this.logger.error(`[daemon] tombstone failed for ${task.taskId}: ${(err as Error).message}`);
+    }
+    const tombstone = this.store.getTombstone(task.fingerprint);
+    try {
+      this.store.recordStep(task.taskId, {
+        phase: 'quarantine',
+        errorSignature:
+          `quarantined (strike ${tombstone?.strikeCount ?? '?'}, cooldown ` +
+          `${tombstone?.cooldownUntilMs === -1 ? 'permanent' : 'until ' + String(tombstone?.cooldownUntilMs ?? '?')})` +
+          `: ${reason}`,
+      });
+    } catch {
+      // The tombstone already deleted the task row; the step may fail. Best effort.
+    }
+    await this.releaseWorktree(task).catch(() => undefined);
+    this.transition('quarantine', task.taskId);
+    this.transition('idle', task.taskId);
+    this.logger.warn(`[daemon] task ${task.taskId} quarantined: ${reason}`);
+  }
+
+  private async releaseWorktree(task: QueuedTask): Promise<void> {
+    if (this.worktrees) await this.worktrees.destroy(task.taskId);
+    // Minimal stub (no worktree manager): work was done in place; nothing to release.
+  }
+
+  /** Blob SHAs of files in a worktree (done_set / tombstone target identity). */
+  private async blobHashesForFiles(
+    worktree: string,
+    files: readonly string[],
+  ): Promise<Record<string, string>> {
+    const hashes: Record<string, string> = {};
+    for (const file of files) {
+      const result = await git(worktree, ['hash-object', '--', file], { allowFailure: true });
+      if (result.exitCode === 0 && result.stdout.trim()) hashes[file] = result.stdout.trim();
+    }
+    return hashes;
+  }
+
+  /** `git write-tree` hash of a worktree; undefined when it is not a git tree. */
+  private async worktreeTreeHash(worktree: string): Promise<string | undefined> {
+    const result = await git(worktree, ['write-tree'], { allowFailure: true });
+    if (result.exitCode !== 0) return undefined;
+    return result.stdout.trim() || undefined;
+  }
+
+  private async currentHead(cwd: string = this.repoRoot): Promise<string | undefined> {
+    const result = await git(cwd, ['rev-parse', 'HEAD'], { allowFailure: true });
+    if (result.exitCode !== 0) return undefined;
+    return result.stdout.trim() || undefined;
+  }
+
+  /** Sleep in headPollMs chunks; wake early when git HEAD changes. */
+  private async sleepWithHeadWatch(totalMs: number): Promise<void> {
+    let remaining = totalMs;
+    while (remaining > 0 && !this.abortController.signal.aborted) {
+      const chunk = Math.min(remaining, this.headPollMs);
+      await this.clock.sleep(chunk, this.abortController.signal).catch(() => undefined);
+      remaining -= chunk;
+      // Control-file polling: a `pause` written while idling pauses at this
+      // boundary; a `stop` aborts the loop. Cheap (one small JSON read per
+      // chunk) and best-effort — an unreadable file just means "no intent".
+      const action = this.readControlAction();
+      if (action === 'pause') {
+        this.pause();
+        return;
+      }
+      if (action === 'stop') {
+        this.abortController.abort(new Error('daemon stop requested via control file'));
+        return;
+      }
+      const head = await this.currentHead();
+      if (head !== undefined && this.lastHead !== undefined && head !== this.lastHead) {
+        this.lastHead = head;
+        this.emptyStreak = 0;
+        this.logger.log('[daemon] new git HEAD detected, waking from IDLE');
+        return;
+      }
+      if (head !== undefined) this.lastHead = head;
+    }
+  }
+
+  /**
+   * Latest operator intent from the control file (`daemon pause|resume|stop`
+   * writes `{ action, ... }`), or null when no control path is configured or
+   * the file is missing/unreadable. Never throws: polling must not kill the loop.
+   */
+  private readControlAction(): 'pause' | 'resume' | 'stop' | null {
+    if (!this.controlPath) return null;
+    try {
+      const parsed: unknown = JSON.parse(readFileSync(this.controlPath, 'utf8'));
+      const action =
+        typeof parsed === 'object' && parsed !== null
+          ? (parsed as { action?: unknown }).action
+          : undefined;
+      return action === 'pause' || action === 'resume' || action === 'stop' ? action : null;
+    } catch {
+      return null;
+    }
+  }
+
+  private transition(to: DaemonState, taskId?: string): void {
+    const from = this.state;
+    if (from === to) return;
+    this.state = to;
+    const id = taskId ?? this.currentTask?.taskId;
+    if (id) {
+      const status = STATE_TO_TASK_STATUS[to];
+      if (status) {
+        try {
+          this.store.updateTaskStatus(id, status);
+        } catch {
+          // Task may already be tombstoned/done (row deleted); transition anyway.
+        }
+      }
+    }
+    this.watchdog.noteProgress(id);
+    this.onStateChange?.(from, to, id);
+    this.logger.log(`[daemon] ${from} → ${to}${id ? ` (${id})` : ''}`);
+  }
+}
diff --git a/src/autonomous/discovery/common.ts b/src/autonomous/discovery/common.ts
new file mode 100644
index 00000000..3cd76391
--- /dev/null
+++ b/src/autonomous/discovery/common.ts
@@ -0,0 +1,171 @@
+import { execa } from 'execa';
+import { existsSync } from 'node:fs';
+import { readFile } from 'node:fs/promises';
+import { join } from 'node:path';
+
+/** Result of a best-effort shell command: never throws, always reports what happened. */
+export interface CommandResult {
+  stdout: string;
+  stderr: string;
+  exitCode: number | null;
+  timedOut: boolean;
+}
+
+/**
+ * Run a command with a timeout. Returns a result object instead of throwing on
+ * non-zero exit or timeout so collectors can degrade gracefully.
+ *
+ * The child runs in its own process group (`detached: true`) and a timeout
+ * kills the WHOLE group with SIGKILL: tools like vitest spawn worker
+ * grandchildren that would otherwise survive a SIGTERM to the direct child,
+ * hold the stdio pipes open, and hang the caller forever.
+ */
+export async function runCommand(
+  command: string,
+  args: string[],
+  cwd: string,
+  timeoutMs: number,
+): Promise<CommandResult> {
+  let timedOut = false;
+  try {
+    const child = execa(command, args, {
+      cwd,
+      reject: false,
+      stdin: 'ignore',
+      maxBuffer: 64 * 1024 * 1024,
+      detached: true,
+    });
+    const timer = setTimeout(() => {
+      timedOut = true;
+      killProcessGroup(child);
+    }, timeoutMs);
+    timer.unref();
+    try {
+      const result = await child;
+      return {
+        stdout: result.stdout,
+        stderr: result.stderr,
+        exitCode: result.exitCode ?? null,
+        timedOut,
+      };
+    } finally {
+      clearTimeout(timer);
+    }
+  } catch (err) {
+    return { stdout: '', stderr: String(err), exitCode: null, timedOut };
+  }
+}
+
+/** SIGKILL the child's process group, falling back to the child itself. */
+function killProcessGroup(child: {
+  pid?: number;
+  kill: (signal: NodeJS.Signals) => boolean;
+}): void {
+  try {
+    if (child.pid !== undefined) process.kill(-child.pid, 'SIGKILL');
+  } catch {
+    // Process group already gone; fall through to killing the child directly.
+  }
+  try {
+    child.kill('SIGKILL');
+  } catch {
+    // Already dead.
+  }
+}
+
+/** Run a git command; returns trimmed stdout or '' on any failure. */
+export async function git(repoRoot: string, args: string[], timeoutMs = 30_000): Promise<string> {
+  const result = await runCommand('git', args, repoRoot, timeoutMs);
+  return result.exitCode === 0 ? result.stdout.trim() : '';
+}
+
+export function clamp01(value: number): number {
+  if (!Number.isFinite(value)) return 0;
+  return Math.min(1, Math.max(0, value));
+}
+
+/** Parse JSON without throwing; returns undefined on bad input. Callers cast the result. */
+export function safeJsonParse(text: string): unknown {
+  try {
+    return JSON.parse(text) as unknown;
+  } catch {
+    return undefined;
+  }
+}
+
+export async function readJsonFile<T>(path: string): Promise<T | undefined> {
+  try {
+    return safeJsonParse(await readFile(path, 'utf8')) as T | undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+export function fileExists(path: string): boolean {
+  try {
+    return existsSync(path);
+  } catch {
+    return false;
+  }
+}
+
+export function joinRoot(repoRoot: string, ...parts: string[]): string {
+  return join(repoRoot, ...parts);
+}
+
+/** Stable fingerprint for a finding, used for dedupe and self-repair attempt bounding. */
+export function fingerprint(parts: string[]): string {
+  return parts.join('|');
+}
+
+/**
+ * Files changed (tracked) in the working tree or index, relative to HEAD.
+ * Capped so a huge dirty tree can't blow up downstream work.
+ */
+export async function changedFiles(repoRoot: string, limit = 100): Promise<string[]> {
+  const out = await git(repoRoot, ['diff', '--name-only', 'HEAD']);
+  const staged = await git(repoRoot, ['diff', '--name-only', '--cached']);
+  const seen = new Set<string>();
+  for (const line of `${out}\n${staged}`.split('\n')) {
+    const file = line.trim();
+    if (file) seen.add(file);
+    if (seen.size >= limit) break;
+  }
+  return [...seen];
+}
+
+/** Parse `git log --numstat` output into per-file churn (added + deleted lines). */
+export function parseNumstat(output: string): Map<string, number> {
+  const churn = new Map<string, number>();
+  for (const line of output.split('\n')) {
+    const match = /^(\d+|-)\t(\d+|-)\t(.+)$/.exec(line);
+    if (!match) continue;
+    const added = match[1] === '-' ? 0 : Number(match[1]);
+    const deleted = match[2] === '-' ? 0 : Number(match[2]);
+    const file = match[3] as string;
+    churn.set(file, (churn.get(file) ?? 0) + added + deleted);
+  }
+  return churn;
+}
+
+/** Parse `git log --numstat` into per-file commit counts (how many commits touched each file). */
+export function parseNumstatCommits(output: string): Map<string, number> {
+  const counts = new Map<string, number>();
+  const seenInCommit = new Set<string>();
+  let inCommit = false;
+  for (const line of output.split('\n')) {
+    if (line.startsWith('commit ')) {
+      seenInCommit.clear();
+      inCommit = true;
+      continue;
+    }
+    if (!inCommit) continue;
+    const match = /^(?:\d+|-)\t(?:\d+|-)\t(.+)$/.exec(line);
+    if (!match) continue;
+    const file = match[1] as string;
+    if (seenInCommit.has(file)) continue;
+    seenInCommit.add(file);
+    counts.set(file, (counts.get(file) ?? 0) + 1);
+  }
+  return counts;
+}
diff --git a/src/autonomous/discovery/complexity.ts b/src/autonomous/discovery/complexity.ts
new file mode 100644
index 00000000..7f0aa4bb
--- /dev/null
+++ b/src/autonomous/discovery/complexity.ts
@@ -0,0 +1,237 @@
+import { readFile } from 'node:fs/promises';
+import { git, parseNumstatCommits, readJsonFile } from './common.js';
+import { makeFinding, type DiscoveryCollector, type RawFinding } from './index.js';
+
+interface CoverageFileSummary {
+  lines?: { pct?: number };
+}
+
+type CoverageSummary = Record<string, CoverageFileSummary | undefined>;
+
+/** Flag functions whose estimated cyclomatic complexity exceeds this. */
+const COMPLEXITY_LIMIT = 20;
+/** Flag files longer than this many lines. */
+const FILE_LENGTH_LIMIT = 600;
+/** Flag exact duplicate blocks of at least this many lines. */
+const CLONE_MIN_LINES = 10;
+/** Gate: only files touched in at least this many commits in the last 30 days. */
+const MIN_TOUCHES_30D = 3;
+/** Gate: only files with at least this line coverage (when coverage data exists). */
+const MIN_COVERAGE_PCT = 80;
+
+/**
+ * Heuristic complexity scan. ts-morph is NOT a dependency of this repo, so
+ * this uses a lightweight regex + brace-matching fallback (noted on every
+ * finding): decision-token counting per function body, file length, and exact
+ * clone-block detection over normalized lines.
+ *
+ * Gate: only files modified ≥3 times in the last 30 days with ≥80% coverage
+ * are queued. When no coverage summary exists the coverage gate is skipped
+ * and the finding says so (`coverageUnknown: true`).
+ */
+export class ComplexityCollector implements DiscoveryCollector {
+  readonly name = 'complexity';
+
+  async collect(repoRoot: string): Promise<RawFinding[]> {
+    const findings: RawFinding[] = [];
+    const touchesLog = await git(repoRoot, [
+      'log',
+      '--since=30 days ago',
+      '--numstat',
+      '--format=commit %H',
+      '--',
+      'src',
+    ]);
+    const touches = parseNumstatCommits(touchesLog);
+    const gated = new Set<string>();
+    for (const [file, count] of touches) {
+      if (count >= MIN_TOUCHES_30D) gated.add(file);
+    }
+    if (gated.size === 0) return findings;
+
+    const summary = await readJsonFile<CoverageSummary>(
+      `${repoRoot}/coverage/coverage-summary.json`,
+    );
+    const coverageUnknown = !summary;
+
+    for (const file of gated) {
+      if (!/\.(?:ts|tsx)$/.test(file) || /test|spec/i.test(file)) continue;
+      if (summary) {
+        const pct = summary[file]?.lines?.pct;
+        if (pct !== undefined && pct < MIN_COVERAGE_PCT) continue;
+      }
+      let content: string;
+      try {
+        content = await readFile(`${repoRoot}/${file}`, 'utf8');
+      } catch {
+        continue;
+      }
+      findings.push(...this.scanFile(file, content, coverageUnknown));
+    }
+    findings.push(...(await this.scanClones(repoRoot, [...gated])));
+    return findings;
+  }
+
+  private scanFile(file: string, content: string, coverageUnknown: boolean): RawFinding[] {
+    const findings: RawFinding[] = [];
+    const lines = content.split('\n');
+    if (lines.length > FILE_LENGTH_LIMIT) {
+      findings.push(
+        makeFinding({
+          collector: this.name,
+          ruleOrTestId: `file-too-long:${file}`,
+          targetFiles: [file],
+          severity: 0.5,
+          confidence: 0.9,
+          verification: 0.6,
+          findingPayload: {
+            kind: 'file-too-long',
+            lines: lines.length,
+            limit: FILE_LENGTH_LIMIT,
+            analysis: 'heuristic-regex-fallback',
+            note: 'ts-morph is not a dependency; length measured by line count.',
+            coverageUnknown,
+          },
+        }),
+      );
+    }
+    for (const fn of extractFunctions(content)) {
+      const complexity = 1 + countDecisionTokens(fn.body);
+      if (complexity <= COMPLEXITY_LIMIT) continue;
+      findings.push(
+        makeFinding({
+          collector: this.name,
+          ruleOrTestId: `complex-function:${file}:${fn.name}`,
+          canonicalSymbol: fn.name,
+          targetFiles: [file],
+          severity: 0.55,
+          confidence: 0.7,
+          verification: 0.5,
+          findingPayload: {
+            kind: 'high-complexity',
+            function: fn.name,
+            estimatedComplexity: complexity,
+            limit: COMPLEXITY_LIMIT,
+            analysis: 'heuristic-regex-fallback',
+            note: 'ts-morph is not a dependency; complexity estimated by counting decision tokens (if/for/while/case/catch/&&/||/?:) in the function body.',
+            coverageUnknown,
+          },
+        }),
+      );
+    }
+    return findings;
+  }
+
+  /** Exact duplicate blocks (≥10 normalized lines) across gated files. */
+  private async scanClones(repoRoot: string, files: string[]): Promise<RawFinding[]> {
+    const findings: RawFinding[] = [];
+    const seen = new Map<string, { file: string; start: number }>();
+    for (const file of files) {
+      if (!/\.(?:ts|tsx)$/.test(file)) continue;
+      let content: string;
+      try {
+        content = await readFile(`${repoRoot}/${file}`, 'utf8');
+      } catch {
+        continue;
+      }
+      const normalized = content
+        .split('\n')
+        .map((line) => line.trim().replace(/\s+/g, ' '))
+        .filter((line) => line.length > 0 && !line.startsWith('//'));
+      for (let i = 0; i + CLONE_MIN_LINES <= normalized.length; i++) {
+        const block = normalized.slice(i, i + CLONE_MIN_LINES).join('\n');
+        const first = seen.get(block);
+        if (!first) {
+          seen.set(block, { file, start: i + 1 });
+          continue;
+        }
+        if (first.file === file) continue;
+        findings.push(
+          makeFinding({
+            collector: this.name,
+            ruleOrTestId: `clone-block:${first.file}:${file}`,
+            targetFiles: [first.file, file],
+            severity: 0.45,
+            confidence: 0.85,
+            verification: 0.6,
+            findingPayload: {
+              kind: 'clone-block',
+              lines: CLONE_MIN_LINES,
+              firstLocation: `${first.file}:${first.start}`,
+              secondLocation: `${file}:${i + 1}`,
+              analysis: 'heuristic-regex-fallback',
+            },
+          }),
+        );
+        // One clone finding per pair is enough; stop scanning this block further.
+        seen.delete(block);
+      }
+    }
+    return findings;
+  }
+}
+
+interface ExtractedFunction {
+  name: string;
+  body: string;
+}
+
+/** Best-effort function extraction: named functions, methods, and arrow functions with bodies. */
+function extractFunctions(content: string): ExtractedFunction[] {
+  const out: ExtractedFunction[] = [];
+  const patterns: RegExp[] = [
+    /(?:export\s+)?(?:async\s+)?function\s+([A-Za-z_$][\w$]*)\s*\(/g,
+    /(?:export\s+)?const\s+([A-Za-z_$][\w$]*)\s*=\s*(?:async\s*)?\([^)]*\)\s*(?::\s*[^{]+)?=>\s*\{/g,
+    /(?:^|\n)\s*(?:public\s+|private\s+|protected\s+|static\s+|async\s+)*([A-Za-z_$][\w$]*)\s*\([^)]*\)\s*(?::\s*[^{]+)?\{/gm,
+  ];
+  for (const pattern of patterns) {
+    let match: RegExpExecArray | null;
+    while ((match = pattern.exec(content)) !== null) {
+      const name = match[1] as string;
+      const braceIndex = content.indexOf('{', match.index);
+      if (braceIndex === -1) continue;
+      const body = extractBalancedBody(content, braceIndex);
+      if (body !== undefined) out.push({ name, body });
+    }
+  }
+  return out;
+}
+
+/** Return the text inside a balanced `{...}` starting at braceIndex, or undefined if unbalanced. */
+function extractBalancedBody(content: string, braceIndex: number): string | undefined {
+  let depth = 0;
+  let inString: string | null = null;
+  let escaped = false;
+  for (let i = braceIndex; i < content.length; i++) {
+    const ch = content[i] as string;
+    if (inString) {
+      if (escaped) escaped = false;
+      else if (ch === '\\') escaped = true;
+      else if (ch === inString) inString = null;
+      continue;
+    }
+    if (ch === '"' || ch === "'" || ch === '`') {
+      inString = ch;
+      continue;
+    }
+    if (ch === '{') depth += 1;
+    else if (ch === '}') {
+      depth -= 1;
+      if (depth === 0) return content.slice(braceIndex + 1, i);
+    }
+  }
+  return undefined;
+}
+
+const DECISION_TOKEN = /\b(?:if|for|while|case|catch|switch)\b|&&|\|\||\?\.|\?\s*[^:?.]/g;
+
+function countDecisionTokens(body: string): number {
+  // Strip strings/comments so tokens inside them don't inflate the count.
+  const stripped = body
+    .replace(/\/\*[\s\S]*?\*\//g, ' ')
+    .replace(/\/\/[^\n]*/g, ' ')
+    .replace(/`(?:\\.|[^`\\])*`/g, '``')
+    .replace(/'(?:\\.|[^'\\])*'/g, "''")
+    .replace(/"(?:\\.|[^"\\])*"/g, '""');
+  return stripped.match(DECISION_TOKEN)?.length ?? 0;
+}
diff --git a/src/autonomous/discovery/coverage-churn.ts b/src/autonomous/discovery/coverage-churn.ts
new file mode 100644
index 00000000..f8ff5940
--- /dev/null
+++ b/src/autonomous/discovery/coverage-churn.ts
@@ -0,0 +1,72 @@
+import { git, parseNumstat, readJsonFile } from './common.js';
+import { makeFinding, type DiscoveryCollector, type RawFinding } from './index.js';
+
+interface CoverageFileSummary {
+  lines?: { pct?: number };
+  branches?: { pct?: number };
+}
+
+interface CoverageSummary {
+  total?: CoverageFileSummary;
+  [file: string]: CoverageFileSummary | undefined;
+}
+
+/** Minimum churn (added + deleted lines in 30 days) for a file to count as high-churn. */
+const HIGH_CHURN_LINES = 20;
+/** Only files below this line-coverage pct are worth queueing. */
+const LOW_COVERAGE_PCT = 100;
+
+/**
+ * Intersects uncovered lines with recent churn: only uncovered code in
+ * high-churn core files (src/**) is queued. Needs a coverage summary
+ * (coverage/coverage-summary.json, v8 or istanbul) — returns [] without one.
+ */
+export class CoverageChurnCollector implements DiscoveryCollector {
+  readonly name = 'coverage_churn';
+
+  async collect(repoRoot: string): Promise<RawFinding[]> {
+    const findings: RawFinding[] = [];
+    const summary = await readJsonFile<CoverageSummary>(
+      `${repoRoot}/coverage/coverage-summary.json`,
+    );
+    if (!summary) return findings;
+
+    const churnLog = await git(repoRoot, [
+      'log',
+      '--since=30 days ago',
+      '--numstat',
+      '--format=',
+      '--',
+      'src',
+    ]);
+    const churn = parseNumstat(churnLog);
+
+    for (const [file, fileSummary] of Object.entries(summary)) {
+      if (file === 'total' || !fileSummary) continue;
+      if (!file.startsWith('src/')) continue; // core files only
+      const linesPct = fileSummary.lines?.pct;
+      const branchesPct = fileSummary.branches?.pct;
+      if (linesPct === undefined || linesPct >= LOW_COVERAGE_PCT) continue;
+      const churnLines = churn.get(file) ?? 0;
+      if (churnLines < HIGH_CHURN_LINES) continue;
+      findings.push(
+        makeFinding({
+          collector: this.name,
+          ruleOrTestId: `uncovered-high-churn:${file}`,
+          targetFiles: [file],
+          severity: 0.6,
+          confidence: 0.85,
+          verification: 0.7,
+          findingPayload: {
+            kind: 'uncovered-high-churn',
+            linesPct,
+            branchesPct: branchesPct ?? null,
+            churnLines30d: churnLines,
+            note: 'Uncovered lines in a core file changed heavily in the last 30 days.',
+          },
+        }),
+      );
+    }
+    return findings;
+  }
+}
diff --git a/src/autonomous/discovery/dependency.ts b/src/autonomous/discovery/dependency.ts
new file mode 100644
index 00000000..cc45f0ac
--- /dev/null
+++ b/src/autonomous/discovery/dependency.ts
@@ -0,0 +1,136 @@
+import { runCommand, safeJsonParse } from './common.js';
+import { makeFinding, type DiscoveryCollector, type RawFinding } from './index.js';
+
+interface OutdatedEntry {
+  current?: string;
+  wanted?: string;
+  latest?: string;
+  type?: string;
+}
+
+interface AuditVulnerability {
+  severity?: string;
+  title?: string;
+  fixAvailable?: boolean | { name?: string; version?: string };
+  via?: unknown[];
+}
+
+interface AuditReport {
+  vulnerabilities?: Record<string, AuditVulnerability>;
+}
+
+const SEVERITY_SCORE: Record<string, number> = {
+  critical: 0.95,
+  high: 0.8,
+  moderate: 0.55,
+  low: 0.3,
+  info: 0.15,
+};
+
+/**
+ * `npm outdated` (patch/minor only — major bumps are human-review) plus
+ * `npm audit` (high/critical vulnerabilities).
+ *
+ * Deviation from the brief: the per-package publish-age check (≥7 days) via
+ * `npm view <pkg> time --json` is SKIPPED. It needs one network round-trip per
+ * outdated package, which makes the collector slow and flaky offline; the
+ * age gate belongs in the downstream verifier, which can batch the lookups.
+ * The deviation is recorded on every outdated finding's payload.
+ */
+export class DependencyCollector implements DiscoveryCollector {
+  readonly name = 'dependency';
+
+  async collect(repoRoot: string): Promise<RawFinding[]> {
+    const findings: RawFinding[] = [];
+    findings.push(...(await this.collectOutdated(repoRoot)));
+    findings.push(...(await this.collectAudit(repoRoot)));
+    return findings;
+  }
+
+  private async collectOutdated(repoRoot: string): Promise<RawFinding[]> {
+    const findings: RawFinding[] = [];
+    // npm outdated exits 1 when anything is outdated — that is a normal result.
+    const result = await runCommand('npm', ['outdated', '--json'], repoRoot, 120_000);
+    if (result.timedOut || !result.stdout.trim()) return findings;
+    const outdated = safeJsonParse(result.stdout.trim()) as
+      Record<string, OutdatedEntry> | undefined;
+    if (!outdated) return findings;
+
+    for (const [pkg, entry] of Object.entries(outdated)) {
+      const current = entry.current ?? '?';
+      const wanted = entry.wanted ?? current;
+      const latest = entry.latest ?? wanted;
+      const isMajor = majorBump(current, latest);
+      findings.push(
+        makeFinding({
+          collector: this.name,
+          ruleOrTestId: `outdated:${pkg}`,
+          targetFiles: ['package.json'],
+          severity: isMajor ? 0.4 : 0.55,
+          confidence: 0.9,
+          verification: 0.6,
+          findingPayload: {
+            kind: 'outdated-dependency',
+            package: pkg,
+            current,
+            wanted,
+            latest,
+            updateType: isMajor ? 'major' : (entry.type ?? 'minor'),
+            // Major bumps are never auto-applied: a human must review the changelog.
+            requiresHumanReview: isMajor,
+            publishAgeCheckSkipped: true,
+            publishAgeCheckNote:
+              'Per-package `npm view <pkg> time` age gate (≥7 days) skipped for speed/offline safety; verify age downstream before queueing.',
+          },
+        }),
+      );
+    }
+    return findings;
+  }
+
+  private async collectAudit(repoRoot: string): Promise<RawFinding[]> {
+    const findings: RawFinding[] = [];
+    const result = await runCommand('npm', ['audit', '--json'], repoRoot, 120_000);
+    if (result.timedOut || !result.stdout.trim()) return findings;
+    const report = safeJsonParse(result.stdout.trim()) as AuditReport | undefined;
+    if (!report?.vulnerabilities) return findings;
+
+    for (const [pkg, vuln] of Object.entries(report.vulnerabilities)) {
+      const severity = (vuln.severity ?? 'low').toLowerCase();
+      if (severity !== 'critical' && severity !== 'high') continue;
+      const fix = vuln.fixAvailable;
+      findings.push(
+        makeFinding({
+          collector: this.name,
+          ruleOrTestId: `audit:${pkg}:${severity}`,
+          targetFiles: ['package.json', 'package-lock.json'],
+          severity: SEVERITY_SCORE[severity] ?? 0.5,
+          confidence: 0.85,
+          verification: 0.6,
+          findingPayload: {
+            kind: 'vulnerable-dependency',
+            package: pkg,
+            severity,
+            title: vuln.title ?? null,
+            fixAvailable: Boolean(fix),
+            fixVersion: typeof fix === 'object' ? (fix.version ?? null) : null,
+          },
+        }),
+      );
+    }
+    return findings;
+  }
+}
+
+/** True when latest is a major version ahead of current (semver, best effort). */
+function majorBump(current: string, latest: string): boolean {
+  const parse = (v: string): number[] | null => {
+    const match = /^(\d+)(?:\.(\d+))?(?:\.(\d+))?/.exec(v.trim().replace(/^[v=^~ ]+/, ''));
+    if (!match) return null;
+    return [Number(match[1]), Number(match[2] ?? 0), Number(match[3] ?? 0)];
+  };
+  const from = parse(current);
+  const to = parse(latest);
+  if (!from || !to) return false;
+  return (to[0] as number) > (from[0] as number);
+}
diff --git a/src/autonomous/discovery/index.ts b/src/autonomous/discovery/index.ts
new file mode 100644
index 00000000..5a4df73d
--- /dev/null
+++ b/src/autonomous/discovery/index.ts
@@ -0,0 +1,143 @@
+import { clamp01, fingerprint } from './common.js';
+import { CoverageChurnCollector } from './coverage-churn.js';
+import { ComplexityCollector } from './complexity.js';
+import { DependencyCollector } from './dependency.js';
+import { PerfBenchmarkCollector } from './perf-benchmark.js';
+import { SelfReviewCollector } from './self-review.js';
+import { StaticAnalysisCollector } from './static-analysis.js';
+import { TelemetryCollector } from './telemetry.js';
+import { TestRunnerCollector } from './test-runner.js';
+import { TodoMiningCollector } from './todo-mining.js';
+
+/**
+ * One raw, unverified observation from a discovery collector.
+ * Downstream stages (dedupe, scoring, verification) refine these into tasks.
+ */
+export interface RawFinding {
+  /** Collector that produced this finding, e.g. 'test_runner'. */
+  collector: string;
+  /** Rule id or test id the finding refers to, e.g. 'TS2304' or 'src/foo.test.ts > bar'. */
+  ruleOrTestId: string;
+  /** Canonical symbol the finding is about, when one can be identified. */
+  canonicalSymbol?: string;
+  /** Repo-relative files the finding touches. */
+  targetFiles: string[];
+  /** Severity 0..1 (1 = must fix now, e.g. a failing test). */
+  severity: number;
+  /** Confidence 0..1 that the finding is real and actionable. */
+  confidence: number;
+  /** Verification 0..1: how strongly the finding has been independently confirmed. */
+  verification: number;
+  /** Collector-specific detail; must be JSON-serializable. */
+  findingPayload: unknown;
+}
+
+/** Every discovery collector is deterministic (no LLM calls) and never throws. */
+export interface DiscoveryCollector {
+  /** Stable name, e.g. 'test_runner'. Used in RawFinding.collector and for enablement. */
+  readonly name: string;
+  /** Collect raw findings from the repo at repoRoot. Returns [] on any tool failure. */
+  collect(repoRoot: string): Promise<RawFinding[]>;
+}
+
+/** Build a RawFinding with clamped scores and a stable fingerprint. */
+export function makeFinding(input: {
+  collector: string;
+  ruleOrTestId: string;
+  canonicalSymbol?: string;
+  targetFiles: string[];
+  severity: number;
+  confidence: number;
+  verification?: number;
+  findingPayload: unknown;
+}): RawFinding {
+  const finding: RawFinding = {
+    collector: input.collector,
+    ruleOrTestId: input.ruleOrTestId,
+    targetFiles: input.targetFiles,
+    severity: clamp01(input.severity),
+    confidence: clamp01(input.confidence),
+    verification: clamp01(input.verification ?? 0),
+    findingPayload: input.findingPayload,
+  };
+  if (input.canonicalSymbol !== undefined) finding.canonicalSymbol = input.canonicalSymbol;
+  return finding;
+}
+
+/** Fingerprint used for dedupe and for bounding self-repair attempts. */
+export function findingFingerprint(finding: RawFinding): string {
+  return fingerprint([finding.collector, finding.ruleOrTestId, ...finding.targetFiles]);
+}
+
+export interface DiscoveryOptions {
+  /** Collector names to run. Defaults to all registered collectors. */
+  enabled?: string[];
+  /** Per-collector timeout in ms. Defaults to 120_000. */
+  timeoutMs?: number;
+}
+
+/** All registered collectors, in priority order. */
+export const ALL_COLLECTORS: DiscoveryCollector[] = [
+  new TestRunnerCollector(),
+  new StaticAnalysisCollector(),
+  new SelfReviewCollector(),
+  new CoverageChurnCollector(),
+  new DependencyCollector(),
+  new TelemetryCollector(),
+  new PerfBenchmarkCollector(),
+  new ComplexityCollector(),
+  new TodoMiningCollector(),
+];
+
+export const COLLECTOR_NAMES: string[] = ALL_COLLECTORS.map((c) => c.name);
+
+/**
+ * Runs the enabled collectors and merges their findings.
+ * A failing collector never takes down the run: it contributes [] and the
+ * failure is recorded in `errors` so the orchestrator can report it.
+ */
+export class DiscoveryOrchestrator {
+  private readonly collectors: DiscoveryCollector[];
+
+  constructor(collectors: DiscoveryCollector[] = ALL_COLLECTORS) {
+    this.collectors = collectors;
+  }
+
+  async collect(
+    repoRoot: string,
+    options: DiscoveryOptions = {},
+  ): Promise<{ findings: RawFinding[]; errors: Record<string, string> }> {
+    const enabled = new Set(options.enabled ?? COLLECTOR_NAMES);
+    const findings: RawFinding[] = [];
+    const errors: Record<string, string> = {};
+
+    for (const collector of this.collectors) {
+      if (!enabled.has(collector.name)) continue;
+      try {
+        const collected = await collector.collect(repoRoot);
+        findings.push(...collected);
+      } catch (err) {
+        // Contract: collectors must not throw, but the orchestrator is the last line
+        // of defence — a rogue collector degrades to [] instead of killing the run.
+        errors[collector.name] = err instanceof Error ? err.message : String(err);
+      }
+    }
+
+    // Highest severity first; ties broken by confidence, then collector name.
+    findings.sort(
+      (a, b) =>
+        b.severity - a.severity ||
+        b.confidence - a.confidence ||
+        a.collector.localeCompare(b.collector),
+    );
+    return { findings, errors };
+  }
+}
+
+/** Convenience entry point: run the default orchestrator over a repo. */
+export async function runDiscovery(
+  repoRoot: string,
+  options: DiscoveryOptions = {},
+): Promise<{ findings: RawFinding[]; errors: Record<string, string> }> {
+  return new DiscoveryOrchestrator().collect(repoRoot, options);
+}
diff --git a/src/autonomous/discovery/perf-benchmark.ts b/src/autonomous/discovery/perf-benchmark.ts
new file mode 100644
index 00000000..13bf75b3
--- /dev/null
+++ b/src/autonomous/discovery/perf-benchmark.ts
@@ -0,0 +1,179 @@
+import { mkdir, writeFile } from 'node:fs/promises';
+import { readJsonFile, runCommand } from './common.js';
+import { makeFinding, type DiscoveryCollector, type RawFinding } from './index.js';
+
+interface BenchResult {
+  name?: string;
+  hz?: number;
+  /** vitest bench JSON uses `samples`/`median`; keep the raw shape loose. */
+  samples?: number[];
+  median?: number;
+  rme?: number;
+}
+
+interface BenchReport {
+  benchmarks?: BenchResult[];
+  files?: { name?: string; benchmarks?: BenchResult[] }[];
+}
+
+interface BaselineEntry {
+  medianMs: number;
+  /** Consecutive runs in which this benchmark regressed >15% vs baseline. */
+  consecutiveRegressions: number;
+}
+
+type Baseline = Record<string, BaselineEntry>;
+
+/** Queue only regressions above this fraction vs the stored baseline. */
+const REGRESSION_THRESHOLD = 0.15;
+/** Queue only after this many consecutive regressing runs (guards against noise). */
+const REQUIRED_REGRESSION_RUNS = 3;
+
+/**
+ * Runs `vitest bench` when bench files exist and compares against the stored
+ * baseline (`.omnexx/perf-baseline.json`). A benchmark is queued only when it
+ * regresses >15% in 3 consecutive runs, with the concrete hot function named.
+ *
+ * First run with no baseline: records the baseline and returns [].
+ * No bench files: returns [] without running anything.
+ */
+export class PerfBenchmarkCollector implements DiscoveryCollector {
+  readonly name = 'perf_benchmark';
+
+  async collect(repoRoot: string): Promise<RawFinding[]> {
+    const findings: RawFinding[] = [];
+    const benchFiles = await findBenchFiles(repoRoot);
+    if (benchFiles.length === 0) return findings;
+
+    const result = await runCommand(
+      'npx',
+      ['vitest', 'bench', '--run', '--outputJson', '.omnexx/discovery/bench-result.json'],
+      repoRoot,
+      300_000,
+    );
+    if (result.timedOut) return findings;
+    const report = await readJsonFile<BenchReport>(
+      `${repoRoot}/.omnexx/discovery/bench-result.json`,
+    );
+    if (!report) return findings;
+
+    const current = flattenBenchmarks(report);
+    if (current.size === 0) return findings;
+
+    const baselinePath = `${repoRoot}/.omnexx/perf-baseline.json`;
+    const baseline = await readJsonFile<Baseline>(baselinePath);
+    if (!baseline) {
+      // No baseline yet: record one and queue nothing.
+      await writeBaseline(baselinePath, toBaseline(current));
+      return findings;
+    }
+
+    const nextBaseline: Baseline = { ...baseline };
+    for (const [name, medianMs] of current) {
+      const entry = baseline[name];
+      if (!entry) {
+        nextBaseline[name] = { medianMs, consecutiveRegressions: 0 };
+        continue;
+      }
+      const regression = (medianMs - entry.medianMs) / entry.medianMs;
+      if (regression > REGRESSION_THRESHOLD) {
+        const consecutive = entry.consecutiveRegressions + 1;
+        nextBaseline[name] = { medianMs: entry.medianMs, consecutiveRegressions: consecutive };
+        if (consecutive >= REQUIRED_REGRESSION_RUNS) {
+          findings.push(
+            makeFinding({
+              collector: this.name,
+              ruleOrTestId: `perf-regression:${name}`,
+              targetFiles: benchFilesFor(name, benchFiles),
+              severity: 0.7,
+              confidence: 0.85,
+              verification: 0.8,
+              findingPayload: {
+                kind: 'perf-regression',
+                benchmark: name,
+                baselineMedianMs: entry.medianMs,
+                currentMedianMs: medianMs,
+                regressionPct: Math.round(regression * 1000) / 10,
+                consecutiveRegressions: consecutive,
+                note: `Regressed >${REGRESSION_THRESHOLD * 100}% vs baseline in ${consecutive} consecutive runs.`,
+              },
+            }),
+          );
+        }
+      } else {
+        // Back within tolerance: reset the streak and adopt the new (better) median.
+        nextBaseline[name] = {
+          medianMs: Math.min(entry.medianMs, medianMs),
+          consecutiveRegressions: 0,
+        };
+      }
+    }
+    await writeBaseline(baselinePath, nextBaseline);
+    return findings;
+  }
+}
+
+async function findBenchFiles(repoRoot: string): Promise<string[]> {
+  const result = await runCommand(
+    'git',
+    ['ls-files', '*.bench.ts', '*.bench.tsx', 'bench/**/*.ts'],
+    repoRoot,
+    30_000,
+  );
+  if (result.exitCode !== 0) return [];
+  return result.stdout
+    .split('\n')
+    .map((f) => f.trim())
+    .filter(Boolean);
+}
+
+function flattenBenchmarks(report: BenchReport): Map<string, number> {
+  const out = new Map<string, number>();
+  const add = (name: string | undefined, r: BenchResult): void => {
+    if (!name) return;
+    const medianMs = medianOf(r);
+    if (medianMs !== undefined) out.set(name, medianMs);
+  };
+  for (const b of report.benchmarks ?? []) add(b.name, b);
+  for (const file of report.files ?? []) {
+    for (const b of file.benchmarks ?? []) {
+      add(b.name ?? `${file.name ?? 'bench'} > unnamed`, b);
+    }
+  }
+  return out;
+}
+
+/** Median run time in ms. Vitest bench reports hz (ops/sec) and/or samples (sec). */
+function medianOf(result: BenchResult): number | undefined {
+  if (typeof result.median === 'number' && Number.isFinite(result.median)) {
+    return result.median * 1000; // vitest bench median is in seconds
+  }
+  if (Array.isArray(result.samples) && result.samples.length > 0) {
+    const sorted = [...result.samples].sort((a, b) => a - b);
+    return (sorted[Math.floor(sorted.length / 2)] as number) * 1000;
+  }
+  if (typeof result.hz === 'number' && result.hz > 0) return 1000 / result.hz;
+  return undefined;
+}
+
+function toBaseline(current: Map<string, number>): Baseline {
+  const baseline: Baseline = {};
+  for (const [name, medianMs] of current) {
+    baseline[name] = { medianMs, consecutiveRegressions: 0 };
+  }
+  return baseline;
+}
+
+async function writeBaseline(path: string, baseline: Baseline): Promise<void> {
+  try {
+    await mkdir(path.slice(0, path.lastIndexOf('/')), { recursive: true });
+    await writeFile(path, `${JSON.stringify(baseline, null, 2)}\n`, 'utf8');
+  } catch {
+    // Baseline persistence is best effort.
+  }
+}
+
+function benchFilesFor(benchmarkName: string, benchFiles: string[]): string[] {
+  const match = benchFiles.find((f) => benchmarkName.includes(f));
+  return match ? [match] : benchFiles.slice(0, 1);
+}
diff --git a/src/autonomous/discovery/self-review.ts b/src/autonomous/discovery/self-review.ts
new file mode 100644
index 00000000..21f97e07
--- /dev/null
+++ b/src/autonomous/discovery/self-review.ts
@@ -0,0 +1,157 @@
+import { fileExists, git, readJsonFile } from './common.js';
+import { makeFinding, type DiscoveryCollector, type RawFinding } from './index.js';
+
+interface ReviewComment {
+  id?: string;
+  file?: string;
+  line?: number;
+  body?: string;
+  resolved?: boolean;
+  author?: string;
+}
+
+/**
+ * Reviews the daemon's own recent work for signs it went wrong: reverted
+ * autonomous commits, autonomous commits whose messages admit a CI failure or
+ * a follow-up fix, and unresolved review comments recorded locally.
+ *
+ * Each finding is bounded to ONE self-repair attempt per fingerprint: the
+ * payload carries `maxSelfRepairAttempts: 1` so downstream stages never
+ * loop on the same failure.
+ */
+export class SelfReviewCollector implements DiscoveryCollector {
+  readonly name = 'self_review';
+
+  async collect(repoRoot: string): Promise<RawFinding[]> {
+    const findings: RawFinding[] = [];
+    findings.push(...(await this.collectReverts(repoRoot)));
+    findings.push(...(await this.collectAutonomousFailures(repoRoot)));
+    findings.push(...(await this.collectUnresolvedComments(repoRoot)));
+    return findings;
+  }
+
+  /** Commits in the last 72h that revert an autonomous commit. */
+  private async collectReverts(repoRoot: string): Promise<RawFinding[]> {
+    const findings: RawFinding[] = [];
+    const log = await git(repoRoot, [
+      'log',
+      '--since=72 hours ago',
+      '--grep=^Revert',
+      '--format=%H%x00%s%x00%b%x1e',
+    ]);
+    for (const entry of log.split('\x1e')) {
+      const trimmed = entry.trim();
+      if (!trimmed) continue;
+      const [hash, subject, body] = trimmed.split('\x00');
+      const reverted = /This reverts commit ([0-9a-f]{7,40})/.exec(body ?? '')?.[1];
+      // Only care about reverts of autonomous work, or reverts whose subject names it.
+      const autonomous =
+        /omnexx-auto/i.test(subject ?? '') ||
+        /omnexx-auto/i.test(body ?? '') ||
+        (await this.isAutonomousCommit(repoRoot, reverted));
+      if (!autonomous) continue;
+      findings.push(
+        makeFinding({
+          collector: this.name,
+          ruleOrTestId: `revert:${hash?.slice(0, 12) ?? 'unknown'}`,
+          targetFiles: await this.commitFiles(repoRoot, hash ?? ''),
+          severity: 0.85,
+          confidence: 0.9,
+          verification: 0.8,
+          findingPayload: {
+            kind: 'reverted-autonomous-commit',
+            revertCommit: hash,
+            revertedCommit: reverted ?? null,
+            subject,
+            maxSelfRepairAttempts: 1,
+          },
+        }),
+      );
+    }
+    return findings;
+  }
+
+  /**
+   * Autonomous commits in the last 72h whose own message admits trouble
+   * (CI failure, follow-up fix, rollback) — the daemon's work needed repair.
+   */
+  private async collectAutonomousFailures(repoRoot: string): Promise<RawFinding[]> {
+    const findings: RawFinding[] = [];
+    const log = await git(repoRoot, [
+      'log',
+      '--since=72 hours ago',
+      '--grep=omnexx-auto',
+      '--format=%H%x00%s%x00%b%x1e',
+    ]);
+    const trouble = /(\bci (fail|broke|red)\b|follow-?up fix|hotfix|rollback|revert)/i;
+    for (const entry of log.split('\x1e')) {
+      const trimmed = entry.trim();
+      if (!trimmed) continue;
+      const [hash, subject, body] = trimmed.split('\x00');
+      const text = `${subject ?? ''}\n${body ?? ''}`;
+      if (!trouble.test(text)) continue;
+      findings.push(
+        makeFinding({
+          collector: this.name,
+          ruleOrTestId: `autonomous-trouble:${hash?.slice(0, 12) ?? 'unknown'}`,
+          targetFiles: await this.commitFiles(repoRoot, hash ?? ''),
+          severity: 0.85,
+          confidence: 0.75,
+          verification: 0.7,
+          findingPayload: {
+            kind: 'autonomous-commit-admits-failure',
+            commit: hash,
+            subject,
+            maxSelfRepairAttempts: 1,
+          },
+        }),
+      );
+    }
+    return findings;
+  }
+
+  /** Unresolved review comments recorded locally (no network, no GitHub API). */
+  private async collectUnresolvedComments(repoRoot: string): Promise<RawFinding[]> {
+    const findings: RawFinding[] = [];
+    const path = `${repoRoot}/.omnexx/review-comments.json`;
+    if (!fileExists(path)) return findings;
+    const comments = (await readJsonFile<ReviewComment[]>(path)) ?? [];
+    for (const comment of comments) {
+      if (comment.resolved) continue;
+      const id = comment.id ?? `${comment.file ?? 'unknown'}:${comment.line ?? 0}`;
+      findings.push(
+        makeFinding({
+          collector: this.name,
+          ruleOrTestId: `review-comment:${id}`,
+          targetFiles: comment.file ? [comment.file] : [],
+          severity: 0.85,
+          confidence: 0.8,
+          verification: 0.6,
+          findingPayload: {
+            kind: 'unresolved-review-comment',
+            author: comment.author ?? null,
+            line: comment.line ?? null,
+            body: (comment.body ?? '').slice(0, 300),
+            maxSelfRepairAttempts: 1,
+          },
+        }),
+      );
+    }
+    return findings;
+  }
+
+  private async isAutonomousCommit(repoRoot: string, hash?: string): Promise<boolean> {
+    if (!hash) return false;
+    const subject = await git(repoRoot, ['log', '-1', '--format=%s%n%b', hash]);
+    return /omnexx-auto/i.test(subject);
+  }
+
+  private async commitFiles(repoRoot: string, hash: string): Promise<string[]> {
+    if (!hash) return [];
+    const out = await git(repoRoot, ['diff-tree', '--no-commit-id', '--name-only', '-r', hash]);
+    return out
+      .split('\n')
+      .map((f) => f.trim())
+      .filter(Boolean);
+  }
+}
diff --git a/src/autonomous/discovery/static-analysis.ts b/src/autonomous/discovery/static-analysis.ts
new file mode 100644
index 00000000..265aa442
--- /dev/null
+++ b/src/autonomous/discovery/static-analysis.ts
@@ -0,0 +1,216 @@
+import { changedFiles, fileExists, runCommand, safeJsonParse } from './common.js';
+import { makeFinding, type DiscoveryCollector, type RawFinding } from './index.js';
+
+interface EslintMessage {
+  ruleId?: string | null;
+  severity?: number;
+  message?: string;
+  line?: number;
+  column?: number;
+}
+
+interface EslintFileResult {
+  filePath?: string;
+  messages?: EslintMessage[];
+}
+
+interface KnipIssue {
+  file?: string;
+  name?: string;
+}
+
+interface KnipReport {
+  files?: string[];
+  exports?: Record<string, Record<string, KnipIssue>>;
+  types?: Record<string, Record<string, KnipIssue>>;
+}
+
+/**
+ * Type errors, lint errors on changed files, and unused exports.
+ * Deterministic: no LLM calls. Each tool is optional — a missing binary or a
+ * tool failure degrades to [] for that source instead of failing the collector.
+ */
+export class StaticAnalysisCollector implements DiscoveryCollector {
+  readonly name = 'static_analysis';
+
+  async collect(repoRoot: string): Promise<RawFinding[]> {
+    const findings: RawFinding[] = [];
+    findings.push(...(await this.collectTypeErrors(repoRoot)));
+    findings.push(...(await this.collectLintErrors(repoRoot)));
+    findings.push(...(await this.collectUnusedExports(repoRoot)));
+    return findings;
+  }
+
+  /** `tsc --noEmit`: every error line becomes a finding (severity 0.9). */
+  private async collectTypeErrors(repoRoot: string): Promise<RawFinding[]> {
+    const findings: RawFinding[] = [];
+    const result = await runCommand(
+      'npx',
+      ['tsc', '--noEmit', '--pretty', 'false'],
+      repoRoot,
+      180_000,
+    );
+    if (result.timedOut) return findings;
+    const output = `${result.stdout}\n${result.stderr}`;
+    for (const line of output.split('\n')) {
+      // src/foo.ts(12,3): error TS2304: Cannot find name 'x'.
+      const match = /^(.+?)\((\d+),(\d+)\): error (TS\d+): (.+)$/.exec(line);
+      if (!match) continue;
+      const [, file, lineNo, colNo, code, message] = match as unknown as [
+        string,
+        string,
+        string,
+        string,
+        string,
+        string,
+      ];
+      findings.push(
+        makeFinding({
+          collector: this.name,
+          ruleOrTestId: code,
+          targetFiles: [file],
+          severity: 0.9,
+          confidence: 1.0,
+          verification: 0.9,
+          findingPayload: {
+            kind: 'type-error',
+            line: Number(lineNo),
+            column: Number(colNo),
+            message: message.trim().slice(0, 300),
+          },
+        }),
+      );
+    }
+    return findings;
+  }
+
+  /** ESLint (JSON) over files changed vs HEAD; errors only, warnings are noise here. */
+  private async collectLintErrors(repoRoot: string): Promise<RawFinding[]> {
+    const findings: RawFinding[] = [];
+    const files = (await changedFiles(repoRoot, 50)).filter((f) =>
+      /\.(?:ts|tsx|js|jsx|mjs|cjs)$/.test(f),
+    );
+    if (files.length === 0) return findings;
+    const result = await runCommand(
+      'npx',
+      ['eslint', '--format', 'json', ...files],
+      repoRoot,
+      120_000,
+    );
+    if (result.timedOut) return findings;
+    const report = safeJsonParse(result.stdout.trim()) as EslintFileResult[] | undefined;
+    if (!report) return findings;
+    for (const fileResult of report) {
+      const relPath = relativeTo(repoRoot, fileResult.filePath ?? '');
+      for (const msg of fileResult.messages ?? []) {
+        if (msg.severity !== 2) continue; // errors only
+        findings.push(
+          makeFinding({
+            collector: this.name,
+            ruleOrTestId: msg.ruleId ?? 'eslint-error',
+            targetFiles: relPath ? [relPath] : [],
+            severity: 0.75,
+            confidence: 0.95,
+            verification: 0.8,
+            findingPayload: {
+              kind: 'lint-error',
+              line: msg.line,
+              column: msg.column,
+              message: (msg.message ?? '').slice(0, 300),
+            },
+          }),
+        );
+      }
+    }
+    return findings;
+  }
+
+  /**
+   * Unused exports via knip (preferred) or ts-prune, when installed.
+   * Neither is a dependency of this repo, so both are skipped gracefully.
+   */
+  private async collectUnusedExports(repoRoot: string): Promise<RawFinding[]> {
+    if (fileExists(`${repoRoot}/node_modules/.bin/knip`)) {
+      return this.collectKnip(repoRoot);
+    }
+    if (fileExists(`${repoRoot}/node_modules/.bin/ts-prune`)) {
+      return this.collectTsPrune(repoRoot);
+    }
+    return [];
+  }
+
+  private async collectKnip(repoRoot: string): Promise<RawFinding[]> {
+    const findings: RawFinding[] = [];
+    const result = await runCommand(
+      'npx',
+      ['knip', '--no-progress', '--reporter', 'json'],
+      repoRoot,
+      120_000,
+    );
+    if (result.timedOut) return findings;
+    const report = safeJsonParse(result.stdout.trim()) as KnipReport | undefined;
+    if (!report) return findings;
+    for (const file of report.files ?? []) {
+      findings.push(unusedFinding(this.name, file, 'unused-file', 'Unused file reported by knip.'));
+    }
+    for (const [file, byName] of Object.entries(report.exports ?? {})) {
+      for (const name of Object.keys(byName)) {
+        findings.push(
+          unusedFinding(this.name, file, `unused-export:${name}`, `Unused export '${name}'.`),
+        );
+      }
+    }
+    for (const [file, byName] of Object.entries(report.types ?? {})) {
+      for (const name of Object.keys(byName)) {
+        findings.push(
+          unusedFinding(this.name, file, `unused-type:${name}`, `Unused type '${name}'.`),
+        );
+      }
+    }
+    return findings;
+  }
+
+  private async collectTsPrune(repoRoot: string): Promise<RawFinding[]> {
+    const findings: RawFinding[] = [];
+    const result = await runCommand('npx', ['ts-prune'], repoRoot, 120_000);
+    if (result.timedOut) return findings;
+    for (const line of result.stdout.split('\n')) {
+      // src/foo.ts:12 - bar (used in module)
+      const match = /^(.+?):(\d+) - (\S+)/.exec(line);
+      if (!match) continue;
+      const [, file, lineNo, name] = match as unknown as [string, string, string, string];
+      findings.push(
+        unusedFinding(
+          this.name,
+          file,
+          `unused-export:${name}`,
+          `Unused export '${name}' (ts-prune, line ${lineNo}).`,
+        ),
+      );
+    }
+    return findings;
+  }
+}
+
+function unusedFinding(
+  collector: string,
+  file: string,
+  ruleOrTestId: string,
+  message: string,
+): RawFinding {
+  return makeFinding({
+    collector,
+    ruleOrTestId,
+    targetFiles: [file],
+    severity: 0.4,
+    confidence: 0.8,
+    verification: 0.6,
+    findingPayload: { kind: 'unused-export', message },
+  });
+}
+
+function relativeTo(repoRoot: string, absolutePath: string): string {
+  if (!absolutePath) return '';
+  const prefix = repoRoot.endsWith('/') ? repoRoot : `${repoRoot}/`;
+  return absolutePath.startsWith(prefix) ? absolutePath.slice(prefix.length) : absolutePath;
+}
diff --git a/src/autonomous/discovery/telemetry.ts b/src/autonomous/discovery/telemetry.ts
new file mode 100644
index 00000000..ef9bac3e
--- /dev/null
+++ b/src/autonomous/discovery/telemetry.ts
@@ -0,0 +1,106 @@
+import { readFile } from 'node:fs/promises';
+import { fileExists, safeJsonParse } from './common.js';
+import { makeFinding, type DiscoveryCollector, type RawFinding } from './index.js';
+
+/** Minimum occurrences of an identical crash signature before it is queued. */
+const MIN_OCCURRENCES = 3;
+
+interface CrashEntry {
+  message?: string;
+  stack?: string;
+  timestamp?: string;
+  error?: string;
+}
+
+/**
+ * Parses `.omnexx/logs/crash.jsonl` (one JSON crash record per line), dedupes
+ * by stack signature, and queues only signatures seen ≥3 times.
+ * Returns [] when the log is absent, empty, or unparseable.
+ */
+export class TelemetryCollector implements DiscoveryCollector {
+  readonly name = 'telemetry';
+
+  async collect(repoRoot: string): Promise<RawFinding[]> {
+    const findings: RawFinding[] = [];
+    const logPath = `${repoRoot}/.omnexx/logs/crash.jsonl`;
+    if (!fileExists(logPath)) return findings;
+
+    let content: string;
+    try {
+      content = await readFile(logPath, 'utf8');
+    } catch {
+      return findings;
+    }
+
+    const bySignature = new Map<
+      string,
+      { count: number; firstSeen: string | null; lastSeen: string | null; sample: CrashEntry }
+    >();
+    for (const line of content.split('\n')) {
+      const trimmed = line.trim();
+      if (!trimmed) continue;
+      const entry = safeJsonParse(trimmed) as CrashEntry | undefined;
+      if (!entry) continue;
+      const signature = crashSignature(entry);
+      const existing = bySignature.get(signature);
+      const at = entry.timestamp ?? null;
+      if (existing) {
+        existing.count += 1;
+        if (at && (!existing.lastSeen || at > existing.lastSeen)) existing.lastSeen = at;
+      } else {
+        bySignature.set(signature, { count: 1, firstSeen: at, lastSeen: at, sample: entry });
+      }
+    }
+
+    for (const [signature, info] of bySignature) {
+      if (info.count < MIN_OCCURRENCES) continue;
+      findings.push(
+        makeFinding({
+          collector: this.name,
+          ruleOrTestId: `crash:${signature.slice(0, 80)}`,
+          targetFiles: stackFiles(info.sample.stack),
+          severity: 0.85,
+          confidence: 0.9,
+          verification: 0.7,
+          findingPayload: {
+            kind: 'repeated-crash',
+            signature,
+            occurrences: info.count,
+            firstSeen: info.firstSeen,
+            lastSeen: info.lastSeen,
+            sampleMessage: (info.sample.message ?? info.sample.error ?? '').slice(0, 300),
+          },
+        }),
+      );
+    }
+    return findings;
+  }
+}
+
+/** Normalise a crash to a dedupe signature: message + first 3 stack frames. */
+function crashSignature(entry: CrashEntry): string {
+  const message = (entry.message ?? entry.error ?? 'unknown error').split('\n')[0]?.trim() ?? '';
+  const frames = (entry.stack ?? '')
+    .split('\n')
+    .slice(0, 4)
+    .map((line) =>
+      line
+        .trim()
+        .replace(/:\d+:\d+\)?$/, '')
+        .replace(/\(.*\)/, '(...)'),
+    )
+    .filter(Boolean);
+  // Strip memory addresses / ids so identical crashes hash identically.
+  return `${message} :: ${frames.join(' | ')}`.replace(/0x[0-9a-f]+/gi, '0x…').slice(0, 200);
+}
+
+/** Repo-relative files mentioned in a stack trace, best effort. */
+function stackFiles(stack?: string): string[] {
+  if (!stack) return [];
+  const files = new Set<string>();
+  for (const match of stack.matchAll(/(?:^|\s)(?:src|test|vscode\/src)\/[^\s:)]+\.tsx?/g)) {
+    files.add(match[0].trim());
+    if (files.size >= 5) break;
+  }
+  return [...files];
+}
diff --git a/src/autonomous/discovery/test-runner.ts b/src/autonomous/discovery/test-runner.ts
new file mode 100644
index 00000000..5e5c5570
--- /dev/null
+++ b/src/autonomous/discovery/test-runner.ts
@@ -0,0 +1,272 @@
+import { mkdir, readFile, readdir, stat, writeFile } from 'node:fs/promises';
+import { join } from 'node:path';
+import { fileExists, readJsonFile, runCommand } from './common.js';
+import { makeFinding, type DiscoveryCollector, type RawFinding } from './index.js';
+
+interface VitestAssertion {
+  title?: string;
+  fullName?: string;
+  status?: string;
+  failureMessages?: string[];
+}
+
+interface VitestFileResult {
+  name?: string;
+  assertionResults?: VitestAssertion[];
+}
+
+interface VitestJsonReport {
+  numFailedTests?: number;
+  testResults?: VitestFileResult[];
+}
+
+/**
+ * Vitest reports absolute file paths; findings must carry repo-relative
+ * targets or the planner's `normalizeRepoPath` drops them (absolute paths
+ * normalize to null), which makes every test_runner plan fail validation
+ * with "plan touches no known target file". Same helper as static-analysis.
+ */
+function relativeTo(repoRoot: string, absolutePath: string): string {
+  if (!absolutePath) return '';
+  const prefix = repoRoot.endsWith('/') ? repoRoot : `${repoRoot}/`;
+  return absolutePath.startsWith(prefix) ? absolutePath.slice(prefix.length) : absolutePath;
+}
+
+interface TestHistoryRun {
+  at: string;
+  failed: string[];
+}
+
+const HISTORY_PATH = ['.omnexx', 'discovery', 'test-history.json'];
+const MAX_HISTORY_RUNS = 10;
+/** A test that flips between pass and fail across runs is flaky, not just broken. */
+const FLAKY_SEVERITY = 0.6;
+
+export interface TestRunnerOptions {
+  timeoutMs?: number;
+  /**
+   * Extra args appended to `vitest run --reporter=json` (e.g. a test-file
+   * filter for a scoped run). Defaults to the full suite.
+   */
+  vitestArgs?: string[];
+}
+
+/**
+ * Runs the test suite and turns each failing test into a finding.
+ * Deterministic: no LLM calls. Degrades to [] when vitest is missing, times out,
+ * or its output cannot be parsed. Also mines recent CI failure logs when present
+ * and flags tests that flip between pass and fail across runs as flaky.
+ */
+export class TestRunnerCollector implements DiscoveryCollector {
+  readonly name = 'test_runner';
+  private readonly timeoutMs: number;
+  private readonly vitestArgs: string[];
+
+  constructor(options: TestRunnerOptions = {}) {
+    this.timeoutMs = options.timeoutMs ?? 120_000;
+    this.vitestArgs = options.vitestArgs ?? [];
+  }
+
+  async collect(repoRoot: string): Promise<RawFinding[]> {
+    const findings: RawFinding[] = [];
+    const failedIds = new Set<string>();
+
+    const startedAt = Date.now();
+    const result = await runCommand(
+      'npx',
+      ['vitest', 'run', '--reporter=json', ...this.vitestArgs],
+      repoRoot,
+      this.timeoutMs,
+    );
+    if (result.timedOut) return findings;
+
+    const report = extractJsonReport(result.stdout) ?? (await readReportFile(repoRoot, startedAt));
+    if (report) {
+      for (const file of report.testResults ?? []) {
+        for (const assertion of file.assertionResults ?? []) {
+          if (assertion.status !== 'failed') continue;
+          const testId = assertion.fullName ?? assertion.title ?? file.name ?? 'unknown test';
+          failedIds.add(testId);
+          findings.push(
+            makeFinding({
+              collector: this.name,
+              ruleOrTestId: testId,
+              targetFiles: file.name ? [relativeTo(repoRoot, file.name)] : [],
+              severity: 1.0,
+              confidence: 1.0,
+              verification: 1.0,
+              findingPayload: {
+                kind: 'failing-test',
+                failureMessages: (assertion.failureMessages ?? []).slice(0, 3),
+              },
+            }),
+          );
+        }
+      }
+    }
+
+    // Recent CI failure logs, if any were captured locally.
+    findings.push(...(await this.collectFromCiLogs(repoRoot, failedIds)));
+
+    // Flaky detection against the recorded run history.
+    findings.push(...(await this.detectFlaky(repoRoot, failedIds)));
+
+    return findings;
+  }
+
+  private async collectFromCiLogs(
+    repoRoot: string,
+    knownFailed: Set<string>,
+  ): Promise<RawFinding[]> {
+    const findings: RawFinding[] = [];
+    const logDir = join(repoRoot, '.omnexx', 'logs');
+    if (!fileExists(logDir)) return findings;
+    const entries = await readdir(logDir).catch(() => null);
+    if (!entries) return findings;
+    for (const entry of entries) {
+      if (!/^(ci|test)[-_.].*\.log$/i.test(entry) && !entry.endsWith('.log')) continue;
+      let content: string;
+      try {
+        content = await readFile(join(logDir, entry), 'utf8');
+      } catch {
+        continue;
+      }
+      // Keep only the tail: CI logs can be huge and only recent failures matter.
+      const lines = content.split('\n').slice(-2000);
+      for (const line of lines) {
+        const match = /FAIL\s+(\S+\.(?:test|spec)\.[jt]sx?)\b/.exec(line);
+        if (!match) continue;
+        const file = match[1] as string;
+        const testId = `ci-failure:${file}`;
+        if (knownFailed.has(testId)) continue;
+        knownFailed.add(testId);
+        findings.push(
+          makeFinding({
+            collector: this.name,
+            ruleOrTestId: testId,
+            targetFiles: [file],
+            severity: 0.9,
+            confidence: 0.7,
+            verification: 0.5,
+            findingPayload: {
+              kind: 'ci-log-failure',
+              logFile: entry,
+              line: line.trim().slice(0, 300),
+            },
+          }),
+        );
+      }
+    }
+    return findings;
+  }
+
+  private async detectFlaky(repoRoot: string, failedIds: Set<string>): Promise<RawFinding[]> {
+    const findings: RawFinding[] = [];
+    const historyPath = join(repoRoot, ...HISTORY_PATH);
+    const history = (await readJsonFile<TestHistoryRun[]>(historyPath)) ?? [];
+    const previousRuns = history.slice(-MAX_HISTORY_RUNS);
+
+    const previouslyFailed = new Set<string>();
+    for (const run of previousRuns) {
+      for (const id of run.failed) previouslyFailed.add(id);
+    }
+    const lastRunFailed = new Set(previousRuns.at(-1)?.failed ?? []);
+
+    // Failing now, passed in the last run, but failed in an earlier run: flaky.
+    for (const id of failedIds) {
+      if (!lastRunFailed.has(id) && previouslyFailed.has(id)) {
+        findings.push(
+          makeFinding({
+            collector: this.name,
+            ruleOrTestId: id,
+            targetFiles: [],
+            severity: FLAKY_SEVERITY,
+            confidence: 0.8,
+            verification: 0.6,
+            findingPayload: {
+              kind: 'flaky-test',
+              note: 'Failed in this run and in an earlier recorded run, but passed in the most recent prior run.',
+            },
+          }),
+        );
+      }
+    }
+    // Failed in the last recorded run but passes now: also flaky (intermittent).
+    for (const id of lastRunFailed) {
+      if (!failedIds.has(id) && previousRuns.length > 1 && previouslyFailed.has(id)) {
+        findings.push(
+          makeFinding({
+            collector: this.name,
+            ruleOrTestId: id,
+            targetFiles: [],
+            severity: FLAKY_SEVERITY,
+            confidence: 0.7,
+            verification: 0.6,
+            findingPayload: {
+              kind: 'flaky-test',
+              note: 'Failed in the most recent recorded run but passes now; intermittent failure.',
+            },
+          }),
+        );
+      }
+    }
+
+    // Record this run (best effort; a missing/unwritable .omnexx dir must not fail collection).
+    const nextHistory = [
+      ...previousRuns,
+      { at: new Date().toISOString(), failed: [...failedIds] },
+    ].slice(-MAX_HISTORY_RUNS);
+    try {
+      await mkdir(join(repoRoot, '.omnexx', 'discovery'), { recursive: true });
+      await writeFile(historyPath, `${JSON.stringify(nextHistory, null, 2)}\n`, 'utf8');
+    } catch {
+      // History is advisory only.
+    }
+    return findings;
+  }
+}
+
+/**
+ * Vitest prints the JSON report to stdout, but may prefix it with other output
+ * (e.g. warnings). Take the largest JSON-looking substring and parse that.
+ */
+function extractJsonReport(stdout: string): VitestJsonReport | undefined {
+  const trimmed = stdout.trim();
+  if (!trimmed) return undefined;
+  const direct = safeParse(trimmed);
+  if (direct) return direct;
+  const start = trimmed.indexOf('{');
+  const end = trimmed.lastIndexOf('}');
+  if (start === -1 || end <= start) return undefined;
+  return safeParse(trimmed.slice(start, end + 1));
+}
+
+function safeParse(text: string): VitestJsonReport | undefined {
+  try {
+    const parsed = JSON.parse(text) as VitestJsonReport;
+    if (Array.isArray(parsed.testResults)) return parsed;
+    return undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+/**
+ * Vitest's json reporter writes the report to `.vitest/json/output.json`
+ * instead of stdout in this repo's setup. Read it when stdout has no JSON,
+ * but only when the file was written by this run (mtime >= run start) so a
+ * stale report from an earlier run can't masquerade as current results.
+ */
+async function readReportFile(
+  repoRoot: string,
+  startedAt: number,
+): Promise<VitestJsonReport | undefined> {
+  const path = join(repoRoot, '.vitest', 'json', 'output.json');
+  try {
+    const info = await stat(path);
+    if (info.mtimeMs < startedAt - 1000) return undefined;
+    return safeParse(await readFile(path, 'utf8'));
+  } catch {
+    return undefined;
+  }
+}
diff --git a/src/autonomous/discovery/todo-mining.ts b/src/autonomous/discovery/todo-mining.ts
new file mode 100644
index 00000000..ab118d3e
--- /dev/null
+++ b/src/autonomous/discovery/todo-mining.ts
@@ -0,0 +1,83 @@
+import { git } from './common.js';
+import { makeFinding, type DiscoveryCollector, type RawFinding } from './index.js';
+
+/** Only markers younger than this are queued. */
+const MAX_AGE_DAYS = 90;
+/** A marker must reference a concrete symbol or issue id to be actionable. */
+const REFERENCE_PATTERN =
+  /(?:#\d+|[A-Z][A-Z0-9]+-\d+|`[A-Za-z_$][\w$]*`|\b[A-Za-z_$][\w$]*(?:\.[A-Za-z_$][\w$]*)+\b)/;
+
+/**
+ * Mines FIXME/BUG markers from `git grep`, enriched with `git blame` dates.
+ * Only markers younger than 90 days that reference a concrete symbol or
+ * issue id are queued — a bare TODO with no anchor is not actionable work.
+ */
+export class TodoMiningCollector implements DiscoveryCollector {
+  readonly name = 'todo_mining';
+
+  async collect(repoRoot: string): Promise<RawFinding[]> {
+    const findings: RawFinding[] = [];
+    const grep = await git(repoRoot, ['grep', '-nE', '(FIXME|BUG)', '--', '*.ts', '*.tsx', '*.js']);
+    if (!grep) return findings;
+
+    const now = Date.now();
+    for (const line of grep.split('\n')) {
+      // file.ts:123:  // FIXME: something (#456)
+      const match = /^(.+?):(\d+):(.*)$/.exec(line);
+      if (!match) continue;
+      const [, file, lineNo, text] = match as unknown as [string, string, string, string];
+      const trimmed = text.trim();
+      const kind = /\bBUG\b/.test(trimmed) ? 'BUG' : 'FIXME';
+      if (!REFERENCE_PATTERN.test(trimmed)) continue;
+
+      const blameDate = await this.blameDate(repoRoot, file, Number(lineNo));
+      if (!blameDate) continue;
+      const ageDays = (now - blameDate.getTime()) / (1000 * 60 * 60 * 24);
+      if (ageDays > MAX_AGE_DAYS) continue;
+
+      const symbol = REFERENCE_PATTERN.exec(trimmed)?.[0];
+      const findingInput: {
+        collector: string;
+        ruleOrTestId: string;
+        canonicalSymbol?: string;
+        targetFiles: string[];
+        severity: number;
+        confidence: number;
+        verification: number;
+        findingPayload: unknown;
+      } = {
+        collector: this.name,
+        ruleOrTestId: `todo:${file}:${lineNo}`,
+        targetFiles: [file],
+        severity: 0.5,
+        confidence: 0.85,
+        verification: 0.7,
+        findingPayload: {
+          kind: 'todo-marker',
+          marker: kind,
+          line: Number(lineNo),
+          ageDays: Math.round(ageDays * 10) / 10,
+          text: trimmed.slice(0, 300),
+          reference: symbol ?? null,
+        },
+      };
+      if (symbol !== undefined) findingInput.canonicalSymbol = symbol;
+      findings.push(makeFinding(findingInput));
+    }
+    return findings;
+  }
+
+  private async blameDate(repoRoot: string, file: string, lineNo: number): Promise<Date | null> {
+    const out = await git(repoRoot, [
+      'blame',
+      '-L',
+      `${lineNo},${lineNo}`,
+      '--porcelain',
+      '--',
+      file,
+    ]);
+    const match = /author-time (\d+)/.exec(out);
+    if (!match?.[1]) return null;
+    return new Date(Number(match[1]) * 1000);
+  }
+}
