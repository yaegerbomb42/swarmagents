+export const TOMBSTONE_COOLDOWNS_MS: readonly number[] = [
+  60 * 60 * 1000, // strike 1: 1h
+  6 * 60 * 60 * 1000, // strike 2: 6h
+  24 * 60 * 60 * 1000, // strike 3: 24h
+  7 * 24 * 60 * 60 * 1000, // strike 4: 7d
