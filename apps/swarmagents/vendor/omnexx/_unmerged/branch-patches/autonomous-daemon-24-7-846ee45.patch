+    store.tombstone({ fingerprint: 'fp-t', failure: tombstoneFailure() });
+    store.tombstone({ fingerprint: 'fp-t', failure: tombstoneFailure() });
+    const fifth = store.tombstone({ fingerprint: 'fp-t', failure: tombstoneFailure() });
+    expect(fifth.strikeCount).toBe(5);
+    expect(fifth.cooldownUntilMs).toBe(-1);
+  });
