+    expect(store.isDone('fp-redo')).toBe(true);
+    const again = store.enqueueTask(taskInput('fp-redo', 40));
+    expect(again.status).toBe('QUEUED');
+    expect(store.isDone('fp-redo')).toBe(true); // done-set row untouched
+  });
