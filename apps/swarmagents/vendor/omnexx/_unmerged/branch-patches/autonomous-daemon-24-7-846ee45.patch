+  // Non-zero usage so the budget-ledger assertions below can see the spend:
+  // 1500 tokens per call × 5 calls = 7500 tokens recorded.
+  usage: { uncached: 1000, cacheWrite5m: 0, cacheWrite1h: 0, cacheRead: 0, output: 500 },
+  model: 'scripted',
+});
