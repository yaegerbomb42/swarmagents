+
+  it('strike escalation is 1h → 6h → 24h → 7d → permanent', () => {
+    expect(TOMBSTONE_COOLDOWNS_MS).toEqual([HOUR, 6 * HOUR, 24 * HOUR, 7 * 24 * HOUR]);
+    expect(MAX_STRIKES_BEFORE_PERMANENT).toBe(5);
