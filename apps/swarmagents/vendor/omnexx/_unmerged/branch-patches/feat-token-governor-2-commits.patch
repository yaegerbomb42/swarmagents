@@ -0,0 +1,431 @@
+import { AsyncLocalStorage } from 'node:async_hooks';
+import { createHash } from 'node:crypto';
+import { appendFileSync, existsSync, mkdirSync, readFileSync } from 'node:fs';
+import { dirname } from 'node:path';
+import type { PriceConfig } from '../config/schema.js';
+import { costUsd } from '../providers/pricing.js';
+import {
+  budgetTokens,
+  totalInput,
+  type CompletionRequest,
+  type Provider,
+  type Usage,
+} from '../providers/types.js';
+
+/**
+ * The usage ledger: one append-only JSON line per model call, plus the waste the harness
+ * removes (a repeat read it answered with a pointer, a compaction that did not shrink).
+ *
+ * Every record carries the purpose of the call and the task/step it belongs to, so `omnexx
+ * usage` can answer "where did the tokens go?" without replaying a provider dashboard. The
+ * ledger is deliberately separate from events.jsonl: events are for people and tools to stream,
+ * the ledger is the billing-shaped record that survives crashes and is cheap to sum.
+ */
+
+export const CALL_PURPOSES = [
+  'main',
+  'subagent',
+  'retry',
+  'compaction',
+  'verification',
+  'reviewer',
+  'planner',
+  'judge',
+  'describe',
+  'chat',
+] as const;
+export type CallPurpose = (typeof CALL_PURPOSES)[number];
+
+export interface CallAttribution {
+  purpose: CallPurpose;
+  /** Plan task id, "plan", "chat", or "untasked" when there is no task. */
+  taskId: string;
+  /** Run cycle the call belongs to. */
+  cycle: number;
+  /** Turn number inside the current loop (1-based); 0 for side calls. */
+  step: number;
+  /** The provider role that asked for the call (worker, cheap, review, ...). */
+  label?: string;
+}
+
+const attribution = new AsyncLocalStorage<CallAttribution>();
+
+/** Thrown when a wrapped provider is called outside an attribution scope. */
+export class UntaggedCallError extends Error {
+  constructor(model: string) {
+    super(
+      `untagged LLM call (${model}): every provider call must run inside withCallAttribution()`,
+    );
+    this.name = 'UntaggedCallError';
+  }
+}
+
+export function withCallAttribution<T>(scope: CallAttribution, fn: () => Promise<T>): Promise<T> {
+  return attribution.run(scope, fn);
+}
+
+export function currentAttribution(): CallAttribution | undefined {
+  return attribution.getStore();
+}
+
+export interface UsageCallRecord {
+  kind: 'call';
+  id: string;
+  ts: number;
+  runId: string;
+  taskId: string;
+  cycle: number;
+  step: number;
+  purpose: CallPurpose;
+  label?: string;
+  provider: string;
+  model: string;
+  ok: boolean;
+  usage: Usage;
+  /** Raw input + output tokens, before cache discounts. */
+  tokens: number;
+  /** Tokens as they count against a budget (cache reads weighted like omnexx's cycle cap). */
+  budgetTokens: number;
+  usd: number;
+  ms: number;
+  requestHash: string;
+  retryOf?: string;
+  errorSignature?: string;
+  error?: string;
+}
+
+export type WasteKind = 'repeat_read' | 'compaction_no_shrink' | 'context_resend';
+
+export interface WasteRecord {
+  kind: 'waste';
+  id: string;
+  ts: number;
+  runId: string;
+  taskId: string;
+  cycle: number;
+  step: number;
+  waste: WasteKind;
+  /** Tokens the waste cost or saved (saved for repeat_read). */
+  tokens: number;
+  /** What happened, short enough for a terminal. */
+  detail: string;
+  path?: string;
+  /** Step where the earlier read/call happened, when there is one. */
+  sinceStep?: number;
+}
+
+export type LedgerRecord = UsageCallRecord | WasteRecord;
+
+export interface TaskTotals {
+  calls: number;
+  usd: number;
+  tokens: number;
+  budgetTokens: number;
+  input: number;
+  cacheRead: number;
+  output: number;
+}
+
+export const emptyTaskTotals = (): TaskTotals => ({
+  calls: 0,
+  usd: 0,
+  tokens: 0,
+  budgetTokens: 0,
+  input: 0,
+  cacheRead: 0,
+  output: 0,
+});
+
+const finite = (n: unknown): number =>
+  typeof n === 'number' && Number.isFinite(n) ? Math.max(0, n) : 0;
+
+/** The usage shape in a provider response, made safe for the ledger. */
+export function safeUsage(u: Partial<Usage> | undefined): Usage {
+  return {
+    uncached: finite(u?.uncached),
+    cacheWrite5m: finite(u?.cacheWrite5m),
+    cacheWrite1h: finite(u?.cacheWrite1h),
+    cacheRead: finite(u?.cacheRead),
+    output: finite(u?.output),
+  };
+}
+
+const countTokens = (u: Usage): number => totalInput(u) + finite(u.output);
+
+const shortHash = (text: string): string =>
+  createHash('sha256').update(text).digest('hex').slice(0, 16);
+
+/**
+ * A stable fingerprint of a request without storing its prompt. The same prompt sent again
+ * (a retry, a 400 re-ask, a repeat after failover) has the same hash and is labelled `retry`.
+ */
+export function requestFingerprint(
+  req: Pick<CompletionRequest, 'model' | 'system' | 'tools' | 'messages'>,
+): string {
+  return shortHash(JSON.stringify([req.model, req.system, req.tools, req.messages]));
+}
+
+/** Error identity for "retried with the same error signature". */
+export function errorSignature(err: unknown): string {
+  const e = err as { message?: unknown; status?: unknown; name?: unknown };
+  const status = typeof e.status === 'number' ? `${e.status} ` : '';
+  const name = typeof e.name === 'string' && e.name !== 'Error' ? `${e.name}: ` : '';
+  const message = typeof e.message === 'string' ? e.message : String(err);
+  const normalized = message
+    .replace(/\b\d{2,}\b/g, '<n>')
+    .replace(/[0-9a-f]{8,}/gi, '<hex>')
+    .replace(/\s+/g, ' ')
+    .trim()
+    .slice(0, 240);
+  return `${status}${name}${normalized}`;
+}
+
+/** Map the existing role strings (used by cheapComplete and the loop) to a ledger purpose. */
+export function purposeForRole(role: string | undefined): CallPurpose {
+  switch (role) {
+    case 'subagent':
+      return 'subagent';
+    case 'compaction':
+    case 'cheap':
+      return 'compaction';
+    case 'review':
+    case 'audit':
+    case 'spec_judge':
+    case 'judge':
+      return 'reviewer';
+    case 'spec_tests':
+    case 'repro_test':
+    case 'verification':
+      return 'verification';
+    case 'planner':
+      return 'planner';
+    case 'describe':
+      return 'describe';
+    case 'chat':
+      return 'chat';
+    case 'retry':
+      return 'retry';
+    default:
+      return 'main';
+  }
+}
+
+export class UsageLedger {
+  private readonly totals = new Map<string, TaskTotals>();
+  private loaded = false;
+  private seq = 0;
+  private dirReady = false;
+
+  constructor(
+    readonly path: string,
+    readonly runId: string,
+  ) {}
+
+  /** Create the directory once, so the first append is not a lost record on a fresh run. */
+  private ensureDir(): void {
+    if (this.dirReady) return;
+    mkdirSync(dirname(this.path), { recursive: true, mode: 0o700 });
+    this.dirReady = true;
+  }
+
+  /** Load totals from an earlier process once; a resumed run keeps its task caps honest. */
+  private ensureLoaded(): void {
+    if (this.loaded) return;
+    this.loaded = true;
+    if (!existsSync(this.path)) return;
+    for (const record of parseLedger(readFileSync(this.path, 'utf8'))) {
+      this.addToTotals(record);
+      this.seq++;
+    }
+  }
+
+  private addToTotals(record: LedgerRecord): void {
+    if (record.kind !== 'call') return;
+    const t = this.totals.get(record.taskId) ?? emptyTaskTotals();
+    t.calls++;
+    t.usd += finite(record.usd);
+    t.tokens += finite(record.tokens);
+    t.budgetTokens += finite(record.budgetTokens);
+    t.input += totalInput(record.usage);
+    t.cacheRead += finite(record.usage.cacheRead);
+    t.output += finite(record.usage.output);
+    this.totals.set(record.taskId, t);
+  }
+
+  append(record: LedgerRecord): void {
+    this.ensureLoaded();
+    this.ensureDir();
+    appendFileSync(this.path, `${JSON.stringify(record)}\n`, { mode: 0o600 });
+    this.addToTotals(record);
+  }
+
+  private id(kind: string, ts: number): string {
+    this.seq++;
+    return `${this.runId}:${String(ts)}:${String(this.seq)}:${kind}`;
+  }
+
+  recordCall(
+    data: Omit<UsageCallRecord, 'kind' | 'id' | 'ts' | 'runId' | 'tokens' | 'budgetTokens'> & {
+      ts?: number;
+    },
+  ): UsageCallRecord {
+    const ts = data.ts ?? Date.now();
+    const usage = safeUsage(data.usage);
+    const record: UsageCallRecord = {
+      kind: 'call',
+      id: this.id('c', ts),
+      ts,
+      runId: this.runId,
+      ...data,
+      usage,
+      tokens: countTokens(usage),
+      budgetTokens: budgetTokens(usage),
+    };
+    this.append(record);
+    return record;
+  }
+
+  recordWaste(
+    data: Omit<WasteRecord, 'kind' | 'id' | 'ts' | 'runId'> & { ts?: number },
+  ): WasteRecord {
+    const ts = data.ts ?? Date.now();
+    const record: WasteRecord = {
+      kind: 'waste',
+      id: this.id('w', ts),
+      ts,
+      runId: this.runId,
+      ...data,
+    };
+    this.append(record);
+    return record;
+  }
+
+  /** Spend for one task from the ledger, including calls made before a resume. */
+  taskTotals(taskId: string): TaskTotals {
+    this.ensureLoaded();
+    return this.totals.get(taskId) ?? emptyTaskTotals();
+  }
+
+  allTotals(): ReadonlyMap<string, TaskTotals> {
+    this.ensureLoaded();
+    return this.totals;
+  }
+
+  /** The current file contents; [] when the run has not made a call yet. */
+  read(): LedgerRecord[] {
+    if (!existsSync(this.path)) return [];
+    return parseLedger(readFileSync(this.path, 'utf8'));
+  }
+}
+
+export function parseLedger(text: string): LedgerRecord[] {
+  const out: LedgerRecord[] = [];
+  for (const line of text.split('\n')) {
+    if (!line.trim()) continue;
+    try {
+      const parsed: unknown = JSON.parse(line);
+      if (typeof parsed === 'object' && parsed !== null) {
+        const { kind } = parsed as { kind?: unknown };
+        if (kind === 'call' || kind === 'waste') out.push(parsed as LedgerRecord);
+      }
+    } catch {
+      // A torn last line from a crash is skipped; every earlier record is intact.
+    }
+  }
+  return out;
+}
+
+export interface UsageLedgerOptions {
+  ledger: UsageLedger;
+  /** Resolve a model's price for the USD figure; unknown models record $0. */
+  priceFor?: (provider: string, model: string) => PriceConfig | undefined;
+  now?: () => number;
+}
+
+/**
+ * Wrap a provider so every call is attributed and recorded. It never changes the request or
+ * response. A call with no attribution throws before hitting the network: that is the test
+ * that proves no call can silently escape the ledger.
+ *
+ * A Proxy forwards the inner provider's other properties (tests and diagnostics use them), so
+ * wrapping a scripted provider never hides `requests` or provider-specific fields.
+ */
+export function withUsageLedger(inner: Provider, opts: UsageLedgerOptions): Provider {
+  const now = opts.now ?? Date.now;
+  /** Last failure by task + request hash: the next identical call is a retry of it. */
+  const failures = new Map<string, { signature: string; at: number }>();
+
+  const complete = async (req: CompletionRequest) => {
+    const scope = currentAttribution();
+    if (!scope) throw new UntaggedCallError(req.model);
+    const requestHash = requestFingerprint(req);
+    const key = `${scope.taskId}:${requestHash}`;
+    const prior = failures.get(key);
+    const effective = prior
+      ? {
+          ...scope,
+          purpose: 'retry' as const,
+          label: scope.label ?? 'retry',
+        }
+      : scope;
+    const provider = req.route ?? inner.name;
+    const started = now();
+    try {
+      const res = await inner.complete(req);
+      const usage = safeUsage(res.usage);
+      const price = opts.priceFor?.(provider, res.model);
+      opts.ledger.recordCall({
+        ts: started,
+        taskId: effective.taskId,
+        cycle: effective.cycle,
+        step: effective.step,
+        purpose: effective.purpose,
+        ...(effective.label ? { label: effective.label } : {}),
+        provider,
+        model: res.model,
+        ok: true,
+        usage,
+        usd: price ? costUsd(usage, price) : 0,
+        ms: now() - started,
+        requestHash,
+        ...(prior ? { retryOf: requestHash, errorSignature: prior.signature } : {}),
+      });
+      failures.delete(key);
+      return res;
+    } catch (err) {
+      const signature = errorSignature(err);
+      failures.set(key, { signature, at: now() });
+      opts.ledger.recordCall({
+        ts: started,
+        taskId: effective.taskId,
+        cycle: effective.cycle,
+        step: effective.step,
+        purpose: effective.purpose,
+        ...(effective.label ? { label: effective.label } : {}),
+        provider,
+        model: req.model,
+        ok: false,
+        usage: safeUsage(undefined),
+        usd: 0,
+        ms: now() - started,
+        requestHash,
+        errorSignature: signature,
+        error: signature,
+        ...(prior ? { retryOf: requestHash } : {}),
+      });
+      throw err;
+    }
+  };
+
+  return new Proxy(inner, {
+    get(target, prop) {
+      if (prop === 'complete') return complete;
+      const value: unknown = Reflect.get(target, prop, target);
+      // Bind methods to the real provider: a class with private fields breaks when `this` is
+      // the proxy. Plain data (`requests`, `name`) comes through unchanged.
+      return typeof value === 'function'
+        ? (value as (...args: unknown[]) => unknown).bind(target)
+        : value;
+    },
+  });
+}
diff --git a/src/usage/report.ts b/src/usage/report.ts
new file mode 100644
index 00000000..389a7416
--- /dev/null
+++ b/src/usage/report.ts
@@ -0,0 +1,278 @@
+import type { LedgerRecord, TaskTotals, UsageCallRecord, WasteRecord } from './ledger.js';
+
+/** Pure aggregation for `omnexx usage`: records in, a breakdown (and its waste section) out. */
+
+export interface UsageFilter {
+  taskId?: string;
+  runId?: string;
+}
+
+export interface PurposeRow {
+  purpose: string;
+  calls: number;
+  tokens: number;
+  usd: number;
+  share: number;
+}
+
+export interface TaskRow {
+  taskId: string;
+  calls: number;
+  tokens: number;
+  usd: number;
+}
+
+export interface StepRow {
+  taskId: string;
+  step: number;
+  calls: number;
+  tokens: number;
+  usd: number;
+}
+
+export interface RepeatReadRow {
+  path: string;
+  count: number;
+  tokens: number;
+  lastStep: number;
+}
+
+export interface RetryRow {
+  signature: string;
+  calls: number;
+  tokens: number;
+}
+
+export interface UsageWaste {
+  repeatReads: {
+    count: number;
+    tokens: number;
+    paths: RepeatReadRow[];
+  };
+  retries: {
+    calls: number;
+    tokens: number;
+    signatures: RetryRow[];
+  };
+  compactions: {
+    count: number;
+    tokens: number;
+    details: string[];
+  };
+  contextResent: {
+    calls: number;
+    tokens: number;
+  };
+  /** Retries + non-shrinking compactions: spend the harness can prevent. Repeat reads are the
+   * other side of the ledger: tokens the guard saved, not tokens wasted. */
+  avoidableTokens: number;
+}
+
+export interface UsageBreakdown {
+  runIds: string[];
+  taskIds: string[];
+  calls: number;
+  tokens: { total: number; input: number; cacheRead: number; output: number };
+  usd: number;
+  byPurpose: PurposeRow[];
+  byTask: TaskRow[];
+  byModel: TaskRow[];
+  steps: StepRow[];
+  waste: UsageWaste;
+  /** Sum of the ledger's budget-weighted tokens for the selected tasks. */
+  budgetTokens: number;
+}
+
+const n = (v: unknown): number =>
+  typeof v === 'number' && Number.isFinite(v) ? Math.max(0, v) : 0;
+const share = (part: number, whole: number): number => (whole > 0 ? part / whole : 0);
+
+function matches(record: LedgerRecord, filter: UsageFilter): boolean {
+  if (filter.runId !== undefined && record.runId !== filter.runId) return false;
+  if (filter.taskId !== undefined && record.taskId !== filter.taskId) return false;
+  return true;
+}
+
+/** Group rows by a key, summing calls/tokens/usd, then sort largest token share first. */
+function groupCalls(
+  records: readonly UsageCallRecord[],
+  key: (r: UsageCallRecord) => string,
+  make: (
+    k: string,
+    calls: number,
+    tokens: number,
+    usd: number,
+  ) => { calls: number; tokens: number; usd: number },
+): { key: string; calls: number; tokens: number; usd: number }[] {
+  const groups = new Map<string, { calls: number; tokens: number; usd: number }>();
+  for (const r of records) {
+    const k = key(r);
+    const g = groups.get(k) ?? { calls: 0, tokens: 0, usd: 0 };
+    g.calls++;
+    g.tokens += n(r.tokens);
+    g.usd += n(r.usd);
+    groups.set(k, g);
+  }
+  return [...groups.entries()]
+    .map(([k, g]) => ({ key: k, ...make(k, g.calls, g.tokens, g.usd) }))
+    .sort((a, b) => b.tokens - a.tokens || a.key.localeCompare(b.key));
+}
+
+export function aggregateUsage(
+  records: readonly LedgerRecord[],
+  filter: UsageFilter = {},
+): UsageBreakdown {
+  const selected = records.filter((r) => matches(r, filter));
+  const calls = selected.filter((r): r is UsageCallRecord => r.kind === 'call');
+  const wasteRecords = selected.filter((r): r is WasteRecord => r.kind === 'waste');
+  const totalTokens = calls.reduce((s, r) => s + n(r.tokens), 0);
+  const input = calls.reduce(
+    (s, r) =>
+      s +
+      n(r.usage.uncached) +
+      n(r.usage.cacheWrite5m) +
+      n(r.usage.cacheWrite1h) +
+      n(r.usage.cacheRead),
+    0,
+  );
+  const cacheRead = calls.reduce((s, r) => s + n(r.usage.cacheRead), 0);
+  const output = calls.reduce((s, r) => s + n(r.usage.output), 0);
+  const usd = calls.reduce((s, r) => s + n(r.usd), 0);
+  const budget = calls.reduce((s, r) => s + n(r.budgetTokens), 0);
+
+  const byPurpose = groupCalls(
+    calls,
+    (r) => r.purpose,
+    (_k, callCount, tokens, spend) => ({
+      calls: callCount,
+      tokens,
+      usd: spend,
+      share: share(tokens, totalTokens),
+    }),
+  ).map((r) => ({
+    purpose: r.key,
+    calls: r.calls,
+    tokens: r.tokens,
+    usd: r.usd,
+    share: (r as unknown as { share: number }).share,
+  }));
+
+  const byTask = groupCalls(
+    calls,
+    (r) => r.taskId,
+    (_k, callCount, tokens, spend) => ({ calls: callCount, tokens, usd: spend }),
+  ).map((r) => ({ taskId: r.key, calls: r.calls, tokens: r.tokens, usd: r.usd }));
+
+  const byModel = groupCalls(
+    calls,
+    (r) => `${r.provider}:${r.model}`,
+    (_k, callCount, tokens, spend) => ({ calls: callCount, tokens, usd: spend }),
+  ).map((r) => ({ taskId: r.key, calls: r.calls, tokens: r.tokens, usd: r.usd }));
+
+  const steps = groupCalls(
+    calls,
+    (r) => `${r.taskId}\u0000${String(r.step)}`,
+    (_k, callCount, tokens, spend) => ({ calls: callCount, tokens, usd: spend }),
+  ).map((r) => {
+    const [taskId = '', step = '0'] = r.key.split('\u0000');
+    return { taskId, step: Number(step), calls: r.calls, tokens: r.tokens, usd: r.usd };
+  });
+
+  const repeatByPath = new Map<string, RepeatReadRow>();
+  let repeatCount = 0;
+  let repeatTokens = 0;
+  const compactionDetails: string[] = [];
+  let compactionCount = 0;
+  let compactionTokens = 0;
+  for (const r of wasteRecords) {
+    if (r.waste === 'repeat_read') {
+      repeatCount++;
+      repeatTokens += n(r.tokens);
+      const path = r.path ?? '?';
+      const row = repeatByPath.get(path) ?? { path, count: 0, tokens: 0, lastStep: 0 };
+      row.count++;
+      row.tokens += n(r.tokens);
+      row.lastStep = Math.max(row.lastStep, n(r.step));
+      repeatByPath.set(path, row);
+    } else if (r.waste === 'compaction_no_shrink') {
+      compactionCount++;
+      compactionTokens += n(r.tokens);
+      if (compactionDetails.length < 8) compactionDetails.push(r.detail);
+    }
+  }
+
+  const retryBySignature = new Map<string, RetryRow>();
+  let retryCalls = 0;
+  let retryTokens = 0;
+  for (const r of calls) {
+    if (r.purpose !== 'retry' && r.retryOf === undefined) continue;
+    retryCalls++;
+    retryTokens += n(r.tokens);
+    const signature = r.errorSignature ?? 'same request (no error recorded)';
+    const row = retryBySignature.get(signature) ?? { signature, calls: 0, tokens: 0 };
+    row.calls++;
+    row.tokens += n(r.tokens);
+    retryBySignature.set(signature, row);
+  }
+
+  return {
+    runIds: [...new Set(selected.map((r) => r.runId))].sort(),
+    taskIds: [...new Set(selected.map((r) => r.taskId))].sort(),
+    calls: calls.length,
+    tokens: { total: totalTokens, input, cacheRead, output },
+    usd,
+    budgetTokens: budget,
+    byPurpose,
+    byTask,
+    byModel,
+    steps: steps.sort((a, b) => b.tokens - a.tokens),
+    waste: {
+      repeatReads: {
+        count: repeatCount,
+        tokens: repeatTokens,
+        paths: [...repeatByPath.values()].sort((a, b) => b.tokens - a.tokens),
+      },
+      retries: {
+        calls: retryCalls,
+        tokens: retryTokens,
+        signatures: [...retryBySignature.values()].sort(
+          (a, b) => b.tokens - a.tokens || b.calls - a.calls,
+        ),
+      },
+      compactions: { count: compactionCount, tokens: compactionTokens, details: compactionDetails },
+      contextResent: {
+        calls: calls.filter((r) => n(r.usage.cacheRead) > 0).length,
+        tokens: cacheRead,
+      },
+      avoidableTokens: retryTokens + compactionTokens,
+    },
+  };
+}
+
+/** A one-line totals view shared by `status --json` and the TUI. */
+export function usageTotals(
+  records: readonly LedgerRecord[],
+  filter: UsageFilter = {},
+): TaskTotals {
+  const d = aggregateUsage(records, filter);
+  return {
+    calls: d.calls,
+    usd: d.usd,
+    tokens: d.tokens.total,
+    budgetTokens: d.budgetTokens,
+    input: d.tokens.input,
+    cacheRead: d.tokens.cacheRead,
+    output: d.tokens.output,
+  };
+}
+
+export const fmtUsd = (usd: number): string =>
+  usd < 1 ? `$${usd.toFixed(3)}` : `$${usd.toFixed(2)}`;
+
+export function fmtTokens(tokens: number): string {
+  if (tokens >= 1_000_000) return `${(tokens / 1_000_000).toFixed(2)}M`;
+  if (tokens >= 1_000) return `${(tokens / 1_000).toFixed(1)}k`;
+  return String(Math.round(tokens));
+}
+
+export const pct = (v: number): string => `${Math.round(v * 100)}%`;
