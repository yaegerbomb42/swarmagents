+      plainTokens += estimateTokens(without.content);
+    }
+    // 1 full read + 11 pointers instead of 12 full reads: the benchmark target is 20%.
+    expect(guardedTokens).toBeLessThanOrEqual(plainTokens * 0.8);
+  });
 });
 
