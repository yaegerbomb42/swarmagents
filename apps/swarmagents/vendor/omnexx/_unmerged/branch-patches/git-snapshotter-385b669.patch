--- /dev/null
+++ b/src/agent/runtime/checkpoint.ts
@@ -0,0 +1,94 @@
+import { execFile } from 'node:child_process';
+import { randomUUID } from 'node:crypto';
+import { rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+
+export interface Snapshot {
+  treeSha: string;
+  timestamp: number;
+}
+
+const MAX_GIT_OUTPUT_BYTES = 16 * 1024 * 1024;
+
+/**
+ * A throwaway git-tree snapshotter.
+ *
+ * Snapshots and restores the working tree (including untracked files) through an isolated
+ * `GIT_INDEX_FILE`, so the user's real `.git/index`, `HEAD`, and branch refs are never touched.
+ * The `index` is created under the OS temp dir and removed in a `finally` block.
+ */
+export class GitTreeSnapshotter {
+  constructor(private readonly repoRoot: string) {}
+
+  /** Capture the working tree + untracked files as a tree, returning its SHA. */
+  async snapshot(): Promise<Snapshot> {
+    const indexPath = this.newIndexPath();
+    try {
+      await this.git(indexPath, ['read-tree', 'HEAD']);
+      await this.git(indexPath, ['add', '-A']);
+      const treeSha = await this.git(indexPath, ['write-tree']);
+      return { treeSha, timestamp: Date.now() };
+    } finally {
+      await rm(indexPath, { force: true }).catch(() => undefined);
+    }
+  }
+
+  /** Reset the working tree to a previously captured snapshot. */
+  async restore(snapshot: Snapshot): Promise<void> {
+    const indexPath = this.newIndexPath();
+    try {
+      await this.git(indexPath, ['read-tree', snapshot.treeSha]);
+      await this.git(indexPath, ['checkout-index', `--prefix=${this.repoRoot}/`, '-a', '-f']);
+      await this.removeUntracked(indexPath);
+    } finally {
+      await rm(indexPath, { force: true }).catch(() => undefined);
+    }
+  }
+
+  private newIndexPath(): string {
+    return path.join(tmpdir(), `omnexx-snap-${randomUUID()}.index`);
+  }
+
+  /** Run a git command against the throwaway index file. */
+  private git(indexPath: string, args: readonly string[]): Promise<string> {
+    return new Promise((resolve, reject) => {
+      execFile(
+        'git',
+        [...args],
+        {
+          cwd: this.repoRoot,
+          env: { ...process.env, GIT_INDEX_FILE: indexPath },
+          maxBuffer: MAX_GIT_OUTPUT_BYTES,
+        },
+        (error, stdout, stderr) => {
+          if (error) {
+            reject(
+              new Error(`git ${args.join(' ')} failed: ${(stderr || '').trim() || error.message}`),
+            );
+            return;
+          }
+          resolve(stdout.trim());
+        },
+      );
+    });
+  }
+
+  /**
+   * Delete working-tree files that are not present in the snapshot tree. Because the throwaway
+   * index holds the snapshot tree, `git ls-files --others` lists exactly the files created
+   * after the snapshot — those get removed so restore() fully reverts the tree.
+   */
+  private async removeUntracked(indexPath: string): Promise<void> {
+    const out = await this.git(indexPath, ['ls-files', '--others', '--exclude-standard', '-z']);
+    if (!out) return;
+    const root = path.resolve(this.repoRoot);
+    const prefix = `${root}${path.sep}`;
+    for (const relative of out.split('\0')) {
+      if (!relative) continue;
+      const abs = path.resolve(root, relative);
+      if (!abs.startsWith(prefix) && abs !== root) continue;
+      await rm(abs, { force: true }).catch(() => undefined);
+    }
+  }
+}
diff --git a/src/agent/runtime/micro-compaction.ts b/src/agent/runtime/micro-compaction.ts
new file mode 100644
index 00000000..101a4947
--- /dev/null
+++ b/src/agent/runtime/micro-compaction.ts
@@ -0,0 +1,162 @@
+import type { Message } from '../../providers/types.js';
+
+export interface MicroCompactOptions {
+  /**
+   * Number of trailing messages protected from mutation (hot recent turns).
+   * Default: 6.
+   */
+  hotWindowSize?: number;
+
+  /**
+   * Maximum character ceiling for cold tool results before middle truncation.
+   * Default: 2,000 chars.
+   */
+  maxColdChars?: number;
+
+  /**
+   * Compaction stride: only compact when turnIndex % stride === 0.
+   * Default: 4.
+   */
+  stride?: number;
+
+  /**
+   * Active turn index.
+   */
+  turnIndex: number;
+}
+
+export interface MicroCompactResult {
+  compacted: boolean;
+  messages: Message[];
+  charsSaved: number;
+  rulesApplied: {
+    supersededReads: number;
+    collapsedErrors: number;
+    truncatedColdOutputs: number;
+  };
+}
+
+/**
+ * Micro-Amortized History Compaction (Step 3.5)
+ *
+ * Runs on a periodic stride (every N turns) strictly outside the pinned prefix (Slot 0-6)
+ * and the hot recent interaction window, pruning dead tokens before they inflate context.
+ */
+export function microCompact(
+  messages: readonly Message[],
+  options: MicroCompactOptions,
+): MicroCompactResult {
+  const stride = options.stride ?? 4;
+  if (stride > 1 && options.turnIndex % stride !== 0) {
+    return {
+      compacted: false,
+      messages: [...messages],
+      charsSaved: 0,
+      rulesApplied: { supersededReads: 0, collapsedErrors: 0, truncatedColdOutputs: 0 },
+    };
+  }
+
+  const hotWindowSize = Math.max(2, options.hotWindowSize ?? 6);
+  const maxColdChars = Math.max(500, options.maxColdChars ?? 2_000);
+
+  // If messages don't exceed the frozen anchor (1) + hot window, skip
+  if (messages.length <= 1 + hotWindowSize) {
+    return {
+      compacted: false,
+      messages: [...messages],
+      charsSaved: 0,
+      rulesApplied: { supersededReads: 0, collapsedErrors: 0, truncatedColdOutputs: 0 },
+    };
+  }
+
+  const coldEndIndex = messages.length - hotWindowSize;
+
+  // Track all tool uses across the entire conversation by toolUseId and by signature
+  const toolUseById = new Map<string, { name: string; sig: string; msgIdx: number }>();
+  const toolCallSignatures = new Map<string, number[]>(); // signature -> message indices
+
+  for (let mIdx = 0; mIdx < messages.length; mIdx++) {
+    const msg = messages[mIdx];
+    if (!msg) continue;
+    for (const block of msg.content) {
+      if (block.type === 'tool_use') {
+        const sig = `${block.name}:${JSON.stringify(block.input ?? {})}`;
+        toolUseById.set(block.id, { name: block.name, sig, msgIdx: mIdx });
+        const existing = toolCallSignatures.get(sig) ?? [];
+        existing.push(mIdx);
+        toolCallSignatures.set(sig, existing);
+      }
+    }
+  }
+
+  let totalCharsSaved = 0;
+  let supersededReads = 0;
+  let collapsedErrors = 0;
+  let truncatedColdOutputs = 0;
+
+  // Deep clone candidate cold messages
+  const nextMessages: Message[] = messages.map((m) => ({
+    role: m.role,
+    content: m.content.map((b) => ({ ...b })),
+  }));
+
+  // Iterate strictly through the cold zone [1 .. coldEndIndex - 1]
+  for (let mIdx = 1; mIdx < coldEndIndex; mIdx++) {
+    const msg = nextMessages[mIdx];
+    if (!msg) continue;
+
+    for (const block of msg.content) {
+      if (block.type !== 'tool_result') continue;
+
+      const initialLength = block.content.length;
+      const useInfo = toolUseById.get(block.toolUseId);
+
+      // Rule A: Check if THIS specific tool call was superseded by an identical read/search later
+      if (
+        useInfo &&
+        (useInfo.name === 'read_file' || useInfo.name === 'read' || useInfo.name === 'search')
+      ) {
+        const sameCallIndices = toolCallSignatures.get(useInfo.sig) ?? [];
+        const hasLaterInstance = sameCallIndices.some((idx) => idx > useInfo.msgIdx);
+        if (hasLaterInstance && block.content.length > 200) {
+          block.content = '[μc] superseded: identical read/search call repeated in later turn';
+          supersededReads++;
+          totalCharsSaved += initialLength - block.content.length;
+          continue;
+        }
+      }
+
+      // Rule B: Collapse verbose error traces if a subsequent turn succeeded
+      if (block.isError && block.content.length > 300) {
+        const lines = block.content.split('\n').filter((l) => l.trim().length > 0);
+        const firstLine = lines[0] ?? 'Command failed';
+        block.content = `[μc] resolved error: ${firstLine.slice(0, 160)}`;
+        collapsedErrors++;
+        totalCharsSaved += initialLength - block.content.length;
+        continue;
+      }
+
+      // Rule C: Truncate cold outputs exceeding maxColdChars
+      if (block.content.length > maxColdChars) {
+        const head = block.content.slice(0, 1_000);
+        const tail = block.content.slice(-400);
+        const omitted = block.content.length - 1_400;
+        block.content = `${head}\n[... truncated by micro-compaction: ${String(omitted)} cold characters omitted ...]\n${tail}`;
+        truncatedColdOutputs++;
+        totalCharsSaved += initialLength - block.content.length;
+      }
+    }
+  }
+
+  const compacted = totalCharsSaved > 0;
+  return {
+    compacted,
+    messages: nextMessages,
+    charsSaved: totalCharsSaved,
+    rulesApplied: {
+      supersededReads,
+      collapsedErrors,
+      truncatedColdOutputs,
+    },
+  };
+}
diff --git a/test/unit/agent/checkpoint.test.ts b/test/unit/agent/checkpoint.test.ts
new file mode 100644
index 00000000..6e05e979
--- /dev/null
+++ b/test/unit/agent/checkpoint.test.ts
@@ -0,0 +1,98 @@
+import { execFile } from 'node:child_process';
+import { mkdir, mkdtemp, readFile, rm, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { afterEach, describe, expect, it } from 'vitest';
+import { GitTreeSnapshotter } from '../../../src/agent/runtime/checkpoint.js';
+
+const roots: string[] = [];
+
+async function runGit(repoDir: string, args: readonly string[]): Promise<string> {
+  return new Promise((resolve, reject) => {
+    execFile('git', [...args], { cwd: repoDir }, (err, stdout, stderr) => {
+      if (err) reject(new Error(`git ${args.join(' ')} failed: ${stderr.trim()}`));
+      else resolve(stdout);
+    });
+  });
+}
+
+/** Create an empty git repo with one initial commit containing seed.txt. */
+async function makeRepo(): Promise<string> {
+  const root = await mkdtemp(path.join(tmpdir(), 'omnexx-snap-'));
+  roots.push(root);
+  await runGit(root, ['init', '-q']);
+  await runGit(root, ['config', 'user.email', 'test@omnexx.dev']);
+  await runGit(root, ['config', 'user.name', 'test']);
+  await writeFile(path.join(root, 'seed.txt'), 'v1\n');
+  await runGit(root, ['add', '-A']);
+  await runGit(root, ['commit', '-qm', 'init']);
+  return root;
+}
+
+afterEach(async () => {
+  await Promise.all(roots.splice(0).map((root) => rm(root, { recursive: true, force: true })));
+});
+
+describe('GitTreeSnapshotter', () => {
+  it('captures uncommitted changes in the snapshot tree', async () => {
+    const repoRoot = await makeRepo();
+    const snap = new GitTreeSnapshotter(repoRoot);
+
+    // Make an uncommitted change before snapshotting.
+    await writeFile(path.join(repoRoot, 'seed.txt'), 'v2\n');
+
+    const snapshot = await snap.snapshot();
+
+    expect(snapshot.treeSha).toMatch(/^[0-9a-f]{40}$/);
+    expect(snapshot.timestamp).toBeGreaterThan(0);
+
+    // Restoring must reproduce the modified content, proving the change is captured.
+    await snap.restore(snapshot);
+    expect(await readFile(path.join(repoRoot, 'seed.txt'), 'utf8')).toBe('v2\n');
+  });
+
+  it('restore() resets the tree and deletes newly created untracked files', async () => {
+    const repoRoot = await makeRepo();
+    const snap = new GitTreeSnapshotter(repoRoot);
+    const snapshot = await snap.snapshot();
+
+    // Mutate a tracked file and create an untracked file (and a nested one).
+    await writeFile(path.join(repoRoot, 'seed.txt'), 'changed\n');
+    await writeFile(path.join(repoRoot, 'new.txt'), 'untracked\n');
+    await mkdir(path.join(repoRoot, 'sub'));
+    await writeFile(path.join(repoRoot, 'sub', 'nested.txt'), 'nested\n');
+
+    await snap.restore(snapshot);
+
+    expect(await readFile(path.join(repoRoot, 'seed.txt'), 'utf8')).toBe('v1\n');
+    await expect(readFile(path.join(repoRoot, 'new.txt'))).rejects.toThrow();
+    await expect(readFile(path.join(repoRoot, 'sub', 'nested.txt'))).rejects.toThrow();
+  });
+
+  it('restore() keeps files that exist in the snapshot', async () => {
+    const repoRoot = await makeRepo();
+    await writeFile(path.join(repoRoot, 'keep.txt'), 'keep\n');
+    const snap = new GitTreeSnapshotter(repoRoot);
+    const snapshot = await snap.snapshot();
+
+    await writeFile(path.join(repoRoot, 'keep.txt'), 'changed\n');
+    await snap.restore(snapshot);
+
+    expect(await readFile(path.join(repoRoot, 'keep.txt'), 'utf8')).toBe('keep\n');
+  });
+
+  it('completes a full snapshot + restore cycle in under 100ms', async () => {
+    const repoRoot = await makeRepo();
+    const snap = new GitTreeSnapshotter(repoRoot);
+
+    // Warm up git on the first run so the timed cycle measures steady-state cost.
+    await snap.restore(await snap.snapshot());
+
+    const start = performance.now();
+    const snapshot = await snap.snapshot();
+    await snap.restore(snapshot);
+    const elapsed = performance.now() - start;
+
+    expect(elapsed).toBeLessThan(100);
+  });
+});
diff --git a/test/unit/agent/micro-compaction.test.ts b/test/unit/agent/micro-compaction.test.ts
new file mode 100644
index 00000000..a61e7e7b
--- /dev/null
+++ b/test/unit/agent/micro-compaction.test.ts
@@ -0,0 +1,111 @@
+import { describe, expect, it } from 'vitest';
+import { microCompact } from '../../../src/agent/runtime/micro-compaction.js';
+import type { Message } from '../../../src/providers/types.js';
+
+describe('Step 3.5: Micro-Amortized History Compaction (micro-compaction.ts)', () => {
+  const makeConversation = (): Message[] => [
+    // Message 0: Frozen anchor
+    { role: 'user', content: [{ type: 'text', text: 'Task M1.T01' }] },
+    // Turn 1 (Cold): Read file
+    {
+      role: 'assistant',
+      content: [{ type: 'tool_use', id: 'read_1', name: 'read_file', input: { path: 'a.ts' } }],
+    },
+    {
+      role: 'user',
+      content: [
+        {
+          type: 'tool_result',
+          toolUseId: 'read_1',
+          content: 'line 1\nline 2\n' + 'a'.repeat(500),
+        },
+      ],
+    },
+    // Turn 2 (Cold): Verbose build error
+    {
+      role: 'assistant',
+      content: [{ type: 'tool_use', id: 'bash_1', name: 'bash', input: { command: 'npm test' } }],
+    },
+    {
+      role: 'user',
+      content: [
+        {
+          type: 'tool_result',
+          toolUseId: 'bash_1',
+          content:
+            'FAIL src/app.test.ts\nError: Assert failed at Object.<anonymous> (test.ts:45)\n' +
+            '    at runTest (runner.js:12)\n'.repeat(20),
+          isError: true,
+        },
+      ],
+    },
+    // Turn 3 (Cold): Huge output
+    {
+      role: 'assistant',
+      content: [{ type: 'tool_use', id: 'bash_huge', name: 'bash', input: { command: 'cat huge.log' } }],
+    },
+    {
+      role: 'user',
+      content: [
+        {
+          type: 'tool_result',
+          toolUseId: 'bash_huge',
+          content: 'LOG START: ' + 'x'.repeat(4000) + ' LOG END',
+        },
+      ],
+    },
+    // Turn 4 (Hot): Second identical read of a.ts
+    {
+      role: 'assistant',
+      content: [{ type: 'tool_use', id: 'read_2', name: 'read_file', input: { path: 'a.ts' } }],
+    },
+    {
+      role: 'user',
+      content: [
+        {
+          type: 'tool_result',
+          toolUseId: 'read_2',
+          content: 'HOT READ RESULT: line 1\nline 2\n' + 'a'.repeat(500),
+        },
+      ],
+    },
+  ];
+
+  it('respects compaction stride and skips non-stride turns', () => {
+    const messages = makeConversation();
+    const result = microCompact(messages, { turnIndex: 3, stride: 4 });
+    expect(result.compacted).toBe(false);
+    expect(result.charsSaved).toBe(0);
+  });
+
+  it('prunes cold superseded reads, collapses cold errors, and truncates huge cold outputs on stride turns', () => {
+    const messages = makeConversation();
+    // Turn 4 with hotWindowSize = 2 protects the latest turn (messages 6 & 7)
+    const result = microCompact(messages, { turnIndex: 4, stride: 4, hotWindowSize: 2 });
+
+    expect(result.compacted).toBe(true);
+    expect(result.charsSaved).toBeGreaterThan(1000);
+
+    // Rule A: Turn 1 read_1 is superseded by Turn 4 read_2
+    const read1Result = result.messages[2]?.content[0];
+    expect(read1Result && 'content' in read1Result ? read1Result.content : '').toContain(
+      '[μc] superseded',
+    );
+
+    // Rule B: Turn 2 verbose error is collapsed to single-line summary
+    const errorResult = result.messages[4]?.content[0];
+    expect(errorResult && 'content' in errorResult ? errorResult.content : '').toContain(
+      '[μc] resolved error: FAIL src/app.test.ts',
+    );
+
+    // Rule C: Turn 3 huge output (4000+ chars) is truncated in the middle
+    const hugeResult = result.messages[6]?.content[0];
+    expect(hugeResult && 'content' in hugeResult ? hugeResult.content : '').toContain(
+      '[... truncated by micro-compaction',
+    );
+
+    // Hot Window: Message 7 (latest turn result) is strictly untouched
+    const hotResult = result.messages[8]?.content[0];
+    expect(hotResult && 'content' in hotResult ? hotResult.content : '').toContain('HOT READ RESULT');
+  });
+});
