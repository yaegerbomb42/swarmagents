From 4951f28b38ce4d200300dd1966c546f2bdd474d2 Mon Sep 17 00:00:00 2001
From: yaegerbomb42 <yaeger.james42@gmail.com>
Date: Mon, 9 Nov 2026 04:19:31 +0000
Subject: [PATCH 1/7] feat(vscode): visual testing harness and webview
 aesthetic overhaul

---
 eslint.config.js                  |   5 +
 vscode/.vscodeignore              |   4 +
 vscode/media/chat.css             | 167 ++++++++++++-
 vscode/media/settings.css         |  38 ++-
 vscode/media/tokens.css           |   4 +
 vscode/package-lock.json          | 382 +++++++++++++++++++++++++++++-
 vscode/package.json               |   3 +
 vscode/src/webview/agentCard.ts   |   2 +-
 vscode/src/webview/chat.ts        |   6 +-
 vscode/src/webview/modelPicker.ts |  14 +-
 10 files changed, 609 insertions(+), 16 deletions(-)

diff --git a/eslint.config.js b/eslint.config.js
index 78892203..99e72b11 100644
--- a/eslint.config.js
+++ b/eslint.config.js
@@ -29,6 +29,11 @@ export default tseslint.config(
       // Plain-JS webview asset (terminal drawer controller): not part of any
       // tsconfig, so the project service cannot type-check it — like build.mjs.
       'vscode/media/terminal.js',
+      // Visual-testing harness: the preview fixtures and the headless capture
+      // runner are plain JS dev tooling, not part of any tsconfig — same as
+      // build.mjs above. They are still prettier-formatted (see format:check).
+      'vscode/preview/**',
+      'vscode/scripts/capture-ui.mjs',
       'scripts/copy-kernel-data.mjs',
       'bench/venv*/**',
       'src/.*/**',
diff --git a/vscode/.vscodeignore b/vscode/.vscodeignore
index 6c96b2f5..aac46f57 100644
--- a/vscode/.vscodeignore
+++ b/vscode/.vscodeignore
@@ -1,3 +1,7 @@
 src/**
 **/*.map
 tsconfig.json
+# Visual testing harness: dev-only, never ships in the VSIX.
+preview/**
+scripts/**
+screenshots/**
diff --git a/vscode/media/chat.css b/vscode/media/chat.css
index 6db1d050..8637b7c2 100644
--- a/vscode/media/chat.css
+++ b/vscode/media/chat.css
@@ -383,6 +383,31 @@ body.vscode-high-contrast-light .posture-pill button[aria-pressed='true'] {
   color: var(--muted);
 }
 
+/* In chat the posture/domain selectors are one quiet row (UI_OVERHAUL §5):
+   the save note lives in Settings (it repeats identically under both
+   selectors), and each caption is a single truncated line — the full
+   caption is the pill button's title. */
+#posture {
+  padding: 8px var(--pad-x) 7px;
+}
+
+#posture .posture-note {
+  display: none;
+}
+
+#posture .posture-caption {
+  margin: 5px 2px 0;
+  font-size: var(--fs-xs);
+  color: var(--muted);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+#posture [data-domain-slot] {
+  margin-top: 8px;
+}
+
 /* Work Domain selector: the posture pill's neutral sibling — a label row, the same
    segmented track, but the active segment is a plain raised surface, no gradient:
    the domain is a category, not an intensity. */
@@ -631,7 +656,14 @@ body.vscode-high-contrast-light .posture-pill button[aria-pressed='true'] {
   flex-direction: column;
   border-radius: var(--radius-lg);
   border: 1px solid var(--line);
-  background: var(--vscode-editorWidget-background, var(--surface));
+  /* Slightly translucent over a blur so the popover reads as floating glass
+     above the conversation, not another flat card. */
+  background: color-mix(
+    in srgb,
+    var(--vscode-editorWidget-background, var(--surface)) 94%,
+    transparent
+  );
+  backdrop-filter: blur(8px);
   box-shadow: var(--shadow-md);
   overflow: hidden;
 }
@@ -1329,6 +1361,7 @@ body.vscode-high-contrast-light .posture-pill button[aria-pressed='true'] {
 .msg.user .who {
   display: flex;
   align-items: center;
+  gap: var(--space-2);
   justify-content: space-between;
   font-size: var(--fs-xs);
   color: var(--muted);
@@ -1353,8 +1386,13 @@ body.vscode-high-contrast-light .posture-pill button[aria-pressed='true'] {
 .msg.assistant {
   position: relative;
   line-height: 1.6;
-  padding: 2px 2px 2px 10px;
-  /* Minimal custom design: soft vertical guide on assistant replies */
+  /* A sleek card, not a bare column: a soft border and radius over a faint
+     tint, keeping the accent guide on the left edge. */
+  margin: 2px 0;
+  padding: 8px 10px 8px 12px;
+  border: 1px solid color-mix(in srgb, var(--fg) 7%, transparent);
+  border-radius: var(--radius-md);
+  background: color-mix(in srgb, var(--fg) 2.5%, transparent);
   box-shadow: inset 2px 0 0 color-mix(in srgb, var(--accent) 35%, transparent);
 }
 
@@ -1661,13 +1699,32 @@ details.msg.think[open] .think-summary-text {
   margin-top: var(--space-3);
   padding-top: var(--space-3);
   border-top: 1px solid color-mix(in srgb, var(--violet) 20%, var(--line));
-  font-family: var(--vscode-font-family);
+  /* The model's inner monologue reads in monospace — it is a transcript of
+     thought, not prose. */
+  font-family: var(--mono);
   font-style: normal;
   color: var(--fg);
   max-height: 260px;
   overflow-y: auto;
 }
 
+/* Opening the accordion fades the body in with a 4px rise (motion rules). */
+details.msg.think[open] .think-body {
+  animation: think-in var(--dur-base) var(--ease);
+}
+
+@keyframes think-in {
+  from {
+    opacity: 0;
+    transform: translateY(4px);
+  }
+
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
 details.msg.think > summary::after {
   content: '▾';
   margin-left: auto;
@@ -1963,6 +2020,9 @@ details.msg.think[open] > summary::after {
 
 .term-pill-status {
   flex: none;
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
   font-size: var(--fs-xs);
   padding: 1px var(--space-2);
   border-radius: var(--radius-full);
@@ -1973,16 +2033,50 @@ details.msg.think[open] > summary::after {
   background: color-mix(in srgb, var(--ox-accent) 16%, transparent);
 }
 
+/* Active pills pulse: a live dot breathes while the command runs; completed
+   pills get a crisp check / cross so the outcome reads at a glance. */
+.term-pill-status.is-running::before {
+  content: '';
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  background: var(--ox-accent);
+  animation: pill-pulse 1.2s var(--ease-soft) infinite;
+}
+
+@keyframes pill-pulse {
+  0%,
+  100% {
+    opacity: 1;
+    box-shadow: 0 0 0 0 color-mix(in srgb, var(--ox-accent) 45%, transparent);
+  }
+
+  50% {
+    opacity: 0.55;
+    box-shadow: 0 0 0 4px transparent;
+  }
+}
+
 .term-pill-status.is-success {
   color: var(--ok);
   background: color-mix(in srgb, var(--ok) 16%, transparent);
 }
 
+.term-pill-status.is-success::before {
+  content: '✓';
+  font-weight: 700;
+}
+
 .term-pill-status.is-error {
   color: var(--bad);
   background: color-mix(in srgb, var(--bad) 16%, transparent);
 }
 
+.term-pill-status.is-error::before {
+  content: '✗';
+  font-weight: 700;
+}
+
 .term-pill-head .tool-elapsed {
   flex: none;
   font-family: var(--mono);
@@ -1996,7 +2090,9 @@ details.msg.think[open] > summary::after {
 }
 
 .term-pill-term {
-  height: 220px;
+  /* Tall enough for a short command's output (~8 rows); the old 220px left a
+     big empty black slab under two lines of output. Long output scrolls. */
+  height: 132px;
   max-height: 40vh;
   overflow: hidden;
   background: var(--ox-bg);
@@ -2025,6 +2121,7 @@ details.msg.think[open] > summary::after {
 .working.cockpit-hud {
   display: flex;
   align-items: center;
+  flex-wrap: wrap;
   gap: var(--space-4);
   padding: 5px 8px;
   border-radius: var(--radius-md);
@@ -2094,6 +2191,12 @@ details.msg.think[open] > summary::after {
 .working-copy {
   font-size: var(--fs-sm);
   color: var(--muted);
+  /* The HUD is one line: the copy truncates instead of forcing the row (and
+     its pill) past the panel edge in split view. */
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
 }
 .working.cockpit-hud.is-thinking .working-copy {
   color: var(--violet);
@@ -2163,6 +2266,30 @@ details.msg.think[open] > summary::after {
   border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
 }
 
+/* Suggestion cards: icon on top, title and hint stacked — the title keeps the
+   accent, the hint drops to muted so the two lines read as a pair. */
+.suggestion-card {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 2px;
+}
+
+.suggestion-icon {
+  font-size: 15px;
+  line-height: 1;
+}
+
+.suggestion-title {
+  font-weight: 600;
+}
+
+.suggestion-hint {
+  color: var(--muted);
+  font-size: var(--fs-xs);
+  font-weight: 400;
+}
+
 .banner,
 .ask {
   margin: 0 var(--pad-x) 8px;
@@ -2248,6 +2375,13 @@ details.msg.think[open] > summary::after {
   color: var(--muted);
 }
 
+/* The `/run <goal>` pill must read against its code-block background: muted
+   text on near-black is unreadable, so the code chip takes the foreground. */
+.empty-hint code {
+  color: var(--fg);
+  border: 1px solid var(--line);
+}
+
 /* Composer: the input is one flat card — borderless textarea inside, a filled
    round send button, and the focus ring on the card, not the textarea. */
 /* Floating bottom composer dock: an inset card on the panel surface — model
@@ -2281,7 +2415,16 @@ details.msg.think[open] > summary::after {
 
 .input-wrap:focus-within {
   border-color: var(--vscode-focusBorder, var(--accent));
-  box-shadow: 0 0 0 1px var(--vscode-focusBorder, var(--accent));
+  box-shadow: var(--ring);
+}
+
+/* The dock itself lights up while the input has focus — a soft glow around
+   the whole composer, not just the textarea. */
+.composer:focus-within {
+  border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
+  box-shadow:
+    var(--shadow-lg),
+    0 0 0 1px color-mix(in srgb, var(--accent) 28%, transparent);
 }
 
 textarea {
@@ -2414,6 +2557,8 @@ textarea::placeholder {
 .statusline {
   display: flex;
   align-items: center;
+  flex-wrap: wrap;
+  row-gap: 2px;
   gap: var(--space-3);
   min-width: 0;
   padding: 2px var(--space-1) 0;
@@ -2431,7 +2576,10 @@ textarea::placeholder {
 }
 
 .status-model {
-  min-width: 0;
+  /* The model is the picker's anchor: it grows first and never collapses to
+     a couple of characters — the other items wrap instead of squeezing it. */
+  flex: 1 1 auto;
+  min-width: 110px;
   max-width: 55%;
   overflow: hidden;
   text-overflow: ellipsis;
@@ -3011,6 +3159,11 @@ body.waking #power {
     animation: none;
   }
 
+  details.msg.think[open] .think-body,
+  .term-pill-status.is-running::before {
+    animation: none;
+  }
+
   .fill,
   .chev {
     transition: none;
