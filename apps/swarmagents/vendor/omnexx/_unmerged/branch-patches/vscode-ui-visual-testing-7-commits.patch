   justify-items: start;
   gap: 4px;
   padding: 10px;
-  border: 1px dashed color-mix(in srgb, var(--sec, var(--accent)) 45%, var(--line));
+  /* A solid, quiet border now — the dashed outline read as a placeholder
+     sketch; the tinted background still marks it as an empty state. */
+  border: 1px solid color-mix(in srgb, var(--sec, var(--accent)) 22%, var(--line));
   border-radius: var(--radius-md);
   background: color-mix(in srgb, var(--sec, var(--accent)) 6%, transparent);
 }
@@ -511,6 +513,25 @@ kbd {
   border-radius: var(--radius-sm);
 }
 
+/* Primary actions take the VS Code button treatment — the agent Save button
+   was falling back to the browser's grey default and looked disabled. */
+.settings .sec-body .primary {
+  background: var(--vscode-button-background, var(--accent));
+  color: var(--vscode-button-foreground, #fff);
+  border: 0;
+  padding: 4px 14px;
+  font-weight: 600;
+}
+
+.settings .sec-body .primary:hover {
+  background: var(--vscode-button-hoverBackground, var(--vscode-button-background, var(--accent)));
+}
+
+.settings .sec-body .primary:disabled {
+  opacity: 0.5;
+  cursor: default;
+}
+
 .settings .sec-body .ghost:hover {
   border-color: var(--sec, var(--accent));
 }
@@ -939,6 +960,13 @@ kbd {
   font-size: var(--fs-sm);
   font-variant-numeric: tabular-nums;
   white-space: nowrap;
+  /* The live meaning ("5 · balanced: plan briefly, test what you touch") is
+     longer than the row: truncate it instead of forcing the label to wrap.
+     The full text is the span's title (agentCard.ts). */
+  min-width: 0;
+  max-width: 62%;
+  overflow: hidden;
+  text-overflow: ellipsis;
 }
 
 .agent-row input[type='range'] {
@@ -999,6 +1027,14 @@ kbd {
   color: var(--fg);
 }
 
+/* The "always ask" checkbox takes the accent so it reads as a control, not
+   a stray square. */
+.agent-ask input[type='checkbox'] {
+  accent-color: var(--accent);
+  width: 15px;
+  height: 15px;
+}
+
 /* Token Budget bar (context fill), under the agent card. */
 .budget {
   border: 1px solid var(--line);
