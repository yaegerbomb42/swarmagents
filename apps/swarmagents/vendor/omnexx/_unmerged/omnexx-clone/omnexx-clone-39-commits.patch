From 2126ac3b486af44e713d1f6093d343e197f9922d Mon Sep 17 00:00:00 2001
From: yaegerbomb42 <203348624+yaegerbomb42@users.noreply.github.com>
Date: Wed, 28 Oct 2026 12:25:55 -0500
Subject: [PATCH 03/39] feat(vscode): modelDetailTags helper for free/size tags

---
 test/unit/vscode-provider-form.test.ts | 15 +++++++++++++++
 vscode/src/webview/badge.ts            | 18 ++++++++++++++++++
 2 files changed, 33 insertions(+)

diff --git a/test/unit/vscode-provider-form.test.ts b/test/unit/vscode-provider-form.test.ts
index d4617b5c..76214c94 100644
--- a/test/unit/vscode-provider-form.test.ts
+++ b/test/unit/vscode-provider-form.test.ts
@@ -1,4 +1,5 @@
 import { beforeEach, describe, expect, it } from 'vitest';
+import { modelDetailTags } from '../../vscode/src/webview/badge.js';
 import * as form from '../../vscode/src/webview/providerForm.js';
 
 const azure: form.FormProvider = {
@@ -57,3 +58,17 @@ describe('settings: provider form extras', () => {
     ).toContain('a, b');
   });
 });
+
+describe('model picker: model detail tags', () => {
+  it('reads a free tag and a parameter size from the model id', () => {
+    expect(modelDetailTags('llama-3.3-70b:free')).toEqual(['free', '70b']);
+    expect(modelDetailTags('qwen2.5-coder-32b-instruct')).toEqual(['32b']);
+    expect(modelDetailTags('gpt-4o')).toEqual([]);
+  });
+
+  it('recognizes a bare free tag and mixed-case or mixed-expert sizes', () => {
+    expect(modelDetailTags('free')).toEqual(['free']);
+    expect(modelDetailTags('mixtral-8x7b-free')).toEqual(['free', '8x7b']);
+    expect(modelDetailTags('Gemma-2-27B')).toEqual(['27b']);
+  });
+});
diff --git a/vscode/src/webview/badge.ts b/vscode/src/webview/badge.ts
index 086f0343..7906b4f8 100644
--- a/vscode/src/webview/badge.ts
+++ b/vscode/src/webview/badge.ts
@@ -17,6 +17,24 @@ export function badge(name: string): string {
   return `<span class="badge" style="--h:${String(providerHue(name))}">${escapeHtml(letters)}</span>`;
 }
 
+/**
+ * The quiet details worth showing next to a model: a free tag and a parameter count
+ * (8b, 70b, 8x7b) read straight from its id. No DOM, so tests can import it.
+ */
+export function modelDetailTags(model: string): string[] {
+  const tags: string[] = [];
+  if (
+    model
+      .toLowerCase()
+      .split(/[^a-z0-9.]+/)
+      .includes('free')
+  )
+    tags.push('free');
+  const size = /(?:^|[^a-z0-9])(\d+(?:\.\d+)?(?:x\d+(?:\.\d+)?)?b)(?![a-z0-9])/i.exec(model);
+  if (size?.[1]) tags.push(size[1].toLowerCase());
+  return tags;
+}
+
 /** One model from a connected provider, as the picker and palette list it. */
 export interface ModelItem {
   ref: string;
-- 
