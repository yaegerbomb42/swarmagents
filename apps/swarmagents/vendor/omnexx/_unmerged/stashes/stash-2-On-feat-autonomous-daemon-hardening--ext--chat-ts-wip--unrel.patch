+    expect(await isOmnexxRepo(bare)).toBe(false);
+  });
+});
+
+describe('daemon loop termination & clean exit', () => {
+  it('start(maxCycles) resolves, stops running, and releases the daemon lock', async () => {
+    const repo = await tempRepo();
