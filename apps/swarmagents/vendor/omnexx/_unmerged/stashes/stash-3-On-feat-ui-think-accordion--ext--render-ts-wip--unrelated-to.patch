+  if (dels > 0) parts.push(`<span class="diff-stat del" title="${String(dels)} deletions">-${String(dels)}</span>`);
+  if (!parts.length) return '';
+  return `<span class="diff-stat-group">${parts.join('')}</span>`;
 }
 
