+}
+
+.token-meter-track {
+  position: relative;
+  flex: none;
+  width: 34px;
+  height: 4px;
+  overflow: hidden;
+  border-radius: 2px;
+  background: color-mix(in srgb, var(--muted) 25%, transparent);
+}
+
+.token-meter-fill {
+  position: absolute;
