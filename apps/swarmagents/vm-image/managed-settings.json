{
  "disableAllHooks": false,
  "permissions": {
    "allow": [
      "Glob",
      "Grep",
      "TodoWrite",
      "WebSearch"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/swarm-approval-hook",
            "timeout": 3600
          }
        ]
      }
    ]
  }
}
