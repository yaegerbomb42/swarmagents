# ── DeepSeek V4 Flash (Azure) — required for LLM features ──────────────
# The dashboard is self-contained: decomposition + execution run in Next.js
# API routes backed by this Azure DeepSeek deployment. Set these as secrets
# in production (e.g. Vercel / container env). Never commit real values.
AZURE_OPENAI_ENDPOINT=https://swarmagents.openai.azure.com/openai/v1/chat/completions
AZURE_OPENAI_API_KEY=your-apim-subscription-key
# Deployment name to call (only DeepSeek V4 Flash is used).
DEEPSEEK_MODEL=DeepSeek-V4-Flash-batch

# Public site URL
NEXT_PUBLIC_URL=http://localhost:3000

# Firebase Auth (public web config — required or login throws)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Optional: external Python engine ───────────────────────────────────
# Left unset by default. When set, /api/engine/health probes it first and
# the WebSocket live-update stream is enabled. The core product works
# without it (native Next.js engine + polling).
# ENGINE_URL=http://localhost:8400
# NEXT_PUBLIC_ENGINE_URL=http://localhost:8400
# NEXT_PUBLIC_WS_URL=ws://localhost:8400

# ── Optional: error tracking (Sentry) ──────────────────────────────────
# Server-side DSN (API routes, SSR). Leave unset to keep Sentry disabled.
# SENTRY_DSN=
# Browser DSN — public, safe to expose (Sentry DSNs are project identifiers).
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Admin unit-economics (engine) ──────────────────────────────────────
# Shared secret injected server-side by /api/admin/margin — never shipped to
# the browser. Must match the engine's BILLING_INTERNAL_SECRET.
# BILLING_INTERNAL_SECRET=
# Comma-separated admin identities (email/uid substrings) allowed to view
# /admin/margin/report on the engine. Defaults to 'yaeger'.
# DASHBOARD_ADMIN_EMAILS=yaeger

