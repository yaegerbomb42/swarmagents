# SwarmAgents Dashboard — Local Development Environment
# Copy this file to .env.local and fill in values
# .env.local is excluded from git via .gitignore

# ─── Engine Backend ──────────────────────────────────────────────────────────
# Server-side URL for the FastAPI backend (used in Next.js API routes and rewrites)
ENGINE_URL=http://localhost:8400

# Client-side URL for direct browser access (leave empty to use /api/engine proxy)
NEXT_PUBLIC_ENGINE_URL=

# WebSocket base URL for real-time streaming (browser)
NEXT_PUBLIC_ENGINE_WS_URL=ws://localhost:8400

# ─── Ollama Local Inference ──────────────────────────────────────────────────
# Ollama endpoint for local model inference
OLLAMA_URL=http://localhost:11434

# Public Ollama URL accessible from the browser (for client-side inference)
NEXT_PUBLIC_OLLAMA_URL=http://localhost:11434

# ─── Browser Automation Backend ──────────────────────────────────────────────
BROWSER_BACKEND_URL=http://localhost:8002

# ─── LLM API Keys (optional — used by Next.js API routes) ───────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# ─── Feature Flags ───────────────────────────────────────────────────────────
NEXT_PUBLIC_DEBUG=true

# ─── Firebase Auth (public web config) ───────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
