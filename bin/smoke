#!/bin/bash
# Swarm smoke gate — run before marking any MASTER_TODO row done.
# Checks: typecheck, fast unit suites, production build, server boot, API ping, SSE stream.
# Usage: ./bin/smoke [--skip-build]
set -e
cd "$(dirname "$0")/.."
# Isolated dist dir: never fight a concurrent `next dev` over .next (dev writes there too).
export NEXT_DIST_DIR=.next-smoke
SKIP_BUILD=0
[ "${1:-}" = "--skip-build" ] && SKIP_BUILD=1

echo "== 1/5 typecheck =="
npx tsc --noEmit
echo OK

echo "== 2/5 fast suites (no server needed) =="
npm test 2>&1 | grep -v -i "warning\|repars\|trace-warnings\|MODULE_TYPELESS"

if [ "$SKIP_BUILD" = "0" ] || [ ! -f ".next-smoke/BUILD_ID" ]; then
  echo "== 3/5 build =="
  npx next build --no-lint 2>&1 | tail -5
else
  echo "== 3/5 build (skipped) =="
fi

echo "== 4/5 boot + API ping =="
# Free port: parallel gates must never fight over one.
PORT=$(python3 -c "import socket; s=socket.socket(); s.bind(('127.0.0.1',0)); print(s.getsockname()[1])")
SMOKE_LOG=$(mktemp -t swarm-smoke.XXXXXX.log)
(npx next start -H 127.0.0.1 -p "$PORT" >"$SMOKE_LOG" 2>&1 &)
for i in $(seq 1 60); do curl -sf -o /dev/null "http://127.0.0.1:$PORT/api/sessions" && break; sleep 0.5; [ "$i" = 60 ] && { tail -30 "$SMOKE_LOG"; exit 1; }; done
echo "GET /api/sessions: $(curl -s "http://127.0.0.1:$PORT/api/sessions")"
echo "GET /api/providers: $(curl -s "http://127.0.0.1:$PORT/api/providers" | head -c 200)..."

echo "== 5/5 session create + SSE snapshot =="
SID=$(curl -s -X POST "http://127.0.0.1:$PORT/api/sessions" | python3 -c "import sys,json;print(json.load(sys.stdin)['session']['id'])")
echo "session: $SID"
curl -sN --max-time 8 "http://127.0.0.1:$PORT/api/sessions/$SID" | head -c 500; echo
curl -s -X DELETE "http://127.0.0.1:$PORT/api/sessions/$SID" >/dev/null
pkill -f "next start -H 127.0.0.1 -p $PORT" 2>/dev/null || true
rm -f "$SMOKE_LOG"
# Whoever ran this owns the build output; hand it to the repo owner so the next agent is never locked out.
chown -R "$(stat -f '%Su' . 2>/dev/null || stat -c '%U' .)" .next-smoke 2>/dev/null || true
echo; echo "SMOKE PASS"
