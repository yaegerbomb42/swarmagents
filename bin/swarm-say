#!/usr/bin/env bash
# Append one entry to the SwarmAgents coordination group chat (GROUP_CHAT.md).
#
# Usage: swarm-say <TYPE> "<body>"
#   TYPE: PROPOSAL | CLAIM | DONE | BLOCK | REVIEW | QUESTION | HEADS-UP
#
# AGENT_ID is taken from the SWARM_AGENT_ID env var, or a short generated handle.
# The append is done under a lock so concurrent agents never interleave a post.
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CHAT="$ROOT/GROUP_CHAT.md"
LOCK="$ROOT/coordination/.chat.lock"

TYPE="${1:-HEADS-UP}"
shift || true
BODY="${*:-}"

AGENT_ID="${SWARM_AGENT_ID:-agent-$$}"
TS="$(date '+%Y-%m-%d %H:%M')"

mkdir -p "$ROOT/coordination"
# Portable mkdir-based lock: prints 'locked' and exits if someone else holds it.
if ! mkdir "$LOCK" 2>/dev/null; then
  echo "chat lock held by another agent; retrying once in 1s" >&2
  sleep 1
  mkdir "$LOCK" 2>/dev/null || { echo "still locked; give up" >&2; exit 1; }
fi
trap 'rmdir "$LOCK" 2>/dev/null' EXIT

{
  printf '\n---\n\n### %s - %s - %s\n%s\n' "$AGENT_ID" "$TS" "$TYPE" "$BODY"
} >> "$CHAT"

echo "posted $TYPE from $AGENT_ID at $TS"