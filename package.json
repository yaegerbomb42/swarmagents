{
  "name": "swarmagents",
  "version": "2.0.0",
  "private": true,
  "description": "One chat bar. One agent. Every tool. Nothing hidden.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3777",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3777",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:checkpoints && npm run test:ui && npm run test:shell && npm run test:auth",
    "test:ui": "node tests/timeline-ui.mjs",
    "test:checkpoints": "node tests/checkpoint-restore.mjs",
    "test:shell": "node tests/shell-env.mjs",
    "test:auth": "node tests/auth-gate.mjs",
    "browser:install": "playwright-core install chromium",
    "test:browser": "tsx tests/browser-runtime.mjs",
    "test:browser:viewer": "tsx tests/browser-viewer.mjs",
    "test:browser:security": "tsx tests/browser-security.mjs",
    "test:browser:all": "npm run test:browser && npm run test:browser:viewer && npm run test:browser:security",
    "test:e2e": "node tests/e2e.mjs",
    "test:runtime": "tsx tests/runtime.e2e.mjs",
    "test:runtime:mock": "node tests/runtime.mock.mjs",
    "test:runtime:tenant": "tsx tests/runtime-tenant.mjs",
    "test:runtime:ledger": "tsx tests/runtime-ledger-durability.mjs",
    "test:router": "tsx tests/router.bench.mjs",
    "test:approvals": "tsx tests/approvals.mjs",
    "test:approvals:store": "tsx tests/approvals.store.mjs",
    "mock-llm": "node tests/mock-llm.mjs",
    "test:tenant": "tsx tests/tenant-connections.mjs && tsx tests/tenant-storage.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.130.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@shikijs/rehype": "^4.5.0",
    "next": "^15.5.27",
    "openai": "^7.25.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0"
  }
}
